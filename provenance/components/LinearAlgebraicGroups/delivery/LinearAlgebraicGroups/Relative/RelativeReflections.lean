open Specs.Unipotent (closedSubgroupAlgebraicGroup)
open Specs.CharacterPairing (powerMorphism)
open Specs.GeometricRadicals (IsSplitTorus)
open Specs.GeometricBorelConjugacy (ConjugatesSubgroups)
open Specs.DiagonalizableGroups (IntegerCharacters integerGenerator groupAlgebra groupAlgebraMap)
open private splitPresentation pairing_eq_iff
  from LinearAlgebraicGroups.RootData.CharacterPairing
open private splitGroupHomEquiv from LinearAlgebraicGroups.Multiplicative.CharacterDescent
open private integerHomEquiv from LinearAlgebraicGroups.Multiplicative.DiagonalizableGroups
open private normalizes_of_conjugates_self inclusion_mono
  from LinearAlgebraicGroups.Reductive.MaximalToriConjugate
