local notation "Gm[" F "]" => specGroup (groupAlgebra F IntegerCharacters)

private theorem splitEndomorphism_ext {S : GroupScheme k} (hS : IsSplitTorus S)
    {f g : S ⟶ S} (h : ∀ b : Character S, f ≫ b = g ≫ b) : f = g := by
  obtain ⟨r, ⟨i⟩⟩ := splitPresentation hS
  let M := Specs.CharacterDescent.StandardLattice.{u} r
  let E := splitGroupHomEquiv (k := k) M M
  let χ := diagonalCharacter (k := k) M
  have hh : i.hom ≫ f ≫ i.inv = i.hom ≫ g ≫ i.inv := by
    apply E.symm.injective
    apply MonoidHom.ext
    intro m
    apply χ.injective
    have hf := diagonalCharacter_pullback (k := k) (E.symm (i.hom ≫ f ≫ i.inv)) m
    have hg := diagonalCharacter_pullback (k := k) (E.symm (i.hom ≫ g ≫ i.inv)) m
    change E (E.symm (i.hom ≫ f ≫ i.inv)) ≫ χ m = _ at hf
    change E (E.symm (i.hom ≫ g ≫ i.inv)) ≫ χ m = _ at hg
    rw [E.apply_symm_apply] at hf hg
    rw [← hf, ← hg]
    simpa only [Category.assoc] using congrArg (i.hom ≫ ·) (h (i.inv ≫ χ m))
  exact (cancel_mono i.inv).mp ((cancel_epi i.hom).mp hh)

private theorem conjugation_one {S : ClosedSubgroup G.val} (hS : IsSplitTorus S.group)
    (Q : QuotientData S) : (Q.splitImage.conjugation 1).hom = 𝟙 S.group := by
  let e := Q.splitImage.conjugation 1
  have h : e.inv = 𝟙 S.group := splitEndomorphism_ext hS (fun b ↦ by
    rw [Category.id_comp]
    exact (Q.splitImage.characterAction 1 b).symm)
  exact (cancel_mono e.inv).mp (by rw [e.hom_inv_id, Category.id_comp, h])

private theorem conjugation_square {S : ClosedSubgroup G.val} (hS : IsSplitTorus S.group)
    (Q : QuotientData S) (w : Q.splitImage.labels) (hw : w ^ 2 = 1) :
    (Q.splitImage.conjugation w).hom ≫ (Q.splitImage.conjugation w).hom = 𝟙 S.group := by
  let e := Q.splitImage.conjugation w
  have h : e.inv ≫ e.inv = 𝟙 S.group := splitEndomorphism_ext hS (fun b ↦ by
    rw [Category.assoc, Category.id_comp, ← Q.splitImage.characterAction w b,
      ← Q.splitImage.characterAction w (w.val b)]
    exact congrArg (fun t : Q.splitImage.labels ↦ t.val b) (show w * w = 1 by simpa [pow_two] using hw))
  have he : e.hom = e.inv := (cancel_mono e.inv).mp (e.hom_inv_id.trans h.symm)
  exact (congrArg₂ (· ≫ ·) he he).trans h

private theorem powerMorphism_eq_zpow (n : ℤ) :
    powerMorphism (k := k) n = (𝟙 Gm[k] : Character Gm[k]) ^ n := by
  let χ := diagonalCharacter (k := k) IntegerCharacters.{u}
  have hg : χ integerGenerator = 𝟙 Gm[k] := by
    have h : integerHomEquiv IntegerCharacters.{u} integerGenerator =
        MonoidHom.id IntegerCharacters.{u} := by
      apply MonoidHom.ext
      intro t
      change (integerGenerator : IntegerCharacters.{u}) ^ t.down.toAdd = t
      apply ULift.ext
      show t.down.toAdd • (1 : ℤ) = t.down.toAdd
      simp
    change specGroupMap (groupAlgebraMap k (integerHomEquiv IntegerCharacters integerGenerator)) = _
    rw [h]
    have hm : groupAlgebraMap k (MonoidHom.id IntegerCharacters) = 𝟙 _ :=
      CommHopfAlgCat.hom_ext (MonoidAlgebra.mapDomainBialgHom_id (R := k))
    rw [hm]
    exact (hopfSpec (CommRingCat.of k)).map_id _
  change χ (integerGenerator ^ n) = _
  rw [map_zpow, hg]

private theorem reflection_pairing_two {X Y : Type u} [AddCommGroup X] [AddCommGroup Y]
    [Module.IsTorsionFree ℤ X] (A : X ≃ₗ[ℤ] X) (P : X →ₗ[ℤ] Y →ₗ[ℤ] ℤ)
    {a : X} {c : Y} (ha : a ≠ 0) (hne : A ≠ 1)
    (hs : ∀ x, A (A x) = x) (h : ∀ x, A x = x - P x c • a) : P a c = 2 := by
  have hex : ∃ x, P x c ≠ 0 := by
    by_contra! hn
    apply hne
    ext x
    rw [h, hn, zero_smul, sub_zero]
    rfl
  obtain ⟨x, hx⟩ := hex
  have hcalc : A (A x) = x + ((P a c - 2) * P x c) • a := by
    rw [h (A x), h x, map_sub, LinearMap.sub_apply, map_smul, LinearMap.smul_apply]
    module
  have hz : ((P a c - 2) * P x c) • a = 0 := by
    rw [hs] at hcalc
    exact add_left_cancel (hcalc.symm.trans (add_zero _).symm)
  exact sub_eq_zero.mp ((mul_eq_zero.mp ((smul_eq_zero.mp hz).resolve_right ha)).resolve_right hx)

private theorem twoChamberLabels {S : ClosedSubgroup G.val} (Q : QuotientData S)
    (A : ChamberAction Q)
    (h : ∃ U V : Set (Root S), IsChamber S U ∧ IsChamber S V ∧ U ≠ V ∧
      ∀ C, IsChamber S C → C = U ∨ C = V) :
    ∃ w : Q.splitImage.labels, w ≠ 1 ∧ (∀ z : Q.splitImage.labels, z = 1 ∨ z = w) ∧
      w ^ 2 = 1 ∧ ∃ U V : Set (Root S), IsChamber S U ∧ IsChamber S V ∧ U ≠ V ∧
      A.permutation w '' U = V ∧ A.permutation w '' V = U := by
  obtain ⟨U,V,hU,hV,hne,hall⟩ := h
  obtain ⟨w, hw, huniq⟩ := A.simplyTransitive U V hU hV
  have hself : A.permutation 1 '' U = U := by simp
  have hw₀ : w ≠ 1 := by rintro rfl; exact hne (hself.symm.trans hw)
  have hallw (z : Q.splitImage.labels) : z = 1 ∨ z = w := by
    rcases hall _ (A.preserves z _ hU) with hz | hz
    · exact Or.inl ((A.simplyTransitive U U hU hU).unique hz hself)
    · exact Or.inr (huniq z hz)
  have hs : w ^ 2 = 1 := by
    rcases hallw w⁻¹ with h | h
    · exact (hw₀ (inv_eq_one.mp h)).elim
    · calc
        w ^ 2 = w⁻¹ * w := (pow_two w).trans (congrArg (· * w) h.symm)
        _ = 1 := inv_mul_cancel w
  refine ⟨w, hw₀, hallw, hs, U, V, hU, hV, hne, hw, ?_⟩
  rw [← hw, Set.image_image]
  have hh : (A.permutation w : Root S → Root S) ∘ A.permutation w =
      (A.permutation 1 : Root S → Root S) := by
    have hw' : w * w = 1 := by simpa [pow_two] using hs
    change ⇑(A.permutation w * A.permutation w) = _
    rw [← map_mul, hw']
  change ((A.permutation w : Root S → Root S) ∘ A.permutation w) '' U = U
  rw [hh, hself]

private theorem reflectionOfCentralizer (centralizers : RootCentralizers.{u}) :
    RootReflections.{u} := by
  classical
  intro k _ G hG S hS Q a
  obtain ⟨C⟩ := centralizers G hG S hS a
  let H := closedSubgroupAlgebraicGroup
    (G := closedSubgroupAlgebraicGroup C.centralizer) C.component
  let j : H.val ⟶ G.val := C.component.inclusion ≫ C.centralizer.inclusion
  let T := C.torus
  let i := C.torusIso
  have hi : i.hom ≫ T.inclusion ≫ j = S.inclusion := C.torusInclusion
  obtain ⟨L, _⟩ := RelativeWeylScheme.finiteConstantQuotient H C.reductive T C.maximal
  obtain ⟨A⟩ := normalizerChambers H C.reductive T C.maximal L
  obtain ⟨l, hl, hlocal, hlsq, hswap⟩ := twoChamberLabels L A C.twoChambers
  obtain ⟨c, hc⟩ := exists_regular_cocharacter H T C.maximal.1
  obtain ⟨D⟩ := existsLimitDecomposition H (c ≫ T.inclusion)
  have hP := (RelativeChambers.minimalLimitParabolic H C.reductive T C.maximal c D).mpr hc
  have hT := (RelativeChambers.limitParabolicThroughSplitTorus H C.reductive T C.maximal.1 c D).2
  obtain ⟨_, _, _, _, hrep, _, _⟩ :=
    RelativeWeylScheme.relativeWeylAction H C.reductive T D.parabolic C.maximal hP hT L
  obtain ⟨m, hm⟩ := hrep l
  let gH := m ≫ L.normalizer.inclusion.hom.hom
  let g := gH ≫ j.hom.hom
  let e := L.splitImage.conjugation l
  let e' := i ≪≫ e ≪≫ i.symm
  have hlconj : (e.hom ≫ T.inclusion).hom.hom = pointConj gH T.inclusion.hom.hom := by
    have h := quotientLabel_conjugates L.splitImage m
    rw [quotientLabel_eq_of_projection L l m hm] at h
    exact h
  have hnconj : (e'.hom ≫ S.inclusion).hom.hom = pointConj g S.inclusion.hom.hom := by
    let F := Grp.forget (SchemeOver k)
    have hb := congrArg (fun f : T.group.X ⟶ H.val.X ↦ (i.hom.hom.hom ≫ f) ≫ j.hom.hom) hlconj
    rw [comp_pointConj] at hb
    have hi' := F.congr_map hi
    change i.hom.hom.hom ≫ T.inclusion.hom.hom ≫ j.hom.hom = S.inclusion.hom.hom at hi'
    have h₁ : (e'.hom ≫ S.inclusion).hom.hom =
        (i.hom.hom.hom ≫ (e.hom ≫ T.inclusion).hom.hom) ≫ j.hom.hom := by
      have ht : e'.hom ≫ S.inclusion = (i.hom ≫ (e.hom ≫ T.inclusion)) ≫ j := by
        change (i.hom ≫ e.hom ≫ i.inv) ≫ S.inclusion = _
        rw [← hi]
        simp only [Category.assoc, Iso.inv_hom_id_assoc]
      exact congrArg (fun f : S.group ⟶ G.val ↦ f.hom.hom) ht
    rw [h₁, hb]
    simp only [pointConj, constantPoint, MonObj.mul_comp, GrpObj.inv_comp, Category.assoc, hi', g]
  obtain ⟨n, hn⟩ := (Q.normalizerProperty _ g).mp
    (normalizes_of_conjugates_self S ⟨e', hnconj⟩)
  let w := quotientLabel Q.splitImage n
  have hwproj : rationalProjection Q n = Q.splitImage.constantGroup.sectionPoint w := by
    have h := quotientLabel_spec Q.splitImage n
    rw [toUnit_unique (toUnit (𝟙_ (SchemeOver k))) (𝟙 _), Category.id_comp] at h
    exact h
  let σ := Q.splitImage.conjugation w
  have hσ : σ.hom = e'.hom := by
    letI := S.isClosedImmersion
    haveI : Mono S.inclusion := inclusion_mono S
    apply (cancel_mono S.inclusion).mp
    apply Grp.hom_ext
    rw [hnconj, ← hn]
    exact quotientLabel_conjugates Q.splitImage n
  have he_sq : e.hom ≫ e.hom = 𝟙 T.group := conjugation_square C.maximal.1 L l hlsq
  have hσ_sq : σ.hom ≫ σ.hom = 𝟙 S.group := by
    rw [hσ]
    change (i.hom ≫ e.hom ≫ i.inv) ≫ (i.hom ≫ e.hom ≫ i.inv) = _
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [← Category.assoc e.hom e.hom, he_sq, Category.id_comp, Iso.hom_inv_id]
  have hσ' : σ.inv = σ.hom := (cancel_mono σ.hom).mp (σ.inv_hom_id.trans hσ_sq.symm)
  have hw_sq : w ^ 2 = 1 := by
    apply Subtype.ext
    apply MulEquiv.ext
    intro b
    change w.val (w.val b) = b
    rw [Q.splitImage.characterAction w (w.val b), Q.splitImage.characterAction w b, hσ',
      ← Category.assoc, hσ_sq, Category.id_comp]
  have hw : w ≠ 1 := by
    intro h
    have hσ₁ : σ.hom = 𝟙 _ := by
      change (Q.splitImage.conjugation w).hom = _
      rw [h]
      exact conjugation_one hS.1 Q
    have he : e.hom = 𝟙 _ := by
      have hi' := congrArg (fun f : S.group ⟶ S.group ↦ i.inv ≫ f ≫ i.hom) (hσ.symm.trans hσ₁)
      simpa only [e', Iso.trans_hom, Iso.symm_hom, Category.assoc, Iso.inv_hom_id_assoc,
        Iso.inv_hom_id, Category.comp_id, Category.id_comp] using hi'
    apply hl
    apply Subtype.ext
    apply MulEquiv.ext
    intro b
    have he' : e.inv = 𝟙 _ := (cancel_epi e.hom).mp (by rw [e.hom_inv_id, Category.comp_id, he])
    rw [L.splitImage.characterAction, he', Category.id_comp]
    rfl
  let K := C.kernel.subgroup
  have hg : Centralizes (K.inclusion ≫ S.inclusion) g := by
    apply (C.represents _ _).mpr
    exact ⟨gH ≫ C.component.inclusion.hom.hom, by simp [g, j, Category.assoc]⟩
  have hfix : K.inclusion ≫ σ.hom = K.inclusion := by
    haveI : Mono S.inclusion := inclusion_mono S
    apply (cancel_mono S.inclusion).mp
    apply Grp.hom_ext
    change K.inclusion.hom.hom ≫ (σ.hom ≫ S.inclusion).hom.hom = _
    rw [hσ, hnconj, comp_pointConj]
    have hh := (centralizes_iff (K.inclusion ≫ S.inclusion) g).mp hg K.group.X (toUnit _) (𝟙 _)
    change Commute (toUnit K.group.X ≫ g) ((𝟙 K.group.X) ≫ (K.inclusion ≫ S.inclusion).hom.hom) at hh
    rw [Category.id_comp] at hh
    exact mul_inv_eq_iff_eq_mul.mpr hh.eq
  obtain ⟨hc, hX, _, _, _, P, _, hpair⟩ :=
    RootData.CharacterPairing.perfectCharacterPairing S.group hS.1
  letI := hc
  letI := hX
  let f : S.group ⟶ S.group := (𝟙 S.group) * σ.hom⁻¹
  obtain ⟨d, hd, _⟩ := C.kernel.factor S.group f (fun X p ↦ by
    change p ≫ K.inclusion.hom.hom ≫ (𝟙 S.group.X * σ.hom.hom.hom⁻¹) = 1
    rw [MonObj.comp_mul, GrpObj.comp_inv, Category.comp_id,
      ← Grp.comp_hom_hom, hfix, mul_inv_cancel, MonObj.comp_one])
  have hformula (b : Character S.group) :
      w.val b = b * a.val ^ (-pairing S.group b d) := by
    have hh : σ.hom ≫ b = w.val b := by rw [Q.splitImage.characterAction, hσ']
    have hcomp : b * (w.val b)⁻¹ = (a.val ≫ d) ≫ b := by
      rw [hd, ← hh]
      apply Grp.hom_ext
      change b.hom.hom * (σ.hom.hom.hom ≫ b.hom.hom)⁻¹ =
        (𝟙 S.group.X * σ.hom.hom.hom⁻¹) ≫ b.hom.hom
      rw [MonObj.mul_comp, GrpObj.inv_comp, Category.id_comp]
    have hp := (pairing_eq_iff b d _).mpr rfl
    change d ≫ b = powerMorphism (pairing S.group b d) at hp
    rw [Category.assoc, hp, powerMorphism_eq_zpow] at hcomp
    have hp' : a.val ≫ (𝟙 Gm[k] : Character Gm[k]) ^ pairing S.group b d =
        a.val ^ pairing S.group b d := by
      rw [show a.val ≫ (𝟙 Gm[k] : Character Gm[k]) ^ pairing S.group b d =
        precomposeCharacter a.val ((𝟙 Gm[k]) ^ pairing S.group b d) from rfl, map_zpow]
      simp [precomposeCharacter]
    rw [hp'] at hcomp
    calc
      w.val b = b * (b * (w.val b)⁻¹)⁻¹ := by
        rw [mul_inv_rev, inv_inv, ← mul_assoc, mul_comm b (w.val b),
          mul_assoc, mul_inv_cancel, mul_one]
      _ = b * a.val ^ (-pairing S.group b d) := by rw [hcomp, zpow_neg]
  have htwo : pairing S.group a.val d = 2 := by
    let B := latticeAction Q.splitImage
    rw [← hpair]
    apply reflection_pairing_two (B w) P
    · exact a.property.1
    · intro h
      apply hw
      exact latticeAction_injective Q (h.trans (map_one B).symm)
    · intro x
      change (B w * B w) x = x
      rw [← map_mul, ← pow_two, hw_sq, map_one]
      rfl
    · intro x
      change Additive.ofMul (w.val x.toMul) = x - P x (Additive.ofMul d) • Additive.ofMul a.val
      rw [hformula]
      change x + (-pairing S.group x.toMul d) • Additive.ofMul a.val = _
      rw [← hpair, ofMul_toMul, neg_smul, sub_eq_add_neg]
  refine ⟨⟨C, L, l, hl, hlocal, m, hm, ⟨A, hswap⟩, w, n, ?_, hwproj, hw_sq, hσ_sq, hfix, d,
    (Grp.forget _).congr_map hd, hformula, htwo⟩⟩
  simpa only [g, gH, j, Grp.comp_hom_hom, Category.assoc] using hn

end ReflectionConstruction

