private abbrev pointsHom {A B : GroupScheme k} (f : A ⟶ B) (R : TestAlgebra k) :
    GroupPoints A R →* GroupPoints B R :=
  ((groupPointsFunctor k).map f |>.app R).hom

private theorem trivial_character_of_values {J : GroupScheme k} (hJ : IsAffine J.X.left)
    (b : Character J) (h : ∀ R (t : GroupPoints J R), characterValue b R t = 1) : b = 1 := by
  apply group_hom_ext hJ
  intro R t
  apply (unitEquiv R).injective
  apply Units.ext
  exact (characterValue_eq_unit b R t).symm.trans
    ((h R t).trans ((characterValue_one R t).symm.trans (characterValue_eq_unit 1 R t)))

/-- A test point of the dual-number scheme is obtained by first extending
coefficients and then mapping the infinitesimal generator to a square-zero element. -/
private theorem dualNumber_testPoint_factors
    (R : TestAlgebra k) (t : Points (testSpec k |>.obj (op (CommAlgCat.of k (DualNumber k)))) R) :
    ∃ q : CommAlgCat.of k (DualNumber R) ⟶ R,
      constants R ≫ q = 𝟙 R ∧
        (testSpec k).map (dualMap (CommAlgCat.ofHom (Algebra.ofId k R)) ≫ q).op = t := by
  let δ := ((algSpec.fullyFaithful (R := CommRingCat.of k)).preimage t).unop
  let z := δ.hom (DualNumber.eps : DualNumber k)
  have hz : z * z = 0 := by rw [← map_mul, DualNumber.eps_mul_eps, map_zero]
  let q : CommAlgCat.of k (DualNumber R) ⟶ R :=
    CommAlgCat.ofHom (DualNumber.lift (R := k) (A := R)
      ⟨(AlgHom.id k R, z), hz, fun a ↦ Commute.all _ _⟩)
  refine ⟨q, ?_, ?_⟩
  · apply CommAlgCat.hom_ext
    ext r
    exact DualNumber.lift_apply_inl _ r
  · have h : dualMap (CommAlgCat.ofHom (Algebra.ofId k R)) ≫ q = δ := by
      apply CommAlgCat.hom_ext
      apply DualNumber.algHom_ext
      let c := CommAlgCat.ofHom (Algebra.ofId k R)
      change q.hom ((dualMap c).hom DualNumber.eps) = z
      have he : (dualMap c).hom DualNumber.eps = (DualNumber.eps : DualNumber R) :=
        TrivSqZeroExt.ext (map_zero c.hom) (map_one c.hom)
      rw [he]
      exact DualNumber.lift_apply_eps _
    rw [h]
    exact (algSpec.fullyFaithful (R := CommRingCat.of k)).map_preimage t

private theorem mapPoints_identity {X : SchemeOver k} {R : TestAlgebra k} (p : Points X R) :
    mapPoints (𝟙 R) p = p := by
  change (testSpec k).map (𝟙 R).op ≫ p = p
  rw [op_id, (testSpec k).map_id, Category.id_comp]

private theorem weight_tangent_centralizes {J : GroupScheme k} (T : ClosedSubgroup G.val)
    (j : J ⟶ T.group) (b : Character T.group)
    {v : Lie k G.val} (hv : v ∈ adjointWeightVectors T b) (hb : j ≫ b = 1) :
    Centralizes (j ≫ T.inclusion) v.toMul.val := by
  apply (centralizes_iff_affine _ _).mpr
  intro R p t
  obtain ⟨q, hq₁, hq₂⟩ := dualNumber_testPoint_factors R p
  have hval : characterValue b R (pointsHom j R t) = 1 := by
    rw [← characterValue_composition, hb, characterValue_one]
  have hscale : scale R 1 = 𝟙 _ := by
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro z
    change (⟨z.fst, 1 * z.snd⟩ : DualNumber R) = z
    exact TrivSqZeroExt.ext rfl (one_mul _)
  have h := hv R (pointsHom j R t)
  change mapPoints (constants R) (pointsHom T.inclusion R (pointsHom j R t)) *
    mapPoints (dualMap (CommAlgCat.ofHom (Algebra.ofId k R))) v.toMul.val *
    (mapPoints (constants R) (pointsHom T.inclusion R (pointsHom j R t)))⁻¹ =
    mapPoints (scale R (characterValue b R (pointsHom j R t)))
      (mapPoints (dualMap (CommAlgCat.ofHom (Algebra.ofId k R))) v.toMul.val) at h
  have hcomp : pointsHom T.inclusion R (pointsHom j R t) =
      pointsHom (j ≫ T.inclusion) R t := by
    change (t ≫ j.hom.hom) ≫ T.inclusion.hom.hom = t ≫ j.hom.hom ≫ T.inclusion.hom.hom
    exact Category.assoc _ _ _
  rw [hval, hscale, mapPoints_identity, hcomp] at h
  have h' : Commute (mapPoints (constants R) (pointsHom (j ≫ T.inclusion) R t))
      (mapPoints (dualMap (CommAlgCat.ofHom (Algebra.ofId k R))) v.toMul.val) :=
    mul_inv_eq_iff_eq_mul.mp h
  have h'' := (h'.map (((groupPointsFunctor k).obj G.val).map q).hom).symm
  change Commute
    (mapPoints q (mapPoints (dualMap (CommAlgCat.ofHom (Algebra.ofId k R))) v.toMul.val))
    (mapPoints q (mapPoints (constants R) (pointsHom (j ≫ T.inclusion) R t))) at h''
  rw [← mapPoints_comp, ← mapPoints_comp, hq₁, mapPoints_identity] at h''
  simpa only [mapPoints, hq₂] using h''

private theorem lieImage_centralizer {J : GroupScheme k} (j : J ⟶ G.val)
    (C : ClosedSubgroup G.val) (hC : RepresentsSubgroup C (fun _ g ↦ Centralizes j g))
    (v : Lie k G.val) : v ∈ lieImage C ↔ Centralizes j v.toMul.val := by
  constructor
  · rintro ⟨y, rfl⟩
    exact (hC _ _).mpr ⟨y.toMul.val, rfl⟩
  · intro hv
    obtain ⟨w, hw⟩ := (hC _ _).mp hv
    have hw' : reduceTangentPoints C.group w = 1 := by
      letI := C.isClosedImmersion
      haveI : Mono C.inclusion.hom.hom := Over.mono_of_mono_left _
      apply (cancel_mono C.inclusion.hom.hom).mp
      change ((testSpec k).map (dualReduction k).op ≫ w) ≫ C.inclusion.hom.hom =
        1 ≫ C.inclusion.hom.hom
      rw [Category.assoc, hw, MonObj.one_comp]
      exact v.toMul.property
    exact ⟨Additive.ofMul ⟨w, hw'⟩, Subtype.ext hw⟩

private theorem lieImage_open_component (C : ClosedSubgroup G.val) (H : ClosedSubgroup C.group)
    (hH : IsOpenImmersion H.inclusion.hom.hom.left) :
    lieImage (subgroupOfSubgroup C H) = lieImage C := by
  ext v
  change (∃ w, mapPointKernel (H.inclusion ≫ C.inclusion) w = v) ↔
    ∃ w, mapPointKernel C.inclusion w = v
  simp only [((lieFunctoriality k).2.2 _ _ _ H.inclusion C.inclusion)]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨_, hw⟩
  · rintro ⟨w, hw⟩
    obtain ⟨y, rfl⟩ := tangent_surjective_of_open H hH w
    exact ⟨y, hw⟩

private theorem centralizer_lieWeight_iff {J : GroupScheme k} (ha : IsAffine J.X.left)
    (T : ClosedSubgroup G.val) (j : J ⟶ T.group)
    (C : ClosedSubgroup G.val) (hC : RepresentsSubgroup C
      (fun _ g ↦ Centralizes (j ≫ T.inclusion) g))
    (H : ClosedSubgroup C.group) (ho : IsOpenImmersion H.inclusion.hom.hom.left)
    (b : Character T.group) (v : Lie k G.val) (hv : v ∈ adjointWeightVectors T b)
    (hn : v ≠ 0) : v ∈ lieImage (subgroupOfSubgroup C H) ↔ j ≫ b = 1 := by
  rw [lieImage_open_component C H ho, lieImage_centralizer _ C hC]
  constructor
  · intro h
    apply trivial_character_of_values ha
    intro R t
    let c := dualMap (CommAlgCat.ofHom (Algebra.ofId k R))
    have hcomm := (centralizes_iff (j ≫ T.inclusion) v.toMul.val).mp h _
      ((testSpec k).map c.op) (mapPoints (constants R) t)
    have hh := hcomm.symm
    change Commute (pointsHom (j ≫ T.inclusion) _ (mapPoints (constants R) t))
      (mapPoints c v.toMul.val) at hh
    rw [← onPoints_mapPoints] at hh
    rw [characterValue_composition]
    exact characterValue_eq_one_of_nonzero_fixedWeight G T b v hv hn R (pointsHom j R t) hh
  · exact weight_tangent_centralizes T j b hv

private theorem subgroup_in_centralizer_component {J : GroupScheme k} {j : J ⟶ G.val}
    (C : ClosedSubgroup G.val) (H : ClosedSubgroup C.group) (hH : IsReducedIdentityComponent H)
    (hC : RepresentsSubgroup C (fun _ g ↦ Centralizes j g))
    (U : ClosedSubgroup G.val) (hs : Smooth U.group.X.hom) (hc : ConnectedSpace U.group.X.left)
    (hcent : Centralizes j U.inclusion.hom.hom) : IsSubgroupOf U (subgroupOfSubgroup C H) := by
  obtain ⟨i, hi⟩ := (hC _ _).mp hcent
  obtain ⟨f, hf⟩ := factor_group_through_subgroup C U.inclusion i hi
  obtain ⟨u, hu⟩ := factors_reduced_component H hH f hs hc
  exact ⟨u, by change u ≫ H.inclusion ≫ C.inclusion = _; rw [← Category.assoc, hu, hf]⟩

private theorem torus_in_centralizer_component {J : GroupScheme k} (T : ClosedSubgroup G.val)
    (hT : IsSplitTorus T.group) (j : J ⟶ T.group)
    (C : ClosedSubgroup G.val) (H : ClosedSubgroup C.group) (hH : IsReducedIdentityComponent H)
    (hC : RepresentsSubgroup C (fun _ g ↦ Centralizes (j ≫ T.inclusion) g)) :
    IsSubgroupOf T (subgroupOfSubgroup C H) := by
  obtain ⟨hc, _⟩ := RootData.CharacterPairing.perfectCharacterPairing T.group hT
  letI := hc
  apply subgroup_in_centralizer_component C H hH hC T
    (splitTorusSmooth hT) (splitTorus_connected hT)
  apply (centralizes_iff _ _).mpr
  intro R t z
  change Commute (IsMonHom.monoidHom T.inclusion.hom.hom R t)
    (IsMonHom.monoidHom T.inclusion.hom.hom R (z ≫ j.hom.hom))
  exact (Commute.all t (z ≫ j.hom.hom)).map (IsMonHom.monoidHom T.inclusion.hom.hom R)

private theorem additive_root_in_centralizer_component {J : GroupScheme k}
    (T : ClosedSubgroup G.val) (j : J ⟶ T.group)
    (C : ClosedSubgroup G.val) (H : ClosedSubgroup C.group) (hH : IsReducedIdentityComponent H)
    (hC : RepresentsSubgroup C (fun _ g ↦ Centralizes (j ≫ T.inclusion) g))
    (U : ClosedSubgroup G.val) (b : Character T.group) (hb : j ≫ b = 1)
    (hU : IsRootSubgroup T U b) {A : RootGroups.AdditiveLine k} (x : A.group ≅ U.group)
    (hx : HasScalarAction T b (x.hom ≫ U.inclusion)) :
    IsSubgroupOf U (subgroupOfSubgroup C H) := by
  have hc : ConnectedSpace U.group.X.left :=
    (((Grp.forget (SchemeOver k) ⋙ Over.forget _).mapIso x).hom.homeomorph.connectedSpace_iff).mp
      (inferInstanceAs (ConnectedSpace (PrimeSpectrum (Polynomial k))))
  apply subgroup_in_centralizer_component C H hH hC U hU.1 hc
  apply (centralizes_iff_affine _ _).mpr
  intro R t z
  obtain ⟨a, ha⟩ := (RootData.RootGroups.additivePoints A R).surjective (t ≫ x.inv.hom.hom)
  have hp : rootPoint (x.hom ≫ U.inclusion) R a = t ≫ U.inclusion.hom.hom := by
    rw [rootPoint_eq, ha, Category.assoc]
    exact congrArg (fun f : U.group ⟶ G.val ↦ t ≫ f.hom.hom) (x.inv_hom_id_assoc _)
  have h := hx R (pointsHom j R z) a
  have hb' : characterValue b R (pointsHom j R z) = 1 := by
    rw [← characterValue_composition, hb, characterValue_one]
  rw [hb', one_mul, hp] at h
  exact (mul_inv_eq_iff_eq_mul.mp h).symm

private theorem diagonalCentralizer_reductive {J : GroupScheme k}
    (ha : IsAffine J.X.left) (hG : IsReductive G)
    (S : ClosedSubgroup G.val) (hS : IsMaximalSplitTorus S) (j : J ⟶ S.group)
    (C : ClosedSubgroup G.val) (hC : RepresentsSubgroup C
      (fun _ g ↦ Centralizes (j ≫ S.inclusion) g))
    (H : ClosedSubgroup C.group) (ho : IsOpenImmersion H.inclusion.hom.hom.left)
    (hs : Smooth H.group.X.hom) (hc : GeometricallyConnected H.group.X.hom) :
    IsReductive (closedSubgroupAlgebraicGroup (G := closedSubgroupAlgebraicGroup C) H) := by
  let B := closedSubgroupAlgebraicGroup (G := closedSubgroupAlgebraicGroup C) H
  apply reductive_of_geometricGroupReductive B hs hc
  let K := AlgebraicClosure k
  let GK := GeometricGroup G
  let F := groupBaseChange k K
  obtain ⟨T, hT, ⟨hiT, hmT⟩, i, hi⟩ := RelativeChambers.maximalTorusOverSplitTorus G hG S hS
  let TK : ClosedSubgroup GK.val := baseChangedSubgroup K T hiT
  have hTK : IsSplitTorus TK.group :=
    split_of_torus ((isTorus_iff_coordinates (closedSubgroupAlgebraicGroup TK)).mp hmT.1)
  obtain ⟨hclC, hCK⟩ := centralizerSchemeBaseChange k K (j ≫ S.inclusion) C hC
  let CK : ClosedSubgroup GK.val := baseChangedSubgroup K C hclC
  let HK : ClosedSubgroup CK.group :=
    baseChangedSubgroup K H (baseChangeClosedSubgroup k K H.inclusion H.isClosedImmersion)
  let D := subgroupOfSubgroup CK HK
  let jK : F.obj J ⟶ TK.group := F.map (j ≫ i)
  have hCK' : RepresentsSubgroup CK (fun _ g ↦ Centralizes (jK ≫ TK.inclusion) g) := by
    have h : jK ≫ TK.inclusion = F.map (j ≫ S.inclusion) := by
      change F.map (j ≫ i) ≫ F.map T.inclusion = _
      rw [← Functor.map_comp, Category.assoc, hi]
    rw [h]
    exact hCK
  have hGK : IsReductive GK := geometricGroupReductive G hG
  have hoK : IsOpenImmersion HK.inclusion.hom.hom.left :=
    MorphismProperty.of_isPullback (baseChangeMapIsPullback K H.inclusion.hom.hom).flip ho
  have hsK : Smooth HK.group.X.hom := MorphismProperty.pullback_snd _ _ hs
  have hcK : GeometricallyConnected HK.group.X.hom := MorphismProperty.pullback_snd _ _ hc
  have hHK : IsReducedIdentityComponent HK := by
    letI := hcK
    exact reducedIdentityComponent_of_open_closed HK hoK hsK
      (GeometricallyConnected.connectedSpace_of_subsingleton HK.group.X.hom)
  have hTD : IsSubgroupOf TK D := torus_in_centralizer_component TK hTK jK CK HK hHK hCK'
  letI := ha
  have hja : IsAffine (F.obj J).X.left := isAffine_baseChange K J
  have hy (b : Character TK.group) (v : Lie K GK.val) (hv : v ∈ adjointWeightVectors TK b)
      (hn : v ≠ 0) : v ∈ lieImage D ↔ jK ≫ b = 1 :=
    centralizer_lieWeight_iff hja TK jK CK hCK' HK hoK b v hv hn
  have hroots := (RootData.RootGroups.rootSubgroups GK hGK TK hTK
    (maximalTorus_over_closure GK TK hmT)).2
  apply Relative.ReductiveLieCentralizers.reductiveOfSymmetricRoots GK hGK D hsK hcK TK hmT hTD
  · rintro b ⟨hb, v, hv, hmem, hn⟩
    have habs : b ∈ absoluteRoots TK := ⟨hb, v, hv, hn⟩
    obtain ⟨hb', w, hw, hn'⟩ := (((hroots b habs).2.1 b⁻¹).mpr (Or.inr rfl)).1
    refine ⟨hb', w, hw, (hy _ _ hw hn').mpr ?_, hn'⟩
    change precomposeCharacter jK (b⁻¹) = 1
    rw [map_inv, show precomposeCharacter jK b = 1 from (hy _ _ hv hn).mp hmem, inv_one]
  · rintro b ⟨hb, v, hv, hmem, hn⟩ U hU
    have habs : b ∈ absoluteRoots TK := ⟨hb, v, hv, hn⟩
    obtain ⟨_, _, V, hV, _, _, ⟨A, x, hx⟩, hu⟩ := hroots b habs
    exact subgroupOf_trans (hu U hU).2
      (additive_root_in_centralizer_component TK jK CK HK hHK hCK' V b
        ((hy _ _ hv hn).mp hmem) hV x hx)

end FullKernelCentralizer

