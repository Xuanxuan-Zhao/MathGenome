/-- The subgroup generated by the reflections is transitive on the realized
regular sign patterns. Maximizing the sum of products of root evaluations
works even when the roots are proportional or do not span the lattice. -/
theorem signPatterns_transitive_of_reflections {I : Type t} [Finite I]
    (A : W →* X ≃ₗ[ℤ] X) (action : W → Equiv.Perm I)
    (P : X →ₗ[ℤ] Y →ₗ[ℤ] ℤ) (root : I → X) (coroot : I → Y) (r : I → W)
    (hroot : ∀ w i, A w (root i) = root (action w i))
    (htwo : ∀ i, P (root i) (coroot i) = 2)
    (hreflect : ∀ i x, A (r i) x = x - P x (coroot i) • root i)
    (f g : X →ₗ[ℤ] ℤ) (hf : ∀ i, f (root i) ≠ 0) (hg : ∀ i, g (root i) ≠ 0) :
    ∃ w ∈ Subgroup.closure (Set.range r), ∀ i, 0 < f (root i) ↔ 0 < g (A w (root i)) := by
  classical
  let := Fintype.ofFinite I
  let H := Subgroup.closure (Set.range r)
  let := Fintype.ofFinite H
  let C (i j : I) := P (root j) (coroot i)
  let rowDot (i : I) := ∑ j, f (root j) * C i j
  let rowSq (i : I) := ∑ j, C i j ^ 2
  have hc (i j : I) : C i (action (r i) j) = -C i j := by
    dsimp [C]
    rw [← hroot, hreflect, map_sub, LinearMap.sub_apply, map_smul,
      LinearMap.smul_apply, htwo]
    change P (root j) (coroot i) - P (root j) (coroot i) * 2 = _
    ring
  have hreflected (i j : I) (l : X →ₗ[ℤ] ℤ) :
      l (root (action (r i) j)) = l (root j) - C i j * l (root i) := by
    rw [← hroot, hreflect, map_sub, map_smul]
    rfl
  have hdot (i : I) : 2 * rowDot i = f (root i) * rowSq i := by
    have hperm := Equiv.sum_comp (action (r i)) (fun j ↦ f (root j) * C i j)
    simp only [hreflected, hc] at hperm
    have hsum : rowDot i = -rowDot i + f (root i) * rowSq i := by
      calc
        rowDot i = ∑ j, (f (root j) - C i j * f (root i)) * -C i j := hperm.symm
        _ = ∑ j, (-(f (root j) * C i j) + f (root i) * C i j ^ 2) := by
          apply Finset.sum_congr rfl
          intro j _
          ring
        _ = -rowDot i + f (root i) * rowSq i := by
          rw [Finset.sum_add_distrib, Finset.sum_neg_distrib, ← Finset.mul_sum]
    linarith
  have hsquare (i : I) : 0 < rowSq i := by
    have hle : C i i ^ 2 ≤ rowSq i :=
      Finset.single_le_sum (f := fun j ↦ C i j ^ 2) (fun j _ ↦ sq_nonneg (C i j))
        (Finset.mem_univ i)
    have hii : C i i = 2 := htwo i
    rw [hii] at hle
    linarith
  let score (w : H) := ∑ j, f (root j) * g (A w.val (root j))
  obtain ⟨w, _, hw⟩ := Finset.exists_max_image Finset.univ score ⟨1, Finset.mem_univ _⟩
  refine ⟨w.val, w.property, ?_⟩
  intro i
  let s : H := ⟨r i, Subgroup.subset_closure ⟨i, rfl⟩⟩
  let l : X →ₗ[ℤ] ℤ := g.comp (A w.val).toLinearMap
  have hscore : score (w * s) = score w - l (root i) * rowDot i := by
    calc
      score (w * s) = ∑ j, f (root j) * (l (root j) - C i j * l (root i)) := by
        apply Finset.sum_congr rfl
        intro j _
        change f (root j) * g (A (w.val * r i) (root j)) = _
        rw [map_mul, LinearEquiv.mul_apply, hroot]
        exact congrArg (f (root j) * ·) (hreflected i j l)
      _ = ∑ j, (f (root j) * l (root j) - l (root i) * (f (root j) * C i j)) := by
        apply Finset.sum_congr rfl
        intro j _
        ring
      _ = score w - l (root i) * rowDot i := by
        rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
        rfl
  have hmax := hw (w * s) (Finset.mem_univ _)
  rw [hscore] at hmax
  have hprod : 0 ≤ l (root i) * rowDot i := by linarith
  have hne : l (root i) ≠ 0 := by
    change g (A w.val (root i)) ≠ 0
    rw [hroot]
    exact hg _
  change 0 < f (root i) ↔ 0 < l (root i)
  constructor
  · intro hfi
    have hp := mul_pos hfi (hsquare i)
    have hdi := hdot i
    have hdp : 0 < rowDot i := by linarith
    exact lt_of_le_of_ne (nonneg_of_mul_nonneg_left hprod hdp) (Ne.symm hne)
  · intro hli
    have hdn : 0 ≤ rowDot i := nonneg_of_mul_nonneg_right hprod hli
    by_contra hnot
    have hfn : f (root i) < 0 := lt_of_le_of_ne (le_of_not_gt hnot) (hf i)
    have hp := mul_neg_of_neg_of_pos hfn (hsquare i)
    have hdi := hdot i
    linarith

end Lattice

open private finite_shear from LinearAlgebraicGroups.RootData.AbstractPairing

private theorem wallReflections_eq {X Y W : Type*} [AddCommGroup X] [AddCommGroup Y]
    [Module.IsTorsionFree ℤ X] [Group W] [Finite W]
    (A : W →* X ≃ₗ[ℤ] X) (hA : Function.Injective A)
    (P : X →ₗ[ℤ] Y →ₗ[ℤ] ℤ)
    {r s : W} {a b : X} {c d : Y} {m n : ℤ}
    (hm : m ≠ 0) (hn : n ≠ 0) (hab : m • a = n • b)
    (ha : P a c = 2) (hb : P b d = 2) (hs₂ : s ^ 2 = 1)
    (hr : ∀ x, A r x = x - P x c • a) (hs : ∀ x, A s x = x - P x d • b) : r = s := by
  have hra : A r a = -a := by
    rw [hr, ha]
    module
  have hsb : A s b = -b := by
    rw [hs, hb]
    module
  have hrb : A r b = -b := by
    apply smul_right_injective X hn
    calc
      n • A r b = A r (n • b) := (map_smul _ _ _).symm
      _ = A r (m • a) := congrArg (A r) hab.symm
      _ = -(m • a) := by rw [map_smul, hra, smul_neg]
      _ = n • (-b) := by rw [hab, smul_neg]
  have hsa : A s a = -a := by
    apply smul_right_injective X hm
    calc
      m • A s a = A s (m • a) := (map_smul _ _ _).symm
      _ = A s (n • b) := congrArg (A s) hab
      _ = -(n • b) := by rw [map_smul, hsb, smul_neg]
      _ = m • (-a) := by rw [← hab, smul_neg]
  let Δ := (P.flip d).smulRight b - (P.flip c).smulRight a
  have hΔ (x : X) : Δ x = P x d • b - P x c • a := rfl
  have hprod (x : X) : A (r * s) x = x + Δ x := by
    rw [map_mul, LinearEquiv.mul_apply, hs, map_sub, map_smul, hr x, hrb, hΔ]
    module
  have hΔa : Δ a = 0 := by
    have he := hprod a
    rw [map_mul, LinearEquiv.mul_apply, hsa, map_neg, hra, neg_neg] at he
    exact add_left_cancel (he.symm.trans (add_zero _).symm)
  have hΔb : Δ b = 0 := by
    have he := hprod b
    rw [map_mul, LinearEquiv.mul_apply, hsb, map_neg, hrb, neg_neg] at he
    exact add_left_cancel (he.symm.trans (add_zero _).symm)
  have hzero := finite_shear A (r * s) Δ hprod (fun x ↦ by
    change Δ (P x d • b - P x c • a) = 0
    simp only [map_sub, map_smul, hΔa, hΔb, smul_zero, sub_zero])
  have he : r * s = 1 := hA (LinearEquiv.ext fun x ↦ by
    rw [hprod, hzero, LinearMap.zero_apply, add_zero, map_one]
    rfl)
  calc
    r = (r * s) * s := by rw [mul_assoc, ← pow_two, hs₂, mul_one]
    _ = s := by rw [he, one_mul]

