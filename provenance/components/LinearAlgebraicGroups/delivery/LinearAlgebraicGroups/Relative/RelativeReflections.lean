private theorem weight_in_subgroup_iff {H : ClosedSubgroup G.val}
    (S : ClosedSubgroup G.val) (T : ClosedSubgroup H.group) (i : S.group ≅ T.group)
    (hi : i.hom ≫ T.inclusion ≫ H.inclusion = S.inclusion)
    (b : Character T.group) (v : Lie k H.group) :
    mapPointKernel H.inclusion v ∈ adjointWeightVectors S (i.hom ≫ b) ↔
      v ∈ adjointWeightVectors T b := by
  have ht (R : TestAlgebra k) (t : GroupPoints S.group R) :
      pointsHom H.inclusion R (pointsHom T.inclusion R (pointsHom i.hom R t)) =
        pointsHom S.inclusion R t := by
    change ((t ≫ i.hom.hom.hom) ≫ T.inclusion.hom.hom) ≫ H.inclusion.hom.hom = _
    simp only [Category.assoc]
    exact congrArg (fun j : S.group ⟶ G.val ↦ t ≫ j.hom.hom) hi
  have hv (R : TestAlgebra k) (t : GroupPoints S.group R) :
      characterValue b R (pointsHom i.hom R t) = characterValue (i.hom ≫ b) R t := by
    unfold characterValue
    change _ = ((algSpec.fullyFaithful (R := CommRingCat.of k)).preimage
      (t ≫ (i.hom ≫ b).hom.hom)).unop.hom _
    simp only [pointsHom, Grp.comp_hom_hom]
    rfl
  have compare (R : TestAlgebra k) (t : GroupPoints S.group R) :
      let A := CommAlgCat.of k (DualNumber R)
      let c := dualMap (CommAlgCat.ofHom (Algebra.ofId k R))
      let x := mapPoints c v.toMul.val
      let p := mapPoints (constants R) (pointsHom T.inclusion R (pointsHom i.hom R t))
      let y := mapPoints c (mapPointKernel H.inclusion v).toMul.val
      let q := mapPoints (constants R) (pointsHom S.inclusion R t)
      (q * y * q⁻¹ = mapPoints (scale R (characterValue (i.hom ≫ b) R t)) y) ↔
        (p * x * p⁻¹ = mapPoints (scale R (characterValue b R (pointsHom i.hom R t))) x) := by
    dsimp only
    rw [← (onPoints_injective H.inclusion H.isClosedImmersion
      (CommAlgCat.of k (DualNumber R))).eq_iff]
    simp only [map_mul, map_inv, onPoints_mapPoints, ht, hv]
    rfl
  constructor
  · intro hv' R t
    obtain ⟨s, rfl⟩ := (ConcreteCategory.bijective_of_isIso
      (((groupPointsFunctor k).map i.hom).app R)).2 t
    exact (compare R s).mp (hv' R s)
  · intro hv' R t
    exact (compare R t).mpr (hv' R (pointsHom i.hom R t))

/-- A closed subgroup containing the torus inherits the ambient weights
whose nonzero vectors lie in its Lie algebra. -/
private theorem relativeRoots_of_closed_subgroup (S J : ClosedSubgroup G.val)
    (j : S.group ⟶ J.group) (hj : j ≫ J.inclusion = S.inclusion)
    (hclosed : IsClosedImmersion j.hom.hom.left) (P : Character S.group → Prop)
    (h : ∀ (b : Character S.group) (v : Lie k G.val),
      v ∈ adjointWeightVectors S b → v ≠ 0 → (v ∈ lieImage J ↔ P b)) :
    relativeRoots (⟨S.group, j, hclosed⟩ : ClosedSubgroup J.group) =
      {b ∈ relativeRoots S | P b} := by
  let T : ClosedSubgroup J.group := ⟨S.group, j, hclosed⟩
  have hi : (Iso.refl S.group).hom ≫ T.inclusion ≫ J.inclusion = S.inclusion := by
    change (𝟙 S.group) ≫ j ≫ J.inclusion = _
    rw [Category.id_comp, hj]
  have hweight (b : Character S.group) (v : Lie k J.group) :
      mapPointKernel J.inclusion v ∈ adjointWeightVectors S b ↔ v ∈ adjointWeightVectors T b := by
    have hw := weight_in_subgroup_iff (H := J) S T (Iso.refl S.group) hi b v
    change _ ∈ adjointWeightVectors S ((𝟙 S.group) ≫ b) ↔ _ at hw
    rw [Category.id_comp] at hw
    exact hw
  have inj := lieMap_closed_injective J.inclusion J.isClosedImmersion
  ext b
  change b ∈ relativeRoots T ↔ b ∈ relativeRoots S ∧ P b
  constructor
  · rintro ⟨hb, v, hv, hn⟩
    let w := mapPointKernel J.inclusion v
    have hw : w ∈ adjointWeightVectors S b := (hweight b v).mpr hv
    have hw₀ : w ≠ 0 := fun hz ↦ hn (inj (hz.trans (map_zero _).symm))
    exact ⟨⟨hb, w, hw, hw₀⟩, (h b w hw hw₀).mp ⟨v, rfl⟩⟩
  · rintro ⟨⟨hb, v, hv, hn⟩, hb'⟩
    obtain ⟨w, rfl⟩ := (h b v hv hn).mpr hb'
    exact ⟨hb, w, (hweight b w).mp hv, fun he ↦ hn (by rw [he, map_zero])⟩

private theorem sameCharacter_zpow_injective {S : GroupScheme k} (hS : IsSplitTorus S)
    {a : Character S} (ha : a ≠ 1) : Function.Injective (a ^ · : ℤ → Character S) := by
  obtain ⟨r, ⟨i⟩⟩ := splitPresentation hS
  letI : IsMulTorsionFree Specs.DiagonalizableGroups.IntegerCharacters.{u} :=
    Function.Injective.isMulTorsionFree
      (MulEquiv.ulift : Specs.DiagonalizableGroups.IntegerCharacters.{u} ≃* Multiplicative ℤ).toMonoidHom
      (MulEquiv.ulift : Specs.DiagonalizableGroups.IntegerCharacters.{u} ≃* Multiplicative ℤ).injective
  let M := Specs.CharacterDescent.StandardLattice.{u} r
  let χ := (diagonalCharacter (k := k) M).symm
  let e := χ.toMonoidHom.comp (precomposeCharacter i.hom)
  letI : IsMulTorsionFree (Character S) :=
    Function.Injective.isMulTorsionFree e (fun _ _ h ↦ (cancel_epi i.hom).mp (χ.injective h))
  intro p q hpq
  change a ^ p = a ^ q at hpq
  apply sub_eq_zero.mp
  apply (IsMulTorsionFree.zpow_eq_one_iff_right ha).mp
  rw [zpow_sub, hpq, mul_inv_cancel]

private theorem rootPowers_twoChambers {T : ClosedSubgroup G.val} (a : Root T)
    (h : ∀ b : Root T, ∃ n : ℤ, b.val = a.val ^ n) (hT : IsSplitTorus T.group) :
    ∃ U : Set (Root T), IsChamber T U ∧ IsChamber T Uᶜ ∧ U ≠ Uᶜ ∧
      ∀ V, IsChamber T V → V = U ∨ V = Uᶜ := by
  obtain ⟨c, hc⟩ := exists_regular_cocharacter G T hT
  obtain ⟨f, hf, -⟩ := (RelativeChambers.chamberCocharacters G T hT _).mpr ⟨c, hc, rfl⟩
  let U : Set (Root T) := {b | 0 < f (Additive.ofMul b.val)}
  have hU : IsChamber T U := ⟨f, hf, rfl⟩
  have hneg : -f ∈ regularRealCocharacters T := by
    intro b
    change -f (Additive.ofMul b.val) ≠ 0
    exact neg_ne_zero.mpr (hf b)
  have hUc : Uᶜ = {b : Root T | 0 < (-f) (Additive.ofMul b.val)} := by
    ext b
    change (¬ 0 < f (Additive.ofMul b.val)) ↔ 0 < -f (Additive.ofMul b.val)
    rw [not_lt, Left.neg_pos_iff]
    exact ⟨fun h ↦ lt_of_le_of_ne h (hf b), le_of_lt⟩
  have hne : U ≠ Uᶜ := by
    intro he
    have hh : a ∈ U ↔ ¬ a ∈ U := Set.ext_iff.mp he a
    tauto
  refine ⟨U, hU, ⟨-f, hneg, hUc⟩, hne, ?_⟩
  have same (f₀ g₀ : Specs.Relative.RelativeChambers.RealCocharacterSpace T)
      (hf₀ : f₀ ∈ regularRealCocharacters T) (hg₀ : g₀ ∈ regularRealCocharacters T)
      (hfg : 0 < f₀ (Additive.ofMul a.val) ↔ 0 < g₀ (Additive.ofMul a.val)) :
      {b : Root T | 0 < f₀ (Additive.ofMul b.val)} =
        {b : Root T | 0 < g₀ (Additive.ofMul b.val)} := by
    ext b
    obtain ⟨n, hn⟩ := h b
    change (0 < f₀ (Additive.ofMul b.val)) ↔ 0 < g₀ (Additive.ofMul b.val)
    rw [hn]
    change (0 < f₀ (n • Additive.ofMul a.val)) ↔ 0 < g₀ (n • Additive.ofMul a.val)
    rw [map_smul, map_smul, zsmul_eq_mul, zsmul_eq_mul]
    by_cases hp : 0 < f₀ (Additive.ofMul a.val)
    · rw [mul_pos_iff_of_pos_right hp, mul_pos_iff_of_pos_right (hfg.mp hp)]
    · have hf' := lt_of_le_of_ne (le_of_not_gt hp) (hf₀ a)
      have hg' := lt_of_le_of_ne (le_of_not_gt (fun hp' ↦ hp (hfg.mpr hp'))) (hg₀ a)
      rw [mul_pos_iff, mul_pos_iff]
      simp only [hf'.not_gt, hg'.not_gt, and_false, false_or, hf', hg', and_true]
  intro V
  rintro ⟨g, hg, rfl⟩
  by_cases hfg : (0 < g (Additive.ofMul a.val)) ↔ 0 < f (Additive.ofMul a.val)
  · exact Or.inl (same g f hg hf hfg)
  · right
    rw [hUc]
    apply same g (-f) hg hneg
    have hn : 0 < (-f) (Additive.ofMul a.val) ↔ ¬ 0 < f (Additive.ofMul a.val) := by
      change (0 < -f (Additive.ofMul a.val)) ↔ ¬ 0 < f (Additive.ofMul a.val)
      rw [Left.neg_pos_iff, not_lt]
      exact ⟨le_of_lt, fun h ↦ lt_of_le_of_ne h (hf a)⟩
    rw [hn]
    tauto

private theorem oppositeRoot_of_rootPowers (hG : IsReductive G)
    (T : ClosedSubgroup G.val) (hT : IsMaximalSplitTorus T)
    (a : Root T) (h : ∀ b : Root T, ∃ n : ℤ, b.val = a.val ^ n) :
    a.val⁻¹ ∈ relativeRoots T := by
  obtain ⟨U, hU, hV, hne, hall⟩ := rootPowers_twoChambers a h hT.1
  obtain ⟨Q, _⟩ := RelativeWeylScheme.finiteConstantQuotient G hG T hT
  obtain ⟨A⟩ := normalizerChambers G hG T hT Q
  obtain ⟨w, hw⟩ := A.simplyTransitive U Uᶜ hU hV
  have hb : A.permutation w a ≠ a := by
    intro he
    have hi : a ∈ A.permutation w '' U ↔ a ∈ U := by
      constructor
      · rintro ⟨b, hb, hb'⟩
        exact ((A.permutation w).injective (hb'.trans he.symm)) ▸ hb
      · intro hmem
        exact ⟨a, hmem, he⟩
    rw [hw.1] at hi
    change (¬ a ∈ U) ↔ a ∈ U at hi
    tauto
  have hwsq : w ^ 2 = 1 := by
    obtain ⟨z, hz, hallz, hzsq, -⟩ := twoChamberLabels Q A ⟨U, Uᶜ, hU, hV, hne, hall⟩
    rcases hallz w with h₁ | h₂
    · simp [h₁]
    · exact h₂.symm ▸ hzsq
  obtain ⟨n, hn⟩ := h (A.permutation w a)
  have hn' : w.val a.val = a.val ^ n := (A.root_eq w a).symm.trans hn
  have hmul : w.val (w.val a.val) = a.val := by
    exact congrArg (fun w : Q.splitImage.labels ↦ w.val a.val)
      (show w * w = 1 by simpa [pow_two] using hwsq)
  have hn₂ : n * n = 1 := by
    apply sameCharacter_zpow_injective hT.1 a.property.1
    calc
      a.val ^ (n * n) = (a.val ^ n) ^ n := zpow_mul _ _ _
      _ = w.val (w.val a.val) := by
        rw [← hn', ← map_zpow, ← hn']
      _ = a.val ^ (1 : ℤ) := hmul.trans (zpow_one _).symm
  have hn₁ : n = -1 := by
    rcases Int.mul_eq_one_iff_eq_one_or_neg_one.mp hn₂ with h₁ | h₂
    · exfalso
      exact hb (Subtype.ext (hn.trans (by rw [h₁.1, zpow_one])))
    · exact h₂.1
  rw [hn₁, zpow_neg_one] at hn
  exact hn ▸ (A.permutation w a).property

set_option maxHeartbeats 3500000 in
/-- The centralizer is smooth and its connected component sees exactly the
weights in the integral cyclic subgroup generated by the given root. -/
theorem rootCentralizers : RootCentralizers.{u} := by
  intro k _ G hG S hS a
  obtain ⟨K⟩ := characterKernels S.group hS.1 a.val a.property.1
  let D := subgroupOfSubgroup S K.subgroup
  obtain ⟨r, ⟨i⟩⟩ := splitPresentation hS.1
  letI := hG.1
  letI := K.subgroup.isClosedImmersion
  have : IsIso i.inv.hom.hom.left := (Grp.forget _ ⋙ Over.forget _).map_isIso i.inv
  let d := K.subgroup.inclusion ≫ i.inv
  have hd : IsClosedImmersion d.hom.hom.left := IsClosedImmersion.comp _ _
  obtain ⟨C, hC, hsC⟩ := DiagonalizableFixedLocus.diagonalizableCentralizerSmooth G D d hd
  obtain ⟨H, hH, ho, hs, hc⟩ := smoothIdentityComponent (closedSubgroupAlgebraicGroup C) hsC
  let J := subgroupOfSubgroup C H
  let B := closedSubgroupAlgebraicGroup (G := closedSubgroupAlgebraicGroup C) H
  have hDaff : IsAffine K.subgroup.group.X.left := (closedSubgroupAlgebraicGroup D).property.1
  have hB : IsReductive B :=
    diagonalCentralizer_reductive hDaff hG S hS K.subgroup.inclusion C hC H ho hs hc
  obtain ⟨j, hj⟩ := torus_in_centralizer_component S hS.1 K.subgroup.inclusion C H hH hC
  let T : ClosedSubgroup B.val := ⟨S.group, j, factor_closed hj⟩
  have hT : IsMaximalSplitTorus T := by
    refine ⟨hS.1, ?_⟩
    rintro U hU ⟨v, hv⟩
    have hSU : IsSubgroupOf S (subgroupOfSubgroup J U) :=
      ⟨v, by change v ≫ U.inclusion ≫ J.inclusion = S.inclusion; rw [← Category.assoc, hv]; exact hj⟩
    obtain ⟨u, hu⟩ := hS.2 _ hU hSU
    haveI : Mono J.inclusion := inclusion_mono J
    exact ⟨u, (cancel_mono J.inclusion).mp (by
      change (u ≫ j) ≫ J.inclusion = U.inclusion ≫ J.inclusion
      rw [Category.assoc, hj]
      exact hu)⟩
  have hi : (Iso.refl S.group).hom ≫ T.inclusion ≫ J.inclusion = S.inclusion := by
    change (𝟙 _) ≫ j ≫ J.inclusion = _
    rw [Category.id_comp, hj]
  have hLie (b : Character S.group) (v : Lie k G.val)
      (hv : v ∈ adjointWeightVectors S b) (hn : v ≠ 0) :
      v ∈ lieImage J ↔ K.subgroup.inclusion ≫ b = 1 :=
    centralizer_lieWeight_iff hDaff S _ C hC H ho b v hv hn
  have hr₀ : relativeRoots T = {b ∈ relativeRoots S | ∃ n : ℤ, b = a.val ^ n} :=
    relativeRoots_of_closed_subgroup S J j hj (factor_closed hj) _
      (fun b v hv hn ↦ (hLie b v hv hn).trans (K.trivialRestrict_iff b))
  have hr (b : Character S.group) : b ∈ relativeRoots T ↔
      b ∈ relativeRoots S ∧ ∃ n : ℤ, b = a.val ^ n := Set.ext_iff.mp hr₀ b
  let b : Root T := ⟨a.val, (hr a.val).mpr ⟨a.property, 1, (zpow_one _).symm⟩⟩
  have hp (x : Root T) : ∃ n : ℤ, x.val = b.val ^ n := ((hr x.val).mp x.property).2
  refine ⟨⟨K, C, hC, hsC, H, hH, ho, hB, T, Iso.refl _, hi, hT, hLie, ?_, ?_, ?_, ?_⟩⟩
  · simp only [Iso.refl_hom, Category.id_comp, Set.image_id']
    exact hr₀
  · exact ⟨b.val, b.property, Category.id_comp _⟩
  · exact ⟨b.val⁻¹, oppositeRoot_of_rootPowers hB T hT b hp, Category.id_comp _⟩
  · obtain ⟨U, hU, hUc, hne, h₀⟩ := rootPowers_twoChambers b hp hT.1
    exact ⟨U, Uᶜ, hU, hUc, hne, h₀⟩

end CentralizerChambers


/-- Every relative root has an integral reflection represented in the
identity component of its full kernel centralizer. -/
theorem rootReflections : RootReflections.{u} :=
  reflectionOfCentralizer rootCentralizers

/-- The relative root datum and its simply transitive Weyl chamber action. -/
theorem relativeRootDatum : RelativeRootDatum.{u} :=
  relativeRootDatumAssembly rootReflections normalizerChambers

end

end LinearAlgebraicGroups.Relative.RelativeReflections
