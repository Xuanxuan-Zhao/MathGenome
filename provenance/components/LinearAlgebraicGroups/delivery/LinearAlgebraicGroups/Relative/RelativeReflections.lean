private def precomposeCharacter {A B : GroupScheme k} (i : A ⟶ B) :
    Character B →* Character A where
  toFun f := i ≫ f
  map_one' := Grp.hom_ext _ _ (MonObj.comp_one _)
  map_mul' _ _ := Grp.hom_ext _ _ (MonObj.comp_mul _ _ _)

private def diagonalCharacter (M : Type u) [CommGroup M] :
    M ≃* Character (specGroup (groupAlgebra k M)) :=
  (integerHomEquiv M).trans (splitGroupHomEquiv (k := k) IntegerCharacters M)

private theorem diagonalCharacter_pullback {M N : Type u} [CommGroup M] [CommGroup N]
    (f : M →* N) (m : M) :
    specGroupMap (groupAlgebraMap k f) ≫ diagonalCharacter M m = diagonalCharacter N (f m) := by
  change specGroupMap (groupAlgebraMap k f) ≫
    specGroupMap (groupAlgebraMap k (integerHomEquiv M m)) =
    specGroupMap (groupAlgebraMap k (integerHomEquiv N (f m)))
  rw [← specGroupMap_comp]
  congr 1
  apply CommHopfAlgCat.hom_ext
  change (MonoidAlgebra.mapDomainBialgHom k f).comp
    (MonoidAlgebra.mapDomainBialgHom k (integerHomEquiv M m)) = _
  rw [← MonoidAlgebra.mapDomainBialgHom_comp]
  congr 1
  ext z
  exact map_zpow f m z.down.toAdd

private theorem descend_trivial_on_kernel {S Q L : GroupScheme k}
    {q : S ⟶ Q} {K : ClosedSubgroup S} (hK : IsSchemeKernel q K)
    [Flat q.hom.hom.left] [Surjective q.hom.hom.left] [QuasiCompact q.hom.hom.left]
    (f : S ⟶ L) (hf : K.inclusion.hom.hom ≫ f.hom.hom = 1) :
    ∃! g : Q ⟶ L, q ≫ g = f := by
  let p := q.hom.hom
  have hp : Epi p := epiOver_of_flat_surjective _
  obtain ⟨g, hg⟩ := descendOver p f.hom.hom (fun a b hab ↦ by
    obtain ⟨v, hv⟩ := difference_in_kernel hK hab
    rw [← hv, MonObj.mul_comp, Category.assoc, hf, MonObj.comp_one, mul_one])
  have : Flat (p ⊗ₘ p).left := tensorHom_property _ _ @Flat inferInstance inferInstance
  have : Surjective (p ⊗ₘ p).left :=
    tensorHom_property _ _ @Surjective inferInstance inferInstance
  have : Epi (p ⊗ₘ p) := epiOver_of_flat_surjective _
  have h₁ : η[Q.X] ≫ g = η[L.X] := by
    rw [← IsMonHom.one_hom p, Category.assoc, hg, IsMonHom.one_hom]
  have h₂ : μ[Q.X] ≫ g = (g ⊗ₘ g) ≫ μ[L.X] := by
    rw [← cancel_epi (p ⊗ₘ p), ← IsMonHom.mul_hom_assoc, hg,
      IsMonHom.mul_hom, tensorHom_comp_tensorHom_assoc, hg]
  let l : Q ⟶ L := Grp.homMk'' g h₁ h₂
  refine ⟨l, Grp.hom_ext _ _ hg, fun y hy ↦ Grp.hom_ext _ _ ((cancel_epi p).mp ?_)⟩
  exact ((Grp.forget _).congr_map hy).trans hg.symm

/-- The full kernel is dual to the quotient of the character lattice by the
cyclic subgroup generated by the character. -/
theorem characterKernels : CharacterKernels.{u} := by
  classical
  intro k _ S hS a ha
  obtain ⟨r, ⟨i⟩⟩ := splitPresentation hS
  let M := StandardLattice.{u} r
  let χ := diagonalCharacter (k := k) M
  let m := χ.symm (i.hom ≫ a)
  have hm : χ m = i.hom ≫ a := χ.apply_symm_apply _
  have hm₁ : m ≠ 1 := by
    intro e
    have h : i.hom ≫ a = i.hom ≫ (1 : Character S) := by
      rw [← hm, e, map_one]
      exact (Grp.hom_ext _ _ (MonObj.comp_one _)).symm
    exact ha ((cancel_epi i.hom).mp h)
  let N := Subgroup.zpowers m
  let z : IntegerCharacters →* N := (integerHomEquiv M m).codRestrict N
    (fun t ↦ Subgroup.zpow_mem_zpowers m t.down.toAdd)
  letI : IsMulTorsionFree IntegerCharacters.{u} :=
    Function.Injective.isMulTorsionFree
      (MulEquiv.ulift : IntegerCharacters.{u} ≃* Multiplicative ℤ).toMonoidHom
      (MulEquiv.ulift : IntegerCharacters.{u} ≃* Multiplicative ℤ).injective
  have hz : Function.Bijective z := by
    constructor
    · intro t t' he
      have hh : m ^ (t.down.toAdd - t'.down.toAdd) = 1 := by
        rw [zpow_sub, show m ^ t.down.toAdd = m ^ t'.down.toAdd from congrArg Subtype.val he,
          mul_inv_cancel]
      have hh' := (IsMulTorsionFree.zpow_eq_one_iff_right hm₁).mp hh
      have ht : t.down.toAdd = t'.down.toAdd := sub_eq_zero.mp hh'
      exact ULift.ext ht
    · intro t
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp t.property
      exact ⟨⟨Multiplicative.ofAdd n⟩, Subtype.ext hn⟩
  let e := MulEquiv.ofBijective z hz
  let j : specGroup (groupAlgebra k N) ≅ Gm[k] :=
    (hopfSpec (CommRingCat.of k)).mapIso
      (CommHopfAlgCat.isoMk (MonoidAlgebra.domCongrBialgEquiv k k e)).op
  let q := diagonalRestriction k N
  have hqa : q ≫ j.hom = i.hom ≫ a := by
    rw [← hm]
    change specGroupMap (groupAlgebraMap k N.subtype) ≫
      specGroupMap (groupAlgebraMap k e.toMonoidHom) =
      specGroupMap (groupAlgebraMap k (integerHomEquiv M m))
    rw [← specGroupMap_comp]
    congr 1
    apply CommHopfAlgCat.hom_ext
    change (MonoidAlgebra.mapDomainBialgHom k N.subtype).comp
      (MonoidAlgebra.mapDomainBialgHom k e.toMonoidHom) = _
    rw [← MonoidAlgebra.mapDomainBialgHom_comp]
    rfl
  obtain ⟨hc, hf, hs, hp, hK, _⟩ :=
    DiagonalizableGroups.diagonalRestrictionKernelAndQuotient k M N
  letI : IsClosedImmersion (diagonalClosedInclusion k N).hom.hom.left := hc
  have : IsIso i.hom.hom.hom.left :=
    (Grp.forget _ ⋙ Over.forget _).map_isIso i.hom
  let K : ClosedSubgroup S :=
    ⟨specGroup (groupAlgebra k (M ⧸ N)), diagonalClosedInclusion k N ≫ i.hom,
      IsClosedImmersion.comp _ _⟩
  have ha' : a = i.inv ≫ q ≫ j.hom := by rw [hqa, i.inv_hom_id_assoc]
  have hai : a.hom.hom.left = i.inv.hom.hom.left ≫ q.hom.hom.left ≫ j.hom.hom.hom.left :=
    congrArg (fun f : S ⟶ Gm[k] ↦ f.hom.hom.left) ha'
  have hiso : IsIso i.inv.hom.hom.left :=
    (Grp.forget _ ⋙ Over.forget _).map_isIso i.inv
  have hjiso : IsIso j.hom.hom.hom.left :=
    (Grp.forget _ ⋙ Over.forget _).map_isIso j.hom
  have tr (P : MorphismProperty Scheme.{u}) [P.RespectsIso]
      (h : P q.hom.hom.left) : P a.hom.hom.left := by
    rw [hai]
    rwa [P.cancel_left_of_respectsIso, P.cancel_right_of_respectsIso]
  have hk : IsSchemeKernel a K := by
    apply hK.of_iso (Iso.refl _) ((Grp.forget _).mapIso i) (Iso.refl _)
      ((Grp.forget _).mapIso j)
    · rfl
    · change toUnit K.group.X ≫ (𝟙 _) = (𝟙 K.group.X) ≫ toUnit _
      rw [Category.comp_id, Category.id_comp]
    · exact (Grp.forget _).congr_map hqa
    · change η[(specGroup (groupAlgebra k N)).X] ≫ j.hom.hom.hom = (𝟙 _) ≫ η[Gm[k].X]
      rw [Category.id_comp, IsMonHom.one_hom]
  letI : Flat a.hom.hom.left := tr @Flat hf
  letI : Surjective a.hom.hom.left := tr @Surjective hs
  letI : LocallyOfFinitePresentation a.hom.hom.left := tr @LocallyOfFinitePresentation hp
  letI : IsAffineHom a.hom.hom.left := tr @IsAffineHom (restrictionProperties (k := k) N).2.2.2
  letI : QuasiCompact a.hom.hom.left := inferInstance
  refine ⟨⟨K, hk, inferInstance, inferInstance, inferInstance, ?_, ?_⟩⟩
  · intro b
    let p := χ.symm (i.hom ≫ b)
    have hb : χ p = i.hom ≫ b := χ.apply_symm_apply _
    have he : K.inclusion ≫ b = diagonalCharacter (k := k) (M ⧸ N) (QuotientGroup.mk p) := by
      change (diagonalClosedInclusion k N ≫ i.hom) ≫ b = _
      rw [Category.assoc, ← hb]
      exact diagonalCharacter_pullback (QuotientGroup.mk' N) p
    rw [he, ← map_one (diagonalCharacter (k := k) (M ⧸ N)),
      (diagonalCharacter (k := k) (M ⧸ N)).injective.eq_iff, QuotientGroup.eq_one_iff,
      Subgroup.mem_zpowers_iff]
    constructor
    · rintro ⟨n, hn⟩
      refine ⟨n, (cancel_epi i.hom).mp ?_⟩
      calc
        i.hom ≫ b = χ p := hb.symm
        _ = χ (m ^ n) := congrArg χ hn.symm
        _ = (i.hom ≫ a) ^ n := by rw [map_zpow, hm]
        _ = i.hom ≫ a ^ n := (map_zpow (precomposeCharacter i.hom) a n).symm
    · rintro ⟨n, rfl⟩
      refine ⟨n, χ.injective ?_⟩
      rw [map_zpow, hm, hb]
      exact (map_zpow (precomposeCharacter i.hom) a n).symm
  · intro L f h
    apply descend_trivial_on_kernel hk f
    simpa only [Category.id_comp, Grp.comp_hom_hom, CategoryTheory.Hom.one_def]
      using h _ (𝟙 _)
end CharacterKernels

private def rootEmbedding (S : ClosedSubgroup G.val) :
    Root S ↪ Additive (Character S.group) :=
  ⟨fun a ↦ Additive.ofMul a.val, fun _ _ h ↦ Subtype.ext (congrArg Additive.toMul h)⟩

private theorem latticeAction_injective {S : ClosedSubgroup G.val} (D : QuotientData S) :
    Function.Injective (latticeAction D.splitImage) := by
  intro w z h
  apply Subtype.ext
  apply MulEquiv.ext
  intro b
  exact congrArg (fun e : Additive (Character S.group) ≃ₗ[ℤ] Additive (Character S.group) ↦
    Additive.toMul (e (Additive.ofMul b))) h

private theorem dualEquiv_eq_pushforward {S : ClosedSubgroup G.val} [IsCommMonObj S.group.X]
    (D : QuotientData S)
    (P : Additive (Character S.group) →ₗ[ℤ] Additive (Cocharacter S.group) →ₗ[ℤ] ℤ)
    [P.IsPerfPair]
    (hP : ∀ x y, P (Additive.ofMul x) (Additive.ofMul y) = pairing S.group x y)
    (w : D.splitImage.labels) (c : Cocharacter S.group) :
    dualEquiv P (latticeAction D.splitImage w) (Additive.ofMul c) =
      Additive.ofMul (c ≫ (D.splitImage.conjugation w).hom) := by
  let A := latticeAction D.splitImage w
  apply P.flip.toPerfPair.injective
  ext x
  change P x (dualEquiv P A (Additive.ofMul c)) =
    P x (Additive.ofMul (c ≫ (D.splitImage.conjugation w).hom))
  rw [← A.apply_symm_apply x, dualEquiv_pair]
  let b : Character S.group := Additive.toMul (A.symm x)
  change P (Additive.ofMul b) (Additive.ofMul c) =
    P (Additive.ofMul (w.val b)) (Additive.ofMul (c ≫ (D.splitImage.conjugation w).hom))
  rw [D.splitImage.characterAction, hP, hP]
  unfold pairing compositionPairing
  simp [Category.assoc]

/-- Once the kernel centralizers provide the actual integral reflections,
the perfect pairing and the Weyl chamber action assemble the datum. -/
theorem relativeRootDatumAssembly : RelativeRootDatumAssembly.{u} := by
  classical
  intro reflections chamberAction k _ G hG S hS D
  obtain ⟨hcomm, hfreeX, hfinX, hfreeY, hfinY, P, hperf, hP⟩ :=
    RootData.CharacterPairing.perfectCharacterPairing S.group hS.1
  letI := hcomm
  letI := hfreeX
  letI := hperf
  letI : Finite (Root S) := RelativeChambers.relativeRootsFinite G S hS.1
  letI : Finite D.splitImage.labels := D.splitImage.finite
  let R (i : Root S) := Classical.choice (reflections G hG S hS D i)
  obtain ⟨act⟩ := chamberAction G hG S hS D
  let A := latticeAction D.splitImage
  let α := rootEmbedding S
  let c (i : Root S) := Additive.ofMul (R i).coroot
  let r (i : Root S) := (R i).label
  have hroot (w : D.splitImage.labels) (i : Root S) : A w (α i) = α (act.permutation w i) :=
    congrArg Additive.ofMul (act.root_eq w i).symm
  have htwo (i : Root S) : P (α i) (c i) = 2 :=
    (hP _ _).trans (R i).rootPairing
  have href (i : Root S) (x : Additive (Character S.group)) :
      A (r i) x = x - P x (c i) • α i := by
    change Additive.ofMul ((R i).label.val x.toMul) = x - P x (c i) • α i
    rw [(R i).characterFormula]
    change x + (-pairing S.group x.toMul (R i).coroot) • α i = _
    rw [← hP, ofMul_toMul, neg_smul, sub_eq_add_neg]
  let data := rootDatum A P α c r (fun w ↦ act.permutation w) hroot htwo href
  have hco (w : D.splitImage.labels) (i : Root S) :
      c (act.permutation w i) = dualEquiv P (A w) (c i) :=
    (coroot_equivariant A P α c r (fun w ↦ act.permutation w) hroot htwo href w i).symm
  have hr (w : D.splitImage.labels) (i : Root S) :
      r (act.permutation w i) = w * r i * w⁻¹ := by
    apply latticeAction_injective D
    apply LinearEquiv.ext
    intro x
    change A (r (act.permutation w i)) x = A (w * r i * w⁻¹) x
    have hm : A (w * r i * w⁻¹) x = A w (A (r i) ((A w).symm x)) := by
      simp only [map_mul, map_inv]
      rfl
    have hmap (p q : Additive (Character S.group)) (n : ℤ) :
        A w (p - n • q) = A w p - n • A w q := by
      change (A w).toLinearMap (p - n • q) = (A w).toLinearMap p - n • (A w).toLinearMap q
      rw [LinearMap.map_sub, LinearMap.map_smul]
    rw [href, hco, hm, href, hmap, hroot, LinearEquiv.apply_symm_apply]
    rw [← dualEquiv_pair P (A w) ((A w).symm x) (c i), LinearEquiv.apply_symm_apply]
  refine ⟨hcomm, ⟨{
    finiteRoots := inferInstance
    freeCharacters := hfreeX
    finiteCharacters := hfinX
    freeCocharacters := hfreeY
    finiteCocharacters := hfinY
    reflection := R
    rootDatum := data
    root_eq := fun _ ↦ rfl
    coroot_eq := fun _ ↦ rfl
    pairing_eq := hP
    normalizerPerm := act.permutation
    rootAction := act.root_eq
    corootAction := ?_
    reflectionAction := hr
    sameWall := ?_
    generates := ?_
    chamberPreservation := act.preserves
    chamberAction := act.simplyTransitive }⟩⟩
  · intro w i
    exact congrArg Additive.toMul ((hco w i).trans (dualEquiv_eq_pushforward D P hP w (R i).coroot))
  · intro a b h
    obtain ⟨m, n, hm, hn, he⟩ := h
    exact wallReflections_eq A (latticeAction_injective D) P hm hn
      (show m • α a = n • α b from congrArg Additive.ofMul he)
      (htwo a) (htwo b) (R b).involution (href a) (href b)
  · obtain ⟨U, hU⟩ := act.existsChamber
    apply top_unique
    intro w _
    let V := act.permutation w '' U
    have hV : Specs.Relative.RelativeChambers.IsChamber S V := act.preserves w U hU
    obtain ⟨a, ha, haU⟩ := (RelativeChambers.chamberCocharacters G S hS.1 U).mp hU
    obtain ⟨b, hb, hbV⟩ := (RelativeChambers.chamberCocharacters G S hS.1 V).mp hV
    let f := P.flip (Additive.ofMul a)
    let g := P.flip (Additive.ofMul b)
    have hfa (i : Root S) : f (α i) = pairing S.group i.val a := hP _ _
    have hgb (i : Root S) : g (α i) = pairing S.group i.val b := hP _ _
    obtain ⟨v, hv, hsign⟩ := signPatterns_transitive_of_reflections A
      (fun z ↦ act.permutation z) P α c r hroot htwo href f g
      (fun i ↦ (hfa i).symm ▸ ha i) (fun i ↦ (hgb i).symm ▸ hb i)
    have hmem (i : Root S) : i ∈ U ↔ act.permutation v i ∈ V := by
      have hh := hsign i
      rw [hroot, hfa, hgb] at hh
      rw [← haU, ← hbV]
      change (0 ≤ pairing S.group i.val a) ↔ (0 ≤ pairing S.group (act.permutation v i).val b)
      exact ⟨fun h ↦ le_of_lt (hh.mp (lt_of_le_of_ne h (Ne.symm (ha i)))),
        fun h ↦ le_of_lt (hh.mpr (lt_of_le_of_ne h (Ne.symm (hb (act.permutation v i)))))⟩
    have hact : act.permutation v '' U = V := by
      ext j
      constructor
      · rintro ⟨i, hi, rfl⟩
        exact (hmem i).mp hi
      · intro hj
        refine ⟨(act.permutation v).symm j, (hmem _).mpr ?_, Equiv.apply_symm_apply _ _⟩
        rwa [Equiv.apply_symm_apply]
    have he : v = w := (act.simplyTransitive U V hU hV).unique hact rfl
    exact he ▸ hv

section WeylAction

open CategoryTheory.CartesianMonoidalCategory
open Specs.Relative.RelativeChambers (IsChamber)
open Specs.Relative.RelativeWeylScheme (rationalProjection markedParabolic)
open Specs.GeometricRadicals (IsReductive)
open Specs.GeometricBorelConjugacy (ConjugatesSubgroups)
open Specs.Relative.MaximalSplitTori (IsMinimalParabolic)
open Specs.RankOneFlag (SameSubgroup)
open LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition existsLimitDecomposition)

open private quotientLabel quotientLabel_spec quotientLabel_conjugates actionOnRoots pointConj
  from LinearAlgebraicGroups.RootData.AbstractPairing
open private exists_regular_cocharacter map_parabolic_of_comp
  from LinearAlgebraicGroups.RootData.BorelsAndChambers
open private innerIso innerMap comp_innerMap transportSubgroup
  from LinearAlgebraicGroups.Reductive.BorelProper
open private conjugates_of_sameTransport from LinearAlgebraicGroups.Relative.MaximalSplitTori
open private constantRationalEquiv from LinearAlgebraicGroups.Relative.RelativeWeylScheme

private theorem quotientLabel_eq_of_projection {S : ClosedSubgroup G.val} (D : QuotientData S)
    (w : D.splitImage.labels) (n : 𝟙_ (SchemeOver k) ⟶ D.normalizer.group.X)
    (h : rationalProjection D n = D.splitImage.constantGroup.sectionPoint w) :
    quotientLabel D.splitImage n = w := by
  apply (constantRationalEquiv D.splitImage.constantGroup).injective
  change D.splitImage.constantGroup.sectionPoint (quotientLabel D.splitImage n) =
    D.splitImage.constantGroup.sectionPoint w
  have hn := quotientLabel_spec D.splitImage n
  rw [toUnit_unique (toUnit (𝟙_ (SchemeOver k))) (𝟙 _), Category.id_comp] at hn
  exact hn.symm.trans h

private theorem conjugates_limitParabolics {S : ClosedSubgroup G.val}
    (Q : QuotientData S) (w : Q.splitImage.labels)
    (n : 𝟙_ (SchemeOver k) ⟶ Q.normalizer.group.X)
    (hn : rationalProjection Q n = Q.splitImage.constantGroup.sectionPoint w)
    (a : Cocharacter S.group) (D : LimitDecomposition (a ≫ S.inclusion))
    (E : LimitDecomposition ((a ≫ (Q.splitImage.conjugation w).hom) ≫ S.inclusion)) :
    ConjugatesSubgroups (n ≫ Q.normalizer.inclusion.hom.hom) D.parabolic E.parabolic := by
  let g := n ≫ Q.normalizer.inclusion.hom.hom
  let e := Q.splitImage.conjugation w
  let F := innerIso g
  have htor : S.inclusion ≫ F.hom = e.hom ≫ S.inclusion := by
    apply Grp.hom_ext
    change S.inclusion.hom.hom ≫ (innerMap g).hom.hom = (e.hom ≫ S.inclusion).hom.hom
    rw [comp_innerMap]
    have h := quotientLabel_conjugates Q.splitImage n
    rw [quotientLabel_eq_of_projection Q w n hn] at h
    exact h.symm
  have hfor : (a ≫ S.inclusion) ≫ F.hom = (a ≫ e.hom) ≫ S.inclusion := by
    simp only [Category.assoc, htor]
  have hback : ((a ≫ e.hom) ≫ S.inclusion) ≫ F.inv = (a ≫ S.inclusion) := by
    rw [← hfor, Category.assoc, F.hom_inv_id, Category.comp_id]
  obtain ⟨i, hi⟩ := map_parabolic_of_comp G.property.1 F.hom hfor D E
  obtain ⟨j, hj⟩ := map_parabolic_of_comp G.property.1 F.inv hback E D
  apply conjugates_of_sameTransport g
  refine ⟨⟨i, hi⟩, ⟨j, ?_⟩⟩
  change j ≫ D.parabolic.inclusion ≫ F.hom = E.parabolic.inclusion
  calc
    j ≫ D.parabolic.inclusion ≫ F.hom =
        (j ≫ D.parabolic.inclusion) ≫ F.hom := (Category.assoc _ _ _).symm
    _ = (E.parabolic.inclusion ≫ F.inv) ≫ F.hom :=
      congrArg (fun f : E.parabolic.group ⟶ G.val ↦ f ≫ F.hom) hj
    _ = E.parabolic.inclusion := (Category.assoc _ _ _).trans
      ((congrArg (E.parabolic.inclusion ≫ ·) F.inv_hom_id).trans (Category.comp_id _))

open private subgroupIso_of_same from LinearAlgebraicGroups.RootData.RankOneFlag

private theorem conjugates_iff_of_known_conjugate
    {g : 𝟙_ (SchemeOver k) ⟶ G.val.X} {A B C : ClosedSubgroup G.val}
    (h : ConjugatesSubgroups g A B) :
    ConjugatesSubgroups g A C ↔ SameSubgroup B C := by
  obtain ⟨e, he⟩ := h
  have he' : (e.hom ≫ B.inclusion).hom.hom = pointConj g A.inclusion.hom.hom := he
  constructor
  · rintro ⟨f, hf⟩
    have hf' : (f.hom ≫ C.inclusion).hom.hom = pointConj g A.inclusion.hom.hom := hf
    have heq : f.hom ≫ C.inclusion = e.hom ≫ B.inclusion := Grp.hom_ext _ _ (hf'.trans he'.symm)
    refine ⟨⟨e.inv ≫ f.hom, ?_⟩, ⟨f.inv ≫ e.hom, ?_⟩⟩
    · rw [Category.assoc, heq, e.inv_hom_id_assoc]
    · rw [Category.assoc, ← heq, f.inv_hom_id_assoc]
  · intro hBC
    obtain ⟨j, hj⟩ := subgroupIso_of_same hBC
    refine ⟨e ≪≫ j, ?_⟩
    change ((e.hom ≫ j.hom) ≫ C.inclusion).hom.hom = _
    rw [Category.assoc, hj]
    exact he


/-- The action on adjoint weights recovers the simply transitive action on
minimal rational parabolics by conjugating their defining cocharacters. -/
theorem normalizerChambers : NormalizerChambers.{u} := by
  classical
  intro k _ G hG S hS Q
  obtain ⟨c, hc⟩ := exists_regular_cocharacter G S hS.1
  have hc' : IsRegular S c := hc
  obtain ⟨D⟩ := existsLimitDecomposition G (c ≫ S.inclusion)
  have hP := (RelativeChambers.minimalLimitParabolic G hG S hS c D).mpr hc'
  have hSP := (RelativeChambers.limitParabolicThroughSplitTorus G hG S hS.1 c D).2
  obtain ⟨_, equivalence, act, hproj, hrep, hconj, hsimple⟩ :=
    RelativeWeylScheme.relativeWeylAction G hG S D.parabolic hS hP hSP Q
  have hsurj : Function.Surjective (quotientLabel Q.splitImage) := by
    intro w
    obtain ⟨n, hn⟩ := hrep w
    exact ⟨n, quotientLabel_eq_of_projection Q w n hn⟩
  let p : Q.splitImage.labels →* Equiv.Perm (Root S) :=
    { toFun := actionOnRoots Q.splitImage hsurj
      map_one' := Equiv.ext fun i ↦ Subtype.ext rfl
      map_mul' := fun w z ↦ Equiv.ext fun i ↦ Subtype.ext rfl }
  have hp (w : Q.splitImage.labels) (i : Root S) : (p w i).val = w.val i.val := rfl
  have htransport (w : Q.splitImage.labels) (a : Cocharacter S.group) (i : Root S) :
      pairing S.group (p w i).val (a ≫ (Q.splitImage.conjugation w).hom) =
        pairing S.group i.val a := by
    rw [hp, Q.splitImage.characterAction]
    unfold pairing compositionPairing
    simp [Category.assoc]
  have hregular (w : Q.splitImage.labels) (a : Cocharacter S.group) (ha : IsRegular S a) :
      IsRegular S (a ≫ (Q.splitImage.conjugation w).hom) := by
    intro j
    obtain ⟨i, rfl⟩ := (p w).surjective j
    rw [htransport]
    exact ha i
  have himage (w : Q.splitImage.labels) (a : Cocharacter S.group) :
      p w '' nonnegativeRoots S a = nonnegativeRoots S (a ≫ (Q.splitImage.conjugation w).hom) := by
    ext j
    constructor
    · rintro ⟨i, hi, rfl⟩
      change 0 ≤ pairing S.group (p w i).val (a ≫ (Q.splitImage.conjugation w).hom)
      rw [htransport]
      exact hi
    · intro hj
      obtain ⟨i, rfl⟩ := (p w).surjective j
      refine ⟨i, ?_, rfl⟩
      change 0 ≤ pairing S.group (p w i).val (a ≫ (Q.splitImage.conjugation w).hom) at hj
      rwa [htransport] at hj
  let cham := RelativeChambers.chamberCocharacters G S hS.1
  refine ⟨⟨p, hp, ⟨_, (cham _).mpr ⟨c, hc', rfl⟩⟩, ?_, ?_⟩⟩
  · intro w U hU
    obtain ⟨a, ha, rfl⟩ := (cham U).mp hU
    exact (cham _).mpr ⟨_, hregular w a ha, (himage w a).symm⟩
  · intro U V hU hV
    obtain ⟨a, ha, rfl⟩ := (cham U).mp hU
    obtain ⟨b, hb, rfl⟩ := (cham V).mp hV
    obtain ⟨A⟩ := existsLimitDecomposition G (a ≫ S.inclusion)
    obtain ⟨B⟩ := existsLimitDecomposition G (b ≫ S.inclusion)
    have hA := (RelativeChambers.minimalLimitParabolic G hG S hS a A).mpr ha
    have hB := (RelativeChambers.minimalLimitParabolic G hG S hS b B).mpr hb
    have hSA := (RelativeChambers.limitParabolicThroughSplitTorus G hG S hS.1 a A).2
    have hSB := (RelativeChambers.limitParabolicThroughSplitTorus G hG S hS.1 b B).2
    let x := markedParabolic A.parabolic hA hSA
    let y := markedParabolic B.parabolic hB hSB
    have heq (w : Q.splitImage.labels) :
        p w '' nonnegativeRoots S a = nonnegativeRoots S b ↔
          @SMul.smul _ _ act.toSMul w x = y := by
      obtain ⟨n, hn⟩ := hrep w
      have hsection : equivalence (QuotientGroup.mk n) = w :=
        (constantRationalEquiv Q.splitImage.constantGroup).injective ((hproj n).symm.trans hn)
      obtain ⟨A'⟩ := existsLimitDecomposition G ((a ≫ (Q.splitImage.conjugation w).hom) ≫ S.inclusion)
      have hcA := conjugates_limitParabolics Q w n hn a A A'
      rw [himage]
      exact ((RelativeChambers.limitParabolicsEqual G hG S hS.1 _ _ A' B).symm.trans
        ((conjugates_iff_of_known_conjugate hcA).symm.trans (by
          rw [← hsection]
          exact hconj n A.parabolic B.parabolic hA hB hSA hSB)))
    obtain ⟨w, hw, hu⟩ := hsimple x y
    exact ⟨w, (heq w).mpr hw, fun z hz ↦ hu z ((heq z).mp hz)⟩

end WeylAction

section ReflectionConstruction

open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
