set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
set_option linter.style.haveILetI false

open private tensorHom_property from LinearAlgebraicGroups.Affine.Components

private theorem epi_over_of_flat_of_surjective {X Y : SchemeOver k} (f : X ⟶ Y)
    [Flat f.left] [Surjective f.left] : Epi f :=
  (Over.forget _).epi_of_epi_map (Flat.epi_of_flat_of_surjective f.left)

private theorem cancel_groupHom_of_flat_of_surjective {P Q H : GroupScheme k}
    (q : P ⟶ Q) [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    {f g : Q ⟶ H} (h : q ≫ f = q ≫ g) : f = g := by
  let := epi_over_of_flat_of_surjective q.hom.hom
  apply Grp.hom_ext
  exact (cancel_epi q.hom.hom).mp (congrArg (fun j : P ⟶ H ↦ j.hom.hom) h)

/-- A homomorphism that kills the entire scheme kernel descends through a
faithfully flat homomorphism between affine group schemes. -/
theorem descendHomOfSchemeKernel {P Q H : GroupScheme k} (q : P ⟶ Q)
    [IsAffine P.X.left] [IsAffine Q.X.left]
    [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    {E : ClosedSubgroup P} (hE : IsSchemeKernel q E) (f : P ⟶ H)
    (hf : E.inclusion.hom.hom ≫ f.hom.hom = 1) :
    ∃ g : Q ⟶ H, q ≫ g = f := by
  let q₀ := q.hom.hom
  let p := q₀.left
  let : IsRegularEpi p := isRegularEpi_of_flat_of_surjective_of_isAffine p
  have hs {X : SchemeOver k} (a b : X ⟶ P.X) (hab : a ≫ q₀ = b ≫ q₀) :
      a ≫ f.hom.hom = b ≫ f.hom.hom := by
    have h : (a⁻¹ * b) ≫ q₀ = toUnit X ≫ η[Q.X] := by
      change (a⁻¹ * b) ≫ q₀ = 1
      rw [MonObj.mul_comp, GrpObj.inv_comp, hab, inv_mul_cancel]
    let e := hE.lift (a⁻¹ * b) (toUnit X) h
    have he : e ≫ E.inclusion.hom.hom = a⁻¹ * b := hE.lift_fst _ _ _
    have hbe : b = a * (e ≫ E.inclusion.hom.hom) := by rw [he, mul_inv_cancel_left]
    calc
      a ≫ f.hom.hom = (a ≫ f.hom.hom) * 1 := (mul_one _).symm
      _ = b ≫ f.hom.hom := by
        rw [hbe, MonObj.mul_comp, Category.assoc, hf, MonObj.comp_one]
  let X := pullback q₀ q₀
  have he : IsPullback (pullback.fst q₀ q₀).left (pullback.snd q₀ q₀).left p p :=
    (IsPullback.of_hasPullback q₀ q₀).map (Over.forget _)
  have hcoeq : (pullback.fst q₀ q₀).left ≫ f.hom.hom.left =
      (pullback.snd q₀ q₀).left ≫ f.hom.hom.left :=
    congrArg (fun j : X ⟶ H.X ↦ j.left) (hs _ _ pullback.condition)
  obtain ⟨g, hg⟩ := IsRegularEpi.exists_of_isKernelPair p he f.hom.hom.left hcoeq
  have hw : g ≫ H.X.hom = Q.X.hom := by
    apply (cancel_epi p).mp
    rw [← Category.assoc, hg, f.hom.hom.w, q₀.w]
  let g₀ : Q.X ⟶ H.X := Over.homMk g hw
  have hg₀ : q₀ ≫ g₀ = f.hom.hom := Over.OverMorphism.ext hg
  have : Flat (q₀ ⊗ₘ q₀).left := tensorHom_property _ _ @Flat inferInstance inferInstance
  have : Surjective (q₀ ⊗ₘ q₀).left := tensorHom_property _ _ @Surjective inferInstance inferInstance
  have : Epi (q₀ ⊗ₘ q₀) := epi_over_of_flat_of_surjective _
  have h₁ : η[Q.X] ≫ g₀ = η[H.X] := by
    rw [← IsMonHom.one_hom q₀, Category.assoc, hg₀, IsMonHom.one_hom]
  have h₂ : μ[Q.X] ≫ g₀ = (g₀ ⊗ₘ g₀) ≫ μ[H.X] := by
    rw [← cancel_epi (q₀ ⊗ₘ q₀), ← IsMonHom.mul_hom_assoc, hg₀,
      IsMonHom.mul_hom, tensorHom_comp_tensorHom_assoc, hg₀]
  exact ⟨Grp.homMk'' g₀ h₁ h₂, Grp.hom_ext _ _ hg₀⟩

/-- The power homomorphism of a commutative group scheme. -/
def powerHom (S : GroupScheme k) [IsCommMonObj S.X] (n : ℕ) : S ⟶ S :=
  (𝟙 S) ^ n

@[simp] theorem powerHom_onSections (S : GroupScheme k) [IsCommMonObj S.X] (n : ℕ)
    {X : SchemeOver k} (s : X ⟶ S.X) : s ≫ (powerHom S n).hom.hom = s ^ n := by
  simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  change s ≫ (𝟙 S.X) ^ n = s ^ n
  rw [MonObj.comp_pow, Category.comp_id]

/-- The power map of an extension with commutative total group descends as
soon as its scheme kernel is annihilated by that power. -/
theorem descendPowerHom {P Q : GroupScheme k}
    (q : P ⟶ Q) [IsAffine P.X.left] [IsAffine Q.X.left]
    [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    [IsCommMonObj P.X] [IsCommMonObj Q.X]
    {E : ClosedSubgroup P} (hker : IsSchemeKernel q E)
    (n : ℕ) (hn : E.inclusion.hom.hom ^ n = 1) :
    ∃ s : Q ⟶ P, q ≫ s = powerHom P n ∧ s ≫ q = powerHom Q n := by
  obtain ⟨s, hs⟩ := descendHomOfSchemeKernel q hker (powerHom P n)
    ((powerHom_onSections P n E.inclusion.hom.hom).trans hn)
  refine ⟨s, hs, cancel_groupHom_of_flat_of_surjective q ?_⟩
  rw [← Category.assoc, hs]
  apply Grp.hom_ext
  change (powerHom P n).hom.hom ≫ q.hom.hom = q.hom.hom ≫ (powerHom Q n).hom.hom
  rw [powerHom_onSections]
  simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  change ((𝟙 P.X) ^ n) ≫ q.hom.hom = q.hom.hom ^ n
  rw [MonObj.pow_comp, Category.id_comp]

/-- A faithfully flat map with the scheme kernel of the power map pulls characters
back injectively onto precisely the powers in the source character group. -/
theorem characterPullback_of_powerKernel {T T₁ : GroupScheme k}
    (f : T ⟶ T₁) [IsCommMonObj T.X] [IsAffine T.X.left] [IsAffine T₁.X.left]
    [Flat f.hom.hom.left] [Surjective f.hom.hom.left]
    (n : ℕ) [Flat (powerHom T n).hom.hom.left] [Surjective (powerHom T n).hom.hom.left]
    {E : ClosedSubgroup T} (hE : IsSchemeKernel f E) (hpow : IsSchemeKernel (powerHom T n) E) :
    Function.Injective (fun χ : Character T₁ ↦ f ≫ χ) ∧
    ∀ χ : Character T, (∃ ψ : Character T₁, f ≫ ψ = χ) ↔ IsCharacterPower n χ := by
  have hcomp (χ : Character T) : powerHom T n ≫ χ = χ ^ n := by
    apply Grp.hom_ext
    change (powerHom T n).hom.hom ≫ χ.hom.hom = (χ ^ n).hom.hom
    simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
    change ((𝟙 T.X) ^ n) ≫ χ.hom.hom = χ.hom.hom ^ n
    rw [MonObj.pow_comp, Category.id_comp]
  refine ⟨fun _ _ ↦ cancel_groupHom_of_flat_of_surjective f, fun χ ↦ ?_⟩
  constructor
  · rintro ⟨ψ, rfl⟩
    have hzero : E.inclusion.hom.hom ≫ (f ≫ ψ).hom.hom = 1 := by
      change E.inclusion.hom.hom ≫ f.hom.hom ≫ ψ.hom.hom = 1
      rw [← Category.assoc, hE.w]
      exact MonObj.one_comp ψ.hom.hom
    obtain ⟨φ, hφ⟩ := descendHomOfSchemeKernel (powerHom T n) hpow (f ≫ ψ) hzero
    exact ⟨φ, (hcomp φ).symm.trans hφ⟩
  · rintro ⟨ψ, rfl⟩
    have hzero : E.inclusion.hom.hom ≫ (powerHom T n ≫ ψ).hom.hom = 1 := by
      change E.inclusion.hom.hom ≫ (powerHom T n).hom.hom ≫ ψ.hom.hom = 1
      rw [← Category.assoc, hpow.w]
      exact MonObj.one_comp ψ.hom.hom
    obtain ⟨φ, hφ⟩ := descendHomOfSchemeKernel f hE (powerHom T n ≫ ψ) hzero
    exact ⟨φ, hφ.trans (hcomp ψ)⟩

