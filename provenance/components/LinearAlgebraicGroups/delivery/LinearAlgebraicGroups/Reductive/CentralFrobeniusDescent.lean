private theorem quotientKernelPair {G Q : GroupScheme k} {q : G ⟶ Q}
    {E : ClosedSubgroup G} (hker : IsSchemeKernel q E) :
    IsPullback (prod.fst : G.X ⨯ E.group.X ⟶ G.X)
      (Specs.HomogeneousQuotient.rightMultiplication E) q.hom.hom q.hom.hom := by
  let i := E.inclusion.hom.hom
  let π := q.hom.hom
  let m := Specs.HomogeneousQuotient.rightMultiplication E
  have hi : IsClosedImmersion i.left := E.isClosedImmersion
  have : Mono i := Over.mono_of_mono_left _
  have hkill {Y : SchemeOver k} (e : Y ⟶ E.group.X) :
      (e ≫ i) ≫ π = 1 := by
    change (e ≫ i) ≫ π = toUnit Y ≫ η[Q.X]
    rw [Category.assoc, hker.w, ← Category.assoc, comp_toUnit]
  have hm {Y : SchemeOver k} (s : Y ⟶ G.X ⨯ E.group.X) :
      s ≫ m = (s ≫ prod.fst) * ((s ≫ prod.snd) ≫ i) := by
    simp [m, i, Specs.HomogeneousQuotient.rightMultiplication, MonObj.comp_mul, Category.assoc]
  have hw : prod.fst ≫ π = m ≫ π := by
    change prod.fst ≫ π = (prod.fst * (prod.snd ≫ i)) ≫ π
    rw [MonObj.mul_comp, hkill, mul_one]
  refine IsPullback.mk' hw ?_ ?_
  · intro Y a b hab hab'
    apply prod.hom_ext hab
    have hab'' := hab'
    change a ≫ m = b ≫ m at hab''
    rw [hm, hm, hab, mul_right_inj, cancel_mono] at hab''
    exact hab''
  · intro Y g h hgh
    have hdiff : (g⁻¹ * h) ≫ π = toUnit Y ≫ η[Q.X] := by
      change (g⁻¹ * h) ≫ π = 1
      rw [MonObj.mul_comp, GrpObj.inv_comp, hgh, inv_mul_cancel]
    let e := hker.lift (g⁻¹ * h) (toUnit Y) hdiff
    have he : e ≫ i = g⁻¹ * h := hker.lift_fst (g⁻¹ * h) (toUnit Y) hdiff
    refine ⟨prod.lift g e, prod.lift_fst _ _, ?_⟩
    change prod.lift g e ≫ m = h
    rw [hm, prod.lift_fst, prod.lift_snd, he, mul_inv_cancel_left]

/-- A quotient with radicial scheme kernel is radicial. Its diagonal is the
section of the kernel pair supplied by the identity of the kernel. -/
theorem universallyInjective_of_radicialKernel {G Q : GroupScheme k} {q : G ⟶ Q}
    {E : ClosedSubgroup G} (hker : IsSchemeKernel q E)
    (hE : UniversallyInjective E.group.X.hom) :
    UniversallyInjective q.hom.hom.left := by
  let q₀ := q.hom.hom.left
  let π : G.X ⨯ E.group.X ⟶ G.X := prod.fst
  let m := Specs.HomogeneousQuotient.rightMultiplication E
  let d : G.X ⟶ G.X ⨯ E.group.X := prod.lift (𝟙 _) (1 : G.X ⟶ E.group.X)
  have hd₁ : d ≫ π = 𝟙 G.X := prod.lift_fst _ _
  have hd₂ : d ≫ m = 𝟙 G.X := by
    simp [d, m, Specs.HomogeneousQuotient.rightMultiplication,
      MonObj.comp_mul, MonObj.one_comp]
  have hprod := Over.isPullback_of_binaryFan_isLimit _
    (prodIsProd G.X E.group.X)
  have hπ : UniversallyInjective π.left := MorphismProperty.of_isPullback hprod.flip hE
  have hd : Surjective d.left := by
    have := hπ
    constructor
    intro x
    refine ⟨π.left x, π.left.injective ?_⟩
    have heq : d.left ≫ π.left = 𝟙 _ := congrArg
      (fun f : G.X ⟶ G.X ↦ f.left) hd₁
    exact congrArg (fun f : G.X.left ⟶ G.X.left ↦ f (π.left x)) heq
  have hp := (quotientKernelPair hker).map (Over.forget (Spec (CommRingCat.of k)))
  have hp' : IsPullback π.left m.left q₀ q₀ := hp
  have hdiag : d.left ≫ hp'.isoPullback.hom = pullback.diagonal q₀ := by
    apply pullback.hom_ext
    · rw [Category.assoc, IsPullback.isoPullback_hom_fst, pullback.diagonal_fst]
      exact congrArg (fun f : G.X ⟶ G.X ↦ f.left) hd₁
    · rw [Category.assoc, IsPullback.isoPullback_hom_snd, pullback.diagonal_snd]
      exact congrArg (fun f : G.X ⟶ G.X ↦ f.left) hd₂
  apply (UniversallyInjective.iff_diagonal q₀).mpr
  rw [← hdiag]
  infer_instance

private theorem isNormalSubgroup_of_isCentral {H G : GroupScheme k} {i : H ⟶ G}
    (h : IsCentral i) : IsNormalSubgroup i := by
  refine ⟨snd G.X H.X, ?_⟩
  have he := h G.X (𝟙 G.X)
  change conjugateFamily i (𝟙 G.X) = fst H.X G.X ≫ i.hom.hom at he
  have he' := congrArg (fun f : H.X ⊗ G.X ⟶ G.X ↦
    lift (snd G.X H.X) (fst G.X H.X) ≫ f) he
  simpa [conjugateFamily, subgroupConjugation, MonObj.comp_mul, GrpObj.comp_inv,
    Category.assoc] using he'.symm

private theorem geometricallyReduced_of_affineFaithfullyFlat
    {X Y : Scheme.{u}} {b : Y ⟶ Spec (CommRingCat.of k)} {q : X ⟶ Y}
    [IsAffineHom q] [IsAffineHom b] [Flat q] [Surjective q]
    [GeometricallyReduced (q ≫ b)] : GeometricallyReduced b := by
  constructor
  intro K _ y Y' v u hy
  let X' := pullback q v
  let q' : X' ⟶ Y' := pullback.snd q v
  have hX : IsPullback (pullback.fst q v) (q' ≫ u) (q ≫ b) y :=
    (IsPullback.of_hasPullback q v).paste_vert hy
  have : IsReduced X' :=
    GeometricallyReduced.geometrically_isReduced y _ _ hX
  have : IsAffineHom u := MorphismProperty.of_isPullback hy inferInstance
  have : IsAffine Y' := isAffine_of_isAffineHom u
  have : IsAffine X' := isAffine_of_isAffineHom q'
  have hinj : Function.Injective q'.appTop :=
    ((Flat.flat_and_surjective_iff_faithfullyFlat_of_isAffine q').mp
      ⟨inferInstance, inferInstance⟩).injective
  have : _root_.IsReduced (Y'.presheaf.obj (Opposite.op ⊤)) :=
    isReduced_of_injective q'.appTop.hom hinj
  exact isReduced_of_isAffine_isReduced Y'

/-- A finite central subgroup has an affine fppf quotient. The quotient map
is finite, and smoothness and connectedness of the source pass to the quotient. -/
theorem finiteCentralQuotient (G : AffineAlgebraicGroup k) (E : ClosedSubgroup G.val)
    (hcentral : IsCentral E.inclusion) (hE : IsFinite E.group.X.hom)
    (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left) :
    ∃ (Q : AffineAlgebraicGroup k) (q : G.val ⟶ Q.val),
      IsFppfGroupQuotient E q ∧ IsFinite q.hom.hom.left ∧
      Smooth Q.val.X.hom ∧ ConnectedSpace Q.val.X.left := by
  obtain ⟨_, _, Q, q, _, _, hker, hfac, _, e, he⟩ :=
    normalAffineQuotient G E (isNormalSubgroup_of_isCentral hcentral)
  let q₀ := q.hom.hom.left
  have : Flat q₀ := hfac.2.1
  have : Surjective q₀ := hfac.2.2.1
  have : LocallyOfFinitePresentation q₀ := hfac.2.2.2.1
  have : IsAffineHom q₀ := hfac.2.2.2.2.1
  have : IsAffine Q.val.X.left := Q.property.1
  have : IsAffineHom Q.val.X.hom := inferInstance
  have : Smooth G.val.X.hom := hs
  have : GeometricallyReduced (q₀ ≫ Q.val.X.hom) := by
    rw [q.hom.hom.w]
    exact (affineGroupSmoothnessCriteria k G).1.mp hs
  have hred : GeometricallyReduced Q.val.X.hom :=
    geometricallyReduced_of_affineFaithfullyFlat (q := q₀)
  have hsQ := (affineGroupSmoothnessCriteria k Q).1.mpr hred
  have : ConnectedSpace G.val.X.left := hc
  have hcQ : ConnectedSpace Q.val.X.left := q₀.surjective.connectedSpace q₀.continuous
  refine ⟨Q, q, ⟨hker, inferInstance, inferInstance, inferInstance, e, he⟩, ?_, hsQ, hcQ⟩
  have hp := quotientKernelPair hker
  have hp₀ := hp.map (Over.forget _)
  have hprod := Over.isPullback_of_binaryFan_isLimit _
    (prodIsProd G.val.X E.group.X)
  have hfinite : IsFinite (prod.fst : G.val.X ⨯ E.group.X ⟶ G.val.X).left :=
    MorphismProperty.of_isPullback hprod.flip hE
  have hcover : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) q₀ :=
    ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩
  have hclosed₀ : UniversallyClosed (prod.fst : G.val.X ⨯ E.group.X ⟶ G.val.X).left := by
    have := hfinite
    infer_instance
  have hclosed : UniversallyClosed q₀ :=
    MorphismProperty.of_isPullback_of_descendsAlong (P := @UniversallyClosed)
      hp₀ hcover hclosed₀
  exact (IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).mpr
    ⟨IsIntegralHom.iff_universallyClosed_and_isAffineHom.mpr ⟨hclosed, inferInstance⟩,
      inferInstance⟩


private theorem commute_of_isCentral {E G : GroupScheme k} {i : E ⟶ G}
    (hi : IsCentral i) {Y : SchemeOver k} (a : Y ⟶ G.X) (e : Y ⟶ E.X) :
    Commute a (e ≫ i.hom.hom) := by
  have h := hi Y a
  have h' := congrArg (fun f : E.X ⊗ Y ⟶ G.X ↦ lift e (𝟙 Y) ≫ f) h
  have hconj : a * (e ≫ i.hom.hom) * a⁻¹ = e ≫ i.hom.hom := by
    simpa [Centralizes, conjugateFamily, MonObj.comp_mul, GrpObj.comp_inv,
      Category.assoc] using h'
  show a * (e ≫ i.hom.hom) = (e ≫ i.hom.hom) * a
  calc
    _ = (a * (e ≫ i.hom.hom) * a⁻¹) * a := by simp
    _ = _ := by rw [hconj]

private theorem hom_eq_of_universallyInjective_of_isReduced {X Y Z : Scheme.{u}}
    (i : Y ⟶ Z) [UniversallyInjective i] [IsSeparated i] [IsReduced X]
    {f g : X ⟶ Y} (heq : f ≫ i = g ≫ i) : f = g := by
  apply ext_of_fromSpecResidueField_eq f g i Set.univ dense_univ _ heq
  intro x _
  have hpoint : ∀ (K : Type u) [Field K],
      Function.Injective (fun a : Spec (CommRingCat.of K) ⟶ Y ↦ a ≫ i) :=
    ((tfae_universallyInjective i).out 1 2).mp ‹UniversallyInjective i›
  apply hpoint (X.residueField x)
  simp only [Category.assoc, heq]

/-- If a quotient is commutative and the kernel is central and radicial, then
the commutator is trivial whenever the square of the quotient is reduced.
The regular epimorphism hypothesis expresses descent along the product map. -/
theorem commutative_of_central_radicial_kernel {G Q : GroupScheme k} {q : G ⟶ Q}
    {E : ClosedSubgroup G} (hker : IsSchemeKernel q E) (hcentral : IsCentral E.inclusion)
    [UniversallyInjective E.group.X.hom] [IsSeparated E.group.X.hom]
    [IsCommMonObj Q.X] [IsReduced (Q.X ⨯ Q.X).left]
    [IsRegularEpi (prod.map q.hom.hom q.hom.hom).left] :
    IsCommMonObj G.X := by
  let π := q.hom.hom
  let i := E.inclusion.hom.hom
  let X := G.X ⨯ G.X
  let Y := Q.X ⨯ Q.X
  let r : X ⟶ Y := prod.map π π
  let a₁ : X ⟶ G.X := prod.fst
  let a₂ : X ⟶ G.X := prod.snd
  let c : X ⟶ G.X := ⁅a₁, a₂⁆
  have hcq : c ≫ π = toUnit X ≫ η[Q.X] := by
    change IsMonHom.monoidHom π X ⁅a₁, a₂⁆ = 1
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_commute.mpr (Commute.all _ _)
  let z : X ⟶ E.group.X := hker.lift c (toUnit X) hcq
  have hz : z ≫ i = c := hker.lift_fst c (toUnit X) hcq
  have hi : IsClosedImmersion i.left := E.isClosedImmersion
  have : Mono i := Over.mono_of_mono_left _
  have hdiff {U : SchemeOver k} {a b : U ⟶ G.X} (hab : a ≫ π = b ≫ π) :
      ∃ e : U ⟶ E.group.X, b = a * (e ≫ i) := by
    have h : (a⁻¹ * b) ≫ π = toUnit U ≫ η[Q.X] := by
      change (a⁻¹ * b) ≫ π = 1
      rw [MonObj.mul_comp, GrpObj.inv_comp, hab, inv_mul_cancel]
    let e := hker.lift (a⁻¹ * b) (toUnit U) h
    have he : e ≫ i = a⁻¹ * b := hker.lift_fst (a⁻¹ * b) (toUnit U) h
    exact ⟨e, by rw [he, mul_inv_cancel_left]⟩
  have hdesc {U : SchemeOver k} (a b : U ⟶ X) (hab : a ≫ r = b ≫ r) : a ≫ z = b ≫ z := by
    have h₁ : (a ≫ prod.fst) ≫ π = (b ≫ prod.fst) ≫ π := by
      simpa [r, Category.assoc] using congrArg (fun f : U ⟶ Y ↦ f ≫ prod.fst) hab
    have h₂ : (a ≫ prod.snd) ≫ π = (b ≫ prod.snd) ≫ π := by
      simpa [r, Category.assoc] using congrArg (fun f : U ⟶ Y ↦ f ≫ prod.snd) hab
    obtain ⟨u, hu⟩ := hdiff h₁
    obtain ⟨v, hv⟩ := hdiff h₂
    apply (cancel_mono i).mp
    simp only [Category.assoc, hz, c, commutatorElement_def, MonObj.comp_mul, GrpObj.comp_inv]
    change ⁅a ≫ prod.fst, a ≫ prod.snd⁆ = ⁅b ≫ prod.fst, b ≫ prod.snd⁆
    rw [hu, hv, commutatorElement_mul_left_eq_conj_mul,
      commutatorElement_eq_one_iff_commute.mpr (commute_of_isCentral hcentral _ u).symm]
    simp only [mul_one, mul_inv_cancel, one_mul]
    rw [commutatorElement_mul_right_eq_mul_conj,
      commutatorElement_eq_one_iff_commute.mpr (commute_of_isCentral hcentral _ v)]
    simp [mul_assoc]
  let r₀ := r.left
  have : IsRegularEpi r₀ := ‹IsRegularEpi (prod.map q.hom.hom q.hom.hom).left›
  have hdesc₀ : pullback.fst r₀ r₀ ≫ z.left = pullback.snd r₀ r₀ ≫ z.left := by
    let U := Over.mk (pullback.fst r₀ r₀ ≫ X.hom)
    let a : U ⟶ X := Over.homMk (pullback.fst r₀ r₀) rfl
    have hb : pullback.snd r₀ r₀ ≫ X.hom = U.hom := by
      simp only [U, Over.mk_hom, ← r.w, ← Category.assoc, r₀, pullback.condition]
    let b : U ⟶ X := Over.homMk (pullback.snd r₀ r₀) hb
    have hab : a ≫ r = b ≫ r := Over.OverMorphism.ext pullback.condition
    exact congrArg (fun w : U ⟶ E.group.X ↦ w.left) (hdesc a b hab)
  obtain ⟨d, hd⟩ := IsRegularEpi.exists_of_isKernelPair r₀ (.of_hasPullback r₀)
    z.left hdesc₀
  have hdOver : d ≫ E.group.X.hom = Y.hom := by
    apply (cancel_epi r₀).mp
    rw [← Category.assoc, hd, z.w, r.w]
  have hdOne : d = (1 : Y ⟶ E.group.X).left :=
    hom_eq_of_universallyInjective_of_isReduced E.group.X.hom (hdOver.trans (Over.w _).symm)
  have hzOne : z = 1 := by
    apply Over.OverMorphism.ext
    rw [← hd, hdOne]
    exact congrArg (fun w : X ⟶ E.group.X ↦ w.left) (MonObj.comp_one r)
  have hcOne : c = 1 := by rw [← hz, hzOne, MonObj.one_comp]
  have hcComm : Commute a₁ a₂ :=
    commutatorElement_eq_one_iff_commute.mp hcOne
  constructor
  let m : G.X ⊗ G.X ⟶ X := prod.lift (fst G.X G.X) (snd G.X G.X)
  have hcomm := congrArg (fun f : X ⟶ G.X ↦ m ≫ f) hcComm.eq.symm
  simp only [MonObj.comp_mul, a₁, a₂, m, prod.lift_fst, prod.lift_snd] at hcomm
  simpa only [CategoryTheory.Hom.mul_def, lift_snd_fst, lift_fst_snd, Category.id_comp]
    using hcomm


end


