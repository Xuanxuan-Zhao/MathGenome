private def extendTangent {G : GroupScheme k} (R : TestAlgebra k) (x : Lie k G) :
    GroupPoints G (CommAlgCat.of k (DualNumber R)) :=
  mapPoints (dualMap (CommAlgCat.ofHom (Algebra.ofId k R))) x.toMul.val

private def IsWeightVector {S G : GroupScheme k} (i : S ⟶ G)
    (χ : Character S) (x : Lie k G) : Prop :=
  ∀ (R : TestAlgebra k) (t : GroupPoints S R),
    let c := (((groupPointsFunctor k).obj G).map (constants R)).hom (t ≫ i.hom.hom)
    c * extendTangent R x * c⁻¹ = mapPoints (scale R (characterValue χ t)) (extendTangent R x)

private theorem isAdjointWeight_iff {S G : GroupScheme k} (i : S ⟶ G) (χ : Character S) :
    IsAdjointWeight i χ ↔ ∃ x : Lie k G, x ≠ 0 ∧ IsWeightVector i χ x := Iff.rfl

private theorem characterValue_comp {S T : GroupScheme k} (f : S ⟶ T) (χ : Character T)
    {R : TestAlgebra k} (t : GroupPoints S R) :
    characterValue (f ≫ χ) t = characterValue χ (t ≫ f.hom.hom) := by
  unfold characterValue
  simp only [Category.assoc]
  rfl

private theorem characterValue_one {S : GroupScheme k} {R : TestAlgebra k}
    (t : GroupPoints S R) : characterValue (1 : Character S) t = 1 := by
  rw [characterValue_as_unit]
  have h : t ≫ (1 : Character S).hom.hom = (1 : GroupPoints _ R) := by
    rw [Grp.Hom.hom_one, Mon.Hom.hom_one, MonObj.comp_one]
  rw [h, map_one]
  rfl

private theorem characterValue_eq {S : GroupScheme k} [IsAffine S.X.left]
    {χ ψ : Character S}
    (h : ∀ (R : TestAlgebra k) (t : GroupPoints S R),
      characterValue χ t = characterValue ψ t) : χ = ψ := by
  let D := specGroup (groupAlgebra k IntegerCharacters)
  apply (groupHomEquiv S D inferInstance).injective
  apply NatTrans.ext
  funext R
  apply GrpCat.ext
  intro t
  let e := (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k IntegerCharacters).hom.app R
  apply (ConcreteCategory.bijective_of_isIso e).1
  apply (integerHomEquiv Rˣ).symm.injective
  apply Units.ext
  exact (characterValue_as_unit χ t).symm.trans ((h R t).trans (characterValue_as_unit ψ t))

private theorem adjointDiagonalBasis {S : GroupScheme k} (G : AffineAlgebraicGroup k)
    (i : S ⟶ G.val) (s : IdentityLieStructure G.val)
    {M : Type u} [CommGroup M] (e : specGroup (groupAlgebra k M) ≅ S) :
    letI := s.lieRing
    letI := s.lieAlgebra
    ∃ (n : ℕ) (d : Module.Basis (ULift.{u} (Fin n)) k (Lie k G.val))
      (U : TangentCoordinates G.val (ULift.{u} (Fin n)) d)
      (χ : ULift.{u} (Fin n) → Character S),
      ∀ (R : TestAlgebra k) (t : GroupPoints S R) (v : ULift.{u} (Fin n) → R),
        (U.equiv R (fun j ↦ characterValue (χ j) t * v j)).toMul.val =
          conjugate (t ≫ i.hom.hom) (U.equiv R v) := by
  classical
  letI := s.lieRing
  letI := s.lieAlgebra
  obtain ⟨n, b, B, L, l, Ad, hAd, _, _⟩ :=
    LinearAlgebraicGroups.adjointRepresentation k G s
  let I := ULift.{u} (Fin n)
  let A := groupAlgebra k M
  let D := splitAffineGroup (k := k) M
  let f : D.val ⟶ L.val := e.hom ≫ i ≫ Ad
  obtain ⟨F, hF⟩ := representationCoactionComparison A b D L.val (hopfSpecPointIso A) l
  let ρ := F f
  letI : FiniteDimensional k (Lie k G.val) := b.finiteDimensional_of_finite
  obtain ⟨J, _, d₀, w₀, hw₀⟩ := DiagonalizableFixedLocus.existsWeightBasis ρ
  letI := Fintype.ofFinite J
  let jI : J ≃ I := Fintype.equivOfCardEq
    ((Module.finrank_eq_card_basis d₀).symm.trans (Module.finrank_eq_card_basis b))
  let d := d₀.reindex jI
  let w : I → M := w₀ ∘ jI.symm
  have hw (j : I) : d j ∈ WeightDecomposition.weightSpace ρ (w j) := by
    simpa only [d, w, Function.comp_apply, Module.Basis.reindex_apply] using hw₀ (jI.symm j)
  let χ (j : I) : Character S := e.inv ≫ specGroupMap (groupAlgebraMap k
    ((zpowersHom M (w j)).comp MulEquiv.ulift.toMonoidHom))
  refine ⟨n, d, rebaseCoordinates B d, χ, ?_⟩
  intro R t v
  let P := coordinateChange b d
  let g : GroupPoints D.val R := t ≫ e.inv.hom.hom
  let l₀ := hopfSpecPointIso A
  obtain ⟨a, ha⟩ := (ConcreteCategory.bijective_of_isIso (l₀.hom.app R)).2 g
  let N : Matrix.GeneralLinearGroup I R :=
    l.hom.app R (((groupPointsFunctor k).map Ad).app R (t ≫ i.hom.hom))
  have hN : N.val = (coefficients A b ρ).map a.ofConv := by
    rw [hF f]
    let α := l₀.hom ≫ (groupPointsFunctor k).map f ≫ l.hom
    have he : α.app R a = N := by
      change l.hom.app R ((l₀.hom.app R a) ≫ f.hom.hom) = _
      rw [ha]
      change l.hom.app R ((t ≫ e.inv.hom.hom) ≫ e.hom.hom.hom ≫ i.hom.hom ≫ Ad.hom.hom) = _
      have he : e.inv.hom.hom ≫ e.hom.hom.hom = 𝟙 S.X :=
        (Grp.forget _).congr_map e.inv_hom_id
      simp only [Category.assoc, reassoc_of% he]
      rfl
    exact (congrArg (fun z : Matrix.GeneralLinearGroup I R ↦ z.val) he.symm).trans
      (pointMatrix_evaluation A α R a)
  have hχ (j : I) : a.ofConv (MonoidAlgebra.of k M (w j)) = characterValue (χ j) t := by
    change _ = characterValue (e.inv ≫ _) t
    rw [characterValue_comp, splitCharacter_value]
    let E := (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k M).hom.app R
    change _ = ((show M →* Rˣ from E g) (w j) : R)
    rw [← ha]
    exact (pointsIso_spec M R a.ofConv (w j)).symm
  have hP (j m : I) : (scalarMatrix P R).val j m = algebraMap k R (b.coord j (d m)) := by
    change algebraMap k R (P.val j m) = _
    rw [coordinateChange_entry]
  have hPmul : N.val * (scalarMatrix P R).val =
      (scalarMatrix P R).val * Matrix.diagonal (fun j ↦ characterValue (χ j) t) := by
    have h := congrArg (fun m : Matrix I I A ↦ m.map a.ofConv)
      (diagonal_coactionMatrix b d ρ w hw)
    rw [Matrix.map_mul, Matrix.map_mul, Matrix.diagonal_map (map_zero a.ofConv)] at h
    change (coefficients A b ρ).map a.ofConv *
      ((scalarMatrix P (CommAlgCat.of k A)).val.map a.ofConv) =
        ((scalarMatrix P (CommAlgCat.of k A)).val.map a.ofConv) *
          Matrix.diagonal (fun j ↦ a.ofConv (MonoidAlgebra.of k M (w j))) at h
    have he : (scalarMatrix P (CommAlgCat.of k A)).val.map a.ofConv =
        (scalarMatrix P R).val := by
      ext j m
      exact a.ofConv.commutes (P.val j m)
    rw [he, ← hN, show (fun j ↦ a.ofConv (MonoidAlgebra.of k M (w j))) =
      _ from funext hχ] at h
    exact h
  have hcoords (v : I → R) : basisChange b d R v = (scalarMatrix P R).val *ᵥ v := by
    funext j
    rw [basisChange_apply, Matrix.mulVec, dotProduct]
    apply Finset.sum_congr rfl
    intro m _
    rw [hP, mul_comm]
    rfl
  change (B.equiv R (basisChange b d R _)).toMul.val =
    conjugate (t ≫ i.hom.hom) (B.equiv R (basisChange b d R v))
  rw [← hAd R (t ≫ i.hom.hom), hcoords, hcoords, Matrix.mulVec_mulVec]
  change (B.equiv R ((scalarMatrix P R).val *ᵥ _)).toMul.val =
    (B.equiv R ((N.val * (scalarMatrix P R).val) *ᵥ v)).toMul.val
  rw [hPmul, ← Matrix.mulVec_mulVec]
  have hd : Matrix.diagonal (fun j ↦ characterValue (χ j) t) *ᵥ v =
      fun j ↦ characterValue (χ j) t * v j :=
    funext (Matrix.mulVec_diagonal _ _)
  rw [hd]

private theorem weightVector_iff_coordinates
    {S G : GroupScheme k} [IsAffine S.X.left] {I : Type u} [Fintype I] [DecidableEq I]
    [AddCommGroup (Lie k G)] [Module k (Lie k G)] (i : S ⟶ G)
    (d : Module.Basis I k (Lie k G)) (U : TangentCoordinates G I d)
    (χ : I → Character S)
    (h : ∀ (R : TestAlgebra k) (t : GroupPoints S R) (v : I → R),
      (U.equiv R (fun j ↦ characterValue (χ j) t * v j)).toMul.val =
        conjugate (t ≫ i.hom.hom) (U.equiv R v))
    (ψ : Character S) (x : Lie k G) :
    IsWeightVector i ψ x ↔ ∀ j, d.equivFun x j ≠ 0 → χ j = ψ := by
  have hcalc (R : TestAlgebra k) (t : GroupPoints S R) :
      let v (j : I) := algebraMap k R (d.equivFun x j)
      (let c := (((groupPointsFunctor k).obj G).map (constants R)).hom (t ≫ i.hom.hom)
       c * extendTangent R x * c⁻¹ = mapPoints (scale R (characterValue ψ t)) (extendTangent R x)) ↔
        ∀ j, characterValue (χ j) t * v j = characterValue ψ t * v j := by
    intro v
    let a : CommAlgCat.of k k ⟶ R := CommAlgCat.ofHom (Algebra.ofId k R)
    have hu : (U.equiv R v).toMul.val = extendTangent R x := by
      refine (U.naturality a (d.equivFun x)).trans ?_
      rw [U.at_base]
      rfl
    have hh := h R t v
    change (U.equiv R _).toMul.val = _ * (U.equiv R v).toMul.val * _ at hh
    dsimp only
    rw [← hu, ← hh, ← U.smul]
    constructor
    · intro hEq j
      have hEq' := (U.equiv R).injective (Subtype.ext hEq)
      exact congrFun hEq' j
    · intro hv
      exact congrArg (fun w ↦ (U.equiv R w).toMul.val) (funext hv)
  constructor
  · intro hw j hj
    apply characterValue_eq
    intro R t
    have he := (hcalc R t).mp (hw R t) j
    have hu := (isUnit_iff_ne_zero.mpr hj).map (algebraMap k R)
    exact hu.mul_right_cancel he
  · intro hw R t
    apply (hcalc R t).mpr
    intro j
    by_cases hj : d.equivFun x j = 0
    · simp [hj]
    · rw [hw j hj]

private theorem weightVector_basis
    {S G : GroupScheme k} [IsAffine S.X.left] {I : Type u} [Fintype I] [DecidableEq I]
    [AddCommGroup (Lie k G)] [Module k (Lie k G)] (i : S ⟶ G)
    (d : Module.Basis I k (Lie k G)) (U : TangentCoordinates G I d)
    (χ : I → Character S)
    (h : ∀ (R : TestAlgebra k) (t : GroupPoints S R) (v : I → R),
      (U.equiv R (fun j ↦ characterValue (χ j) t * v j)).toMul.val =
        conjugate (t ≫ i.hom.hom) (U.equiv R v)) (j : I) :
    IsWeightVector i (χ j) (d j) := by
  apply (weightVector_iff_coordinates i d U χ h _ _).mpr
  intro m hm
  by_cases hEq : j = m
  · subst m
    rfl
  · exact (hm (by simp [Module.Basis.equivFun_self, hEq])).elim

private theorem map_weightVector {S G H : GroupScheme k} (i : S ⟶ G) (q : G ⟶ H)
    (χ : Character S) (x : Lie k G) (hx : IsWeightVector i χ x) :
    IsWeightVector (i ≫ q) χ (mapPointKernel q x) := by
  intro R t
  let V := CommAlgCat.of k (DualNumber R)
  let F := groupPointsFunctor k
  let a : CommAlgCat.of k k ⟶ R := CommAlgCat.ofHom (Algebra.ofId k R)
  have hext : extendTangent R (mapPointKernel q x) =
      (((F.map q).app V).hom (extendTangent R x)) := by
    change ((F.obj H).map (dualMap a)).hom
        (((F.map q).app _).hom x.toMul.val) =
      ((F.map q).app V).hom (((F.obj G).map (dualMap a)).hom x.toMul.val)
    exact ((F.map q).naturality_apply (dualMap a) x.toMul.val).symm
  let g : GroupPoints G R := t ≫ i.hom.hom
  have hc : (((F.obj H).map (constants R)).hom (t ≫ (i ≫ q).hom.hom)) =
      ((F.map q).app V).hom (((F.obj G).map (constants R)).hom g) := by
    change (((F.obj H).map (constants R)).hom (((F.map q).app R).hom g)) = _
    exact ((F.map q).naturality_apply (constants R) g).symm
  have hs : mapPoints (scale R (characterValue χ t)) (extendTangent R (mapPointKernel q x)) =
      ((F.map q).app V).hom (mapPoints (scale R (characterValue χ t)) (extendTangent R x)) := by
    rw [hext]
    exact ((F.map q).naturality_apply (scale R (characterValue χ t)) (extendTangent R x)).symm
  change _ * extendTangent R (mapPointKernel q x) * _ =
    mapPoints (scale R (characterValue χ t)) (extendTangent R (mapPointKernel q x))
  rw [hs, hext, hc]
  simpa only [map_mul, map_inv] using congrArg ((F.map q).app V).hom (hx R t)

private theorem scale_one (R : TestAlgebra k) :
    scale R 1 = 𝟙 (CommAlgCat.of k (DualNumber R)) := by
  apply CommAlgCat.hom_ext
  apply AlgHom.ext
  intro a
  exact TrivSqZeroExt.ext rfl (one_mul _)

private theorem scale_one_apply {G : GroupScheme k} (R : TestAlgebra k)
    (z : GroupPoints G (CommAlgCat.of k (DualNumber R))) :
    mapPoints (scale R 1) z = z := by
  rw [scale_one]
  change (testSpec k).map (𝟙 (op (CommAlgCat.of k (DualNumber R)))) ≫ z = z
  rw [(testSpec k).map_id, Category.id_comp]

private theorem fixedWeightVector_of_commutative {S G : GroupScheme k}
    [IsCommMonObj S.X] (i : S ⟶ G) (x : Lie k S) :
    IsWeightVector i 1 (mapPointKernel i x) := by
  have hx : IsWeightVector (𝟙 S) 1 x := by
    intro R t
    dsimp only
    rw [characterValue_one, scale_one_apply (G := S)]
    let c := (((groupPointsFunctor k).obj S).map (constants R)).hom (t ≫ (𝟙 S : S ⟶ S).hom.hom)
    change c * extendTangent R x * c⁻¹ = extendTangent R x
    have h : Commute c (extendTangent R x) := by
      let H := (testSpec k).obj (op (CommAlgCat.of k (DualNumber R))) ⟶ S.X
      exact @mul_comm H inferInstance (c : H) (extendTangent R x : H)
    exact h.mul_inv_cancel
  simpa only [Category.id_comp] using map_weightVector (𝟙 S) i 1 x hx

open Specs.GeometricRadicals (IsMaximalTorus)

private def specializeDual {R : TestAlgebra k} (u : R) (hu : u * u = 0) :
    CommAlgCat.of k (DualNumber R) ⟶ R :=
  CommAlgCat.ofHom {
    toFun := fun a ↦ a.fst + u * a.snd
    map_zero' := by simp
    map_one' := by simp
    map_add' := fun a b ↦ by
      simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add]
      ring
    map_mul' := fun a b ↦ by
      simp only [TrivSqZeroExt.fst_mul, DualNumber.snd_mul]
      calc
        _ = (a.fst + u * a.snd) * (b.fst + u * b.snd) - (u * u) * (a.snd * b.snd) := by ring
        _ = _ := by rw [hu, zero_mul, sub_zero]
    commutes' := fun r ↦ by
      change algebraMap k R r + u * 0 = _
      simp }

private theorem centralizes_of_fixedWeightVector {S G : GroupScheme k}
    (i : S ⟶ G) (x : Lie k G) (hx : IsWeightVector i 1 x) :
    Centralizes i x.toMul.val := by
  apply (centralizes_iff_affine _ _).mpr
  intro R a t
  let z : CommAlgCat.of k (DualNumber k) ⟶ R :=
    ((algSpec.fullyFaithful (R := CommRingCat.of k)).preimage a).unop
  let u := z.hom (DualNumber.eps : DualNumber k)
  have hu : u * u = 0 := by
    change z.hom _ * z.hom _ = _
    rw [← map_mul, DualNumber.eps_mul_eps, map_zero]
  let q := specializeDual u hu
  have hqa : dualMap (CommAlgCat.ofHom (Algebra.ofId k R)) ≫ q = z := by
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro b
    have hb : b = algebraMap k (DualNumber k) b.fst +
        algebraMap k (DualNumber k) b.snd * DualNumber.eps := by
      apply TrivSqZeroExt.ext
      · change b.fst = b.fst + b.snd * 0
        rw [mul_zero, add_zero]
      · change b.snd = 0 + (b.snd * 1 + 0 * 0)
        rw [mul_one, zero_mul, add_zero, zero_add]
    change algebraMap k R b.fst + u * algebraMap k R b.snd = z.hom b
    conv_rhs => rw [hb, map_add, map_mul, AlgHom.commutes, AlgHom.commutes]
    rw [mul_comm u]
  have hconst : constants R ≫ q = 𝟙 R := by
    apply CommAlgCat.hom_ext
    apply AlgHom.ext
    intro b
    change b + u * 0 = b
    simp
  have hz : (testSpec k).map z.op = a :=
    (algSpec.fullyFaithful (R := CommRingCat.of k)).map_preimage _
  let F := (groupPointsFunctor k).obj G
  let c := (F.map (constants R)).hom (t ≫ i.hom.hom)
  have hc : (F.map q).hom c = t ≫ i.hom.hom := by
    let g : GroupPoints G R := t ≫ i.hom.hom
    change mapPoints q (mapPoints (constants R) g) = g
    rw [← map_comp_apply G, hconst]
    change (testSpec k).map (𝟙 (op R)) ≫ g = g
    rw [(testSpec k).map_id, Category.id_comp]
  have he : (F.map q).hom (extendTangent R x) = a ≫ x.toMul.val := by
    change (testSpec k).map q.op ≫ ((testSpec k).map (dualMap
      (CommAlgCat.ofHom (Algebra.ofId k R))).op ≫ x.toMul.val) = _
    rw [← Category.assoc, ← Functor.map_comp, ← op_comp, hqa, hz]
  have hw := hx R t
  change c * extendTangent R x * c⁻¹ = _ at hw
  rw [characterValue_one, scale_one_apply (G := G)] at hw
  have hcomm : Commute c (extendTangent R x) :=
    mul_inv_eq_iff_eq_mul.mp hw
  have heq := hcomm.map (F.map q).hom
  rw [hc, he] at heq
  exact heq.symm

private theorem nontrivial_weight_of_noncentral_of_lieCentralizer
    [IsAlgClosed k] (G : AffineAlgebraicGroup k) (S : ClosedSubgroup G.val)
    (hS : IsTorus S.group)
    (h : ∃ x : Lie k G.val, ¬ Centralizes S.inclusion x.toMul.val) :
    ∃ χ : Character S.group, χ ≠ 1 ∧ IsAdjointWeight S.inclusion χ := by
  classical
  haveI : IsAffine S.group.X.left := (closedSubgroupAlgebraicGroup S).property.1
  obtain ⟨r, ⟨e⟩⟩ := torus_split_of_algClosed (closedSubgroupAlgebraicGroup S) hS
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r
  let s := identityLieStructure G
  letI := s.lieRing
  letI := s.lieAlgebra
  obtain ⟨n, b, B, χ, hχ⟩ := adjointDiagonalBasis G S.inclusion s (d ≪≫ e.symm)
  by_contra hn
  have htriv (j : ULift.{u} (Fin n)) : χ j = 1 := by
    by_contra hne
    apply hn
    exact ⟨χ j, hne, (isAdjointWeight_iff _ _).mpr
      ⟨b j, b.ne_zero j, weightVector_basis _ b B χ hχ j⟩⟩
  obtain ⟨x, hx⟩ := h
  apply hx
  apply centralizes_of_fixedWeightVector
  exact (weightVector_iff_coordinates S.inclusion b B χ hχ 1 x).mpr
    (fun j _ ↦ htriv j)

private theorem compareAdjointWeights_of_differential
    [IsAlgClosed k] (G Q : AffineAlgebraicGroup k) (q : G.val ⟶ Q.val)
    (T : ClosedSubgroup G.val) (S : ClosedSubgroup Q.val)
    (hT : IsTorus T.group) (hS : IsTorus S.group)
    (f : T.group ⟶ S.group) (hf : T.inclusion ≫ q = f ≫ S.inclusion)
    (hinj : Function.Injective (fun χ : Character S.group ↦ f ≫ χ))
    (hker : ∀ x : Lie k G.val, mapPointKernel q x = 0 →
      ∃ z : Lie k T.group, mapPointKernel T.inclusion z = x)
    (hsurj : ∀ y : Lie k Q.val, ∃ (x : Lie k G.val) (z : Lie k S.group),
      y = mapPointKernel q x + mapPointKernel S.inclusion z) :
    ∀ χ : Character S.group, χ ≠ 1 →
      (IsAdjointWeight S.inclusion χ ↔ IsAdjointWeight T.inclusion (f ≫ χ)) := by
  classical
  letI : IsAffine G.val.X.left := G.property.1
  letI : IsAffine Q.val.X.left := Q.property.1
  letI : IsAffine T.group.X.left := (closedSubgroupAlgebraicGroup T).property.1
  letI : IsAffine S.group.X.left := (closedSubgroupAlgebraicGroup S).property.1
  letI : IsCommMonObj T.group.X := torus_commutative (closedSubgroupAlgebraicGroup T) hT
  letI : IsCommMonObj S.group.X := torus_commutative (closedSubgroupAlgebraicGroup S) hS
  obtain ⟨r, ⟨e⟩⟩ := torus_split_of_algClosed (closedSubgroupAlgebraicGroup T) hT
  obtain ⟨r', ⟨e'⟩⟩ := torus_split_of_algClosed (closedSubgroupAlgebraicGroup S) hS
  obtain ⟨a⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r
  obtain ⟨a'⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r'
  obtain ⟨n, b, B, wT, hwT⟩ := adjointDiagonalBasis G T.inclusion (identityLieStructure G) (a ≪≫ e.symm)
  obtain ⟨n', d, D, wS, hwS⟩ := adjointDiagonalBasis Q S.inclusion (identityLieStructure Q) (a' ≪≫ e'.symm)
  have hwSf (R : TestAlgebra k) (t : GroupPoints T.group R) (v : ULift.{u} (Fin n') → R) :
      (D.equiv R (fun j ↦ characterValue ((fun l ↦ f ≫ wS l) j) t * v j)).toMul.val =
        conjugate (t ≫ (T.inclusion ≫ q).hom.hom) (D.equiv R v) := by
    simp only [characterValue_comp, hf]
    exact hwS R (t ≫ f.hom.hom) v
  intro χ hχ
  have hf₁ : f ≫ (1 : Character S.group) = 1 := by
    apply Grp.hom_ext
    simp only [Grp.Hom.hom_one, Mon.Hom.hom_one, MonObj.comp_one]
  have hfχ : f ≫ χ ≠ 1 := fun he ↦ hχ (hinj (he.trans hf₁.symm))
  rw [isAdjointWeight_iff, isAdjointWeight_iff]
  constructor
  · rintro ⟨y, hy₀, hy⟩
    obtain ⟨x, z, h⟩ := hsurj y
    obtain ⟨j, hj⟩ : ∃ j, d.equivFun y j ≠ 0 := by
      by_contra! hh
      exact hy₀ (d.equivFun.injective (funext fun l ↦ (hh l).trans (by simp)))
    have hwSj := (weightVector_iff_coordinates S.inclusion d D wS hwS χ y).mp hy j hj
    have hz : d.equivFun (mapPointKernel S.inclusion z) j = 0 := by
      by_contra hz
      have hfix := fixedWeightVector_of_commutative S.inclusion z
      have he := (weightVector_iff_coordinates S.inclusion d D wS hwS 1 _).mp hfix j hz
      exact hχ (hwSj.symm.trans he)
    let L := (d.coord j).comp (lieMap q)
    have hLx : L x ≠ 0 := by
      have h' := congrArg (fun v ↦ d.equivFun v j) h
      change d.equivFun y j = d.coord j (mapPointKernel q x + mapPointKernel S.inclusion z) at h'
      rw [map_add, show d.coord j (mapPointKernel S.inclusion z) = 0 from hz, add_zero] at h'
      exact h' ▸ hj
    obtain ⟨i, hi⟩ : ∃ i, L (b i) ≠ 0 := by
      by_contra! hh
      apply hLx
      rw [← b.sum_repr x, map_sum]
      simp [hh]
    have hvec := map_weightVector T.inclusion q (wT i) (b i)
      (weightVector_basis T.inclusion b B wT hwT i)
    have hwTi := (weightVector_iff_coordinates (T.inclusion ≫ q) d D
      (fun l ↦ f ≫ wS l) hwSf (wT i) _).mp hvec j hi
    refine ⟨b i, b.ne_zero i, ?_⟩
    rw [← hwSj, hwTi]
    exact weightVector_basis T.inclusion b B wT hwT i
  · rintro ⟨x, hx₀, hx⟩
    let y := mapPointKernel q x
    have hy₀ : y ≠ 0 := by
      intro hy
      obtain ⟨z, rfl⟩ := hker x hy
      obtain ⟨j, hj⟩ : ∃ j, b.equivFun (mapPointKernel T.inclusion z) j ≠ 0 := by
        by_contra! hh
        exact hx₀ (b.equivFun.injective (funext fun l ↦ (hh l).trans (by simp)))
      exact hfχ (((weightVector_iff_coordinates T.inclusion b B wT hwT _ _).mp hx j hj).symm.trans
        ((weightVector_iff_coordinates T.inclusion b B wT hwT _ _).mp
          (fixedWeightVector_of_commutative T.inclusion z) j hj))
    refine ⟨y, hy₀, (weightVector_iff_coordinates S.inclusion d D wS hwS χ y).mpr ?_⟩
    intro j hj
    apply hinj
    exact (weightVector_iff_coordinates (T.inclusion ≫ q) d D (fun l ↦ f ≫ wS l)
      hwSf (f ≫ χ) y).mp (map_weightVector T.inclusion q (f ≫ χ) x hx) j hj

/-- Smooth morphisms lift dual-number points with a prescribed reduction. -/
private theorem smooth_lift_dual {X Y : SchemeOver k} (f : X ⟶ Y) [Smooth f.left]
    (x : Points X (CommAlgCat.of k k))
    (y : Points Y (CommAlgCat.of k (DualNumber k)))
    (h : mapPoints (dualReduction k) y = x ≫ f) :
    ∃ x' : Points X (CommAlgCat.of k (DualNumber k)),
      mapPoints (dualReduction k) x' = x ∧ x' ≫ f = y := by
  let B := CommAlgCat.of k (DualNumber k)
  let S := (testSpec k).obj (op B)
  let t : (testSpec k).obj (op (CommAlgCat.of k k)) ⟶ S :=
    (testSpec k).map (dualReduction k).op
  let P := pullback f y
  let a : (testSpec k).obj (op (CommAlgCat.of k k)) ⟶ P := pullback.lift x t h.symm
  have hp : IsPullback (pullback.fst f y).left (pullback.snd f y).left f.left y.left :=
    (IsPullback.of_hasPullback f y).map (Over.forget _)
  haveI : Smooth (pullback.snd f y).left :=
    MorphismProperty.of_isPullback (P := @Smooth) hp inferInstance
  let C := P.left.affineCover
  let x₀ : (Spec (CommRingCat.of k)).carrier := IsLocalRing.closedPoint k
  let j := C.idx (a.left x₀)
  have hj : Set.range a.left ⊆ Set.range (C.f j) := by
    rintro _ ⟨z, rfl⟩
    change PrimeSpectrum k at z
    change PrimeSpectrum k at x₀
    have hz : z = x₀ := Subsingleton.elim _ _
    rw [hz]
    exact C.covers (a.left x₀)
  let xW := IsOpenImmersion.lift (C.f j) a.left hj
  have hW : xW ≫ C.f j = a.left := IsOpenImmersion.lift_fac _ _ _
  let π := C.f j ≫ (pullback.snd f y).left
  haveI : Smooth π := inferInstance
  have hx : xW ≫ π = t.left := by
    rw [← Category.assoc, hW]
    exact congrArg (fun w : (testSpec k).obj (op (CommAlgCat.of k k)) ⟶ S ↦ w.left)
      (pullback.lift_snd x t h.symm)
  let A := Scheme.Γ.obj (op (C.X j))
  let e : C.X j ≅ Spec A := (C.X j).isoSpec
  let α := (Spec.fullyFaithful.preimage (e.inv ≫ π)).unop
  let β := (Spec.fullyFaithful.preimage (xW ≫ e.hom)).unop
  let ε := (dualReduction k).hom.toRingHom
  have hπ : Spec.map α = e.inv ≫ π := Spec.fullyFaithful.map_preimage _
  have hβ : Spec.map β = xW ≫ e.hom := Spec.fullyFaithful.map_preimage _
  have hαβc : α ≫ β = CommRingCat.ofHom ε := by
    apply Spec.map_injective
    change Spec.map (α ≫ β) = t.left
    rw [Spec.map_comp, hπ, hβ, Category.assoc, e.hom_inv_id_assoc, hx]
  have hαβ : β.hom.comp α.hom = ε := congrArg CommRingCat.Hom.hom hαβc
  have hsm : α.hom.Smooth := by
    rw [← HasRingHomProperty.Spec_iff (P := @Smooth), hπ]
    infer_instance
  letI : Algebra (DualNumber k) A := α.hom.toAlgebra
  letI : Algebra (DualNumber k) k := ε.toAlgebra
  have : Algebra.Smooth (DualNumber k) A := RingHom.smooth_algebraMap.mp hsm
  let b : A →ₐ[DualNumber k] k :=
    { toRingHom := β.hom
      commutes' := fun r ↦ DFunLike.congr_fun hαβ r }
  let d : DualNumber k →ₐ[DualNumber k] k := Algebra.ofId _ _
  have hd : Function.Surjective d := fun c ↦ ⟨⟨c, 0⟩, rfl⟩
  have hnil : (RingHom.ker d.toRingHom) ^ 2 = ⊥ := by
    rw [pow_two, eq_bot_iff, Ideal.mul_le]
    intro u hu v hv
    change u.fst = 0 at hu
    change v.fst = 0 at hv
    apply TrivSqZeroExt.ext
    · change u.fst * v.fst = 0
      rw [hu, zero_mul]
    · rw [DualNumber.snd_mul, hu, hv, zero_mul, mul_zero, zero_add]
      rfl
  let l := Algebra.FormallySmooth.liftOfSurjective b d hd ⟨2, hnil⟩
  let s₀ := Spec.map (CommRingCat.ofHom l.toRingHom) ≫ e.inv ≫ C.f j
  have hsec : s₀ ≫ (pullback.snd f y).left = 𝟙 S.left := by
    change Spec.map (CommRingCat.ofHom l.toRingHom) ≫ e.inv ≫ π = 𝟙 _
    rw [← hπ, ← Spec.map_comp, ← Spec.map_id]
    congr 1
    apply CommRingCat.hom_ext
    exact RingHom.ext (fun r ↦ l.commutes r)
  have hred : t.left ≫ s₀ = a.left := by
    have hmaps : CommRingCat.ofHom l.toRingHom ≫ CommRingCat.ofHom ε = β := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact Algebra.FormallySmooth.liftOfSurjective_apply b d hd ⟨2, hnil⟩ r
    change Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom l.toRingHom) ≫
      e.inv ≫ C.f j = a.left
    rw [← Category.assoc, ← Spec.map_comp, hmaps, hβ, Category.assoc, e.hom_inv_id_assoc, hW]
  let s : S ⟶ P := Over.homMk s₀ (by
    rw [← (pullback.snd f y).w, ← Category.assoc, hsec, Category.id_comp])
  have hss : s ≫ pullback.snd f y = 𝟙 S := Over.OverMorphism.ext hsec
  have hsr : t ≫ s = a := Over.OverMorphism.ext hred
  refine ⟨s ≫ pullback.fst f y, ?_, ?_⟩
  · change t ≫ s ≫ pullback.fst f y = x
    rw [← Category.assoc, hsr, pullback.lift_fst]
  · rw [Category.assoc, pullback.condition, ← Category.assoc, hss, Category.id_comp]


private theorem quotientProjection_mul {G : GroupScheme k} {T : ClosedSubgroup G}
    (P : Presentation T) {X : SchemeOver k} (a : X ⟶ G.X) (b : X ⟶ T.group.X) :
    (a * (b ≫ T.inclusion.hom.hom)) ≫ P.projection = a ≫ P.projection := by
  have h := congrArg (fun m ↦ prod.lift a b ≫ m)
    (LinearAlgebraicGroups.HomogeneousQuotient.quotientPullback P).w.symm
  change prod.lift a b ≫ (prod.fst * (prod.snd ≫ T.inclusion.hom.hom)) ≫ P.projection =
    prod.lift a b ≫ prod.fst ≫ P.projection at h
  rw [← Category.assoc, MonObj.comp_mul, ← Category.assoc (prod.lift a b),
    prod.lift_fst, prod.lift_snd, prod.lift_fst_assoc] at h
  exact h

private theorem differential_add_torus_surjective
    (G Q : AffineAlgebraicGroup k) (q : G.val ⟶ Q.val)
    [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    {E T : ClosedSubgroup G.val} (hE : IsSchemeKernel q E)
    (j : E.group ⟶ T.group) (hj : j ≫ T.inclusion = E.inclusion)
    (S : ClosedSubgroup Q.val) (f : T.group ⟶ S.group)
    (hf : T.inclusion ≫ q = f ≫ S.inclusion) (hT : IsTorus T.group) :
    ∀ y : Lie k Q.val, ∃ (x : Lie k G.val) (z : Lie k S.group),
      y = mapPointKernel q x + mapPointKernel S.inclusion z := by
  letI : IsAffine G.val.X.left := G.property.1
  letI : IsAffine Q.val.X.left := Q.property.1
  obtain ⟨⟨P⟩, hP⟩ := LinearAlgebraicGroups.HomogeneousQuotient.homogeneousQuotient k G T
  obtain ⟨⟨P₁⟩, _⟩ := LinearAlgebraicGroups.HomogeneousQuotient.homogeneousQuotient k Q S
  haveI : Smooth P.projection.left :=
    (hP P).2 (torus_smooth (closedSubgroupAlgebraicGroup T) hT)
  obtain ⟨r, hr⟩ := descendOver q.hom.hom P.projection (fun a b hab ↦ by
    obtain ⟨v, hv⟩ := difference_in_kernel hE hab
    rw [← hv]
    have hw : v ≫ E.inclusion.hom.hom = (v ≫ j.hom.hom) ≫ T.inclusion.hom.hom := by
      rw [Category.assoc, ← show (j ≫ T.inclusion).hom.hom =
        j.hom.hom ≫ T.inclusion.hom.hom from rfl, hj]
    rw [hw, quotientProjection_mul])
  let Y := (fppfOver k).uliftYoneda
  let u := Y.preimage (P.quotientIso.inv ≫ rightQuotientMap q f hf ≫ P₁.quotientIso.hom)
  have hu : P.projection ≫ u = q.hom.hom ≫ P₁.projection := by
    apply Y.map_injective
    rw [Functor.map_comp, Functor.map_preimage, ← P.quotientProjection, Category.assoc,
      Iso.hom_inv_id_assoc, Functor.map_comp, ← P₁.quotientProjection]
    apply (sheafToPresheaf _ _).map_injective
    ext U ⟨g⟩
    change P₁.quotientIso.hom.hom.app U
      ((rightQuotientMap q f hf).hom.app U (projectSection T g)) =
        P₁.quotientIso.hom.hom.app U (projectSection S (g ≫ q.hom.hom))
    exact congrArg (P₁.quotientIso.hom.hom.app U)
      (rightQuotientMapOnLifts q f hf g)
  haveI : Epi q.hom.hom := epi_over_of_flat_of_surjective _
  have hru : r ≫ u = P₁.projection := by
    apply (cancel_epi q.hom.hom).mp
    rwa [← Category.assoc, hr]
  intro y
  let R := CommAlgCat.of k (DualNumber k)
  let K₀ := CommAlgCat.of k k
  let w := y.toMul.val ≫ r
  have hw : mapPoints (dualReduction k) w = (1 : GroupPoints G.val K₀) ≫ P.projection := by
    change ((testSpec k).map (dualReduction k).op ≫ y.toMul.val) ≫ r = _
    rw [show (testSpec k).map (dualReduction k).op ≫ y.toMul.val =
      (1 : GroupPoints Q.val K₀) from y.toMul.property]
    rw [← show (1 : GroupPoints G.val K₀) ≫ q.hom.hom = (1 : GroupPoints Q.val K₀) from
      map_one (((groupPointsFunctor k).map q).app K₀).hom, Category.assoc, hr]
  obtain ⟨x₀, hred, hx⟩ := smooth_lift_dual P.projection (1 : GroupPoints G.val K₀) w hw
  let x : Lie k G.val := Additive.ofMul ⟨x₀, hred⟩
  let a : GroupPoints Q.val R := x₀ ≫ q.hom.hom
  have ha : a ≫ P₁.projection = y.toMul.val ≫ P₁.projection := by
    change (x₀ ≫ q.hom.hom) ≫ P₁.projection = _
    rw [Category.assoc, ← hu, ← Category.assoc, hx, Category.assoc, hru]
  let H := LinearAlgebraicGroups.HomogeneousQuotient.quotientPullback P₁
  let z₀ := H.lift a y.toMul.val ha
  let z' : GroupPoints S.group R := z₀ ≫ prod.snd
  let b := (((groupPointsFunctor k).map S.inclusion).app R).hom z'
  have hres : a * b = y.toMul.val := by
    have hl := H.lift_snd a y.toMul.val ha
    change z₀ ≫ rightMultiplication S = y.toMul.val at hl
    rwa [rightMultiplication, MonObj.comp_mul, ← Category.assoc,
      show z₀ ≫ prod.fst = a from H.lift_fst a y.toMul.val ha] at hl
  have hzred : reduceTangentPoints S.group z' = 1 := by
    let v := ((groupPointsFunctor k).map S.inclusion).app K₀
    haveI : IsClosedImmersion S.inclusion.hom.hom.left := S.isClosedImmersion
    haveI : Mono S.inclusion.hom.hom := Over.mono_of_mono_left _
    have hi : Function.Injective v := fun _ _ hh ↦ (cancel_mono S.inclusion.hom.hom).mp hh
    apply hi
    have he := congrArg (reduceTangentPoints Q.val) hres
    have hared : reduceTangentPoints Q.val a = 1 :=
      (mapPointKernel q x).toMul.property
    rw [map_mul, hared, one_mul, y.toMul.property] at he
    have hn := (((groupPointsFunctor k).map S.inclusion).naturality_apply (dualReduction k) z').symm
    exact hn.symm.trans (he.trans (map_one v.hom).symm)
  let z : Lie k S.group := Additive.ofMul ⟨z', hzred⟩
  exact ⟨x, z, Subtype.ext hres.symm⟩

/-- A smooth closed subscheme tangent to the full ambient space at a rational point
has zero defining ideal in a Noetherian domain. -/
private theorem ideal_eq_bot_of_smooth_quotient
    {k A : Type*} [Field k] [CommRing A] [Algebra k A] [IsNoetherianRing A] [IsDomain A]
    (m J : Ideal A) (hm : m ≠ ⊤) (hJ : J ≤ m ^ 2)
    [Algebra.FormallySmooth k (A ⧸ J)] : J = ⊥ := by
  have hJm : J ≤ m := hJ.trans (by rw [pow_two]; exact Ideal.mul_le_left)
  have hle : m * J ≤ J := Ideal.mul_le_right
  let q : A →ₐ[k] A ⧸ (m * J) := Ideal.Quotient.mkₐ k _
  let r : A ⧸ (m * J) →ₐ[k] A ⧸ J :=
    Ideal.Quotient.liftₐ (m * J) (Ideal.Quotient.mkₐ k J)
      (fun a ha ↦ Ideal.Quotient.eq_zero_iff_mem.mpr (hle ha))
  have hr (a : A) : r (q a) = Ideal.Quotient.mk J a := rfl
  have hs : Function.Surjective r := by
    intro b
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨q a, hr a⟩
  have hrr {b : A ⧸ (m * J)} (hb : r b = 0) (a : A) (ha : a ∈ m) : q a * b = 0 := by
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective b
    change r (q c) = 0 at hb
    change q a * q c = 0
    rw [hr] at hb
    rw [← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.mul_mem_mul ha (Ideal.Quotient.eq_zero_iff_mem.mp hb))
  have hnil : (RingHom.ker r.toRingHom) ^ 2 = ⊥ := by
    rw [pow_two, eq_bot_iff, Ideal.mul_le]
    intro a ha b hb
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective a
    change r (q c) = 0 at ha
    rw [hr] at ha
    exact hrr hb c (hJm (Ideal.Quotient.eq_zero_iff_mem.mp ha))
  let s : (A ⧸ J) →ₐ[k] A ⧸ (m * J) :=
    Algebra.FormallySmooth.liftOfSurjective (AlgHom.id k (A ⧸ J)) r hs ⟨2, hnil⟩
  have hsr (b : A ⧸ J) : r (s b) = b :=
    Algebra.FormallySmooth.liftOfSurjective_apply (AlgHom.id k (A ⧸ J)) r hs ⟨2, hnil⟩ b
  let t : A →ₐ[k] A ⧸ (m * J) := s.comp (Ideal.Quotient.mkₐ k J)
  have hrt (a : A) : r (q a - t a) = 0 := by
    rw [map_sub, hr]
    change _ - r (s (Ideal.Quotient.mk J a)) = _
    rw [hsr, sub_self]
  have ht (a : A) (ha : a ∈ m) {b : A ⧸ (m * J)} (hb : r b = 0) : t a * b = 0 := by
    have he : (q a - t a) * b = 0 := by
      obtain ⟨c, hc⟩ := Ideal.Quotient.mk_surjective (q a - t a)
      change q c = q a - t a at hc
      have hc' : r (q c) = 0 := by rw [hc]; exact hrt a
      rw [← hc]
      rw [hr] at hc'
      exact hrr hb c (hJm (Ideal.Quotient.eq_zero_iff_mem.mp hc'))
    rw [sub_mul, hrr hb a ha, zero_sub, neg_eq_zero] at he
    exact he
  have hsq (a : A) (ha : a ∈ m ^ 2) : q a = t a := by
    rw [pow_two] at ha
    refine Submodule.mul_induction_on ha ?_ ?_
    · intro b hb c hc
      rw [map_mul, map_mul, ← sub_eq_zero]
      calc
        q b * q c - t b * t c = q b * (q c - t c) + t c * (q b - t b) := by ring
        _ = 0 := by rw [hrr (hrt c) b hb, ht c hc (hrt b), zero_add]
    · intro a b ha hb
      simp only [map_add, ha, hb]
  have hEq : m * J = J := by
    apply le_antisymm hle
    intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q a = 0
    rw [hsq a (hJ ha)]
    change s (Ideal.Quotient.mk J a) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
  have hall (n : ℕ) : J ≤ m ^ n := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ']
      exact hEq.ge.trans (Ideal.mul_mono le_rfl ih)
  rw [eq_bot_iff, ← Ideal.iInf_pow_eq_bot_of_isDomain m hm]
  exact le_iInf hall


private theorem closedSubgroup_iso_of_lie_surjective [IsAlgClosed k]
    (G : AffineAlgebraicGroup k) [Smooth G.val.X.hom] [ConnectedSpace G.val.X.left]
    (C : ClosedSubgroup G.val) (hc : Smooth C.group.X.hom)
    (hs : Function.Surjective (mapPointKernel C.inclusion)) :
    IsIso C.inclusion := by
  letI : IsAffine G.val.X.left := G.property.1
  letI : IsAffine C.group.X.left := (closedSubgroupAlgebraicGroup C).property.1
  obtain ⟨Aop, ⟨e⟩⟩ := essImage_hopfSpec.mpr (show IsAffine G.val.X.left from inferInstance)
  let A := Aop.unop
  let i := C.inclusion ≫ e.inv
  haveI : IsClosedImmersion C.inclusion.hom.hom.left := C.isClosedImmersion
  haveI : IsClosedImmersion i.hom.hom.left := by
    change IsClosedImmersion (C.inclusion.hom.hom.left ≫ e.inv.hom.hom.left)
    haveI : IsIso e.inv.hom.hom.left := ((Grp.forget _) ⋙ Over.forget _).map_isIso e.inv
    infer_instance
  obtain ⟨J, ⟨hJ, c, hc'⟩, _⟩ := (closedSubgroupClassification k A _ i).mp inferInstance
  letI := hJ
  let H := specGroup (hopfQuotient A J)
  let π := specGroupMap (hopfQuotientMap A J)
  have hC : Smooth H.X.hom := by
    haveI : Smooth C.group.X.hom := hc
    haveI : IsIso c.inv.hom.hom.left := ((Grp.forget _) ⋙ Over.forget _).map_isIso c.inv
    rw [← Over.w c.inv.hom.hom]
    infer_instance
  haveI : Algebra.Smooth k (A ⧸ J) := (smooth_spec_iff (k := k) (A := A ⧸ J)).mp hC
  have hpₛ : Function.Surjective (mapPointKernel i) := by
    intro x
    obtain ⟨y, hy⟩ := hs (mapPointKernel e.hom x)
    refine ⟨y, ?_⟩
    change mapPointKernel (C.inclusion ≫ e.inv) y = x
    rw [(lieFunctoriality k).2.2, hy, ← (lieFunctoriality k).2.2,
      e.hom_inv_id, (lieFunctoriality k).2.1]
  have hπ : Function.Surjective (mapPointKernel π) := by
    intro x
    obtain ⟨y, hy⟩ := hpₛ x
    refine ⟨mapPointKernel c.hom y, ?_⟩
    rw [← (lieFunctoriality k).2.2, hc']
    exact hy
  let R := CommAlgCat.of k (DualNumber k)
  have hm : J ≤ (RingHom.ker (counitAlgHom k A).toRingHom) ^ 2 := by
    apply (ideal_le_point_sq_iff A _ J).mpr
    intro g
    let x := mapDualKernel (hopfSpecPointIso A).hom ((hopfKernelLifts A).symm g)
    obtain ⟨y, hy⟩ := hπ x
    obtain ⟨b, hb⟩ := (ConcreteCategory.bijective_of_isIso ((hopfSpecPointIso (hopfQuotient A J)).hom.app R)).2
      y.toMul.val
    have hg := congrArg (fun z : Lie k (specGroup A) ↦ z.toMul.val) hy
    change ((groupPointsFunctor k).map π).app R y.toMul.val =
      (hopfSpecPointIso A).hom.app R (toConv g.val) at hg
    rw [← hb, hopfPoint_map] at hg
    have he := congrArg WithConv.ofConv
      ((ConcreteCategory.bijective_of_isIso ((hopfSpecPointIso A).hom.app R)).1 hg)
    intro a ha
    have hEq := DFunLike.congr_fun he a
    change b.ofConv (Ideal.Quotient.mk J a) = g.val a at hEq
    change g.val a = 0
    rw [← hEq, Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero]
  let q := e.hom.hom.hom
  haveI : IsIso q.left := ((Grp.forget _) ⋙ Over.forget _).map_isIso e.hom
  have hA : LocallyOfFiniteType (specGroup A).X.hom := by
    haveI : LocallyOfFiniteType G.val.X.hom := G.property.2.1
    rw [← Over.w e.hom.hom.hom]
    infer_instance
  haveI : Algebra.FiniteType k A :=
    RingHom.finiteType_algebraMap.mp ((HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hA)
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  haveI : IsIntegral G.val.X.left :=
    LinearAlgebraicGroups.WordDomainGeometry.smoothConnectedGroupIntegral G inferInstance inferInstance
  have hIntegral : IsIntegral (specGroup A).X.left := IsIntegral.of_isIso (inv q.left)
  haveI : IsDomain A := (affine_isIntegral_iff (CommRingCat.of A)).mp hIntegral
  have hJ₀ : J = ⊥ :=
    ideal_eq_bot_of_smooth_quotient (k := k) _ _ (RingHom.ker_ne_top (counitAlgHom k A).toRingHom) hm
  have hπiso : IsIso π := by
    have heq : Function.Bijective (hopfQuotientMap A J).hom := by
      refine ⟨?_, Ideal.Quotient.mk_surjective⟩
      change Function.Injective (Ideal.Quotient.mk J)
      intro a b hab
      have hab' : a - b ∈ J := Ideal.Quotient.eq_zero_iff_mem.mp (by
        rw [map_sub, hab, sub_self])
      rw [hJ₀, Ideal.mem_bot] at hab'
      exact sub_eq_zero.mp hab'
    let e₀ := CommHopfAlgCat.isoMk (BialgEquiv.ofBijective (hopfQuotientMap A J).hom heq)
    change IsIso ((hopfSpec _).map e₀.op.hom)
    infer_instance
  have hi : i = c.hom ≫ π := hc'.symm
  have hi' : IsIso i := by rw [hi]; infer_instance
  have hEq : C.inclusion = i ≫ e.hom := by simp [i]
  rw [hEq]
  infer_instance

open private centralizes_precomp_iso from LinearAlgebraicGroups.Reductive.ConnectedTorusCentralizer

/-- A closed torus subgroup of a smooth connected geometric group that acts
noncentrally has a nontrivial character in its identity tangent action. -/
theorem existsNontrivialAdjointWeight [IsAlgClosed k] (G : AffineAlgebraicGroup k)
    (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left)
    (T : ClosedSubgroup G.val) (hT : IsMaximalTorus T) (hn : ¬ IsCentral T.inclusion) :
    ∃ χ : Character T.group, χ ≠ 1 ∧ IsAdjointWeight T.inclusion χ := by
  classical
  letI := hs
  letI := hc
  apply nontrivial_weight_of_noncentral_of_lieCentralizer G T hT.1
  by_contra! hall
  obtain ⟨C, hC, hsm, _, _, _, _⟩ :=
    LinearAlgebraicGroups.TorusFreeUnipotent.maximalTorusCentralizer G hs hc T hT
  haveI : IsClosedImmersion C.inclusion.hom.hom.left := C.isClosedImmersion
  haveI : Mono C.inclusion.hom.hom := Over.mono_of_mono_left _
  have hl : Function.Surjective (mapPointKernel C.inclusion) := by
    intro x
    obtain ⟨a, ha⟩ := (hC _ x.toMul.val).mp (hall x)
    have hred : reduceTangentPoints C.group a = 1 := by
      apply (cancel_mono C.inclusion.hom.hom).mp
      change ((testSpec k).map (dualReduction k).op ≫ a) ≫ C.inclusion.hom.hom =
        (1 : GroupPoints C.group (CommAlgCat.of k k)) ≫ C.inclusion.hom.hom
      rw [Category.assoc, ha, show (testSpec k).map (dualReduction k).op ≫ x.toMul.val =
        (1 : GroupPoints G.val (CommAlgCat.of k k)) from x.toMul.property, MonObj.one_comp]
    exact ⟨Additive.ofMul ⟨a, hred⟩, Subtype.ext ha⟩
  haveI : IsIso C.inclusion := closedSubgroup_iso_of_lie_surjective G C hsm hl
  apply hn
  intro Y g
  exact (hC Y g).mpr ⟨g ≫ (inv C.inclusion).hom.hom, by
    change g ≫ (inv C.inclusion ≫ C.inclusion).hom.hom = _
    rw [IsIso.inv_hom_id]
    exact Category.comp_id _⟩

private theorem lie_lifts_of_schemeKernel {G Q : GroupScheme k}
    (q : G ⟶ Q) {E : ClosedSubgroup G} (hE : IsSchemeKernel q E)
    (x : Lie k G) (hx : mapPointKernel q x = 0) :
    ∃ y : Lie k E.group, mapPointKernel E.inclusion y = x := by
  have hx₀ : x.toMul.val ≫ q.hom.hom = toUnit _ ≫ η[Q.X] :=
    congrArg (fun z : Lie k Q ↦ z.toMul.val) hx
  let a := hE.lift x.toMul.val (toUnit _) hx₀
  have ha : a ≫ E.inclusion.hom.hom = x.toMul.val := hE.lift_fst _ _ _
  haveI : IsClosedImmersion E.inclusion.hom.hom.left := E.isClosedImmersion
  haveI : Mono E.inclusion.hom.hom := Over.mono_of_mono_left _
  have hred : reduceTangentPoints E.group a = 1 := by
    apply (cancel_mono E.inclusion.hom.hom).mp
    change ((testSpec k).map (dualReduction k).op ≫ a) ≫ E.inclusion.hom.hom =
      (1 : GroupPoints E.group (CommAlgCat.of k k)) ≫ E.inclusion.hom.hom
    rw [Category.assoc, ha, show (testSpec k).map (dualReduction k).op ≫ x.toMul.val =
      (1 : GroupPoints G (CommAlgCat.of k k)) from x.toMul.property, MonObj.one_comp]
  exact ⟨Additive.ofMul ⟨a, hred⟩, Subtype.ext ha⟩

/-- For a faithfully flat homomorphism with scheme kernel inside the torus,
nontrivial adjoint tangent weights agree under injective character pullback. -/
theorem compareAdjointWeights [IsAlgClosed k] (G Q : AffineAlgebraicGroup k)
    (q : G.val ⟶ Q.val) [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    {E T : ClosedSubgroup G.val} (hq : IsSchemeKernel q E)
    (j : E.group ⟶ T.group) (hj : j ≫ T.inclusion = E.inclusion)
    (S : ClosedSubgroup Q.val) (hT : IsTorus T.group) (hS : IsTorus S.group)
    (f : T.group ⟶ S.group) (hf : T.inclusion ≫ q = f ≫ S.inclusion)
    (hinj : Function.Injective (fun χ : Character S.group ↦ f ≫ χ)) :
    ∀ χ : Character S.group, χ ≠ 1 →
      (IsAdjointWeight S.inclusion χ ↔ IsAdjointWeight T.inclusion (f ≫ χ)) := by
  apply compareAdjointWeights_of_differential G Q q T S hT hS f hf hinj
  · intro x hx
    obtain ⟨y, hy⟩ := lie_lifts_of_schemeKernel q hq x hx
    refine ⟨mapPointKernel j y, ?_⟩
    rwa [← (lieFunctoriality k).2.2, hj]
  · exact differential_add_torus_surjective G Q q hq j hj S f hf hT

/-- Centrality of a subgroup can be checked after an extension of the field. -/
theorem isCentral_of_baseChange (K : Type u) [Field K] [Algebra k K] {G E : GroupScheme k}
    (i : E ⟶ G) (h : IsCentral ((groupBaseChange k K).map i)) : IsCentral i := by
  let F := baseChange k K
  let e := prodComparisonIso F G.X E.X
  apply (central_iff_conjugation i).mpr
  apply baseChange_hom_injective K
  apply (cancel_epi e.inv).mp
  have hs : e.inv ≫ F.map (snd G.X E.X) = snd (F.obj G.X) (F.obj E.X) := by
    rw [← CartesianMonoidalCategory.prodComparison_snd, ← prodComparisonIso_hom,
      Iso.inv_hom_id_assoc]
  rw [baseChange_conjugation K i]
  change subgroupConjugation ((groupBaseChange k K).map i) =
    e.inv ≫ F.map (snd G.X E.X ≫ i.hom.hom)
  rw [F.map_comp, ← Category.assoc, hs]
  exact (central_iff_conjugation _).mp h

/-- Once the geometric central Frobenius kernel descends as a closed subgroup,
all the other conclusions of the central Frobenius reduction follow. -/
theorem centralFrobeniusReduction_of_kernelDescent
    (hdesc : ∀ (k : Type u) [Field k] [Infinite k] (p : ℕ) [Fact p.Prime] [CharP k p]
      (G : AffineAlgebraicGroup k), Smooth G.val.X.hom → ConnectedSpace G.val.X.left →
      ∀ (T : ClosedSubgroup (GeometricGroup G).val), IsMaximalTorus T →
        ¬ IsCentral T.inclusion → ¬ HasGeometricNoncentralSemisimple G →
        ∃ E : ClosedSubgroup G.val, DescendsTorusFrobeniusKernel p T E) :
    Specs.CentralFrobeniusDescent.CentralFrobeniusReduction.{u} := by
  intro k _ _ p _ _ G hs hc T hT hn hLie
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  let F := groupBaseChange k K
  let A := GeometricGroup G
  have hsm : Smooth A.val.X.hom := by
    letI := hs
    change Smooth (pullback.snd G.val.X.hom (fieldSpecMap k K))
    infer_instance
  have hcon : ConnectedSpace A.val.X.left := by
    letI := hc
    letI := geometricallyConnected_of_connected G
    exact pullback_of_geometrically GeometricallyConnected.geometrically_connectedSpace K
      (fieldSpecMap k K)
  refine ⟨existsNontrivialAdjointWeight A hsm hcon T hT hn, ?_, ?_⟩
  · intro χ _ hχ
    exact geometricAdjointWeights_divisible
      LinearAlgebraicGroups.NormalizerLatticeAction.quotientByCentralizer p G hs hc hLie T hT.1 χ hχ
  obtain ⟨E, hE⟩ := hdesc k p G hs hc T hT hn hLie
  have he : IsCentral E.inclusion := by
    obtain ⟨N, e, hN, hi⟩ := hE
    have h := geometricFirstKernel_central
      LinearAlgebraicGroups.NormalizerLatticeAction.quotientByCentralizer p G hs hc hLie T hT.1 N hN
    apply isCentral_of_baseChange K
    intro Y g
    rw [← hi]
    exact (centralizes_precomp_iso e _ g).mpr (h Y g)
  obtain ⟨hefinite, herad⟩ := descendedTorusKernel_finite_radicial p E hE
  obtain ⟨Q, q, hq, hfin, hsQ, hcQ⟩ := finiteCentralQuotient G E he hefinite hs hc
  haveI : IsFinite q.hom.hom.left := hfin
  haveI : Surjective q.hom.hom.left := hq.2.2.1
  haveI : UniversallyInjective q.hom.hom.left := universallyInjective_of_radicialKernel hq.1 herad
  refine ⟨E, Q, q, he, hE, hefinite, hq, hfin, hsQ, hcQ,
    liftsTori_of_descendedKernel p hT.1 q hE hq he,
    reductive_of_finite_radicial_quotient
      LinearAlgebraicGroups.TorusFreeUnipotent.torusFreeUnipotent q hsQ hcQ, ?_⟩
  obtain ⟨T₁, f, ht, hqT, hf, hfs, hinj, him, hpow⟩ :=
    geometricTorusImage_of_descendedKernel p q hT hE he hq
  refine ⟨T₁, f, ht, hqT, hf, hfs, hinj, him, ?_, fun χ _ _ n ↦ hpow χ n⟩
  have hbase := groupBaseChange_isPullback K q
  haveI : Flat (F.map q).hom.hom.left := MorphismProperty.of_isPullback hbase.flip hq.2.1
  haveI : Surjective (F.map q).hom.hom.left :=
    MorphismProperty.of_isPullback hbase.flip hq.2.2.1
  let E' := scalarExtendedSubgroup K E (baseChangeClosedSubgroup k K E.inclusion E.isClosedImmersion)
  have hk : IsSchemeKernel (F.map q) E' := baseChangeKernelSquare q E.inclusion hq.1
  obtain ⟨N, e, _, hi⟩ := hE
  exact compareAdjointWeights A (GeometricGroup Q) (F.map q) hk
    (e.hom ≫ N.inclusion) hi T₁ hT.1 ht.1 f hqT hinj

open Specs.Unipotent (IsUnipotent)
open private augmentationIdeal_extension tensorMap_surjective
  from LinearAlgebraicGroups.Affine.ClosedSubgroups
open private augmentation_extendAlong extensionInclusion
  from LinearAlgebraicGroups.Affine.RelativeFrobenius

/-- The Frobenius ideal is generated by the p-th powers of augmentation elements. -/
private theorem frobeniusKernelIdeal_eq (p : ℕ) [Fact p.Prime] [CharP k p]
    (A : HopfAlgebraCategory k) :
    kernelIdeal (RelativeFrobenius.pullback p A) =
      Ideal.span ((fun x : A ↦ x ^ p) '' (augmentationIdeal A : Set A)) := by
  let f : RelativeFrobenius.twistCoordinates k p A →+* A :=
    (RelativeFrobenius.pullback p A).hom.toAlgHom.toRingHom
  let j := extensionInclusion (frobenius k p) A
  let I := augmentationIdeal A
  change (augmentationIdeal (RelativeFrobenius.twistCoordinates k p A)).map f = _
  rw [show augmentationIdeal (RelativeFrobenius.twistCoordinates k p A) = I.map j from
    augmentation_extendAlong (frobenius k p) A, Ideal.map_map]
  rw [← I.span_eq, Ideal.map_span]
  congr 1
  ext x
  constructor <;> rintro ⟨a, ha, rfl⟩ <;> refine ⟨a, ha, ?_⟩
  · exact ((RelativeFrobenius.pullback_formula p A) 1 a).trans (one_smul _ _) |>.symm
  · exact ((RelativeFrobenius.pullback_formula p A) 1 a).trans (one_smul _ _)

private theorem frobeniusKernelIdeal_baseChange (p : ℕ) [Fact p.Prime] [CharP k p]
    (K : Type u) [Field K] [Algebra k K] [CharP K p] (A : HopfAlgebraCategory k) :
    extendedIdeal K (kernelIdeal (RelativeFrobenius.pullback p A)) =
      kernelIdeal (RelativeFrobenius.pullback p (extendedHopf K A)) := by
  let B := extendedHopf K A
  let incl := includeCoordinates K A
  let I := augmentationIdeal A
  letI : Nontrivial B := (counitAlgHom K B).toRingHom.domain_nontrivial
  letI : CharP B p := CharP.of_ringHom_of_ne_zero (algebraMap K B) p (Fact.out : p.Prime).ne_zero
  let f : B →+* B := frobenius B p
  have he : I.map incl = augmentationIdeal B := augmentationIdeal_extension K A
  change (kernelIdeal (RelativeFrobenius.pullback p A)).map incl =
    kernelIdeal (RelativeFrobenius.pullback p B)
  rw [frobeniusKernelIdeal_eq, frobeniusKernelIdeal_eq, ← he, Ideal.map_span]
  change Ideal.span (incl '' ((fun x : A ↦ x ^ p) '' (I : Set A))) =
    Ideal.span (f '' (I.map incl : Set B))
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    apply Ideal.subset_span
    refine ⟨incl a, Ideal.mem_map_of_mem _ ha, ?_⟩
    exact (map_pow incl a p).symm
  · apply Ideal.span_le.mpr
    rintro _ ⟨b, hb, rfl⟩
    change b ∈ Ideal.span (incl '' (I : Set A)) at hb
    refine Submodule.span_induction (p := fun b _ ↦ f b ∈ _)
      ?_ ?_ ?_ ?_ hb
    · rintro _ ⟨a, ha, rfl⟩
      exact Ideal.subset_span ⟨a ^ p, ⟨a, ha, rfl⟩, (map_pow incl a p)⟩
    · change f 0 ∈ Ideal.span _
      rw [map_zero]
      exact Ideal.zero_mem _
    · intro x y _ _ hx hy
      rw [map_add]
      exact Ideal.add_mem _ hx hy
    · intro c b _ hb
      change f (c * b) ∈ _
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ hb

private theorem transport_schemeKernel {S S' Z : GroupScheme k}
    (N : ClosedSubgroup S) (N' : ClosedSubgroup S') (a : N.group ≅ N'.group) (b : S ≅ S')
    (f : S' ⟶ Z) (hN : IsSchemeKernel f N')
    (h : N.inclusion ≫ b.hom = a.hom ≫ N'.inclusion) :
    IsSchemeKernel (b.hom ≫ f) N := by
  let U := Grp.forget (SchemeOver k)
  refine hN.of_iso' (U.mapIso a) (U.mapIso b) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · exact (U.congr_map h).symm
  · exact toUnit_unique _ _
  · exact (Category.comp_id _).symm
  · simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]

private theorem schemeKernel_quotient {A B : HopfAlgebraCategory k} (f : B ⟶ A)
    [(kernelIdeal f).IsHopfIdeal k] :
    IsSchemeKernel (specGroupMap f)
      ⟨specGroup (hopfQuotient A (kernelIdeal f)), specGroupMap (hopfQuotientMap A (kernelIdeal f)),
        (hopfMapClosedImmersion k _).mpr Ideal.Quotient.mk_surjective⟩ := by
  let q := hopfQuotientMap A (kernelIdeal f)
  have h := (Grp.forget (SchemeOver k)).map_isPullback (schemeKernel k f).1
  change IsPullback (specGroupMap q).hom.hom (specGroupMap (hopfUnit _)).hom.hom
    (specGroupMap f).hom.hom (specGroupMap (hopfCounit B)).hom.hom at h
  let e : (specGroup (CommHopfAlgCat.of k k)).X ≅ 𝟙_ (SchemeOver k) :=
    Over.isoMk (Iso.refl (Spec (CommRingCat.of k))) (by
      change (𝟙 _) ≫ (𝟙 _) = Spec.map (𝟙 (CommRingCat.of k))
      rw [Spec.map_id, Category.comp_id])
  apply h.of_iso (Iso.refl _) (Iso.refl _) e (Iso.refl _)
  · change 𝟙 _ ≫ (specGroupMap q).hom.hom = (specGroupMap q).hom.hom ≫ 𝟙 _
    rw [Category.id_comp, Category.comp_id]
  · exact (isTerminalTensorUnit (C := SchemeOver k)).hom_ext _ _
  · simp
  · apply Over.OverMorphism.ext
    change (specGroupMap (hopfCounit B)).hom.hom.left ≫ 𝟙 _ = _
    rw [Category.comp_id]
    exact (hopfSpecOperations k B).2.1.symm

set_option maxHeartbeats 2500000 in
private theorem firstFrobeniusKernel_over_fieldExtension (p : ℕ) [Fact p.Prime] [CharP k p]
    (K : Type u) [Field K] [Algebra k K] [CharP K p] (G : AffineAlgebraicGroup k) :
    ∃ E : ClosedSubgroup G.val, IsFirstFrobeniusKernel p E ∧
      IsFirstFrobeniusKernel p
        (scalarExtendedSubgroup K E (baseChangeClosedSubgroup k K E.inclusion E.isClosedImmersion)) := by
  letI : IsAffine G.val.X.left := G.property.1
  obtain ⟨A₀, ⟨e⟩⟩ := essImage_hopfSpec.mpr (show IsAffine G.val.X.left from inferInstance)
  let A := A₀.unop
  let f := RelativeFrobenius.pullback p A
  let I := kernelIdeal f
  letI : I.IsHopfIdeal k := hopfKernelIdeal k f
  let N : ClosedSubgroup (specGroup A) :=
    ⟨specGroup (hopfQuotient A I), specGroupMap (hopfQuotientMap A I),
      (hopfMapClosedImmersion k _).mpr Ideal.Quotient.mk_surjective⟩
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso e.hom.hom.hom.left := U.map_isIso e.hom
  haveI : IsClosedImmersion N.inclusion.hom.hom.left := N.isClosedImmersion
  let E : ClosedSubgroup G.val := ⟨N.group, N.inclusion ≫ e.hom, by
    change IsClosedImmersion (N.inclusion.hom.hom.left ≫ e.hom.hom.hom.left)
    infer_instance⟩
  have hE : IsFirstFrobeniusKernel p E := by
    refine ⟨A, e.symm, f, RelativeFrobenius.pullback_formula p A,
      transport_schemeKernel E N (Iso.refl _) e.symm _ (schemeKernel_quotient f) ?_⟩
    change (N.inclusion ≫ e.hom) ≫ e.inv = 𝟙 _ ≫ N.inclusion
    simp
  refine ⟨E, hE, ?_⟩
  let F := groupBaseChange k K
  let E' := scalarExtendedSubgroup K E
    (baseChangeClosedSubgroup k K E.inclusion E.isClosedImmersion)
  let B := extendedHopf K A
  let g := RelativeFrobenius.pullback p B
  let J := extendedIdeal K I
  letI := extendedHopfIdeal k K A I
  have hJ : J = kernelIdeal g := frobeniusKernelIdeal_baseChange p K A
  let N' (J₀ : Ideal B) [J₀.IsHopfIdeal K] : ClosedSubgroup (specGroup B) :=
    ⟨specGroup (hopfQuotient B J₀), specGroupMap (hopfQuotientMap B J₀),
      (hopfMapClosedImmersion K _).mpr Ideal.Quotient.mk_surjective⟩
  have hk (J₀ : Ideal B) [J₀.IsHopfIdeal K] (hj : J₀ = kernelIdeal g) :
      IsSchemeKernel (specGroupMap g) (N' J₀) := by
    subst J₀
    exact schemeKernel_quotient g
  obtain ⟨eG, eN, hh⟩ := baseChangeQuotientInclusion k K A I
  let e' := eG ≪≫ F.mapIso e
  refine ⟨B, e'.symm, g, RelativeFrobenius.pullback_formula p B,
    transport_schemeKernel E' (N' J) eN.symm e'.symm _ (hk J hJ) ?_⟩
  change F.map (N.inclusion ≫ e.hom) ≫ (F.map e.inv ≫ eG.inv) =
    eN.inv ≫ specGroupMap (hopfQuotientMap B J)
  have heq : (N.inclusion ≫ e.hom) ≫ e.inv = N.inclusion := by
    rw [Category.assoc, e.hom_inv_id]
    exact Category.comp_id _
  rw [← Category.assoc, ← F.map_comp, heq, ← cancel_mono eG.hom,
    Category.assoc, eG.inv_hom_id, Category.comp_id, Category.assoc, hh, eN.inv_hom_id_assoc]

open private pullback_unique from LinearAlgebraicGroups.Affine.RelativeFrobenius

private theorem frobeniusTwistMap_surjective (p : ℕ) [Fact p.Prime] [CharP k p]
    {A B : HopfAlgebraCategory k} (g : A ⟶ B) (hg : Function.Surjective g.hom) :
    Function.Surjective ((frobeniusTwistHopfFunctor p).map g).hom := by
  letI : Algebra k k := (frobenius k p).toAlgebra
  change Function.Surjective (extendedHopfMap k g).hom
  exact tensorMap_surjective (K := k) g.hom.toAlgHom hg

/-- The first Frobenius kernel of a closed subgroup is its pullback of the
ambient first Frobenius kernel. -/
private theorem firstFrobeniusKernel_intersection (p : ℕ) [Fact p.Prime] [CharP k p]
    {S G : GroupScheme k} (i : S ⟶ G) (hi : IsClosedImmersion i.hom.hom.left)
    (N : ClosedSubgroup S) (E : ClosedSubgroup G)
    (hn : IsFirstFrobeniusKernel p N) (he : IsFirstFrobeniusKernel p E) :
    ∃ j : N.group ⟶ E.group,
      j ≫ E.inclusion = N.inclusion ≫ i ∧
      IsPullback N.inclusion.hom.hom j.hom.hom i.hom.hom E.inclusion.hom.hom := by
  obtain ⟨A, a, f, hf, hN⟩ := hn
  obtain ⟨B, b, g, hg, hE⟩ := he
  rw [pullback_unique p A f hf] at hN
  rw [pullback_unique p B g hg] at hE
  let r := a.inv ≫ i ≫ b.hom
  let c := ((hopfSpec.fullyFaithful (R := CommRingCat.of k)).preimage r).unop
  have hc : specGroupMap c = r :=
    (hopfSpec.fullyFaithful (R := CommRingCat.of k)).map_preimage _
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso a.inv.hom.hom.left := U.map_isIso a.inv
  haveI : IsIso b.hom.hom.hom.left := U.map_isIso b.hom
  haveI : IsClosedImmersion i.hom.hom.left := hi
  have hcl : IsClosedImmersion (specGroupMap c).hom.hom.left := by
    rw [hc]
    change IsClosedImmersion (a.inv.hom.hom.left ≫ i.hom.hom.left ≫ b.hom.hom.hom.left)
    infer_instance
  let d := specGroupMap ((frobeniusTwistHopfFunctor p).map c)
  haveI : IsClosedImmersion d.hom.hom.left :=
    (hopfMapClosedImmersion k _).mpr (frobeniusTwistMap_surjective p c
      ((hopfMapClosedImmersion k c).mp hcl))
  letI : Mono d.hom.hom := Over.mono_of_mono_left _
  let fs := a.hom ≫ specGroupMap (RelativeFrobenius.pullback p A)
  let fg := b.hom ≫ specGroupMap (RelativeFrobenius.pullback p B)
  have hnat : fs ≫ d = i ≫ fg := by
    change a.hom ≫ specGroupMap (RelativeFrobenius.pullback p A) ≫ d =
      i ≫ b.hom ≫ specGroupMap (RelativeFrobenius.pullback p B)
    have h := congrArg specGroupMap (relativeFrobenius_natural p c)
    rw [specGroupMap_comp, specGroupMap_comp, hc] at h
    rw [← h]
    simp only [r, Category.assoc, a.hom_inv_id_assoc]
  have hnat₀ : fs.hom.hom ≫ d.hom.hom = i.hom.hom ≫ fg.hom.hom :=
    (Grp.forget _).congr_map hnat
  have hkillN : N.inclusion.hom.hom ≫ fs.hom.hom = 1 := by
    rw [hN.w]
    rfl
  have hkillE : E.inclusion.hom.hom ≫ fg.hom.hom = 1 := by
    rw [hE.w]
    rfl
  have hkill : (N.inclusion.hom.hom ≫ i.hom.hom) ≫ fg.hom.hom = toUnit _ ≫ η[_] := by
    rw [Category.assoc, ← hnat₀, ← Category.assoc, hkillN, MonObj.one_comp]
    rfl
  let v := hE.lift (N.inclusion.hom.hom ≫ i.hom.hom) (toUnit _) hkill
  have hv : v ≫ E.inclusion.hom.hom = N.inclusion.hom.hom ≫ i.hom.hom := hE.lift_fst _ _ _
  haveI : IsClosedImmersion E.inclusion.hom.hom.left := E.isClosedImmersion
  haveI : Mono E.inclusion.hom.hom := Over.mono_of_mono_left _
  haveI : IsClosedImmersion N.inclusion.hom.hom.left := N.isClosedImmersion
  haveI : Mono N.inclusion.hom.hom := Over.mono_of_mono_left _
  haveI : IsMonHom v := isMonHom_of_comp_closed v (N.inclusion ≫ i) E.inclusion hv
  let j := Grp.homMk v
  refine ⟨j, Grp.hom_ext _ _ hv, IsPullback.mk' hv.symm ?_ ?_⟩
  · intro Y m n hmn _
    exact (cancel_mono N.inclusion.hom.hom).mp hmn
  · intro Y s z hsz
    have hs : s ≫ fs.hom.hom = toUnit Y ≫ η[_] := by
      change s ≫ fs.hom.hom = 1
      apply (cancel_mono d.hom.hom).mp
      rw [Category.assoc, hnat₀, ← Category.assoc, hsz, Category.assoc,
        hkillE, MonObj.comp_one, MonObj.one_comp]
    let w := hN.lift s (toUnit _) hs
    have hw : w ≫ N.inclusion.hom.hom = s := hN.lift_fst _ _ _
    refine ⟨w, hw, (cancel_mono E.inclusion.hom.hom).mp ?_⟩
    change (w ≫ v) ≫ E.inclusion.hom.hom = _
    rw [Category.assoc, hv, ← Category.assoc, hw, hsz]

open private centralizes_iff from LinearAlgebraicGroups.Affine.Stabilizers
private theorem centralizes_of_central_morphism {S G : GroupScheme k}
    (i : S ⟶ G) (hi : IsCentral i) {T : GroupScheme k} (j : T ⟶ G) :
    Centralizes j i.hom.hom := by
  apply (centralizes_iff j i.hom.hom).mpr
  intro Y a b
  exact (commute_of_isCentral hi (b ≫ j.hom.hom) a).symm

private theorem center_isCentral {G : GroupScheme k} (C : ClosedSubgroup G)
    (hc : RepresentsSubgroup C (fun _ g ↦ Centralizes (𝟙 G) g)) :
    IsCentral C.inclusion := by
  intro Y g
  apply (centralizes_iff C.inclusion g).mpr
  intro U a b
  have hb : Centralizes (𝟙 G) (b ≫ C.inclusion.hom.hom) := (hc _ _).mpr ⟨b, rfl⟩
  have h := (centralizes_iff _ _).mp hb U (𝟙 U) (a ≫ g)
  change Commute (𝟙 U ≫ (b ≫ C.inclusion.hom.hom)) ((a ≫ g) ≫ 𝟙 G.X) at h
  simpa only [Category.id_comp, Category.comp_id] using h.symm

private theorem center_contains {G S : GroupScheme k} (C : ClosedSubgroup G)
    (hc : RepresentsSubgroup C (fun _ g ↦ Centralizes (𝟙 G) g)) (i : S ⟶ G)
    (hi : IsCentral i) : ∃ j : S ⟶ C.group, j ≫ C.inclusion = i := by
  obtain ⟨v, hv⟩ := (hc S.X i.hom.hom).mp (centralizes_of_central_morphism i hi (𝟙 G))
  letI : IsClosedImmersion C.inclusion.hom.hom.left := C.isClosedImmersion
  letI : IsMonHom v := isMonHom_of_comp_closed v i C.inclusion hv
  exact ⟨Grp.homMk v, Grp.hom_ext _ _ hv⟩

private theorem central_inclusion_commutative {G : GroupScheme k} (H : ClosedSubgroup G)
    (hH : IsCentral H.inclusion) : IsCommMonObj H.group.X := by
  let J := H.group.X
  let v := H.inclusion.hom.hom
  haveI : IsClosedImmersion v.left := H.isClosedImmersion
  haveI : Mono v := Over.mono_of_mono_left _
  have h := commute_of_isCentral hH (fst J J ≫ v) (snd J J)
  have he : Commute (fst J J) (snd J J) := by
    apply (cancel_mono v).mp
    simpa only [MonObj.mul_comp] using h.eq
  constructor
  simpa only [CategoryTheory.Hom.mul_def, lift_snd_fst, lift_fst_snd, Category.id_comp]
    using he.eq.symm

private theorem central_comp {H S G : GroupScheme k} (i : S ⟶ G) (h : IsCentral i)
    (f : H ⟶ S) : IsCentral (f ≫ i) := by
  intro Y g
  apply (centralizes_iff _ _).mpr
  intro Z a b
  change Commute (a ≫ g) (b ≫ f.hom.hom ≫ i.hom.hom)
  rw [← Category.assoc b]
  exact commute_of_isCentral h (a ≫ g) (b ≫ f.hom.hom)

open Specs.CharacterDescent (StandardLattice)
open Specs.DiagonalizableGroups (diagonalGroup)

/-- A closed subgroup of a geometric torus has a split group-algebra presentation. -/
theorem splitPresentation_of_torusSubgroup [IsAlgClosed k]
    (T : AffineAlgebraicGroup k) (ht : IsTorus T.val) (N : ClosedSubgroup T.val) :
    ∃ (M : Type u) (_ : CommGroup M), Nonempty (N.group ≅ specGroup (groupAlgebra k M)) := by
  obtain ⟨r, ⟨e⟩⟩ := torus_split_of_algClosed T ht
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r
  let M := StandardLattice.{u} r
  letI : Group.FG M := lattice_fg r
  let a : T.val ≅ (diagonalGroup k M).val := e ≪≫ d.symm
  let i := N.inclusion ≫ a.hom
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso a.hom.hom.hom.left := U.map_isIso a.hom
  haveI : IsClosedImmersion N.inclusion.hom.hom.left := N.isClosedImmersion
  have hci : IsClosedImmersion i.hom.hom.left := by
    change IsClosedImmersion (N.inclusion.hom.hom.left ≫ a.hom.hom.hom.left)
    infer_instance
  obtain ⟨S, ⟨b, _⟩, _⟩ :=
    (LinearAlgebraicGroups.DiagonalizableGroups.diagonalClosedSubgroups k M N.group i).mp hci
  exact ⟨M ⧸ S, inferInstance, ⟨b⟩⟩

set_option maxHeartbeats 2400000 in
/-- The intersection of the center and the first Frobenius kernel is a finite
central subgroup containing the geometric torus kernel with unipotent quotient. -/
theorem existsFiniteCentralSubgroupContainingKernel (p : ℕ) [Fact p.Prime] [CharP k p]
    (G : AffineAlgebraicGroup k) (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left)
    (T : ClosedSubgroup (GeometricGroup G).val) (hT : IsMaximalTorus T)
    (N : ClosedSubgroup T.group)
    (hN : letI : CharP (AlgebraicClosure k) p :=
      charP_of_injective_algebraMap (algebraMap k (AlgebraicClosure k)).injective p
      IsFirstFrobeniusKernel p N)
    (hcn : IsCentral (N.inclusion ≫ T.inclusion)) :
    let K := AlgebraicClosure k
    let F := groupBaseChange k K
    ∃ (H : ClosedSubgroup G.val), IsFinite H.group.X.hom ∧ IsCentral H.inclusion ∧
      IsCommMonObj H.group.X ∧
      ∃ (j : N.group ⟶ F.obj H.group), j ≫ F.map H.inclusion = N.inclusion ≫ T.inclusion ∧
        ∃ (hj : IsClosedImmersion j.hom.hom.left) (Q : AffineAlgebraicGroup K)
          (f : F.obj H.group ⟶ Q.val), IsUnipotent Q ∧
          IsSchemeKernel f (⟨_, j, hj⟩ : ClosedSubgroup (F.obj H.group)) := by
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  let F := groupBaseChange k K
  let A := GeometricGroup G
  have hsm : Smooth A.val.X.hom := by
    letI := hs
    change Smooth (pullback.snd G.val.X.hom (fieldSpecMap k K))
    infer_instance
  have hcon : ConnectedSpace A.val.X.left := by
    letI := hc
    letI := geometricallyConnected_of_connected G
    exact pullback_of_geometrically GeometricallyConnected.geometrically_connectedSpace K
      (fieldSpecMap k K)
  let All : ClosedSubgroup G.val := ⟨_, 𝟙 _, inferInstanceAs (IsClosedImmersion (𝟙 G.val.X.left))⟩
  obtain ⟨Z, hZ⟩ := centralizerScheme k G All
  have hzc : IsCentral Z.inclusion := center_isCentral Z hZ
  obtain ⟨hz', hZ'⟩ := centralizerSchemeBaseChange k K (𝟙 G.val) Z hZ
  let Z' := scalarExtendedSubgroup K Z hz'
  have hZ'_rep : RepresentsSubgroup Z' (fun _ g ↦ Centralizes (𝟙 A.val) g) := by
    change RepresentsSubgroup Z' (fun _ g ↦ Centralizes (F.map (𝟙 G.val)) g) at hZ'
    rw [F.map_id] at hZ'
    exact hZ'
  obtain ⟨P, hP, hP'⟩ := firstFrobeniusKernel_over_fieldExtension p K G
  let P' := scalarExtendedSubgroup K P (baseChangeClosedSubgroup k K P.inclusion P.isClosedImmersion)
  obtain ⟨H₀, jP, hpb⟩ := preimageSubgroup (G := closedSubgroupAlgebraicGroup Z) (Q := G) Z.inclusion P
  haveI : IsClosedImmersion Z.inclusion.hom.hom.left := Z.isClosedImmersion
  haveI : IsClosedImmersion H₀.inclusion.hom.hom.left := H₀.isClosedImmersion
  let H : ClosedSubgroup G.val := ⟨H₀.group, H₀.inclusion ≫ Z.inclusion, by
    change IsClosedImmersion (H₀.inclusion.hom.hom.left ≫ Z.inclusion.hom.hom.left)
    infer_instance⟩
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  have hpj : IsClosedImmersion jP.hom.hom.left := MorphismProperty.of_isPullback (hpb.map U)
    Z.isClosedImmersion
  have hfP := firstFrobeniusKernel_finite p G P hP
  have hfin : IsFinite H.group.X.hom := by
    rw [← jP.hom.hom.w]
    exact MorphismProperty.comp_mem (@IsFinite.{u}) _ _ (by letI := hpj; infer_instance) hfP
  have hcen : IsCentral H.inclusion := central_comp Z.inclusion hzc H₀.inclusion
  refine ⟨H, hfin, hcen, central_inclusion_commutative H hcen, ?_⟩
  have hpair := baseChangeSubgroupPullback k K hpb
  obtain ⟨nZ, hnZ⟩ := center_contains Z' hZ'_rep (N.inclusion ≫ T.inclusion) hcn
  obtain ⟨nP, hnP, hNP⟩ :=
    firstFrobeniusKernel_intersection p T.inclusion T.isClosedImmersion N P' hN hP'
  let nH := hpair.lift nZ nP (hnZ.trans hnP.symm)
  have hnHZ : nH ≫ F.map H₀.inclusion = nZ := hpair.lift_fst _ _ _
  have hnHP : nH ≫ F.map jP = nP := hpair.lift_snd _ _ _
  have hnH : nH ≫ F.map H.inclusion = N.inclusion ≫ T.inclusion := by
    change nH ≫ F.map (H₀.inclusion ≫ Z.inclusion) = _
    rw [F.map_comp, ← Category.assoc, hnHZ]
    exact hnZ
  haveI : IsClosedImmersion (F.map H.inclusion).hom.hom.left :=
    baseChangeClosedSubgroup k K H.inclusion H.isClosedImmersion
  have hnj : IsClosedImmersion nH.hom.hom.left := by
    haveI : IsClosedImmersion (nH.hom.hom.left ≫ (F.map H.inclusion).hom.hom.left) := by
      change IsClosedImmersion (nH ≫ F.map H.inclusion).hom.hom.left
      rw [hnH]
      exact MorphismProperty.comp_mem (@IsClosedImmersion.{u}) _ _ N.isClosedImmersion T.isClosedImmersion
    exact IsClosedImmersion.of_comp_isClosedImmersion _ (F.map H.inclusion).hom.hom.left
  refine ⟨nH, hnH, hnj, ?_⟩
  obtain ⟨C, hC, _, _, _, _, tC, htC, Q, q, hti, hq, hQ⟩ :=
    LinearAlgebraicGroups.TorusFreeUnipotent.maximalTorusCentralizer A hsm hcon T hT
  have hH' := baseChange_central K hcen
  obtain ⟨s, hsi⟩ := (hC _ (F.map H.inclusion).hom.hom).mp
    (centralizes_of_central_morphism (F.map H.inclusion) hH' T.inclusion)
  letI : IsClosedImmersion C.inclusion.hom.hom.left := C.isClosedImmersion
  letI : Mono C.inclusion.hom.hom := Over.mono_of_mono_left _
  letI : IsMonHom s := isMonHom_of_comp_closed s (F.map H.inclusion) C.inclusion hsi
  let c := Grp.homMk s
  have hcd : nH ≫ c = N.inclusion ≫ tC := by
    apply Grp.hom_ext
    apply (cancel_mono C.inclusion.hom.hom).mp
    change (nH.hom.hom ≫ s) ≫ C.inclusion.hom.hom =
      (N.inclusion.hom.hom ≫ tC.hom.hom) ≫ C.inclusion.hom.hom
    simp only [Category.assoc, hsi]
    change (nH ≫ F.map H.inclusion).hom.hom = (N.inclusion ≫ tC ≫ C.inclusion).hom.hom
    rw [hnH, hti]
  let f := c ≫ q
  have hkill : nH.hom.hom ≫ f.hom.hom = toUnit _ ≫ η[Q.val.X] := by
    change (nH ≫ c ≫ q).hom.hom = _
    rw [← Category.assoc, hcd]
    change (N.inclusion.hom.hom ≫ tC.hom.hom) ≫ q.hom.hom = _
    rw [Category.assoc, hq.1.w, ← Category.assoc, comp_toUnit]
  have hfP' : (F.map jP).hom.hom ≫ P'.inclusion.hom.hom = (F.map H.inclusion).hom.hom := by
    change (F.map jP ≫ F.map P.inclusion).hom.hom = _
    rw [← F.map_comp, ← hpb.w]
  refine ⟨Q, f, hQ, IsPullback.mk' hkill ?_ ?_⟩
  · intro Y a b hab _
    haveI : IsClosedImmersion nH.hom.hom.left := hnj
    haveI : Mono nH.hom.hom := Over.mono_of_mono_left _
    exact (cancel_mono nH.hom.hom).mp hab
  · intro Y a y ha
    have hac : (a ≫ c.hom.hom) ≫ q.hom.hom = toUnit Y ≫ η[Q.val.X] := by
      change a ≫ f.hom.hom = _
      rw [ha, toUnit_unique y (toUnit Y)]
    let t := hq.1.lift (a ≫ c.hom.hom) (toUnit Y) hac
    have ht : t ≫ tC.hom.hom = a ≫ c.hom.hom := hq.1.lift_fst _ _ _
    let v := a ≫ (F.map jP).hom.hom
    have hv : t ≫ T.inclusion.hom.hom = v ≫ P'.inclusion.hom.hom := by
      have hti' : tC.hom.hom ≫ C.inclusion.hom.hom = T.inclusion.hom.hom :=
        (Grp.forget _).congr_map hti
      rw [← hti', ← Category.assoc, ht, Category.assoc]
      change a ≫ s ≫ C.inclusion.hom.hom = v ≫ P'.inclusion.hom.hom
      rw [hsi]
      change a ≫ (F.map H.inclusion).hom.hom = (a ≫ (F.map jP).hom.hom) ≫ P'.inclusion.hom.hom
      rw [Category.assoc, hfP']
    let w := hNP.lift t v hv
    have hw := hNP.lift_snd t v hv
    haveI : Mono (F.map H.inclusion).hom.hom := Over.mono_of_mono_left _
    refine ⟨w, (cancel_mono (F.map H.inclusion).hom.hom).mp ?_, toUnit_unique _ _⟩
    rw [Category.assoc]
    change w ≫ (nH ≫ F.map H.inclusion).hom.hom = _
    rw [hnH, ← hnP]
    change w ≫ nP.hom.hom ≫ P'.inclusion.hom.hom = _
    rw [← Category.assoc, hw]
    change (a ≫ (F.map jP).hom.hom) ≫ P'.inclusion.hom.hom = _
    rw [Category.assoc, hfP']

open HopfAlgebra

private abbrev ConvolutionDual (A : HopfAlgebraCategory k) := WithConv (Module.Dual k A)

private def evalGroupLike (A : HopfAlgebraCategory k) (a : GroupLike k A) :
    ConvolutionDual A →ₐ[k] k where
  toFun f := f.ofConv a.val
  map_one' := by
    change counit (R := k) a.val = 1
    exact a.isGroupLikeElem_val.counit_eq_one
  map_zero' := rfl
  map_add' _ _ := rfl
  map_mul' f g := by
    change (f * g) a.val = f.ofConv a.val * g.ofConv a.val
    rw [LinearMap.convMul_apply, a.isGroupLikeElem_val.comul_eq_tmul_self,
      TensorProduct.map_tmul, LinearMap.mul'_apply]
  commutes' r := by
    change (algebraMap k (ConvolutionDual A) r) a.val = r
    rw [LinearMap.convAlgebraMap_apply, a.isGroupLikeElem_val.counit_eq_one, map_one, smul_eq_mul, mul_one]

private theorem tensor_eq_of_dual_evaluations {V W : Type u} [AddCommGroup V] [Module k V]
    [AddCommGroup W] [Module k W] {x y : V ⊗[k] W}
    (h : ∀ (f : Module.Dual k V) (g : Module.Dual k W),
      LinearMap.mul' k k (TensorProduct.map f g x) =
        LinearMap.mul' k k (TensorProduct.map f g y)) : x = y := by
  let v := Module.Free.chooseBasis k V
  let w := Module.Free.chooseBasis k W
  let b := v.tensorProduct w
  have hcoord (i) (j) (z : V ⊗[k] W) :
      b.repr z (i, j) = LinearMap.mul' k k (TensorProduct.map (v.coord i) (w.coord j) z) := by
    induction z using TensorProduct.inductionOn with
    | tmul a c =>
      rw [TensorProduct.map_tmul, LinearMap.mul'_apply]
      change (v.tensorProduct w).repr (a ⊗ₜ[k] c) (i, j) = v.repr a i * w.repr c j
      rw [Module.Basis.tensorProduct_repr_tmul_apply, smul_eq_mul, mul_comm]
    | add a c ha hc => simp only [map_add, Finsupp.add_apply, ha, hc]
  apply b.repr.injective
  ext ⟨i, j⟩
  rw [hcoord, hcoord]
  exact h (v.coord i) (w.coord j)

private theorem evalGroupLike_surjective (A : HopfAlgebraCategory k) [Module.Finite k A] :
    Function.Surjective (evalGroupLike A) := by
  intro f
  let l := f.toLinearMap.comp (WithConv.linearEquiv k (Module.Dual k A)).symm.toLinearMap
  let a := (Module.evalEquiv k A).symm l
  have ha (g : ConvolutionDual A) : g.ofConv a = f g := by
    exact Module.apply_evalEquiv_symm_apply k A g.ofConv l
  have h : IsGroupLikeElem k a := by
    constructor
    · exact (ha (1 : ConvolutionDual A)).trans (map_one f)
    · apply tensor_eq_of_dual_evaluations
      intro g h
      rw [TensorProduct.map_tmul, LinearMap.mul'_apply]
      change (toConv g * toConv h).ofConv a = g a * h a
      rw [ha, map_mul, ← ha (toConv g), ← ha (toConv h)]
  exact ⟨⟨a, h⟩, AlgHom.ext ha⟩

private def groupAlgebraDualIso (M : Type u) [CommGroup M] :
    ConvolutionDual (DiagonalizableGroups.groupAlgebra k M) ≃ₐ[k] (M → k) := by
  let A := DiagonalizableGroups.groupAlgebra k M
  let b : Module.Basis M k A := MonoidAlgebra.basis M k
  let g (m : M) : GroupLike k A :=
    ⟨MonoidAlgebra.of k M m, MonoidAlgebra.isGroupLikeElem_of m⟩
  let f := AlgHom.pi (fun m ↦ evalGroupLike A (g m))
  apply AlgEquiv.ofBijective f
  constructor
  · intro x y h
    apply WithConv.ext
    apply b.ext
    intro m
    change f x m = f y m
    exact congrFun h m
  · intro v
    refine ⟨toConv (b.constr k v), ?_⟩
    funext m
    change (b.constr k v) (b m) = v m
    exact b.constr_basis _ _ _

private theorem eq_of_algHom_ker {A : Type u} [CommRing A] [Algebra k A] {f g : A →ₐ[k] k}
    (h : RingHom.ker f.toRingHom = RingHom.ker g.toRingHom) : f = g := by
  apply AlgHom.ext
  intro a
  have ha : a - algebraMap k A (f a) ∈ RingHom.ker f.toRingHom := by
    change f (a - algebraMap k A (f a)) = 0
    rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self_apply, sub_self]
  rw [h] at ha
  change g (a - algebraMap k A (f a)) = 0 at ha
  rwa [map_sub, AlgHom.commutes, Algebra.algebraMap_self_apply, sub_eq_zero, eq_comm] at ha

private theorem characterRestriction_surjective [IsAlgClosed k]
    {A B : Type u} [CommRing A] [CommRing B] [Algebra k A] [Algebra k B] [Module.Finite k B]
    (e : A →ₐ[k] B) (he : Function.Injective e) :
    Function.Surjective (fun f : B →ₐ[k] k ↦ f.comp e) := by
  intro g
  letI : Algebra A B := e.toRingHom.toAlgebra
  letI : IsScalarTower k A B := IsScalarTower.of_algebraMap_eq fun x ↦ (e.commutes x).symm
  let P := RingHom.ker g.toRingHom
  haveI : P.IsMaximal := RingHom.ker_isMaximal_of_surjective g.toRingHom
    (fun x ↦ ⟨algebraMap k A x, (g.commutes x).trans (Algebra.algebraMap_self_apply x)⟩)
  haveI : Module.Finite A B := Module.Finite.of_restrictScalars_finite k A B
  have hP : RingHom.ker (algebraMap A B) ≤ P := by
    change RingHom.ker e.toRingHom ≤ P
    rw [(RingHom.injective_iff_ker_eq_bot e.toRingHom).mp he]
    exact bot_le
  obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral P hP
  letI : Field (B ⧸ Q) := Ideal.Quotient.field Q
  let i : k ≃ₐ[k] B ⧸ Q :=
    AlgEquiv.ofBijective (Algebra.ofId k _) IsAlgClosed.algebraMap_bijective_of_isIntegral
  let f : B →ₐ[k] k := i.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k Q)
  refine ⟨f, eq_of_algHom_ker ?_⟩
  change RingHom.ker (f.comp e).toRingHom = P
  rw [← hQP]
  ext a
  change i.symm (Ideal.Quotient.mk Q (e a)) = 0 ↔ e a ∈ Q
  rw [← map_zero i.symm, i.symm.injective.eq_iff]
  exact Ideal.Quotient.eq_zero_iff_mem

/-- If the characters of a finite algebra restrict bijectively to those of
a split subalgebra, large Frobenius powers span exactly that subalgebra. -/
theorem span_primePowers_of_characterRestriction
    {K B I : Type*} [Field K] [IsAlgClosed K] [CommRing B] [Algebra K B] [Module.Finite K B]
    [Fintype I] (p : ℕ) [Fact p.Prime] [CharP B p]
    (e : (I → K) →ₐ[K] B) (χ : I → B →ₐ[K] K)
    (hχ : Function.Surjective χ)
    (he : ∀ i : I, (χ i).comp e = Pi.evalAlgHom K (fun _ : I ↦ K) i) :
    ∃ r : ℕ, Submodule.span K (Set.range fun b : B ↦ b ^ (p ^ r)) = LinearMap.range e.toLinearMap := by
  classical
  letI : IsArtinianRing B := isArtinian_of_tower K inferInstance
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_nilradical (R := B)
  obtain ⟨r, hr⟩ := pow_unbounded_of_one_lt n (Fact.out : p.Prime).one_lt
  let s (b : B) := e fun i ↦ χ i b
  have hs (b : B) : b - s b ∈ nilradical B := by
    rw [nilradical, Ideal.radical_eq_sInf, Ideal.mem_sInf]
    intro P hP
    haveI : P.IsPrime := hP.2
    have hM : P.IsMaximal := (IsArtinianRing.isPrime_iff_isMaximal P).mp hP.2
    letI : Field (B ⧸ P) := Ideal.Quotient.field P
    let z : K ≃ₐ[K] (B ⧸ P) :=
      AlgEquiv.ofBijective (Algebra.ofId K _) IsAlgClosed.algebraMap_bijective_of_isIntegral
    let f : B →ₐ[K] K := z.symm.toAlgHom.comp (Ideal.Quotient.mkₐ K P)
    obtain ⟨i, hi⟩ := hχ f
    have hzero : f (b - s b) = 0 := by
      rw [← hi, map_sub]
      change χ i b - ((χ i).comp e) (fun j ↦ χ j b) = 0
      rw [he]
      exact sub_self _
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    exact z.symm.injective (hzero.trans (map_zero z.symm).symm)
  refine ⟨r, le_antisymm (Submodule.span_le.mpr ?_) ?_⟩
  · rintro _ ⟨b, rfl⟩
    let f : B →+* B := iterateFrobenius B p r
    have hnil : (b - s b) ^ (p ^ r) = 0 := by
      have hb : (b - s b) ^ (p ^ r) ∈ nilradical B ^ (p ^ r) :=
        Ideal.pow_mem_pow (hs b) _
      have hle : nilradical B ^ (p ^ r) ≤ nilradical B ^ n :=
        Ideal.pow_le_pow_right hr.le
      have hz := hle hb
      rw [hn] at hz
      exact Ideal.mem_bot.mp hz
    have hpow : f b = f (s b) := sub_eq_zero.mp ((map_sub f b (s b)).symm.trans hnil)
    refine ⟨(fun i ↦ χ i b) ^ (p ^ r), ?_⟩
    change e _ = _
    rw [map_pow]
    exact hpow.symm
  · rintro _ ⟨v, rfl⟩
    have hb (i : I) : e (Pi.single i 1) ∈ Submodule.span K (Set.range fun b : B ↦ b ^ (p ^ r)) := by
      apply Submodule.subset_span
      refine ⟨e (Pi.single i 1), ?_⟩
      change (e (Pi.single i 1)) ^ (p ^ r) = _
      rw [← map_pow]
      congr 1
      funext j
      rw [Pi.pow_apply]
      by_cases hij : j = i
      · subst j
        simp
      · rw [Pi.single_eq_of_ne hij, zero_pow (pow_ne_zero _ (Fact.out : p.Prime).ne_zero)]
    have hv := (Pi.basisFun K I).sum_repr v
    change (∑ i, v i • Pi.single i 1) = v at hv
    change e v ∈ _
    rw [← hv, map_sum]
    apply Submodule.sum_mem
    intro i _
    exact (map_smul e _ _).symm ▸ Submodule.smul_mem _ _ (hb i)


section DualBaseChange

variable (K : Type u) [Field K] [Algebra k K]

private def extendDualLinear (A : HopfAlgebraCategory k) :
    ConvolutionDual A →ₗ[k] ConvolutionDual (extendedHopf K A) :=
  (WithConv.linearEquiv k _).symm.toLinearMap.comp
    ((Module.Dual.baseChange K).comp (WithConv.linearEquiv k _).toLinearMap)

private theorem extendDualLinear_tmul (A : HopfAlgebraCategory k) (f : ConvolutionDual A)
    (c : K) (a : A) :
    (extendDualLinear K A f).ofConv (c ⊗ₜ[k] a) = f.ofConv a • c := rfl

private theorem extendDualLinear_powCompat (A : HopfAlgebraCategory k) :
    ∀ f g : ConvolutionDual A, extendDualLinear K A (f * g) =
      extendDualLinear K A f * extendDualLinear K A g := by
  intro f g
  apply WithConv.ext
  let j := (TensorProduct.mk k K A) 1
  have hbc : IsBaseChange K j := TensorProduct.isBaseChange k A K
  apply hbc.algHom_ext
  intro a
  change (extendDualLinear K A (f * g)).ofConv ((1 : K) ⊗ₜ[k] a) =
    (extendDualLinear K A f * extendDualLinear K A g).ofConv ((1 : K) ⊗ₜ[k] a)
  rw [extendDualLinear_tmul]
  change (f * g) a • (1 : K) =
    (extendDualLinear K A f * extendDualLinear K A g) ((1 : K) ⊗ₜ[k] a)
  rw [LinearMap.convMul_apply, LinearMap.convMul_apply, TensorProduct.comul_tmul, comul_one]
  let t := Coalgebra.comul (R := k) a
  change LinearMap.mul' k k (TensorProduct.map f.ofConv g.ofConv t) • (1 : K) =
    LinearMap.mul' K K (TensorProduct.map (extendDualLinear K A f).ofConv (extendDualLinear K A g).ofConv
      (TensorProduct.AlgebraTensorModule.tensorTensorTensorComm k K k K K K A A
        (((1 : K) ⊗ₜ[K] (1 : K)) ⊗ₜ[k] t)))
  induction t using TensorProduct.inductionOn with
  | tmul a b =>
    rw [TensorProduct.AlgebraTensorModule.tensorTensorTensorComm_tmul, TensorProduct.map_tmul,
      TensorProduct.map_tmul, LinearMap.mul'_apply, LinearMap.mul'_apply,
      extendDualLinear_tmul, extendDualLinear_tmul]
    simp only [Algebra.smul_def, mul_one, map_mul]
  | add a b ha hb =>
    simp only [map_add, TensorProduct.tmul_add, add_smul, ha, hb]

private def extendDual (A : HopfAlgebraCategory k) :
    ConvolutionDual A →ₐ[k] ConvolutionDual (extendedHopf K A) where
  toFun := extendDualLinear K A
  map_zero' := (extendDualLinear K A).map_zero
  map_add' := (extendDualLinear K A).map_add
  map_mul' := extendDualLinear_powCompat K A
  map_one' := by
    apply WithConv.ext
    let j := (TensorProduct.mk k K A) 1
    have hbc : IsBaseChange K j := TensorProduct.isBaseChange k A K
    apply hbc.algHom_ext
    intro b
    rw [show j b = (1 : K) ⊗ₜ[k] b from rfl, extendDualLinear_tmul]
    change counit (R := k) b • (1 : K) = counit (R := K) ((1 : K) ⊗ₜ[k] b)
    rw [TensorProduct.counit_tmul]
    rfl
  commutes' c := by
    have h : extendDualLinear K A 1 = 1 := by
      apply WithConv.ext
      let j := (TensorProduct.mk k K A) 1
      have hbc : IsBaseChange K j := TensorProduct.isBaseChange k A K
      apply hbc.algHom_ext
      intro b
      rw [show j b = (1 : K) ⊗ₜ[k] b from rfl, extendDualLinear_tmul]
      change counit (R := k) b • (1 : K) = counit (R := K) ((1 : K) ⊗ₜ[k] b)
      rw [TensorProduct.counit_tmul]
      rfl
    simp only [Algebra.algebraMap_eq_smul_one, map_smul, h]

private theorem extendDual_span (A : HopfAlgebraCategory k) [Module.Finite k A] :
    Submodule.span K (Set.range (extendDual K A)) = ⊤ := by
  let J := (TensorProduct.mk k K A) 1
  have hJ : IsBaseChange K J := TensorProduct.isBaseChange k A K
  apply top_unique
  intro x _
  have he (f : Module.Dual k A) :
      hJ.toDual f = (extendDual K A (toConv f)).ofConv := by
    apply hJ.algHom_ext
    intro a
    rw [hJ.toDual_comp_apply]
    change algebraMap k K (f a) = (extendDualLinear K A (toConv f)).ofConv ((1 : K) ⊗ₜ[k] a)
    rw [extendDualLinear_tmul, Algebra.smul_def, mul_one]
  have hx (y : Module.Dual K (extendedHopf K A)) :
      toConv y ∈ Submodule.span K (Set.range (extendDual K A)) := by
    refine (hJ.dual).inductionOn y ?_ ?_ ?_
    · intro f
      rw [he]
      exact Submodule.subset_span ⟨toConv f, rfl⟩
    · intro c g hg
      exact Submodule.smul_mem _ c hg
    · intro g h hg hh
      exact Submodule.add_mem _ hg hh
  exact hx x.ofConv

private theorem extendDual_powerSpan (A : HopfAlgebraCategory k) [IsCocomm k A] [Module.Finite k A]
    (p : ℕ) [Fact p.Prime] [CharP (ConvolutionDual (extendedHopf K A)) p] (r : ℕ) :
    Submodule.span K (Set.range (fun f : ConvolutionDual A ↦ extendDual K A (f ^ (p ^ r)))) =
      Submodule.span K (Set.range fun f : ConvolutionDual (extendedHopf K A) ↦ f ^ (p ^ r)) := by
  let D := ConvolutionDual (extendedHopf K A)
  let S := Submodule.span K (Set.range (fun f : ConvolutionDual A ↦ extendDual K A (f ^ (p ^ r))))
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨f, rfl⟩
    change extendDual K A (f ^ (p ^ r)) ∈ _
    rw [map_pow]
    exact Submodule.subset_span ⟨extendDual K A f, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨f, rfl⟩
    let F : D →+* D := iterateFrobenius D p r
    change F f ∈ S
    have hf : f ∈ Submodule.span K (Set.range (extendDual K A)) :=
      (extendDual_span K A).symm ▸ Submodule.mem_top
    refine Submodule.span_induction (p := fun y _ ↦ F y ∈ S) ?_ ?_ ?_ ?_ hf
    · rintro _ ⟨x, rfl⟩
      change extendDual K A x ^ (p ^ r) ∈ S
      rw [← map_pow]
      exact Submodule.subset_span ⟨x, rfl⟩
    · change F 0 ∈ S
      rw [map_zero]
      exact S.zero_mem
    · intro a b _ _ ha hb
      rw [map_add]
      exact S.add_mem ha hb
    · intro c x _ hx
      change (c • x) ^ (p ^ r) ∈ S
      rw [smul_pow]
      exact S.smul_mem _ hx

end DualBaseChange

open LinearAlgebraicGroups.CharacterDescent (mapGroupLike)

/-- The finite dual of a Hopf quotient is exactly the span of sufficiently
large Frobenius powers when the quotient preserves and detects group-like elements. -/
private theorem geometricPowerSpan [IsAlgClosed k] (A : HopfAlgebraCategory k)
    [IsCocomm k A] [Module.Finite k A] (M : Type u) [CommGroup M] [Fintype M]
    (a : A ⟶ groupAlgebra k M) (ha : Function.Surjective a.hom)
    (hg : Function.Injective (mapGroupLike a))
    (p : ℕ) [Fact p.Prime] [CharP (ConvolutionDual A) p] :
    ∃ r : ℕ,
      Submodule.span k (Set.range fun f : ConvolutionDual A ↦ f ^ (p ^ r)) =
        LinearMap.range
          (((a.hom.toCoalgHom).convPrecomp (A := k)) :
            ConvolutionDual (groupAlgebra k M) →ₐ[k] ConvolutionDual A).toLinearMap := by
  classical
  let D := ConvolutionDual A
  let B := groupAlgebra k M
  let f : ConvolutionDual B →ₐ[k] D := a.hom.toCoalgHom.convPrecomp
  let e := groupAlgebraDualIso (k := k) M
  let j := f.comp e.symm.toAlgHom
  haveI : Module.Finite k D :=
    Module.Finite.equiv (WithConv.linearEquiv k (Module.Dual k A)).symm
  have hf : Function.Injective f := CoalgHom.convPrecomp_injective ha
  have hj : Function.Injective j := hf.comp e.symm.injective
  have heq : Function.Injective (fun L : D →ₐ[k] k ↦ L.comp j) := by
    intro P Q hPQ
    obtain ⟨x, rfl⟩ := evalGroupLike_surjective A P
    obtain ⟨y, rfl⟩ := evalGroupLike_surjective A Q
    congr 1
    apply hg
    apply GroupLike.val_injective
    haveI : Module.Finite k B := Module.Finite.of_surjective a.hom.toLinearMap ha
    apply (Module.evalEquiv k B).injective
    ext l
    change l (a.hom x.val) = l (a.hom y.val)
    have hx := DFunLike.congr_fun hPQ (e (toConv l))
    change (f (e.symm (e (toConv l)))).ofConv x.val =
      (f (e.symm (e (toConv l)))).ofConv y.val at hx
    rw [e.symm_apply_apply] at hx
    exact hx
  have hsurj := characterRestriction_surjective j hj
  choose χ hχ using fun m : M ↦ hsurj (Pi.evalAlgHom k (fun _ : M ↦ k) m)
  have hs : Function.Surjective χ := by
    intro g
    obtain ⟨a₀, rfl⟩ := evalGroupLike_surjective A g
    obtain ⟨m, hm⟩ := (LinearAlgebraicGroups.CharacterDescent.monomialCharacterEquiv
      (M := M) k).surjective (mapGroupLike a a₀)
    refine ⟨m, heq ?_⟩
    rw [hχ m]
    ext v
    change v m = (j v).ofConv a₀.val
    change v m = (e.symm v).ofConv (a.hom a₀.val)
    rw [← show (MonoidAlgebra.of k M m : B) = a.hom a₀.val from
      congrArg GroupLike.val hm]
    change v m = e (e.symm v) m
    rw [AlgEquiv.apply_symm_apply]
  obtain ⟨r, h⟩ := span_primePowers_of_characterRestriction p j χ hs hχ
  refine ⟨r, h.trans ?_⟩
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact ⟨e.symm x, rfl⟩
  · rintro _ ⟨x, rfl⟩
    exact ⟨e x, by change f (e.symm (e x)) = f x; rw [AlgEquiv.symm_apply_apply]⟩

section DualKernelDescent

variable (K : Type u) [Field K] [Algebra k K]

private theorem extendedIdeal_eq_of_dualPowerSpan (A : HopfAlgebraCategory k)
    (B : HopfAlgebraCategory K) (ρ : extendedHopf K A ⟶ B) (p r : ℕ)
    (h : Submodule.span K (Set.range (fun f : ConvolutionDual A ↦ extendDual K A (f ^ (p ^ r)))) =
      LinearMap.range ((ρ.hom.toCoalgHom.convPrecomp (A := K)).toLinearMap)) :
    extendedIdeal K ((RingHom.ker ρ.hom.toAlgHom.toRingHom).comap (includeCoordinates K A)) =
      RingHom.ker ρ.hom.toAlgHom.toRingHom := by
  classical
  let j := includeCoordinates K A
  let J := RingHom.ker ρ.hom.toAlgHom.toRingHom
  let I := J.comap j
  let S := Submodule.span K (Set.range (fun f : ConvolutionDual A ↦ extendDual K A (f ^ (p ^ r))))
  have htest (z : extendedHopf K A) :
      z ∈ J ↔ ∀ f : ConvolutionDual A, (extendDual K A (f ^ (p ^ r))).ofConv z = 0 := by
    let e : ConvolutionDual (extendedHopf K A) →ₗ[K] K :=
      (Module.Dual.eval K _ z).comp (WithConv.linearEquiv K _).toLinearMap
    have he : S ≤ LinearMap.ker e ↔
        ∀ f : ConvolutionDual A, (extendDual K A (f ^ (p ^ r))).ofConv z = 0 := by
      rw [Submodule.span_le]
      exact Set.range_subset_iff
    rw [← he]
    change _ ↔ S ≤ _
    rw [show S = _ from h, LinearMap.range_le_iff_comap, eq_top_iff]
    constructor
    · intro hz f _
      change f.ofConv (ρ.hom z) = 0
      rw [show ρ.hom z = 0 from hz, map_zero]
    · intro hh
      change ρ.hom z = 0
      let b := Module.Free.chooseBasis K B
      apply b.repr.injective
      ext i
      change b.coord i (ρ.hom z) = b.repr 0 i
      rw [map_zero, Finsupp.zero_apply]
      exact hh (Submodule.mem_top (x := toConv (b.coord i)))
  apply le_antisymm (Ideal.map_le_iff_le_comap.mpr le_rfl)
  intro z hz
  let b := Module.Free.chooseBasis k K
  let e := TensorProduct.equivFinsuppOfBasisLeft (N := A) b
  obtain ⟨v, rfl⟩ := e.symm.surjective z
  have hco (i : _) (f : ConvolutionDual A) :
      b.coord i ((extendDual K A (f ^ (p ^ r))).ofConv (e.symm v)) =
        (f ^ (p ^ r)).ofConv (v i) := by
    let ell := (f ^ (p ^ r)).ofConv
    have heq (x : K ⊗[k] A) :
        b.coord i ((extendDual K A (f ^ (p ^ r))).ofConv x) = ell (e x i) := by
      induction x using TensorProduct.inductionOn with
      | tmul c a =>
        change b.coord i ((extendDualLinear K A (f ^ (p ^ r))).ofConv (c ⊗ₜ[k] a)) = _
        rw [extendDualLinear_tmul, TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply,
          map_smul, map_smul]
        rw [smul_eq_mul, smul_eq_mul, mul_comm]
        rfl
      | add x y hx hy => simp only [map_add, Finsupp.add_apply, hx, hy]
    rw [heq, e.apply_symm_apply]
  have hi (i : _) : v i ∈ I := by
    apply (htest (j (v i))).mpr
    intro f
    change (extendDualLinear K A (f ^ (p ^ r))).ofConv ((1 : K) ⊗ₜ[k] v i) = 0
    rw [extendDualLinear_tmul, ← hco, (htest _).mp hz f, map_zero, zero_smul]
  rw [TensorProduct.equivFinsuppOfBasisLeft_symm_apply, Finsupp.sum]
  apply (I.map j).sum_mem
  intro i _
  have hm := Ideal.mem_map_of_mem j (hi i)
  have hw := (I.map j).mul_mem_left ((b i) ⊗ₜ[k] (1 : A)) hm
  change ((b i) ⊗ₜ[k] (1 : A)) * ((1 : K) ⊗ₜ[k] v i) ∈ _ at hw
  simpa only [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul] using hw


private theorem hopfIdeal_of_extended_kernel (A : HopfAlgebraCategory k)
    (B : HopfAlgebraCategory K) (ρ : extendedHopf K A ⟶ B)
    (hρ : Function.Surjective ρ.hom) (I : Ideal A)
    (hI : extendedIdeal K I = RingHom.ker ρ.hom.toAlgHom.toRingHom) :
    I.IsHopfIdeal k := by
  let j := includeCoordinates K A
  let J := RingHom.ker ρ.hom.toAlgHom.toRingHom
  have hm (x : A) (hx : x ∈ I) : ρ.hom (j x) = 0 := by
    apply RingHom.mem_ker.mp
    change j x ∈ RingHom.ker ρ.hom.toAlgHom.toRingHom
    rw [← hI]
    exact Ideal.mem_map_of_mem j hx
  let e : K ⊗[k] (A ⧸ I) ≃ₐ[K] B :=
    (Algebra.TensorProduct.tensorQuotientEquiv (R := k) K A K I).trans
      ((Ideal.quotientEquivAlgOfEq K hI).trans
        (Ideal.quotientKerAlgEquivOfSurjective hρ))
  have he (x : A) : e ((1 : K) ⊗ₜ[k] Ideal.Quotient.mk I x) = ρ.hom (j x) := rfl
  refine { toIsCoideal := ⟨?_, ?_⟩, antipode_mem := ?_ }
  · intro x hx
    apply (algebraMap k K).injective
    rw [map_zero]
    have h := CoalgHomClass.counit_comp_apply ρ.hom (j x)
    rw [hm x hx, map_zero] at h
    change 0 = counit (R := K) ((1 : K) ⊗ₜ[k] x) at h
    rw [TensorProduct.counit_tmul] at h
    change 0 = counit (R := k) x • (1 : K) at h
    rw [Algebra.algebraMap_eq_smul_one]
    exact h.symm
  · intro x hx
    let C := A ⧸ I
    let q := (Ideal.Quotient.mkₐ k I).toLinearMap
    let t := TensorProduct.AlgebraTensorModule.tensorTensorTensorComm k K k K K K C C
    let s := TensorProduct.congr
      ((TensorProduct.lid K K).symm.restrictScalars k) (LinearEquiv.refl k (C ⊗[k] C))
    let v := TensorProduct.congr e.toLinearEquiv e.toLinearEquiv
    let d (y : C ⊗[k] C) : B ⊗[K] B := v (t (s ((1 : K) ⊗ₜ[k] y)))
    have hd : Function.Injective d := v.injective.comp (t.injective.comp (s.injective.comp
      (Module.FaithfullyFlat.tensorProduct_mk_injective (A := k) (B := K) (C ⊗[k] C))))
    have hl : TensorProduct.map ρ.hom.toLinearMap ρ.hom.toLinearMap
          (comul (R := K) ((1 : K) ⊗ₜ[k] x)) = 0 := by
      have h := CoalgHomClass.map_comp_comul_apply ρ.hom (j x)
      rw [hm x hx, map_zero] at h
      exact h
    have hc (z : A ⊗[k] A) :
        d (TensorProduct.map q q z) =
          TensorProduct.map ρ.hom.toLinearMap ρ.hom.toLinearMap
            (TensorProduct.AlgebraTensorModule.tensorTensorTensorComm k K k K K K A A
              (((1 : K) ⊗ₜ[K] (1 : K)) ⊗ₜ[k] z)) := by
      induction z using TensorProduct.inductionOn with
      | tmul a b =>
        rw [TensorProduct.map_tmul, TensorProduct.AlgebraTensorModule.tensorTensorTensorComm_tmul,
          TensorProduct.map_tmul]
        change (e ((1 : K) ⊗ₜ[k] Ideal.Quotient.mk I a)) ⊗ₜ[K]
           (e ((1 : K) ⊗ₜ[k] Ideal.Quotient.mk I b)) = _
        rw [he, he]
        rfl
      | add a b ha hb =>
        simp [d, map_add, TensorProduct.tmul_add] at ha hb ⊢
        rw [ha, hb]
    apply hd
    change d (TensorProduct.map q q (comul (R := k) x)) = d 0
    have hd₀ : d 0 = 0 := by simp only [d, TensorProduct.tmul_zero, map_zero]
    rw [hd₀, hc]
    have hc1 : comul (R := K) (1 : K) = (1 : K) ⊗ₜ[K] (1 : K) := rfl
    rw [TensorProduct.comul_tmul, hc1] at hl
    exact hl
  · intro x hx
    have h := DFunLike.congr_fun (hopfSpecMorphism K ρ).2 (j x)
    change ρ.hom (antipode K (j x)) = antipode K (ρ.hom (j x)) at h
    rw [hm x hx, map_zero] at h
    have hEq : antipode K (j x) = j (antipode k x) := by
      change HopfAlgebra.antipode K ((1 : K) ⊗ₜ[k] x) =
        (1 : K) ⊗ₜ[k] (HopfAlgebra.antipode k x)
      rw [TensorProduct.antipode_def, TensorProduct.AlgebraTensorModule.map_tmul, antipode_one]
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply (Module.FaithfullyFlat.tensorProduct_mk_injective (A := k) (B := K) (A ⧸ I))
    apply e.injective
    change e ((1 : K) ⊗ₜ[k] Ideal.Quotient.mk I (antipode k x)) = e ((1 : K) ⊗ₜ[k] 0)
    rw [he, TensorProduct.tmul_zero, map_zero, ← hEq]
    exact h

end DualKernelDescent

open private extendedGroupIso extendedSpecIso_natural liftHopfQuotient
  from LinearAlgebraicGroups.Affine.ClosedSubgroups

private theorem schemeKernel_of_comp_mono {G Q I : GroupScheme k} (p : G ⟶ Q) (i : Q ⟶ I)
    [Mono i.hom.hom] {N : ClosedSubgroup G} (h : IsSchemeKernel (p ≫ i) N) :
    IsSchemeKernel p N := by
  have hkill : N.inclusion.hom.hom ≫ p.hom.hom = toUnit _ ≫ η[Q.X] := by
    apply (cancel_mono i.hom.hom).mp
    rw [Category.assoc, Category.assoc, IsMonHom.one_hom]
    exact h.w
  refine IsPullback.mk' hkill ?_ ?_
  · intro R a b hab h'
    exact h.hom_ext hab h'
  · intro R a b hab
    have hab' : a ≫ (p ≫ i).hom.hom = b ≫ η[I.X] := by
      change a ≫ p.hom.hom ≫ i.hom.hom = _
      rw [← Category.assoc, hab, Category.assoc, IsMonHom.one_hom]
    exact ⟨h.lift a b hab', h.lift_fst _ _ _, h.lift_snd _ _ _⟩

