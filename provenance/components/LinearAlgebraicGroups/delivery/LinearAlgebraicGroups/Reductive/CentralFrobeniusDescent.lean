private theorem characterRestriction_of_unipotent_image
    (G Q : AffineAlgebraicGroup k) (q : G.val ⟶ Q.val) (hQ : IsUnipotent Q)
    {N : ClosedSubgroup G.val} (hN : IsSchemeKernel q N) :
    Function.Injective (fun χ : Character G.val ↦ N.inclusion ≫ χ) := by
  obtain ⟨I, p, i, hF, _, _⟩ := schemeImageFactorization G Q q
  letI : IsClosedImmersion i.hom.hom.left := hF.2.2.2.2.2
  letI : Mono i.hom.hom := Over.mono_of_mono_left _
  letI : Flat p.hom.hom.left := hF.2.1
  letI : Surjective p.hom.hom.left := hF.2.2.1
  letI : IsAffine G.val.X.left := G.property.1
  letI : IsAffine I.val.X.left := I.property.1
  let H : ClosedSubgroup Q.val := ⟨I.val, i, inferInstance⟩
  have hI := LinearAlgebraicGroups.Unipotent.closedSubgroupsUnipotent Q H hQ
  have hp : IsSchemeKernel p N := schemeKernel_of_comp_mono p i (hF.1.symm ▸ hN)
  intro x y hxy
  have hxy' : N.inclusion.hom.hom ≫ x.hom.hom = N.inclusion.hom.hom ≫ y.hom.hom :=
    (Grp.forget _).congr_map hxy
  have hz : N.inclusion.hom.hom ≫ (x * y⁻¹).hom.hom = 1 := by
    change N.inclusion.hom.hom ≫ (x.hom.hom * y.hom.hom⁻¹) = 1
    rw [MonObj.comp_mul, GrpObj.comp_inv, hxy', mul_inv_cancel]
  obtain ⟨z, hz⟩ := descendHomOfSchemeKernel p hp (x * y⁻¹) hz
  let B := diagonalGroup k IntegerCharacters
  haveI : Group.FG (IntegerCharacters.{u}) :=
    Group.fg_of_surjective (f := (MulEquiv.ulift.symm : Multiplicative ℤ ≃* IntegerCharacters).toMonoidHom)
      (MulEquiv.ulift.symm : Multiplicative ℤ ≃* IntegerCharacters).surjective
  let B₀ := groupAlgebra k IntegerCharacters
  let h : extendedHopf k B₀ ≅ B₀ :=
    CommHopfAlgCat.isoMk (Bialgebra.TensorProduct.lid k (MonoidAlgebra k IntegerCharacters.{u}))
  let h₀ := (hopfSpec (CommRingCat.of k)).mapIso h.symm.op
  have hB : (multiplicativeTypeSpecFunctor k).essImage B :=
    (LinearAlgebraicGroups.CharacterDescent.multiplicativeTypeGroupCriterion B).mpr
      ⟨k, inferInstance, inferInstance, inferInstance,
        ⟨CommGrpCat.of IntegerCharacters, inferInstance⟩, ⟨(extendedGroupIso k B₀).symm ≪≫ h₀⟩⟩
  have h0 := LinearAlgebraicGroups.Unipotent.homFromUnipotentToMultiplicativeType
    (closedSubgroupAlgebraicGroup H) B z hI hB
  rw [h0, comp_zero] at hz
  have h1 : x * y⁻¹ = 1 := hz.symm
  exact mul_inv_eq_one.mp h1

private theorem groupLike_injective_of_unipotent_image
    (A B : HopfAlgebraCategory k) [Algebra.FiniteType k A] (a : A ⟶ B)
    (ha : Function.Surjective a.hom) (Q : AffineAlgebraicGroup k) (hQ : IsUnipotent Q)
    (q : specGroup A ⟶ Q.val)
    (hk : IsSchemeKernel q ⟨specGroup B, specGroupMap a, (hopfMapClosedImmersion k _).mpr ha⟩) :
    Function.Injective (mapGroupLike a) := by
  let G := (finiteTypeHopfSpec k).obj (op ⟨A, inferInstance⟩)
  have hc := characterRestriction_of_unipotent_image G Q q hQ hk
  obtain ⟨e, he, _⟩ := LinearAlgebraicGroups.CharacterDescent.characterInterpretation (k := k)
  intro x y hxy
  apply (e A).injective
  apply hc
  change specGroupMap a ≫ e A x = specGroupMap a ≫ e A y
  exact (he A B a x).symm.trans ((congrArg (e B) hxy).trans (he A B a y))

