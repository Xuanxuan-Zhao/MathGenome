  from LinearAlgebraicGroups.Multiplicative.DiagonalizableGroups

private lemma torus_of_iso {S T : GroupScheme k} (e : S ≅ T) (h : IsTorus S) :
    IsTorus T := by
  obtain ⟨K, hK, hAlg, hSep, n, ⟨a⟩⟩ := h
  let F := @groupBaseChange k _ K hK hAlg
  exact ⟨K, hK, hAlg, hSep, n, ⟨F.mapIso e.symm ≪≫ a⟩⟩

/-- A torus is a commutative group scheme over its ground field. -/
theorem torus_commutative (T : AffineAlgebraicGroup k) (hT : IsTorus T.val) :
    IsCommMonObj T.val.X := by
  obtain ⟨A, _, ⟨e⟩⟩ := groupPresentation T
  have hA := (LinearAlgebraicGroups.CharacterDescent.torusOnSchemes A).mpr
    (torus_of_iso e.symm hT)
  have hm := LinearAlgebraicGroups.CharacterDescent.torusIsMultiplicativeType A hA
  exact isCommMonObj_of_groupIso e
    (LinearAlgebraicGroups.CharacterDescent.multiplicativeTypeProperties A hm).2

private theorem splitDiagonal_commutative (M : Type u) [CommGroup M] :
    IsCommMonObj (specGroup (groupAlgebra k M)).X :=
  (hopfSpecCommutativity k (groupAlgebra k M)).mpr
    (inferInstanceAs (IsCocomm k (MonoidAlgebra k M)))

open private splitGroupHomEquiv from LinearAlgebraicGroups.Multiplicative.CharacterDescent

private theorem splitDiagonal_powerHom (M : Type u) [CommGroup M] (n : ℕ) :
    letI := splitDiagonal_commutative (k := k) M
    powerHom (specGroup (groupAlgebra k M)) n =
      specGroupMap (groupAlgebraMap k (powMonoidHom (α := M) n)) := by
  let A := groupAlgebra k M
  let e := splitGroupHomEquiv (k := k) M M
  have hid : e (MonoidHom.id M) = 𝟙 (specGroup A) := by
    change specGroupMap (groupAlgebraMap k (MonoidHom.id M)) = _
    have ha : groupAlgebraMap k (MonoidHom.id M) = 𝟙 A := by
      apply CommHopfAlgCat.hom_ext
      exact MonoidAlgebra.mapDomainBialgHom_id
    rw [ha]
    change (hopfSpec (CommRingCat.of k)).map (𝟙 (op A)) = _
    exact (hopfSpec (CommRingCat.of k)).map_id _
  have hp : (MonoidHom.id M) ^ n = powMonoidHom n := by
    ext x
    simp
  change (𝟙 (specGroup A)) ^ n = e (powMonoidHom n)
  rw [← hp, map_pow, hid]

private theorem powerHom_iso {S T : GroupScheme k}
    [IsCommMonObj S.X] [IsCommMonObj T.X] (e : S ≅ T) (n : ℕ) :
    powerHom S n ≫ e.hom = e.hom ≫ powerHom T n := by
  apply Grp.hom_ext
  change (powerHom S n).hom.hom ≫ e.hom.hom.hom = e.hom.hom.hom ≫ (powerHom T n).hom.hom
  rw [powerHom_onSections]
  simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  change ((𝟙 S.X) ^ n) ≫ e.hom.hom.hom = e.hom.hom.hom ^ n
  rw [MonObj.pow_comp, Category.id_comp]

private theorem powerHom_baseChange (K : Type u) [Field K] [Algebra k K] {S : GroupScheme k}
    [IsCommMonObj S.X] [IsCommMonObj ((groupBaseChange k K).obj S).X] (n : ℕ) :
    (groupBaseChange k K).map (powerHom S n) = powerHom ((groupBaseChange k K).obj S) n := by
  apply Grp.hom_ext
  change (baseChange k K).map (powerHom S n).hom.hom =
    (powerHom ((groupBaseChange k K).obj S) n).hom.hom
  simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  letI : MonObj ((baseChange k K).obj S.X) :=
    inferInstanceAs (MonObj ((groupBaseChange k K).obj S).X)
  have h := (Functor.homMonoidHom (baseChange k K)).map_pow (𝟙 S.X) n
  change (baseChange k K).map ((𝟙 S.X) ^ n) = ((baseChange k K).map (𝟙 S.X)) ^ n at h
  exact h.trans (congrArg (fun f : (baseChange k K).obj S.X ⟶ (baseChange k K).obj S.X ↦ f ^ n)
    ((baseChange k K).map_id S.X))

private theorem flat_of_surjective_to_reduced (S T : AffineAlgebraicGroup k)
    (f : S.val ⟶ T.val) [Surjective f.hom.hom.left] [IsReduced T.val.X.left] :
    Flat f.hom.hom.left := by
  obtain ⟨_, p, i, h, _, _⟩ := schemeImageFactorization S T f
  have hi : IsClosedImmersion i.hom.hom.left := h.2.2.2.2.2
  have hp : Flat p.hom.hom.left := h.2.1
  have he : p.hom.hom.left ≫ i.hom.hom.left = f.hom.hom.left :=
    congrArg (fun j : S.val ⟶ T.val ↦ j.hom.hom.left) h.1
  have : Surjective (p.hom.hom.left ≫ i.hom.hom.left) := he ▸ inferInstanceAs (Surjective f.hom.hom.left)
  have : Surjective i.hom.hom.left := Surjective.of_comp p.hom.hom.left _
  have : IsIso i.hom.hom.left := isIso_of_isClosedImmersion_of_surjective _
  rw [← he]
  infer_instance

private theorem splitDiagonal_power_flat_surjective
    (M : Type u) [CommGroup M] [Group.FG M] [IsMulTorsionFree M] (n : ℕ) (hn : n ≠ 0) :
    letI := splitDiagonal_commutative (k := k) M
    let f := powerHom (specGroup (groupAlgebra k M)) n
    Flat f.hom.hom.left ∧ Surjective f.hom.hom.left := by
  letI := splitDiagonal_commutative (k := k) M
  dsimp only
  rw [splitDiagonal_powerHom]
  let a := groupAlgebraMap k (powMonoidHom (α := M) n)
  have : Algebra.FiniteType k (groupAlgebra k M) :=
    inferInstanceAs (Algebra.FiniteType k (MonoidAlgebra k M))
  exact (flat_and_surjective_SpecMap_iff
    (CommRingCat.ofHom a.hom.toAlgHom.toRingHom)).mpr
      (hopfFaithfulFlatness k a (groupAlgebraMap_injective _
        (fun _ _ h ↦ eq_of_pow_eq_pow_of_commute hn (Commute.all _ _) h)))

private theorem lattice_fg (r : ℕ) : Group.FG (StandardLattice.{u} r) := by
  let e : Multiplicative ℤ ≃* Specs.DiagonalizableGroups.IntegerCharacters.{u} := MulEquiv.ulift.symm
  have h : Group.FG Specs.DiagonalizableGroups.IntegerCharacters.{u} :=
    Group.fg_of_surjective (f := e.toMonoidHom) e.surjective
  apply Group.fg_def.mpr
  simpa only [Subgroup.pi_top] using
    (Subgroup.FG.pi (P := fun (_ : Fin r) => (⊤ : Subgroup Specs.DiagonalizableGroups.IntegerCharacters))
      fun _ => Group.fg_def.mp h)

private theorem torsionFree_lattice (r : ℕ) : IsMulTorsionFree (StandardLattice.{u} r) := by
  letI : IsAddTorsionFree ℤ := inferInstance
  let e : ULift.{u} (Multiplicative ℤ) ≃* Multiplicative ℤ := MulEquiv.ulift
  letI : IsMulTorsionFree (ULift.{u} (Multiplicative ℤ)) :=
    Function.Injective.isMulTorsionFree e.toMonoidHom e.injective
  infer_instance

open private isReduced_of_smooth_over_field
  from LinearAlgebraicGroups.Affine.SmoothnessCriteria

open private baseChangeMapPullback from LinearAlgebraicGroups.Affine.Components

private theorem groupBaseChange_isPullback (K : Type u) [Field K] [Algebra k K]
    {X Y : GroupScheme k} (f : X ⟶ Y) :
    IsPullback ((groupBaseChange k K).map f).hom.hom.left
      (pullback.fst X.X.hom (fieldSpecMap k K))
      (pullback.fst Y.X.hom (fieldSpecMap k K)) f.hom.hom.left :=
  baseChangeMapPullback f.hom.hom

private theorem torus_smooth (T : AffineAlgebraicGroup k) (h : IsTorus T.val) :
    Smooth T.val.X.hom := by
  obtain ⟨A, _, ⟨e⟩⟩ := groupPresentation T
  have hA := (LinearAlgebraicGroups.CharacterDescent.torusOnSchemes A).mpr
    (torus_of_iso e.symm h)
  haveI : Smooth (specGroup A).X.hom :=
    ((LinearAlgebraicGroups.SmoothnessAndIsogenies.smoothConnectedMultiplicativeType A).mp hA).2.1
  haveI : IsIso e.inv.hom.hom.left :=
    (Grp.forget (SchemeOver k) ⋙ Over.forget _).map_isIso e.inv
  rw [← e.inv.hom.hom.w]
  exact smooth_comp _ _

/-- The positive power map of a torus is faithfully flat, including when the
power is divisible by the characteristic. -/
theorem torus_power_flat_surjective (T : AffineAlgebraicGroup k) (hT : IsTorus T.val)
    [IsCommMonObj T.val.X] (n : ℕ) (hn : n ≠ 0) :
    Flat (powerHom T.val n).hom.hom.left ∧ Surjective (powerHom T.val n).hom.hom.left := by
  have hs := torus_smooth T hT
  obtain ⟨K, _, _, _, r, ⟨e⟩⟩ := hT
  let F := groupBaseChange k K
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := K) r
  let M := StandardLattice.{u} r
  let A := specGroup (groupAlgebra K M)
  let i : A ≅ F.obj T.val := d ≪≫ e.symm
  haveI : Group.FG M := lattice_fg r
  haveI : IsMulTorsionFree M := torsionFree_lattice r
  haveI : IsCommMonObj A.X := splitDiagonal_commutative M
  haveI : IsCommMonObj (F.obj T.val).X := isCommMonObj_of_groupIso i inferInstance
  let q := (powerHom T.val n).hom.hom.left
  have hqK : Surjective (F.map (powerHom T.val n)).hom.hom.left := by
    rw [powerHom_baseChange]
    have hi : IsIso i.hom.hom.hom.left :=
      (Grp.forget (SchemeOver K) ⋙ Over.forget _).map_isIso i.hom
    have he : (powerHom A n).hom.hom.left ≫ i.hom.hom.hom.left =
        i.hom.hom.hom.left ≫ (powerHom (F.obj T.val) n).hom.hom.left :=
      congrArg (fun f : A ⟶ F.obj T.val ↦ f.hom.hom.left) (powerHom_iso i n)
    have hp : Surjective (powerHom A n).hom.hom.left :=
      (splitDiagonal_power_flat_surjective M n hn).2
    have hc : Surjective (i.hom.hom.hom.left ≫ (powerHom (F.obj T.val) n).hom.hom.left) := by
      rw [← he]
      exact MorphismProperty.comp_mem _ _ _ hp inferInstance
    exact Surjective.of_comp i.hom.hom.hom.left _
  let b := fieldSpecMap k K
  have hp := groupBaseChange_isPullback K (powerHom T.val n)
  have hcover : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u})
      (pullback.fst T.val.X.hom b) := ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩
  have hq : Surjective q :=
    MorphismProperty.of_isPullback_of_descendsAlong (P := @Surjective) hp hcover hqK
  haveI : Smooth T.val.X.hom := hs
  haveI : IsReduced T.val.X.left := isReduced_of_smooth_over_field T.val.X.hom
  exact ⟨flat_of_surjective_to_reduced T T (powerHom T.val n), hq⟩

open scoped TensorProduct
open private specGroupMap_comp from LinearAlgebraicGroups.Affine.ClosedSubgroups
open private extAlong from LinearAlgebraicGroups.Affine.RelativeFrobenius
open Specs.CentralFrobeniusDescent (IsFirstFrobeniusKernel)

private def frobeniusTwistHopfFunctor (p : ℕ) [Fact p.Prime] [CharP k p] :
    HopfAlgebraCategory k ⥤ HopfAlgebraCategory k :=
  @LinearAlgebraicGroups.CharacterDescent.extendedHopfFunctor k k _ _ (frobenius k p).toAlgebra

private theorem relativeFrobenius_natural (p : ℕ) [Fact p.Prime] [CharP k p]
    {A B : HopfAlgebraCategory k} (f : A ⟶ B) :
    LinearAlgebraicGroups.RelativeFrobenius.pullback p A ≫ f =
      (frobeniusTwistHopfFunctor p).map f ≫ LinearAlgebraicGroups.RelativeFrobenius.pullback p B := by
  let l := (LinearAlgebraicGroups.RelativeFrobenius.pullback p A ≫ f).hom.toAlgHom
  let r := ((frobeniusTwistHopfFunctor p).map f ≫
    LinearAlgebraicGroups.RelativeFrobenius.pullback p B).hom.toAlgHom
  have h : l = r := by
    apply extAlong (frobenius k p) A
    intro a
    let t := Specs.RelativeFrobenius.scalarTensor (frobenius k p)
    have hf : ((frobeniusTwistHopfFunctor p).map f).hom (t A 1 a) = t B 1 (f.hom a) := by
      rfl
    change f.hom ((LinearAlgebraicGroups.RelativeFrobenius.pullback p A).hom (t A 1 a)) =
      (LinearAlgebraicGroups.RelativeFrobenius.pullback p B).hom
        (((frobeniusTwistHopfFunctor p).map f).hom (t A 1 a))
    have hA := LinearAlgebraicGroups.RelativeFrobenius.pullback_formula p A 1 a
    have hB := LinearAlgebraicGroups.RelativeFrobenius.pullback_formula p B 1 (f.hom a)
    simp only [one_smul] at hA hB
    rw [hf]
    exact (congrArg f.hom hA).trans ((map_pow f.hom a p).trans hB.symm)
  exact CommHopfAlgCat.hom_ext (BialgHom.ext fun a ↦ DFunLike.congr_fun h a)

/-- On the spectrum of a group algebra, relative Frobenius is the (p)-power
homomorphism followed by the split identification with the Frobenius twist. -/
private theorem splitRelativeFrobenius (p : ℕ) [Fact p.Prime] [CharP k p]
    (M : Type u) [CommGroup M] :
    let A := groupAlgebra k M
    letI := splitDiagonal_commutative (k := k) M
    ∃ d : specGroup A ≅ Specs.RelativeFrobenius.twist k p A,
      powerHom (specGroup A) p ≫ d.hom =
        LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p A := by
  let A := groupAlgebra k M
  let e : Specs.RelativeFrobenius.twistCoordinates k p A ≅ A :=
    CommHopfAlgCat.isoMk (@LinearAlgebraicGroups.CharacterDescent.groupAlgebraBaseChange
      k k _ _ (frobenius k p).toAlgebra M _)
  let h := LinearAlgebraicGroups.RelativeFrobenius.pullback p A
  let a := groupAlgebraMap k (powMonoidHom (α := M) p)
  have hh : e.inv ≫ h = a := by
    let l : MonoidAlgebra k M →ₐ[k] MonoidAlgebra k M := (e.inv ≫ h).hom.toAlgHom
    let r : MonoidAlgebra k M →ₐ[k] MonoidAlgebra k M := a.hom.toAlgHom
    have he : l = r := by
      apply MonoidAlgebra.algHom_ext
      · intro m
        let x := MonoidAlgebra.single m (1 : k)
        have hx : e.inv.hom x =
            Specs.RelativeFrobenius.scalarTensor (frobenius k p) A 1 x := by
          letI := (frobenius k p).toAlgebra
          exact MonoidAlgebra.scalarTensorEquiv_symm_single (R := k) (A := k) m 1
        change h.hom (e.inv.hom x) = a.hom x
        rw [hx, LinearAlgebraicGroups.RelativeFrobenius.pullback_formula, one_smul]
        change x ^ p = (MonoidAlgebra.mapDomainBialgHom k (powMonoidHom p)) x
        rw [MonoidAlgebra.mapDomainBialgHom_single, MonoidAlgebra.single_pow, one_pow]
        rfl
      · exact AlgHom.ext fun x ↦ (l.commutes x).trans (r.commutes x).symm
    exact CommHopfAlgCat.hom_ext (BialgHom.ext fun x ↦ DFunLike.congr_fun he x)
  let d := (hopfSpec (CommRingCat.of k)).mapIso e.op
  refine ⟨d, ?_⟩
  change powerHom (specGroup A) p ≫ specGroupMap e.hom = specGroupMap h
  rw [splitDiagonal_powerHom]
  change specGroupMap a ≫ specGroupMap e.hom = specGroupMap h
  rw [← specGroupMap_comp]
  apply congrArg specGroupMap
  rw [← hh, Iso.hom_inv_id_assoc]

private theorem schemeKernel_postcompose_iso {S T U : GroupScheme k}
    (f : S ⟶ T) (e : T ≅ U) (N : ClosedSubgroup S) :
    IsSchemeKernel (f ≫ e.hom) N ↔ IsSchemeKernel f N := by
  have hc : η[T.X] ≫ e.hom.hom.hom = η[U.X] := IsMonHom.one_hom _
  constructor
  · intro h
    refine h.of_iso' (Iso.refl _) (Iso.refl _) (Iso.refl _) ((Grp.forget _).mapIso e)
      ?_ ?_ (Category.id_comp _) ((Category.id_comp _).trans hc.symm)
    · exact (Category.id_comp _).trans (Category.comp_id _).symm
    · exact (Category.id_comp _).trans (Category.comp_id _).symm
  · intro h
    refine h.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) ((Grp.forget _).mapIso e)
      ?_ ?_ (Category.id_comp _).symm (hc.trans (Category.id_comp _).symm)
    · exact (Category.comp_id _).trans (Category.id_comp _).symm
    · exact (Category.comp_id _).trans (Category.id_comp _).symm

/-- A split torus's first relative Frobenius kernel is its scheme of p-torsion,
independently of the Hopf presentation used to define relative Frobenius. -/
theorem firstFrobeniusKernel_iff_powerKernel_of_split {S : GroupScheme k}
    [IsCommMonObj S.X] (p : ℕ) [Fact p.Prime] [CharP k p] (hs : IsSplitTorus S)
    (N : ClosedSubgroup S) :
    IsFirstFrobeniusKernel p N ↔ IsSchemeKernel (powerHom S p) N := by
  obtain ⟨r, ⟨eS⟩⟩ := hs
  obtain ⟨eM⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r
  let M := StandardLattice.{u} r
  let C := groupAlgebra k M
  let b : S ≅ specGroup C := eS ≪≫ eM.symm
  letI : IsCommMonObj (specGroup C).X := splitDiagonal_commutative M
  obtain ⟨d, hd⟩ := splitRelativeFrobenius (k := k) p M
  have hsplit : powerHom S p ≫ (b ≪≫ d).hom =
      b.hom ≫ LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p C := by
    change powerHom S p ≫ b.hom ≫ d.hom =
      b.hom ≫ LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p C
    rw [← Category.assoc, powerHom_iso, Category.assoc, hd]
  constructor
  · rintro ⟨A, e, f, hf, hk⟩
    have huni :=
      (LinearAlgebraicGroups.RelativeFrobenius.relativeFrobeniusExists k p A).unique hf
        (LinearAlgebraicGroups.RelativeFrobenius.pullback_formula p A)
    subst f
    let iso : C ≅ A := ((hopfSpec.fullyFaithful (R := CommRingCat.of k)).preimageIso
      (e.symm ≪≫ b)).unop
    have hiso : specGroupMap iso.hom = e.inv ≫ b.hom :=
      (hopfSpec.fullyFaithful (R := CommRingCat.of k)).map_preimage _
    let F := frobeniusTwistHopfFunctor (k := k) p
    let d' := (hopfSpec (CommRingCat.of k)).mapIso (F.mapIso iso).op
    have hn : specGroupMap iso.hom ≫
        LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p C =
        LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p A ≫ d'.hom := by
      change specGroupMap iso.hom ≫ specGroupMap (LinearAlgebraicGroups.RelativeFrobenius.pullback p C) =
        specGroupMap (LinearAlgebraicGroups.RelativeFrobenius.pullback p A) ≫ specGroupMap (F.map iso.hom)
      rw [← specGroupMap_comp, ← specGroupMap_comp, relativeFrobenius_natural]
    have hcomp : b.hom ≫ LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p C =
        (e.hom ≫ LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p A) ≫ d'.hom := by
      rw [Category.assoc, ← hn, hiso]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
    apply (schemeKernel_postcompose_iso _ (b ≪≫ d) N).mp
    rw [hsplit, hcomp]
    exact (schemeKernel_postcompose_iso _ d' N).mpr hk
  · intro hk
    refine ⟨C, b, LinearAlgebraicGroups.RelativeFrobenius.pullback p C,
      LinearAlgebraicGroups.RelativeFrobenius.pullback_formula p C, ?_⟩
    change IsSchemeKernel (b.hom ≫ LinearAlgebraicGroups.RelativeFrobenius.relativeFrobenius p C) N
    rw [← hsplit]
    exact (schemeKernel_postcompose_iso _ (b ≪≫ d) N).mpr hk

open Specs.Unipotent (baseChangedAlgebraicGroup closedSubgroupAlgebraicGroup)

open private groupAlgebraOfCharacters groupLikeSpanOfSplit
  from LinearAlgebraicGroups.Multiplicative.CharacterDescent

set_option backward.isDefEq.respectTransparency true in
set_option maxHeartbeats 2200000 in
private theorem torus_split_of_algClosed [IsAlgClosed k] (S : AffineAlgebraicGroup k)
    (hS : IsTorus S.val) : IsSplitTorus S.val := by
  obtain ⟨A, _, ⟨s⟩⟩ := groupPresentation S
  have ht := (LinearAlgebraicGroups.CharacterDescent.torusOnSchemes A).mpr
    (torus_of_iso s.symm hS)
  have hm := LinearAlgebraicGroups.CharacterDescent.torusIsMultiplicativeType A ht
  obtain ⟨r, ⟨f⟩⟩ :=
    ((LinearAlgebraicGroups.CharacterDescent.torusAndSplitCriteria (K := k) A hm).1).mp ht
  have hd := (LinearAlgebraicGroups.CharacterDescent.splitsOverSeparableClosure (K := k) A).mp hm
  let C := extendedHopf k A
  let M := StandardLattice.{u} r
  let N : Type u := GroupLike k C
  let a : M ≃* N := f.symm
  let b₁ : groupAlgebra k M ≅ groupAlgebra k N :=
    CommHopfAlgCat.isoMk (MonoidAlgebra.domCongrBialgEquiv k k a)
  let b₂ : groupAlgebra k N ≅ C := groupAlgebraOfCharacters C (groupLikeSpanOfSplit C hd)
  let b₃ : C ≅ A := CommHopfAlgCat.isoMk (Bialgebra.TensorProduct.lid k A)
  let b := b₁ ≪≫ b₂ ≪≫ b₃
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) r
  exact ⟨r, ⟨s.symm ≪≫ (hopfSpec (CommRingCat.of k)).mapIso b.op ≪≫ d⟩⟩

/-- Finitely generated torsion-free character groups of tori are lattices. -/
private theorem lattice_of_finite_generation (M : Type u) [CommGroup M]
    [Group.FG M] [IsMulTorsionFree M] :
    ∃ r, Nonempty (M ≃* StandardLattice.{u} r) := by
  letI : HasUniqueDiv (Additive M) :=
    ⟨fun _ hn _ _ h ↦ eq_of_pow_eq_pow_of_commute (M := M) hn (Commute.all _ _) h⟩
  letI : Module.Finite ℤ (Additive M) := Module.Finite.iff_addGroup_fg.mpr inferInstance
  obtain ⟨r, b⟩ := Module.basisOfFiniteTypeTorsionFree' (R := ℤ) (M := Additive M)
  let e : M ≃* (Fin r → Multiplicative ℤ) :=
    (MulEquiv.toAdditive).symm
      (b.equivFun.toAddEquiv.trans (AddEquiv.piAdditive (fun _ : Fin r ↦ Multiplicative ℤ)).symm)
  exact ⟨r, ⟨e.trans (MulEquiv.piCongrRight fun _ ↦ MulEquiv.ulift.symm)⟩⟩

/-- Any faithfully flat algebraic group quotient of a torus splits over the
same splitting field and is again a torus. -/
theorem torus_of_flat_surjective (S T : AffineAlgebraicGroup k) (q : S.val ⟶ T.val)
    (hs : IsTorus S.val) (hf : Flat q.hom.hom.left) (hq : Surjective q.hom.hom.left) :
    IsTorus T.val := by
  obtain ⟨K, hK, hAlg, hSep, n, ⟨s⟩⟩ := hs
  let F := groupBaseChange k K
  let M := StandardLattice.{u} n
  haveI : Group.FG M := lattice_fg n
  haveI : IsMulTorsionFree M := torsionFree_lattice n
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := K) n
  let e := d ≪≫ s.symm
  let a := e.hom ≫ F.map q
  have hi : IsIso e.hom.hom.hom.left := (Grp.forget (SchemeOver K) ⋙ Over.forget _).map_isIso e.hom
  have hP := groupBaseChange_isPullback K q
  have hfa : Flat a.hom.hom.left :=
    MorphismProperty.comp_mem @Flat _ _ inferInstance
      (MorphismProperty.of_isPullback hP.flip hf)
  have hsa : Surjective a.hom.hom.left :=
    MorphismProperty.comp_mem @Surjective _ _ inferInstance
      (MorphismProperty.of_isPullback hP.flip hq)
  let T' := baseChangedAlgebraicGroup K T
  obtain ⟨L, ⟨i, _⟩, _⟩ := (LinearAlgebraicGroups.DiagonalizableGroups.diagonalFaithfullyFlatQuotients
    K M ⟨T'.val, T'.property.1⟩ a).mp ⟨hfa, hsa⟩
  letI : Group.FG L := LinearAlgebraicGroups.DiagonalizableGroups.subgroupFG L
  obtain ⟨r, ⟨f⟩⟩ := lattice_of_finite_generation L
  obtain ⟨j⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := K) r
  let h := CommHopfAlgCat.isoMk (MonoidAlgebra.domCongrBialgEquiv K K f.symm)
  exact ⟨K, hK, hAlg, hSep, r, ⟨i.symm ≪≫ (hopfSpec (CommRingCat.of K)).mapIso h.op ≪≫ j⟩⟩

open Specs.CentralFrobeniusDescent (IsCentral)
open private isMonHom_of_comp_closed schemeKernel_exists from
  LinearAlgebraicGroups.Affine.SchemeImageQuotient

private theorem preimageSubgroup {G Q : AffineAlgebraicGroup k}
    (q : G.val ⟶ Q.val) (S : ClosedSubgroup Q.val) :
    ∃ (P : ClosedSubgroup G.val) (r : P.group ⟶ S.group),
      IsPullback P.inclusion r q S.inclusion := by
  let P := pullback q S.inclusion
  let j : P ⟶ G.val := pullback.fst q S.inclusion
  let r : P ⟶ S.group := pullback.snd q S.inclusion
  have h := IsPullback.of_hasPullback q S.inclusion
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  have hj : IsClosedImmersion j.hom.hom.left :=
    MorphismProperty.of_isPullback (h.map U).flip S.isClosedImmersion
  exact ⟨⟨P, j, hj⟩, r, h⟩

private theorem kernel_of_preimage {G Q : GroupScheme k} {q : G ⟶ Q} {E : ClosedSubgroup G}
    (hE : IsSchemeKernel q E) {S : ClosedSubgroup Q} {P : ClosedSubgroup G}
    {r : P.group ⟶ S.group} (hP : IsPullback P.inclusion r q S.inclusion) :
    ∃ (i : E.group ⟶ P.group) (hi : IsClosedImmersion i.hom.hom.left),
      i ≫ P.inclusion = E.inclusion ∧ IsSchemeKernel r ⟨E.group, i, hi⟩ := by
  let H := Grp.forget (SchemeOver k)
  have h : IsPullback P.inclusion.hom.hom r.hom.hom q.hom.hom S.inclusion.hom.hom :=
    hP.map H
  have hcomp : (1 : E.group.X ⟶ S.group.X) ≫ S.inclusion.hom.hom =
      E.inclusion.hom.hom ≫ q.hom.hom := by
    rw [MonObj.one_comp]
    exact hE.w.symm
  let i₀ := h.lift E.inclusion.hom.hom (1 : E.group.X ⟶ S.group.X) hcomp.symm
  have hi₀ : i₀ ≫ P.inclusion.hom.hom = E.inclusion.hom.hom := h.lift_fst _ _ _
  have hclosed := P.isClosedImmersion
  letI : IsMonHom i₀ := isMonHom_of_comp_closed i₀ E.inclusion P.inclusion hi₀
  let i : E.group ⟶ P.group := Grp.homMk i₀
  have hi : i ≫ P.inclusion = E.inclusion := Grp.hom_ext _ _ hi₀
  have : IsClosedImmersion (i.hom.hom.left ≫ P.inclusion.hom.hom.left) := by
    change IsClosedImmersion (i ≫ P.inclusion).hom.hom.left
    rw [hi]
    exact E.isClosedImmersion
  refine ⟨i, IsClosedImmersion.of_comp_isClosedImmersion _ P.inclusion.hom.hom.left, hi, ?_⟩
  have hs : i₀ ≫ r.hom.hom = toUnit E.group.X ≫ η[S.group.X] := h.lift_snd _ _ _
  change IsPullback i₀ (toUnit E.group.X) r.hom.hom η[S.group.X]
  refine IsPullback.of_right (h₁₂ := P.inclusion.hom.hom)
    (v₁₃ := q.hom.hom) (h₂₂ := S.inclusion.hom.hom) ?_ hs h
  rw [hi₀, IsMonHom.one_hom]
  exact hE

private theorem central_of_comp_closed {E P G : GroupScheme k} (i : E ⟶ P) (j : P ⟶ G)
    (hj : IsClosedImmersion j.hom.hom.left) (h : IsCentral (i ≫ j)) :
    IsCentral i := by
  have : Mono j.hom.hom := Over.mono_of_mono_left _
  intro Y g
  apply (cancel_mono j.hom.hom).mp
  have hi : (i ≫ j).hom.hom = i.hom.hom ≫ j.hom.hom := rfl
  simpa only [Centralizes, conjugateFamily, hi, MonObj.mul_comp,
    GrpObj.inv_comp, Category.assoc] using h Y (g ≫ j.hom.hom)

private theorem isReduced_product_of_smooth (X Y : SchemeOver k)
    [Smooth X.hom] [Smooth Y.hom] : IsReduced (X ⨯ Y).left := by
  have hp := Over.isPullback_of_binaryFan_isLimit _ (prodIsProd X Y)
  have : Smooth (prod.fst : X ⨯ Y ⟶ X).left := MorphismProperty.of_isPullback hp.flip inferInstance
  have : Smooth (X ⨯ Y).hom := by
    rw [← Over.w (prod.fst : X ⨯ Y ⟶ X)]
    infer_instance
  exact isReduced_of_smooth_over_field (X ⨯ Y).hom

private theorem productMap_property {X Y Z W : SchemeOver k} (f : X ⟶ Y) (g : Z ⟶ W)
    (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [P.IsStableUnderComposition]
    [P.RespectsIso] [P.ContainsIdentities] (hf : P f.left) (hg : P g.left) : P (prod.map f g).left := by
  have h₁ : P (prod.map f (𝟙 Z)).left := P.of_isPullback
    ((IsPullback.of_prod_fst_with_id f Z).map (Over.forget _)) hf
  have h₂ : P (prod.map g (𝟙 Y)).left := P.of_isPullback
    ((IsPullback.of_prod_fst_with_id g Y).map (Over.forget _)) hg
  have he : prod.map f g = prod.map f (𝟙 Z) ≫ (prod.braiding Y Z).hom ≫
      prod.map g (𝟙 Y) ≫ (prod.braiding W Y).hom := by
    apply prod.hom_ext <;> simp
  rw [he, Over.comp_left, Over.comp_left, Over.comp_left]
  let H := Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso (prod.braiding Y Z).hom.left := H.map_isIso _
  haveI : IsIso (prod.braiding W Y).hom.left := H.map_isIso _
  exact P.comp_mem _ _ h₁ (P.comp_mem _ _ (P.of_isIso _)
    (P.comp_mem _ _ h₂ (P.of_isIso _)))

private theorem affine_product (X Y : SchemeOver k) [IsAffine X.left] [IsAffine Y.left] :
    IsAffine (X ⨯ Y).left := by
  have hp := Over.isPullback_of_binaryFan_isLimit _ (prodIsProd X Y)
  have : IsAffineHom (prod.fst : X ⨯ Y ⟶ X).left :=
    MorphismProperty.of_isPullback hp.flip inferInstance
  exact isAffine_of_isAffineHom (prod.fst : X ⨯ Y ⟶ X).left

/-- A torus in the quotient of a central radicial extension with kernel killed
by a positive integer lifts to a torus over its own field. -/
theorem liftTorusOfCentralRadicialKernel
    {G Q : AffineAlgebraicGroup k} (q : G.val ⟶ Q.val)
    [Flat q.hom.hom.left] [Surjective q.hom.hom.left]
    {E : ClosedSubgroup G.val} (hE : IsSchemeKernel q E)
    (hcentral : IsCentral E.inclusion) [UniversallyInjective E.group.X.hom]
    (n : ℕ) (hn : n ≠ 0) (hpower : E.inclusion.hom.hom ^ n = 1)
    (S : ClosedSubgroup Q.val) (hS : IsTorus S.group) :
    ∃ (T : ClosedSubgroup G.val) (f : T.group ⟶ S.group),
      IsTorus T.group ∧ T.inclusion ≫ q = f ≫ S.inclusion ∧
      Flat f.hom.hom.left ∧ Surjective f.hom.hom.left := by
  obtain ⟨P, r, hr⟩ := preimageSubgroup q S
  obtain ⟨i, hi, hcomp, hker⟩ := kernel_of_preimage hE hr
  let E' : ClosedSubgroup P.group := ⟨E.group, i, hi⟩
  change IsSchemeKernel r E' at hker
  let A := closedSubgroupAlgebraicGroup P
  let B := closedSubgroupAlgebraicGroup S
  let U := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  have hP : IsPullback P.inclusion.hom.hom.left r.hom.hom.left q.hom.hom.left
      S.inclusion.hom.hom.left := hr.map U
  have hflat : Flat r.hom.hom.left := MorphismProperty.of_isPullback hP inferInstance
  have hsurj : Surjective r.hom.hom.left := MorphismProperty.of_isPullback hP inferInstance
  have ha : IsAffine P.group.X.left := A.property.1
  have hb : IsAffine S.group.X.left := B.property.1
  haveI : IsCommMonObj B.val.X := torus_commutative B hS
  have hs : Smooth B.val.X.hom := torus_smooth B hS
  haveI : Smooth S.group.X.hom := hs
  haveI : IsCommMonObj S.group.X := inferInstanceAs (IsCommMonObj B.val.X)
  have : IsReduced (S.group.X ⨯ S.group.X).left := isReduced_product_of_smooth _ _
  have : IsAffine (P.group.X ⨯ P.group.X).left := affine_product _ _
  have : IsAffine (S.group.X ⨯ S.group.X).left := affine_product _ _
  let r₂ := prod.map r.hom.hom r.hom.hom
  have : Flat r₂.left := productMap_property _ _ @Flat hflat hflat
  have : Surjective r₂.left := productMap_property _ _ @Surjective hsurj hsurj
  have : IsRegularEpi r₂.left := isRegularEpi_of_flat_of_surjective_of_isAffine _
  have hf : IsAffine E.group.X.left := (closedSubgroupAlgebraicGroup E).property.1
  have : IsSeparated E'.group.X.hom := inferInstanceAs (IsSeparated E.group.X.hom)
  have : UniversallyInjective E'.group.X.hom := inferInstanceAs (UniversallyInjective E.group.X.hom)
  have hc : IsCentral i := central_of_comp_closed i P.inclusion P.isClosedImmersion
    (by rwa [hcomp])
  have : IsCommMonObj P.group.X := commutative_of_central_radicial_kernel hker hc
  have hm := P.isClosedImmersion
  have : Mono P.inclusion.hom.hom := Over.mono_of_mono_left _
  have hp : E'.inclusion.hom.hom ^ n = 1 := by
    apply (cancel_mono P.inclusion.hom.hom).mp
    rw [MonObj.pow_comp, MonObj.one_comp]
    exact (congrArg (fun f : E.group ⟶ G.val ↦ f.hom.hom ^ n) hcomp).trans hpower
  obtain ⟨s, _, hsr⟩ := descendPowerHom r hker n hp
  obtain ⟨I, t, j, hj, _, _⟩ := schemeImageFactorization B A s
  have hT : IsTorus I.val := torus_of_flat_surjective B I t hS hj.2.1 hj.2.2.1
  let f := j ≫ r
  have htf : t ≫ f = powerHom S.group n := by
    rw [← Category.assoc, hj.1, hsr]
  have hw : t.hom.hom.left ≫ f.hom.hom.left = (powerHom S.group n).hom.hom.left :=
    congrArg (fun g : S.group ⟶ S.group ↦ g.hom.hom.left) htf
  have : Surjective (t.hom.hom.left ≫ f.hom.hom.left) := by
    rw [hw]
    exact (torus_power_flat_surjective B hS n hn).2
  have hf : Surjective f.hom.hom.left := Surjective.of_comp t.hom.hom.left _
  have : IsReduced B.val.X.left := isReduced_of_smooth_over_field B.val.X.hom
  have hfc : Flat f.hom.hom.left := flat_of_surjective_to_reduced I B f
  have hji := hj.2.2.2.2.2
  let T : ClosedSubgroup G.val := ⟨I.val, j ≫ P.inclusion,
    IsClosedImmersion.comp _ _⟩
  exact ⟨T, f, hT, by simp only [T, f, Category.assoc, hr.w], hfc, hf⟩

open Specs.CentralFrobeniusDescent (DescendsTorusFrobeniusKernel LiftsTori)
open private baseChangeKernelSquare from LinearAlgebraicGroups.Affine.Components
open private baseChangeProjection_naturality baseChange_conjugation
  from LinearAlgebraicGroups.Affine.ClosedSubgroups

private theorem baseChange_hom_injective (K : Type u) [Field K] [Algebra k K]
    {X Y : SchemeOver k} :
    Function.Injective (fun g : X ⟶ Y ↦ (baseChange k K).map g) := by
  intro a b h
  change (baseChange k K).map a = (baseChange k K).map b at h
  apply Over.OverMorphism.ext
  let g := fieldSpecMap k K
  let π := pullback.fst X.hom g
  have : Epi π := Flat.epi_of_flat_of_surjective π
  apply (cancel_epi π).mp
  rw [← baseChangeProjection_naturality K a, ← baseChangeProjection_naturality K b, h]

private theorem central_iff_conjugation {G E : GroupScheme k} (i : E ⟶ G) :
    IsCentral i ↔ subgroupConjugation i = snd G.X E.X ≫ i.hom.hom := by
  constructor
  · intro h
    have hc := commute_of_isCentral h (fst G.X E.X) (snd G.X E.X)
    change fst G.X E.X * (snd G.X E.X ≫ i.hom.hom) * (fst G.X E.X)⁻¹ =
      snd G.X E.X ≫ i.hom.hom
    rw [hc.eq, mul_assoc, mul_inv_cancel, mul_one]
  · intro h Y g
    let a := lift (snd E.X Y ≫ g) (fst E.X Y)
    have ht := congrArg (fun z : G.X ⊗ E.X ⟶ G.X ↦ a ≫ z) h
    simpa only [a, subgroupConjugation, Centralizes, conjugateFamily, MonObj.comp_mul,
      GrpObj.comp_inv, ← Category.assoc, lift_fst, lift_snd] using ht

private theorem baseChange_central (K : Type u) [Field K] [Algebra k K]
    {G E : GroupScheme k} {i : E ⟶ G} (h : IsCentral i) :
    IsCentral ((groupBaseChange k K).map i) := by
  let F := baseChange k K
  let e := prodComparisonIso F G.X E.X
  apply (central_iff_conjugation _).mpr
  rw [← baseChange_conjugation K i, (central_iff_conjugation i).mp h, F.map_comp,
    ← Category.assoc]
  have hs : e.inv ≫ F.map (snd G.X E.X) = snd (F.obj G.X) (F.obj E.X) := by
    rw [← CartesianMonoidalCategory.prodComparison_snd, ← prodComparisonIso_hom,
      Iso.inv_hom_id_assoc]
  exact congrArg (· ≫ F.map i.hom.hom) hs

/-- Once the geometric first Frobenius kernel of the torus has descended, the
inclusion of the descended subgroup is killed by the pointwise (p)-power. -/
theorem descendedKernel_annihilated (p : ℕ) [Fact p.Prime] [CharP k p]
    {G : AffineAlgebraicGroup k} {T : ClosedSubgroup (GeometricGroup G).val}
    (hT : IsTorus T.group) (E : ClosedSubgroup G.val)
    (hE : DescendsTorusFrobeniusKernel p T E) : E.inclusion.hom.hom ^ p = 1 := by
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  letI : IsCommMonObj T.group.X := torus_commutative (closedSubgroupAlgebraicGroup T) hT
  obtain ⟨N, e, hN, hinc⟩ := hE
  have hsplit : IsSplitTorus T.group := torus_split_of_algClosed (closedSubgroupAlgebraicGroup T) hT
  have hk := (firstFrobeniusKernel_iff_powerKernel_of_split p hsplit N).mp hN
  have hpN : N.inclusion.hom.hom ^ p = 1 :=
    (powerHom_onSections _ _ _).symm.trans hk.w
  let F := baseChange k K
  let φ := E.inclusion.hom.hom
  letI : MonObj ((baseChange k K).obj G.val.X) :=
    inferInstanceAs (MonObj ((groupBaseChange k K).obj G.val).X)
  have hφ : F.map φ = e.hom.hom.hom ≫ N.inclusion.hom.hom ≫ T.inclusion.hom.hom :=
    (congrArg (fun j ↦ j.hom.hom) hinc).symm
  apply baseChange_hom_injective K
  change F.map (φ ^ p) = F.map (1 : E.group.X ⟶ G.val.X)
  have hm := (Functor.homMonoidHom F).map_pow φ p
  change F.map (φ ^ p) = (F.map φ) ^ p at hm
  rw [hm, F.map_one, hφ, ← Category.assoc, ← MonObj.pow_comp, ← MonObj.comp_pow,
    hpN, MonObj.comp_one, MonObj.one_comp]

/-- Tori of the finite central quotient lift over every field of definition,
provided the kernel is the descended first kernel of the geometric torus. -/
theorem liftsTori_of_descendedKernel (p : ℕ) [Fact p.Prime] [CharP k p]
    {G Q : AffineAlgebraicGroup k} {T : ClosedSubgroup (GeometricGroup G).val}
    (hT : IsTorus T.group) (q : G.val ⟶ Q.val)
    {E : ClosedSubgroup G.val} (hE : DescendsTorusFrobeniusKernel p T E)
    (hw : IsFppfGroupQuotient E q) (hc : IsCentral E.inclusion) : LiftsTori q := by
  intro K _ _
  dsimp only
  intro S hS
  let F := groupBaseChange k K
  let FK := baseChange k K
  let f := F.map q
  let j := F.map E.inclusion
  have hi : IsClosedImmersion j.hom.hom.left :=
    MorphismProperty.of_isPullback (groupBaseChange_isPullback K E.inclusion).flip E.isClosedImmersion
  let N : ClosedSubgroup (F.obj G.val) := ⟨F.obj E.group, j, hi⟩
  have hN : IsSchemeKernel f N := baseChangeKernelSquare q E.inclusion hw.1
  have hu : UniversallyInjective E.group.X.hom := (descendedTorusKernel_finite_radicial p E hE).2
  haveI : UniversallyInjective N.group.X.hom :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback E.group.X.hom (fieldSpecMap k K)) hu
  have hf := groupBaseChange_isPullback K q
  haveI : Flat f.hom.hom.left := MorphismProperty.of_isPullback hf.flip hw.2.1
  haveI : Surjective f.hom.hom.left := MorphismProperty.of_isPullback hf.flip hw.2.2.1
  letI : MonObj ((baseChange k K).obj G.val.X) :=
    inferInstanceAs (MonObj ((groupBaseChange k K).obj G.val).X)
  have hp : N.inclusion.hom.hom ^ p = 1 := by
    have hp0 := descendedKernel_annihilated p hT E hE
    have hm := (Functor.homMonoidHom FK).map_pow E.inclusion.hom.hom p
    change FK.map (E.inclusion.hom.hom ^ p) = (FK.map E.inclusion.hom.hom) ^ p at hm
    rw [hp0, FK.map_one] at hm
    exact hm.symm
  exact liftTorusOfCentralRadicialKernel (G := baseChangedAlgebraicGroup K G)
    (Q := baseChangedAlgebraicGroup K Q) f hN (baseChange_central K hc)
    p (Fact.out : p.Prime).ne_zero hp S hS

open Specs.GeometricRadicals (IsMaximalTorus)
open Specs.SchemeDerivedGroup (IsSubgroupOf)

/-- For reduced closed subgroups, inclusion of the underlying closed sets
implies inclusion as group schemes. -/
private theorem subgroupOf_of_range_subset {G : GroupScheme k} (S T : ClosedSubgroup G)
    [IsReduced S.group.X.left]
    (h : Set.range S.inclusion.hom.hom.left ⊆ Set.range T.inclusion.hom.hom.left) :
    IsSubgroupOf S T := by
  let s := S.inclusion.hom.hom.left
  let t := T.inclusion.hom.hom.left
  have hs : IsClosedImmersion s := S.isClosedImmersion
  have ht : IsClosedImmersion t := T.isClosedImmersion
  have hsupport : s.ker.support ≤ t.ker.support := by
    change (s.ker.support : Set G.X.left) ⊆ (t.ker.support : Set G.X.left)
    rw [Scheme.Hom.support_ker, Scheme.Hom.support_ker]
    exact closure_mono h
  have hrad : s.ker.radical = s.ker := by
    ext U : 2
    rw [Scheme.IdealSheafData.radical_ideal, Scheme.Hom.ker_apply]
    apply Ideal.radical_eq_iff.mpr
    intro x hx
    obtain ⟨n, hn⟩ := hx
    change (s.app U.1).hom x = 0
    have he : (s.app U.1).hom (x ^ n) = 0 := hn
    rw [map_pow] at he
    exact IsReduced.eq_zero _ ⟨n, he⟩
  have htker := Scheme.IdealSheafData.vanishingIdeal_antimono hsupport
  rw [Scheme.IdealSheafData.vanishingIdeal_support,
    Scheme.IdealSheafData.vanishingIdeal_support, hrad] at htker
  let r := IsClosedImmersion.lift t s (t.ker.le_radical.trans htker)
  have harr : r ≫ t = s := IsClosedImmersion.lift_fac _ _ _
  let r₀ : S.group.X ⟶ T.group.X := Over.homMk r (by
    rw [← T.inclusion.hom.hom.w, ← Category.assoc, harr, S.inclusion.hom.hom.w])
  have hr₀ : r₀ ≫ T.inclusion.hom.hom = S.inclusion.hom.hom :=
    Over.OverMorphism.ext harr
  letI : IsMonHom r₀ := isMonHom_of_comp_closed r₀ S.inclusion T.inclusion hr₀
  exact ⟨Grp.homMk r₀, Grp.hom_ext _ _ hr₀⟩

/-- Under a radicial homomorphism along which tori lift, a faithfully flat
torus image of a maximal torus is maximal. -/
theorem maximalTorus_of_radicial_image {G Q : AffineAlgebraicGroup k}
    (q : G.val ⟶ Q.val) [UniversallyInjective q.hom.hom.left]
    (hlift : ∀ S₁ : ClosedSubgroup Q.val, IsTorus S₁.group →
      ∃ (S : ClosedSubgroup G.val) (a : S.group ⟶ S₁.group),
        IsTorus S.group ∧ S.inclusion ≫ q = a ≫ S₁.inclusion ∧
        Surjective a.hom.hom.left)
    {T : ClosedSubgroup G.val} {T₁ : ClosedSubgroup Q.val} (f : T.group ⟶ T₁.group)
    (hT : IsMaximalTorus T) (hT₁ : IsTorus T₁.group)
    (hf : T.inclusion ≫ q = f ≫ T₁.inclusion) : IsMaximalTorus T₁ := by
  refine ⟨hT₁, ?_⟩
  intro S₁ hS₁ h
  obtain ⟨j, hj⟩ := h
  obtain ⟨S, a, hS, ha, hsurj⟩ := hlift S₁ hS₁
  let x := T.inclusion.hom.hom.left
  let x₁ := T₁.inclusion.hom.hom.left
  let y := S.inclusion.hom.hom.left
  let y₁ := S₁.inclusion.hom.hom.left
  let q₀ := q.hom.hom.left
  let f₀ := f.hom.hom.left
  let a₀ := a.hom.hom.left
  let j₀ := j.hom.hom.left
  have h₁ : x ≫ q₀ = f₀ ≫ x₁ := congrArg (fun b : T.group ⟶ Q.val ↦ b.hom.hom.left) hf
  have h₂ : y ≫ q₀ = a₀ ≫ y₁ := congrArg (fun b : S.group ⟶ Q.val ↦ b.hom.hom.left) ha
  have h₃ : j₀ ≫ y₁ = x₁ := congrArg (fun b : T₁.group ⟶ Q.val ↦ b.hom.hom.left) hj
  have hr : Set.range x ⊆ Set.range y := by
    rintro _ ⟨t, rfl⟩
    obtain ⟨s, hs⟩ := hsurj.1 (j₀ (f₀ t))
    refine ⟨s, q₀.injective ?_⟩
    change (y ≫ q₀) s = (x ≫ q₀) t
    rw [h₁, h₂, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hs]
    exact congrArg (fun b : T₁.group.X.left ⟶ Q.val.X.left ↦ b (f₀ t)) h₃
  have : IsReduced T.group.X.left := by
    haveI : Smooth T.group.X.hom := torus_smooth (closedSubgroupAlgebraicGroup T) hT.1
    exact isReduced_of_smooth_over_field T.group.X.hom
  obtain ⟨b, hb⟩ := hT.2 S hS (subgroupOf_of_range_subset T S hr)
  let b₀ := b.hom.hom.left
  have h₄ : b₀ ≫ x = y := congrArg (fun m : S.group ⟶ G.val ↦ m.hom.hom.left) hb
  have hr₁ : Set.range y₁ ⊆ Set.range x₁ := by
    rintro _ ⟨s₁, rfl⟩
    obtain ⟨s, hs⟩ := hsurj.1 s₁
    refine ⟨f₀ (b₀ s), ?_⟩
    calc
      x₁ (f₀ (b₀ s)) = (x ≫ q₀) (b₀ s) := congrArg
        (fun m : T.group.X.left ⟶ Q.val.X.left ↦ m (b₀ s)) h₁.symm
      _ = (y ≫ q₀) s := congrArg (fun m : S.group.X.left ⟶ Q.val.X.left ↦ m s)
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ q₀) h₄))
      _ = y₁ (a₀ s) := congrArg (fun m : S.group.X.left ⟶ Q.val.X.left ↦ m s) h₂
      _ = y₁ s₁ := congrArg y₁ hs
  have : IsReduced S₁.group.X.left := by
    haveI : Smooth S₁.group.X.hom := torus_smooth (closedSubgroupAlgebraicGroup S₁) hS₁
    exact isReduced_of_smooth_over_field S₁.group.X.hom
  exact subgroupOf_of_range_subset S₁ T₁ hr₁

private theorem schemeKernel_of_factored_kernel {G Q : GroupScheme k}
    {q : G ⟶ Q} {E : ClosedSubgroup G}
    (hE : IsSchemeKernel q E) {S : ClosedSubgroup G}
    {S₁ : ClosedSubgroup Q} {f : S.group ⟶ S₁.group}
    (hf : S.inclusion ≫ q = f ≫ S₁.inclusion)
    (N : ClosedSubgroup S.group) (e : E.group ≅ N.group)
    (he : e.hom ≫ N.inclusion ≫ S.inclusion = E.inclusion) :
    IsSchemeKernel f N := by
  let H := Grp.forget (SchemeOver k)
  let i := S.inclusion.hom.hom
  let j := S₁.inclusion.hom.hom
  let n := N.inclusion.hom.hom
  have : IsClosedImmersion i.left := S.isClosedImmersion
  have : IsClosedImmersion j.left := S₁.isClosedImmersion
  have : Mono i := Over.mono_of_mono_left _
  have : Mono j := Over.mono_of_mono_left _
  have : IsClosedImmersion n.left := N.isClosedImmersion
  have : Mono n := Over.mono_of_mono_left _
  have h₁ : i ≫ q.hom.hom = f.hom.hom ≫ j := congrArg H.map hf
  have h₂ : e.hom.hom.hom ≫ n ≫ i = E.inclusion.hom.hom := congrArg H.map he
  have hkill : n ≫ f.hom.hom = toUnit _ ≫ η[S₁.group.X] := by
    apply (cancel_epi e.hom.hom.hom).mp
    apply (cancel_mono j).mp
    simp only [Category.assoc, IsMonHom.one_hom, comp_toUnit_assoc]
    rw [← h₁]
    calc
      _ = (e.hom.hom.hom ≫ n ≫ i) ≫ q.hom.hom := by simp only [Category.assoc]
      _ = _ := by rw [h₂]; exact hE.w
  refine IsPullback.mk' hkill ?_ ?_
  · intro Y a b ha _
    exact (cancel_mono n).mp ha
  intro Y a b hab
  have hb : b = toUnit Y := toUnit_unique _ _
  have hz : (a ≫ i) ≫ q.hom.hom = toUnit Y ≫ η[Q.X] := by
    rw [Category.assoc, h₁, ← Category.assoc, hab, hb, Category.assoc, IsMonHom.one_hom]
  let u := hE.lift (a ≫ i) (toUnit Y) hz
  have hu : u ≫ e.hom.hom.hom ≫ n = a := by
    apply (cancel_mono i).mp
    simp only [Category.assoc, h₂]
    exact hE.lift_fst _ _ _
  exact ⟨u ≫ e.hom.hom.hom, (Category.assoc _ _ _).trans hu, toUnit_unique _ _⟩

/-- The geometric image of the given torus is maximal, with character lattice
equal by pullback to the p-multiples in the original character lattice. -/
theorem geometricTorusImage_of_descendedKernel
    (p : ℕ) [Fact p.Prime] [CharP k p] {G Q : AffineAlgebraicGroup k}
    (q : G.val ⟶ Q.val) {T : ClosedSubgroup (GeometricGroup G).val}
    (hT : IsMaximalTorus T) {E : ClosedSubgroup G.val}
    (hE : DescendsTorusFrobeniusKernel p T E) (hC : IsCentral E.inclusion)
    (hq : IsFppfGroupQuotient E q) :
    ∃ (T₁ : ClosedSubgroup (GeometricGroup Q).val) (f : T.group ⟶ T₁.group),
      IsMaximalTorus T₁ ∧
      T.inclusion ≫ (groupBaseChange k (AlgebraicClosure k)).map q = f ≫ T₁.inclusion ∧
      Flat f.hom.hom.left ∧ Surjective f.hom.hom.left ∧
      Function.Injective (fun χ : Character T₁.group ↦ f ≫ χ) ∧
      (∀ χ : Character T.group, (∃ ψ : Character T₁.group, f ≫ ψ = χ) ↔ IsCharacterPower p χ) ∧
      ∀ (χ : Character T₁.group) (n : ℕ),
        IsCharacterPower (p ^ (n + 1)) (f ≫ χ) ↔ IsCharacterPower (p ^ n) χ := by
  let K := AlgebraicClosure k
  let F := groupBaseChange k K
  let B := GeometricGroup Q
  let A := closedSubgroupAlgebraicGroup T
  let r := F.map q
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  have hl := liftsTori_of_descendedKernel p hT.1 q hE hq hC
  obtain ⟨I, f, i, h, _, _⟩ := schemeImageFactorization A B (T.inclusion ≫ r)
  let T₁ : ClosedSubgroup B.val := ⟨I.val, i, h.2.2.2.2.2⟩
  have ht : IsTorus T₁.group := torus_of_flat_surjective A I f hT.1 h.2.1 h.2.2.1
  have hu : UniversallyInjective E.group.X.hom := (descendedTorusKernel_finite_radicial p E hE).2
  have hv : UniversallyInjective q.hom.hom.left := universallyInjective_of_radicialKernel hq.1 hu
  haveI : UniversallyInjective r.hom.hom.left :=
    MorphismProperty.of_isPullback (groupBaseChange_isPullback K q).flip hv
  have hmax : IsMaximalTorus T₁ :=
    maximalTorus_of_radicial_image (G := GeometricGroup G) (Q := B) r (by
      intro S hS
      obtain ⟨T', a, hT', ha, _, hs⟩ := hl K S hS
      exact ⟨T', a, hT', ha, hs⟩) f hT ht h.1.symm
  have hci : IsClosedImmersion (F.map E.inclusion).hom.hom.left :=
    MorphismProperty.of_isPullback (groupBaseChange_isPullback K E.inclusion).flip E.isClosedImmersion
  let E' : ClosedSubgroup (GeometricGroup G).val := ⟨F.obj E.group, F.map E.inclusion, hci⟩
  have hk : IsSchemeKernel r E' := baseChangeKernelSquare q E.inclusion hq.1
  obtain ⟨N, e, hN, hinc⟩ := hE
  have hsplit : IsSplitTorus T.group := torus_split_of_algClosed A hT.1
  haveI : IsCommMonObj A.val.X := torus_commutative A hT.1
  haveI : IsCommMonObj T.group.X := inferInstanceAs (IsCommMonObj A.val.X)
  have hf : IsSchemeKernel f N :=
    schemeKernel_of_factored_kernel (E := E') (S := T) (S₁ := T₁) (f := f) hk h.1.symm N e hinc
  have hp := (firstFrobeniusKernel_iff_powerKernel_of_split p hsplit N).mp hN
  haveI : IsAffine A.val.X.left := A.property.1
  haveI : IsAffine T.group.X.left := inferInstanceAs (IsAffine A.val.X.left)
  haveI : IsAffine I.val.X.left := I.property.1
  haveI : IsAffine T₁.group.X.left := inferInstanceAs (IsAffine I.val.X.left)
  haveI : Flat f.hom.hom.left := h.2.1
  haveI : Surjective f.hom.hom.left := h.2.2.1
  obtain ⟨hpf, hps⟩ := torus_power_flat_surjective A hT.1 p (Fact.out : p.Prime).ne_zero
  haveI : Flat (powerHom T.group p).hom.hom.left := hpf
  haveI : Surjective (powerHom T.group p).hom.hom.left := hps
  obtain ⟨hinj, him⟩ := characterPullback_of_powerKernel f p hf hp
  exact ⟨T₁, f, hmax, h.1.symm, h.2.1, h.2.2.1, hinj, him,
    characterPower_iff_of_pullback f p hinj him⟩

