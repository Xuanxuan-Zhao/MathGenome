variable {k : Type u} [Field k]

/-- Over an infinite subfield, the span of the values of a polynomial family
on rational inputs already contains its values on all extension-field inputs. -/
theorem span_polynomialValues_eq (K : Type u) [Field K] [Algebra k K] [Infinite k]
    {Index Coord : Type u} [Fintype Coord] (P : Coord → MvPolynomial Index K) :
    Submodule.span K (Set.range fun v : Index → k ↦
      fun j ↦ MvPolynomial.eval (fun i ↦ algebraMap k K (v i)) (P j)) =
    Submodule.span K (Set.range fun v : Index → K ↦ fun j ↦ MvPolynomial.eval v (P j)) := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    exact Submodule.subset_span ⟨fun i ↦ algebraMap k K (v i), rfl⟩
  apply Submodule.span_le.mpr
  rintro _ ⟨v, rfl⟩
  by_contra hv
  obtain ⟨f, hfv, hf⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hv inferInstance
  let b := Pi.basisFun K Coord
  let Q : MvPolynomial Index K := ∑ j, MvPolynomial.C (f (b j)) * P j
  have heval (w : Index → K) : MvPolynomial.eval w Q = f (fun j ↦ MvPolynomial.eval w (P j)) := by
    have hrepr : (∑ j, MvPolynomial.eval w (P j) • b j) =
        (fun j ↦ MvPolynomial.eval w (P j)) := by
      simpa [b] using b.sum_repr (fun j ↦ MvPolynomial.eval w (P j))
    rw [← hrepr, map_sum]
    simp only [map_sum, map_mul, MvPolynomial.eval_C, map_smul, smul_eq_mul]
    exact Finset.sum_congr rfl fun _ _ ↦ mul_comm _ _
  have hzero : Q = 0 := by
    apply MvPolynomial.funext_set (fun _ ↦ Set.range (algebraMap k K))
      (fun _ ↦ Set.infinite_range_of_injective (algebraMap k K).injective)
    intro w hw
    have hw' : ∀ i, ∃ a : k, algebraMap k K a = w i :=
      fun i ↦ hw i (Set.mem_univ i)
    choose a ha using hw'
    have hm : (fun j ↦ MvPolynomial.eval w (P j)) ∈
        Submodule.span K (Set.range fun v : Index → k ↦
          fun j ↦ MvPolynomial.eval (fun i ↦ algebraMap k K (v i)) (P j)) := by
      exact Submodule.subset_span ⟨a, by simp only [ha]⟩
    have hz := Submodule.mem_map_of_mem hm (f := f)
    rw [hf, Submodule.mem_bot] at hz
    simpa only [heval, map_zero] using hz
  exact hfv (by rw [← heval, hzero, map_zero])

/-- The geometric span of the powers of a matrix family defined over an infinite
field is generated by the powers of its rational specializations. -/
theorem span_matrixPowerValues_eq (K : Type u) [Field K] [Algebra k K] [Infinite k]
    {Parameter Index : Type u} [Fintype Index] [DecidableEq Index]
    (M : Matrix Index Index (MvPolynomial Parameter k)) (d : ℕ) :
    Submodule.span K (Set.range fun v : Parameter → k ↦
      ((M.map (MvPolynomial.eval v)) ^ d).map (algebraMap k K)) =
    Submodule.span K (Set.range fun v : Parameter → K ↦
      (M.map (MvPolynomial.aeval v : MvPolynomial Parameter k →ₐ[k] K)) ^ d) := by
  let e : Matrix Index Index K ≃ₗ[K] ((Index × Index) → K) :=
    { toFun := fun A ij ↦ A ij.1 ij.2
      invFun := fun v ↦ Matrix.of (fun i j ↦ v (i, j))
      left_inv := fun _ ↦ rfl
      right_inv := fun _ ↦ rfl
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  apply Submodule.map_injective_of_injective e.injective
  rw [Submodule.map_span, Submodule.map_span, ← Set.range_comp, ← Set.range_comp]
  let P : Index × Index → MvPolynomial Parameter K :=
    fun ij ↦ MvPolynomial.map (algebraMap k K) ((M ^ d) ij.1 ij.2)
  have hK (v : Parameter → K) (ij : Index × Index) :
      e ((M.map (MvPolynomial.aeval v : MvPolynomial Parameter k →ₐ[k] K)) ^ d) ij =
        MvPolynomial.eval v (P ij) := by
    let a : MvPolynomial Parameter k →+* K := (MvPolynomial.aeval v).toRingHom
    change e ((M.map a) ^ d) ij = _
    rw [← Matrix.map_pow M a]
    exact (MvPolynomial.eval_map _ _ _).symm
  have hk (v : Parameter → k) (ij : Index × Index) :
      e (((M.map (MvPolynomial.eval v)) ^ d).map (algebraMap k K)) ij =
        MvPolynomial.eval (fun i ↦ algebraMap k K (v i)) (P ij) := by
    rw [← Matrix.map_pow M (MvPolynomial.eval v)]
    change algebraMap k K (MvPolynomial.eval v ((M ^ d) ij.1 ij.2)) =
      MvPolynomial.eval (fun i ↦ algebraMap k K (v i)) (P ij)
    change _ = MvPolynomial.eval (fun i ↦ algebraMap k K (v i))
      (MvPolynomial.map (algebraMap k K) ((M ^ d) ij.1 ij.2))
    rw [MvPolynomial.eval_map]
    exact MvPolynomial.map_eval₂Hom (RingHom.id k) v (algebraMap k K) _
  change (Submodule.span K (Set.range fun v : Parameter → k ↦
    e (((M.map (MvPolynomial.eval v)) ^ d).map (algebraMap k K)))) = _
  rw [show (fun v : Parameter → k ↦ e (((M.map (MvPolynomial.eval v)) ^ d).map
      (algebraMap k K))) = _ from funext fun v ↦ funext (hk v)]
  change _ = (Submodule.span K (Set.range fun v : Parameter → K ↦
    e ((M.map (MvPolynomial.aeval v : MvPolynomial Parameter k →ₐ[k] K)) ^ d)))
  rw [show (fun v : Parameter → K ↦
      e ((M.map (MvPolynomial.aeval v : MvPolynomial Parameter k →ₐ[k] K)) ^ d)) = _
    from funext fun v ↦ funext (hK v)]
  exact span_polynomialValues_eq K P

/-- Point-separating functions generate the full algebra of functions on a
finite set. This supplies the scalar algebra of separated eigenblocks. -/
theorem subalgebra_eq_top_of_separates {Index : Type u} [Fintype Index]
    (S : Subalgebra k (Index → k))
    (h : ∀ i j : Index, i ≠ j → ∃ f ∈ S, f i ≠ f j) : S = ⊤ := by
  classical
  have hsingle (i : Index) : Pi.single i 1 ∈ S := by
    have hchoose (j : Index) : ∃ f ∈ S, f i = 1 ∧ (i ≠ j → f j = 0) := by
      by_cases hij : i = j
      · exact ⟨1, S.one_mem, rfl, fun hn ↦ (hn hij).elim⟩
      obtain ⟨f, hf, hneq⟩ := h i j hij
      refine ⟨(f i - f j)⁻¹ • (f - algebraMap k (Index → k) (f j)),
        S.smul_mem (S.sub_mem hf (S.algebraMap_mem _)) _, ?_, ?_⟩
      · change (f i - f j)⁻¹ * (f i - f j) = 1
        exact inv_mul_cancel₀ (sub_ne_zero.mpr hneq)
      · intro _
        change (f i - f j)⁻¹ * (f j - f j) = 0
        rw [sub_self, mul_zero]
    choose f hf hi hj using hchoose
    have hprod : (∏ j, f j) = Pi.single i 1 := by
      ext j
      rw [Finset.prod_apply]
      by_cases hij : i = j
      · subst j
        simp [hi]
      · rw [Pi.single_eq_of_ne (Ne.symm hij)]
        exact Finset.prod_eq_zero (Finset.mem_univ j) (hj j hij)
    rw [← hprod]
    exact S.prod_mem fun j _ ↦ hf j
  apply top_unique
  intro f _
  have hf : (∑ i, f i • Pi.single i (1 : k)) = f := by
    simpa using (Pi.basisFun k Index).sum_repr f
  rw [← hf]
  exact S.sum_mem fun i _ ↦ S.smul_mem (hsingle i) _

open Specs.CharacterDescent (Character)
open Specs.CentralFrobeniusDescent (IsCharacterPower)

private theorem pullback_character_pow {S T : GroupScheme k} (f : S ⟶ T)
    (χ : Character T) (n : ℕ) : f ≫ χ ^ n = (f ≫ χ) ^ n := by
  apply Grp.hom_ext
  change f.hom.hom ≫ (χ ^ n).hom.hom = ((f ≫ χ) ^ n).hom.hom
  simp only [Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  exact MonObj.comp_pow χ.hom.hom n f.hom.hom

/-- An injective pullback onto the p-th powers in a character lattice
decreases the exponent of p-divisibility by one. -/
theorem characterPower_iff_of_pullback {S T : GroupScheme k} (f : S ⟶ T) (p : ℕ)
    (hinj : Function.Injective (fun χ : Character T ↦ f ≫ χ))
    (himage : ∀ χ : Character S, (∃ ψ : Character T, f ≫ ψ = χ) ↔ IsCharacterPower p χ)
    (χ : Character T) (n : ℕ) :
    IsCharacterPower (p ^ (n + 1)) (f ≫ χ) ↔ IsCharacterPower (p ^ n) χ := by
  constructor
  · rintro ⟨ψ, hψ⟩
    obtain ⟨φ, hφ⟩ := (himage (ψ ^ p)).mpr ⟨ψ, rfl⟩
    refine ⟨φ, hinj ?_⟩
    change f ≫ φ ^ (p ^ n) = f ≫ χ
    rw [pullback_character_pow, hφ, ← pow_mul, Nat.mul_comm, ← pow_succ]
    exact hψ
  · rintro ⟨ψ, rfl⟩
    obtain ⟨φ, hφ⟩ := (himage (f ≫ ψ)).mp ⟨ψ, rfl⟩
    refine ⟨φ, ?_⟩
    rw [pullback_character_pow, ← hφ, ← pow_mul, Nat.mul_comm, ← pow_succ]

/-- The relative Frobenius of a finite-type affine group over a field is finite.
The pullback contains the p-th power of every coordinate. -/
theorem relativeFrobenius_finite (p : ℕ) [Fact p.Prime] [CharP k p]
    (A : HopfAlgebraCategory k) [Algebra.FiniteType k A]
    (f : Specs.RelativeFrobenius.twistCoordinates k p A ⟶ A)
    (hf : Specs.RelativeFrobenius.PullbackFormula k p A f) :
    IsFinite (specGroupMap f).hom.hom.left := by
  let B := Specs.RelativeFrobenius.twistCoordinates k p A
  let a : B →ₐ[k] A := f.hom.toAlgHom
  let : Algebra B A := a.toRingHom.toAlgebra
  have : IsScalarTower k B A :=
    IsScalarTower.of_algebraMap_eq fun r ↦ (a.commutes r).symm
  change IsFinite (Spec.map (CommRingCat.ofHom a.toRingHom))
  rw [IsFinite.SpecMap_iff, RingHom.finite_iff_isIntegral_and_finiteType]
  refine ⟨?_, ?_⟩
  · intro x
    apply IsIntegral.of_pow (Fact.out : p.Prime).pos
    let y : B := Specs.RelativeFrobenius.scalarTensor (frobenius k p) A 1 x
    have hxy : algebraMap B A y = x ^ p := by
      change f.hom y = x ^ p
      simpa only [one_smul] using hf 1 x
    rw [← hxy]
    exact isIntegral_algebraMap
  · exact Algebra.FiniteType.of_restrictScalars_finiteType k B A

/-- Relative Frobenius is radicial, even over an imperfect ground field. -/
theorem relativeFrobenius_universallyInjective (p : ℕ) [Fact p.Prime] [CharP k p]
    (A : HopfAlgebraCategory k)
    (f : Specs.RelativeFrobenius.twistCoordinates k p A ⟶ A)
    (hf : Specs.RelativeFrobenius.PullbackFormula k p A f) :
    UniversallyInjective (specGroupMap f).hom.hom.left := by
  let B := Specs.RelativeFrobenius.twistCoordinates k p A
  let a : CommRingCat.of B ⟶ CommRingCat.of A := CommRingCat.ofHom f.hom.toAlgHom.toRingHom
  change UniversallyInjective (Spec.map a)
  apply ((tfae_universallyInjective (Spec.map a)).out 1 2).mpr
  intro K _ g h eq
  obtain ⟨g, rfl⟩ := Spec.map_surjective g
  obtain ⟨h, rfl⟩ := Spec.map_surjective h
  have heq : a ≫ g = a ≫ h := by
    apply Spec.map_injective
    simpa only [Spec.map_comp] using eq
  have : CharP K p := CharP.of_ringHom_of_ne_zero
    (g.hom.comp (algebraMap k A)) p (Fact.out : p.Prime).ne_zero
  congr 1
  ext x
  let y : B := Specs.RelativeFrobenius.scalarTensor (frobenius k p) A 1 x
  have hy : a.hom y = x ^ p := by
    change f.hom y = x ^ p
    simpa only [one_smul] using hf 1 x
  have hpoint := ConcreteCategory.congr_hom heq y
  change g.hom (a.hom y) = h.hom (a.hom y) at hpoint
  rw [hy, map_pow, map_pow] at hpoint
  exact frobenius_inj K p hpoint

open Specs.CentralFrobeniusDescent (IsFirstFrobeniusKernel)

set_option backward.isDefEq.respectTransparency false in
/-- The first Frobenius kernel of a finite-type group is finite over the base. -/
theorem firstFrobeniusKernel_finite (p : ℕ) [Fact p.Prime] [CharP k p]
    (S : AffineAlgebraicGroup k) (N : ClosedSubgroup S.val)
    (hN : IsFirstFrobeniusKernel p N) : IsFinite N.group.X.hom := by
  obtain ⟨A, e, f, hf, hker⟩ := hN
  let e₀ := ((Grp.forget (SchemeOver k)) ⋙ Over.forget _).mapIso e
  have : LocallyOfFiniteType S.val.X.hom := S.property.2.1
  have hA : LocallyOfFiniteType (specGroup A).X.hom := by
    have he : e₀.inv ≫ S.val.X.hom = (specGroup A).X.hom := e.inv.hom.hom.w
    rw [← he]
    have : IsIso e₀.inv := e₀.isIso_inv
    have : IsOpenImmersion e₀.inv := inferInstance
    exact locallyOfFiniteType_comp e₀.inv S.val.X.hom
  have : Algebra.FiniteType k A := by
    change LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k A))) at hA
    exact RingHom.finiteType_algebraMap.mp (HasRingHomProperty.Spec_iff.mp hA)
  have hfin : IsFinite (specGroupMap f).hom.hom.left := relativeFrobenius_finite p A f hf
  have : IsFinite (e.hom ≫ specGroupMap f).hom.hom.left := by
    change IsFinite (e₀.hom ≫ (specGroupMap f).hom.hom.left)
    have : IsIso e₀.hom := e₀.isIso_hom
    have : IsFinite e₀.hom := inferInstance
    exact MorphismProperty.comp_mem (@IsFinite.{u}) e₀.hom _ this hfin
  have hp := hker.map (Over.forget (Spec (CommRingCat.of k)))
  exact MorphismProperty.of_isPullback hp
    (show IsFinite (e.hom ≫ specGroupMap f).hom.hom.left from inferInstance)


set_option backward.isDefEq.respectTransparency false in
/-- A first Frobenius kernel is radicial over the base field. -/
theorem firstFrobeniusKernel_universallyInjective (p : ℕ) [Fact p.Prime] [CharP k p]
    {S : GroupScheme k} (N : ClosedSubgroup S)
    (hN : IsFirstFrobeniusKernel p N) : UniversallyInjective N.group.X.hom := by
  obtain ⟨A, e, f, hf, hker⟩ := hN
  let e₀ := ((Grp.forget (SchemeOver k)) ⋙ Over.forget _).mapIso e
  have hU : UniversallyInjective (specGroupMap f).hom.hom.left :=
    relativeFrobenius_universallyInjective p A f hf
  have hU' : UniversallyInjective (e.hom ≫ specGroupMap f).hom.hom.left := by
    change UniversallyInjective (e₀.hom ≫ (specGroupMap f).hom.hom.left)
    have : IsIso e₀.hom := e₀.isIso_hom
    exact MorphismProperty.comp_mem (@UniversallyInjective.{u}) e₀.hom _ inferInstance hU
  exact MorphismProperty.of_isPullback (hker.map (Over.forget (Spec (CommRingCat.of k)))) hU'

open Specs.CentralFrobeniusDescent (DescendsTorusFrobeniusKernel)
open Specs.GeometricRadicals (GeometricGroup)
open Specs.Unipotent (closedSubgroupAlgebraicGroup)

set_option backward.isDefEq.respectTransparency false in
/-- Once the first kernel has descended, its structural map over the ground
field is finite and radicial. -/
theorem descendedTorusKernel_finite_radicial (p : ℕ) [Fact p.Prime] [CharP k p]
    {G : AffineAlgebraicGroup k} {T : ClosedSubgroup (GeometricGroup G).val}
    (E : ClosedSubgroup G.val) (hE : DescendsTorusFrobeniusKernel p T E) :
    IsFinite E.group.X.hom ∧ UniversallyInjective E.group.X.hom := by
  let K := AlgebraicClosure k
  let : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  obtain ⟨N, e, hN, _⟩ := hE
  let F := groupBaseChange k K
  let e₀ := ((Grp.forget (SchemeOver K)) ⋙ Over.forget _).mapIso e
  have hstruct : e₀.hom ≫ N.group.X.hom = (F.obj E.group).X.hom := e.hom.hom.hom.w
  have : IsIso e₀.hom := e₀.isIso_hom
  have hNfin : IsFinite N.group.X.hom := firstFrobeniusKernel_finite p
    (closedSubgroupAlgebraicGroup T) N hN
  have hNuni : UniversallyInjective N.group.X.hom :=
    firstFrobeniusKernel_universallyInjective p N hN
  have hBfin : IsFinite (F.obj E.group).X.hom := by
    rw [← hstruct]
    exact MorphismProperty.comp_mem (@IsFinite.{u}) e₀.hom _ inferInstance hNfin
  have hBuni : UniversallyInjective (F.obj E.group).X.hom := by
    rw [← hstruct]
    exact MorphismProperty.comp_mem (@UniversallyInjective.{u}) e₀.hom _ inferInstance hNuni
  have hBclosed : UniversallyClosed (F.obj E.group).X.hom := by
    have := hBfin
    infer_instance
  let g := fieldSpecMap k K
  have hcover : (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}) g := by
    dsimp [g]
    exact ⟨⟨inferInstance, inferInstance⟩, inferInstance⟩
  have hfinType : LocallyOfFiniteType E.group.X.hom :=
    (closedSubgroupAlgebraicGroup E).property.2.1
  have hA : IsAffine E.group.X.left := (closedSubgroupAlgebraicGroup E).property.1
  have hclosed : UniversallyClosed E.group.X.hom :=
    MorphismProperty.of_pullback_snd_of_descendsAlong (P := @UniversallyClosed)
      (g := g) hcover hBclosed
  refine ⟨(IsFinite.iff_isIntegralHom_and_locallyOfFiniteType _).mpr
    ⟨IsIntegralHom.iff_universallyClosed_and_isAffineHom.mpr ⟨hclosed, inferInstance⟩,
      hfinType⟩, ?_⟩
  exact MorphismProperty.of_pullback_snd_of_descendsAlong (P := @UniversallyInjective)
    (g := g) hcover hBuni

