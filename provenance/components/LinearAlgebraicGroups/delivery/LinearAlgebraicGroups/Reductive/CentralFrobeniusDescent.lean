/-- A split subgroup of a finite commutative group with unipotent quotient
descends from the algebraic closure in positive characteristic. -/
theorem descendFiniteMultiplicativeKernel (p : ℕ) [Fact p.Prime] [CharP k p]
    (H : AffineAlgebraicGroup k) (hfin : IsFinite H.val.X.hom) (hcom : IsCommMonObj H.val.X)
    (N : ClosedSubgroup ((groupBaseChange k (AlgebraicClosure k)).obj H.val))
    (hN : ∃ (M : Type u) (_ : CommGroup M),
      Nonempty (N.group ≅ specGroup (groupAlgebra (AlgebraicClosure k) M)))
    (Q : AffineAlgebraicGroup (AlgebraicClosure k))
    (f : (groupBaseChange k (AlgebraicClosure k)).obj H.val ⟶ Q.val)
    (hQ : IsUnipotent Q) (hf : IsSchemeKernel f N) :
    ∃ (E : ClosedSubgroup H.val)
      (e : (groupBaseChange k (AlgebraicClosure k)).obj E.group ≅ N.group),
        e.hom ≫ N.inclusion = (groupBaseChange k (AlgebraicClosure k)).map E.inclusion := by
  classical
  let K := AlgebraicClosure k
  let F := groupBaseChange k K
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  have : IsAffine H.val.X.left := H.property.1
  obtain ⟨A₀, ⟨a⟩⟩ := essImage_hopfSpec.mpr (show IsAffine H.val.X.left from inferInstance)
  let A := A₀.unop
  let V := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso a.hom.hom.hom.left := V.map_isIso a.hom
  haveI : IsCommMonObj (specGroup A).X := by
    exact isCommMonObj_of_groupIso a.symm hcom
  haveI : IsCocomm k A := (hopfSpecCommutativity k A).mp inferInstance
  haveI : IsFinite (specGroup A).X.hom := by
    haveI := hfin
    rw [← Over.w a.hom.hom.hom]
    infer_instance
  haveI : Module.Finite k A := RingHom.finite_algebraMap.mp
    ((IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap k A))).mp
      (inferInstance : IsFinite (specGroup A).X.hom))
  let AK := extendedHopf K A
  let aK : specGroup AK ≅ F.obj H.val := extendedGroupIso K A ≪≫ F.mapIso a
  let VK := Grp.forget (SchemeOver K) ⋙ Over.forget (Spec (CommRingCat.of K))
  obtain ⟨M, _, ⟨eN⟩⟩ := hN
  let B := groupAlgebra K M
  let i := eN.inv ≫ N.inclusion ≫ aK.inv
  let ρ := ((hopfSpec.fullyFaithful (R := CommRingCat.of K)).preimage i).unop
  have hρ : specGroupMap ρ = i :=
    (hopfSpec.fullyFaithful (R := CommRingCat.of K)).map_preimage _
  haveI : IsIso eN.inv.hom.hom.left := VK.map_isIso eN.inv
  haveI : IsIso aK.inv.hom.hom.left := VK.map_isIso aK.inv
  haveI : IsClosedImmersion N.inclusion.hom.hom.left := N.isClosedImmersion
  have hi : IsClosedImmersion (specGroupMap ρ).hom.hom.left := by
    rw [hρ]
    change IsClosedImmersion (eN.inv.hom.hom.left ≫ N.inclusion.hom.hom.left ≫ aK.inv.hom.hom.left)
    infer_instance
  have hsurj : Function.Surjective ρ.hom := (hopfMapClosedImmersion K _).mp hi
  let N' : ClosedSubgroup (specGroup AK) := ⟨specGroup B, specGroupMap ρ, hi⟩
  have hinc : N'.inclusion ≫ aK.hom = eN.inv ≫ N.inclusion := by
    change specGroupMap ρ ≫ aK.hom = _
    rw [hρ]
    simp only [i, Category.assoc, aK.inv_hom_id]
    exact congrArg (fun g : N.group ⟶ F.obj H.val ↦ eN.inv ≫ g)
      (Category.comp_id N.inclusion)
  have hK : IsSchemeKernel (aK.hom ≫ f) N' :=
    transport_schemeKernel N' N eN.symm aK f hf hinc
  haveI : Module.Finite K B := Module.Finite.of_surjective ρ.hom.toLinearMap hsurj
  haveI : Finite M := (MonoidAlgebra.basis M K).linearIndependent.finite
  letI := Fintype.ofFinite M
  have hgl := groupLike_injective_of_unipotent_image AK B ρ hsurj Q hQ _ hK
  haveI : Nontrivial (ConvolutionDual AK) :=
    (evalGroupLike AK 1).toRingHom.domain_nontrivial
  haveI : CharP (ConvolutionDual AK) p :=
    CharP.of_ringHom_of_ne_zero (algebraMap K (ConvolutionDual AK)) p (Fact.out : p.Prime).ne_zero
  obtain ⟨r, hr⟩ := geometricPowerSpan AK M ρ hsurj hgl p
  let I : Ideal A := (RingHom.ker ρ.hom.toAlgHom.toRingHom).comap (includeCoordinates K A)
  have hI : extendedIdeal K I = RingHom.ker ρ.hom.toAlgHom.toRingHom :=
    extendedIdeal_eq_of_dualPowerSpan K A B ρ p r ((extendDual_powerSpan K A p r).trans hr)
  haveI : I.IsHopfIdeal k := hopfIdeal_of_extended_kernel K A B ρ hsurj I hI
  letI := extendedHopfIdeal k K A I
  let J := extendedIdeal K I
  let C := hopfQuotient A I
  let q := hopfQuotientMap A I
  let j := specGroupMap q
  haveI : IsClosedImmersion j.hom.hom.left :=
    (hopfMapClosedImmersion k q).mpr Ideal.Quotient.mk_surjective
  let E : ClosedSubgroup H.val := ⟨specGroup C, j ≫ a.hom, by
    change IsClosedImmersion (j.hom.hom.left ≫ a.hom.hom.hom.left)
    infer_instance⟩
  let v := liftHopfQuotient J ρ (fun x hx ↦ show x ∈ RingHom.ker ρ.hom.toAlgHom.toRingHom from hI ▸ hx)
  have hv (x : AK) : v.hom (Ideal.Quotient.mk J x) = ρ.hom x := rfl
  have hvbij : Function.Bijective v.hom := by
    constructor
    · intro x y he
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hv, hv] at he
      apply sub_eq_zero.mp
      rw [← map_sub]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [show J = RingHom.ker ρ.hom.toAlgHom.toRingHom from hI]
      change ρ.hom (x - y) = 0
      rw [map_sub, he, sub_self]
    · intro y
      obtain ⟨x, rfl⟩ := hsurj y
      exact ⟨Ideal.Quotient.mk J x, hv x⟩
  let v₀ := CommHopfAlgCat.isoMk (BialgEquiv.ofBijective v.hom hvbij)
  obtain ⟨z, hz⟩ := extendedHopfQuotient k K A I
  let β : extendedHopf K C ≅ B := z.symm ≪≫ v₀
  have hβ : extendedHopfMap K q ≫ β.hom = ρ := by
    change extendedHopfMap K q ≫ z.inv ≫ v = _
    rw [← hz, Category.assoc, z.hom_inv_id_assoc]
    apply CommHopfAlgCat.hom_ext
    exact BialgHom.ext hv
  let δ := (hopfSpec (CommRingCat.of K)).mapIso β.op
  have hδ : δ.hom ≫ specGroupMap (extendedHopfMap K q) = specGroupMap ρ := by
    change specGroupMap β.hom ≫ specGroupMap (extendedHopfMap K q) = _
    rw [← specGroupMap_comp, hβ]
  let b := extendedGroupIso K C
  have hb : b.hom ≫ F.map j = specGroupMap (extendedHopfMap K q) ≫ (extendedGroupIso K A).hom := by
    apply Grp.hom_ext
    exact (extendedSpecIso_natural K q).symm
  let w := eN ≪≫ δ ≪≫ b
  refine ⟨E, w.symm, ?_⟩
  apply (cancel_epi w.hom).mp
  change w.hom ≫ w.inv ≫ N.inclusion = w.hom ≫ F.map (j ≫ a.hom)
  rw [w.hom_inv_id_assoc]
  symm
  change eN.hom ≫ δ.hom ≫ b.hom ≫ F.map (j ≫ a.hom) = N.inclusion
  rw [F.map_comp, ← Category.assoc b.hom, hb, Category.assoc, ← Category.assoc δ.hom, hδ]
  change eN.hom ≫ N'.inclusion ≫ aK.hom = N.inclusion
  rw [hinc, eN.hom_inv_id_assoc]

/-- Descend the geometric torus kernel and apply the central quotient to the
original smooth connected affine group. -/
theorem centralFrobeniusReduction :
    Specs.CentralFrobeniusDescent.CentralFrobeniusReduction.{u} := by
  apply centralFrobeniusReduction_of_kernelDescent
  intro k _ _ p _ _ G hs hc T hT _ hLie
  let K := AlgebraicClosure k
  let F := groupBaseChange k K
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  obtain ⟨N, hN, hn⟩ := exists_geometricCentralFirstKernel
    LinearAlgebraicGroups.NormalizerLatticeAction.quotientByCentralizer p G hs hc hLie T hT.1
  obtain ⟨H, hHfin, _, hHcom, j, hj, hjc, Q, f, hQ, hf⟩ :=
    existsFiniteCentralSubgroupContainingKernel p G hs hc T hT N hN hn
  let H₀ := closedSubgroupAlgebraicGroup H
  let N₀ : ClosedSubgroup (F.obj H₀.val) := ⟨N.group, j, hjc⟩
  obtain ⟨E, e, he⟩ := descendFiniteMultiplicativeKernel p H₀ hHfin hHcom N₀
    (splitPresentation_of_torusSubgroup (closedSubgroupAlgebraicGroup T) hT.1 N) Q f hQ hf
  haveI : IsClosedImmersion E.inclusion.hom.hom.left := E.isClosedImmersion
  haveI : IsClosedImmersion H.inclusion.hom.hom.left := H.isClosedImmersion
  let E₀ : ClosedSubgroup G.val := ⟨E.group, E.inclusion ≫ H.inclusion, by
    change IsClosedImmersion (E.inclusion.hom.hom.left ≫ H.inclusion.hom.hom.left)
    infer_instance⟩
  refine ⟨E₀, N, e, hN, ?_⟩
  change e.hom ≫ N.inclusion ≫ T.inclusion = F.map (E.inclusion ≫ H.inclusion)
  have hje : e.hom ≫ j = F.map E.inclusion := he
  rw [F.map_comp, ← hje, Category.assoc, hj]

end

end

