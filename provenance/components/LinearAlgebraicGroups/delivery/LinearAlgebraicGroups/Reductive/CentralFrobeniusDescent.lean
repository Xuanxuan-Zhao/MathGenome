private theorem preimage_isNormal {G Q : GroupScheme k}
    {q : G ⟶ Q} {S : ClosedSubgroup Q} {P : ClosedSubgroup G} {r : P.group ⟶ S.group}
    (h : IsPullback P.inclusion r q S.inclusion)
    (hs : IsNormalSubgroup S.inclusion) : IsNormalSubgroup P.inclusion := by
  let X := G.X ⊗ P.group.X
  let g : X ⟶ G.X := fst G.X P.group.X
  let y : X ⟶ P.group.X := snd G.X P.group.X
  let z := g * (y ≫ P.inclusion.hom.hom) * g⁻¹
  obtain ⟨x, hx⟩ := normalSubgroup_conjugate_sections hs (g ≫ q.hom.hom) (y ≫ r.hom.hom)
  let F := Grp.forget (SchemeOver k)
  have hh : IsPullback P.inclusion.hom.hom r.hom.hom q.hom.hom S.inclusion.hom.hom :=
    h.map F
  have hzw : z ≫ q.hom.hom = x ≫ S.inclusion.hom.hom := by
    rw [hx]
    simp only [z, MonObj.mul_comp, GrpObj.inv_comp, Category.assoc, hh.w]
  exact ⟨hh.lift z x hzw, hh.lift_fst _ _ _⟩

private theorem torus_isMultiplicativeType (T : AffineAlgebraicGroup k) (ht : IsTorus T.val) :
    (multiplicativeTypeSpecFunctor k).essImage T := by
  obtain ⟨K, hK, hAlg, hsep, r, ⟨e⟩⟩ := ht
  obtain ⟨i⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := K) r
  exact (LinearAlgebraicGroups.CharacterDescent.multiplicativeTypeGroupCriterion T).mpr
    ⟨K, hK, hAlg, hsep, ⟨CommGrpCat.of (StandardLattice.{u} r), lattice_fg r⟩, ⟨e ≪≫ i.symm⟩⟩

private theorem trivial_of_zero_inclusion {G : GroupScheme k} (S : ClosedSubgroup G)
    (h : S.inclusion = 0) : IsTrivialSubgroup S := by
  have := S.isClosedImmersion
  have : Mono S.inclusion.hom.hom := Over.mono_of_mono_left _
  have : Mono S.inclusion := (Grp.forget _).mono_of_mono_map ‹Mono S.inclusion.hom.hom›
  have hz : 𝟙 S.group = 0 := by
    apply (cancel_mono S.inclusion).mp
    rw [Category.id_comp, zero_comp, h]
  exact ⟨((IsZero.iff_id_eq_zero _).mpr hz).iso (Grp.isZero_trivial _)⟩

private theorem trivial_of_subsingleton_points (G : AffineAlgebraicGroup k)
    [Subsingleton G.val.X.left] [IsReduced G.val.X.left] :
    Nonempty (G.val ≅ Grp.trivial (SchemeOver k)) := by
  let e := identitySubgroup G
  have hi := e.isClosedImmersion
  have hs : Surjective e.inclusion.hom.hom.left := by
    constructor
    intro x
    let y : e.group.X.left := IsLocalRing.closedPoint k
    exact ⟨y, Subsingleton.elim _ _⟩
  have : IsIso e.inclusion.hom.hom.left := isIso_of_isClosedImmersion_of_surjective _
  have : IsIso e.inclusion := isIso_of_schemeIso _
  exact ⟨(asIso e.inclusion).symm⟩

private theorem smooth_reduced_component_surjects {K : Type u} [Field K] [PerfectField K]
    (P : AffineAlgebraicGroup K) [ConnectedSpace P.val.X.left]
    (D : LinearAlgebraicGroups.EquivariantUnipotentSeries.ReducedIdentityComponent P) :
    Surjective D.subgroup.inclusion.hom.hom.left := by
  have hi := D.subgroup.isClosedImmersion
  let f := D.subgroup.inclusion.hom.hom.left
  have hcl : IsClopen (Set.range f) := ⟨hi.isClosedEmbedding.isClosed_range, D.open_range⟩
  have hn : (Set.range f).Nonempty :=
    ⟨f ((η[D.subgroup.group.X]).left (IsLocalRing.closedPoint K)), ⟨_, rfl⟩⟩
  exact ⟨Set.range_eq_univ.mp (hcl.eq_univ hn)⟩

set_option synthInstance.maxHeartbeats 300000 in
/-- The source's geometric rank-zero argument preserves reductivity under a
finite surjective radicial homomorphism with smooth connected target. -/
theorem reductive_of_finite_radicial_quotient
    (rankZero : Specs.TorusFreeUnipotent.Unipotence.{u})
    {G Q : AffineAlgebraicGroup k} (q : G.val ⟶ Q.val)
    [IsFinite q.hom.hom.left] [UniversallyInjective q.hom.hom.left] [Surjective q.hom.hom.left]
    (hsQ : Smooth Q.val.X.hom) (hcQ : ConnectedSpace Q.val.X.left)
    (hred : IsReductive G) : IsReductive Q := by
  letI := hcQ
  refine ⟨hsQ, geometricallyConnected_of_connected Q, ?_⟩
  let K := AlgebraicClosure k
  let G' := GeometricGroup G
  let Q' := GeometricGroup Q
  let q' := (groupBaseChange k K).map q
  let R := geometricUnipotentRadical Q
  let B := closedSubgroupAlgebraicGroup R
  have hR := LinearAlgebraicGroups.GeometricRadicals.geometricUnipotentRadicalLargest Q
  obtain ⟨P, r, hP⟩ := preimageSubgroup (G := G') (Q := Q') q' R
  let A := closedSubgroupAlgebraicGroup P
  have hbase := groupBaseChange_isPullback K q
  have : IsFinite q'.hom.hom.left := MorphismProperty.of_isPullback hbase.flip inferInstance
  have : UniversallyInjective q'.hom.hom.left :=
    MorphismProperty.of_isPullback hbase.flip inferInstance
  have : Surjective q'.hom.hom.left := MorphismProperty.of_isPullback hbase.flip inferInstance
  let H := Grp.forget (SchemeOver K) ⋙ Over.forget (Spec (CommRingCat.of K))
  have hPr : IsPullback P.inclusion.hom.hom.left r.hom.hom.left q'.hom.hom.left
      R.inclusion.hom.hom.left := hP.map H
  have : IsFinite r.hom.hom.left := MorphismProperty.of_isPullback hPr inferInstance
  have : UniversallyInjective r.hom.hom.left := MorphismProperty.of_isPullback hPr inferInstance
  have hr : Surjective r.hom.hom.left := MorphismProperty.of_isPullback hPr inferInstance
  have hconn : ConnectedSpace P.group.X.left := by
    have he : Function.Bijective r.hom.hom.left := ⟨r.hom.hom.left.injective, hr.1⟩
    let e := Equiv.ofBijective _ he
    let h := e.toHomeomorphOfContinuousClosed r.hom.hom.left.continuous
      r.hom.hom.left.isClosedMap
    exact h.connectedSpace_iff.mpr hR.1.2.1
  haveI : ConnectedSpace A.val.X.left := hconn
  obtain ⟨D⟩ := exists_smooth_identity_component A
  let C := closedSubgroupAlgebraicGroup D.subgroup
  have hsG : Smooth G'.val.X.hom := by
    have := hred.1
    change Smooth (pullback.snd G.val.X.hom (fieldSpecMap k K))
    infer_instance
  have hcG : ConnectedSpace G'.val.X.left := by
    letI := hred.2.1
    exact pullback_of_geometrically GeometricallyConnected.geometrically_connectedSpace K
      (fieldSpecMap k K)
  let i := D.subgroup.inclusion ≫ P.inclusion
  have hi : IsClosedImmersion i.hom.hom.left := by
    have := D.subgroup.isClosedImmersion
    have := P.isClosedImmersion
    exact IsClosedImmersion.comp _ _
  let V : ClosedSubgroup G'.val := ⟨C.val, i, hi⟩
  have hN := smooth_identity_component_normal hsG hcG P (preimage_isNormal hP hR.1.2.2) D
  have hU : Specs.Unipotent.IsUnipotent C := rankZero C D.smooth D.connected (by
    intro T hT
    let L := AlgebraicClosure K
    let F := groupBaseChange K L
    let B' := baseChangedAlgebraicGroup L B
    let p := F.map r
    let z := T.inclusion ≫ F.map D.subgroup.inclusion
    let T' := closedSubgroupAlgebraicGroup T
    have hp := groupBaseChange_isPullback L r
    have : UniversallyInjective p.hom.hom.left := MorphismProperty.of_isPullback hp.flip inferInstance
    have : IsFinite p.hom.hom.left := MorphismProperty.of_isPullback hp.flip inferInstance
    have : IsReduced T.group.X.left := by
      letI : Smooth T.group.X.hom := torus_smooth T' hT
      exact isReduced_of_smooth_over_field T.group.X.hom
    have hBu := (LinearAlgebraicGroups.Unipotent.unipotenceFieldExtension (K := L) B).mpr hR.2.1
    have ho : z ≫ p = 0 := LinearAlgebraicGroups.Unipotent.homFromMultiplicativeTypeToUnipotent
      T' B' (z ≫ p) (torus_isMultiplicativeType T' hT) hBu
    have hz : z = 0 := by
      apply Grp.hom_ext
      apply Over.OverMorphism.ext
      apply hom_eq_of_universallyInjective_of_isReduced p.hom.hom.left
      exact congrArg (fun f : T.group ⟶ B'.val ↦ f.hom.hom.left) (ho.trans (show (0 : T.group ⟶ _) ≫ p = 0 from zero_comp).symm)
    have hC := D.subgroup.isClosedImmersion
    have hC' : IsClosedImmersion (F.map D.subgroup.inclusion).hom.hom.left :=
      MorphismProperty.of_isPullback
        (groupBaseChange_isPullback L D.subgroup.inclusion).flip hC
    have : Mono (F.map D.subgroup.inclusion).hom.hom := Over.mono_of_mono_left _
    have : Mono (F.map D.subgroup.inclusion) := (Grp.forget _).mono_of_mono_map this
    exact trivial_of_zero_inclusion T ((cancel_mono (F.map D.subgroup.inclusion)).mp
      (hz.trans (show (0 : T.group ⟶ _) ≫ F.map D.subgroup.inclusion = 0 from zero_comp).symm)))
  have hG := LinearAlgebraicGroups.GeometricRadicals.geometricUnipotentRadicalLargest G
  obtain ⟨f, hf⟩ := hG.2.2 V ⟨D.smooth, D.connected, hN⟩ hU
  obtain ⟨e⟩ := hred.2.2
  have hv : V.inclusion = 0 := by
    rw [← hf]
    have h : (geometricUnipotentRadical G).inclusion = 0 := by
      apply (cancel_epi e.inv).mp
      exact Subsingleton.elim _ _
    rw [h, comp_zero]
  obtain ⟨eV⟩ := trivial_of_zero_inclusion V hv
  let u := H.mapIso eV
  have : Subsingleton (H.obj (Grp.trivial (SchemeOver K))) :=
    inferInstanceAs (Subsingleton (Spec (CommRingCat.of K)))
  have : Subsingleton D.subgroup.group.X.left :=
    u.hom.homeomorph.injective.subsingleton
  have hD := smooth_reduced_component_surjects A D
  have : Surjective (D.subgroup.inclusion.hom.hom.left ≫ r.hom.hom.left) :=
    MorphismProperty.comp_mem @Surjective _ _ hD hr
  have : Subsingleton R.group.X.left :=
    (D.subgroup.inclusion.hom.hom.left ≫ r.hom.hom.left).surjective.subsingleton
  have : Smooth B.val.X.hom := hR.1.1
  have : IsReduced B.val.X.left := isReduced_of_smooth_over_field B.val.X.hom
  have : Subsingleton B.val.X.left := ‹Subsingleton R.group.X.left›
  exact trivial_of_subsingleton_points B

open Specs.CentralFrobeniusDescent (characterValue IsAdjointWeight)
open Specs.DiagonalizableGroups (IntegerCharacters integerGenerator)
open Specs.AdjointRepresentation (GroupPoints constants dualMap scale)
open WithConv
open private pointsIso_spec integerHomEquiv from LinearAlgebraicGroups.Multiplicative.DiagonalizableGroups
open private tangent_coordinates from LinearAlgebraicGroups.Affine.AdjointRepresentation

private theorem characterValue_as_unit {S : GroupScheme k} (χ : Character S)
    {R : TestAlgebra k} (t : GroupPoints S R) :
    let v : IntegerCharacters.{u} →* Rˣ :=
      (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k IntegerCharacters).hom.app R
        (t ≫ χ.hom.hom)
    characterValue χ t = (v integerGenerator : R) := by
  let A := CommAlgCat.of k (groupAlgebra k IntegerCharacters)
  let a : A ⟶ R :=
    ((algSpec.fullyFaithful (R := CommRingCat.of k)).preimage
      (X := op R) (Y := op A) (t ≫ χ.hom.hom)).unop
  have ha : (algSpec (R := CommRingCat.of k)).map a.op = t ≫ χ.hom.hom :=
    (algSpec.fullyFaithful (R := CommRingCat.of k)).map_preimage _
  let e := hopfSpecPointIso (groupAlgebra k IntegerCharacters)
  have he : e.hom.app R (toConv a.hom) = t ≫ χ.hom.hom := ha
  dsimp only
  rw [← he, pointsIso_spec]
  rfl

private theorem character_trivial_of_values {S : GroupScheme k} [IsAffine S.X.left]
    (χ : Character S) (hχ : ∀ (R : TestAlgebra k) (t : GroupPoints S R), characterValue χ t = 1) :
    χ = 1 := by
  let T := specGroup (groupAlgebra k IntegerCharacters)
  have h : (groupPointsFunctor k).map χ = (groupPointsFunctor k).map (1 : Character S) := by
    apply NatTrans.ext
    funext R
    apply GrpCat.ext
    intro t
    let e := (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k IntegerCharacters).hom.app R
    have hval : ((show IntegerCharacters.{u} →* Rˣ from e (t ≫ χ.hom.hom)) integerGenerator : R) = 1 :=
      (characterValue_as_unit χ t).symm.trans (hχ R t)
    have hpoint : t ≫ χ.hom.hom = (1 : GroupPoints T R) := by
      apply (ConcreteCategory.bijective_of_isIso e).1
      apply (integerHomEquiv Rˣ).symm.injective
      apply Units.ext
      change ((show IntegerCharacters.{u} →* Rˣ from e (t ≫ χ.hom.hom)) integerGenerator : R) =
        ((show IntegerCharacters.{u} →* Rˣ from e (1 : GroupPoints T R)) integerGenerator : R)
      rw [hval, map_one]
      rfl
    change t ≫ χ.hom.hom = t ≫ (1 : Character S).hom.hom
    rw [hpoint, Grp.Hom.hom_one, Mon.Hom.hom_one, MonObj.comp_one]
  exact (groupHomEquiv S T inferInstance).injective h

/-- A character on a nonzero adjoint weight space is trivial on every
subgroup that acts centrally, including nonreduced subgroups. -/
theorem adjointWeight_trivial_on_central (G : AffineAlgebraicGroup k)
    {S N : GroupScheme k} [IsAffine N.X.left] (i : S ⟶ G.val) (j : N ⟶ S)
    (hc : IsCentral (j ≫ i)) (χ : Character S) (hχ : IsAdjointWeight i χ) :
    j ≫ χ = 1 := by
  obtain ⟨x, hx, hw⟩ := hχ
  obtain ⟨s⟩ := identityLieBracket k G
  letI := s.lieRing
  letI := s.lieAlgebra
  obtain ⟨n, b, ⟨C⟩⟩ := tangent_coordinates G s
  let Index := ULift.{u} (Fin n)
  let z : Lie k G.val := s.lieRing.toAddCommGroup.toAddGroup.toAddMonoid.toAddZeroClass.zero
  have hz := congrArg (fun a : AddGroup (Lie k G.val) ↦ a.toAddMonoid.toAddZeroClass.zero) s.group_law
  have hb : b.equivFun x ≠ 0 := by
    intro h
    apply hx
    have he : x = z := b.equivFun.injective (h.trans b.equivFun.toLinearMap.map_zero.symm)
    exact he.trans hz
  obtain ⟨l, hl⟩ : ∃ l : Index, b.equivFun x l ≠ 0 := by
    by_contra! h
    exact hb (funext h)
  apply character_trivial_of_values
  intro R t
  let F := groupPointsFunctor k
  let u := (F.map j).app R t
  let a : CommAlgCat.of k k ⟶ R := CommAlgCat.ofHom (Algebra.ofId k R)
  let v : Index → R := fun l ↦ a.hom (b.equivFun x l)
  let xR : GroupPoints G.val (CommAlgCat.of k (DualNumber R)) :=
    mapPoints (dualMap a) x.toMul.val
  let g := (F.map i).app R u
  let c : GroupPoints G.val (CommAlgCat.of k (DualNumber R)) :=
    ((F.obj G.val).map (constants R)).hom g
  let t' := ((F.obj N).map (constants R)).hom t
  have htc : t' ≫ (j ≫ i).hom.hom = c := by
    change (F.map (j ≫ i)).app _ (((F.obj N).map (constants R)).hom t) = _
    have hh := NatTrans.naturality_apply (F.map (j ≫ i)) (constants R) t
    change (F.map (j ≫ i)).app _ (((F.obj N).map (constants R)).hom t) =
      (((F.obj G.val).map (constants R)).hom ((F.map (j ≫ i)).app R t)) at hh
    rw [hh, F.map_comp]
    rfl
  have hcx : Commute c xR := by
    have hh := commute_of_isCentral hc xR t'
    rw [htc] at hh
    exact hh.symm
  have hscale : xR = mapPoints (scale R (characterValue χ u)) xR := by
    have h := hw R u
    change c * xR * c⁻¹ = _ at h
    rw [hcx.eq, mul_assoc, mul_inv_cancel, mul_one] at h
    exact h
  have hv : (C.equiv R v).toMul.val = xR := by
    simpa only [v, xR, C.at_base] using C.naturality a (b.equivFun x)
  have hmul : v = characterValue χ u • v := by
    apply (C.equiv R).injective
    apply Subtype.ext
    change (C.equiv R v).toMul.val = (C.equiv R (characterValue χ u • v)).toMul.val
    rw [C.smul, hv]
    exact hscale
  have h1 : (1 : R) * v l = characterValue χ u * v l := by
    simpa only [one_mul, Pi.smul_apply, smul_eq_mul] using congrFun hmul l
  obtain ⟨z, hz⟩ : IsUnit (v l) := (isUnit_iff_ne_zero.mpr hl).map a.hom
  have h2 := congrArg (fun w : R ↦ w * (↑z⁻¹ : R)) h1
  rw [← hz, mul_assoc, mul_assoc, Units.mul_inv, mul_one, mul_one] at h2
  change characterValue χ u = 1
  exact h2.symm

/-- When the first Frobenius kernel of the split acting torus is central,
every occurring adjoint character is divisible by the characteristic. -/
theorem adjointWeight_isPower_of_central_firstKernel
    (G : AffineAlgebraicGroup k) (T : ClosedSubgroup G.val) (hT : IsTorus T.group)
    (hS : IsSplitTorus T.group)
    (p : ℕ) [Fact p.Prime] [CharP k p] (N : ClosedSubgroup T.group)
    (hN : IsFirstFrobeniusKernel p N) (hC : IsCentral (N.inclusion ≫ T.inclusion))
    (χ : Character T.group) (hχ : IsAdjointWeight T.inclusion χ) : IsCharacterPower p χ := by
  let A := closedSubgroupAlgebraicGroup T
  haveI : IsCommMonObj A.val.X := torus_commutative A hT
  haveI : IsCommMonObj T.group.X := inferInstanceAs (IsCommMonObj A.val.X)
  haveI : IsAffine T.group.X.left := A.property.1
  haveI : IsAffine N.group.X.left :=
    (closedSubgroupAlgebraicGroup (G := A) N).property.1
  have hk := (firstFrobeniusKernel_iff_powerKernel_of_split p hS N).mp hN
  obtain ⟨hf, hs⟩ := torus_power_flat_surjective A hT p (Fact.out : p.Prime).ne_zero
  haveI : Flat (powerHom T.group p).hom.hom.left := hf
  haveI : Surjective (powerHom T.group p).hom.hom.left := hs
  have hz := adjointWeight_trivial_on_central G T.inclusion N.inclusion hC χ hχ
  have hz₀ : N.inclusion.hom.hom ≫ χ.hom.hom = 1 := by
    change (N.inclusion ≫ χ).hom.hom = _
    rw [hz, Grp.Hom.hom_one, Mon.Hom.hom_one]
  obtain ⟨ψ, hψ⟩ := descendHomOfSchemeKernel (powerHom T.group p) hk χ hz₀
  refine ⟨ψ, ?_⟩
  rw [← hψ]
  apply Grp.hom_ext
  change (ψ ^ p).hom.hom = (powerHom T.group p).hom.hom ≫ ψ.hom.hom
  simp only [powerHom, Grp.Hom.hom_pow, Mon.Hom.hom_pow]
  change ψ.hom.hom ^ p = ((𝟙 T.group.X) ^ p) ≫ ψ.hom.hom
  rw [MonObj.pow_comp, Category.id_comp]

open private pointsIso_precompose from LinearAlgebraicGroups.Multiplicative.DiagonalizableGroups

private theorem splitCharacter_value
    {M : Type u} [CommGroup M] (m : M)
    {R : TestAlgebra k} (t : GroupPoints (specGroup (groupAlgebra k M)) R) :
    characterValue (specGroupMap (groupAlgebraMap k
      ((zpowersHom M m).comp MulEquiv.ulift.toMonoidHom))) t =
      ((show M →* Rˣ from
        (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k M).hom.app R t) m : R) := by
  rw [characterValue_as_unit]
  change ((show IntegerCharacters.{u} →* Rˣ from
      (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k IntegerCharacters).hom.app R
        (((groupPointsFunctor k).map (specGroupMap (groupAlgebraMap k
          ((zpowersHom M m).comp MulEquiv.ulift.toMonoidHom)))).app R t))
      integerGenerator : R) = _
  rw [pointsIso_precompose]
  simp only [MonoidHom.comp_apply]
  change ((show M →* Rˣ from
    (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k M).hom.app R t)
      (m ^ (1 : ℤ)) : R) = _
  rw [zpow_one]

private def dualOneUnit (a : k) : (DualNumber k)ˣ :=
  ⟨⟨1, a⟩, ⟨1, -a⟩,
    TrivSqZeroExt.ext (one_mul _) (by simp),
    TrivSqZeroExt.ext (one_mul _) (by simp)⟩

private def latticeProbe (r : ℕ) (l : Fin r) : StandardLattice.{u} r →* (DualNumber k)ˣ where
  toFun m := dualOneUnit (k := k) ((m l).down.toAdd : k)
  map_one' := by
    apply Units.ext
    exact TrivSqZeroExt.ext rfl (Int.cast_zero)
  map_mul' m n := by
    apply Units.ext
    apply TrivSqZeroExt.ext
    · change (1 : k) = 1 * 1
      exact (one_mul 1).symm
    · change (((m l).down.toAdd + (n l).down.toAdd : ℤ) : k) =
        1 * ((n l).down.toAdd : k) + ((m l).down.toAdd : k) * 1
      rw [Int.cast_add, one_mul, mul_one, add_comm]

private theorem splitTorus_tangent_probes (r : ℕ) :
    let S := specGroup (groupAlgebra k (StandardLattice.{u} r))
    ∃ (x : Fin r → Lie k S) (e : StandardLattice.{u} r ≃* Character S),
      (∀ m, e m = specGroupMap (groupAlgebraMap k
        ((zpowersHom (StandardLattice.{u} r) m).comp MulEquiv.ulift.toMonoidHom))) ∧
      ∀ (m : StandardLattice.{u} r) (l : Fin r),
        characterValue (e m) (R := CommAlgCat.of k (DualNumber k)) (x l).toMul.val =
          (⟨1, (m l).down.toAdd⟩ : DualNumber k) := by
  let M := StandardLattice.{u} r
  let S := specGroup (groupAlgebra k M)
  let R := CommAlgCat.of k (DualNumber k)
  let B := CommAlgCat.of k k
  let e := LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k M
  let ρ (l : Fin r) : (Specs.DiagonalizableGroups.characterValuedPoints k M).obj R :=
    latticeProbe r l
  let t (l : Fin r) : GroupPoints S R := e.inv.app R (ρ l)
  have ht (l : Fin r) : e.hom.app R (t l) = ρ l := by
    exact ConcreteCategory.congr_hom (e.app R).inv_hom_id (ρ l)
  have hred (l : Fin r) : (reduceTangentPoints S) (t l) = 1 := by
    apply (ConcreteCategory.bijective_of_isIso (e.hom.app B)).1
    have h := NatTrans.naturality_apply e.hom (dualReduction k) (t l)
    change e.hom.app B (reduceTangentPoints S (t l)) =
      (Specs.DiagonalizableGroups.characterValuedPoints k M).map (dualReduction k)
        (e.hom.app R (t l)) at h
    rw [h, ht, map_one]
    apply MonoidHom.ext
    intro m
    apply Units.ext
    rfl
  let x (l : Fin r) : Lie k S := Additive.ofMul ⟨t l, hred l⟩
  obtain ⟨χ, a, hχ, _, _⟩ := LinearAlgebraicGroups.CharacterDescent.splitCompositionPairing
    (k := k) r
  refine ⟨x, χ, hχ, fun m l ↦ ?_⟩
  change characterValue (χ m) (t l) = _
  rw [hχ, splitCharacter_value]
  change ((show M →* Rˣ from e.hom.app R (t l)) m : R) = _
  rw [ht]
  rfl

private theorem lattice_power_of_cast_zero (p : ℕ) [Fact p.Prime] [CharP k p] (r : ℕ)
    (m : StandardLattice.{u} r) (h : ∀ l : Fin r, (((m l).down.toAdd : ℤ) : k) = 0) :
    ∃ m₀ : StandardLattice.{u} r, m₀ ^ p = m := by
  have hm (l : Fin r) : (p : ℤ) ∣ (m l).down.toAdd :=
    (CharP.intCast_eq_zero_iff k p _).mp (h l)
  choose d hd using hm
  let m₀ : StandardLattice.{u} r := fun l ↦ ⟨Multiplicative.ofAdd (d l)⟩
  refine ⟨m₀, ?_⟩
  funext l
  apply ULift.ext
  apply Multiplicative.toAdd.injective
  change p • d l = (m l).down.toAdd
  rw [nsmul_eq_mul, hd]

/-- The differential detects (p)-divisibility of characters of a split
diagonal torus by its values on the first-order coordinate probes. -/
theorem splitTorusCharacter_power_of_zero_differential
    (p : ℕ) [Fact p.Prime] [CharP k p] (r : ℕ)
    (χ : Character (specGroup (groupAlgebra k (StandardLattice.{u} r))))
    (hχ : ∀ x : Lie k (specGroup (groupAlgebra k (StandardLattice.{u} r))),
      (characterValue χ (R := CommAlgCat.of k (DualNumber k)) x.toMul.val).snd = 0) :
    IsCharacterPower p χ := by
  obtain ⟨x, e, _, hx⟩ := splitTorus_tangent_probes (k := k) r
  obtain ⟨m, rfl⟩ := e.surjective χ
  have h (l : Fin r) : ((m l).down.toAdd : k) = 0 := by
    have he := hχ (x l)
    rw [hx] at he
    exact he
  obtain ⟨m₀, hm₀⟩ := lattice_power_of_cast_zero p r m h
  exact ⟨e m₀, (map_pow e m₀ p).symm.trans (congrArg e hm₀)⟩

open Specs.NormalizerLatticeAction (FaithfulWeights QuotientByCentralizer)
open Specs.SemisimpleLieCentralizer (HasGeometricNoncentralSemisimple GeometricallySemisimple)
open Specs.StandardGroups (multiplicativePoints generalLinearPoints)
open private integerPointsIso from LinearAlgebraicGroups.Multiplicative.DiagonalizableGroups

private theorem commute_diagonal_of_coordinate_tests
    {Index : Type u} [Fintype Index] [DecidableEq Index]
    {R : Type u} [CommRing R] [Algebra k R] {r : ℕ}
    (A : Matrix Index Index R) (a : Index → Fin r → k) (d : Index → R)
    (ha : ∀ l, Commute A (Matrix.diagonal (fun i ↦ algebraMap k R (a i l))))
    (hd : ∀ i j, (∀ l, a i l = a j l) → d i = d j) : Commute A (Matrix.diagonal d) := by
  classical
  change A * Matrix.diagonal d = Matrix.diagonal d * A
  ext i j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases hij : ∀ l, a i l = a j l
  · rw [hd i j hij, mul_comm]
  · push Not at hij
    obtain ⟨l, hl⟩ := hij
    have hw := congrArg (fun B : Matrix Index Index R ↦ B i j) (ha l).eq
    rw [Matrix.mul_diagonal, Matrix.diagonal_mul, mul_comm (algebraMap k R (a i l))] at hw
    have hz : A i j * algebraMap k R (a j l - a i l) = 0 := by
      rw [map_sub, mul_sub, hw, sub_self]
    obtain ⟨z, hz'⟩ : IsUnit (algebraMap k R (a j l - a i l)) :=
      (isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hl.symm)).map (algebraMap k R)
    have hA : A i j = 0 := by
      calc
        A i j = (A i j * z.val) * ↑z⁻¹ := (Units.mul_inv_cancel_right _ _).symm
        _ = 0 := by rw [hz', hz, zero_mul]
    rw [hA, zero_mul, mul_zero]

private theorem pointwise_central_of_affine {E G : GroupScheme k} (f : E ⟶ G)
    [IsAffine E.X.left] [IsAffine G.X.left]
    (h : ∀ (R : TestAlgebra k) (g : GroupPoints G R) (t : GroupPoints E R),
      Commute g (t ≫ f.hom.hom)) : IsCentral f := by
  apply (central_iff_conjugation f).mpr
  let X := G.X ⨯ E.X
  have hX : IsAffine X.left := affine_product _ _
  obtain ⟨A, ⟨e⟩⟩ := (essImage_algSpec (R := CommRingCat.of k)).mpr hX
  let a := e.hom ≫ prod.fst
  let b := e.hom ≫ prod.snd
  let d : X ⟶ G.X ⊗ E.X := lift prod.fst prod.snd
  haveI : IsIso d := by
    let c := prod.lift (fst G.X E.X) (snd G.X E.X)
    have hd₁ : d ≫ c = 𝟙 X := by
      apply prod.hom_ext
      · simp only [c, d, Category.assoc, prod.lift_fst, lift_fst, Category.id_comp]
      · simp only [c, d, Category.assoc, prod.lift_snd, lift_snd, Category.id_comp]
    have hd₂ : c ≫ d = 𝟙 (G.X ⊗ E.X) := by
      apply CartesianMonoidalCategory.hom_ext
      · simp only [c, d, Category.assoc, lift_fst, prod.lift_fst, Category.id_comp]
      · simp only [c, d, Category.assoc, lift_snd, prod.lift_snd, Category.id_comp]
    exact ⟨⟨c, hd₁, hd₂⟩⟩
  have hcomm := h A.unop a b
  apply (cancel_epi (e.hom ≫ d)).mp
  change (e.hom ≫ d) ≫ (fst G.X E.X * (snd G.X E.X ≫ f.hom.hom) *
    (fst G.X E.X)⁻¹) = _
  have hF : (e.hom ≫ d) ≫ fst G.X E.X = a := by
    rw [Category.assoc]
    exact congrArg (e.hom ≫ ·) (lift_fst _ _)
  have hS : (e.hom ≫ d) ≫ snd G.X E.X = b := by
    rw [Category.assoc]
    exact congrArg (e.hom ≫ ·) (lift_snd _ _)
  simp only [MonObj.comp_mul, GrpObj.comp_inv, ← Category.assoc, hF, hS]
  rw [hcomm.eq, mul_assoc, mul_inv_cancel, mul_one]

private theorem matrixDiagonal_of_faithfulWeights
    (G : AffineAlgebraicGroup k) {T : GroupScheme k} (i : T ⟶ G.val)
    (w : Set (Character T)) (h : FaithfulWeights i w) :
    ∃ (n : ℕ) (L : AffineAlgebraicGroup k)
      (l : (groupPointsFunctor k).obj L.val ≅ generalLinearPoints k (ULift.{u} (Fin n)))
      (f : G.val ⟶ L.val) (χ : ULift.{u} (Fin n) → Character T),
      IsClosedImmersion f.hom.hom.left ∧
      ∀ (R : TestAlgebra k) (t : GroupPoints T R),
        (l.hom.app R (t ≫ (i ≫ f).hom.hom) :
          Matrix.GeneralLinearGroup (ULift.{u} (Fin n)) R).val =
          Matrix.diagonal (fun j ↦ characterValue (χ j) t) := by
  obtain ⟨n, L, l, m, f, χ, hf, _, _, hd⟩ := h
  let C := specGroup (groupAlgebra k IntegerCharacters)
  let e := LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso k IntegerCharacters ≪≫
    integerPointsIso
  let a := groupHomEquiv C C (inferInstanceAs (IsAffine (Spec _)))
  let s := a.symm (m.hom ≫ e.inv)
  have hs : (groupPointsFunctor k).map s = m.hom ≫ e.inv := a.apply_symm_apply _
  have hm : (groupPointsFunctor k).map s ≫ e.hom = m.hom := by rw [hs, Category.assoc, e.inv_hom_id, Category.comp_id]
  refine ⟨n, L, l, f, fun j ↦ χ j ≫ s, hf, ?_⟩
  intro R t
  rw [hd]
  congr 1
  funext j
  have he :=
    congrArg (fun b : (groupPointsFunctor k).obj C ⟶ multiplicativePoints k ↦ b.app R (t ≫ (χ j).hom.hom)) hm
  refine (congrArg (fun u : Rˣ ↦ (u : R)) he).symm.trans ?_
  exact (characterValue_as_unit (χ j ≫ s) t).symm

private theorem integerDiagonal_semisimple [IsAlgClosed k]
    {Index : Type u} [Fintype Index] [DecidableEq Index]
    (p : ℕ) [Fact p.Prime] [CharP k p] (d : Index → ℤ) :
    Module.End.IsSemisimple (Matrix.toLinAlgEquiv' (Matrix.diagonal (fun i ↦ (d i : k)))) := by
  let X := Matrix.diagonal (fun i ↦ (d i : k))
  obtain ⟨r, hr⟩ := pow_unbounded_of_one_lt (Module.finrank k (Index → k))
    (Fact.out : p.Prime).one_lt
  have hpow : X ^ (p ^ r) = X := by
    unfold X
    rw [Matrix.diagonal_pow]
    congr 1
    funext i
    exact map_intCast (iterateFrobenius k p r) (d i)
  have he := LinearAlgebraicGroups.SemisimpleLieCentralizer.largePrimePowerSemisimple
    k (Index → k) p r (Matrix.toLinAlgEquiv' X) hr.le
  rw [← map_pow, hpow] at he
  exact he

/-- Under the geometric Lie hypothesis, the first Frobenius kernel of the
geometric torus centralizes the entire geometric group as a scheme. -/
theorem geometricFirstKernel_central
    (normalizer : QuotientByCentralizer.{u})
    (p : ℕ) [Fact p.Prime] [CharP k p]
    (G : AffineAlgebraicGroup k) (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left)
    (hLie : ¬ HasGeometricNoncentralSemisimple G)
    (T : ClosedSubgroup (GeometricGroup G).val) (hT : IsTorus T.group)
    (N : ClosedSubgroup T.group)
    (hN : letI : CharP (AlgebraicClosure k) p :=
      charP_of_injective_algebraMap (algebraMap k (AlgebraicClosure k)).injective p
      IsFirstFrobeniusKernel p N) : IsCentral (N.inclusion ≫ T.inclusion) := by
  classical
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  let A := GeometricGroup G
  let B := closedSubgroupAlgebraicGroup T
  have hsm : Smooth A.val.X.hom := by
    letI := hs
    change Smooth (pullback.snd G.val.X.hom (fieldSpecMap k K))
    infer_instance
  have hcon : ConnectedSpace A.val.X.left := by
    letI := hc
    letI := geometricallyConnected_of_connected G
    exact pullback_of_geometrically GeometricallyConnected.geometrically_connectedSpace K
      (fieldSpecMap k K)
  have ht : IsSplitTorus T.group := torus_split_of_algClosed B hT
  letI : IsCommMonObj T.group.X := torus_commutative B hT
  have hker : IsSchemeKernel (powerHom T.group p) N :=
    (firstFrobeniusKernel_iff_powerKernel_of_split p ht N).mp hN
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hw, _⟩ := normalizer A hsm hcon T hT
  obtain ⟨W⟩ := hw ht
  obtain ⟨n, L, fIso, f, χ, hf, hdiag⟩ :=
    matrixDiagonal_of_faithfulWeights A T.inclusion W.weights W.faithfulWeights
  let Index := ULift.{u} (Fin n)
  let L' : AffineGroupCategory K := ⟨L.val, L.property.1⟩
  let Φ := (groupPointsFunctor K).map f ≫ fIso.hom
  obtain ⟨r, ⟨s⟩⟩ := ht
  obtain ⟨d⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := K) r
  let M := StandardLattice.{u} r
  let D := specGroup (groupAlgebra K M)
  let e : D ≅ T.group := d ≪≫ s.symm
  let g := e.hom ≫ T.inclusion
  obtain ⟨x, b, hb, hprobe⟩ := splitTorus_tangent_probes (k := K) r
  let w (i : Index) : M := b.symm (e.hom ≫ χ i)
  have hwχ (i : Index) : b (w i) = e.hom ≫ χ i := b.apply_symm_apply _
  have hdg (R : TestAlgebra K) (t : GroupPoints D R) :
      (Φ.app R (t ≫ g.hom.hom) : Matrix.GeneralLinearGroup Index R).val =
        Matrix.diagonal (fun i ↦ characterValue (b (w i)) t) := by
    have hh := hdiag R (t ≫ e.hom.hom.hom)
    change (Φ.app R (t ≫ g.hom.hom) : Matrix.GeneralLinearGroup Index R).val = _
    have hleft :
        (Φ.app R (t ≫ g.hom.hom) : Matrix.GeneralLinearGroup Index R).val =
          (fIso.hom.app R ((t ≫ e.hom.hom.hom) ≫ (T.inclusion ≫ f).hom.hom) :
            Matrix.GeneralLinearGroup Index R).val := by
      change (fIso.hom.app R ((t ≫ g.hom.hom) ≫ f.hom.hom) :
        Matrix.GeneralLinearGroup Index R).val = _
      apply congrArg (fun v : GroupPoints L.val R ↦ (fIso.hom.app R v :
        Matrix.GeneralLinearGroup Index R).val)
      change (t ≫ e.hom.hom.hom ≫ T.inclusion.hom.hom) ≫ f.hom.hom =
        (t ≫ e.hom.hom.hom) ≫ T.inclusion.hom.hom ≫ f.hom.hom
      simp only [Category.assoc]
    rw [hleft, hh]
    congr 1
    funext i
    rw [hwχ]
    unfold characterValue
    simp only [Category.assoc]
    rfl
  let a (i : Index) (l : Fin r) : K := ((w i l).down.toAdd : K)
  let y (l : Fin r) : Lie K A.val := mapPointKernel g (x l)
  have hmat (l : Fin r) : InfinitesimalCommutator.matrixDifferential f fIso (y l) =
      Matrix.diagonal (fun i ↦ a i l) := by
    have h := hdg (CommAlgCat.of K (DualNumber K)) (x l).toMul.val
    ext i j
    have h₀ := congrArg (fun U : Matrix Index Index (DualNumber K) ↦ (U i j).snd) h
    change ((Φ.app _ ((x l).toMul.val ≫ g.hom.hom) :
      Matrix.GeneralLinearGroup Index (DualNumber K)).val i j).snd = _
    rw [h₀]
    by_cases hij : i = j
    · subst j
      rw [Matrix.diagonal_apply_eq, Matrix.diagonal_apply_eq, hprobe]
      rfl
    · rw [Matrix.diagonal_apply_ne _ hij, Matrix.diagonal_apply_ne _ hij]
      rfl
  obtain ⟨sLie⟩ := identityLieBracket K A
  letI := sLie.lieRing
  letI := sLie.lieAlgebra
  have hsemi (l : Fin r) : Module.End.IsSemisimple (Matrix.toLinAlgEquiv'
      (InfinitesimalCommutator.matrixDifferential f fIso (y l))) := by
    rw [hmat]
    exact integerDiagonal_semisimple p fun i ↦ (w i l).down.toAdd
  have hcY (l : Fin r) :
      LieAlgebra.ad K (Lie K A.val) (y l) = 0 := by
    by_contra hh
    apply hLie
    exact ⟨sLie, Index, inferInstance, inferInstance, L', fIso, f, hf, y l, hsemi l, hh⟩
  have hentry (R : TestAlgebra K) (t : GroupPoints A.val R) (l : Fin r) :
      Commute (Φ.app R t : Matrix.GeneralLinearGroup Index R).val
        (Matrix.diagonal (fun i ↦ algebraMap K R (a i l))) := by
    have hy : GeometricallySemisimple (InfinitesimalCommutator.matrixDifferential f fIso (y l)) := by
      change Module.End.IsSemisimple (Matrix.toLinAlgEquiv'
        ((InfinitesimalCommutator.matrixDifferential f fIso (y l)).map (algebraMap K (AlgebraicClosure K))))
      rw [hmat, Matrix.diagonal_map (map_zero (algebraMap K (AlgebraicClosure K)))]
      haveI : CharP (AlgebraicClosure K) p :=
        charP_of_injective_algebraMap (algebraMap K (AlgebraicClosure K)).injective p
      change Module.End.IsSemisimple (Matrix.toLinAlgEquiv'
        (Matrix.diagonal (fun i ↦ algebraMap K (AlgebraicClosure K) (a i l))))
      have hcast : (fun i : Index ↦ algebraMap K (AlgebraicClosure K) (a i l)) =
          (fun i ↦ ((w i l).down.toAdd : AlgebraicClosure K)) :=
        funext fun i ↦ map_intCast (algebraMap K (AlgebraicClosure K)) ((w i l).down.toAdd)
      rw [hcast]
      exact integerDiagonal_semisimple (k := AlgebraicClosure K) p (fun i ↦ (w i l).down.toAdd)
    obtain ⟨V, _, hV, _, hIso⟩ :=
      LinearAlgebraicGroups.SemisimpleLieCentralizer.schemeCentralizerOfSemisimple
        K A L' sLie hsm Index fIso f hf (y l) hy
    haveI : IsIso V.inclusion := hIso hcon.toPreconnectedSpace (hcY l)
    have hsur := (ConcreteCategory.bijective_of_isIso
      (((groupPointsFunctor K).map V.inclusion).app R)).2 t
    have h := (hV R t).mp hsur
    rw [hmat, Matrix.diagonal_map (map_zero (algebraMap K R))] at h
    exact h
  haveI : IsAffine A.val.X.left := A.property.1
  haveI : IsAffine N.group.X.left := (closedSubgroupAlgebraicGroup (G := B) N).property.1
  apply pointwise_central_of_affine
  intro R t z
  let t₀ : GroupPoints T.group R := z ≫ N.inclusion.hom.hom
  let z₀ : GroupPoints D R := t₀ ≫ e.inv.hom.hom
  have hz₀ : z₀ ≫ g.hom.hom = z ≫ (N.inclusion ≫ T.inclusion).hom.hom := by
    change ((z ≫ N.inclusion.hom.hom) ≫ e.inv.hom.hom) ≫
      e.hom.hom.hom ≫ T.inclusion.hom.hom = z ≫ N.inclusion.hom.hom ≫ T.inclusion.hom.hom
    have he : e.inv.hom.hom ≫ e.hom.hom.hom = 𝟙 T.group.X :=
      (Grp.forget (SchemeOver K)).congr_map e.inv_hom_id
    simp only [Category.assoc, reassoc_of% he]
  have hzpow : z₀ ^ p = 1 := by
    have hNpow : N.inclusion.hom.hom ^ p = 1 :=
      (powerHom_onSections _ _ _).symm.trans hker.w
    have hz' : (z ≫ N.inclusion.hom.hom) ^ p = 1 := by
      rw [← MonObj.comp_pow, hNpow, MonObj.comp_one]
    change ((z ≫ N.inclusion.hom.hom) ≫ e.inv.hom.hom) ^ p = 1
    rw [← MonObj.pow_comp, hz', MonObj.one_comp]
  let ω : M →* Rˣ := (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso K M).hom.app R z₀
  have hwPow (m : M) : ω m ^ p = 1 := by
    let E := (LinearAlgebraicGroups.DiagonalizableGroups.groupAlgebraPointsIso K M).hom.app R
    have h := (map_pow E.hom z₀ p).symm.trans ((congrArg E.hom hzpow).trans (map_one E.hom))
    exact congrArg (fun a : M →* Rˣ ↦ a m) h
  have hv (i : Index) : characterValue (b (w i)) z₀ = (ω (w i) : R) := by
    rw [hb, splitCharacter_value]
  have hvalue (i j : Index) (hij : ∀ l, a i l = a j l) :
      characterValue (b (w i)) z₀ = characterValue (b (w j)) z₀ := by
    rw [hv, hv]
    obtain ⟨v, hv⟩ := lattice_power_of_cast_zero (k := K) p r (w i / w j) (by
      intro l
      change (((w i l).down.toAdd - (w j l).down.toAdd : ℤ) : K) = 0
      rw [Int.cast_sub, sub_eq_zero]
      exact hij l)
    have hh : ω (w i) / ω (w j) = 1 := by
      rw [← map_div, ← hv, map_pow, hwPow]
    exact congrArg (fun a : Rˣ ↦ (a : R)) (div_eq_one.mp hh)
  have hmatComm : Commute (Φ.app R t : Matrix.GeneralLinearGroup Index R).val
      (Φ.app R (z₀ ≫ g.hom.hom) : Matrix.GeneralLinearGroup Index R).val := by
    rw [hdg]
    exact commute_diagonal_of_coordinate_tests _ _ _ (hentry R t) hvalue
  have hΦ : Function.Injective (Φ.app R) := by
    have : IsClosedImmersion f.hom.hom.left := hf
    haveI : Mono f.hom.hom := Over.mono_of_mono_left _
    exact (ConcreteCategory.bijective_of_isIso (fIso.hom.app R)).1.comp
      (fun _ _ h ↦ (cancel_mono f.hom.hom).mp h)
  show t * _ = _ * t
  apply hΦ
  rw [map_mul, map_mul, ← hz₀]
  apply Matrix.GeneralLinearGroup.ext
  intro i j
  exact congrArg (fun m : Matrix Index Index R ↦ m i j) hmatComm.eq

/-- Construct the full geometric first Frobenius kernel and prove its
scheme centrality before descent to the original field. -/
theorem exists_geometricCentralFirstKernel
    (normalizer : QuotientByCentralizer.{u})
    (p : ℕ) [Fact p.Prime] [CharP k p]
    (G : AffineAlgebraicGroup k) (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left)
    (hLie : ¬ HasGeometricNoncentralSemisimple G)
    (T : ClosedSubgroup (GeometricGroup G).val) (hT : IsTorus T.group) :
    letI : CharP (AlgebraicClosure k) p :=
      charP_of_injective_algebraMap (algebraMap k (AlgebraicClosure k)).injective p
    ∃ N : ClosedSubgroup T.group,
      IsFirstFrobeniusKernel p N ∧ IsCentral (N.inclusion ≫ T.inclusion) := by
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  let A := closedSubgroupAlgebraicGroup T
  have : IsAffine T.group.X.left := A.property.1
  have : IsCommMonObj T.group.X := torus_commutative A hT
  have ht : IsSplitTorus T.group := torus_split_of_algClosed A hT
  obtain ⟨N, hN⟩ := schemeKernel_exists (powerHom T.group p)
  have hF := (firstFrobeniusKernel_iff_powerKernel_of_split p ht N).mpr hN
  exact ⟨N, hF, geometricFirstKernel_central normalizer p G hs hc hLie T hT N hF⟩

/-- The geometric semisimplicity hypothesis forces divisibility of the original
adjoint weights, using only the faithful split-torus weight data. -/
theorem geometricAdjointWeights_divisible
    (normalizer : QuotientByCentralizer.{u})
    (p : ℕ) [Fact p.Prime] [CharP k p]
    (G : AffineAlgebraicGroup k) (hs : Smooth G.val.X.hom) (hc : ConnectedSpace G.val.X.left)
    (hLie : ¬ HasGeometricNoncentralSemisimple G)
    (T : ClosedSubgroup (GeometricGroup G).val) (hT : IsTorus T.group) :
    ∀ χ : Character T.group, IsAdjointWeight T.inclusion χ → IsCharacterPower p χ := by
  let K := AlgebraicClosure k
  letI : CharP K p := charP_of_injective_algebraMap (algebraMap k K).injective p
  obtain ⟨N, hn, hc'⟩ := exists_geometricCentralFirstKernel normalizer p G hs hc hLie T hT
  exact adjointWeight_isPower_of_central_firstKernel (GeometricGroup G) T hT
    (torus_split_of_algClosed (closedSubgroupAlgebraicGroup T) hT) p N hn hc'

