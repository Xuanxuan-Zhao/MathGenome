private def projectLinear : E6Space →ₗ[ℝ] E6Space where
  toFun := project
  map_add' x y := by
    funext j
    change (1 / 2 : ℝ) * ((x j + y j) + (x (E6Reflection j) + y (E6Reflection j))) =
      1 / 2 * (x j + x (E6Reflection j)) + 1 / 2 * (y j + y (E6Reflection j))
    ring
  map_smul' t x := by
    funext j
    change (1 / 2 : ℝ) * (t * x j + t * x (E6Reflection j)) =
      t * (1 / 2 * (x j + x (E6Reflection j)))
    ring

private def intCoordinates : (Fin 6 → ℤ) →+ E6Space where
  toFun z j := z j
  map_zero' := by ext j; exact Int.cast_zero
  map_add' x y := by ext j; exact Int.cast_add (x j) (y j)

private theorem intCoordinates_single (i : Fin 6) :
    intCoordinates (Pi.single i 1) = Pi.single i 1 := by
  ext j
  by_cases h : j = i
  · subst j
    simp [intCoordinates]
  · simp [intCoordinates, Pi.single_eq_of_ne h]

private theorem e6_simple_mem_roots (i : Fin 6) :
    (Pi.single i 1 : E6Space) ∈ e6Roots := by
  exact ⟨_, CartanRoots.simple i, (intCoordinates_single i).symm⟩

/-- The projected coroot lattice is generated by the projected roots. -/
private theorem projectedLattice_eq_rootSpan :
    projectedLattice = (AddSubgroup.closure foldedRoots : Set E6Space) := by
  let p : (Fin 6 → ℤ) →+ E6Space := projectLinear.toAddMonoidHom.comp intCoordinates
  have hp : projectedLattice = (p.range : Set E6Space) := by
    ext x
    constructor
    · rintro ⟨_, ⟨z, rfl⟩, rfl⟩
      exact ⟨z, rfl⟩
    · rintro ⟨z, rfl⟩
      exact ⟨intCoordinates z, ⟨z, rfl⟩, rfl⟩
  rw [hp]
  congr 1
  apply le_antisymm
  · rintro _ ⟨z, rfl⟩
    have hz : z = ∑ i : Fin 6, z i • Pi.single i 1 := by
      ext j
      rw [Finset.sum_apply]
      change z j = ∑ i : Fin 6, z i * (Pi.single i (1 : ℤ) : Fin 6 → ℤ) j
      rw [Finset.sum_eq_single j]
      · simp
      · intro i _ hij
        simp [Pi.single_eq_of_ne hij.symm]
      · simp
    rw [show p z = p (∑ i : Fin 6, z i • Pi.single i 1) from congrArg p hz, map_sum]
    refine AddSubgroup.sum_mem _ fun i _ => ?_
    rw [map_zsmul]
    apply AddSubgroup.zsmul_mem
    apply AddSubgroup.subset_closure
    exact ⟨Pi.single i 1, e6_simple_mem_roots i,
      congrArg project (intCoordinates_single i).symm⟩
  · apply AddSubgroup.closure_le _ |>.mpr
    rintro _ ⟨v, ⟨r, _, rfl⟩, rfl⟩
    exact ⟨r.2, rfl⟩

private def foldedToEuclidean : E6Space →ₗ[ℝ] ExceptionalGF.Space 4 :=
  let p (i : Fin 6) : E6Space →ₗ[ℝ] ℝ := LinearMap.proj i
  let a := (1 / 2 : ℝ) • (p 0 + p 5)
  (WithLp.linearEquiv 2 ℝ (Fin 4 → ℝ)).symm.toLinearMap.comp
    (LinearMap.pi ![a, p 1 - a, p 3 - p 1 - a, p 2 + p 4 - p 3 - a])

private theorem foldedCoordinates (x : E6Space) :
    (foldedToEuclidean x).ofLp =
      ![(x 0 + x 5) / 2, x 1 - (x 0 + x 5) / 2, x 3 - x 1 - (x 0 + x 5) / 2,
        x 2 + x 4 - x 3 - (x 0 + x 5) / 2] := by
  funext j
  fin_cases j <;>
    simp [foldedToEuclidean, LinearMap.proj_apply, LinearMap.pi_apply, div_eq_inv_mul, mul_add]

private theorem foldedToEuclidean_gram (x y : E6Space)
    (hx : x ∈ foldedSpace) (hy : y ∈ foldedSpace) :
    inner ℝ (foldedToEuclidean x) (foldedToEuclidean y) = e6Inner x y := by
  have hx₀ : x 5 = x 0 := congrFun (show e6Diagram x = x from hx) 0
  have hx₂ : x 4 = x 2 := congrFun (show e6Diagram x = x from hx) 2
  have hy₀ : y 5 = y 0 := congrFun (show e6Diagram y = y from hy) 0
  have hy₂ : y 4 = y 2 := congrFun (show e6Diagram y = y from hy) 2
  rw [PiLp.inner_apply]
  change (∑ j : Fin 4, inner ℝ ((foldedToEuclidean x).ofLp j)
    ((foldedToEuclidean y).ofLp j)) = _
  rw [foldedCoordinates, foldedCoordinates]
  have sumSix (f : Fin 6 → ℝ) :
      ∑ i, f i = f 0 + (f 1 + (f 2 + (f 3 + (f 4 + f 5)))) := by
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero]
    rfl
  have sumFour (f : Fin 4 → ℝ) :
      ∑ i, f i = f 0 + (f 1 + (f 2 + f 3)) := by
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero]
    rfl
  simp only [e6Inner, sumFour, sumSix, Real.inner_apply]
  norm_num [CartanMatrix.E, Matrix.of_apply, hx₀, hx₂, hy₀, hy₂]
  ring

private theorem foldedToEuclidean_simple (i : Fin 4) :
    foldedToEuclidean (foldedSimple i) = ExceptionalGF.f4Simple (Fin.rev i) := by
  apply WithLp.ofLp_injective
  rw [foldedCoordinates]
  fin_cases i <;>
    (funext j; fin_cases j) <;>
    norm_num [foldedSimple, project, e6Diagram, E6Reflection, Equiv.swap_apply_def, Fin.rev,
      ExceptionalGF.f4Simple, ExceptionalGF.realize, Pi.single_apply]


private theorem diagram_values : ∀ i : Fin 6, E6Reflection i = (![5, 1, 4, 3, 2, 0] : Fin 6 → Fin 6) i := by
  decide

private theorem diagram_square : ∀ i : Fin 6, E6Reflection (E6Reflection i) = i := by
  decide

private theorem mem_foldedSpace (x : E6Space) :
    x ∈ foldedSpace ↔ x 5 = x 0 ∧ x 4 = x 2 := by
  change e6Diagram x = x ↔ _
  rw [funext_iff]
  constructor
  · intro h
    exact ⟨h 0, h 2⟩
  · rintro ⟨h₀, h₂⟩ i
    fin_cases i <;> simp [e6Diagram, diagram_values, h₀, h₂]


private theorem foldedToEuclidean_bijOn : Set.BijOn foldedToEuclidean foldedSpace Set.univ := by
  refine ⟨fun _ _ => Set.mem_univ _, ?_, ?_⟩
  · intro x hx y hy h
    obtain ⟨hx₀, hx₂⟩ := (mem_foldedSpace x).mp hx
    obtain ⟨hy₀, hy₂⟩ := (mem_foldedSpace y).mp hy
    have he := congrArg WithLp.ofLp h
    rw [foldedCoordinates, foldedCoordinates] at he
    have h₀ := congrFun he 0
    have h₁ := congrFun he 1
    have h₂ := congrFun he 2
    have h₃ := congrFun he 3
    simp [hx₀, hx₂, hy₀, hy₂] at h₀ h₁ h₂ h₃
    have e₀ : x 0 = y 0 := by linarith
    have e₁ : x 1 = y 1 := by linarith
    have e₂ : x 2 = y 2 := by linarith
    have e₃ : x 3 = y 3 := by linarith
    funext i; fin_cases i <;> simp_all
  · intro y _
    let a := y.ofLp 0
    let b := y.ofLp 1 + a
    let d := y.ofLp 2 + b + a
    let c := (y.ofLp 3 + d + a) / 2
    refine ⟨![a,b,c,d,c,a], (mem_foldedSpace _).mpr ⟨rfl, rfl⟩, ?_⟩
    apply WithLp.ofLp_injective
    rw [foldedCoordinates]
    funext i; fin_cases i <;> simp [b, c, d, a] <;> ring

private theorem project_apply (x : E6Space) (i : Fin 6) :
    project x i = (x i + x (E6Reflection i)) / 2 := by
  change (1 / 2 : ℝ) * (x i + x (E6Reflection i)) = _
  ring

private theorem simpleInner (i : Fin 6) (x : E6Space) :
    e6Inner (Pi.single i 1) x = ∑ j, (CartanMatrix.E 6 i j : ℝ) * x j := by
  unfold e6Inner
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    simp [Pi.single_eq_of_ne hji]
  · simp

private theorem simpleValues (x : E6Space) :
    (fun i => e6Inner (Pi.single i 1) x) =
      ![2 * x 0 - x 2, 2 * x 1 - x 3, 2 * x 2 - x 0 - x 3,
        2 * x 3 - x 1 - x 2 - x 4, 2 * x 4 - x 3 - x 5, 2 * x 5 - x 4] := by
  funext i
  fin_cases i <;>
    simp [simpleInner, CartanMatrix.E, Fin.sum_univ_succ] <;> ring

private theorem simpleValueAt (x : E6Space) (i : Fin 6) :
    e6Inner (Pi.single i 1) x =
      (![2 * x 0 - x 2, 2 * x 1 - x 3, 2 * x 2 - x 0 - x 3,
        2 * x 3 - x 1 - x 2 - x 4, 2 * x 4 - x 3 - x 5, 2 * x 5 - x 4] : E6Space) i :=
  congrFun (simpleValues x) i

private theorem inner_eq_sum (a x : E6Space) :
    e6Inner a x = ∑ i, a i * e6Inner (Pi.single i 1) x := by
  simp_rw [simpleInner]
  simp only [e6Inner, Finset.mul_sum, mul_assoc]

theorem projectionCalculation : ProjectionCalculation := by
  refine ⟨?_, ?_, ?_⟩
  · intro x
    show e6Diagram (project x) = project x
    funext i
    change project x (E6Reflection i) = project x i
    rw [project_apply, project_apply, diagram_square]
    ring
  · intro x hx
    funext i
    rw [project_apply]
    change e6Diagram x = x at hx
    rw [show x (E6Reflection i) = x i from congrFun hx i]
    ring
  · intro a x hx
    obtain ⟨hx₀, hx₂⟩ := (mem_foldedSpace x).mp hx
    rw [inner_eq_sum, inner_eq_sum]
    simp [project_apply, simpleValueAt, Fin.sum_univ_succ, diagram_values, hx₀, hx₂]
    ring

private theorem fixed_lattice_of_simple_values (y : E6Space) (hy : y ∈ foldedSpace)
    (h : ∀ j : Fin 6, ∃ m : ℤ, e6Inner (Pi.single j 1) y = (m : ℝ)) :
    y ∈ e6Lattice := by
  obtain ⟨hy₀, hy₂⟩ := (mem_foldedSpace y).mp hy
  obtain ⟨a, ha⟩ := h 0
  obtain ⟨b, hb⟩ := h 1
  obtain ⟨c, hc⟩ := h 2
  obtain ⟨d, hd⟩ := h 3
  simp [simpleValueAt, hy₂] at ha hb hc hd
  let z₀ := 2*a+b+3*c+2*d
  let z₁ := 2*a+2*b+4*c+3*d
  let z₂ := 3*a+2*b+6*c+4*d
  let z₃ := 4*a+3*b+8*c+6*d
  have e₀ : (z₀ : ℝ) = y 0 := by dsimp [z₀]; push_cast; linarith
  have e₁ : (z₁ : ℝ) = y 1 := by dsimp [z₁]; push_cast; linarith
  have e₂ : (z₂ : ℝ) = y 2 := by dsimp [z₂]; push_cast; linarith
  have e₃ : (z₃ : ℝ) = y 3 := by dsimp [z₃]; push_cast; linarith
  refine ⟨![z₀,z₁,z₂,z₃,z₂,z₀], ?_⟩
  funext i; fin_cases i <;> simp [e₀, e₁, e₂, e₃, hy₀, hy₂]

theorem involutionRange : InvolutionRange := by
  intro x hx
  constructor
  · rintro ⟨z, hz⟩ i
    refine ⟨∑ j, CartanMatrix.E 6 i j * z j, ?_⟩
    rw [← hz, simpleInner]
    push_cast
    rfl
  · intro h
    apply fixed_lattice_of_simple_values _ _ h
    obtain ⟨h₀, h₂⟩ := (mem_foldedSpace x).mp hx
    exact (mem_foldedSpace _).mpr ⟨by simp [h₀], by simp [h₂]⟩

private abbrev ZVec := Fin 6 → ℤ

private def reflectZ (i : Fin 6) (a : ZVec) : ZVec :=
  a - (∑ j, a j * CartanMatrix.E 6 j i) • Pi.single i 1

