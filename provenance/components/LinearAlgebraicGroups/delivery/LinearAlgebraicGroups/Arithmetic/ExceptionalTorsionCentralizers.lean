variable {P : SplitBorelPair ℂ}

private def rootCoordinates (U : RootSubgroupFamily P.T) (α : Root P.T) :
    RootCoordinate U α :=
  Classical.choice (rootCoordinate_exists RootData.RootGroups.rootSubgroups P.G
    P.reductive P.T P.split P.maximal U α)

private def centralizerGenerators (U : RootSubgroupFamily P.T) (t : ComplexPoints P.T.group) :
    Subgroup (ComplexPoints P.G.val) :=
  Subgroup.closure (Set.range (torusPoint (P := P)) ∪ RootGenerators U t)

private theorem scalarRoot_mem (U : RootSubgroupFamily P.T) (t : ComplexPoints P.T.group)
    (α : Root P.T) (hα : characterValue α.val R₀ t = 1) (b : ℂ) :
    rootPoint ((RootCoordinate.iso (rootCoordinates U α)).hom ≫ (U α).val.inclusion) R₀ b ∈ RootGenerators U t := by
  exact ⟨α, hα, rootPoint (RootCoordinate.iso (rootCoordinates U α)).hom R₀ b, rfl⟩

private theorem root_group_point_commute (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group) {α : Root P.T} (hα : characterValue α.val R₀ t = 1)
    {g : ComplexPoints P.G.val} (hg : g ∈ SubgroupSections (U α).val Y₀) :
    Commute (torusPoint t) g := by
  obtain ⟨p, rfl⟩ := hg
  obtain ⟨a, rfl⟩ := rootPoint_surjective (RootCoordinate.iso (rootCoordinates U α)) R₀ p
  let x := (RootCoordinate.iso (rootCoordinates U α)).hom ≫ (U α).val.inclusion
  let p : ComplexPoints P.G.val := rootPoint x R₀ a
  let p' : ComplexPoints P.G.val := rootPoint x R₀ (characterValue α.val R₀ t * a)
  have h : torusPoint t * p * (torusPoint t)⁻¹ = p' :=
    (RootCoordinate.scalar (rootCoordinates U α)) R₀ t a
  have hp : p' = p := by dsimp [p', p]; rw [hα, one_mul]
  rw [hp] at h
  change torusPoint t * p = p * torusPoint t
  simpa only [mul_assoc, inv_mul_cancel, mul_one] using congrArg (· * torusPoint t) h

private theorem conjugate_ordered_root_product (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group) (a : Root P.T → ℂ) (l : List (Root P.T)) :
    torusPoint t * (productPoint (rootCoordinates U) R₀ a l ≫ rootProduct U l : ComplexPoints P.G.val) *
      (torusPoint t)⁻¹ =
    productPoint (rootCoordinates U) R₀ (fun α => characterValue α.val R₀ t * a α) l ≫
      rootProduct U l := by
  rw [productPoint_mul, productPoint_mul]
  let c : ComplexPoints P.G.val →* ComplexPoints P.G.val := (MulAut.conj (torusPoint t)).toMonoidHom
  change c (List.map _ l).prod = (List.map _ l).prod
  rw [map_list_prod, List.map_map]
  apply congrArg List.prod
  apply List.map_congr_left
  intro α _
  exact (RootCoordinate.scalar (rootCoordinates U α)) R₀ t (a α)

private theorem ordered_root_product_centralizes (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group) {H : ClosedSubgroup P.G.val} {l : List (Root P.T)}
    (h : Parametrizes U l H.inclusion.hom.hom) (hl : l.Nodup)
    {g : ComplexPoints P.G.val} (hg : g ∈ SubgroupSections H Y₀)
    (hc : Commute (torusPoint t) g) : g ∈ centralizerGenerators U t := by
  obtain ⟨p, rfl⟩ := (rootCoordinatesRange h Y₀ g).mpr hg
  obtain ⟨a, rfl⟩ := productPoint_surjective (rootCoordinates U) R₀ l hl p
  let : Mono (rootProduct U l) := orderedProductMono h
  have he := conjugate_ordered_root_product U t a l
  rw [hc.eq, mul_assoc, mul_inv_cancel, mul_one] at he
  have ha := (productPoint_eq_iff (rootCoordinates U) R₀ _ _ l).mp
    ((cancel_mono (rootProduct U l)).mp he).symm
  rw [productPoint_mul]
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨α, hα, rfl⟩ := List.mem_map.mp hx
  by_cases hzero : a α = 0
  · rw [hzero, rootPoint_zero]
    exact (centralizerGenerators U t).one_mem
  · have hα' : characterValue α.val R₀ t = 1 :=
      mul_right_cancel₀ hzero ((ha α hα).trans (one_mul _).symm)
    exact Subgroup.subset_closure (Or.inr (scalarRoot_mem U t α hα' (a α)))

private theorem normalizes_ordered_root_product (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group) {H : ClosedSubgroup P.G.val} {l : List (Root P.T)}
    (h : Parametrizes U l H.inclusion.hom.hom) (hl : l.Nodup)
    {g : ComplexPoints P.G.val} (hg : g ∈ SubgroupSections H Y₀) :
    torusPoint t * g * (torusPoint t)⁻¹ ∈ SubgroupSections H Y₀ := by
  obtain ⟨p, rfl⟩ := (rootCoordinatesRange h Y₀ g).mpr hg
  obtain ⟨a, rfl⟩ := productPoint_surjective (rootCoordinates U) R₀ l hl p
  rw [conjugate_ordered_root_product]
  apply (rootCoordinatesRange h Y₀ _).mp
  exact ⟨_, rfl⟩

private theorem point_lifts_through_immersion {X S : SchemeOver ℂ} (f : X ⟶ S)
    [IsImmersion f.left] [LocallyOfFiniteType S.hom]
    (p : Y₀ ⟶ S) (x : X.left)
    (hx : f.left x = p.left (IsLocalRing.closedPoint ℂ)) :
    ∃ q : Y₀ ⟶ X, q ≫ f = p := by
  have hY : (Y₀).hom = 𝟙 _ := by
    change Spec.map (CommRingCat.ofHom (algebraMap ℂ ℂ)) = 𝟙 _
    rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]
  have hp : p.left ≫ S.hom = 𝟙 _ := p.w.trans hY
  have hclosed : IsClosed ({p.left (IsLocalRing.closedPoint ℂ)} : Set S.left) :=
    ((pointEquivClosedPoint S.hom) ⟨p.left, hp⟩).property
  have hpre : f.left ⁻¹' {p.left (IsLocalRing.closedPoint ℂ)} = {x} := by
    ext z
    simp only [Set.mem_preimage, Set.mem_singleton_iff, ← hx]
    exact f.left.isEmbedding.injective.eq_iff
  have hxclosed : IsClosed ({x} : Set X.left) := hpre ▸ hclosed.preimage f.left.continuous
  have : LocallyOfFiniteType X.hom := by rw [← f.w]; infer_instance
  let q : Y₀ ⟶ X := Over.homMk (pointOfClosedPoint X.hom x hxclosed)
    ((pointOfClosedPoint_comp X.hom x hxclosed).trans hY.symm)
  refine ⟨q, Over.OverMorphism.ext ?_⟩
  apply ext_of_apply_closedPoint_eq S.hom ((q ≫ f).w.trans hY) hp
  change f.left (q.left (IsLocalRing.closedPoint ℂ)) = p.left (IsLocalRing.closedPoint ℂ)
  have hq : q.left (IsLocalRing.closedPoint ℂ) = x :=
    pointOfClosedPoint_apply (K := ℂ) X.hom x hxclosed (IsLocalRing.closedPoint ℂ)
  exact (congrArg (fun a : X.left => f.left a) hq).trans hx

private theorem torus_commutes [IsCommMonObj P.T.group.X]
    (s t : ComplexPoints P.T.group) : Commute (torusPoint s) (torusPoint t) := by
  change (s ≫ P.T.inclusion.hom.hom) * (t ≫ P.T.inclusion.hom.hom) =
    (t ≫ P.T.inclusion.hom.hom) * (s ≫ P.T.inclusion.hom.hom)
  rw [← MonObj.mul_comp, ← MonObj.mul_comp, mul_comm s t]

private theorem middle_product_coordinates {X B : SchemeOver ℂ} (a : X ⟶ P.G.val.X)
    (b : B ⟶ P.G.val.X) (n : 𝟙_ (SchemeOver ℂ) ⟶ P.G.val.X)
    (p : Y₀ ⟶ X ⊗ B) :
    p ≫ ((fst X B ≫ a) * (toUnit (X ⊗ B) ≫ n) * (snd X B ≫ b)) =
      ((p ≫ fst X B ≫ a : ComplexPoints P.G.val) * (toUnit Y₀ ≫ n) *
        (p ≫ snd X B ≫ b : ComplexPoints P.G.val)) := by
  simp only [MonObj.comp_mul, comp_constant]

private theorem unique_middle_product {X B : SchemeOver ℂ} (a : X ⟶ P.G.val.X)
    (b : B ⟶ P.G.val.X) (n : 𝟙_ (SchemeOver ℂ) ⟶ P.G.val.X)
    (hmono : Mono ((fst X B ≫ a) * (toUnit (X ⊗ B) ≫ n) * (snd X B ≫ b)))
    (x x' : Y₀ ⟶ X) (y y' : Y₀ ⟶ B)
    (he : (x ≫ a : ComplexPoints P.G.val) * (toUnit Y₀ ≫ n) * (y ≫ b : ComplexPoints P.G.val) =
      (x' ≫ a : ComplexPoints P.G.val) * (toUnit Y₀ ≫ n) * (y' ≫ b : ComplexPoints P.G.val)) :
    x = x' ∧ y = y' := by
  have h : lift x y = lift x' y' := by
    apply (cancel_mono ((fst X B ≫ a) * (toUnit (X ⊗ B) ≫ n) * (snd X B ≫ b))).mp
    simpa only [middle_product_coordinates, lift_fst_assoc, lift_snd_assoc] using he
  exact ⟨by simpa using congrArg (· ≫ fst X B) h,
    by simpa using congrArg (· ≫ snd X B) h⟩

private theorem point_lifts_through_cell (Q : Presentation P.B)
    (a : ModObj P.G.val.X Q.scheme) (n : 𝟙_ (SchemeOver ℂ) ⟶ P.G.val.X)
    (A : ClosedSubgroup P.G.val) (C : Cell (T := P.T) Q a n A)
    (p : ComplexPoints P.G.val) (x : C.doubleOrbit.left)
    (hx : C.doubleOrbitInclusion.left x = p.left (IsLocalRing.closedPoint ℂ)) :
    ∃ u : Y₀ ⟶ A.group.X, ∃ b : Y₀ ⟶ P.B.group.X,
      (u ≫ A.inclusion.hom.hom : ComplexPoints P.G.val) * (toUnit Y₀ ≫ n) *
        (b ≫ P.B.inclusion.hom.hom : ComplexPoints P.G.val) = p := by
  let : LocallyOfFiniteType P.G.val.X.hom := P.G.property.2.1
  let : IsImmersion C.doubleOrbitInclusion.left := C.doubleOrbitImmersion
  obtain ⟨q, hq⟩ := point_lifts_through_immersion C.doubleOrbitInclusion p x hx
  let z := q ≫ C.doubleOrbitIso.inv
  refine ⟨z ≫ fst _ _, z ≫ snd _ _, ?_⟩
  simp only [Category.assoc]
  rw [← middle_product_coordinates (P := P) _ _ n z, ← C.doubleOrbitIso_eq]
  simpa [z] using hq

open private borelSections from LinearAlgebraicGroups.Flag.BruhatOrbitParametrization
open LinearAlgebraicGroups.CocharacterDynamics (multiplyFactors)

private theorem torus_radical_coordinates_unique
    (R : ClosedSubgroup P.B.group) (j : P.T.group ⟶ P.B.group)
    (hj : j ≫ P.B.inclusion = P.T.inclusion)
    (hiso : IsIso (multiplyFactors j R.inclusion))
    (t t' : Y₀ ⟶ P.T.group.X) (r r' : Y₀ ⟶ R.group.X)
    (eq : (t ≫ P.T.inclusion.hom.hom : ComplexPoints P.G.val) *
          (r ≫ (subgroupOfSubgroup P.B R).inclusion.hom.hom : ComplexPoints P.G.val) =
          (t' ≫ P.T.inclusion.hom.hom : ComplexPoints P.G.val) *
          (r' ≫ (subgroupOfSubgroup P.B R).inclusion.hom.hom : ComplexPoints P.G.val)) :
    t = t' ∧ r = r' := by
  let f : P.T.group.X ⊗ R.group.X ⟶ P.G.val.X :=
    multiplyFactors j R.inclusion ≫ P.B.inclusion.hom.hom
  have : IsClosedImmersion P.B.inclusion.hom.hom.left := P.B.isClosedImmersion
  have : Mono P.B.inclusion.hom.hom := Over.mono_of_mono_left _
  have : Mono f := mono_comp _ _
  have hj' : j.hom.hom ≫ P.B.inclusion.hom.hom = P.T.inclusion.hom.hom :=
    congrArg (Grp.forget (SchemeOver ℂ)).map hj
  have hf : f =
      (fst P.T.group.X R.group.X ≫ P.T.inclusion.hom.hom) *
        (snd P.T.group.X R.group.X ≫ (subgroupOfSubgroup P.B R).inclusion.hom.hom) := by
    simp only [f, multiplyFactors, MonObj.mul_comp, Category.assoc, hj']
    rfl
  have hmono : Mono ((fst P.T.group.X R.group.X ≫ P.T.inclusion.hom.hom) *
      (toUnit (P.T.group.X ⊗ R.group.X) ≫ (1 : 𝟙_ (SchemeOver ℂ) ⟶ P.G.val.X)) *
      (snd P.T.group.X R.group.X ≫ (subgroupOfSubgroup P.B R).inclusion.hom.hom)) := by
    rw [MonObj.comp_one, mul_one, ← hf]
    infer_instance
  exact unique_middle_product _ _ 1 hmono t t' r r' (by simpa only [MonObj.comp_one, mul_one] using eq)

private theorem centralizer_le_generators_and_normalizer
    [IsCommMonObj P.T.group.X] {D : Datum P.T} (I : Identification D)
    (U : RootSubgroupFamily P.T) (t : ComplexPoints P.T.group)
    (R : ClosedSubgroup P.B.group) (j : P.T.group ⟶ P.B.group)
    (hj : j ≫ P.B.inclusion = P.T.inclusion)
    (hiso : IsIso (multiplyFactors j R.inclusion))
    {Q : Presentation P.B} {a : ModObj P.G.val.X Q.scheme}
    (n : D.rootDatum.weylGroup → (𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X))
    (hn : ∀ w, IsRepresentative I w (n w))
    (A : D.rootDatum.weylGroup → ClosedSubgroup P.G.val)
    (C : ∀ w, Cell (T := P.T) Q a (n w ≫ I.normalizer.inclusion.hom.hom) (A w))
    (hcover : (⋃ w, Set.range (C w).doubleOrbitInclusion.left) = Set.univ)
    (l : List (Root P.T)) (hl : l.Nodup)
    (hR : Parametrizes U l (subgroupOfSubgroup P.B R).inclusion.hom.hom)
    (m : D.rootDatum.weylGroup → List (Root P.T)) (hm : ∀ w, (m w).Nodup)
    (hA : ∀ w, Parametrizes U (m w) (A w).inclusion.hom.hom)
    (K : Subgroup (ComplexPoints P.G.val)) (hK : centralizerGenerators U t ≤ K)
    (hnK : ∀ w, Commute (torusPoint t) (toUnit Y₀ ≫ n w ≫ I.normalizer.inclusion.hom.hom) →
      (toUnit Y₀ ≫ n w ≫ I.normalizer.inclusion.hom.hom : ComplexPoints P.G.val) ∈ K) :
    Subgroup.centralizer ({torusPoint t} : Set (ComplexPoints P.G.val)) ≤ K := by
  intro p hp
  let g (w : D.rootDatum.weylGroup) := n w ≫ I.normalizer.inclusion.hom.hom
  let z := p.left (IsLocalRing.closedPoint ℂ)
  have hz : z ∈ ⋃ w, Set.range (C w).doubleOrbitInclusion.left := hcover ▸ Set.mem_univ _
  obtain ⟨w, x, hx⟩ := Set.mem_iUnion.mp hz
  obtain ⟨u, b, hb⟩ := point_lifts_through_cell (P := P) Q a (g w) (A w) (C w) p x hx
  obtain ⟨s, hs, r, hr, hsr⟩ := (borelSections R j hj hiso Y₀ _).mp ⟨b, rfl⟩
  let v : ComplexPoints P.G.val := u ≫ (A w).inclusion.hom.hom
  have hprod : v * (toUnit Y₀ ≫ g w) * s * r = p := by rw [mul_assoc, hsr]; exact hb
  have ht : torusPoint t ∈ SubgroupSections P.T Y₀ := ⟨t, rfl⟩
  have hnorm (w : D.rootDatum.weylGroup) :
      ((toUnit Y₀ ≫ g w : ComplexPoints P.G.val)⁻¹ * torusPoint t *
        (toUnit Y₀ ≫ g w : ComplexPoints P.G.val)) ∈ SubgroupSections P.T Y₀ := by
    have he := representativeConjugation I (hn w)
    have hh := conjugateInverse_mem_torus _ _ he ht
    rw [conjugatePoint, GrpObj.comp_inv, inv_inv] at hh
    exact hh
  have hcomm : ∀ s ∈ SubgroupSections P.T Y₀, Commute (torusPoint t) s := by
    rintro _ ⟨z, rfl⟩
    exact torus_commutes t z
  have hunique (w : D.rootDatum.weylGroup) (u s r u' s' r' : ComplexPoints P.G.val)
      (hu : u ∈ SubgroupSections (A w) Y₀) (hs : s ∈ SubgroupSections P.T Y₀)
      (hr : r ∈ SubgroupSections (subgroupOfSubgroup P.B R) Y₀)
      (hu' : u' ∈ SubgroupSections (A w) Y₀) (hs' : s' ∈ SubgroupSections P.T Y₀)
      (hr' : r' ∈ SubgroupSections (subgroupOfSubgroup P.B R) Y₀)
      (he : u * (toUnit Y₀ ≫ g w) * s * r = u' * (toUnit Y₀ ≫ g w) * s' * r') :
      u = u' ∧ s = s' ∧ r = r' := by
    obtain ⟨u₀, rfl⟩ := hu
    obtain ⟨u₀', rfl⟩ := hu'
    obtain ⟨s₀, rfl⟩ := hs
    obtain ⟨s₀', rfl⟩ := hs'
    obtain ⟨r₀, rfl⟩ := hr
    obtain ⟨r₀', rfl⟩ := hr'
    obtain ⟨b₀, hb₀⟩ := (borelSections R j hj hiso Y₀ _).mpr
      ⟨_, ⟨s₀, rfl⟩, _, ⟨r₀, rfl⟩, rfl⟩
    obtain ⟨b₀', hb₀'⟩ := (borelSections R j hj hiso Y₀ _).mpr
      ⟨_, ⟨s₀', rfl⟩, _, ⟨r₀', rfl⟩, rfl⟩
    simp only [mul_assoc, ← hb₀, ← hb₀'] at he
    have : IsImmersion (C w).doubleOrbitInclusion.left := (C w).doubleOrbitImmersion
    have : Mono (C w).doubleOrbitInclusion := Over.mono_of_mono_left _
    have hmono : Mono ((fst _ _ ≫ (A w).inclusion.hom.hom) *
        (toUnit ((A w).group.X ⊗ P.B.group.X) ≫ g w) * (snd _ _ ≫ P.B.inclusion.hom.hom)) := by
      rw [← (C w).doubleOrbitIso_eq]
      infer_instance
    change ((u₀ ≫ (A w).inclusion.hom.hom : ComplexPoints P.G.val) *
      ((toUnit Y₀ ≫ g w : ComplexPoints P.G.val) * (b₀ ≫ P.B.inclusion.hom.hom))) =
      ((u₀' ≫ (A w).inclusion.hom.hom : ComplexPoints P.G.val) *
      ((toUnit Y₀ ≫ g w : ComplexPoints P.G.val) * (b₀' ≫ P.B.inclusion.hom.hom))) at he
    obtain ⟨e₁, e₂⟩ := unique_middle_product _ _ _ hmono u₀ u₀' b₀ b₀'
      (by simpa only [mul_assoc] using he)
    have hEq := hb₀.symm.trans (e₂ ▸ hb₀')
    obtain ⟨e₃, e₄⟩ := torus_radical_coordinates_unique R j hj hiso s₀ s₀' r₀ r₀' hEq
    subst u₀' s₀' r₀'
    exact ⟨rfl, rfl, rfl⟩
  have hp' : Commute (torusPoint t) (v * (toUnit Y₀ ≫ g w) * s * r) := by
    rw [hprod]
    exact ((Subgroup.mem_centralizer_singleton_iff.mp hp).symm)
  have hv : v ∈ SubgroupSections (A w) Y₀ := ⟨u, rfl⟩
  obtain ⟨hcv, hcn, hcr⟩ := bruhatFactors_commute (SubgroupSections P.T Y₀)
    (SubgroupSections (subgroupOfSubgroup P.B R) Y₀) (fun w => SubgroupSections (A w) Y₀)
    (fun w => toUnit Y₀ ≫ g w) (torusPoint t) ht hcomm hnorm
    (fun w _ h => normalizes_ordered_root_product U t (hA w) (hm w) h)
    (fun _ h => normalizes_ordered_root_product U t hR hl h) hunique hv hs hr hp'
  have hsK : s ∈ K := hK (Subgroup.subset_closure (Or.inl hs))
  have hvK := hK (ordered_root_product_centralizes U t (hA w) (hm w) hv hcv)
  have hrK := hK (ordered_root_product_centralizes U t hR hl hr hcr)
  rw [← hprod]
  exact K.mul_mem (K.mul_mem (K.mul_mem hvK (hnK w hcn)) hsK) hrK

open private evaluate_root from LinearAlgebraicGroups.Flag.BruhatCells

/-- The actual complex Bruhat strata give the point centralizer as the
subgroup generated by the torus, the roots trivial on the point, and the
centralizing normalizer points. -/
theorem bruhatCentralizer : BruhatCentralizerStatement := by
  classical
  intro P
  obtain ⟨hcomm, D, I, U, Bneg, Rpos, Rneg, c, b, _, _, _, _, _, _, hpos, hb,
    hrep, hQ, hdata⟩ :=
    Flag.BruhatCells.bruhatCells P.G P.reductive P.T P.B P.split P.maximal P.borel P.containsTorus
  let := hcomm
  let := D.finiteRoots
  have hs : ∀ α, α ∈ b.support ↔ Specs.Pinning.IsSimple P α := by
    intro α
    rw [hb.simple_iff]
    have hplus : Specs.SimpleRoots.positive D.rootDatum (Specs.SimpleRoots.evaluate D c) =
        subgroupRoots P.T P.B := by
      rw [← hpos]
      ext i
      change 0 < Specs.SimpleRoots.evaluate D c (D.rootDatum.root i) ↔
        0 < Specs.CharacterPairing.pairing P.T.group i.val c
      rw [evaluate_root]
    rw [hplus]
    simp only [Specs.Pinning.IsSimple, D.root_eq]
    rfl
  let E : Specs.Pinning.AttachedDatum P := ⟨hcomm, D, b, hs⟩
  refine ⟨E, I, U, ?_⟩
  obtain ⟨Q⟩ := hQ
  obtain ⟨a, _, hq⟩ := hdata Q
  choose n hn using hrep
  obtain ⟨A, C, hC, _, hcover, _⟩ := hq n hn
  obtain ⟨hComm', D', _, _, _, _, hdecomp⟩ :=
    RootData.BorelPositivity.borelPositivity P.G P.reductive P.T P.split P.maximal
  obtain ⟨R, j, _, _, _, hj, _, _, hiso, hR⟩ := hdecomp P.B P.borel P.containsTorus
  obtain ⟨l, hl⟩ := existsEnumeration (subgroupRoots P.T P.B)
  have hm (w : D.rootDatum.weylGroup) :
      ∃ l, Specs.OrderedRootProducts.Enumerates l
        (subgroupRoots P.T P.B ∩ (D.rootDatum.weylGroupToPerm w '' subgroupRoots P.T Bneg)) :=
    existsEnumeration _
  choose m hm using hm
  intro t
  let K := Subgroup.closure
    ((Set.range (torusPoint (P := P)) ∪ RootGenerators U t) ∪ NormalizerGenerators I t)
  refine le_antisymm ?_ ?_
  · apply centralizer_le_generators_and_normalizer I U t R j hj hiso n hn A C hcover
      l hl.1 (hR U l hl) m (fun w => (hm w).1) (fun w => (hC w).2.1 _ (hm w)) K
    · exact Subgroup.closure_mono Set.subset_union_left
    · intro w h
      apply Subgroup.subset_closure
      refine Or.inr ⟨⟨toUnit Y₀ ≫ n w, ?_⟩, h⟩
      change (toUnit Y₀ ≫ n w) ≫ I.normalizer.inclusion.hom.hom =
        toUnit Y₀ ≫ n w ≫ I.normalizer.inclusion.hom.hom
      exact Category.assoc _ _ _
  · apply (Subgroup.closure_le _).mpr
    rintro g ((⟨s, rfl⟩ | ⟨α, hα, hg⟩) | ⟨_, h⟩)
    · exact (Subgroup.mem_centralizer_singleton_iff).mpr (torus_commutes t s).eq.symm
    · exact (Subgroup.mem_centralizer_singleton_iff).mpr (root_group_point_commute U t hα hg).eq.symm
    · exact (Subgroup.mem_centralizer_singleton_iff).mpr h.eq.symm

open private rationalSectionsEquiv inducedConjugation_unique automorphism_eq_of_weight
  from LinearAlgebraicGroups.RootData.DatumAndWeyl
open private characterUnit characterValue_eq_unit characterUnit_inv rootPoint_comp
  from LinearAlgebraicGroups.RootData.RootGroups

open private rationalPointSource
  from LinearAlgebraicGroups.Arithmetic.TorsionInComplexMaximalTorus

private theorem exists_normalizerLabel [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D) :
    ∃ q : (𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X) →* D.rootDatum.weylGroup,
      ∀ n, IsRepresentative I (q n) n := by
  obtain ⟨e, he⟩ := rationalSectionsEquiv I.image.constantGroup
  let q₀ : (𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X) →*
      (𝟙_ (SchemeOver ℂ) ⟶ I.scheme.val.X) :=
    ((yonedaGrp.map I.quotient).app (.op (𝟙_ (SchemeOver ℂ)))).hom
  let q := I.labelEquiv.symm.toMonoidHom.comp (e.symm.toMonoidHom.comp q₀)
  refine ⟨q, fun n => ?_⟩
  change q₀ n = I.image.constantGroup.sectionPoint
    (I.labelEquiv (I.labelEquiv.symm (e.symm (q₀ n))))
  calc
    q₀ n = e (e.symm (q₀ n)) := (e.apply_symm_apply _).symm
    _ = I.image.constantGroup.sectionPoint (e.symm (q₀ n)) := he _
    _ = _ := congrArg I.image.constantGroup.sectionPoint (I.labelEquiv.apply_symm_apply _).symm

private def normalizerPointMap [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D) :
    (𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X) →* ComplexPoints P.G.val where
  toFun n := toUnit Y₀ ≫ n ≫ I.normalizer.inclusion.hom.hom
  map_one' := by simp only [MonObj.one_comp, MonObj.comp_one]
  map_mul' n m := by simp only [MonObj.mul_comp, MonObj.comp_mul]

private theorem normalizer_label_fixed [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D)
    {w : D.rootDatum.weylGroup} {n : 𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X}
    (hn : IsRepresentative I w n) (t : ComplexPoints P.T.group)
    (h : Commute (torusPoint t) (normalizerPointMap I n)) :
    t ≫ (I.image.conjugation (I.labelEquiv w)).hom.hom.hom = t := by
  have he := congrArg (fun f => t ≫ f) (representativeConjugation I hn)
  change t ≫ (I.image.conjugation (I.labelEquiv w)).hom.hom.hom ≫ P.T.inclusion.hom.hom =
    t ≫ conjugatePoint (n ≫ I.normalizer.inclusion.hom.hom) P.T.inclusion.hom.hom at he
  have hh : normalizerPointMap I n * torusPoint t * (normalizerPointMap I n)⁻¹ =
      torusPoint t := by
    rw [← h.eq, mul_assoc, mul_inv_cancel, mul_one]
  simp only [conjugatePoint, MonObj.comp_mul, GrpObj.comp_inv, comp_constant] at he
  change _ = normalizerPointMap I n * torusPoint t * (normalizerPointMap I n)⁻¹ at he
  rw [hh] at he
  have : IsClosedImmersion P.T.inclusion.hom.hom.left := P.T.isClosedImmersion
  have : Mono P.T.inclusion.hom.hom := Over.mono_of_mono_left _
  exact (cancel_mono P.T.inclusion.hom.hom).mp
    (by simpa only [Category.assoc, torusPoint] using he)

open private schemeKernel_sections from LinearAlgebraicGroups.Affine.SchemeImageQuotient

private theorem normalizer_kernel_mem [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D)
    {n : 𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X}
    (hn : IsRepresentative I 1 n) (U : RootSubgroupFamily P.T) (t : ComplexPoints P.T.group) :
    normalizerPointMap I n ∈ centralizerGenerators U t := by
  have hn' : n ≫ I.quotient.hom.hom = 1 := by
    simpa only [IsRepresentative, map_one] using hn
  let S : ClosedSubgroup I.normalizer.group := ⟨P.T.group, I.torusInclusion, I.torusClosed⟩
  have hS : IsSchemeKernel I.quotient S := I.isQuotient.1
  obtain ⟨s, hs⟩ := (schemeKernel_sections hS n).mpr hn'
  change s ≫ I.torusInclusion.hom.hom = n at hs
  have hi : I.torusInclusion.hom.hom ≫ I.normalizer.inclusion.hom.hom =
      P.T.inclusion.hom.hom := congrArg (Grp.forget (SchemeOver ℂ)).map I.inclusion_eq
  have he : s ≫ P.T.inclusion.hom.hom = n ≫ I.normalizer.inclusion.hom.hom := by
    rw [← hi, ← Category.assoc, hs]
  apply Subgroup.subset_closure
  left
  exact ⟨toUnit Y₀ ≫ s, (Category.assoc _ _ _).trans (congrArg (toUnit Y₀ ≫ ·) he)⟩

set_option maxHeartbeats 350000 in
private theorem rankOne_lift_mem [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D)
    (q : (𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X) →* D.rootDatum.weylGroup)
    (hq : ∀ n, IsRepresentative I (q n) n)
    (U : RootSubgroupFamily P.T) (t : ComplexPoints P.T.group)
    (α : Root P.T) (hα : characterValue α.val R₀ t = 1) :
    ∃ n, q n = RootPairing.weylGroup.ofIdx D.rootDatum α ∧
      normalizerPointMap I n ∈ centralizerGenerators U t := by
  obtain ⟨C, cochar, _, _, Dpos, Dneg, _, Q, F, PP, A, p, n, hpos, hneg, h⟩ := D.attached α
  dsimp only at h
  obtain ⟨_, _, r, hr⟩ := h
  obtain ⟨z, hz⟩ := (I.representsNormalizer _ r.representative).mp r.normalizes
  have hconj := representativeConjugation I (hq z)
  rw [hz] at hconj
  have he := inducedConjugation_unique hconj r.conjugates
  have hweight (χ : Specs.CharacterDescent.Character P.T.group) :
      (q z).val.weightEquiv (Additive.ofMul χ) =
        (RootPairing.weylGroup.ofIdx D.rootDatum α).val.weightEquiv (Additive.ofMul χ) := by
    have hpair : D.rootDatum.coroot' α (Additive.ofMul χ) =
        Specs.CharacterPairing.pairing P.T.group χ r.coroot := by
      rw [hr]
      exact D.pairing_eq χ (Additive.toMul (D.rootDatum.coroot α))
    rw [I.characterAction, I.image.characterAction, he]
    change _ = (RootPairing.Equiv.reflection D.rootDatum α).weightEquiv (Additive.ofMul χ)
    rw [RootPairing.Equiv.reflection_weightEquiv, RootPairing.reflection_apply, hpair,
      D.root_eq, r.reflection, ofMul_mul, ofMul_zpow, neg_smul, sub_eq_add_neg]
  have hqz : q z = RootPairing.weylGroup.ofIdx D.rootDatum α :=
    Subtype.ext (automorphism_eq_of_weight hweight)
  have hroot (β : Root P.T) (hβ : characterValue β.val R₀ t = 1)
      (V : ClosedSubgroup P.G.val) (hV : Specs.RootGroups.IsRootSubgroup P.T V β.val)
      (f : A.group ⟶ V.group) (a : ℂ) :
      (rootPoint (f ≫ V.inclusion) R₀ a : ComplexPoints P.G.val) ∈ centralizerGenerators U t := by
    obtain ⟨W, _, _, _, _, huniq⟩ :=
      ((RootData.RootGroups.rootSubgroups P.G P.reductive P.T P.split P.maximal).2 β.val β.property).2.2
    obtain ⟨j₁, hj₁⟩ := (huniq V hV).2
    obtain ⟨j₂, hj₂⟩ := (huniq (U β).val (U β).property).1
    apply Subgroup.subset_closure
    right
    refine ⟨β, hβ, rootPoint (f ≫ j₁ ≫ j₂) R₀ a, ?_⟩
    change rootPoint (f ≫ j₁ ≫ j₂) R₀ a ≫ (U β).val.inclusion.hom.hom = _
    have hf : (f ≫ j₁ ≫ j₂) ≫ (U β).val.inclusion = f ≫ V.inclusion := by
      simp only [Category.assoc, hj₂, hj₁]
    rw [← rootPoint_comp, hf]
  have hβroot : α.val⁻¹ ∈ Specs.CharacterPairing.absoluteRoots P.T :=
    ((((RootData.RootGroups.rootSubgroups P.G P.reductive P.T P.split P.maximal).2
      α.val α.property).2.1 α.val⁻¹).mpr (Or.inr rfl)).1
  let β : Root P.T := ⟨α.val⁻¹, hβroot⟩
  have hβ : characterValue β.val R₀ t = 1 := by
    have hunit : characterUnit α.val R₀ t = 1 :=
      Units.ext ((characterValue_eq_unit α.val R₀ t).symm.trans hα)
    change characterValue α.val⁻¹ R₀ t = 1
    rw [characterValue_eq_unit, characterUnit_inv, hunit, inv_one]
    rfl
  let fpos : A.group ⟶ (subgroupOfSubgroup C.subgroup Dpos.contracting).group := p.root.hom
  let fneg : A.group ⟶ (subgroupOfSubgroup C.subgroup Dneg.contracting).group := n.root.hom
  have hmpos := hroot α hα _ hpos fpos 1
  have hmneg := hroot β hβ _ hneg fneg (-1)
  refine ⟨z, hqz, ?_⟩
  change (toUnit Y₀ ≫ z ≫ I.normalizer.inclusion.hom.hom) ∈ centralizerGenerators U t
  have hw : toUnit Y₀ ≫ r.representative = Specs.RootGroups.rankOneWord
      (p.root.hom ≫ Dpos.contracting.inclusion ≫ C.subgroup.inclusion)
      (n.root.hom ≫ Dneg.contracting.inclusion ≫ C.subgroup.inclusion) R₀ 1 :=
    r.representative_word
  rw [hz, hw]
  change _ * _ * _ ∈ centralizerGenerators U t
  exact (centralizerGenerators U t).mul_mem
    ((centralizerGenerators U t).mul_mem hmpos hmneg) hmpos

private theorem toUnit_comp_iso_inv {C : Type*} [Category C] [CartesianMonoidalCategory C]
    {X Z : C} (e : X ≅ 𝟙_ C) (p : X ⟶ Z) :
    toUnit X ≫ e.inv ≫ p = p := by
  have he : toUnit X = e.hom := Subsingleton.elim _ _
  exact (congrArg (fun f => f ≫ e.inv ≫ p) he).trans (e.hom_inv_id_assoc p)

private theorem rationalSection_exists {X : SchemeOver ℂ} (p : Y₀ ⟶ X) :
    ∃ n : 𝟙_ (SchemeOver ℂ) ⟶ X, toUnit Y₀ ≫ n = p :=
  ⟨(rationalPointSource ℂ).inv ≫ p, toUnit_comp_iso_inv (rationalPointSource ℂ) p⟩

private theorem normalizerPoint_lift [IsCommMonObj P.T.group.X] {D : Datum P.T}
    (I : Identification D) {g : ComplexPoints P.G.val}
    (hg : g ∈ SubgroupSections I.normalizer Y₀) :
    ∃ n, normalizerPointMap I n = g := by
  obtain ⟨point, hpoint⟩ := hg
  change (point : Y₀ ⟶ I.normalizer.group.X) ≫ I.normalizer.inclusion.hom.hom = g at hpoint
  obtain ⟨n, hn⟩ := rationalSection_exists point
  refine ⟨n, ?_⟩
  change toUnit Y₀ ≫ n ≫ I.normalizer.inclusion.hom.hom = g
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (· ≫ I.normalizer.inclusion.hom.hom) hn).trans hpoint)

private theorem normalizerPoint_mem_of_fixed [IsCommMonObj P.T.group.X]
    {D : Datum P.T} (I : Identification D) (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group)
    (hw : ∀ w : D.rootDatum.weylGroup,
      t ≫ (I.image.conjugation (I.labelEquiv w)).hom.hom.hom = t →
        w ∈ Subgroup.closure {s | ∃ α : Root P.T, characterValue α.val R₀ t = 1 ∧
          s = RootPairing.weylGroup.ofIdx D.rootDatum α})
    (n : 𝟙_ (SchemeOver ℂ) ⟶ I.normalizer.group.X)
    (hn : Commute (torusPoint t) (normalizerPointMap I n)) :
    normalizerPointMap I n ∈ centralizerGenerators U t := by
  obtain ⟨q, hq⟩ := exists_normalizerLabel I
  have hmem := hw (q n) (normalizer_label_fixed I (hq n) t hn)
  refine mem_of_label_mem_closure q (normalizerPointMap I) (centralizerGenerators U t) ?_ ?_ hmem
  · intro a ha
    have ha' : IsRepresentative I 1 a :=
      Eq.mp (congrArg (fun w => IsRepresentative I w a) ha) (hq a)
    exact normalizer_kernel_mem I ha' U t
  · rintro w ⟨α, hα, hw⟩
    obtain ⟨z, hqz, hz⟩ := rankOne_lift_mem I q hq U t α hα
    exact ⟨z, hqz.trans hw.symm, hz⟩

private theorem normalizer_le_of_weylStabilizer {D : Specs.Pinning.AttachedDatum P} :
    letI := D.comm
    ∀ (I : Identification D.datum) (U : RootSubgroupFamily P.T)
      (t : ComplexPoints P.T.group), WeylStabilizer D I t →
      NormalizerGenerators I t ⊆ centralizerGenerators U t := by
  let := D.comm
  intro I U t hw g hg
  obtain ⟨n, rfl⟩ := normalizerPoint_lift I hg.1
  exact normalizerPoint_mem_of_fixed I U t (fun w => (hw w).mp) n hg.2

/-- Once the Weyl stabilizer is given by the roots trivial at the torus point,
the rank-one representatives remove the normalizer factors from the Bruhat
description of its centralizer. -/
theorem centralizerOfTorusPoint : CentralizerOfTorusPoint := by
  intro P
  obtain ⟨D, I, U, hg⟩ := bruhatCentralizer P
  let := D.comm
  refine ⟨D, I, U, fun t ht => ?_⟩
  rw [hg t]
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g (h | h)
    · exact Subgroup.subset_closure h
    · exact normalizer_le_of_weylStabilizer I U t ht h
  · exact Subgroup.closure_mono Set.subset_union_left

private theorem torusPoint_isOfFinOrder {H : AffineAlgebraicGroup ℂ}
    (hP : P.G = H) (s : ComplexPoints P.T.group) (t : ComplexPoints H.val)
    (hs : (hP ▸ torusPoint s : ComplexPoints H.val) = t)
    (ht : IsOfFinOrder t) : IsOfFinOrder s := by
  subst H
  subst t
  let f : ComplexPoints P.T.group →* ComplexPoints P.G.val :=
    ((yonedaGrp.map P.T.inclusion).app (.op Y₀)).hom
  let : IsClosedImmersion P.T.inclusion.hom.hom.left := P.T.isClosedImmersion
  let : Mono P.T.inclusion.hom.hom := Over.mono_of_mono_left _
  have hf : Function.Injective f := fun _ _ h => (cancel_mono P.T.inclusion.hom.hom).mp h
  exact hf.isOfFinOrder_iff.mp ht

open Specs.ComplexExceptionalDatum (HasExceptionalCartan)
open Specs.ExceptionalAffineCorootStabilizers (cocharacterAction congruenceGenerators)
open Specs.SimplyConnectedLattice (corootLattice)

private theorem weylStabilizer_of_torsion (inputs : ExceptionalAlcoveInputs)
    (D : Specs.Pinning.AttachedDatum P) :
    letI := D.comm
    ∀ (I : Identification D.datum) (s : ComplexPoints P.T.group),
      corootLattice D = ⊤ → HasExceptionalCartan D → IsOfFinOrder s →
      WeylStabilizer D I s := by
  let := D.comm
  let := D.datum.finiteRoots
  let := D.datum.freeCharacters
  let := D.datum.finiteCharacters
  let := D.datum.freeCocharacters
  let := D.datum.finiteCocharacters
  let := D.datum.reduced
  let := D.datum.reducedCoroots
  intro I s hlattice htype hs
  obtain ⟨d, ζ, y, hd, _, _, _, _, hw, hroot⟩ :=
    ExceptionalTorusTorsionCoordinates.torsionCoordinates D.datum I P.split s hs
  have hcong (w : D.datum.rootDatum.weylGroup) :
      (∃ a, cocharacterAction D.datum.rootDatum w y - y = (d : ℤ) • a) ↔
        w ∈ Subgroup.closure (congruenceGenerators D.datum.rootDatum d y) := by
    rcases htype with ⟨e, he⟩ | ⟨e, he⟩ | ⟨e, he⟩
    · exact ExceptionalAffineCorootStabilizers.congruenceStabilizers
        D.datum.rootDatum D.base hlattice (n := 6) (Or.inl rfl) e he _ inputs.1 d hd y w
    · exact ExceptionalAffineCorootStabilizers.congruenceStabilizers
        D.datum.rootDatum D.base hlattice (n := 7) (Or.inr (Or.inl rfl)) e he _ inputs.2.1 d hd y w
    · exact ExceptionalAffineCorootStabilizers.congruenceStabilizers
        D.datum.rootDatum D.base hlattice (n := 8) (Or.inr (Or.inr rfl)) e he _ inputs.2.2 d hd y w
  have hgenerators : congruenceGenerators D.datum.rootDatum d y =
      {v | ∃ α : Root P.T, characterValue α.val R₀ s = 1 ∧
        v = RootPairing.weylGroup.ofIdx D.datum.rootDatum α} := by
    ext v
    exact exists_congr (fun α => and_congr_left' (hroot α).symm)
  intro w
  exact (hw w).trans ((hcong w).trans (by rw [hgenerators]))

/-- The point centralizer of a finite-order point in the complexification
is generated by the actual maximal torus and the roots trivial on that point. -/
theorem torsionCentralizer : Statement := by
  intro inputs G hsimple hsc htype
  dsimp only
  intro t ht
  obtain ⟨hred, hdatum⟩ := ComplexExceptionalDatum.complexExceptionalDatum G hsimple hsc htype
  obtain ⟨P, hP, s, hs⟩ :=
    TorsionInComplexMaximalTorus.torsionInComplexMaximalTorus
      (Unipotent.baseChangedAlgebraicGroup ℂ G) hred t ht
  obtain ⟨D, I, U, hcentralizer⟩ := centralizerOfTorusPoint P
  let := D.comm
  obtain ⟨hlattice, hcartan⟩ := hdatum P hP D
  have hweyl := weylStabilizer_of_torsion inputs D I s hlattice hcartan
    (torusPoint_isOfFinOrder hP s t hs ht)
  exact ⟨P, hP, s, D, U, hs, ⟨I, hweyl⟩, hcentralizer s hweyl⟩

end

end Algebraic

end LinearAlgebraicGroups.Arithmetic.ExceptionalTorsionCentralizers
