variable {M : Type*} [Group M]

/-- A subgroup containing the kernel of a quotient contains every lift of an
element generated by labels with lifts in the subgroup. -/
theorem mem_of_label_mem_closure {W H : Type*} [Group W] [Group H] (q : M →* W)
    (f : M →* H) (K : Subgroup H) (hker : ∀ a, q a = 1 → f a ∈ K)
    {S : Set W} (hS : ∀ s ∈ S, ∃ b, q b = s ∧ f b ∈ K) {a : M}
    (ha : q a ∈ Subgroup.closure S) : f a ∈ K := by
  let L := K.comap f
  have hSL : S ⊆ L.map q := by
    intro s hs
    obtain ⟨b, hqb, hb⟩ := hS s hs
    exact ⟨b, hb, hqb⟩
  obtain ⟨b, hb, he⟩ := (Subgroup.closure_le _).mpr hSL ha
  have hab : q (a * b⁻¹) = 1 := by rw [map_mul, map_inv, he, mul_inv_cancel]
  have hprod : f (a * b⁻¹ * b) ∈ K := (map_mul f _ _).symm ▸ K.mul_mem (hker _ hab) hb
  simpa only [mul_assoc, inv_mul_cancel, mul_one] using hprod

/-- In a group with unique Bruhat coordinates, a centralizing element has
centralizing left and right radical factors, and its normalizer factor
centralizes the torus point. -/
theorem bruhatFactors_commute {W : Type*} (T R : Subgroup M)
    (A : W → Subgroup M) (n : W → M) (t : M) (ht : t ∈ T)
    (hcomm : ∀ l ∈ T, Commute t l)
    (hn : ∀ w, (n w)⁻¹ * t * n w ∈ T)
    (hA : ∀ w u, u ∈ A w → t * u * t⁻¹ ∈ A w)
    (hR : ∀ v, v ∈ R → t * v * t⁻¹ ∈ R)
    (hunique : ∀ w (u l v u' l' v' : M), u ∈ A w → l ∈ T → v ∈ R →
      u' ∈ A w → l' ∈ T → v' ∈ R →
      u * n w * l * v = u' * n w * l' * v' → u = u' ∧ l = l' ∧ v = v')
    {w : W} {u l v : M} (hu : u ∈ A w) (hl : l ∈ T) (hv : v ∈ R)
    (h : Commute t (u * n w * l * v)) :
    Commute t u ∧ Commute t (n w) ∧ Commute t v := by
  let d := (n w)⁻¹ * t * n w * t⁻¹
  have hd : d ∈ T := T.mul_mem (hn w) (T.inv_mem ht)
  have hconj : t⁻¹ * l * t = l := by
    rw [mul_assoc, ← (hcomm l hl).eq, ← mul_assoc, inv_mul_cancel, one_mul]
  have he : (t * u * t⁻¹) * n w * (d * l) * (t * v * t⁻¹) =
      u * n w * l * v := by
    calc
      _ = (t * u * n w) * (t⁻¹ * l * t) * v * t⁻¹ := by dsimp [d]; group
      _ = t * (u * n w * l * v) * t⁻¹ := by rw [hconj]; group
      _ = _ := by rw [h.eq, mul_assoc (u * n w * l * v), mul_inv_cancel, mul_one]
  obtain ⟨heu, hel, hev⟩ :=
    hunique w _ _ _ _ _ _ (hA w u hu) (T.mul_mem hd hl) (hR v hv) hu hl hv he
  have hd1 : d = 1 := mul_right_cancel (hel.trans (one_mul l).symm)
  have hn' : (n w)⁻¹ * t * n w = t := by
    simpa only [d, mul_assoc, inv_mul_cancel, mul_one, one_mul]
      using congrArg (· * t) hd1
  refine ⟨?_, ?_, ?_⟩
  · change t * u = u * t
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using congrArg (· * t) heu
  · change t * n w = n w * t
    simpa only [← mul_assoc, mul_inv_cancel, one_mul] using congrArg (n w * ·) hn'
  · change t * v = v * t
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using congrArg (· * t) hev

end Group

