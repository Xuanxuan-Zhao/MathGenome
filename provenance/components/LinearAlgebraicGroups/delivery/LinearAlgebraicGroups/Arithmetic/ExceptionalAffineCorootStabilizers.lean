variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {W : Type*} [Group W] [MulAction W E] {Idx κ : Type*}

/-- The open half-space intersection specified by the bounding walls. -/
private def chamber (walls : Idx → E →ᵃ[ℝ] ℝ) (facet : κ → Idx) : Set E :=
  {x | ∀ i, 0 < walls (facet i) x}

/-- The corresponding closed half-space intersection. -/
private def closedChamber (walls : Idx → E →ᵃ[ℝ] ℝ) (facet : κ → Idx) : Set E :=
  {x | ∀ i, 0 ≤ walls (facet i) x}

/-- A point is off all walls in the arrangement. -/
private def regular (walls : Idx → E →ᵃ[ℝ] ℝ) (x : E) : Prop :=
  ∀ i, walls i x ≠ 0

/-- The affine point stabilizer is generated by reflections in the walls
through the point. The assumptions express the geometric properties of an
alcove and its affine reflection action. -/
private def AffineWallStabilizers (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E]
    (W : Type*) [Group W] [MulAction W E] (Idx κ : Type*) [Finite κ] : Prop :=
  ∀ (walls : Idx → E →ᵃ[ℝ] ℝ) (facet : κ → Idx) (reflection : Idx → W),
    (∀ w : W, Isometry (fun x : E => w • x)) →
    (∀ i, Continuous (walls i)) →
    (∀ i x, walls i x = 0 → reflection i • x = x) →
    (∀ i x y, walls i x < 0 → 0 < walls i y → dist (reflection i • x) y < dist x y) →
    (∀ (w : W) x, regular walls (w • x) ↔ regular walls x) →
    (∀ (w : W) (i : Idx) x, walls i (w • x) = 0 →
      ∃ j, walls j x = 0 ∧ reflection i = w * reflection j * w⁻¹) →
    (∀ (x y : E) (R : ℝ), {u : E | (∃ w : W, w • x = u) ∧ dist u y ≤ R}.Finite) →
    (chamber walls facet).Nonempty →
    (∀ x ∈ chamber walls facet, regular walls x) →
    (∀ (w : W), w • chamber walls facet = chamber walls facet → w = 1) →
    ∀ x : E, MulAction.stabilizer W x =
      Subgroup.closure {s | ∃ i, walls i x = 0 ∧ s = reflection i}

end Affine

section Affine

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {W : Type*} [Group W] [MulAction W E] {Idx κ : Type*}
  {walls : Idx → E →ᵃ[ℝ] ℝ} {facet : κ → Idx}

private theorem chamber_convex : Convex ℝ (chamber walls facet) := by
  intro x hx y hy a b ha hb hab i
  have hab' : 1 - b = a := by linarith
  change 0 < walls (facet i) (a • x + b • y)
  rw [← hab', ← AffineMap.lineMap_apply_module, AffineMap.apply_lineMap,
    AffineMap.lineMap_apply_ring, hab']
  by_cases hb' : b = 0
  · subst b
    simp at hab
    simpa [hab] using hx i
  · exact add_pos_of_nonneg_of_pos (mul_nonneg ha (hx i).le)
      (mul_pos (lt_of_le_of_ne hb (Ne.symm hb')) (hy i))

private theorem closedChamber_subset_closure
    (hne : (chamber walls facet).Nonempty) :
    closedChamber walls facet ⊆ closure (chamber walls facet) := by
  intro x hx
  obtain ⟨y, hy⟩ := hne
  let line : ℝ → E := AffineMap.lineMap x y
  have hcontinuous : Continuous line := by
    change Continuous (fun t : ℝ => t • (y - x) + x)
    exact (continuous_id.smul continuous_const).add continuous_const
  have hzero : (0 : ℝ) ∈ closure (Set.Ioc 0 1) := by
    rw [closure_Ioc zero_ne_one]
    exact ⟨le_rfl, zero_le_one⟩
  have hline : line '' Set.Ioc 0 1 ⊆ chamber walls facet := by
    rintro z ⟨r, hr, rfl⟩ i
    change 0 < walls (facet i) (AffineMap.lineMap x y r)
    rw [AffineMap.apply_lineMap, AffineMap.lineMap_apply_ring]
    exact add_pos_of_nonneg_of_pos (mul_nonneg (sub_nonneg.mpr hr.2) (hx i))
      (mul_pos hr.1 (hy i))
  have hmaps : Set.MapsTo line (Set.Ioc 0 1) (chamber walls facet) :=
    Set.mapsTo_iff_image_subset.mpr hline
  simpa [line] using map_mem_closure hcontinuous hzero hmaps

private theorem smul_chamber_eq_of_mem
    (hisom : ∀ w : W, Isometry (fun x : E => w • x))
    (hcont : ∀ i, Continuous (walls i))
    (hreg : ∀ x ∈ chamber walls facet, regular walls x)
    (hpres : ∀ (w : W) x, regular walls (w • x) ↔ regular walls x)
    (w : W) {y : E} (hy : y ∈ chamber walls facet) (hwy : w • y ∈ chamber walls facet) :
    w • chamber walls facet = chamber walls facet := by
  have hsub (g : W) {p : E} (hp : p ∈ chamber walls facet)
      (hgp : g • p ∈ chamber walls facet) : g • chamber walls facet ⊆ chamber walls facet := by
    have hconn : IsPreconnected (g • chamber walls facet) :=
      chamber_convex.isPreconnected.image _ (hisom g).continuous.continuousOn
    intro z hz i
    apply hconn.lt_of_ne (hcont (facet i)).continuousOn
    · rintro a ⟨b, hb, rfl⟩
      exact (hpres g b).2 (hreg b hb) (facet i)
    · exact ⟨g • p, Set.smul_mem_smul_set hp, hgp i⟩
    · exact hz
  apply Set.Subset.antisymm (hsub w hy hwy)
  have hi : w⁻¹ • (w • y) ∈ chamber walls facet := by simpa
  have h := Set.smul_set_mono (a := w) (hsub w⁻¹ hwy hi)
  simpa [smul_smul] using h

omit [NormedSpace ℝ E] in
private theorem exists_dist_minimizing_smul
    (K : Subgroup W)
    (hfinite : ∀ x y : E, ∀ R : ℝ,
      {u | (∃ w : W, w • x = u) ∧ dist u y ≤ R}.Finite)
    (x y : E) :
    ∃ g : K, ∀ h : K, dist (g.val • x) y ≤ dist (h.val • x) y := by
  let A : Set E := {u | (∃ g : K, g.val • x = u) ∧ dist u y ≤ dist x y}
  have hA : A.Finite := (hfinite x y (dist x y)).subset (by
    rintro a ⟨⟨g, hg⟩, hd⟩
    exact ⟨⟨g.val, hg⟩, hd⟩)
  have hx : x ∈ A := ⟨⟨1, one_smul W x⟩, le_rfl⟩
  obtain ⟨z, ⟨⟨g, rfl⟩, hd⟩, hmin⟩ := Set.exists_min_image A (fun u => dist u y) hA ⟨x, hx⟩
  refine ⟨g, fun h => ?_⟩
  by_cases hh : dist (h.val • x) y ≤ dist x y
  · exact hmin _ ⟨⟨h, rfl⟩, hh⟩
  · exact hd.trans (le_of_not_ge hh)

/-- Nearest points in the full orbit give a closed-alcove representative.
Minimizing again using only reflections through that point brings a nearby
regular point into the open alcove. -/
private theorem affineWallStabilizers [Finite κ] :
    AffineWallStabilizers E W Idx κ := by
  classical
  intro walls facet reflection hisom hcont hfix hcloser hpres hconj hfinite hne hreg hfree
  let generators (x : E) : Set W := {s | ∃ i, walls i x = 0 ∧ s = reflection i}
  have hle (x : E) : Subgroup.closure (generators x) ≤ MulAction.stabilizer W x :=
    (Subgroup.closure_le _).mpr (by
      rintro _ ⟨i, hi, rfl⟩
      exact hfix i x hi)
  have hclosed (x : E) (hx : x ∈ closedChamber walls facet) :
      MulAction.stabilizer W x ≤ Subgroup.closure (generators x) := by
    let K := Subgroup.closure (generators x)
    let V : κ → Set E := fun i =>
      if walls (facet i) x = 0 then Set.univ else {z | 0 < walls (facet i) z}
    have hV : IsOpen (⋂ i, V i) := isOpen_iInter_of_finite (by
      intro i
      dsimp [V]
      split_ifs
      · exact isOpen_univ
      · exact isOpen_lt continuous_const (hcont (facet i)))
    have hxV : x ∈ ⋂ i, V i := by
      refine Set.mem_iInter.mpr (fun i => ?_)
      dsimp [V]
      split_ifs with hi
      · exact Set.mem_univ _
      · exact lt_of_le_of_ne (hx i) (Ne.symm hi)
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhds_iff.mp (hV.mem_nhds hxV)
    obtain ⟨y, hy, hxy⟩ := Metric.mem_closure_iff.mp
      (closedChamber_subset_closure hne hx) ε hε
    intro g hg
    change g • x = x at hg
    obtain ⟨k, hk⟩ := exists_dist_minimizing_smul K hfinite (g • y) y
    let z := k.val • (g • y)
    have hfixK : k.val • x = x := hle x k.property
    have hzball : z ∈ Metric.ball x ε := by
      have hdist : dist x z = dist x y := calc
        dist x z = dist (k.val • x) (k.val • (g • y)) := by rw [hfixK]
        _ = dist x (g • y) := (hisom k.val).dist_eq _ _
        _ = dist (g • x) (g • y) := by rw [hg]
        _ = dist x y := (hisom g).dist_eq _ _
      rw [Metric.mem_ball, dist_comm, hdist]
      exact hxy
    have hzreg : regular walls z := (hpres _ _).2 ((hpres _ _).2 (hreg _ hy))
    have hz : z ∈ chamber walls facet := by
      intro i
      by_contra! hn
      have hn' : walls (facet i) z < 0 := lt_of_le_of_ne hn (hzreg _)
      have hi : walls (facet i) x = 0 := by
        by_contra hi
        have hv := Set.mem_iInter.mp (hball hzball) i
        simp only [V, ite_eq_right hi] at hv
        exact (not_lt_of_ge hn) hv
      let r : K := ⟨reflection (facet i), Subgroup.subset_closure ⟨facet i, hi, rfl⟩⟩
      have hlt := hcloser (facet i) z y hn' (hy i)
      have hmin := hk (r * k)
      change dist z y ≤ dist ((reflection (facet i) * k.val) • (g • y)) y at hmin
      rw [mul_smul] at hmin
      exact (not_lt_of_ge hmin) hlt
    have hkg : (k.val * g) • y ∈ chamber walls facet := by rwa [mul_smul]
    have h1 := hfree _ (smul_chamber_eq_of_mem hisom hcont hreg hpres _ hy hkg)
    exact (eq_inv_of_mul_eq_one_right h1) ▸ K.inv_mem k.property
  intro x
  refine le_antisymm (fun g hg => ?_) (hle x)
  obtain ⟨b, hb⟩ := hne
  obtain ⟨a, ha⟩ := exists_dist_minimizing_smul (⊤ : Subgroup W) hfinite x b
  let y := a.val • x
  have hy : y ∈ closedChamber walls facet := by
    intro i
    by_contra! hneg
    have hlt := hcloser _ y b hneg (hb i)
    let r : (⊤ : Subgroup W) := ⟨reflection (facet i), Subgroup.mem_top _⟩
    have hmin := ha (r * a)
    change dist y b ≤ dist ((reflection (facet i) * a.val) • x) b at hmin
    rw [mul_smul] at hmin
    exact (not_lt_of_ge hmin) hlt
  have hg' : a.val * g * a.val⁻¹ ∈ MulAction.stabilizer W y := by
    change (a.val * g * a.val⁻¹) • (a.val • x) = a.val • x
    rw [mul_smul, inv_smul_smul, mul_smul, (show g • x = x from hg)]
  let conjBack : W →* W := (MulAut.conj a.val⁻¹).toMonoidHom
  have hmap : Subgroup.closure (generators y) ≤
      (Subgroup.closure (generators x)).comap conjBack := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨j, hj, he⟩ := hconj a.val i x hi
    apply Subgroup.subset_closure
    refine ⟨j, hj, ?_⟩
    change a.val⁻¹ * reflection i * (a.val⁻¹)⁻¹ = reflection j
    rw [he]
    group
  have h := hmap (hclosed y hy hg')
  change a.val⁻¹ * (a.val * g * a.val⁻¹) * (a.val⁻¹)⁻¹ ∈ Subgroup.closure (generators x) at h
  simpa [mul_assoc] using h

end Affine

/-- All positive roots lie between zero and the highest-root value when
every simple-root value is strictly positive. -/
private theorem root_value_lt_one {n : ℕ} {m p : Fin n → ℤ} {v : Fin n → ℝ}
    (hpos : ∀ i, 0 < v i) (hp : ∀ i, 0 ≤ p i) (hp₀ : p ≠ 0) (hpm : ∀ i, p i ≤ m i)
    (hm : (∑ i, (m i : ℝ) * v i) < 1) :
    0 < (∑ i, (p i : ℝ) * v i) ∧ (∑ i, (p i : ℝ) * v i) < 1 := by
  classical
  have hterm (i : Fin n) : 0 ≤ (p i : ℝ) * v i :=
    mul_nonneg (by exact_mod_cast hp i) (hpos i).le
  have hnonzero : ∃ i, p i ≠ 0 := by
    by_contra! h
    exact hp₀ (funext h)
  obtain ⟨i, hi⟩ := hnonzero
  have hpi : 0 < p i := lt_of_le_of_ne (hp i) (Ne.symm hi)
  refine ⟨lt_of_lt_of_le (mul_pos (Int.cast_pos.mpr hpi) (hpos i))
    (Finset.single_le_sum (fun j _ => hterm j) (Finset.mem_univ i)), ?_⟩
  exact lt_of_le_of_lt (Finset.sum_le_sum (fun j _ =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hpm j) (hpos j).le)) hm

/-- Integral simple-root values in the closed alcove are either all zero or
satisfy the equations for one of its nonzero vertices. -/
private theorem integral_closed_alcove_values {n : ℕ} {m v : Fin n → ℤ}
    (hm : ∀ i, 0 < m i) (hv : ∀ i, 0 ≤ v i)
    (hbound : (∑ i, m i * v i) ≤ 1) :
    v = 0 ∨ ∃ i, ∀ j, m i * v j = (Pi.single i 1 : Fin n → ℤ) j := by
  classical
  by_cases hz : v = 0
  · exact Or.inl hz
  have hnonzero : ∃ i, v i ≠ 0 := by
    by_contra! h
    exact hz (funext h)
  obtain ⟨i, hi⟩ := hnonzero
  have hterm (j : Fin n) : 0 ≤ m j * v j := mul_nonneg (hm j).le (hv j)
  have hiPos : 0 < v i := lt_of_le_of_ne (hv i) (Ne.symm hi)
  have hmi : (1 : ℤ) ≤ m i * v i :=
    Int.add_one_le_iff.mpr (mul_pos (hm i) hiPos)
  have hsplit := Finset.sum_erase_add (s := Finset.univ) (fun j => m j * v j)
    (Finset.mem_univ i)
  have hrest : ∑ j ∈ Finset.univ.erase i, m j * v j = 0 := by
    have hnonneg := Finset.sum_nonneg (fun j _ => hterm j : ∀ j ∈ Finset.univ.erase i, _)
    omega
  have hvertex : m i * v i = 1 := by omega
  refine Or.inr ⟨i, fun j => ?_⟩
  by_cases he : j = i
  · subst j
    simpa using hvertex
  · have hj : j ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨he, Finset.mem_univ j⟩
    have hvzero := (Finset.single_le_sum (fun k _ => hterm k) hj).trans_eq hrest
    have hjzero : v j = 0 := by
      by_contra hne
      exact (not_lt_of_ge hvzero) (mul_pos (hm j) (lt_of_le_of_ne (hv j) (Ne.symm hne)))
    simp [Pi.single_eq_of_ne he, hjzero]

/-- The vertex equations in the exceptional input exclude every nonzero
vector of integral simple-root values in the closed alcove. -/
private theorem exceptional_integral_simple_values {n : ℕ} {m x : Fin n → ℤ}
    (h : HighestRootAndVertices m)
    (hpos : ∀ j, 0 ≤ ∑ k, (x k : ℝ) * (CartanMatrix.E n k j : ℝ))
    (hbound : ∑ j, (m j : ℝ) * (∑ k, (x k : ℝ) * (CartanMatrix.E n k j : ℝ)) ≤ 1) :
    ∀ j, (∑ k, (x k : ℝ) * (CartanMatrix.E n k j : ℝ)) = 0 := by
  classical
  let v (j : Fin n) : ℤ := ∑ k, x k * CartanMatrix.E n k j
  have hv (j : Fin n) : (v j : ℝ) = ∑ k, (x k : ℝ) * (CartanMatrix.E n k j : ℝ) := by
    simp [v]
  simp only [← hv] at hpos hbound ⊢
  have hbound' : ∑ j, m j * v j ≤ 1 := by exact_mod_cast hbound
  have hpos' (j : Fin n) : 0 ≤ v j := by exact_mod_cast hpos j
  rcases integral_closed_alcove_values h.1 hpos' hbound' with hzero | ⟨i, hi⟩
  · intro j
    simp [hzero]
  · exfalso
    apply h.2.2.2 i x
    intro j
    rw [← hv]
    by_cases hji : j = i
    · subst j
      have hh := hi i
      simp only [Pi.single_eq_same] at hh ⊢
      exact_mod_cast hh
    · have hh := hi j
      simp only [Pi.single_eq_of_ne hji] at hh ⊢
      exact_mod_cast hh

section Action

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
variable (Q : RootDatum ι X Y)

private theorem latticeMap_injective [Module.Free ℤ Y] :
    Function.Injective (latticeMap (Y := Y)) :=
  latticeEmbedding_injective

@[simp] private theorem realAction_lattice (w : Q.weylGroup) (y : Y) :
    realAction Q w (latticeMap y) = latticeMap (cocharacterAction Q w y) := rfl

@[simp] private theorem rootValue_lattice (i : ι) (y : Y) :
    rootValue Q i (latticeMap y) = (Q.toLinearMap (Q.root i) y : ℝ) :=
  extendFunctional_one_tmul ℝ (Q.root' i) y

@[simp] private theorem realAction_one (x : Space Y) : realAction Q 1 x = x := by
  change ((cocharacterAction Q 1).toLinearMap.baseChange ℝ) x = x
  rw [map_one]
  exact congrArg (fun f : Module.End ℝ (Space Y) => f x)
    (LinearMap.baseChange_one ℤ Y (A := ℝ))

private theorem realAction_mul (v w : Q.weylGroup) (x : Space Y) :
    realAction Q (v * w) x = realAction Q v (realAction Q w x) := by
  change ((cocharacterAction Q (v * w)).toLinearMap.baseChange ℝ) x = _
  rw [map_mul]
  exact congrArg (fun f : Module.End ℝ (Space Y) => f x)
    (LinearMap.baseChange_mul (A := ℝ) (cocharacterAction Q v).toLinearMap
      (cocharacterAction Q w).toLinearMap)

private theorem latticeAction_coroot (w : Q.weylGroup) (i : ι) :
    cocharacterAction Q w (Q.coroot i) = Q.coroot (Q.weylGroupToPerm w i) := by
  change w.val.coweightEquiv.symm (Q.coroot i) = Q.coroot (w.val.indexEquiv i)
  apply w.val.coweightEquiv.injective
  simp [RootPairing.Equiv.coweightEquiv_apply, RootPairing.Hom.coroot_coweightMap_apply]

private theorem tmul_eq_lattice_smul (r : ℝ) (y : Y) :
    r ⊗ₜ[ℤ] y = r • latticeMap y :=
  TensorProduct.tmul_eq_smul_one_tmul r y

private theorem rootValue_action (w : Q.weylGroup) (i : ι) (x : Space Y) :
    rootValue Q (Q.weylGroupToPerm w i) (realAction Q w x) = rootValue Q i x := by
  suffices h : (rootValue Q (Q.weylGroupToPerm w i)).comp (realAction Q w).toLinearMap =
      rootValue Q i from LinearMap.congr_fun h x
  apply TensorProduct.AlgebraTensorModule.ext
  intro r y
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  change rootValue Q (Q.weylGroupToPerm w i) (r ⊗ₜ[ℤ] cocharacterAction Q w y) =
    rootValue Q i (r ⊗ₜ[ℤ] y)
  simp only [tmul_eq_lattice_smul, map_smul, rootValue_lattice]
  exact congrArg (fun q : ℤ => r • (q : ℝ)) (w.val.root'_coweightEquiv i y)

private theorem cocharacterAction_reflection (i : ι) :
    cocharacterAction Q (RootPairing.weylGroup.ofIdx Q i) = Q.coreflection i := by
  change (RootPairing.Equiv.reflection Q i).coweightEquiv.symm = _
  rw [RootPairing.Equiv.reflection_coweightEquiv]
  exact Module.reflection_symm _

private theorem realAction_reflection (i : ι) (x : Space Y) :
    realAction Q (RootPairing.weylGroup.ofIdx Q i) x =
      x - rootValue Q i x • latticeMap (Q.coroot i) := by
  let f : Space Y →ₗ[ℝ] Space Y :=
    LinearMap.id - (rootValue Q i).smulRight (latticeMap (Q.coroot i))
  suffices h : (realAction Q (RootPairing.weylGroup.ofIdx Q i)).toLinearMap = f from
    LinearMap.congr_fun h x
  apply TensorProduct.AlgebraTensorModule.ext
  intro r y
  change r ⊗ₜ[ℤ] (cocharacterAction Q (RootPairing.weylGroup.ofIdx Q i) y) = f (r ⊗ₜ[ℤ] y)
  rw [tmul_eq_lattice_smul, tmul_eq_lattice_smul, map_smul, cocharacterAction_reflection, RootPairing.coreflection_apply,
    map_sub, map_smul, smul_sub]
  simp [f, rootValue_lattice, RootPairing.root', ← Int.cast_smul_eq_zsmul ℝ, smul_sub]

theorem wallReflectionFormula : WallReflectionFormula := by
  intro ι X Y _ _ Q i k x
  change latticeMap (k • Q.coroot i) + realAction Q (RootPairing.weylGroup.ofIdx Q i) x = _
  rw [realAction_reflection, map_smul, ← Int.cast_smul_eq_zsmul ℝ, sub_smul]
  abel

private theorem affine_action_faithful [Module.Free ℤ Y] {v w : AffineWeylGroup Q}
    (h : ∀ x : Space Y, v • x = w • x) : v = w := by
  have hleft : v.left = w.left := by
    apply Multiplicative.toAdd.injective
    apply latticeMap_injective
    have hh := h 0
    change latticeMap v.left.toAdd + realAction Q v.right 0 =
      latticeMap w.left.toAdd + realAction Q w.right 0 at hh
    simpa only [map_zero, add_zero] using hh
  have hright : v.right = w.right := by
    apply Subtype.ext
    apply RootPairing.Equiv.coweightHom_injective Q
    apply MulOpposite.unop_injective
    change v.right.val.coweightEquiv = w.right.val.coweightEquiv
    suffices he : v.right.val.coweightEquiv.symm = w.right.val.coweightEquiv.symm by
      simpa using congrArg LinearEquiv.symm he
    ext y
    apply latticeMap_injective
    have hh := h (latticeMap y)
    change latticeMap v.left.toAdd + realAction Q v.right (latticeMap y) =
      latticeMap w.left.toAdd + realAction Q w.right (latticeMap y) at hh
    rw [hleft, realAction_lattice, realAction_lattice, add_right_inj] at hh
    exact hh
  exact SemidirectProduct.ext hleft hright

private theorem rootValue_affine (g : AffineWeylGroup Q) (i : ι) (x : Space Y) :
    rootValue Q (Q.weylGroupToPerm g.right i) (g • x) =
      (Q.toLinearMap (Q.root (Q.weylGroupToPerm g.right i)) g.left.toAdd : ℝ) +
        rootValue Q i x := by
  change rootValue Q _ (latticeMap g.left.toAdd + realAction Q g.right x) = _
  rw [map_add, rootValue_lattice, rootValue_action]

private theorem conjugate_wall [Module.Free ℤ Y] (g : AffineWeylGroup Q) (i : ι) (k : ℤ) :
    g * wallReflection Q i k * g⁻¹ =
      wallReflection Q (Q.weylGroupToPerm g.right i)
        (k + Q.toLinearMap (Q.root (Q.weylGroupToPerm g.right i)) g.left.toAdd) := by
  apply affine_action_faithful Q
  intro x
  obtain ⟨z, rfl⟩ := MulAction.surjective g x
  rw [mul_smul, inv_smul_smul, mul_smul, wallReflectionFormula, wallReflectionFormula,
    rootValue_affine, Int.cast_add]
  change latticeMap g.left.toAdd +
      realAction Q g.right (z - (rootValue Q i z - (k : ℝ)) • latticeMap (Q.coroot i)) =
    (latticeMap g.left.toAdd + realAction Q g.right z) - _ • _
  rw [map_sub, map_smul, realAction_lattice, latticeAction_coroot]
  rw [show (Q.toLinearMap (Q.root (Q.weylGroupToPerm g.right i)) g.left.toAdd : ℝ) +
    rootValue Q i z - ((k : ℝ) +
      Q.toLinearMap (Q.root (Q.weylGroupToPerm g.right i)) g.left.toAdd) =
      rootValue Q i z - k by ring]
  abel

end Action

section Projection

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
variable (Q : RootDatum ι X Y)

private theorem divided_lift [Module.Free ℤ Y] {d : ℕ} (hd : 0 < d)
    (y : Y) (w : Q.weylGroup) :
    w ∈ (MulAction.stabilizer (AffineWeylGroup Q) ((d : ℝ)⁻¹ • latticeMap y)).map
      SemidirectProduct.rightHom ↔
      ∃ a : Y, cocharacterAction Q w y - y = (d : ℤ) • a := by
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have he (a : Y) :
      (⟨Multiplicative.ofAdd a, w⟩ : AffineWeylGroup Q) • ((d : ℝ)⁻¹ • latticeMap y) =
        (d : ℝ)⁻¹ • latticeMap y ↔
      cocharacterAction Q w y - y = (d : ℤ) • (-a) := by
    change latticeMap a + realAction Q w ((d : ℝ)⁻¹ • latticeMap y) = _ ↔ _
    rw [map_smul, realAction_lattice]
    rw [← (smul_right_injective (Space Y) hd').eq_iff, smul_add, smul_smul, smul_smul,
      mul_inv_cancel₀ hd', one_smul, one_smul]
    rw [← Int.cast_natCast (R := ℝ) d, Int.cast_smul_eq_zsmul, ← map_smul, ← map_add,
      latticeMap_injective.eq_iff]
    constructor <;> intro h <;> rw [smul_neg] at *
    · calc
        cocharacterAction Q w y - y =
            cocharacterAction Q w y - ((d : ℤ) • a + cocharacterAction Q w y) := by rw [h]
        _ = -((d : ℤ) • a) := by abel
    · apply (eq_of_sub_eq_zero _)
      calc
        (d : ℤ) • a + cocharacterAction Q w y - y =
          (d : ℤ) • a + (cocharacterAction Q w y - y) := by abel
        _ = 0 := by rw [h, add_neg_cancel]
  constructor
  · rintro ⟨⟨a, w'⟩, h, rfl⟩
    exact ⟨-a.toAdd, (he a.toAdd).mp h⟩
  · rintro ⟨a, ha⟩
    exact ⟨⟨Multiplicative.ofAdd (-a), w⟩, (he (-a)).mpr (by simpa using ha), rfl⟩

private theorem projected_generators {d : ℕ} (hd : 0 < d) (y : Y) :
    SemidirectProduct.rightHom '' wallGenerators Q ((d : ℝ)⁻¹ • latticeMap y) =
      congruenceGenerators Q d y := by
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have he (i : ι) (k : ℤ) :
      rootValue Q i ((d : ℝ)⁻¹ • latticeMap y) = (k : ℝ) ↔
        Q.toLinearMap (Q.root i) y = (d : ℤ) * k := by
    rw [map_smul, rootValue_lattice, smul_eq_mul, ← div_eq_inv_mul, div_eq_iff hd']
    norm_cast
    rw [mul_comm]
  ext w
  constructor
  · rintro ⟨g, ⟨i, k, hk, rfl⟩, rfl⟩
    exact ⟨i, ⟨k, (he i k).mp hk⟩, rfl⟩
  · rintro ⟨i, ⟨k, hk⟩, rfl⟩
    exact ⟨wallReflection Q i k, ⟨i, k, (he i k).mpr hk, rfl⟩, rfl⟩

theorem stabilizerTranslation : StabilizerTranslation := by
  intro ι X Y _ _ Q x g hg
  change latticeMap g.left.toAdd + realAction Q g.right x = x at hg
  exact eq_sub_of_add_eq hg

end Projection

section Coordinates

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
variable (Q : RootDatum ι X Y) (B : Q.Base) {n : ℕ}
variable (e : B.support ≃ Fin n)

private abbrev simpleIndex (i : Fin n) : ι := (e.symm i).val

private theorem cartanRoots_matrix {A : Matrix (Fin n) (Fin n) ℤ}
    (hA : ∀ i j, A i j = A j i) {p} (hp : CartanRoots A p) :
    p.1 = A *ᵥ p.2 := by
  induction hp with
  | simple i =>
    change Specs.AbsoluteDynkinTypes.simpleCharacter A i = A *ᵥ Pi.single i 1
    rw [Matrix.mulVec_single_one]
    rfl
  | neg _ ih => simp [Matrix.mulVec_neg, ih]
  | @reflect i p hp ih =>
    simp only [Specs.AbsoluteDynkinTypes.reflectCoordinates, Matrix.mulVec_sub,
      Matrix.mulVec_smul, Matrix.mulVec_single_one]
    rw [← ih]
    congr 1
    have hcoeff : p.1 i = ∑ j, p.2 j * A j i := by
      rw [ih]
      simp [Matrix.mulVec, dotProduct, hA i, mul_comm]
    rw [hcoeff]
    rfl

private theorem exceptional_cartan_symmetric (hn : n = 6 ∨ n = 7 ∨ n = 8) :
    ∀ i j, CartanMatrix.E n i j = CartanMatrix.E n j i := by
  intro i j
  unfold CartanMatrix.E
  simp only [Matrix.of_apply, eq_comm (a := i) (b := j)]
  congr 1
  split_ifs <;> first | rfl | tauto

private theorem coroot_coordinate_sign (c : Basis (Fin n) ℤ Y)
    (hc : ∀ i, c i = Q.coroot (simpleIndex Q B e i)) (a : ι) :
    (∀ i, 0 ≤ c.equivFun (Q.coroot a) i) ∨ (∀ i, c.equivFun (Q.coroot a) i ≤ 0) := by
  classical
  let B' : Q.flip.Base := B.flip
  obtain ⟨f, _, hs, hf⟩ := B'.exists_root_eq_sum_int a
  have heq (i : Fin n) : c.equivFun (Q.coroot a) i = f (simpleIndex Q B e i) := by
    change Q.coroot a = ∑ j ∈ B.support, f j • Q.coroot j at hf
    have hsum : Q.coroot a = ∑ j : B.support, f j.val • Q.coroot j.val := by
      rw [Finset.univ_eq_attach]
      exact hf.trans (Finset.sum_attach B.support (fun j => f j • Q.coroot j)).symm
    have hsum' : Q.coroot a = ∑ j : Fin n, f (simpleIndex Q B e j) • c j := by
      rw [hsum]
      symm
      apply Fintype.sum_equiv e.symm
      intro j
      rw [hc]
    rw [hsum']
    simp [Finsupp.single_apply, eq_comm]
  rcases hs with hs | hs
  · exact Or.inl fun i => heq i ▸ hs.le (simpleIndex Q B e i)
  · exact Or.inr fun i => heq i ▸ hs.le (simpleIndex Q B e i)

private theorem simpleValue_lattice (c : Basis (Fin n) ℤ Y)
    (hc : ∀ i, c i = Q.coroot (simpleIndex Q B e i))
    (he : PreservesCartan (integralCartan Q B) (CartanMatrix.E n) e) (y : Y) (j : Fin n) :
    rootValue Q (simpleIndex Q B e j) (latticeMap y) =
      ∑ k, (c.equivFun y k : ℝ) * (CartanMatrix.E n k j : ℝ) := by
  have hpair (i : Fin n) :
      Q.toLinearMap (Q.root (simpleIndex Q B e j)) (c i) = CartanMatrix.E n i j := by
    rw [hc]
    simpa [integralCartan, simpleIndex] using he (e.symm i) (e.symm j)
  rw [rootValue_lattice]
  exact_mod_cast (calc
    Q.toLinearMap (Q.root (simpleIndex Q B e j)) y =
        Q.toLinearMap (Q.root (simpleIndex Q B e j)) (∑ k, c.repr y k • c k) := by rw [c.sum_repr]
    _ = ∑ k, c.equivFun y k * CartanMatrix.E n k j := by
      simp only [map_sum, map_smul, Int.zsmul_eq_mul, Basis.equivFun_apply, hpair])

private theorem rootValue_sum (a : X ≃ₗ[ℤ] (Fin n → ℤ))
    (hs : ∀ i, a (Q.root (simpleIndex Q B e i)) =
      Specs.AbsoluteDynkinTypes.simpleCharacter (CartanMatrix.E n) i)
    (j : ι) (p : Fin n → ℤ) (hj : a (Q.root j) = CartanMatrix.E n *ᵥ p)
    (x : Space Y) :
    rootValue Q j x =
      ∑ i, (p i : ℝ) * rootValue Q (simpleIndex Q B e i) x := by
  have hroot : Q.root j = ∑ i, p i • Q.root (simpleIndex Q B e i) := by
    apply a.injective
    rw [hj, map_sum]
    ext k
    simp [Matrix.mulVec, dotProduct, hs, Specs.AbsoluteDynkinTypes.simpleCharacter, mul_comm]
  have hfun : Q.root' j =
      ∑ i, p i • Q.root' (simpleIndex Q B e i) := by
    change Q.toLinearMap (Q.root j) = _
    rw [hroot, map_sum]
    simp [RootPairing.root']
  let f : Space Y →ₗ[ℝ] ℝ := ∑ i, (p i : ℝ) • rootValue Q (simpleIndex Q B e i)
  suffices h : rootValue Q j = f by
    simpa [f] using LinearMap.congr_fun h x
  apply TensorProduct.AlgebraTensorModule.ext
  intro r y
  have hy := LinearMap.congr_fun hfun y
  rw [tmul_eq_lattice_smul, map_smul, map_smul]
  congr 1
  change rootValue Q j (latticeMap y) = (∑ i, (p i : ℝ) • rootValue Q (simpleIndex Q B e i)) _
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, rootValue_lattice, smul_eq_mul]
  exact_mod_cast (by simpa [RootPairing.root'] using hy :
    Q.toLinearMap (Q.root j) y = ∑ i, p i * Q.toLinearMap (Q.root (simpleIndex Q B e i)) y)

end Coordinates

section RealGeometry

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
variable (Q : RootDatum ι X Y)

private def toCorootSpan
    (hY : Submodule.span ℤ (range Q.coroot) = ⊤) :
    Space Y ≃ₗ[ℝ] realRootSpan Q.flip :=
  (LinearEquiv.ofBijective (realRootSpan Q.flip).subtype ⟨Subtype.coe_injective, by
    intro x
    refine ⟨⟨x, ?_⟩, rfl⟩
    have h : realRootSpan Q.flip = ⊤ := by
      have hh := Submodule.baseChange_span (R := ℤ) ℝ (range Q.coroot)
      rw [hY, Submodule.baseChange_top, ← range_comp] at hh
      exact hh.symm
    rw [h]
    trivial⟩).symm

private theorem corootSpan_coe (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    (x : Space Y) : ((toCorootSpan Q hY x : realRootSpan Q.flip) : Space Y) = x :=
  (toCorootSpan Q hY).symm_apply_apply x

private theorem corootSpan_root (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    (i : ι) : toCorootSpan Q hY (latticeMap (Q.coroot i)) = realRoot Q.flip i := by
  apply Subtype.ext
  exact corootSpan_coe Q hY _

private theorem corootSpan_value (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    (i : ι) (x : Space Y) :
    realCoroot Q.flip i (toCorootSpan Q hY x) = rootValue Q i x := by
  change extendFunctional ℝ (Q.root' i) ((toCorootSpan Q hY x).val) = _
  rw [corootSpan_coe]
  rfl

private def onCorootSpan (hY : Submodule.span ℤ (range Q.coroot) = ⊤) :
    Q.weylGroup →* (realRootSpan Q.flip ≃ₗ[ℝ] realRootSpan Q.flip) where
  toFun w := (toCorootSpan Q hY).symm.trans ((realAction Q w).trans (toCorootSpan Q hY))
  map_one' := by ext x; simp [realAction_one]
  map_mul' v w := by ext x; simp [realAction_mul]

private theorem onCorootSpan_apply (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    (w : Q.weylGroup) (x : Space Y) :
    onCorootSpan Q hY w (toCorootSpan Q hY x) = toCorootSpan Q hY (realAction Q w x) := by
  simp [onCorootSpan]

set_option maxHeartbeats 1000000 in
private theorem onCorootSpan_mem (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    (w : Q.weylGroup) : onCorootSpan Q hY w ∈ realWeylGroup Q.flip := by
  refine RootPairing.weylGroup.induction Q (pred := fun w hw =>
    onCorootSpan Q hY ⟨w, hw⟩ ∈ realWeylGroup Q.flip) ?_ ?_ ?_ w.property
  · intro i
    apply Subgroup.subset_closure
    refine ⟨i, ?_⟩
    ext1 x
    obtain ⟨y, rfl⟩ := (toCorootSpan Q hY).surjective x
    change realReflection Q.flip i (toCorootSpan Q hY y) =
      onCorootSpan Q hY (RootPairing.weylGroup.ofIdx Q i) (toCorootSpan Q hY y)
    rw [onCorootSpan_apply, realAction_reflection, map_sub, map_smul, corootSpan_root]
    change toCorootSpan Q hY y - realCoroot Q.flip i (toCorootSpan Q hY y) • realRoot Q.flip i = _
    rw [corootSpan_value]
  · change onCorootSpan Q hY 1 ∈ _
    rw [map_one]
    exact Subgroup.one_mem _
  · intro g h hg hh hg' hh'
    have hm := (realWeylGroup Q.flip).mul_mem hg' hh'
    rw [← (onCorootSpan Q hY).map_mul] at hm
    exact hm

private theorem finiteWeyl [Finite ι] [Module.Free ℤ X]
    (hY : Submodule.span ℤ (range Q.coroot) = ⊤) : Finite Q.weylGroup := by
  obtain ⟨e, _, _⟩ := RootData.AbsoluteDynkinTypes.weylGroupComparison Q hY
  let _ := finite_realWeylGroup Q
  exact Finite.of_injective e e.injective

private theorem bounded_lattice {n : ℕ} (c : Basis (Fin n) ℤ Y)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] (j : Space Y ≃ₗ[ℝ] F) (R : ℝ) :
    {u : Y | ‖j (latticeMap u)‖ ≤ R}.Finite := by
  classical
  let bR := (c.baseChange ℝ).map j
  let : FiniteDimensional ℝ F := bR.finiteDimensional_of_finite
  let f (i : Fin n) := (bR.coord i).toContinuousLinearMap
  let b (i : Fin n) : ℤ := ⌈‖f i‖ * max R 0⌉
  have hb (u : {u : Y | ‖j (latticeMap u)‖ ≤ R}) (i : Fin n) :
      c.equivFun u.val i ∈ Set.Icc (-(b i)) (b i) := by
    have hu : f i (j (latticeMap u.val)) = (c.equivFun u.val i : ℝ) := by
      change bR.repr (j (latticeMap u.val)) i = _
      simp only [bR, Basis.map_repr, LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply,
        Basis.equivFun_apply]
      change (c.baseChange ℝ).repr (1 ⊗ₜ[ℤ] u.val) i = _
      simp [Basis.baseChange_repr_tmul, zsmul_eq_mul]
    have hbound := (f i).le_opNorm (j (latticeMap u.val))
    rw [hu, Real.norm_eq_abs] at hbound
    have hle := hbound.trans ((mul_le_mul_of_nonneg_left
      (u.property.trans (le_max_left R 0)) (norm_nonneg _)).trans (Int.le_ceil _))
    have h := abs_le.mp hle
    exact ⟨by exact_mod_cast h.1, by exact_mod_cast h.2⟩
  exact Finite.of_injective
    (fun u i => (⟨c.equivFun u.val i, hb u i⟩ : Set.Icc (-(b i)) (b i)))
    (fun u v huv => Subtype.ext (c.equivFun.injective (by
      funext i
      exact congrArg Subtype.val (congrFun huv i))))

private theorem affine_orbit_finite [Finite ι] [Module.Free ℤ X] {n : ℕ} (c : Basis (Fin n) ℤ Y)
    (hY : Submodule.span ℤ (range Q.coroot) = ⊤)
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] (j : Space Y ≃ₗ[ℝ] F)
    (hnorm : ∀ w x, ‖j (realAction Q w x)‖ = ‖j x‖) (x y : Space Y) (R : ℝ) :
    {u : Space Y | (∃ g : AffineWeylGroup Q, g • x = u) ∧ dist (j u) (j y) ≤ R}.Finite := by
  let _ := finiteWeyl Q hY
  apply (Set.finite_iUnion (fun w : Q.weylGroup =>
    (bounded_lattice c j (R + ‖j y‖ + ‖j x‖)).image
      (fun a => latticeMap a + realAction Q w x))).subset
  rintro u ⟨⟨g, rfl⟩, hu⟩
  refine Set.mem_iUnion.mpr ⟨g.right, g.left.toAdd, ?_, rfl⟩
  change dist (j (latticeMap g.left.toAdd + realAction Q g.right x)) (j y) ≤ R at hu
  change ‖j (latticeMap g.left.toAdd)‖ ≤ R + ‖j y‖ + ‖j x‖
  have htriangle := norm_sub_le (j (latticeMap g.left.toAdd) + j (realAction Q g.right x))
    (j (realAction Q g.right x))
  rw [add_sub_cancel_right, hnorm] at htriangle
  have hsum := dist_triangle (j (latticeMap g.left.toAdd) + j (realAction Q g.right x)) (j y) 0
  rw [dist_zero_right, dist_zero_right] at hsum
  rw [map_add] at hu
  linarith

end RealGeometry

section Alcove

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]

private theorem reflection_dist_lt (a x y : F) (p q D : ℝ)
    (hp : p < 0) (hq : 0 < q) (hD : 0 < D) (haa : inner ℝ a a = D)
    (hxy : 2 * inner ℝ (x - y) a = (p - q) * D) :
    dist (x - p • a) y < dist x y := by
  rw [← sq_lt_sq₀ dist_nonneg dist_nonneg, dist_eq_norm, dist_eq_norm,
    ← real_inner_self_eq_norm_sq, ← real_inner_self_eq_norm_sq]
  rw [show x - p • a - y = (x - y) - p • a by abel]
  simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right]
  simp only [real_inner_comm a x, real_inner_comm a y, haa] at *
  have hmul := congrArg (fun r : ℝ => p * r) hxy
  simp only [inner_sub_left] at hmul
  rw [real_inner_comm a x, real_inner_comm a y] at hmul
  have hneg : p * q * D < 0 := mul_neg_of_neg_of_pos (mul_neg_of_neg_of_pos hp hq) hD
  nlinarith

private theorem positive_scaling (f : F →ₗ[ℝ] ℝ) (x : F) :
    ∃ r : ℝ, 0 < r ∧ f (r • x) < 1 := by
  let d := |f x| + 1
  have hd : 0 < d := by dsimp [d]; positivity
  refine ⟨d⁻¹, inv_pos.mpr hd, ?_⟩
  rw [map_smul, smul_eq_mul, ← div_eq_inv_mul, div_lt_iff₀ hd, one_mul]
  exact (le_abs_self _).trans_lt (lt_add_one _)

private theorem image_eq_of_scalings (g : F ≃ₗ[ℝ] F) {A D : Set F}
    (hA : g '' A = A)
    (hD : ∀ x, x ∈ D ↔ ∃ r : ℝ, 0 < r ∧ r • x ∈ A) :
    g '' D = D := by
  have hf (x : F) : g x ∈ D ↔ x ∈ D := by
    rw [hD, hD]
    apply exists_congr
    intro r
    rw [← map_smul]
    have he : g (r • x) ∈ A ↔ r • x ∈ A := by
      constructor
      · intro hx
        have hx' : g (r • x) ∈ g '' A := hA.symm ▸ hx
        obtain ⟨y, hy, h⟩ := hx'
        exact g.injective h ▸ hy
      · intro hx
        exact hA ▸ (show g (r • x) ∈ g '' A from ⟨r • x, hx, rfl⟩)
    exact and_congr_right fun _ => he
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact (hf y).mpr hy
  · intro hx
    refine ⟨g.symm x, (hf _).mp ?_, g.apply_symm_apply x⟩
    rwa [g.apply_symm_apply]

end Alcove

set_option maxHeartbeats 2000000 in
theorem pointStabilizers : PointStabilizers.{u,v,w} := by
  classical
  intro ι X Y _ _ _ _ _ _ _ Q _ _ B hY n hn e he m hm
  obtain ⟨c, a, hc, _, hs, hroots⟩ :=
    RootData.AbsoluteDynkinTypes.cartanCoordinates Q B hY (CartanMatrix.E n) e he
  let B' : Q.flip.Base := B.flip
  let e' : B'.support ≃ Fin n := e
  obtain ⟨_, _, _, _, _, metric, hinv, hform, hreflection, hR, z, b, hz, _, _, hb, hbasis, _, _, _⟩ :=
    euclideanComparison Q.flip B'
  let F := realRootSpan Q.flip
  let : NormedAddCommGroup F := metric.toNormedAddCommGroup
  let : InnerProductSpace ℝ F := InnerProductSpace.ofCore metric.toCore
  let j : Space Y ≃ₗ[ℝ] F := toCorootSpan Q hY
  let : FiniteDimensional ℝ F := ((c.baseChange ℝ).map j).finiteDimensional_of_finite
  let f (i : ι) : F →ₗ[ℝ] ℝ := (rootValue Q i).comp j.symm.toLinearMap
  let L (w : Q.weylGroup) := onCorootSpan Q hY w
  let G := AffineWeylGroup Q
  let : MulAction G F :=
    { smul := fun g x => j (g • j.symm x)
      one_smul := by
        intro x
        change j ((1 : G) • j.symm x) = x
        rw [one_smul, j.apply_symm_apply]
      mul_smul := by
        intro g h x
        change j ((g * h) • j.symm x) = j (g • j.symm (j (h • j.symm x)))
        rw [j.symm_apply_apply, mul_smul] }
  have hact (g : G) (x : F) : g • x = j (g • j.symm x) := rfl
  have hf (i : ι) (x : F) : f i x = realCoroot Q.flip i x := by
    obtain ⟨y, rfl⟩ := j.surjective x
    change rootValue Q i (j.symm (j y)) = _
    rw [j.symm_apply_apply]
    exact (corootSpan_value Q hY i y).symm
  have hvalue (i : ι) (x : F) :
      2 * inner ℝ x (realRoot Q.flip i) =
        f i x * inner ℝ (realRoot Q.flip i) (realRoot Q.flip i) := by
    rw [hf, hform, div_mul_cancel₀ _ (inner_self_ne_zero.mpr (hR.nonzero _ (mem_range_self i)))]
  have hL (w : Q.weylGroup) (x : F) : L w x = j (realAction Q w (j.symm x)) := rfl
  have hLinv (w : Q.weylGroup) (x y : F) : inner ℝ (L w x) (L w y) = inner ℝ x y :=
    hinv ⟨L w, onCorootSpan_mem Q hY w⟩ x y
  have hsum (i : ι) (p : Fin n → ℤ) (hi : a (Q.root i) = CartanMatrix.E n *ᵥ p) (x : F) :
      f i x = ∑ l, (p l : ℝ) * f (simpleIndex Q B e l) x :=
    rootValue_sum Q B e a hs i p hi (j.symm x)
  obtain ⟨θ, hθ⟩ : ∃ i : ι, (a (Q.root i), c.equivFun (Q.coroot i)) = (CartanMatrix.E n *ᵥ m, m) := by
    have hmem : (CartanMatrix.E n *ᵥ m, m) ∈
      range (fun i => (a (Q.root i), c.equivFun (Q.coroot i))) := by
      rw [hroots]
      exact hm.2.1
    exact hmem
  have hhighest (x : F) : f θ x = ∑ i, (m i : ℝ) * f (simpleIndex Q B e i) x :=
    hsum θ m (congrArg Prod.fst hθ) x
  let wall (p : ι × ℤ) : F →ᵃ[ℝ] ℝ := (f p.1).toAffineMap - AffineMap.const ℝ F (p.2 : ℝ)
  let facet : Option (Fin n) → ι × ℤ := fun i => i.elim (θ, 1) (fun l => (simpleIndex Q B e l, 0))
  -- The highest-root inequality is oriented in the opposite direction to the simple walls.
  -- Use signed copies of the walls so all defining inequalities have the same direction.
  let walls (p : (ι × ℤ) × Bool) : F →ᵃ[ℝ] ℝ := if p.2 then wall p.1 else -wall p.1
  let facets : Option (Fin n) → (ι × ℤ) × Bool := fun i => (facet i, i.isSome)
  let reflection (p : (ι × ℤ) × Bool) : G := wallReflection Q p.1.1 p.1.2
  have hwall (p : (ι × ℤ) × Bool) (x : F) :
      walls p x = if p.2 then f p.1.1 x - (p.1.2 : ℝ) else (p.1.2 : ℝ) - f p.1.1 x := by
    rcases p with ⟨p, _ | _⟩ <;> simp [walls, wall, neg_sub]
  have hwzero (p : (ι × ℤ) × Bool) (x : F) :
      walls p x = 0 ↔ f p.1.1 x = (p.1.2 : ℝ) := by
    rw [hwall]
    cases hp : p.2
    · simp only [Bool.false_eq_true, ite_false]
      exact sub_eq_zero.trans eq_comm
    · simp only [ite_true, sub_eq_zero]
  have hA (x : F) : x ∈ chamber walls facets ↔
      (∀ i, 0 < f (simpleIndex Q B e i) x) ∧ f θ x < 1 := by
    change (∀ i, 0 < walls (facets i) x) ↔ _
    constructor
    · intro h
      exact ⟨fun i => by simpa [facets, facet, hwall] using h (some i),
        by simpa [facets, facet, hwall, sub_pos] using h none⟩
    · rintro ⟨h, hθ'⟩ (_ | i)
      · simpa [facets, facet, hwall, sub_pos] using hθ'
      · simpa [facets, facet, hwall] using h i
  have hC (x : F) : x ∈ closedChamber walls facets ↔
      (∀ i, 0 ≤ f (simpleIndex Q B e i) x) ∧ f θ x ≤ 1 := by
    change (∀ i, 0 ≤ walls (facets i) x) ↔ _
    constructor
    · intro h
      exact ⟨fun i => by simpa [facets, facet, hwall] using h (some i),
        by simpa [facets, facet, hwall, sub_nonneg] using h none⟩
    · rintro ⟨h, hθ'⟩ (_ | i)
      · simpa [facets, facet, hwall, sub_nonneg] using hθ'
      · simpa [facets, facet, hwall] using h i
  have hsimple (x : F) (i : Fin n) :
      0 < f (simpleIndex Q B e i) x ↔ 0 < inner ℝ x (b (e'.symm i)) := by
    rw [hb (e'.symm i)]
    change 0 < f (simpleIndex Q B e i) x ↔
      0 < inner ℝ x (realRoot Q.flip (simpleIndex Q B e i))
    have h := hvalue (simpleIndex Q B e i) x
    have hd := real_inner_self_pos.mpr (hR.nonzero _ (mem_range_self (simpleIndex Q B e i)))
    rw [← mul_pos_iff_of_pos_right hd, ← h]
    exact mul_pos_iff_of_pos_left (by norm_num)
  have hdom (x : F) : x ∈ simpleChamber (range (realRoot Q.flip)) z ↔
      ∀ i, 0 < f (simpleIndex Q B e i) x := by
    change (∀ r ∈ simpleRoots _ _, 0 < inner ℝ x r) ↔ _
    rw [← hbasis]
    simp only [forall_mem_range]
    constructor
    · intro hh i
      exact (hsimple x i).mpr (hh (e'.symm i))
    · intro hh i
      simpa only [e'.symm_apply_apply] using (hsimple x (e' i)).mp (hh (e' i))
  have hscale (x : F) : x ∈ simpleChamber (range (realRoot Q.flip)) z ↔
      ∃ r : ℝ, 0 < r ∧ r • x ∈ chamber walls facets := by
    rw [hdom]
    constructor
    · intro hx
      obtain ⟨r, hr, hrx⟩ := positive_scaling (f θ) x
      exact ⟨r, hr, (hA _).mpr ⟨fun i => by
        rw [map_smul, smul_eq_mul]; exact mul_pos hr (hx i), hrx⟩⟩
    · rintro ⟨r, hr, hx⟩ i
      have h := ((hA _).mp hx).1 i
      rwa [map_smul, smul_eq_mul, mul_pos_iff_of_pos_left hr] at h
  have hnonempty : (chamber walls facets).Nonempty := by
    obtain ⟨r, _, hr⟩ := (hscale z).mp (self_mem_simpleChamber _ z)
    exact ⟨r • z, hr⟩
  have hregular (x : F) (hx : x ∈ chamber walls facets) : regular walls x := by
    have ⟨hxpos, hxθ⟩ := (hA x).mp hx
    intro ⟨⟨i, k⟩, s⟩
    rw [ne_eq, hwzero]
    change f i x ≠ (k : ℝ)
    let p := c.equivFun (Q.coroot i)
    have hp0 : p ≠ 0 := by
      intro hp
      exact Q.flip.ne_zero i (c.equivFun.injective (by simpa [p] using hp))
    have hp : CartanRoots (CartanMatrix.E n) (a (Q.root i), p) := by
      change (a (Q.root i), c.equivFun (Q.coroot i)) ∈ {p | CartanRoots (CartanMatrix.E n) p}
      rw [← hroots]
      exact mem_range_self i
    have hpi := cartanRoots_matrix (exceptional_cartan_symmetric hn) hp
    have less (v : Fin n → ℤ) (hv : ∀ i, 0 ≤ v i) (hv0 : v ≠ 0)
        (hv' : ∀ i, v i ≤ m i) :
        0 < ∑ i, (v i : ℝ) * f (simpleIndex Q B e i) x ∧
          ∑ i, (v i : ℝ) * f (simpleIndex Q B e i) x < 1 :=
      root_value_lt_one hxpos hv hv0 hv' (by rwa [← hhighest])
    rcases coroot_coordinate_sign Q B e c hc i with hpos | hneg
    · have h := less p hpos hp0 (hm.2.2.1 _ hp)
      rw [← hsum i p hpi] at h
      intro hk
      rw [hk] at h
      have hp' : 0 < k := by exact_mod_cast h.1
      have hk' : k < 1 := by exact_mod_cast h.2
      omega
    · have h := less (-p) (fun l => neg_nonneg.mpr (hneg l)) (neg_ne_zero.mpr hp0)
          (hm.2.2.1 _ (CartanRoots.neg hp))
      simp only [Pi.neg_apply, Int.cast_neg, neg_mul, Finset.sum_neg_distrib, ← hsum i p hpi] at h
      intro hk
      rw [hk, ← Int.cast_neg] at h
      have hp' : 0 < -k := by exact_mod_cast h.1
      have hk' : -k < 1 := by exact_mod_cast h.2
      omega
  have hclosure : closure (chamber walls facets) ⊆ closedChamber walls facets := by
    apply closure_minimal (fun x hx => (hC x).mpr ⟨fun i => ((hA x).mp hx).1 i |>.le,
      ((hA x).mp hx).2.le⟩)
    have heq : closedChamber walls facets = ⋂ i, {x | 0 ≤ walls (facets i) x} := by
      ext x
      simp [closedChamber]
    rw [heq]
    exact isClosed_iInter fun _ => isClosed_le continuous_const (AffineMap.continuous_of_finiteDimensional _)
  have hF (g : G) (x : F) : g • x = j (latticeMap g.left.toAdd) + L g.right x := by
    rw [hact]
    exact map_add j _ _
  have hiso (g : G) : Isometry (fun x : F => g • x) := by
    apply isometry_iff_dist_eq.mpr
    intro x y
    rw [hF, hF, dist_eq_norm, dist_eq_norm, add_sub_add_left_eq_sub, ← map_sub]
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    simpa only [real_inner_self_eq_norm_sq] using hLinv g.right (x - y) (x - y)
  have hfree (g : G) (hg : g • chamber walls facets = chamber walls facets) : g = 1 := by
    have h0 : (0 : F) ∈ closedChamber walls facets := (hC 0).mpr (by simp)
    have hg0 : g • (0 : F) ∈ closedChamber walls facets := hclosure
      (map_mem_closure (hiso g).continuous (closedChamber_subset_closure hnonempty h0)
        (fun _ hx => hg ▸ Set.smul_mem_smul_set hx))
    have hv := (hC _).mp hg0
    have htrans : g • (0 : F) = j (latticeMap g.left.toAdd) := by simp [hF]
    have hcoords (i : Fin n) : f (simpleIndex Q B e i) (g • (0 : F)) =
        ∑ k, (c.equivFun g.left.toAdd k : ℝ) * (CartanMatrix.E n k i : ℝ) := by
      rw [htrans]
      change rootValue Q (simpleIndex Q B e i) (j.symm (j (latticeMap g.left.toAdd))) = _
      rw [j.symm_apply_apply]
      exact simpleValue_lattice Q B e c hc he _ _
    rw [hhighest] at hv
    simp only [hcoords] at hv
    have hvalues : ∀ i, f (simpleIndex Q B e i) (g • (0 : F)) = 0 := by
      intro i
      rw [hcoords]
      exact exceptional_integral_simple_values hm hv.1 hv.2 i
    have hinner (i : B'.support) : inner ℝ (g • (0 : F)) (b i) = 0 := by
      rw [hb i]
      have hh := hvalue i.val (g • (0 : F))
      have hfi : f i.val (g • (0 : F)) = 0 := by
        have hh' := hvalues (e' i)
        change f (e'.symm (e' i)).val (g • (0 : F)) = 0 at hh'
        rwa [e'.symm_apply_apply] at hh'
      rw [hfi, zero_mul] at hh
      linarith
    have hzero : g • (0 : F) = 0 := by
      apply (inner_self_eq_zero (𝕜 := ℝ)).mp
      calc
        _ = inner ℝ (g • (0 : F)) (∑ i, b.repr (g • (0 : F)) i • b i) := by rw [b.sum_repr]
        _ = 0 := by simp [inner_sum, inner_smul_right, hinner]
    have hlin (x : F) : g • x = L g.right x := by
      rw [hF, ← htrans, hzero, zero_add]
    have hgroup : L g.right ∈ rootWeylGroup (range (realRoot Q.flip)) := by
      have hh := onCorootSpan_mem Q hY g.right
      apply (show realWeylGroup Q.flip ≤ rootWeylGroup (range (realRoot Q.flip)) from
        (Subgroup.closure_le _).mpr (by
          rintro _ ⟨i, rfl⟩
          apply Subgroup.subset_closure
          refine ⟨realRoot Q.flip i, mem_range_self _, ?_⟩
          ext x
          rw [rootReflectionEquiv_apply, hreflection])) hh
    have himage : L g.right '' chamber walls facets = chamber walls facets := by
      change (fun x : F => g • x) '' chamber walls facets = chamber walls facets at hg
      calc
        _ = (fun x : F => g • x) '' chamber walls facets := Set.image_congr (fun x _ => (hlin x).symm)
        _ = _ := hg
    have heq := weyl_simpleChamber_stabilizer hR hz ⟨L g.right, hgroup⟩
      (image_eq_of_scalings _ himage hscale)
    apply affine_action_faithful Q
    intro x
    apply j.injective
    have hh := congrArg (fun w : rootWeylGroup (range (realRoot Q.flip)) => w.val (j x)) heq
    change L g.right (j x) = j x at hh
    calc
      j (g • x) = g • j x := by rw [hact, j.symm_apply_apply]
      _ = L g.right (j x) := hlin _
      _ = j ((1 : G) • x) := by rwa [one_smul]
  have hrefl (p : (ι × ℤ) × Bool) (x : F) : reflection p • x =
      x - (f p.1.1 x - (p.1.2 : ℝ)) • realRoot Q.flip p.1.1 := by
    rw [hact]
    change j (wallReflection Q p.1.1 p.1.2 • j.symm x) = _
    rw [wallReflectionFormula, map_sub, map_smul, j.apply_symm_apply]
    change x - (f p.1.1 x - (p.1.2 : ℝ)) • j (latticeMap (Q.coroot p.1.1)) = _
    rw [corootSpan_root]
  have hfinite (x y : F) (r : ℝ) :
      {u : F | (∃ w : G, w • x = u) ∧ dist u y ≤ r}.Finite := by
    have hf' := affine_orbit_finite Q c hY j (fun w x => by
      have hh := hLinv w (j x) (j x)
      rw [hL, j.symm_apply_apply, real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq] at hh
      exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp hh) (j.symm x) (j.symm y) r
    apply (hf'.image j).subset
    rintro u ⟨⟨w, rfl⟩, hu⟩
    exact ⟨w • j.symm x, ⟨⟨w, rfl⟩, by simpa [← hact] using hu⟩, rfl⟩
  -- Apply the geometric stabilizer theorem to both orientations of each wall.
  have hstab := @affineWallStabilizers F _ _ G _ _ _ _ _
    walls facets reflection hiso (fun _ => AffineMap.continuous_of_finiteDimensional _)
    (fun p x hx => by rw [hrefl, (hwzero _ _).mp hx, sub_self, zero_smul, sub_zero])
    (fun p x y hx hy => by
      rw [hrefl]
      let i := p.1.1
      let r := realRoot Q.flip i
      let D := inner ℝ r r
      let v := f i x - (p.1.2 : ℝ)
      let u := f i y - (p.1.2 : ℝ)
      have hd : 0 < D := real_inner_self_pos.mpr (hR.nonzero _ (mem_range_self i))
      have huv : 2 * inner ℝ (x - y) r = (v - u) * D := by
        rw [inner_sub_left]
        dsimp only [v, u]
        linear_combination hvalue i x - hvalue i y
      rw [hwall] at hx hy
      by_cases h : p.2
      · rw [ite_eq_left h] at hx hy
        exact reflection_dist_lt r x y v u D hx hy hd rfl huv
      · rw [ite_eq_right h] at hx hy
        have hv : -v < 0 := by dsimp only [v, i]; linarith only [hx]
        have hu : 0 < -u := by dsimp only [u, i]; linarith only [hy]
        have huv' : 2 * inner ℝ (x - y) (-r) = (-v - -u) * D := by
          rw [inner_neg_right]
          linear_combination -huv
        have hh := reflection_dist_lt (-r) x y (-v) (-u) D hv hu hd (by simp [D]) huv'
        simpa only [neg_smul, smul_neg, neg_neg] using hh)
    (fun g x => by
      have hregular_forward (g : G) (x : F) : regular walls x → regular walls (g • x) := by
        intro hx ⟨⟨i, k⟩, s⟩ hz'
        let t := Q.weylGroupToPerm g.right
        let l := Q.toLinearMap (Q.root i) g.left.toAdd
        have hz := (hwzero _ _).mp hz'
        change f i (g • x) = (k : ℝ) at hz
        have ht := rootValue_affine Q g (t.symm i) (j.symm x)
        change rootValue Q (t (t.symm i)) (g • j.symm x) =
          (Q.toLinearMap (Q.root (t (t.symm i))) g.left.toAdd : ℝ) +
            rootValue Q (t.symm i) (j.symm x) at ht
        rw [t.apply_symm_apply] at ht
        change rootValue Q i (j.symm (g • x)) = (k : ℝ) at hz
        rw [hact, j.symm_apply_apply, ht] at hz
        apply hx ((t.symm i, k - l), true)
        apply (hwzero _ _).mpr
        change rootValue Q (t.symm i) (j.symm x) = ((k - l : ℤ) : ℝ)
        push_cast
        dsimp only [l]
        linarith
      exact ⟨fun hx => by simpa using hregular_forward g⁻¹ (g • x) hx, hregular_forward g x⟩)
    (fun g p x hx => by
      let t := Q.weylGroupToPerm g.right
      let i := t.symm p.1.1
      let l := Q.toLinearMap (Q.root p.1.1) g.left.toAdd
      have hi : t i = p.1.1 := t.apply_symm_apply _
      refine ⟨((i, p.1.2 - l), true), (hwzero _ _).mpr ?_, ?_⟩
      · have hz := (hwzero _ _).mp hx
        change rootValue Q p.1.1 (j.symm (g • x)) = (p.1.2 : ℝ) at hz
        have hf' := rootValue_affine Q g i (j.symm x)
        change rootValue Q (t i) (g • j.symm x) =
          (Q.toLinearMap (Q.root (t i)) g.left.toAdd : ℝ) + _ at hf'
        rw [hi] at hf'
        rw [hact, j.symm_apply_apply, hf'] at hz
        change rootValue Q i (j.symm x) = ((p.1.2 - l : ℤ) : ℝ)
        push_cast
        dsimp only [l]
        linarith
      · symm
        change g * wallReflection Q i (p.1.2 - l) * g⁻¹ = wallReflection Q p.1.1 p.1.2
        rw [conjugate_wall]
        change wallReflection Q (t i) (p.1.2 - l + Q.toLinearMap (Q.root (t i)) g.left.toAdd) = _
        rw [hi]
        simp [l])
    hfinite hnonempty hregular hfree
  intro x
  have hg : {s : G | ∃ p, walls p (j x) = 0 ∧ s = reflection p} = wallGenerators Q x := by
    ext g
    constructor
    · rintro ⟨⟨⟨i, k⟩, s⟩, hs', rfl⟩
      have h := (hwzero _ _).mp hs'
      change rootValue Q i (j.symm (j x)) = (k : ℝ) at h
      exact ⟨i, k, by simpa only [j.symm_apply_apply] using h, rfl⟩
    · rintro ⟨i, k, hk, rfl⟩
      refine ⟨((i, k), true), (hwzero _ _).mpr ?_, rfl⟩
      change rootValue Q i (j.symm (j x)) = (k : ℝ)
      rwa [j.symm_apply_apply]
  rw [← hg, ← hstab (j x)]
  ext g
  change g • x = x ↔ g • j x = j x
  rw [hact, j.symm_apply_apply, j.injective.eq_iff]

theorem congruenceProjection : CongruenceProjection.{u,v,w} := by
  intro ι X Y _ _ _ _ _ _ _ Q _ _ B hY n hn e he m hm d hd y
  rw [pointStabilizers Q B hY hn e he m hm, MonoidHom.map_closure, projected_generators Q hd]

theorem congruenceStabilizers : CongruenceStabilizers.{u,v,w} := by
  intro ι X Y _ _ _ _ _ _ _ Q _ _ B hY n hn e he m hm d hd y w
  rw [← divided_lift Q hd, congruenceProjection Q B hY hn e he m hm d hd]

end LinearAlgebraicGroups.Arithmetic.ExceptionalAffineCorootStabilizers
