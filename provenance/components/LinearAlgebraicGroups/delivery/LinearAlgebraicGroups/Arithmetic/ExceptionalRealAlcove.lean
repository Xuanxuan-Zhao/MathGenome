open LinearAlgebraicGroups.Specs.Pinning (BasedRootDatum BasedIso)
open LinearAlgebraicGroups.Specs.IntegralSemisimpleModel (integerAlgebra)
attribute [local instance] integerAlgebra
open LinearAlgebraicGroups.Specs.ExceptionalAffineRootSystems
  (FoldedRootDirection IsLongF4Doubled IsShortF4Doubled normalizedFoldedRoot normalizedFoldedNumerator unitSign)

private theorem split_root_separates (D : BasedRootDatum.{uG})
    (hspan : D.datum.rootSpan ℤ = ⊤) :
    ∀ x y : ℚ ⊗[ℤ] D.Y,
      (∀ i, (ApartmentRoots.split D.datum ℚ).root i x = (ApartmentRoots.split D.datum ℚ).root i y) →
      x = y := by
  let := D.finiteRoots
  apply separating_baseChange D.datum.root'
  intro x y h
  apply D.datum.flip.toPerfPair.injective
  apply LinearMap.ext_on (s := range D.datum.root) hspan
  rintro _ ⟨i, rfl⟩
  exact h i

private theorem folded_abs_le (z : FoldedRootDirection) (i : Fin 4) :
    z.val i ∈ Icc (-2 : ℤ) 2 := by
  have hsign (b : Bool) : -2 ≤ 2 * unitSign b ∧ 2 * unitSign b ≤ 2 := by
    cases b <;> decide
  rcases z.property with ⟨j, k, s, t, hjk, hz⟩ | (⟨j, s, hz⟩ | h)
  · rw [hz]
    simp only [Pi.add_apply, Pi.single_apply, mem_Icc]
    by_cases hij : i = j
    · have hik : i ≠ k := hij ▸ hjk
      simpa only [hij, hik, hjk, ite_true, ite_false, add_zero] using hsign s
    · by_cases hik : i = k
      · simpa only [hij, hik, hjk.symm, ite_true, ite_false, zero_add] using hsign t
      · simp [hij, hik]
  · rw [hz]
    simp only [Pi.single_apply, mem_Icc]
    split_ifs <;> first | exact hsign s | decide
  · rcases h i with he | he <;> rw [he] <;> norm_num

private theorem finite_foldedDirections : Finite FoldedRootDirection := by
  let _ : Finite (Icc (-2 : ℤ) 2) := (Set.finite_Icc _ _).to_subtype
  exact Finite.of_injective (fun (z : FoldedRootDirection) i => (⟨z.val i, folded_abs_le z i⟩ :
    Icc (-2 : ℤ) 2)) (fun z w h => Subtype.ext (funext fun i => congrArg Subtype.val (congrFun h i)))

private def foldedCoordinateDirection (i : Fin 4) : FoldedRootDirection :=
  ⟨Pi.single i 2, Or.inr (Or.inl ⟨i, true, rfl⟩)⟩

private theorem foldedCoordinate_not_long (i : Fin 4) :
    ¬ IsLongF4Doubled (foldedCoordinateDirection i).val := by
  rintro ⟨j, k, s, t, hjk, h⟩
  change (Pi.single i (2 : ℤ) : Fin 4 → ℤ) =
    Pi.single j (2 * unitSign s) + Pi.single k (2 * unitSign t) at h
  by_cases hji : j = i
  · subst j
    have hk := congrArg (fun z : Fin 4 → ℤ => z k) h
    simp only [Pi.add_apply, Pi.single_apply, ite_eq_right hjk.symm, zero_add] at hk
    cases t <;> norm_num [unitSign] at hk
  · have hj := congrArg (fun z : Fin 4 → ℤ => z j) h
    simp only [Pi.add_apply, Pi.single_apply, ite_eq_right hji, ite_eq_right hjk, add_zero] at hj
    cases s <;> norm_num [unitSign] at hj

private theorem foldedCoordinate_numerator (i j : Fin 4) :
    normalizedFoldedNumerator (foldedCoordinateDirection i).val j = if j = i then 4 else 0 := by
  unfold normalizedFoldedNumerator
  rw [ite_eq_right (foldedCoordinate_not_long i)]
  change ((2 : ℤ) • (Pi.single i (2 : ℤ) : Fin 4 → ℤ)) j = _
  by_cases h : j = i <;> simp [Pi.smul_apply, h]

private theorem foldedCoordinate_value (i : Fin 4) (x : Fin 4 → ℚ) :
    normalizedFoldedRoot ℚ (foldedCoordinateDirection i) x = 2 * x i := by
  simp only [normalizedFoldedRoot, LinearMap.sum_apply, LinearMap.smul_apply,
    LinearMap.proj_apply, smul_eq_mul]
  rw [Finset.sum_eq_single i]
  · rw [foldedCoordinate_numerator, ite_eq_left rfl]
    norm_num
  · intro j _ hj
    rw [foldedCoordinate_numerator, ite_eq_right hj]
    norm_num
  · simp

private theorem folded_root_separates {D : BasedRootDatum.{uG}} {τ : BasedIso D D}
    (F : FoldedApartment τ) :
    ∀ x y, (∀ i, F.roots.root i x = F.roots.root i y) → x = y := by
  intro x y h
  apply F.coordinates.symm.injective
  funext i
  have hv := h (foldedCoordinateDirection i)
  rw [← F.coordinates.apply_symm_apply x, ← F.coordinates.apply_symm_apply y, F.normalized_root,
    F.normalized_root, foldedCoordinate_value, foldedCoordinate_value] at hv
  linarith

private theorem splitRealAlcoves_core.{u} :
    LinearAlgebraicGroups.Specs.ExceptionalRealAlcove.SplitRealAlcoves.{u} := by
  intro K _ _ _ _ D E M M' c n b b' hn _ _ _ hspan p p' e L hp
  let := D.finiteRoots
  let := E.finiteRoots
  have hpos : 0 < n := by rcases hn with h | h | h <;> omega
  let i : Fin n := ⟨0, hpos⟩
  let _ : Nonempty D.I := ⟨(b i).val⟩
  let _ : Nonempty E.I := ⟨(b' i).val⟩
  have hsep := split_root_separates E hspan
  rcases L.central with ⟨_, _, _, _, _, _, _, _, _, f, _, hroot, _⟩
  have hsep' : ∀ x y, (∀ i, (ApartmentRoots.split D.datum ℚ).root i x =
      (ApartmentRoots.split D.datum ℚ).root i y) → x = y := by
    intro x y h
    apply e.injective
    apply hsep
    intro j
    obtain ⟨i, rfl⟩ := f.surjective j
    simp only [hroot, h]
  exact ⟨realAlcove_of_markedVertices L.sc.geometry L.sc.coxeter hsep'
      (markedVertices_of_transport e f hp hroot L.typeQuotient.vertex),
    realAlcove_of_markedVertices L.ad.geometry L.ad.coxeter hsep L.typeQuotient.vertex⟩

private theorem ramifiedRealAlcoves_core.{u} :
    LinearAlgebraicGroups.Specs.ExceptionalRealAlcove.RamifiedRealAlcoves.{u} := by
  intro F L k K _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ D M R σ σK f A X
  let := finite_foldedDirections
  let _ : Nonempty FoldedRootDirection := ⟨foldedCoordinateDirection 0⟩
  exact realAlcove_of_markedVertices X.comparison.geometry X.comparison.coxeter
    (folded_root_separates A) X.typeQuotient.vertex

end ExceptionalLevels

