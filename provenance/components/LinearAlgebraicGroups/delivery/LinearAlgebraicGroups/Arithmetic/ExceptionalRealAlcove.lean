section RationalAlcove

open LinearAlgebraicGroups.Specs.ExceptionalAffineRootSystems
  (AlcoveCoxeterData AlcoveGeometry ApartmentRoots)
open LinearAlgebraicGroups.Arithmetic.AffineArrangement (Datum)

variable {V J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V}

/-- The weak inequalities of the marked rational alcove. -/
def InClosedAlcove (A : ApartmentRoots ℚ V J) (p x : V) : Prop :=
  ∀ a, A.positive p a → 0 ≤ A.wallValue a x

private theorem reflection_apply (a : J × ℤ) (x : V) :
    A.reflection a x = x - A.wallValue a x • A.coroot a.1 := by
  change (-a.2) • A.coroot a.1 + Module.reflection (A.diagonal a.1) x =
    x - (A.root a.1 x + (a.2 : ℚ)) • A.coroot a.1
  rw [Module.reflection_apply, add_smul, ← Int.cast_smul_eq_zsmul ℚ, Int.cast_neg, neg_smul]
  abel

private theorem reflection_reverses_wall (a : J × ℤ) (x : V) :
    A.wallValue a (A.reflection a x) = -A.wallValue a x := by
  change A.root a.1 (A.reflection a x) + (a.2 : ℚ) = -(A.root a.1 x + (a.2 : ℚ))
  rw [reflection_apply, map_sub, map_smul, A.diagonal]
  change A.root a.1 x - (A.root a.1 x + (a.2 : ℚ)) * 2 + (a.2 : ℚ) = _
  ring

/-- Each signed wall has a wall with its opposite affine equation. -/
theorem exists_opposite_wall (hA : AlcoveGeometry A p) (a : J × ℤ) :
    ∃ b, ∀ x, A.wallValue b x = -A.wallValue a x := by
  have hr : A.reflection a ∈ A.affineWeylGroup := Subgroup.subset_closure ⟨a, rfl⟩
  obtain ⟨σ, hσ⟩ := hA.ordinary_symmetries hr
  refine ⟨σ.symm a, fun x => ?_⟩
  have h := (hσ (σ.symm a)).1 x
  rw [Equiv.apply_symm_apply] at h
  exact h.symm.trans (reflection_reverses_wall a x)

private theorem wall_nonpos_of_negative (hA : AlcoveGeometry A p)
    {a : J × ℤ} (ha : A.wallValue a p < 0) {x : V} (hx : InClosedAlcove A p x) :
    A.wallValue a x ≤ 0 := by
  obtain ⟨b, hb⟩ := exists_opposite_wall hA a
  have hp : A.positive p b := by
    change 0 < A.wallValue b p
    rw [hb]
    exact neg_pos.mpr ha
  have h := hx b hp
  rwa [hb, neg_nonneg] at h

private theorem rightDescent_wall_eq_zero (hA : AlcoveGeometry A p)
    (d : AlcoveCoxeterData A p) {w : A.affineWeylGroup} {i : A.SimpleWall p}
    (hi : d.coxeter.IsRightDescent w i) {x : V}
    (hx : InClosedAlcove A p x) (hwx : InClosedAlcove A p (w.val x)) :
    A.wallValue i.val x = 0 := by
  let := d.action
  have h := wall_nonpos_of_negative hA ((d.right_descent w i).mp hi) hwx
  rw [d.equation, AffineEquiv.symm_apply_apply] at h
  exact h.antisymm (hx i.val i.property.1)

private theorem simple_fixes_of_wall_eq_zero (d : AlcoveCoxeterData A p)
    {i : A.SimpleWall p} {x : V} (hx : A.wallValue i.val x = 0) :
    (d.coxeter.simple i).val x = x := by
  rw [d.simple_eq]
  change A.reflection i.val x = x
  rw [reflection_apply, hx, zero_smul, sub_zero]

private theorem wall_eq_zero_of_simple_fixes (d : AlcoveCoxeterData A p)
    {i : A.SimpleWall p} {x : V} (hx : (d.coxeter.simple i).val x = x) :
    A.wallValue i.val x = 0 := by
  rw [d.simple_eq] at hx
  change A.reflection i.val x = x at hx
  rw [reflection_apply, sub_eq_self, smul_eq_zero] at hx
  refine hx.resolve_right fun h => ?_
  have htwo := A.diagonal i.val.1
  rw [h, map_zero] at htwo
  norm_num at htwo

/-- A closed alcove meets each ordinary Weyl orbit in at most one point. The
transporter of two points of the closed alcove is generated by the simple
walls through the source point. -/
theorem closedAlcove_transporter (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    {x : V} (hx : InClosedAlcove A p x) (w : A.affineWeylGroup)
    (hwx : InClosedAlcove A p (w.val x)) :
    w.val x = x ∧ w ∈ standardWallSubgroup d.coxeter {i | A.wallValue i.val x = 0} := by
  induction hl : d.coxeter.length w using Nat.strong_induction_on generalizing w with
  | h n ih =>
    by_cases hw : w = 1
    · subst w
      exact ⟨rfl, Subgroup.one_mem _⟩
    · obtain ⟨i, hi⟩ := d.coxeter.exists_rightDescent_of_ne_one hw
      let s := d.coxeter.simple i
      have hzero := rightDescent_wall_eq_zero hA d hi hx hwx
      have hs : s.val x = x := simple_fixes_of_wall_eq_zero d hzero
      have hws : (w * s).val x = w.val x := by
        change w.val (s.val x) = _
        rw [hs]
      have hshort : d.coxeter.length (w * s) < n := hl ▸ hi
      obtain ⟨heq, hmem⟩ := ih _ hshort (w * s) (hws ▸ hwx) rfl
      refine ⟨hws.symm.trans heq, ?_⟩
      have hsimple : s ∈ standardWallSubgroup d.coxeter {i | A.wallValue i.val x = 0} :=
        Subgroup.subset_closure ⟨i, hzero, rfl⟩
      simpa only [s, mul_assoc, d.coxeter.simple_mul_simple_self, mul_one] using
        (standardWallSubgroup d.coxeter _).mul_mem hmem hsimple

/-- In the rational apartment the point stabilizer is generated precisely by
the simple walls passing through the point. -/
theorem closedAlcove_stabilizer (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    {x : V} (hx : InClosedAlcove A p x) (w : A.affineWeylGroup) :
    w.val x = x ↔ w ∈ standardWallSubgroup d.coxeter {i | A.wallValue i.val x = 0} := by
  refine ⟨fun heq => (closedAlcove_transporter hA d hx w (heq.symm ▸ hx)).2, ?_⟩
  intro hw
  refine Subgroup.closure_induction (p := fun w _ => w.val x = x) ?_ rfl ?_ ?_ hw
  · rintro _ ⟨i, hi, rfl⟩
    exact simple_fixes_of_wall_eq_zero d hi
  · intro a b _ _ ha hb
    change a.val (b.val x) = x
    rw [hb, ha]
  · intro a _ ha
    exact (a.val.symm_apply_eq).2 ha.symm

/-- The standard subgroup fixes exactly the prescribed collection of
unomitted vertices in the sense of its common point stabilizer. -/
theorem mem_standardWallSubgroup_iff_fix_vertices (hA : AlcoveGeometry A p)
    (d : AlcoveCoxeterData A p) (vertex : A.SimpleWall p → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (T : Set (A.SimpleWall p)) (w : A.affineWeylGroup) :
    w ∈ standardWallSubgroup d.coxeter T ↔ ∀ i ∉ T, w.val (vertex i) = vertex i := by
  constructor
  · intro hw i hi
    apply (closedAlcove_stabilizer hA d (hv i).1 w).2
    refine Subgroup.closure_mono ?_ hw
    rintro _ ⟨j, hj, rfl⟩
    exact ⟨j, (hv i).2 j |>.2 (fun h => hi (h ▸ hj)), rfl⟩
  · intro hfix
    induction hl : d.coxeter.length w using Nat.strong_induction_on generalizing w with
    | h n ih =>
      by_cases hw : w = 1
      · exact hw.symm ▸ (standardWallSubgroup d.coxeter T).one_mem
      · obtain ⟨i, hi⟩ := d.coxeter.exists_rightDescent_of_ne_one hw
        have hiT : i ∈ T := by
          by_contra hn
          have hfixi := hfix i hn
          have hzero := rightDescent_wall_eq_zero hA d hi (hv i).1 (hfixi.symm ▸ (hv i).1)
          exact ((hv i).2 i).1 hzero rfl
        let s := d.coxeter.simple i
        have hfix' (j : A.SimpleWall p) (hj : j ∉ T) :
            (w * s).val (vertex j) = vertex j := by
          have hzero := ((hv j).2 i).2 (fun h => hj (h ▸ hiT))
          change w.val (s.val (vertex j)) = _
          rw [simple_fixes_of_wall_eq_zero d hzero, hfix j hj]
        have hshort : d.coxeter.length (w * s) < n := hl ▸ hi
        have hmem := ih _ hshort (w * s) hfix' rfl
        have hs : s ∈ standardWallSubgroup d.coxeter T := Subgroup.subset_closure ⟨i, hiT, rfl⟩
        simpa only [s, mul_assoc, d.coxeter.simple_mul_simple_self, mul_one] using
          (standardWallSubgroup d.coxeter T).mul_mem hmem hs

/-- The standard-subgroup intersection rule, read on the marked vertices. -/
theorem standardWallSubgroup_inf (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : A.SimpleWall p → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (T U : Set (A.SimpleWall p)) :
    standardWallSubgroup d.coxeter T ⊓ standardWallSubgroup d.coxeter U =
      standardWallSubgroup d.coxeter (T ∩ U) := by
  classical
  ext w
  change (w ∈ standardWallSubgroup d.coxeter T ∧ w ∈ standardWallSubgroup d.coxeter U) ↔ _
  simp only [mem_standardWallSubgroup_iff_fix_vertices hA d vertex hv, Set.mem_inter_iff, not_and_or]
  exact ⟨fun ⟨hT, hU⟩ i hi => hi.elim (hT i) (hU i),
    fun h => ⟨fun i hi => h i (Or.inl hi), fun i hi => h i (Or.inr hi)⟩⟩

/-- The linear part of any signed-wall symmetry permutes the finite set of
root functionals. This follows by subtracting the constant terms. -/
theorem root_comp_linear_mem_range {g : V ≃ᵃ[ℚ] V} (hg : g ∈ A.symmetries) (i : J) :
    (A.root i).comp g.linear.toLinearMap ∈ Set.range A.root := by
  obtain ⟨σ, hσ⟩ := hg
  let a := σ.symm (i, 0)
  have h (x : V) : A.wallValue (i, 0) (g x) = A.wallValue a x := by
    simpa only [a, Equiv.apply_symm_apply] using (hσ a).1 x
  refine ⟨a.1, LinearMap.ext fun x => ?_⟩
  have hx := h x
  have h0 := h 0
  change A.root i (g x) + (↑(0 : ℤ) : ℚ) = A.root a.1 x + (a.2 : ℚ) at hx
  change A.root i (g 0) + (↑(0 : ℤ) : ℚ) = A.root a.1 0 + (a.2 : ℚ) at h0
  have hgx : g x = g.linear x + g 0 := by
    simpa only [vadd_eq_add, add_zero] using g.map_vadd (0 : V) x
  rw [hgx, map_add] at hx
  rw [(A.root a.1).map_zero] at h0
  change A.root a.1 x = A.root i (g.linear x)
  linarith only [hx, h0]

/-- When the roots separate vectors, an affine Weyl element fixing a point
is determined by its permutation of the finitely many root functionals. -/
theorem finite_standardWallSubgroup [Finite J] (hA : AlcoveGeometry A p)
    (d : AlcoveCoxeterData A p) (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (vertex : A.SimpleWall p → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (T : Set (A.SimpleWall p)) (hT : T ≠ univ) :
    Finite (standardWallSubgroup d.coxeter T) := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, i ∉ T := by
    by_contra! h
    exact hT (Set.eq_univ_iff_forall.mpr h)
  let x := vertex i
  let P := standardWallSubgroup d.coxeter T
  have hfix (w : P) : w.val.val x = x :=
    (mem_standardWallSubgroup_iff_fix_vertices hA d vertex hv T w).mp w.property i hi
  have : Finite (Set.range A.root) := Set.finite_coe_iff.mpr (Set.finite_range _)
  let roots (w : P) (j : J) : Set.range A.root :=
    ⟨(A.root j).comp w.val.val.linear.toLinearMap,
      root_comp_linear_mem_range (hA.ordinary_symmetries w.val.property) j⟩
  refine Finite.of_injective roots (fun w v h => ?_)
  apply Subtype.ext
  apply Subtype.ext
  ext y
  have hlin : w.val.val.linear (y - x) = v.val.val.linear (y - x) :=
    hsep _ _ (fun j => congrArg (fun f : Set.range A.root => f.val (y - x)) (congrFun h j))
  have translate (f : V ≃ᵃ[ℚ] V) (hf : f x = x) :
      f y = f.linear (y - x) + x := by
    have hxy : (y - x) +ᵥ x = y := by simp
    calc
      f y = f ((y - x) +ᵥ x) := congrArg f hxy.symm
      _ = f.linear (y - x) + x := by rw [AffineEquiv.map_vadd, hf, vadd_eq_add]
  rw [translate _ (hfix w), translate _ (hfix v), hlin]

end RationalAlcove

section RealScalarExtension

open LinearAlgebraicGroups.Specs.ExceptionalRealAlcove
  (EuclideanApartment RealCoordinates rationalPoint realAffine realWallValue)
open LinearAlgebraicGroups.Specs.ExceptionalAffineRootSystems (ApartmentRoots)
open scoped TensorProduct

variable {V V' V'' : Type uG}
  [AddCommGroup V] [Module ℚ V] [AddCommGroup V'] [Module ℚ V']
  [AddCommGroup V''] [Module ℚ V'']

/-- Scalar extension of a rational affine equivalence, bundled in the
specified linear coordinates over the reals. -/
noncomputable def realAffineEquiv (r : RealCoordinates V) (r' : RealCoordinates V')
    (f : V ≃ᵃ[ℚ] V') : EuclideanApartment V ≃ᵃ[ℝ] EuclideanApartment V' :=
  let l := r.symm.trans <| (TensorProduct.AlgebraTensorModule.congr
    (LinearEquiv.refl ℝ ℝ) f.linear).trans r'
  l.toAffineEquiv.trans (AffineEquiv.constVAdd ℝ _ (rationalPoint r' (f 0)))

theorem realAffineEquiv_apply (r : RealCoordinates V) (r' : RealCoordinates V')
    (f : V ≃ᵃ[ℚ] V') (x : EuclideanApartment V) :
    realAffineEquiv r r' f x = realAffine r r' f x := by
  change r' (1 ⊗ₜ[ℚ] f 0) + r' (f.linear.toLinearMap.baseChange ℝ (r.symm x)) = _
  rw [realAffine, map_add, add_comm]

@[simp]
theorem realAffine_rationalPoint (r : RealCoordinates V) (r' : RealCoordinates V')
    (f : V ≃ᵃ[ℚ] V') (x : V) :
    realAffine r r' f (rationalPoint r x) = rationalPoint r' (f x) := by
  rw [realAffine, rationalPoint, LinearEquiv.symm_apply_apply, LinearMap.baseChange_tmul,
    ← TensorProduct.tmul_add]
  have h : f x = f.linear x + f 0 := by
    simpa only [vadd_eq_add, add_zero] using f.map_vadd (0 : V) x
  change rationalPoint r' (f.linear x + f 0) = rationalPoint r' (f x)
  exact congrArg (rationalPoint r') h.symm

/-- A real affine map out of the scalar extension is determined by its
values at rational points, since their differences span the tensor product. -/
theorem affineMap_ext_rational (r : RealCoordinates V) {E : Type*} [AddCommGroup E] [Module ℝ E]
    {f g : EuclideanApartment V →ᵃ[ℝ] E} (h : ∀ x, f (rationalPoint r x) = g (rationalPoint r x)) :
    f = g := by
  have h0 : f 0 = g 0 := by simpa only [rationalPoint, TensorProduct.tmul_zero, map_zero] using h 0
  have hlin (x : V) : f.linear (rationalPoint r x) = g.linear (rationalPoint r x) := by
    have hf := f.linear_apply_vsub (rationalPoint r x) 0
    have hg := g.linear_apply_vsub (rationalPoint r x) 0
    simp only [vsub_eq_sub, sub_zero] at hf hg
    rw [hf, hg, h, h0]
  refine AffineMap.ext_linear ?_ h0
  have heq : f.linear.comp r.toLinearMap = g.linear.comp r.toLinearMap := by
    apply LinearMap.ext
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a x =>
        have ha : (a ⊗ₜ[ℚ] x) = a • ((1 : ℝ) ⊗ₜ[ℚ] x) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [ha, map_smul, map_smul]
        exact congrArg (a • ·) (hlin x)
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  apply LinearMap.ext
  intro x
  simpa only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] using
    DFunLike.congr_fun heq (r.symm x)

theorem realAffineEquiv_trans (r : RealCoordinates V) (r' : RealCoordinates V')
    (r'' : RealCoordinates V'') (f : V ≃ᵃ[ℚ] V') (g : V' ≃ᵃ[ℚ] V'') :
    realAffineEquiv r r'' (f.trans g) =
      (realAffineEquiv r r' f).trans (realAffineEquiv r' r'' g) := by
  apply AffineEquiv.toAffineMap_injective
  apply affineMap_ext_rational r
  intro x
  change realAffineEquiv r r'' (f.trans g) (rationalPoint r x) =
    realAffineEquiv r' r'' g (realAffineEquiv r r' f (rationalPoint r x))
  simp only [realAffineEquiv_apply, realAffine_rationalPoint, AffineEquiv.trans_apply]

theorem realAffineEquiv_refl (r : RealCoordinates V) :
    realAffineEquiv r r (AffineEquiv.refl ℚ V) = AffineEquiv.refl ℝ (EuclideanApartment V) := by
  apply AffineEquiv.toAffineMap_injective
  apply affineMap_ext_rational r
  intro x
  change realAffineEquiv r r (AffineEquiv.refl ℚ V) (rationalPoint r x) = rationalPoint r x
  rw [realAffineEquiv_apply, realAffine_rationalPoint]
  rfl

/-- The ordinary Weyl action on the rational apartment extends to the
specified real apartment. -/
@[instance_reducible]
noncomputable def realWeylAction {J : Type*} (A : ApartmentRoots ℚ V J) (r : RealCoordinates V) :
    MulAction A.affineWeylGroup (EuclideanApartment V) where
  smul w x := realAffineEquiv r r w.val x
  one_smul x := by
    change realAffineEquiv r r (AffineEquiv.refl ℚ V) x = x
    rw [realAffineEquiv_refl]
    rfl
  mul_smul w v x := by
    change realAffineEquiv r r (v.val.trans w.val) x =
      realAffineEquiv r r w.val (realAffineEquiv r r v.val x)
    rw [realAffineEquiv_trans]
    rfl

/-- A normalized wall equation in the real coordinates is an affine map. -/
noncomputable def realWallMap {J : Type*} (A : ApartmentRoots ℚ V J) (r : RealCoordinates V)
    (a : J × ℤ) : EuclideanApartment V →ᵃ[ℝ] ℝ :=
  let l := (TensorProduct.AlgebraTensorModule.rid ℚ ℝ ℝ).toLinearMap ∘ₗ
    (A.root a.1).baseChange ℝ ∘ₗ r.symm.toLinearMap
  { toFun := realWallValue A r a
    linear := l
    map_vadd' := fun p v => by
      change l (v + p) + (a.2 : ℝ) = l v + (l p + (a.2 : ℝ))
      rw [map_add, add_assoc] }

@[simp]
theorem realWallValue_rationalPoint {J : Type*} (A : ApartmentRoots ℚ V J) (r : RealCoordinates V)
    (a : J × ℤ) (x : V) :
    realWallValue A r a (rationalPoint r x) = (A.wallValue a x : ℝ) := by
  rw [realWallValue, rationalPoint, LinearEquiv.symm_apply_apply, LinearMap.baseChange_tmul,
    TensorProduct.AlgebraTensorModule.rid_tmul]
  change A.root a.1 x • (1 : ℝ) + (a.2 : ℝ) = ((A.root a.1 x + (a.2 : ℚ) : ℚ) : ℝ)
  simp only [Rat.cast_add, Rat.cast_intCast, Rat.smul_def, mul_one]

/-- A rational affine equality between wall equations extends to the
real coordinates, including a change of the marked apartment. -/
theorem realWallValue_comp_of_rational {J J' : Type*}
    (A : ApartmentRoots ℚ V J) (A' : ApartmentRoots ℚ V' J')
    (r : RealCoordinates V) (r' : RealCoordinates V') (a : J × ℤ) (a' : J' × ℤ) (f : V ≃ᵃ[ℚ] V')
    (h : ∀ x, A'.wallValue a' (f x) = A.wallValue a x) (x : EuclideanApartment V) :
    realWallValue A' r' a' (realAffine r r' f x) = realWallValue A r a x := by
  have heq : (realWallMap A' r' a').comp (realAffineEquiv r r' f).toAffineMap = realWallMap A r a :=
    affineMap_ext_rational r (fun y => by
      change realWallValue A' r' a' (realAffineEquiv r r' f (rationalPoint r y)) =
        realWallValue A r a (rationalPoint r y)
      simp only [realAffineEquiv_apply, realAffine_rationalPoint, realWallValue_rationalPoint, h])
  rw [← realAffineEquiv_apply]
  exact AffineMap.congr_fun heq x

end RealScalarExtension

section RealWalls

open Filter
open scoped Topology

variable {V : Type uG} {J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V} (r : RealCoordinates V)

private theorem rationalPoint_add (x y : V) :
    rationalPoint r (x + y) = rationalPoint r x + rationalPoint r y := by
  simp [rationalPoint, TensorProduct.tmul_add]

private theorem rationalPoint_smul (c : ℚ) (x : V) :
    rationalPoint r (c • x) = (c : ℝ) • rationalPoint r x := by
  unfold rationalPoint
  rw [← TensorProduct.smul_tmul, ← map_smul, ← TensorProduct.smul_tmul']
  congr 2

theorem denseRange_rationalPoint : DenseRange (rationalPoint r) := by
  let f : V →+ EuclideanApartment V :=
    { toFun := rationalPoint r
      map_zero' := by simp [rationalPoint]
      map_add' := rationalPoint_add r }
  let S := f.range
  intro x
  change x ∈ (S.topologicalClosure : Set _)
  have hx : r (r.symm x) ∈ S.topologicalClosure := by
    refine TensorProduct.inductionOn (motive := fun z => r z ∈ S.topologicalClosure) (r.symm x) ?_ ?_
    · intro a y
      change r (a ⊗ₜ[ℚ] y) ∈ closure (S : Set _)
      have hc : Continuous (fun t : ℝ => t • rationalPoint r y) :=
        continuous_id.smul continuous_const
      have h := mem_closure_image (hc.continuousAt (x := a)) (Rat.denseRange_cast a)
      have hs : (fun t : ℝ => t • rationalPoint r y) '' range ((↑) : ℚ → ℝ) ⊆ S := by
        rintro _ ⟨_, ⟨c, rfl⟩, rfl⟩
        exact ⟨c • y, rationalPoint_smul r c y⟩
      have he : r (a ⊗ₜ[ℚ] y) = a • rationalPoint r y := by
        rw [rationalPoint, TensorProduct.tmul_eq_smul_one_tmul, map_smul]
      exact he ▸ closure_mono hs h
    · intro z₁ z₂ h₁ h₂
      rw [map_add]
      exact S.topologicalClosure.add_mem h₁ h₂
  change x ∈ S.topologicalClosure
  simpa only [LinearEquiv.apply_symm_apply] using hx

theorem realWallValue_level (i : J) (n : ℤ) (x : EuclideanApartment V) :
    realWallValue A r (i, n) x = realWallValue A r (i, 0) x + n := by
  simp [realWallValue]

theorem continuous_realWallValue (a : J × ℤ) :
    Continuous (realWallValue A r a) :=
  (realWallMap A r a).continuous_of_finiteDimensional

theorem wallValue_lineMap (a : J × ℤ) (x y : EuclideanApartment V) (t : ℝ) :
    realWallValue A r a (AffineMap.lineMap x y t) =
      (1 - t) * realWallValue A r a x + t * realWallValue A r a y := by
  exact ((realWallMap A r a).apply_lineMap x y t).trans
    (AffineMap.lineMap_apply_ring _ _ _)

private theorem eventually_wall_bounds [Finite J] (x : EuclideanApartment V) :
    ∀ᶠ y in 𝓝 x, ∀ i : J, |realWallValue A r (i, 0) y - realWallValue A r (i, 0) x| < 1 := by
  rw [Filter.eventually_all]
  intro i
  have hc := ((continuous_realWallValue (A := A) r (i, 0)).sub
    (continuous_const (y := realWallValue A r (i, 0) x))).abs.continuousAt (x := x)
  exact hc.eventually_lt continuousAt_const (by simp)

private def nearbyWalls (x : EuclideanApartment V) : Set (J × ℤ) :=
  {a | a.2 ∈ Icc ⌈-realWallValue A r (a.1, 0) x - 1⌉
    ⌊-realWallValue A r (a.1, 0) x + 1⌋}

private theorem nearbyWalls_finite [Finite J] (x : EuclideanApartment V) :
    (nearbyWalls (A := A) r x).Finite := by
  apply Set.Finite.of_finite_fibers Prod.fst (Set.toFinite _)
  intro i _
  apply (Set.finite_Icc (⌈-realWallValue A r (i, 0) x - 1⌉ : ℤ)
    ⌊-realWallValue A r (i, 0) x + 1⌋).of_injOn (f := Prod.snd)
  · rintro ⟨j, n⟩ ⟨hn, hj⟩
    change j = i at hj
    subst j
    exact hn
  · rintro ⟨j, n⟩ ⟨_, hj⟩ ⟨k, m⟩ ⟨_, hk⟩ hn
    exact Prod.ext (hj.trans hk.symm) hn

private theorem mem_nearbyWalls_iff (x : EuclideanApartment V) (a : J × ℤ) :
    a ∈ nearbyWalls (A := A) r x ↔ |realWallValue A r a x| ≤ 1 := by
  obtain ⟨i, n⟩ := a
  simp only [nearbyWalls, mem_ofPred_eq, mem_Icc, Int.ceil_le, Int.le_floor,
    realWallValue_level r i n, abs_le]
  constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]

theorem locallyFinite_walls [Finite J] :
    LocallyFinite (fun a : J × ℤ => {x | realWallValue A r a x = 0}) := by
  intro x
  refine ⟨_, eventually_wall_bounds (A := A) r x, (nearbyWalls_finite (A := A) r x).subset ?_⟩
  rintro ⟨i, n⟩ ⟨y, hy, hz⟩
  change realWallValue A r (i, n) y = 0 at hy
  rw [mem_nearbyWalls_iff]
  have h := hz i
  rw [realWallValue_level] at hy ⊢
  have hn : (n : ℝ) = -realWallValue A r (i, 0) y := by linarith
  rw [hn, ← sub_eq_add_neg, ← neg_sub, abs_neg]
  exact h.le

private theorem eventually_same_signs [Finite J] (x : EuclideanApartment V) :
    ∀ᶠ y in 𝓝 x, ∀ a : J × ℤ,
      (0 < realWallValue A r a x → 0 < realWallValue A r a y) ∧
      (realWallValue A r a x < 0 → realWallValue A r a y < 0) := by
  have hfin : ∀ᶠ y in 𝓝 x, ∀ a ∈ nearbyWalls (A := A) r x,
      (0 < realWallValue A r a x → 0 < realWallValue A r a y) ∧
      (realWallValue A r a x < 0 → realWallValue A r a y < 0) := by
    rw [Filter.eventually_all_finite (nearbyWalls_finite (A := A) r x)]
    intro a _
    have hc := (continuous_realWallValue (A := A) r a).continuousAt (x := x)
    exact (by
      by_cases h : 0 < realWallValue A r a x
      · exact (continuousAt_const.eventually_lt hc h).mono fun _ hy => fun _ => hy
      · exact Filter.Eventually.of_forall fun _ hx => False.elim (h hx)
      : ∀ᶠ y in 𝓝 x, 0 < realWallValue A r a x → 0 < realWallValue A r a y).and (by
      by_cases h : realWallValue A r a x < 0
      · exact (hc.eventually_lt continuousAt_const h).mono fun _ hy => fun _ => hy
      · exact Filter.Eventually.of_forall fun _ hx => False.elim (h hx))
  filter_upwards [eventually_wall_bounds (A := A) r x, hfin] with y hb hf a
  by_cases ha : a ∈ nearbyWalls (A := A) r x
  · exact hf a ha
  · obtain ⟨i, n⟩ := a
    rw [mem_nearbyWalls_iff, abs_le, not_and_or, not_le, not_le] at ha
    have hi := abs_lt.mp (hb i)
    rw [realWallValue_level r i n x] at ha
    rw [realWallValue_level r i n x, realWallValue_level r i n y]
    rcases ha with ha | ha <;> constructor <;> intro hh <;> linarith [hi.1, hi.2]

theorem rational_regular_iff (q : V) :
    A.IsRegular q ↔ ∀ a, realWallValue A r a (rationalPoint r q) ≠ 0 := by
  simp only [realWallValue_rationalPoint, Rat.cast_ne_zero]
  constructor
  · rintro h ⟨i, n⟩ hn
    refine h i ⟨-n, ?_⟩
    change A.root i q + (n : ℚ) = 0 at hn
    rw [Int.cast_neg]
    linarith
  · rintro h i ⟨n, hn⟩
    apply h (i, -n)
    change A.root i q + ((-n : ℤ) : ℚ) = 0
    simp [← hn]

private theorem rationalPoint_lineMap (x y : V) (c : ℚ) :
    rationalPoint r (AffineMap.lineMap x y c) =
      AffineMap.lineMap (rationalPoint r x) (rationalPoint r y) (c : ℝ) := by
  simp only [AffineMap.lineMap_apply_module, rationalPoint_add, rationalPoint_smul, Rat.cast_sub,
    Rat.cast_one]

/-- A small move from a rational point toward the marked regular point avoids
every wall passing through the rational point and preserves its nonzero signs. -/
theorem dense_rational_regular [Finite J] (hp : A.IsRegular p) :
    Dense (rationalPoint r '' {q | A.IsRegular q}) := by
  have hreg := (rational_regular_iff (A := A) r p).mp hp
  have hsub : range (rationalPoint r) ⊆ closure (rationalPoint r '' {q | A.IsRegular q}) := by
    rintro _ ⟨q, rfl⟩
    apply mem_closure_iff_nhds.mpr
    intro U hU
    let f : ℝ →ᵃ[ℝ] EuclideanApartment V :=
      AffineMap.lineMap (rationalPoint r q) (rationalPoint r p)
    have hf : Continuous f := f.continuous_of_finiteDimensional
    have hq : f 0 = rationalPoint r q := AffineMap.lineMap_apply_zero _ _
    have he : ∀ᶠ t in 𝓝 (0 : ℝ), f t ∈ U ∧ ∀ a : J × ℤ,
        (0 < realWallValue A r a (rationalPoint r q) → 0 < realWallValue A r a (f t)) ∧
        (realWallValue A r a (rationalPoint r q) < 0 → realWallValue A r a (f t) < 0) :=
      hf.continuousAt (x := 0) (by
        rw [hq]
        have hU' : ∀ᶠ z in 𝓝 (rationalPoint r q), z ∈ U := hU
        exact hU'.and (eventually_same_signs (A := A) r (rationalPoint r q)))
    obtain ⟨ε, hε, heε⟩ := Metric.eventually_nhds_iff.mp he
    obtain ⟨t, ht0, htε⟩ := exists_rat_btwn hε
    have ht := heε (y := (t : ℝ)) (by
      rw [Real.dist_eq, sub_zero, abs_of_pos ht0]
      exact htε)
    have hft : f t = rationalPoint r (AffineMap.lineMap q p t) := (rationalPoint_lineMap r q p t).symm
    refine ⟨f t, ht.1, AffineMap.lineMap q p t, ?_, hft.symm⟩
    apply (rational_regular_iff r _).mpr
    rw [← hft]
    intro a
    rcases lt_trichotomy (realWallValue A r a (rationalPoint r q)) 0 with h | h | h
    · exact (ht.2 a).2 h |>.ne
    · change realWallValue A r a (AffineMap.lineMap _ _ _) ≠ 0
      rw [wallValue_lineMap, h, mul_zero, zero_add]
      exact mul_ne_zero ht0.ne' (hreg a)
    · exact ((ht.2 a).1 h).ne'
  exact fun x => closure_minimal hsub isClosed_closure (denseRange_rationalPoint r x)

theorem exists_rational_regular_near [Finite J] (hp : A.IsRegular p) (x : EuclideanApartment V) :
    ∃ q : V, A.IsRegular q ∧ ∀ a : J × ℤ,
      (0 < realWallValue A r a x → 0 < A.wallValue a q) ∧
      (realWallValue A r a x < 0 → A.wallValue a q < 0) := by
  obtain ⟨_, hx, q, hq, rfl⟩ := mem_closure_iff_nhds.mp (dense_rational_regular r hp x) _
    (eventually_same_signs (A := A) r x)
  refine ⟨q, hq, fun a => ?_⟩
  have h := hx a
  rw [realWallValue_rationalPoint, Rat.cast_pos, Rat.cast_lt_zero] at h
  exact h

end RealWalls

section RealChambers

open Filter
open scoped Topology

variable {V : Type uG} {J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V} (r : RealCoordinates V)

local notation "E" => EuclideanApartment V
local notation "W" => A.affineWeylGroup
local notation "B" => A.SimpleWall p

@[simp]
theorem realAffine_one (x : E) : realAffine r r ((1 : W).val) x = x := by
  let := realWeylAction A r
  rw [← realAffineEquiv_apply]
  exact one_smul W x

theorem realAffine_mul (w v : W) (x : E) :
    realAffine r r (w * v).val x = realAffine r r w.val (realAffine r r v.val x) := by
  let := realWeylAction A r
  simp only [← realAffineEquiv_apply]
  exact mul_smul w v x

theorem realAffine_inv (w : W) (x : E) :
    realAffine r r w⁻¹.val (realAffine r r w.val x) = x := by
  rw [← realAffine_mul, inv_mul_cancel, realAffine_one]

theorem realWallEquation (d : AlcoveCoxeterData A p) (w : W) (a : J × ℤ) (x : E) :
    let := d.action
    realWallValue A r (w • a) (realAffine r r w.val x) = realWallValue A r a x := by
  let := d.action
  apply realWallValue_comp_of_rational
  intro y
  rw [d.equation, AffineEquiv.symm_apply_apply]

theorem realReflection_apply (a : J × ℤ) (x : E) :
    realAffine r r (A.reflection a) x =
      x - realWallValue A r a x • rationalPoint r (A.coroot a.1) := by
  let l : ℝ →ₗ[ℝ] E := (LinearMap.id : ℝ →ₗ[ℝ] ℝ).smulRight (rationalPoint r (A.coroot a.1))
  let f : E →ᵃ[ℝ] E := AffineMap.id ℝ E - l.toAffineMap.comp (realWallMap A r a)
  have h : (realAffineEquiv r r (A.reflection a)).toAffineMap = f := by
    apply affineMap_ext_rational r
    intro y
    change realAffineEquiv r r (A.reflection a) (rationalPoint r y) =
      rationalPoint r y - realWallValue A r a (rationalPoint r y) • rationalPoint r (A.coroot a.1)
    rw [realAffineEquiv_apply, realAffine_rationalPoint, reflection_apply,
      sub_eq_add_neg, rationalPoint_add, ← neg_smul, rationalPoint_smul,
      Rat.cast_neg, neg_smul, ← sub_eq_add_neg, realWallValue_rationalPoint]
  rw [← realAffineEquiv_apply]
  exact AffineMap.congr_fun h x

private theorem realWall_nonpos_of_negative (hA : AlcoveGeometry A p)
    {a : J × ℤ} (ha : A.wallValue a p < 0) {x : E} (hx : RealClosed A p r x) :
    realWallValue A r a x ≤ 0 := by
  obtain ⟨b, hb⟩ := exists_opposite_wall hA a
  have hp : A.positive p b := by
    change 0 < A.wallValue b p
    rw [hb]
    exact neg_pos.mpr ha
  have hh : realWallMap A r b = -realWallMap A r a := by
    apply affineMap_ext_rational r
    intro y
    change realWallValue A r b (rationalPoint r y) = -realWallValue A r a (rationalPoint r y)
    rw [realWallValue_rationalPoint, realWallValue_rationalPoint, hb, Rat.cast_neg]
  have he := hx b hp
  change 0 ≤ realWallMap A r b x at he
  rw [hh] at he
  exact neg_nonneg.mp he

theorem finite_simpleWalls [Finite J] : Finite B := by
  refine Finite.of_injective (fun a : B => a.val.1) ?_
  rintro ⟨⟨i, n⟩, hn⟩ ⟨⟨j, m⟩, hm⟩ (h : i = j)
  subst j
  have le_level (a b : ℤ) (ha : A.IsSimple p (i, a)) (hb : A.IsSimple p (i, b)) : a ≤ b := by
    by_contra! h
    obtain ⟨x, hx, hothers⟩ := ha.2
    have hx' := hothers (i, b) hb.1 (by simp [h.ne])
    change A.root i x + (a : ℚ) = 0 at hx
    change 0 < A.root i x + (b : ℚ) at hx'
    have hh : (b : ℚ) < (a : ℚ) := by exact_mod_cast h
    linarith
  exact Subtype.ext (Prod.ext rfl ((le_level n m hn hm).antisymm (le_level m n hm hn)))

theorem exists_realClosed_translate [Finite J] (hA : AlcoveGeometry A p)
    (d : AlcoveCoxeterData A p) (x : E) :
    ∃ w : W, RealClosed A p r (realAffine r r w.val x) := by
  let := d.action
  obtain ⟨q, hq, hsign⟩ := exists_rational_regular_near r hA.regular x
  obtain ⟨w, hw, _⟩ := hA.simply_transitive q hq
  have hmem : q ∈ A.alcove q := fun _ ha => ha
  rw [← hw] at hmem
  obtain ⟨y, hy, rfl⟩ := hmem
  refine ⟨w⁻¹, fun a ha => ?_⟩
  have hwe := realWallEquation r d w a (realAffine r r w⁻¹.val x)
  rw [← realAffine_mul, mul_inv_cancel, realAffine_one] at hwe
  rw [← hwe]
  by_contra! hneg
  have hh := (hsign (w • a)).2 hneg
  rw [d.equation, AffineEquiv.symm_apply_apply] at hh
  exact hh.not_gt (hy a ha)

theorem realClosed_transporter (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    {x : E} (hx : RealClosed A p r x) (w : W)
    (hwx : RealClosed A p r (realAffine r r w.val x)) :
    realAffine r r w.val x = x ∧
      w ∈ standardWallSubgroup d.coxeter {i | realWallValue A r i.val x = 0} := by
  let := d.action
  induction hl : d.coxeter.length w using Nat.strong_induction_on generalizing w with
  | h n ih =>
    by_cases hw : w = 1
    · subst w
      exact ⟨realAffine_one r x, Subgroup.one_mem _⟩
    · obtain ⟨i, hi⟩ := d.coxeter.exists_rightDescent_of_ne_one hw
      let s := d.coxeter.simple i
      have hnonpos := realWall_nonpos_of_negative r hA ((d.right_descent w i).mp hi) hwx
      rw [realWallEquation r d] at hnonpos
      have hzero := hnonpos.antisymm (hx i.val i.property.1)
      have hs : realAffine r r s.val x = x := by
        rw [show s = A.simpleAffineReflection p i from congrFun d.simple_eq i]
        change realAffine r r (A.reflection i.val) x = x
        rw [realReflection_apply, hzero, zero_smul, sub_zero]
      have hws : realAffine r r (w * s).val x = realAffine r r w.val x := by
        rw [realAffine_mul, hs]
      have hshort : d.coxeter.length (w * s) < n := hl ▸ hi
      obtain ⟨heq, hmem⟩ := ih _ hshort (w * s) (hws ▸ hwx) rfl
      refine ⟨hws.symm.trans heq, ?_⟩
      have hsimple : s ∈ standardWallSubgroup d.coxeter {i | realWallValue A r i.val x = 0} :=
        Subgroup.subset_closure ⟨i, hzero, rfl⟩
      simpa only [s, mul_assoc, d.coxeter.simple_mul_simple_self, mul_one] using
        (standardWallSubgroup d.coxeter _).mul_mem hmem hsimple

theorem realClosed_stabilizer (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    {x : E} (hx : RealClosed A p r x) :
    standardWallSubgroup d.coxeter {i | realWallValue A r i.val x = 0} =
      Subgroup.closure ((fun a : J × ℤ =>
        (⟨A.reflection a, Subgroup.subset_closure ⟨a, rfl⟩⟩ : W)) ''
        {a | realWallValue A r a x = 0}) := by
  apply le_antisymm
  · apply Subgroup.closure_mono
    rintro _ ⟨i, hi, rfl⟩
    exact ⟨i.val, hi, (congrFun d.simple_eq i).symm⟩
  · rw [Subgroup.closure_le]
    rintro _ ⟨a, ha, rfl⟩
    let w : W := ⟨A.reflection a, Subgroup.subset_closure ⟨a, rfl⟩⟩
    have heq : realAffine r r w.val x = x := by
      change realAffine r r (A.reflection a) x = x
      rw [realReflection_apply, ha, zero_smul, sub_zero]
    exact (realClosed_transporter r hA d hx w (heq.symm ▸ hx)).2

private theorem realClosed_of_simple_pos [Finite J] (hA : AlcoveGeometry A p)
    (d : AlcoveCoxeterData A p) {x : E}
    (hx : ∀ i : B, 0 < realWallValue A r i.val x) :
    RealClosed A p r x := by
  let := d.action
  obtain ⟨w, hw⟩ := exists_realClosed_translate r hA d x
  by_cases he : w = 1
  · subst w
    rw [realAffine_one r] at hw
    exact hw
  · obtain ⟨i, hi⟩ := d.coxeter.exists_rightDescent_of_ne_one he
    have hn := realWall_nonpos_of_negative r hA ((d.right_descent w i).mp hi) hw
    rw [realWallEquation r d] at hn
    exact False.elim (hn.not_gt (hx i))

theorem realClosed_iff_simple [Finite J] (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (x : E) : RealClosed A p r x ↔ ∀ i : B, 0 ≤ realWallValue A r i.val x := by
  refine ⟨fun h i => h i.val i.property.1, fun h a ha => ?_⟩
  by_contra! hn
  let y : E := rationalPoint r p
  have hy : ∀ b, A.positive p b → 0 < realWallValue A r b y := by
    intro b hb
    rw [realWallValue_rationalPoint, Rat.cast_pos]
    exact hb
  let f : ℝ →ᵃ[ℝ] E := AffineMap.lineMap x y
  have hc : Continuous (fun t => realWallValue A r a (f t)) :=
    (continuous_realWallValue r a).comp f.continuous_of_finiteDimensional
  have he : ∀ᶠ t in 𝓝 (0 : ℝ), realWallValue A r a (f t) < 0 :=
    hc.continuousAt.eventually_lt continuousAt_const (by simpa [f] using hn)
  obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp he
  let t := min (ε / 2) (1 / 2)
  have ht : 0 < t := lt_min (by linarith) (by norm_num)
  have ht₁ : t ≤ 1 := (min_le_right _ _).trans (by norm_num)
  have htε : dist t 0 < ε := by
    rw [Real.dist_eq, sub_zero, abs_of_pos ht]
    exact (min_le_left _ _).trans_lt (by linarith)
  have hs (i : B) : 0 < realWallValue A r i.val (f t) := by
    rw [show f t = AffineMap.lineMap x y t from rfl, wallValue_lineMap]
    exact add_pos_of_nonneg_of_pos (mul_nonneg (sub_nonneg.mpr ht₁) (h i))
      (mul_pos ht (hy i.val i.property.1))
  exact (hnear htε).not_ge (realClosed_of_simple_pos r hA d hs a ha)

theorem realOpen_iff_simple [Finite J] (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (x : E) : RealOpen A p r x ↔ ∀ i : B, 0 < realWallValue A r i.val x := by
  refine ⟨fun h i => h i.val i.property.1, fun hx a ha => ?_⟩
  let := finite_simpleWalls (A := A) (p := p)
  let y : E := rationalPoint r p
  let f : ℝ →ᵃ[ℝ] E := AffineMap.lineMap x y
  have hs : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ i : B, 0 < realWallValue A r i.val (f t) := by
    rw [Filter.eventually_all]
    intro i
    have hc : Continuous (fun t => realWallValue A r i.val (f t)) :=
      (continuous_realWallValue r i.val).comp f.continuous_of_finiteDimensional
    exact continuousAt_const.eventually_lt hc.continuousAt (by simpa [f] using hx i)
  by_contra! hn
  obtain ⟨ε, hε, hnear⟩ := Metric.eventually_nhds_iff.mp hs
  let t := -(ε / 2)
  have ht : t < 0 := by dsimp [t]; linarith
  have htε : dist t 0 < ε := by
    rw [Real.dist_eq, sub_zero, abs_of_neg ht]
    dsimp [t]
    linarith
  have hy : 0 < realWallValue A r a y := by
    rw [realWallValue_rationalPoint, Rat.cast_pos]
    exact ha
  have hw := realClosed_of_simple_pos r hA d (hnear htε) a ha
  rw [show f t = AffineMap.lineMap x y t from rfl, wallValue_lineMap] at hw
  exact (add_neg_of_nonpos_of_neg (mul_nonpos_of_nonneg_of_nonpos (by linarith) hn)
    (mul_neg_of_neg_of_pos ht hy)).not_ge hw

/-- Moving the point by an ordinary Weyl element conjugates its wall group. -/
theorem wallReflectionGroup_translate (d : AlcoveCoxeterData A p) (w : W) (x : E) :
    (wallReflectionGroup A r x).map (MulAut.conj w).toMonoidHom =
      wallReflectionGroup A r (realAffine r r w.val x) := by
  let := d.action
  let refl : J × ℤ → W := fun a => ⟨A.reflection a, Subgroup.subset_closure ⟨a, rfl⟩⟩
  have hrefl (a : J × ℤ) : refl (w • a) = MulAut.conj w (refl a) := by
    have hd (b : J × ℤ) : d.walls.reflect b = refl b := Subtype.ext (d.reflection_eq b)
    change refl (w • a) = w * refl a * w⁻¹
    rw [← hd, d.walls.conjugate_reflect, hd]
  unfold wallReflectionGroup
  rw [MonoidHom.map_closure]
  apply congrArg Subgroup.closure
  ext g
  constructor
  · rintro ⟨_, ⟨a, ha, rfl⟩, rfl⟩
    refine ⟨w • a, ?_, hrefl a⟩
    change realWallValue A r (w • a) (realAffine r r w.val x) = 0
    rw [realWallEquation r d]
    exact ha
  · rintro ⟨a, ha, rfl⟩
    have hs : w • (w⁻¹ • a) = a := smul_inv_smul w a
    refine ⟨refl (w⁻¹ • a), ⟨w⁻¹ • a, ?_, rfl⟩, ?_⟩
    · change realWallValue A r (w⁻¹ • a) x = 0
      rw [← realWallEquation r d w (w⁻¹ • a), hs]
      exact ha
    · change MulAut.conj w (refl (w⁻¹ • a)) = refl a
      rw [← hrefl, hs]

end RealChambers

section SeparatingRoots

variable {R S X I : Type*} [CommRing R] [CommRing S] [Algebra R S] [Module.Flat R S]
  [AddCommGroup X] [Module R X] [Finite I]

/-- Extension of scalars preserves separation by a finite family of linear functionals. -/
private theorem separating_baseChange (forms : I → X →ₗ[R] R)
    (hforms : ∀ x y, (∀ i, forms i x = forms i y) → x = y) :
    ∀ x y : S ⊗[R] X,
      (∀ i, TensorProduct.AlgebraTensorModule.rid R S S ((forms i).baseChange S x) =
        TensorProduct.AlgebraTensorModule.rid R S S ((forms i).baseChange S y)) → x = y := by
  let := Fintype.ofFinite I
  classical
  let f := LinearMap.pi forms
  have hf : Function.Injective f := fun x y h => hforms x y (congrFun h)
  have hfS : Function.Injective (f.baseChange S) :=
    Module.Flat.lTensor_preserves_injective_linearMap f hf
  let e := TensorProduct.piScalarRight R S S I
  have h (z : S ⊗[R] X) (i : I) :
      e (f.baseChange S z) i =
        TensorProduct.AlgebraTensorModule.rid R S S ((forms i).baseChange S z) := by
    induction z using TensorProduct.inductionOn with
    | tmul a x =>
        simp [e, f, Algebra.smul_def, mul_comm]
    | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]
  intro x y hxy
  apply hfS
  apply e.injective
  ext i
  rw [h, h, hxy]

end SeparatingRoots

section Simplex

open LinearAlgebraicGroups.Arithmetic.AffineArrangement (Datum)

variable {V : Type uG} {J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V} (r : RealCoordinates V)

local notation "E" => EuclideanApartment V
local notation "B" => A.SimpleWall p
local notation "W" => A.affineWeylGroup

private theorem realWall_separates [Finite J]
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    {x y : E} (h : ∀ i, realWallValue A r (i, 0) x = realWallValue A r (i, 0) y) :
    x = y := by
  apply r.symm.injective
  refine separating_baseChange (S := ℝ) A.root hsep _ _ fun i => ?_
  simpa [realWallValue] using h i

private theorem slope_nonneg {a b : ℝ} (h : ∀ t : ℝ, 0 ≤ t → 0 ≤ a + t * b) : 0 ≤ b := by
  by_contra! hb
  have hab : 0 ≤ a := by simpa using h 0 le_rfl
  let t := (a + 1) / (-b)
  have ht : 0 ≤ t := div_nonneg (by linarith) (neg_pos.mpr hb).le
  have he : t * (-b) = a + 1 := div_mul_cancel₀ _ (neg_ne_zero.mpr hb.ne)
  linarith only [h t ht, he, mul_neg t b]

private theorem eq_of_realClosed_ray [Finite J] (hA : AlcoveGeometry A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    {x y : E} (h : ∀ t : ℝ, 0 ≤ t → RealClosed A p r (AffineMap.lineMap x y t)) :
    x = y := by
  apply realWall_separates r hsep
  intro i
  obtain ⟨n, hn⟩ := exists_int_gt (-A.root i p)
  have hn' : A.positive p (i, n) := by
    change 0 < A.root i p + (n : ℚ)
    linarith
  obtain ⟨m, hm⟩ := exists_int_lt (-A.root i p)
  have hm' : A.wallValue (i, m) p < 0 := by
    change A.root i p + (m : ℚ) < 0
    linarith
  have hpos : 0 ≤ realWallValue A r (i, 0) y - realWallValue A r (i, 0) x := by
    apply slope_nonneg (a := realWallValue A r (i, n) x)
    intro t ht
    have hp := h t ht (i, n) hn'
    rw [wallValue_lineMap, realWallValue_level r i n y] at hp
    rw [realWallValue_level r i n x] at hp ⊢
    nlinarith only [hp]
  have hneg : 0 ≤ realWallValue A r (i, 0) x - realWallValue A r (i, 0) y := by
    apply slope_nonneg (a := -realWallValue A r (i, m) x)
    intro t ht
    have hm := realWall_nonpos_of_negative r hA hm' (h t ht)
    rw [wallValue_lineMap, realWallValue_level r i m y,
      realWallValue_level r i m x] at hm
    rw [realWallValue_level r i m x]
    nlinarith only [hm]
  linarith

private theorem realClosed_base : RealClosed A p r (rationalPoint r p) := by
  intro a ha
  rw [realWallValue_rationalPoint, Rat.cast_nonneg]
  exact ha.le

private theorem no_common_simple_zero [Finite J] [Nonempty J]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (x : E) : ¬ ∀ i : B, realWallValue A r i.val x = 0 := by
  intro hx
  have hy (y : E) (hy : RealClosed A p r y) : x = y := by
    apply eq_of_realClosed_ray r hA hsep
    intro t ht
    apply (realClosed_iff_simple r hA d _).mpr
    intro i
    rw [wallValue_lineMap, hx i, mul_zero, zero_add]
    exact mul_nonneg ht (hy i.val i.property.1)
  have he := hy _ (realClosed_base r)
  have hempty (i : B) : False := by
    have hi := i.property.1
    have hz := hx i
    rw [he, realWallValue_rationalPoint, Rat.cast_eq_zero] at hz
    exact hi.ne' hz
  let i : J := Classical.choice ‹Nonempty J›
  have h₀ : x = 0 := hy 0 ((realClosed_iff_simple r hA d _).mpr fun j => (hempty j).elim)
  have h₁ : x = rationalPoint r (A.coroot i) :=
    hy _ ((realClosed_iff_simple r hA d _).mpr fun j => (hempty j).elim)
  have hwall := realWallValue_rationalPoint A r (i, 0) (A.coroot i)
  rw [← h₁, h₀] at hwall
  change _ = ((A.root i (A.coroot i) + (0 : ℤ) : ℚ) : ℝ) at hwall
  simp [realWallValue, A.diagonal] at hwall

private theorem simple_values_injective [Finite J]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    {x y : E} (hxy : ∀ i : B, realWallValue A r i.val x = realWallValue A r i.val y) :
    x = y := by
  let z := rationalPoint r p
  have hz (i : B) :
      realWallValue A r i.val (z + (x - y)) = realWallValue A r i.val z := by
    let l := realWallMap A r i.val
    have hlin := l.linear_apply_vsub x y
    change l.linear (x - y) = realWallValue A r i.val x - realWallValue A r i.val y at hlin
    rw [hxy, sub_self] at hlin
    rw [add_comm z]
    change l ((x - y) +ᵥ z) = l z
    rw [l.map_vadd, hlin, zero_vadd]
  have he : z = z + (x - y) := by
    apply eq_of_realClosed_ray r hA hsep
    intro t _
    apply (realClosed_iff_simple r hA d _).mpr
    intro i
    rw [wallValue_lineMap, hz]
    linarith only [realClosed_base (A := A) (p := p) r i.val i.property.1]
  exact sub_eq_zero.mp (by simpa using left_eq_add.mp he : x - y = 0)

private theorem opposite_vertex_pos (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (i : B) :
    0 < realWallValue A r i.val (rationalPoint r (vertex i)) := by
  rw [realWallValue_rationalPoint, Rat.cast_pos]
  exact lt_of_le_of_ne ((hv i).1 i.val i.property.1)
    (fun he => (hv i).2 i |>.mp he.symm |>.elim rfl)

private def normalizedWall (vertex : B → V) (i : B) : E →ᵃ[ℝ] ℝ :=
  (LinearMap.lsmul ℝ ℝ (realWallValue A r i.val (rationalPoint r (vertex i)))⁻¹).toAffineMap.comp
    (realWallMap A r i.val)

private theorem normalizedWall_apply (vertex : B → V) (i : B) (x : E) :
    normalizedWall r vertex i x =
      (realWallValue A r i.val (rationalPoint r (vertex i)))⁻¹ * realWallValue A r i.val x :=
  rfl

private theorem normalizedWall_vertex (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (i j : B) :
    normalizedWall r vertex i (rationalPoint r (vertex j)) = if i = j then 1 else 0 := by
  rw [normalizedWall_apply]
  split_ifs with h
  · subst j
    exact inv_mul_cancel₀ (opposite_vertex_pos r vertex hv i).ne'
  · rw [realWallValue_rationalPoint A r i.val (vertex j), ((hv j).2 i).2 h, Rat.cast_zero, mul_zero]

private theorem affine_on_weighted_sum {I : Type*} [Fintype I]
    (f : E →ᵃ[ℝ] ℝ) (v : I → E) (t : I → ℝ) (ht : ∑ i, t i = 1) :
    f (∑ i, t i • v i) = ∑ i, t i * f (v i) := by
  rw [← Finset.affineCombination_eq_linear_combination _ v _ ht,
    Finset.map_affineCombination _ _ _ ht f,
    Finset.affineCombination_eq_linear_combination _ (f ∘ v) _ ht]
  rfl

private theorem normalizedWall_combination [Fintype B] (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (t : B → ℝ) (ht : ∑ i, t i = 1) (i : B) :
    normalizedWall r vertex i (∑ j, t j • rationalPoint r (vertex j)) = t i := by
  rw [affine_on_weighted_sum _ _ _ ht]
  simp [normalizedWall_vertex r vertex hv]

theorem affineIndependent_vertices [Fintype B] (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) :
    AffineIndependent ℝ (fun i => rationalPoint r (vertex i)) := by
  rw [affineIndependent_iff_eq_of_fintype_affineCombination_eq]
  intro t s ht hs he
  rw [Finset.affineCombination_eq_linear_combination _ _ _ ht,
    Finset.affineCombination_eq_linear_combination _ _ _ hs] at he
  funext i
  rw [← normalizedWall_combination r vertex hv t ht i, he,
    normalizedWall_combination r vertex hv s hs i]

private theorem sum_normalizedWall [Finite J] [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (x : E) :
    ∑ i, normalizedWall r vertex i x = 1 := by
  classical
  let F := normalizedWall r vertex
  change (∑ i, F i x) = 1
  by_contra! h
  let c := (1 - ∑ i, F i x)⁻¹
  let weights : Option B → ℝ := fun i => i.elim c (fun j => -c * F j x)
  let vertices : Option B → E := fun i => i.elim x (fun j => rationalPoint r (vertex j))
  have hnonzero : (1 - ∑ i, F i x) ≠ 0 := sub_ne_zero.mpr h.symm
  have hweights : ∑ i, weights i = 1 := by
    rw [Fintype.sum_option]
    change c + ∑ i, -c * F i x = 1
    rw [← Finset.mul_sum]
    calc
      _ = c * (1 - ∑ i, F i x) := by ring
      _ = 1 := inv_mul_cancel₀ hnonzero
  let z := ∑ i, weights i • vertices i
  apply no_common_simple_zero r hA d hsep z
  intro i
  have hz : F i z = 0 := by
    rw [affine_on_weighted_sum _ _ _ hweights, Fintype.sum_option]
    change c * F i x + ∑ j, (-c * F j x) * F i (rationalPoint r (vertex j)) = 0
    simp [F, normalizedWall_vertex r vertex hv]
  rw [normalizedWall_apply] at hz
  exact (mul_eq_zero.mp hz).resolve_left (inv_ne_zero (opposite_vertex_pos r vertex hv i).ne')

theorem simplexPoint_wallValue [Fintype B] (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (t : Weights B) (i : B) :
    realWallValue A r i.val (simplexPoint r vertex t) =
      realWallValue A r i.val (rationalPoint r (vertex i)) * t.val i := by
  have hw : ∑ i, t.val i = 1 := by
    have h := t.property.2
    rwa [finsum_eq_sum_of_fintype] at h
  have h := normalizedWall_combination r vertex hv t.val hw i
  rw [normalizedWall_apply] at h
  rw [simplexPoint, finsum_eq_sum_of_fintype]
  exact (inv_mul_eq_iff_eq_mul₀ (opposite_vertex_pos r vertex hv i).ne').mp h

theorem simplexPoint_injective [Fintype B] (vertex : B → V)
    (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) :
    Function.Injective (simplexPoint r vertex) := by
  intro t s h
  apply Subtype.ext
  funext i
  have h' := congrArg (realWallValue A r i.val) h
  rw [simplexPoint_wallValue r vertex hv, simplexPoint_wallValue r vertex hv] at h'
  exact mul_left_cancel₀ (opposite_vertex_pos r vertex hv i).ne' h'

theorem realClosed_iff_simplexPoint [Finite J] [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (x : E) :
    RealClosed A p r x ↔ ∃ t : Weights B, simplexPoint r vertex t = x := by
  rw [realClosed_iff_simple r hA d]
  refine ⟨fun hx => ?_, ?_⟩
  · let t : Weights B :=
      ⟨fun i => normalizedWall r vertex i x, fun i => by
        change 0 ≤ normalizedWall r vertex i x
        rw [normalizedWall_apply]
        exact mul_nonneg (inv_nonneg.mpr (opposite_vertex_pos r vertex hv i).le) (hx i),
        by
          rw [finsum_eq_sum_of_fintype]
          exact sum_normalizedWall r hA d hsep vertex hv x⟩
    refine ⟨t, simple_values_injective r hA d hsep (fun i => ?_)⟩
    rw [simplexPoint_wallValue r vertex hv]
    change _ * normalizedWall r vertex i x = _
    rw [normalizedWall_apply, ← mul_assoc, mul_inv_cancel₀ (opposite_vertex_pos r vertex hv i).ne',
      one_mul]
  · rintro ⟨t, rfl⟩ i
    rw [simplexPoint_wallValue r vertex hv]
    exact mul_nonneg (opposite_vertex_pos r vertex hv i).le (t.property.1 i)

theorem realOpen_iff_simplexPoint [Finite J] [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (x : E) :
    RealOpen A p r x ↔ ∃ t : Weights B, (∀ i, 0 < t.val i) ∧ simplexPoint r vertex t = x := by
  constructor
  · intro hx
    obtain ⟨t, rfl⟩ :=
      (realClosed_iff_simplexPoint r hA d hsep vertex hv x).mp fun a ha => (hx a ha).le
    refine ⟨t, fun i => ?_, rfl⟩
    have h := hx i.val i.property.1
    rw [simplexPoint_wallValue r vertex hv] at h
    exact pos_of_mul_pos_right h (opposite_vertex_pos r vertex hv i).le
  · rintro ⟨t, ht, rfl⟩
    apply (realOpen_iff_simple r hA d _).mpr
    intro i
    rw [simplexPoint_wallValue r vertex hv]
    exact mul_pos (opposite_vertex_pos r vertex hv i) (ht i)

end Simplex

section Translates

variable {V : Type uG} {J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V} (r : RealCoordinates V)

local notation "E" => EuclideanApartment V
local notation "B" => A.SimpleWall p
local notation "W" => A.affineWeylGroup

variable [Finite J]

private theorem simplexPoint_closed [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (t : Weights B) :
    RealClosed A p r (simplexPoint r vertex t) := by
  apply (realClosed_iff_simple r hA d _).mpr
  intro i
  rw [simplexPoint_wallValue r vertex hv]
  exact mul_nonneg (opposite_vertex_pos r vertex hv i).le (t.property.1 i)

omit [Finite J] in
private theorem simplexPoint_wall_eq_zero [Fintype B]
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (t : Weights B) :
    {i : B | realWallValue A r i.val (simplexPoint r vertex t) = 0} = cotype t := by
  ext i
  change realWallValue A r i.val (simplexPoint r vertex t) = 0 ↔ t.val i = 0
  rw [simplexPoint_wallValue r vertex hv]
  simp only [mul_eq_zero, (opposite_vertex_pos r vertex hv i).ne', false_or]

theorem simplexPoint_overlap [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (w v : W) (t s : Weights B) :
    realAffine r r w.val (simplexPoint r vertex t) = realAffine r r v.val (simplexPoint r vertex s) ↔
      t = s ∧ w⁻¹ * v ∈ standardWallSubgroup d.coxeter (cotype s) := by
  have ht := simplexPoint_closed r hA d vertex hv t
  have hs := simplexPoint_closed r hA d vertex hv s
  have hzero := simplexPoint_wall_eq_zero r vertex hv s
  have he : realAffine r r (w⁻¹ * v).val (simplexPoint r vertex s) = simplexPoint r vertex t ↔
      realAffine r r w.val (simplexPoint r vertex t) = realAffine r r v.val (simplexPoint r vertex s) := by
    constructor
    · intro h
      rw [← h, ← realAffine_mul, ← mul_assoc, mul_inv_cancel, one_mul]
    · intro h
      rw [realAffine_mul, ← h, realAffine_inv]
  rw [← he]
  constructor
  · intro h
    have hwx : RealClosed A p r (realAffine r r (w⁻¹ * v).val (simplexPoint r vertex s)) := by
      rw [h]
      exact ht
    obtain ⟨hfix, hw⟩ := realClosed_transporter r hA d hs _ hwx
    rw [hzero] at hw
    exact ⟨simplexPoint_injective r vertex hv (h.symm.trans hfix), hw⟩
  · rintro ⟨hts, hw⟩
    rw [hts]
    rw [← hzero] at hw
    let := realWeylAction A r
    let x := simplexPoint r vertex s
    let stab := MulAction.stabilizer W x
    have hs : standardWallSubgroup d.coxeter {i | realWallValue A r i.val x = 0} ≤ stab := by
      rw [standardWallSubgroup, Subgroup.closure_le]
      rintro g ⟨i, hi, rfl⟩
      change realAffineEquiv r r (d.coxeter.simple i).val x = x
      rw [realAffineEquiv_apply, congrFun d.simple_eq i]
      change realAffine r r (A.reflection i.val) x = x
      rw [realReflection_apply, hi, zero_smul, sub_zero]
    have hfix := hs hw
    change realAffineEquiv r r (w⁻¹ * v).val x = x at hfix
    rwa [realAffineEquiv_apply] at hfix

theorem simplexPoint_wallSubgroup [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i)) (s : Weights B) :
    standardWallSubgroup d.coxeter (cotype s) =
      wallReflectionGroup A r (simplexPoint r vertex s) := by
  rw [← simplexPoint_wall_eq_zero r vertex hv s]
  exact realClosed_stabilizer r hA d (simplexPoint_closed r hA d vertex hv s)

theorem simplexPoint_covers [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y) (x : E) :
    ∃ (w : W) (t : Weights B), realAffine r r w.val (simplexPoint r vertex t) = x := by
  obtain ⟨w, hw⟩ := exists_realClosed_translate r hA d x
  obtain ⟨t, ht⟩ := (realClosed_iff_simplexPoint r hA d hsep vertex hv _).mp hw
  refine ⟨w⁻¹, t, ?_⟩
  rw [ht, realAffine_inv]

private def crossingTimes (x y : E) : Set ℝ :=
  {t ∈ Icc 0 1 | ∃ a : J × ℤ,
    realWallValue A r a x ≠ realWallValue A r a y ∧
      realWallValue A r a (AffineMap.lineMap x y t) = 0}

private theorem crossingTimes_finite (x y : E) : (crossingTimes (A := A) r x y).Finite := by
  let f : ℝ →ᵃ[ℝ] E := AffineMap.lineMap x y
  let H := fun a : J × ℤ => {z | realWallValue A r a z = 0}
  let S := {a | (H a ∩ f '' Icc 0 1).Nonempty}
  have hS : S.Finite := (locallyFinite_walls (A := A) r).finite_nonempty_inter_compact
    (isCompact_Icc.image f.continuous_of_finiteDimensional)
  let T := fun a : J × ℤ => {t : ℝ | realWallValue A r a x ≠ realWallValue A r a y ∧
    realWallValue A r a (f t) = 0}
  have hT (a : J × ℤ) : (T a).Finite := by
    apply Set.Subsingleton.finite
    rintro s ⟨hxy, hs⟩ t ⟨_, ht⟩
    change realWallValue A r a (AffineMap.lineMap x y s) = 0 at hs
    change realWallValue A r a (AffineMap.lineMap x y t) = 0 at ht
    rw [wallValue_lineMap] at hs ht
    have he : (s - t) * (realWallValue A r a y - realWallValue A r a x) = 0 := by
      nlinarith only [hs, ht]
    exact sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_right (sub_ne_zero.mpr hxy.symm))
  apply (hS.biUnion fun a _ => hT a).subset
  rintro t ⟨ht, a, hneq, hzero⟩
  exact mem_iUnion₂.mpr ⟨a, ⟨f t, hzero, t, ht, rfl⟩, hneq, hzero⟩

omit [Finite J] in
private theorem wall_nonneg_of_no_crossing (x y : E) {s t m b : ℝ} (a : J × ℤ)
    (hs : 0 ≤ s) (ht : t ≤ 1) (hm : m ∈ Ioo s t) (hb : b ∈ Icc s t)
    (hgap : ∀ z ∈ Ioo s t, z ∉ crossingTimes (A := A) r x y)
    (hpos : 0 ≤ realWallValue A r a (AffineMap.lineMap x y m)) :
    0 ≤ realWallValue A r a (AffineMap.lineMap x y b) := by
  let f := fun u : ℝ => realWallValue A r a (AffineMap.lineMap x y u)
  change 0 ≤ f m at hpos
  change 0 ≤ f b
  by_contra! hn
  have hneq : realWallValue A r a x ≠ realWallValue A r a y := by
    intro he
    have hf (u : ℝ) : f u = realWallValue A r a x := by
      change realWallValue A r a (AffineMap.lineMap x y u) = _
      rw [wallValue_lineMap, ← he]
      ring
    rw [hf] at hpos hn
    exact hn.not_ge hpos
  have contradiction {u : ℝ} (hu : u ∈ Ioo s t) (hf : f u = 0) : False :=
    hgap u hu ⟨⟨hs.trans hu.1.le, hu.2.le.trans ht⟩, a, hneq, hf⟩
  rcases hpos.eq_or_lt with hzero | hpos
  · exact contradiction hm hzero.symm
  · have hc : Continuous f := (continuous_realWallValue r a).comp
        (AffineMap.lineMap (k := ℝ) x y).continuous_of_finiteDimensional
    have hc₀ := intermediate_value_uIcc (a := b) (b := m) (f := f) hc.continuousOn
    obtain ⟨u, hu, huz⟩ := hc₀ (show (0 : ℝ) ∈ Set.uIcc (f b) (f m) from
      (uIcc_of_le (hn.le.trans hpos.le)).symm ▸ ⟨hn.le, hpos.le⟩)
    have hub : u ≠ b := fun he => hn.ne (he ▸ huz)
    have hum : u ≠ m := fun he => hpos.ne' (he ▸ huz)
    have hsu : s ≤ min b m := le_min hb.1 hm.1.le
    have hut : max b m ≤ t := max_le hb.2 hm.2.le
    have hmin : u ≠ min b m := by rcases min_choice b m with h | h <;> simpa only [h]
    have hmax : u ≠ max b m := by rcases max_choice b m with h | h <;> simpa only [h]
    exact contradiction ⟨hsu.trans_lt (lt_of_le_of_ne hu.1 (Ne.symm hmin)),
      (lt_of_le_of_ne hu.2 hmax).trans_le hut⟩ huz

private theorem common_simplex_of_gap [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y) (x y : E) {s t : ℝ} (hs : 0 ≤ s) (ht : t ≤ 1)
    (hst : s < t) (hgap : ∀ z ∈ Ioo s t, z ∉ crossingTimes (A := A) r x y) :
    ∃ (w : W) (a b : Weights B),
      realAffine r r w.val (simplexPoint r vertex a) = AffineMap.lineMap x y s ∧
      realAffine r r w.val (simplexPoint r vertex b) = AffineMap.lineMap x y t := by
  let m := (s + t) / 2
  have hm : m ∈ Ioo s t := ⟨by dsimp [m]; linarith, by dsimp [m]; linarith⟩
  let := d.action
  obtain ⟨w, hw⟩ := exists_realClosed_translate r hA d (AffineMap.lineMap x y m)
  have he (b : ℝ) (hb : b ∈ Icc s t) :
      RealClosed A p r (realAffine r r w.val (AffineMap.lineMap x y b)) := by
    intro a ha
    have heq (z : ℝ) : realWallValue A r a (realAffine r r w.val (AffineMap.lineMap x y z)) =
        realWallValue A r (w⁻¹ • a) (AffineMap.lineMap x y z) := by
      simpa only [smul_inv_smul] using realWallEquation r d w (w⁻¹ • a) (AffineMap.lineMap x y z)
    rw [heq]
    apply wall_nonneg_of_no_crossing r x y _ hs ht hm hb hgap
    exact (heq m) ▸ hw a ha
  obtain ⟨a, ha⟩ := (realClosed_iff_simplexPoint r hA d hsep vertex hv _).mp
    (he s ⟨le_rfl, hst.le⟩)
  obtain ⟨b, hb⟩ := (realClosed_iff_simplexPoint r hA d hsep vertex hv _).mp
    (he t ⟨hst.le, le_rfl⟩)
  exact ⟨w⁻¹, a, b, by rw [ha, realAffine_inv], by rw [hb, realAffine_inv]⟩

private theorem dist_lineMap_add (x y : E) {s m t : ℝ} (hsm : s ≤ m) (hmt : m ≤ t) :
    dist (AffineMap.lineMap x y s) (AffineMap.lineMap x y m) +
      dist (AffineMap.lineMap x y m) (AffineMap.lineMap x y t) =
        dist (AffineMap.lineMap x y s) (AffineMap.lineMap x y t) := by
  simp only [dist_lineMap_lineMap, Real.dist_eq, abs_of_nonpos (sub_nonpos.mpr hsm),
    abs_of_nonpos (sub_nonpos.mpr hmt), abs_of_nonpos (sub_nonpos.mpr (hsm.trans hmt))]
  ring

theorem exists_orderedSubdivision [Nonempty J] [Fintype B]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (vertex : B → V) (hv : ∀ i, IsAlcoveVertex A p i (vertex i))
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y) (x y : E) :
    OrderedSubdivision r vertex x y 0 1 (dist x y) := by
  classical
  let f := AffineMap.lineMap (k := ℝ) x y
  let S := crossingTimes (A := A) r x y
  have hchain (T : Finset ℝ) : ∀ {s t : ℝ}, 0 ≤ s → t ≤ 1 → s ≤ t →
      (∀ b ∈ Ioo s t, b ∈ S → b ∈ T) →
      OrderedSubdivision r vertex x y s t (dist (f s) (f t)) := by
    induction T using Finset.strongInduction with
    | H T ih =>
      intro s t hs ht hst hT
      rcases hst.eq_or_lt with rfl | hst
      · simpa only [dist_self] using (OrderedSubdivision.nil (r := r) (vertex := vertex) (x := x) (y := y) s)
      · let U := T.filter fun b => b ∈ Ioo s t
        by_cases hU : U.Nonempty
        · let m := U.min' hU
          have hm := Finset.mem_filter.mp (Finset.min'_mem U hU)
          have hgap (b : ℝ) (hb : b ∈ Ioo s m) : b ∉ S := by
            intro hbS
            have hbI : b ∈ Ioo s t := ⟨hb.1, hb.2.trans hm.2.2⟩
            exact hb.2.not_ge (Finset.min'_le U b (Finset.mem_filter.mpr ⟨hT b hbI hbS, hbI⟩))
          obtain ⟨w, a, b, ha, hb⟩ := common_simplex_of_gap r hA d vertex hv hsep x y hs
            (hm.2.2.le.trans ht) hm.2.1 hgap
          have htail := ih (T.erase m) (Finset.erase_ssubset hm.1)
            (hs.trans hm.2.1.le) ht hm.2.2.le fun c hc hcS =>
              Finset.mem_erase.mpr ⟨hc.1.ne', hT c ⟨hm.2.1.trans hc.1, hc.2⟩ hcS⟩
          have hcons := OrderedSubdivision.cons hm.2.1 w a b ha hb htail
          rw [dist_lineMap_add x y hm.2.1.le hm.2.2.le] at hcons
          exact hcons
        · have hgap (b : ℝ) (hb : b ∈ Ioo s t) : b ∉ S :=
            fun hbS => hU ⟨b, Finset.mem_filter.mpr ⟨hT b hb hbS, hb⟩⟩
          obtain ⟨w, a, b, ha, hb⟩ := common_simplex_of_gap r hA d vertex hv hsep x y hs ht hst hgap
          simpa only [add_zero] using
            (OrderedSubdivision.cons hst w a b ha hb (OrderedSubdivision.nil t))
  have hS := crossingTimes_finite (A := A) r x y
  simpa only [f, AffineMap.lineMap_apply_zero, AffineMap.lineMap_apply_one] using
    hchain hS.toFinset le_rfl le_rfl zero_le_one (fun b _ hb => hS.mem_toFinset.mpr hb)

end Translates

section Assemble

variable {V : Type uG} {J : Type*} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V}

set_option maxHeartbeats 800000 in
theorem realAlcove_of_markedVertices [Finite J] [Nonempty J]
    (hA : AlcoveGeometry A p) (d : AlcoveCoxeterData A p)
    (hsep : ∀ x y : V, (∀ i, A.root i x = A.root i y) → x = y)
    (hvertex : ∀ i : A.SimpleWall p, ∃! x, IsAlcoveVertex A p i x) :
    Nonempty (RealAlcoveData d) := by
  let hf := finite_simpleWalls (A := A) (p := p)
  let := Fintype.ofFinite (A.SimpleWall p)
  let vertex := fun i => (hvertex i).exists.choose
  have hv (i : A.SimpleWall p) : IsAlcoveVertex A p i (vertex i) := (hvertex i).exists.choose_spec
  exact ⟨{
    finiteWalls := hf
    vertex := vertex
    marked_vertex := hv
    vertex_unique := fun i _ hx => (hvertex i).unique hx (hv i)
    affineIndependent := fun r => affineIndependent_vertices r vertex hv
    opposite_pos := fun r => opposite_vertex_pos r vertex hv
    wall_weight := fun r => simplexPoint_wallValue r vertex hv
    closed_simplex := fun r => realClosed_iff_simplexPoint r hA d hsep vertex hv
    open_simplex := fun r => realOpen_iff_simplexPoint r hA d hsep vertex hv
    covers := fun r => simplexPoint_covers r hA d vertex hv hsep
    overlap := fun r => simplexPoint_overlap r hA d vertex hv
    wallSubgroup := fun r => simplexPoint_wallSubgroup r hA d vertex hv
    translatedWallSubgroup := fun r w t => by
      rw [simplexPoint_wallSubgroup r hA d vertex hv t]
      exact wallReflectionGroup_translate r d w (simplexPoint r vertex t)
    finiteFaceSubgroup := finite_standardWallSubgroup hA d hsep vertex hv
    locallyFinite := fun r => locallyFinite_walls (A := A) r
    subdivision := fun r => exists_orderedSubdivision r hA d vertex hv hsep }⟩

end Assemble

section CentralTransport

variable {V V' I I' : Type*} [AddCommGroup V] [AddCommGroup V'] [Module ℚ V] [Module ℚ V']
  {A : ApartmentRoots ℚ V I} {A' : ApartmentRoots ℚ V' I'} {p : V} {p' : V'}
  (e : V ≃ₗ[ℚ] V') (f : I ≃ I') (hp : p' = e p)
  (hf : ∀ i x, A'.root (f i) (e x) = A.root i x)

include e f hp hf in
private theorem markedVertices_of_transport
    (hv : ∀ i : A'.SimpleWall p', ∃! x, IsAlcoveVertex A' p' i x) :
    ∀ i : A.SimpleWall p, ∃! x, IsAlcoveVertex A p i x := by
  let w : I × ℤ ≃ I' × ℤ := f.prodCongr (Equiv.refl ℤ)
  have heq (a : I × ℤ) (x : V) : A'.wallValue (w a) (e x) = A.wallValue a x := by
    change A'.root (f a.1) (e x) + (a.2 : ℚ) = A.root a.1 x + (a.2 : ℚ)
    rw [hf]
  have hpos (a : I × ℤ) : A'.positive p' (w a) ↔ A.positive p a := by
    change 0 < A'.wallValue (w a) p' ↔ 0 < A.wallValue a p
    rw [hp, heq]
  have hs (a : I × ℤ) : A.IsSimple p a ↔ A'.IsSimple p' (w a) := by
    constructor
    · rintro ⟨ha, x, hx, hrest⟩
      refine ⟨(hpos a).mpr ha, e x, (heq a x).trans hx, ?_⟩
      intro b hb hne
      obtain ⟨b, rfl⟩ := w.surjective b
      change 0 < A'.wallValue (w b) (e x)
      rw [heq]
      exact hrest b ((hpos b).mp hb) (fun h => hne (congrArg w h))
    · rintro ⟨ha, x, hx, hrest⟩
      obtain ⟨x, rfl⟩ := e.surjective x
      refine ⟨(hpos a).mp ha, x, (heq a x).symm.trans hx, ?_⟩
      intro b hb hne
      have hh := hrest (w b) ((hpos b).mpr hb) (fun h => hne (w.injective h))
      change 0 < A'.wallValue (w b) (e x) at hh
      rwa [heq] at hh
  let s := w.subtypeEquiv hs
  have bridge (i : A.SimpleWall p) (x : V) :
      IsAlcoveVertex A p i x ↔ IsAlcoveVertex A' p' (s i) (e x) := by
    constructor
    · intro h
      refine ⟨?_, ?_⟩
      · intro a ha
        obtain ⟨a, rfl⟩ := w.surjective a
        rw [heq]
        exact h.1 a ((hpos a).mp ha)
      · intro j
        obtain ⟨j, rfl⟩ := s.surjective j
        change A'.wallValue (w j.val) (e x) = 0 ↔ s j ≠ s i
        rw [heq, h.2 j, s.injective.ne_iff]
    · intro h
      refine ⟨fun a ha => ?_, fun j => ?_⟩
      · rw [← heq]
        exact h.1 (w a) ((hpos a).mpr ha)
      · have hh := h.2 (s j)
        change A'.wallValue (w j.val) (e x) = 0 ↔ s j ≠ s i at hh
        simpa only [heq, s.injective.ne_iff] using hh
  intro i
  obtain ⟨x, hx, hu⟩ := hv (s i)
  obtain ⟨x, rfl⟩ := e.surjective x
  exact ⟨x, (bridge i x).mpr hx, fun y hy => e.injective (hu (e y) ((bridge i y).mp hy))⟩

end CentralTransport

