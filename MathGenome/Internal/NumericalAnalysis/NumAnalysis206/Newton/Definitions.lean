import MathGenome.Internal.NumericalAnalysis.Specs.NumAnalysis206.Newton.Definitions
import MathGenome.Internal.NumericalAnalysis.NumAnalysis206.Approximation.DividedDifferences

/-! Shared exact Newton and secant interfaces. See the independent Specs for the
root-stop, open-domain, and per-step validity conventions. -/

noncomputable section
open scoped Classical
universe u v w
namespace NumAnalysis206.Newton
open Specs.NumAnalysis206.Newton

/-- The exact scalar Newton expression; division is totalized, not a validity certificate. -/
def scalarNewton : Specs.NumAnalysis206.Newton.scalarNewtonType :=
  @Specs.NumAnalysis206.Newton.scalarNewtonValue

/-- The multiplicity-m corrected expression. The multiple-root theorem will supply m ≥ 2. -/
def correctedNewton : Specs.NumAnalysis206.Newton.correctedNewtonType :=
  @Specs.NumAnalysis206.Newton.correctedNewtonValue

/-- The canonical first divided difference on the ordered node-value pairs. -/
def secantSlope : Specs.NumAnalysis206.Newton.secantSlopeType :=
  @Specs.NumAnalysis206.Newton.secantSlopeValue

/-- The raw secant point. Its use away from a root requires distinct nodes and nonzero slope. -/
def secantStep : Specs.NumAnalysis206.Newton.secantStepType :=
  @Specs.NumAnalysis206.Newton.secantStepValue

/-- Absorbing extension of a one-point iteration at a successfully reached root. -/
def stopAtRoot : Specs.NumAnalysis206.Newton.stopAtRootType :=
  @Specs.NumAnalysis206.Newton.stopAtRootValue

/-- Two-point state update, checking either initial point for a root before any secant step. -/
def secantTransition : Specs.NumAnalysis206.Newton.secantTransitionType :=
  @Specs.NumAnalysis206.Newton.secantTransitionValue

/-- Analytic validity of a scalar non-root step; also applies to corrected Newton. -/
def scalarStepValid : Specs.NumAnalysis206.Newton.scalarStepValidType :=
  @Specs.NumAnalysis206.Newton.scalarStepValidValue

/-- Validity of a non-root secant step; repeated nodes are not certified by totalized division. -/
def secantStepValid : Specs.NumAnalysis206.Newton.secantStepValidType :=
  @Specs.NumAnalysis206.Newton.secantStepValidValue

/-- A secant state either permits a successful stop or has a valid next step. -/
def secantStateValid : Specs.NumAnalysis206.Newton.secantStateValidType :=
  @Specs.NumAnalysis206.Newton.secantStateValidValue

/-- An open differentiability domain for a total representative of F : U → Y. No regularity outside U is required. -/
def operatorDomain : Specs.NumAnalysis206.Newton.operatorDomainType :=
  @Specs.NumAnalysis206.Newton.operatorDomainValue

/-- Banach-space Newton over the reals or complexes, using the actual Fréchet derivative and the totalized continuous linear inverse. -/
def operatorNewton : Specs.NumAnalysis206.Newton.operatorNewtonType :=
  @Specs.NumAnalysis206.Newton.operatorNewtonValue

/-- Validity at one used point: domain membership, differentiability and a bounded-isomorphism derivative. This makes no assertion about the next point. -/
def operatorStepValid : Specs.NumAnalysis206.Newton.operatorStepValidType :=
  @Specs.NumAnalysis206.Newton.operatorStepValidValue

/-- Validity for a stopped one-point method: a root requires no further division or inverse. -/
def stoppedStepValid : Specs.NumAnalysis206.Newton.stoppedStepValidType :=
  @Specs.NumAnalysis206.Newton.stoppedStepValidValue

/-- The exact sequence generated by an update. Domain and denominator validity must be proved separately. -/
def exactIterates : Specs.NumAnalysis206.Newton.exactIteratesType :=
  @Specs.NumAnalysis206.Newton.exactIteratesValue

/-- Only the initial value and exact recurrence, with no convergence or invariance assumption. -/
def IsExactRun : Specs.NumAnalysis206.Newton.IsExactRunType :=
  @Specs.NumAnalysis206.Newton.IsExactRunValue

/-- A prefix through x N, including the zero-step run. The sequence after N is unrestricted. -/
def IsExactFiniteRun : Specs.NumAnalysis206.Newton.IsExactFiniteRunType :=
  @Specs.NumAnalysis206.Newton.IsExactFiniteRunValue

/-- Separate per-step validity obligations for an infinite run, not a conclusion about its behavior. -/
def StepsValid : Specs.NumAnalysis206.Newton.StepsValidType :=
  @Specs.NumAnalysis206.Newton.StepsValidValue

/-- Only points at which an update is used need a valid step. No derivative at the terminal point is required. -/
def FiniteStepsValid : Specs.NumAnalysis206.Newton.FiniteStepsValidType :=
  @Specs.NumAnalysis206.Newton.FiniteStepsValidValue

/-- An exact successful stop at the terminal point; this does not assert that any run reaches a root. -/
def SuccessfulRootStop : Specs.NumAnalysis206.Newton.SuccessfulRootStopType :=
  @Specs.NumAnalysis206.Newton.SuccessfulRootStopValue

/-- Exact scalar Newton iterates with absorbing root stopping. -/
def scalarNewtonIterates : Specs.NumAnalysis206.Newton.scalarNewtonIteratesType :=
  @Specs.NumAnalysis206.Newton.scalarNewtonIteratesValue

/-- Exact multiplicity-corrected iterates with absorbing root stopping. -/
def correctedNewtonIterates : Specs.NumAnalysis206.Newton.correctedNewtonIteratesType :=
  @Specs.NumAnalysis206.Newton.correctedNewtonIteratesValue

/-- Exact secant state sequence from two initial points. A root in either slot is a successful stop. -/
def secantIterates : Specs.NumAnalysis206.Newton.secantIteratesType :=
  @Specs.NumAnalysis206.Newton.secantIteratesValue

/-- Exact Banach Newton sequence with absorbing root stopping. Validity of each used inverse is a separate obligation. -/
def operatorNewtonIterates : Specs.NumAnalysis206.Newton.operatorNewtonIteratesType :=
  @Specs.NumAnalysis206.Newton.operatorNewtonIteratesValue

theorem secantSlope_eq_div : Specs.NumAnalysis206.Newton.secantSlopeEqDiv := by
  intro K _ f u v
  change NumAnalysis206.Approximation.dividedDifference [(u, f u), (v, f v)] = _
  simpa only [List.nil_append, NumAnalysis206.Approximation.dividedDifference_singleton] using
    NumAnalysis206.Approximation.dividedDifference_recursion (u, f u) (v, f v) []

theorem stopAtRoot_of_root : Specs.NumAnalysis206.Newton.stopAtRootOfRoot := by
  intro X Y _ f step x h
  exact ite_eq_left h

theorem stopAtRoot_of_nonroot : Specs.NumAnalysis206.Newton.stopAtRootOfNonroot := by
  intro X Y _ f step x h
  exact ite_eq_right h

theorem stoppedStepValid_of_nonroot : Specs.NumAnalysis206.Newton.stoppedStepValidOfNonroot := by
  intro X Y _ f valid x h
  exact or_iff_right h

theorem secantTransition_of_first_root : Specs.NumAnalysis206.Newton.secantTransitionOfFirstRoot := by
  intro K _ f u v h
  exact ite_eq_left h

theorem secantTransition_of_second_root : Specs.NumAnalysis206.Newton.secantTransitionOfSecondRoot := by
  intro K _ f u v hu hv
  simp only [secantTransitionValue, ite_eq_right hu, ite_eq_left hv]

theorem secantTransition_of_nonroots : Specs.NumAnalysis206.Newton.secantTransitionOfNonroots := by
  intro K _ f u v hu hv
  simp only [secantTransitionValue, ite_eq_right hu, ite_eq_right hv]

theorem secantStateValid_of_nonroots : Specs.NumAnalysis206.Newton.secantStateValidOfNonroots := by
  intro K _ f u v hu hv
  simp only [secantStateValidValue, secantStepValidValue, or_iff_right hu, or_iff_right hv]

theorem operatorNewton_eq_of_hasFDerivAt : Specs.NumAnalysis206.Newton.operatorNewtonEqOfHasFDerivAt := by
  intro 𝕜 _ X Y _ _ _ _ _ _ F x e h
  simp only [operatorNewtonValue, h.fderiv, ContinuousLinearMap.inverse_equiv,
    ContinuousLinearEquiv.coe_coe]

theorem operatorStepValid_of_domain : Specs.NumAnalysis206.Newton.operatorStepValidOfDomain := by
  intro 𝕜 _ X Y _ _ _ _ _ _ F U h x hx hi
  exact ⟨hx, h.2.differentiableAt (h.1.mem_nhds hx), hi⟩

theorem exactIterates_isExactRun : Specs.NumAnalysis206.Newton.exactIteratesIsExactRun := by
  intro X step x₀
  exact ⟨rfl, fun _ => rfl⟩

theorem isExactRun_isExactFiniteRun : Specs.NumAnalysis206.Newton.isExactRunIsExactFiniteRun := by
  intro X step x₀ x h N
  exact ⟨h.1, fun n _ => h.2 n⟩

theorem isExactFiniteRun_eq_iterates : Specs.NumAnalysis206.Newton.isExactFiniteRunEqIterates := by
  intro X step x₀ N x h n hn
  induction n with
  | zero => exact h.1
  | succ n ih =>
      change x (n + 1) = step (exactIteratesValue step x₀ n)
      rw [h.2 n (Nat.lt_of_succ_le hn), ih (Nat.le_of_succ_le hn)]

theorem exactIterates_absorbing_after_root : Specs.NumAnalysis206.Newton.exactIteratesAbsorbingAfterRoot := by
  intro X Y _ f step x₀ N h k
  induction k with
  | zero => rfl
  | succ k ih =>
      change stopAtRootValue f step
        (exactIteratesValue (stopAtRootValue f step) x₀ (N + k)) = _
      rw [ih]
      exact ite_eq_left h

def SuccessfulSecantStop : Specs.NumAnalysis206.Newton.SuccessfulSecantStopType := @Specs.NumAnalysis206.Newton.SuccessfulSecantStopValue

theorem scalarNewtonIterates_succ : Specs.NumAnalysis206.Newton.scalarNewtonIteratesSucc := by
  intro 𝕜 _ f x₀ n
  change stopAtRootValue f (scalarNewtonValue f) (scalarNewtonIteratesValue f x₀ n) = _
  by_cases h : f (scalarNewtonIteratesValue f x₀ n) = 0
  · simp only [stopAtRootValue, h, ite_eq_left, scalarNewtonValue, zero_div, sub_zero]
  · exact ite_eq_right h

theorem correctedNewtonIterates_succ : Specs.NumAnalysis206.Newton.correctedNewtonIteratesSucc := by
  intro 𝕜 _ m f x₀ n
  change stopAtRootValue f (correctedNewtonValue m f) (correctedNewtonIteratesValue m f x₀ n) = _
  by_cases h : f (correctedNewtonIteratesValue m f x₀ n) = 0
  · simp only [stopAtRootValue, h, ite_eq_left, correctedNewtonValue, mul_zero, zero_div, sub_zero]
  · exact ite_eq_right h

theorem operatorNewtonIterates_succ : Specs.NumAnalysis206.Newton.operatorNewtonIteratesSucc := by
  intro 𝕜 _ X Y _ _ _ _ _ _ F x₀ n
  change stopAtRootValue F (operatorNewtonValue (𝕜 := 𝕜) F)
    (operatorNewtonIteratesValue (𝕜 := 𝕜) F x₀ n) = _
  by_cases h : F (operatorNewtonIteratesValue (𝕜 := 𝕜) F x₀ n) = 0
  · simp only [stopAtRootValue, h, ite_eq_left, operatorNewtonValue, map_zero, sub_zero]
  · exact ite_eq_right h

end NumAnalysis206.Newton
