import Mathlib.Analysis.Complex.Basic
import MathGenome.Internal.Specs.D05.M11.Nondegenerate
import MathGenome.Internal.Specs.D05.M11.Hermitian
import MathGenome.Internal.Specs.D05.M11.SymplecticBlocks
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic

/-! K05.11.isometry_groups, paper.tex:1802–1803.
Bilinear and first-slot-linear sesquilinear forms use the upstream canonical
objects and matrix conventions. The group is represented initially by the
subgroup generated by preserving automorphisms. The membership obligations
below prove that this subgroup has exactly the stated carrier; closure does
not assume the assertion being proved. No symmetry or nondegeneracy is needed
for group closure. Invertibility of preserving endomorphisms does require
nondegeneracy and finite dimension. Empty dimensions and characteristic two
are included. Named positive specializations do not restrict the general results.
-/
noncomputable section
namespace Specs.D05.M11.IsometryGroups
open Module Matrix
universe u v

abbrev Sesq (K V : Type*) [RCLike K] [AddCommGroup V] [Module K V] :=
  Specs.D05.M11.Hermitian.sesquilinearForm_value K V

def bilinearIsometryGroup_value {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] (B : LinearMap.BilinForm K V) :
    Subgroup (V ≃ₗ[K] V) :=
  Subgroup.closure {S | ∀ u v, B (S u) (S v) = B u v}

def bilinearIsometryGroup_type : Type (max (u+1) (v+1)) :=
  {K : Type u} → {V : Type v} → [Field K] → [AddCommGroup V] → [Module K V] →
    LinearMap.BilinForm K V → Subgroup (V ≃ₗ[K] V)

def sesquilinearIsometryGroup_value {K : Type u} {V : Type v} [RCLike K]
    [AddCommGroup V] [Module K V] (B : Sesq K V) : Subgroup (V ≃ₗ[K] V) :=
  Subgroup.closure {S | ∀ u v, B (S u) (S v) = B u v}

def sesquilinearIsometryGroup_type : Type (max (u+1) (v+1)) :=
  {K : Type u} → {V : Type v} → [RCLike K] → [AddCommGroup V] → [Module K V] →
    Sesq K V → Subgroup (V ≃ₗ[K] V)

def bilinear_mem : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (B : LinearMap.BilinForm K V) (S : V ≃ₗ[K] V),
    S ∈ bilinearIsometryGroup_value B ↔ ∀ u v, B (S u) (S v) = B u v

def sesquilinear_mem : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V]
    (B : Sesq K V) (S : V ≃ₗ[K] V),
    S ∈ sesquilinearIsometryGroup_value B ↔ ∀ u v, B (S u) (S v) = B u v

/-- The actual identity, composition (S after T), and inverse preserve B. -/
def bilinear_operations : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (B : LinearMap.BilinForm K V),
    (∀ u v, B ((1 : V ≃ₗ[K] V) u) ((1 : V ≃ₗ[K] V) v) = B u v) ∧
    (∀ S T : V ≃ₗ[K] V, (∀ u v, B (S u) (S v) = B u v) →
      (∀ u v, B (T u) (T v) = B u v) →
      ∀ u v, B ((S * T) u) ((S * T) v) = B u v) ∧
    (∀ S : V ≃ₗ[K] V, (∀ u v, B (S u) (S v) = B u v) →
      ∀ u v, B (S.symm u) (S.symm v) = B u v)

def sesquilinear_operations : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V]
    (B : Sesq K V),
    (∀ u v, B ((1 : V ≃ₗ[K] V) u) ((1 : V ≃ₗ[K] V) v) = B u v) ∧
    (∀ S T : V ≃ₗ[K] V, (∀ u v, B (S u) (S v) = B u v) →
      (∀ u v, B (T u) (T v) = B u v) →
      ∀ u v, B ((S * T) u) ((S * T) v) = B u v) ∧
    (∀ S : V ≃ₗ[K] V, (∀ u v, B (S u) (S v) = B u v) →
      ∀ u v, B (S.symm u) (S.symm v) = B u v)

def bilinear_injective : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (B : LinearMap.BilinForm K V), B.Nondegenerate → ∀ S : V →ₗ[K] V,
    (∀ u v, B (S u) (S v) = B u v) → Function.Injective S

def sesquilinear_injective : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V]
    (B : Sesq K V), B.Nondegenerate → ∀ S : V →ₗ[K] V,
    (∀ u v, B (S u) (S v) = B u v) → Function.Injective S

/-- The preserving map itself underlies an automorphism, not merely some map. -/
def bilinear_automorphism : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V), B.Nondegenerate → ∀ S : V →ₗ[K] V,
    (∀ u v, B (S u) (S v) = B u v) →
    ∃ e : V ≃ₗ[K] V, e.toLinearMap = S ∧ e ∈ bilinearIsometryGroup_value B

def sesquilinear_automorphism : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (B : Sesq K V), B.Nondegenerate → ∀ S : V →ₗ[K] V,
    (∀ u v, B (S u) (S v) = B u v) →
    ∃ e : V ≃ₗ[K] V, e.toLinearMap = S ∧ e ∈ sesquilinearIsometryGroup_value B

/-- Matrix equivalences apply to every endomorphism, without invertibility premises. -/
def bilinear_matrix : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {n : ℕ}
    (b : Basis (Fin n) K V) (B : LinearMap.BilinForm K V) (S : V →ₗ[K] V),
    (∀ u v, B (S u) (S v) = B u v) ↔
    (LinearMap.toMatrix b b S)ᵀ * Specs.D05.M11.FormMatrix.formMatrix_value b B *
      LinearMap.toMatrix b b S = Specs.D05.M11.FormMatrix.formMatrix_value b B

def sesquilinear_matrix : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V] {n : ℕ}
    (b : Basis (Fin n) K V) (B : Sesq K V) (S : V →ₗ[K] V),
    (∀ u v, B (S u) (S v) = B u v) ↔
    (LinearMap.toMatrix b b S)ᵀ * Specs.D05.M11.Hermitian.formMatrix_value b B *
      (LinearMap.toMatrix b b S).map star = Specs.D05.M11.Hermitian.formMatrix_value b B

/-- Orthogonal groups of positive definite real symmetric forms. -/
def orthogonalGroup_value {V : Type v} [AddCommGroup V] [Module ℝ V]
    (B : LinearMap.BilinForm ℝ V) (_hs : B.IsSymm)
    (_hp : ∀ v, v ≠ 0 → 0 < B v v) : Subgroup (V ≃ₗ[ℝ] V) :=
  bilinearIsometryGroup_value B

def orthogonalGroup_type : Type (v+1) :=
  {V : Type v} → [AddCommGroup V] → [Module ℝ V] → (B : LinearMap.BilinForm ℝ V) →
    B.IsSymm → (∀ v, v ≠ 0 → 0 < B v v) → Subgroup (V ≃ₗ[ℝ] V)

/-- Unitary groups use conjugate linearity, not complex bilinearity. -/
def unitaryGroup_value {V : Type v} [AddCommGroup V] [Module ℂ V]
    (B : Sesq ℂ V) (_hh : Specs.D05.M11.Hermitian.isHermitian_value B)
    (_hp : ∀ v, v ≠ 0 → 0 < (B v v).re) : Subgroup (V ≃ₗ[ℂ] V) :=
  sesquilinearIsometryGroup_value B

def unitaryGroup_type : Type (v+1) :=
  {V : Type v} → [AddCommGroup V] → [Module ℂ V] → (B : Sesq ℂ V) →
    Specs.D05.M11.Hermitian.isHermitian_value B →
    (∀ v, v ≠ 0 → 0 < (B v v).re) → Subgroup (V ≃ₗ[ℂ] V)

def symplecticGroup_value {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] (B : LinearMap.BilinForm K V)
    (_ha : B.IsAlt) (_hn : B.Nondegenerate) : Subgroup (V ≃ₗ[K] V) :=
  bilinearIsometryGroup_value B

def symplecticGroup_type : Type (max (u+1) (v+1)) :=
  {K : Type u} → {V : Type v} → [Field K] → [AddCommGroup V] → [Module K V] →
    (B : LinearMap.BilinForm K V) → B.IsAlt → B.Nondegenerate → Subgroup (V ≃ₗ[K] V)

/-- Positivity supplies nondegeneracy, on both sides, including the zero space. -/
def real_positive_nondegenerate : Prop :=
  ∀ {V : Type*} [AddCommGroup V] [Module ℝ V] (B : LinearMap.BilinForm ℝ V),
    (∀ v, v ≠ 0 → 0 < B v v) → B.Nondegenerate

def complex_positive_nondegenerate : Prop :=
  ∀ {V : Type*} [AddCommGroup V] [Module ℂ V] (B : Sesq ℂ V),
    (∀ v, v ≠ 0 → 0 < (B v v).re) → B.Nondegenerate

def orthogonal_mem : Prop :=
  ∀ {V : Type*} [AddCommGroup V] [Module ℝ V] (B : LinearMap.BilinForm ℝ V)
    (hs : B.IsSymm) (hp : ∀ v, v ≠ 0 → 0 < B v v) (S : V ≃ₗ[ℝ] V),
    S ∈ orthogonalGroup_value B hs hp ↔ ∀ u v, B (S u) (S v) = B u v

def unitary_mem : Prop :=
  ∀ {V : Type*} [AddCommGroup V] [Module ℂ V] (B : Sesq ℂ V)
    (hh : Specs.D05.M11.Hermitian.isHermitian_value B)
    (hp : ∀ v, v ≠ 0 → 0 < (B v v).re) (S : V ≃ₗ[ℂ] V),
    S ∈ unitaryGroup_value B hh hp ↔ ∀ u v, B (S u) (S v) = B u v

def symplectic_mem : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (B : LinearMap.BilinForm K V) (ha : B.IsAlt) (hn : B.Nondegenerate) (S : V ≃ₗ[K] V),
    S ∈ symplecticGroup_value B ha hn ↔ ∀ u v, B (S u) (S v) = B u v

def symplectic_even_dimension : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V), B.IsAlt → B.Nondegenerate → Even (Module.finrank K V)

/-- Coordinate characterizations of membership in the actual groups. -/
def bilinear_group_coordinates : Prop :=
  ∀ {K V : Type*} [Field K] [AddCommGroup V] [Module K V] {n : ℕ}
    (b : Basis (Fin n) K V) (B : LinearMap.BilinForm K V) (S : V ≃ₗ[K] V),
    S ∈ bilinearIsometryGroup_value B ↔
    (LinearMap.toMatrix b b S.toLinearMap)ᵀ * Specs.D05.M11.FormMatrix.formMatrix_value b B *
      LinearMap.toMatrix b b S.toLinearMap = Specs.D05.M11.FormMatrix.formMatrix_value b B

def sesquilinear_group_coordinates : Prop :=
  ∀ {K V : Type*} [RCLike K] [AddCommGroup V] [Module K V] {n : ℕ}
    (b : Basis (Fin n) K V) (B : Sesq K V) (S : V ≃ₗ[K] V),
    S ∈ sesquilinearIsometryGroup_value B ↔
    (LinearMap.toMatrix b b S.toLinearMap)ᵀ * Specs.D05.M11.Hermitian.formMatrix_value b B *
      (LinearMap.toMatrix b b S.toLinearMap).map star = Specs.D05.M11.Hermitian.formMatrix_value b B

/-- Even in dimension one the two complex preservation equations differ. -/
def complex_conventions_distinct : Prop :=
  let P : Matrix (Fin 1) (Fin 1) ℂ := Matrix.of (fun _ _ => Complex.I)
  let H : Matrix (Fin 1) (Fin 1) ℂ := Matrix.of (fun _ _ => 1)
  Pᵀ * H * P.map star = H ∧ Pᵀ * H * P ≠ H

end Specs.D05.M11.IsometryGroups
