import MathGenome.Internal.Specs.D05.M15.TensorAlgebra
import MathGenome.Internal.Specs.D05.M15.Multilinear
import MathGenome.Internal.Specs.D05.M05.Alternating
import MathGenome.Internal.Specs.D05.M06.QuotientLift
import Mathlib.LinearAlgebra.ExteriorPower.Basic
import Mathlib.LinearAlgebra.ExteriorAlgebra.Grading
import Mathlib.LinearAlgebra.TensorAlgebra.Grading
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
Independent statements for K05.15.exterior, paper.tex:2909–2912.
The tensor algebra and tensor powers are the accepted canonical objects.
The exterior algebra is the quotient by the congruence generated by squares;
`ideal_eq_span` identifies its ideal with the two-sided ideal generated by
those squares. Powers are the actual homogeneous submodules, rather than an
assumed decomposition. Degree relations are pulled back from the kernel of
the canonical quotient, and are identified with the kernel of the degree map.
All fields, arbitrary dimensional vector spaces, all degrees including zero,
and arbitrary vector-valued alternating maps are included. No averaging occurs.
-/

noncomputable section
namespace Specs.D05.M15.Exterior

open scoped TensorProduct DirectSum
universe u v w

abbrev exteriorAlgebra_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → Type (max u v)

abbrev exteriorAlgebra_value : exteriorAlgebra_type :=
  fun K V _ _ _ => _root_.ExteriorAlgebra K V

abbrev definingIdeal_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → TwoSidedIdeal (_root_.TensorAlgebra K V)

abbrev definingIdeal_value : definingIdeal_type :=
  fun K V _ _ _ => TwoSidedIdeal.ofRingCon (CliffordAlgebra.ringCon (0 : QuadraticForm K V))

abbrev homogeneousPart_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → ℕ → Submodule K (_root_.ExteriorAlgebra K V)

abbrev homogeneousPart_value : homogeneousPart_type :=
  fun K V _ _ _ p => ⋀[K]^p V

abbrev generator_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → (V →ₗ[K] _root_.ExteriorAlgebra K V)

abbrev generator_value : generator_type :=
  fun K _ _ _ _ => _root_.ExteriorAlgebra.ι K

abbrev quotientMap_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → (_root_.TensorAlgebra K V →ₐ[K] _root_.ExteriorAlgebra K V)

abbrev quotientMap_value : quotientMap_type :=
  fun _ _ _ _ _ => _root_.TensorAlgebra.toExterior

abbrev tensorProjection_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → (p : ℕ) → (TensorPower K p V →ₗ[K] (⋀[K]^p V))

abbrev tensorProjection_value : tensorProjection_type :=
  fun K _ _ _ _ p => PiTensorProduct.lift (exteriorPower.ιMulti K p).toMultilinearMap

abbrev degreeRelations_type := (K : Type u) → (V : Type v) → [Field K] → [AddCommGroup V] → [Module K V] → (p : ℕ) → Submodule K (TensorPower K p V)

abbrev degreeRelations_value : degreeRelations_type :=
  fun _ _ _ _ _ _ => LinearMap.ker (_root_.TensorAlgebra.toExterior.toLinearMap.comp TensorPower.toTensorAlgebra)

abbrev alternatingLift_type := (K : Type u) → (V : Type v) → (H : Type w) → [Field K] → [AddCommGroup V] → [Module K V] → [AddCommGroup H] → [Module K H] → (p : ℕ) → AlternatingMap K V H (Fin p) → ((⋀[K]^p V) →ₗ[K] H)

abbrev alternatingLift_value : alternatingLift_type :=
  fun _ _ _ _ _ _ _ _ _ b => exteriorPower.alternatingMapLinearEquiv b

abbrev algebraLift_type := (K : Type u) → (V : Type v) → (A : Type w) → [Field K] → [AddCommGroup V] → [Module K V] → [Ring A] → [Algebra K A] → (f : V →ₗ[K] A) → (∀ v, f v * f v = 0) → (_root_.ExteriorAlgebra K V →ₐ[K] A)

abbrev algebraLift_value : algebraLift_type :=
  fun K _ _ _ _ _ _ _ f hf => _root_.ExteriorAlgebra.lift K ⟨f, hf⟩

def ideal_eq_span : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  definingIdeal_value K V = TwoSidedIdeal.span
    (Set.range (fun v : V => _root_.TensorAlgebra.ι K v * _root_.TensorAlgebra.ι K v))

def quotient_realization : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∃ e : (definingIdeal_value K V).ringCon.Quotient ≃ₐ[K] _root_.ExteriorAlgebra K V,
    ∀ t, e (RingCon.mkₐ K (definingIdeal_value K V).ringCon t) = quotientMap_value K V t

def quotient_kernel : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ t : _root_.TensorAlgebra K V,
    quotientMap_value K V t = 0 ↔ t ∈ definingIdeal_value K V

def quotient_surjective : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  Function.Surjective (quotientMap_value K V)

def quotient_generator : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ v : V, quotientMap_value K V (_root_.TensorAlgebra.ι K v) = generator_value K V v

def ideal_homogeneous : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ (t : _root_.TensorAlgebra K V), t ∈ definingIdeal_value K V →
    ∀ p : ℕ, (DirectSum.decompose
      (fun n : ℕ => LinearMap.range (_root_.TensorAlgebra.ι K (M := V)) ^ n) t p :
        _root_.TensorAlgebra K V) ∈ definingIdeal_value K V

def square_zero : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ v : V, generator_value K V v * generator_value K V v = 0

def generator_anticommutation : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ u v : V,
    generator_value K V u * generator_value K V v =
      -(generator_value K V v * generator_value K V u)

def algebra_laws : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  (∀ x y z : _root_.ExteriorAlgebra K V, (x * y) * z = x * (y * z)) ∧
    (∀ x : _root_.ExteriorAlgebra K V, 1 * x = x ∧ x * 1 = x) ∧
    (∀ x y z : _root_.ExteriorAlgebra K V,
      (x + y) * z = x * z + y * z ∧ x * (y + z) = x * y + x * z)

def graded_decomposition : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∃ e : _root_.ExteriorAlgebra K V ≃ₐ[K] ⨁ p : ℕ, ⋀[K]^p V,
    ∀ (p : ℕ) (x : ⋀[K]^p V), e x = DirectSum.lof K ℕ (fun p => ⋀[K]^p V) p x

def homogeneous_multiplication : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ (p q : ℕ) (a b : _root_.ExteriorAlgebra K V),
    a ∈ homogeneousPart_value K V p → b ∈ homogeneousPart_value K V q →
      a * b ∈ homogeneousPart_value K V (p + q)

def degree_zero : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∃ e : (⋀[K]^0 V) ≃ₗ[K] K,
    (∀ x : Fin 0 → V, e (exteriorPower.ιMulti K 0 x) = 1) ∧
    (∀ a : K, ((e.symm a : ⋀[K]^0 V) : _root_.ExteriorAlgebra K V) =
      algebraMap K (_root_.ExteriorAlgebra K V) a)

def projection_elementary : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ (p : ℕ) (x : Fin p → V),
    tensorProjection_value K V p (PiTensorProduct.tprod K x) = exteriorPower.ιMulti K p x

def projection_compatibility : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ (p : ℕ) (t : TensorPower K p V),
    (tensorProjection_value K V p t : _root_.ExteriorAlgebra K V) =
      quotientMap_value K V (TensorPower.toTensorAlgebra t)

def projection_surjective : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ p : ℕ, Function.Surjective (tensorProjection_value K V p)

def degree_relations_iff : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ (p : ℕ) (t : TensorPower K p V),
    t ∈ degreeRelations_value K V p ↔ TensorPower.toTensorAlgebra t ∈ definingIdeal_value K V

def degree_quotient : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V],
  ∀ p : ℕ, ∃ e : (TensorPower K p V ⧸ degreeRelations_value K V p) ≃ₗ[K] (⋀[K]^p V),
    ∀ t, e (Submodule.Quotient.mk t) = tensorProjection_value K V p t

def alternating_swap : Prop :=
  ∀ {K : Type u} {V : Type v} {H : Type w} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup H] [Module K H],
  ∀ (p : ℕ) (b : MultilinearMap K (fun _ : Fin p => V) H),
    (∀ (x : Fin p → V) (i j : Fin p), x i = x j → i ≠ j → b x = 0) →
    ∀ (x : Fin p → V) (i j : Fin p), i ≠ j → b (x ∘ Equiv.swap i j) = -b x

def alternating_universal : Prop :=
  ∀ {K : Type u} {V : Type v} {H : Type w} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup H] [Module K H],
  ∀ (p : ℕ) (b : MultilinearMap K (fun _ : Fin p => V) H),
    (∃! L : (⋀[K]^p V) →ₗ[K] H, ∀ x : Fin p → V, L (exteriorPower.ιMulti K p x) = b x) ↔
      (∀ (x : Fin p → V) (i j : Fin p), x i = x j → i ≠ j → b x = 0)

def alternating_annihilates_relations : Prop :=
  ∀ {K : Type u} {V : Type v} {H : Type w} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup H] [Module K H],
  ∀ (p : ℕ) (b : MultilinearMap K (fun _ : Fin p => V) H),
    (∀ (x : Fin p → V) (i j : Fin p), x i = x j → i ≠ j → b x = 0) ↔
      degreeRelations_value K V p ≤ LinearMap.ker (PiTensorProduct.lift b)

def linear_factorization : Prop :=
  ∀ {K : Type u} {V : Type v} {H : Type w} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup H] [Module K H],
  ∀ (p : ℕ) (T : TensorPower K p V →ₗ[K] H),
    (∃! L : (⋀[K]^p V) →ₗ[K] H, L.comp (tensorProjection_value K V p) = T) ↔
      degreeRelations_value K V p ≤ LinearMap.ker T

def alternatingLift_apply : Prop :=
  ∀ {K : Type u} {V : Type v} {H : Type w} [Field K] [AddCommGroup V] [Module K V] [AddCommGroup H] [Module K H],
  ∀ (p : ℕ) (b : AlternatingMap K V H (Fin p)) (x : Fin p → V),
    alternatingLift_value K V H p b (exteriorPower.ιMulti K p x) = b x

def algebra_universal : Prop :=
  ∀ {K : Type u} {V : Type v} {A : Type w} [Field K] [AddCommGroup V] [Module K V] [Ring A] [Algebra K A],
  ∀ f : V →ₗ[K] A,
    (∃! F : _root_.ExteriorAlgebra K V →ₐ[K] A, ∀ v, F (generator_value K V v) = f v) ↔
      ∀ v, f v * f v = 0

def algebraLift_apply : Prop :=
  ∀ {K : Type u} {V : Type v} {A : Type w} [Field K] [AddCommGroup V] [Module K V] [Ring A] [Algebra K A],
  ∀ (f : V →ₗ[K] A) (hf : ∀ v, f v * f v = 0) (v : V),
    algebraLift_value K V A f hf (generator_value K V v) = f v

def algebra_hom_ext : Prop :=
  ∀ {K : Type u} {V : Type v} {A : Type w} [Field K] [AddCommGroup V] [Module K V] [Ring A] [Algebra K A],
  ∀ F G : _root_.ExteriorAlgebra K V →ₐ[K] A,
    (∀ v, F (generator_value K V v) = G (generator_value K V v)) → F = G

def algebra_tensor_factorization : Prop :=
  ∀ {K : Type u} {V : Type v} {A : Type w} [Field K] [AddCommGroup V] [Module K V] [Ring A] [Algebra K A],
  ∀ (f : V →ₗ[K] A) (hf : ∀ v, f v * f v = 0),
    (algebraLift_value K V A f hf).comp (quotientMap_value K V) = _root_.TensorAlgebra.lift K f

end Specs.D05.M15.Exterior
