import MathGenome.Internal.Specs.D05.M15.SymmetricBasis
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-! Independent statements for paper.tex:3003–3009, K05.15.symmetric.

The algebra and all degreewise quotients are the upstream objects. The ideal
is generated by the actual degree-one images of a subspace. Images inside a
symmetric algebra are subalgebras, with the subspace's symmetric algebra
identified through its natural injective map. Quotient compatibility includes
the formula on every representative and equality of homogeneous subspaces;
it therefore specifies a canonical graded isomorphism.

The structural maps have no dimension restriction. The three displayed image,
kernel, and quotient conclusions retain the source's finite-dimensional scope.
No factorial or characteristic-zero assumption is used.
-/
namespace Specs.D05.M15.Symmetric.KernelQuotient
open Specs.D05.M15.Symmetric
open Specs.D05.M15.SymmetricBasis
universe u v w z

section Objects
variable {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]

/-- The algebra map applying `f` to every generator. -/
def map (f : V →ₗ[K] W) : symmetricAlgebra K V →ₐ[K] symmetricAlgebra K W :=
  _root_.SymmetricAlgebra.lift ((_root_.SymmetricAlgebra.ι K W).comp f)

/-- The ordinary ideal generated by the degree-one copy of `U`. The algebra
is commutative, so this is also its two-sided generated ideal. -/
def generatedIdeal (U : Submodule K V) : Ideal (symmetricAlgebra K V) :=
  Ideal.span ((_root_.SymmetricAlgebra.ι K V) '' (U : Set V))
end Objects

def map_type := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W],
  (V →ₗ[K] W) → (symmetricAlgebra K V →ₐ[K] symmetricAlgebra K W)
def map_value : map_type.{u,v,w} := @map

def generatedIdeal_type := ∀ {K : Type u} {V : Type v}
  [Field K] [AddCommGroup V] [Module K V],
  Submodule K V → Ideal (symmetricAlgebra K V)
def generatedIdeal_value : generatedIdeal_type.{u,v} := @generatedIdeal

def map_generator : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W) (v : V),
  map f (_root_.SymmetricAlgebra.ι K V v) = _root_.SymmetricAlgebra.ι K W (f v)

def map_unique : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W) (F : symmetricAlgebra K V →ₐ[K] symmetricAlgebra K W),
  (∀ v, F (_root_.SymmetricAlgebra.ι K V v) = _root_.SymmetricAlgebra.ι K W (f v)) →
  F = map f

def map_id : Prop := ∀ {K : Type u} {V : Type v}
  [Field K] [AddCommGroup V] [Module K V],
  map (LinearMap.id : V →ₗ[K] V) = AlgHom.id K (symmetricAlgebra K V)

def map_comp : Prop := ∀ {K : Type u} {V : Type v} {W : Type w} {X : Type z}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  [AddCommGroup X] [Module K X] (f : V →ₗ[K] W) (g : W →ₗ[K] X),
  map (g.comp f) = (map g).comp (map f)

/-- Applying `f` in every slot descends to each actual symmetric-power quotient,
uniquely, and commutes with its inclusion in the algebra. This includes p=0. -/
def degree_map : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W) (p : ℕ),
  ∃! L : symmetricPower K V p →ₗ[K] symmetricPower K W p,
    (∀ x : Fin p → V, L (elementary K V p x) = elementary K W p (f ∘ x)) ∧
    (powerInclusion (K := K) (V := W) p).comp L =
      (map f).toLinearMap.comp (powerInclusion (K := K) (V := V) p)

def map_degree_zero : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W) (c : K),
  map f (algebraMap K (symmetricAlgebra K V) c) =
    algebraMap K (symmetricAlgebra K W) c

def map_injective : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W), Function.Injective f → Function.Injective (map f)

def map_surjective : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  (f : V →ₗ[K] W), Function.Surjective f → Function.Surjective (map f)

/-- The natural image is exactly the algebra generated by the image vectors. -/
def image_eq_adjoin : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
  (map f).range = Algebra.adjoin K
    ((_root_.SymmetricAlgebra.ι K W) '' (LinearMap.range f : Set W))

/-- This makes `im Sym(f) = Sym(im f)` an identification through the
natural map, and includes injectivity of that subspace map. -/
def image_eq_subspace : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
  Function.Injective (map (LinearMap.range f).subtype) ∧
    (map f).range = (map (LinearMap.range f).subtype).range

def kernel_eq_generatedIdeal : Prop := ∀ {K : Type u} {V : Type v} {W : Type w}
  [Field K] [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
  [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
  RingHom.ker (map f).toRingHom = generatedIdeal (LinearMap.ker f)

/-- The unique isomorphism induced by the quotient map. The second condition
is gradedness in both directions: each homogeneous image is mapped ONTO the
corresponding actual homogeneous subspace, including degree zero. -/
def quotient_equiv : Prop := ∀ {K : Type u} {V : Type v}
  [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (U : Submodule K V),
  ∃! E : (symmetricAlgebra K V ⧸ generatedIdeal U) ≃ₐ[K]
      symmetricAlgebra K (V ⧸ U),
    (∀ a, E (Ideal.Quotient.mk (generatedIdeal U) a) = map U.mkQ a) ∧
    ∀ p : ℕ,
      Submodule.map E.toLinearMap
        (Submodule.map (Ideal.Quotient.mkₐ K (generatedIdeal U)).toLinearMap
          (LinearMap.range (powerInclusion (K := K) (V := V) p))) =
      LinearMap.range (powerInclusion (K := K) (V := V ⧸ U) p)

end Specs.D05.M15.Symmetric.KernelQuotient
