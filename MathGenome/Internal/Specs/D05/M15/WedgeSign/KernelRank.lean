import MathGenome.Internal.Specs.D05.M15.WedgeSign
import MathGenome.Internal.Specs.D05.M15.ExteriorBasis
import Mathlib.LinearAlgebra.ExteriorAlgebra.Basis
import Mathlib.RingTheory.Congruence.Hom
import Mathlib.RingTheory.TwoSidedIdeal.Kernel

/-! K05.15.wedge_sign, Images, kernels, quotients, and ranks (2926–2937).
The ideal is generated by the actual embedded vectors, and the image exterior
algebra is embedded using the inclusion of the actual range. The quotient
comparison must commute with the quotient map and carry each homogeneous
quotient component onto the corresponding exterior power. No averaging or
characteristic restriction is involved. -/
noncomputable section
namespace Specs.D05.M15.WedgeSign.KernelRank
universe u v w

/-- The two-sided ideal generated by a subspace in the exterior algebra. -/
def generatedIdeal {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] (U : Submodule K V) :
    TwoSidedIdeal (_root_.ExteriorAlgebra K V) :=
  TwoSidedIdeal.span ((_root_.ExteriorAlgebra.ι K) '' (U : Set V))

/-- The intrinsic quotient algebra, before the quotient compatibility theorem. -/
abbrev ExteriorQuotient {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] (U : Submodule K V) :=
  (generatedIdeal U).ringCon.Quotient

abbrev quotientProjection {K : Type u} {V : Type v} [Field K]
    [AddCommGroup V] [Module K V] (U : Submodule K V) :
    _root_.ExteriorAlgebra K V →ₐ[K] ExteriorQuotient U :=
  (generatedIdeal U).ringCon.mkₐ K

def image : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
    (exteriorMap_value f).range = (exteriorMap_value (LinearMap.range f).subtype).range

def image_embedding : Prop :=
  ∀ {K : Type u} {W : Type w} [Field K] [AddCommGroup W] [Module K W]
    (S : Submodule K W),
    Function.Injective (exteriorMap_value S.subtype)

def power_image : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W) (p : ℕ),
    LinearMap.range (powerMap_value p f) =
      LinearMap.range (powerMap_value p (LinearMap.range f).subtype)

def kernel : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
    TwoSidedIdeal.ker (exteriorMap_value f).toRingHom = generatedIdeal (LinearMap.ker f)

/-- The comparison is induced by V → V/U, and is graded: the image under it
of the projected degree-p submodule is precisely the target degree-p submodule. -/
def quotient_equiv : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (U : Submodule K V),
    ∃ e : ExteriorQuotient U ≃ₐ[K] _root_.ExteriorAlgebra K (V ⧸ U),
      (∀ a, e (quotientProjection U a) = exteriorMap_value U.mkQ a) ∧
      (∀ p : ℕ,
        ((⋀[K]^p V).map (quotientProjection U).toLinearMap).map e.toLinearMap =
          ⋀[K]^p (V ⧸ U))

def quotient_generator : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
    (U : Submodule K V) (x : V),
    exteriorMap_value U.mkQ (_root_.ExteriorAlgebra.ι K x) =
      _root_.ExteriorAlgebra.ι K (U.mkQ x)

def power_rank : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W) (p : ℕ),
    Module.finrank K (LinearMap.range (powerMap_value p f)) =
      (Module.finrank K (LinearMap.range f)).choose p

def degree_zero_rank : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W),
    Module.finrank K (LinearMap.range (powerMap_value 0 f)) = 1

def above_rank : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [FiniteDimensional K W] (f : V →ₗ[K] W) (p : ℕ),
    Module.finrank K (LinearMap.range f) < p →
      powerMap_value p f = 0

def fixes_unit : Prop :=
  ∀ {K : Type u} {V : Type v} {W : Type w} [Field K]
    [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W] (f : V →ₗ[K] W),
    exteriorMap_value f 1 = 1

/-- For a basis adapted to U (the indices S are its U-basis), the ideal has
exactly the basis wedges whose finite index sets meet S. -/
def ideal_monomial_basis : Prop :=
  ∀ {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (n : ℕ) (b : Module.Basis (Fin n) K V) (S : Set (Fin n)),
    (∀ x : _root_.ExteriorAlgebra K V,
      x ∈ generatedIdeal (Submodule.span K (b '' S)) ↔
      x ∈ Submodule.span K (b.ExteriorAlgebra '' {t | ∃ i ∈ t, i ∈ S})) ∧
    LinearIndependent K (fun t : {t : Finset (Fin n) // ∃ i ∈ t, i ∈ S} =>
      b.ExteriorAlgebra t.val)

end Specs.D05.M15.WedgeSign.KernelRank
