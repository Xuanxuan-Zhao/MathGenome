import MathGenome.Internal.Specs.D05.Foundations.IdealsGcd
import MathGenome.Internal.Specs.D05.M05.DetDefinition
import Mathlib.Data.Finset.Sort

/-! Determinantal ideals, including rectangular and empty matrices.
We permit all row and column words in the generators. Repeated indices contribute
zero; `injective_generators` explicitly identifies this with genuine minors.
No Smith decomposition or correctness certificate is part of these definitions. -/
noncomputable section
open scoped BigOperators

namespace D05.M10.InvariantFactorComputation

/-- Ideal generated by the determinants of all square submatrices of size k.
Allowing repeated indices adds only zero generators. -/
def minorIdeal {R : Type*} [CommRing R] {m n : ℕ}
    (M : Matrix (Fin m) (Fin n) R) (k : ℕ) : Ideal R :=
  Ideal.span {x | ∃ (ρ : Fin k → Fin m) (κ : Fin k → Fin n),
    (M.submatrix ρ κ).det = x}

/-- Monic normalization of the principal generator, with the zero ideal giving zero. -/
def minorGcd {K : Type*} [Field K] {m n : ℕ}
    (M : Matrix (Fin m) (Fin n) (Polynomial K)) (k : ℕ) : Polynomial K := by
  classical
  exact normalize (Submodule.IsPrincipal.generator (minorIdeal M k))

/-- Rectangular diagonal with the supplied (zero-padded) diagonal sequence. -/
def rectDiagonal {R : Type*} [CommRing R] (m n : ℕ) (d : ℕ → R) :
    Matrix (Fin m) (Fin n) R :=
  fun i j => if i.val = j.val then d i.val else 0

/-- Product of the first k entries; the empty product is one. -/
def prefixProduct {R : Type*} [CommMonoid R] (d : ℕ → R) (k : ℕ) : R :=
  ∏ i ∈ Finset.range k, d i

/-- Nonzero monic diagonal entries in increasing divisibility order, then zeros.
The all-pairs divisibility clause is the transitive form of d₁ ∣ … ∣ dᵣ;
it remains valid on the zero padding. -/
def DiagonalChain {K : Type*} [Field K] (d : ℕ → Polynomial K) (r : ℕ) : Prop :=
  (∀ i, i < r → (d i).Monic) ∧
  (∀ i, r ≤ i → d i = 0) ∧
  (∀ i j, i ≤ j → d i ∣ d j)

end D05.M10.InvariantFactorComputation

namespace D05.Specs.MinorIdeals
open D05.M10.InvariantFactorComputation

/-- The transitive chain convention is equivalent to the paper's adjacent
relations, with precisely the same monicity and zero-padding hypotheses. -/
def chain_iff_adjacent : Prop :=
  ∀ (K : Type*) [Field K] (d : ℕ → Polynomial K) (r : ℕ),
    DiagonalChain d r ↔
      (∀ i, i < r → (d i).Monic) ∧
      (∀ i, r ≤ i → d i = 0) ∧
      (∀ i, i + 1 < r → d i ∣ d (i + 1))

/-- Explicit bridge to submatrices with distinct selected rows and columns. -/
def injective_generators : Prop :=
  ∀ (R : Type*) [CommRing R] (m n k : ℕ) (M : Matrix (Fin m) (Fin n) R),
    minorIdeal M k = Ideal.span {x | ∃ (ρ : Fin k → Fin m) (κ : Fin k → Fin n),
      Function.Injective ρ ∧ Function.Injective κ ∧ (M.submatrix ρ κ).det = x}

/-- Stronger than elementary invariance: arbitrary invertible left and right
multipliers preserve every determinantal ideal. -/
def invertible_invariance : Prop :=
  ∀ (R : Type*) [CommRing R] (m n k : ℕ) (M : Matrix (Fin m) (Fin n) R)
    (U : (Matrix (Fin m) (Fin m) R)ˣ) (V : (Matrix (Fin n) (Fin n) R)ˣ),
    minorIdeal ((U : Matrix (Fin m) (Fin m) R) * M *
      (V : Matrix (Fin n) (Fin n) R)) k = minorIdeal M k

/-- The size-zero ideal is the unit ideal, in all shapes. -/
def zero_size : Prop :=
  ∀ (R : Type*) [CommRing R] (m n : ℕ) (M : Matrix (Fin m) (Fin n) R),
    minorIdeal M 0 = ⊤

/-- No square submatrix can exceed either ambient dimension. -/
def oversized : Prop :=
  ∀ (R : Type*) [CommRing R] (m n k : ℕ) (M : Matrix (Fin m) (Fin n) R),
    (m < k ∨ n < k) → minorIdeal M k = ⊥

/-- Principal generator and common-divisor characterization: this is a gcd of
all minors, not an assumed determinantal-divisor certificate. -/
def gcd_properties : Prop :=
  ∀ (K : Type*) [Field K] (m n k : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K)),
    Ideal.span {minorGcd M k} = minorIdeal M k ∧
    (minorGcd M k = 0 ↔ minorIdeal M k = ⊥) ∧
    (minorGcd M k ≠ 0 → (minorGcd M k).Monic) ∧
    (∀ p : Polynomial K, p ∣ minorGcd M k ↔
      ∀ (ρ : Fin k → Fin m) (κ : Fin k → Fin n), p ∣ (M.submatrix ρ κ).det)

/-- All three cases of the diagonal determinantal-ideal formula. -/
def diagonal_ideals : Prop :=
  ∀ (K : Type*) [Field K] (m n r : ℕ) (d : ℕ → Polynomial K),
    r ≤ m → r ≤ n → DiagonalChain d r →
    (∀ k, k ≤ r → minorIdeal (rectDiagonal m n d) k =
      Ideal.span {prefixProduct d k}) ∧
    (∀ k, r < k → minorIdeal (rectDiagonal m n d) k = ⊥) ∧
    minorIdeal (rectDiagonal m n d) 0 = ⊤

/-- The same formulas for the normalized gcd, together with consecutive
quotients recovering every nonzero diagonal entry (zero-based index i). -/
def diagonal_gcd : Prop :=
  ∀ (K : Type*) [Field K] (m n r : ℕ) (d : ℕ → Polynomial K),
    r ≤ m → r ≤ n → DiagonalChain d r →
    (∀ k, k ≤ r → minorGcd (rectDiagonal m n d) k = prefixProduct d k) ∧
    (∀ k, r < k → minorGcd (rectDiagonal m n d) k = 0) ∧
    minorGcd (rectDiagonal m n d) 0 = 1 ∧
    (∀ i, i < r → d i = minorGcd (rectDiagonal m n d) (i + 1) /
      minorGcd (rectDiagonal m n d) i)

/-- Transfer the gcd and quotient formulas back through any invertible
left/right change from M to the supplied diagonal. -/
def transformed_gcd : Prop :=
  ∀ (K : Type*) [Field K] (m n r : ℕ) (d : ℕ → Polynomial K)
    (M : Matrix (Fin m) (Fin n) (Polynomial K))
    (U : (Matrix (Fin m) (Fin m) (Polynomial K))ˣ)
    (V : (Matrix (Fin n) (Fin n) (Polynomial K))ˣ),
    r ≤ m → r ≤ n → DiagonalChain d r →
    (U : Matrix (Fin m) (Fin m) (Polynomial K)) * M *
      (V : Matrix (Fin n) (Fin n) (Polynomial K)) = rectDiagonal m n d →
    (∀ k, k ≤ r → minorGcd M k = prefixProduct d k) ∧
    (∀ k, r < k → minorGcd M k = 0) ∧ minorGcd M 0 = 1 ∧
    (∀ i, i < r → d i = minorGcd M (i + 1) / minorGcd M i)

end D05.Specs.MinorIdeals
