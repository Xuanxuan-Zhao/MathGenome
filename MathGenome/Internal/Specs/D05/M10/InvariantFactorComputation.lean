import MathGenome.Internal.Specs.D05.M10.InvariantFactorComputation.Existence
import MathGenome.Internal.Specs.D05.M10.InvariantFactorComputation.MinorIdeals
import Mathlib.LinearAlgebra.Matrix.Charpoly.Coeff

/-! Independent statements for K05.10.invariant_factor_computation,
paper.tex:1468–1481. The operator-module identification after discarding unit
entries belongs to the following rational-form entry, not to an assumption here.
All entries are formal polynomials over the original field. -/
noncomputable section

namespace D05.M10.InvariantFactorComputation
open D05.M10.Smith

/-- An actual word of permitted operations produces the stated normalized
rectangular diagonal. No determinantal-divisor formula is assumed. -/
def SmithReduction {K : Type*} [Field K] {m n : ℕ}
    (M : Matrix (Fin m) (Fin n) (Polynomial K))
    (ops : List (Operation K m n)) (r : ℕ) (d : ℕ → Polynomial K) : Prop :=
  r ≤ m ∧ r ≤ n ∧ DiagonalChain d r ∧ run ops M = rectDiagonal m n d

/-- The gcd of all k-minors, with the zero-size and above-rank conventions,
and the consecutive polynomial quotients recovering the nonzero entries. -/
def ComputesMinors {K : Type*} [Field K] {m n : ℕ}
    (M : Matrix (Fin m) (Fin n) (Polynomial K)) (r : ℕ)
    (d : ℕ → Polynomial K) : Prop :=
  (∀ k, k ≤ r → minorGcd M k = prefixProduct d k) ∧
  (∀ k, r < k → minorGcd M k = 0) ∧ minorGcd M 0 = 1 ∧
  (∀ i, i < r → d i = minorGcd M (i+1) / minorGcd M i)

end D05.M10.InvariantFactorComputation

namespace D05.Specs.InvariantFactorComputation
open D05.M10.Smith D05.M10.InvariantFactorComputation

/-- Every permitted operation has a permitted two-sided inverse. -/
def operation_inverse : Prop := ∀ (K : Type*) [Field K] (m n : ℕ)
    (op : Operation K m n) (M : Matrix (Fin m) (Fin n) (Polynomial K)),
  op.inverse.apply (op.apply M) = M ∧ op.apply (op.inverse.apply M) = M

/-- The ideal generated by k-minors is invariant under each permitted operation. -/
def elementary_invariance : Prop := ∀ (K : Type*) [Field K] (m n k : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K)) (op : Operation K m n),
  minorIdeal (op.apply M) k = minorIdeal M k

/-- Invariance for an arbitrary finite execution of elementary operations. -/
def run_invariance : Prop := ∀ (K : Type*) [Field K] (m n k : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K)) (ops : List (Operation K m n)),
  minorIdeal (run ops M) k = minorIdeal M k

/-- The formulas hold for every reduction, not only a chosen witness. -/
def reduction_computes : Prop := ∀ (K : Type*) [Field K] (m n : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K)) (ops : List (Operation K m n))
    (r : ℕ) (d : ℕ → Polynomial K),
  SmithReduction M ops r d → ComputesMinors M r d

/-- Full rectangular Smith theorem and the gcd-of-minors computation. -/
def smith_computation : Prop := ∀ (K : Type*) [Field K] (m n : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K)),
  ∃ (ops : List (Operation K m n)) (r : ℕ) (d : ℕ → Polynomial K),
    SmithReduction M ops r d ∧ ComputesMinors M r d

/-- Both the number of nonzero entries and the full zero-padded monic sequence
are independent of all choices in reduction. -/
def smith_unique : Prop := ∀ (K : Type*) [Field K] (m n : ℕ)
    (M : Matrix (Fin m) (Fin n) (Polynomial K))
    (ops ops' : List (Operation K m n)) (r s : ℕ) (d e : ℕ → Polynomial K),
  SmithReduction M ops r d → SmithReduction M ops' s e → r = s ∧ d = e

/-- Nonzero determinant forces all n Smith entries to be nonzero. -/
def nonsingular_rank : Prop := ∀ (K : Type*) [Field K] (n : ℕ)
    (M : Matrix (Fin n) (Fin n) (Polynomial K)) (ops : List (Operation K n n))
    (r : ℕ) (d : ℕ → Polynomial K),
  M.det ≠ 0 → SmithReduction M ops r d → r = n

/-- For xI-A the normalized top gcd is exactly the characteristic polynomial;
its Smith reduction has n nonzero entries, even when A is singular or n=0. -/
def characteristic_smith : Prop := ∀ (K : Type*) [Field K] (n : ℕ)
    (A : Matrix (Fin n) (Fin n) K),
  A.charpoly.Monic ∧ A.charpoly ≠ 0 ∧ A.charpoly.natDegree = n ∧
  ∃ (ops : List (Operation K n n)) (d : ℕ → Polynomial K),
    SmithReduction A.charmatrix ops n d ∧ ComputesMinors A.charmatrix n d ∧
    minorGcd A.charmatrix n = A.charpoly ∧ prefixProduct d n = A.charpoly ∧
    (∀ i, i < n → (IsUnit (d i) ↔ d i = 1))

end D05.Specs.InvariantFactorComputation
