import MathGenome.Internal.Specs.D07.Ch11.PolynomialUfd
import MathGenome.Internal.Specs.D07.Ch11.PolynomialDefinition
import Mathlib.RingTheory.Ideal.Span

/-!
Independent statements for K07.10.ufd_not_pid, paper.tex:2057–2065.
The ring is the formal polynomial ring over the integers. Its domain
structure is canonical, so failure of the principal ideal ring property
is exactly failure to be a PID. The displayed ideal is generated by the
constant polynomial 2 and the indeterminate X.
-/

namespace Specs.D07.Ch10.UfdNotPid

open Polynomial

local notation "I₂X" => (Ideal.span ({(2 : ℤ[X]), X} : Set ℤ[X]))

def IntegerPolynomialUfd : Prop :=
  UniqueFactorizationMonoid ℤ[X]

def EvenConstantCoefficient : Prop :=
  ∀ f : ℤ[X], f ∈ I₂X → (2 : ℤ) ∣ f.coeff 0

def TwoXIdealProper : Prop :=
  I₂X ≠ ⊤

/-- No polynomial generates the particular ideal (2,X). -/
def TwoXIdealNotPrincipal : Prop :=
  ¬ ∃ h : ℤ[X], I₂X = Ideal.span {h}

def IntegerPolynomialNotPid : Prop :=
  ¬ IsPrincipalIdealRing ℤ[X]

end Specs.D07.Ch10.UfdNotPid
