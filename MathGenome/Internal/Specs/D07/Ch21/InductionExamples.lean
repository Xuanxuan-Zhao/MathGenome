import MathGenome.Internal.Specs.D07.Ch21.InducedCharacter
import MathGenome.Internal.Specs.D07.Ch21.S3Table
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.GroupTheory.SpecificGroups.Alternating

/-! Independent statements for paper.tex:6656–6699. The induction space is
exactly the shared balanced tensor quotient. No character computation is
substituted for an equivalence of representations. -/
namespace Specs.D07.Ch21.InductionExamples
noncomputable section
open scoped BigOperators
open Representation
open Specs.D07.Ch21.InductionCosetModelInductionConventionBridge
open Specs.D07.Ch21.S3Table

universe u

/-- An action on the source quotient is prescribed on every generator. -/
def IsInduced {G : Type*} [Group G] (H : Subgroup G)
    {V : Type*} [AddCommGroup V] [Module ℂ V] (ρ : Representation ℂ H V)
    (σ : Representation ℂ G (NotesInd H ρ)) : Prop :=
  ∀ k g v, σ k (notesMk H ρ g v) = notesMk H ρ (k * g) v

/-- The coset basis, and its permutation action, including the generator formula. -/
def TrivialInduction : Prop :=
  ∀ (G : Type u) [Group G] [Finite G] (H : Subgroup G),
    ∃ (σ : Representation ℂ G (NotesInd H (trivial ℂ H ℂ)))
      (e : NotesInd H (trivial ℂ H ℂ) ≃ₗ[ℂ] ((G ⧸ H) →₀ ℂ)),
      IsInduced H (trivial ℂ H ℂ) σ ∧
      (∀ g c, e (notesMk H (trivial ℂ H ℂ) g c) =
        Finsupp.single (QuotientGroup.mk g) c) ∧
      (∀ k q c, e (σ k (e.symm (Finsupp.single q c))) =
        Finsupp.single (k • q) c) ∧
      Nonempty (σ.Equiv (ofMulAction ℂ G (G ⧸ H)))

/-- Induction from the identity subgroup is regular, including G = 1. -/
def RegularInduction : Prop :=
  ∀ (G : Type u) [Group G] [Finite G],
    ∃ (σ : Representation ℂ G (NotesInd (⊥ : Subgroup G) (trivial ℂ _ ℂ)))
      (e : σ.Equiv (leftRegular ℂ G)),
      IsInduced ⊥ (trivial ℂ _ ℂ) σ ∧
      (∀ g c, e (notesMk ⊥ (trivial ℂ _ ℂ) g c) = MonoidAlgebra.single g c)

/-- The sum of the regular basis spans a proper nonzero invariant line when
|G|>1. The one-dimensional input is irreducible, the induced action is not. -/
def RegularExample : Prop :=
  ∀ (G : Type u) [Group G] [Fintype G], 1 < Fintype.card G →
    ∃ (σ : Representation ℂ G (NotesInd (⊥ : Subgroup G) (trivial ℂ _ ℂ)))
      (e : σ.Equiv (leftRegular ℂ G)),
      IsInduced ⊥ (trivial ℂ _ ℂ) σ ∧
      (∀ g c, e (notesMk ⊥ (trivial ℂ _ ℂ) g c) = MonoidAlgebra.single g c) ∧
      let z : MonoidAlgebra ℂ G := ∑ g : G, MonoidAlgebra.single g 1
      z ≠ 0 ∧ Submodule.span ℂ {z} ≠ ⊤ ∧
      (∀ k, leftRegular ℂ G k z = z) ∧
      Representation.IsIrreducible (trivial ℂ (⊥ : Subgroup G) ℂ) ∧
      ¬ Representation.IsIrreducible σ

/-- The subgroup generated by (12), and the actual alternating subgroup. -/
abbrev H2 : Subgroup S3 := Subgroup.zpowers s
abbrev H3 : Subgroup S3 := alternatingGroup (Fin 3)

/-- Restrict the ordinary sign representation to the order-two subgroup. -/
abbrev epsilon : Representation ℂ H2 ℂ := sign.comp H2.subtype

/-- The coset identification is the specified map gH ↦ g(3), not just a
cardinality statement. The final point is labelled 2 in Fin 3. -/
def S3Cosets : Prop :=
  H2 = MulAction.stabilizer S3 (2 : Fin 3) ∧
  ∃ e : (S3 ⧸ H2) ≃ Fin 3,
    (∀ g, e (QuotientGroup.mk g) = g 2) ∧
    (∀ (k : S3) q, e (k • q) = k (e q))

/-- The two inductions from the order-two subgroup, with their genuine actions,
characters on every group element, and equivalences to the stated sums. -/
def S3OrderTwo : Prop :=
  ∃ (τ : Representation ℂ S3 plane),
    (∀ g v i, (τ g v : V3) i = (v : V3) (g⁻¹ i)) ∧
    ∃ (σ₀ : Representation ℂ S3 (NotesInd H2 (trivial ℂ H2 ℂ)))
      (σ₁ : Representation ℂ S3 (NotesInd H2 epsilon)),
      IsInduced H2 (trivial ℂ H2 ℂ) σ₀ ∧ IsInduced H2 epsilon σ₁ ∧
      (∃ h : H2, epsilon h (1 : ℂ) = -1) ∧
      (χ σ₀ 1 = 3 ∧ χ σ₀ s = 1 ∧ χ σ₀ a = 0) ∧
      (χ σ₁ 1 = 3 ∧ χ σ₁ s = -1 ∧ χ σ₁ a = 0) ∧
      (∀ g, χ σ₀ g = χ triv g + χ τ g) ∧
      (∀ g, χ σ₁ g = χ sign g + χ τ g) ∧
      Nonempty (σ₀.Equiv permRep) ∧
      Nonempty (σ₀.Equiv (triv.prod τ)) ∧
      Nonempty (σ₁.Equiv (sign.prod τ))

/-- Multiplication by the scalar character ψ. -/
def scalarRep (ψ : H3 →* ℂ) : Representation ℂ H3 ℂ :=
  (algebraMap ℂ (Module.End ℂ ℂ)).toMonoidHom.comp ψ

/-- Existence of the primitive root, the specified two coset representatives,
and the conjugation relation used for the cubic character. -/
def CubicPreliminaries : Prop :=
  (∃ ω : ℂ, IsPrimitiveRoot ω 3) ∧ s⁻¹ * a * s = a⁻¹ ∧
  ∃ e : Fin 2 ≃ (S3 ⧸ H3),
    e 0 = QuotientGroup.mk 1 ∧ e 1 = QuotientGroup.mk s

/-- Induction from A₃, including both distinct conjugate inputs, the failure of
injectivity on equivalence types, and the obstruction to extension on a line.
The primitive root may be any choice, as in the source. -/
def S3OrderThree : Prop :=
  H3 = Subgroup.zpowers a ∧
  ∀ ω : ℂ, IsPrimitiveRoot ω 3 →
    ∃ (ha : a ∈ H3) (ψ ψbar : H3 →* ℂ)
      (τ : Representation ℂ S3 plane)
      (σ : Representation ℂ S3 (NotesInd H3 (scalarRep ψ)))
      (σbar : Representation ℂ S3 (NotesInd H3 (scalarRep ψbar))),
      ψ ⟨a, ha⟩ = ω ∧
      (∀ h, ψbar h = starRingEnd ℂ (ψ h)) ∧
      (∀ g v i, (τ g v : V3) i = (v : V3) (g⁻¹ i)) ∧
      IsInduced H3 (scalarRep ψ) σ ∧ IsInduced H3 (scalarRep ψbar) σbar ∧
      (χ σ 1 = 2 ∧ χ σ s = 0 ∧ χ σ a = -1) ∧
      (∀ g, χ σ g = χ τ g) ∧ (∀ g, χ σbar g = χ τ g) ∧
      Nonempty (σ.Equiv τ) ∧ Nonempty (σbar.Equiv τ) ∧
      Representation.IsIrreducible σ ∧
      Representation.IsIrreducible (scalarRep ψ) ∧
      Representation.IsIrreducible (scalarRep ψbar) ∧
      ¬ Nonempty ((scalarRep ψ).Equiv (scalarRep ψbar)) ∧
      Nonempty (σ.Equiv σbar) ∧
      ¬ ∃ θ : S3 →* ℂ, θ.comp H3.subtype = ψ

end
end Specs.D07.Ch21.InductionExamples
