import MathGenome.Internal.Specs.D07.Ch01.IntegerPowerLaws
import MathGenome.Internal.Specs.D07.Ch01.SubgroupLattice
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
Independent specification of `K07.02.cyclic_definition`
(paper.tex:425–428; chapters/M07.02.tex:3–6).

The canonical subgroup `Subgroup.zpowers x` must have exactly the source's
integer powers as its carrier. Its generator and least-subgroup property
identify it with the singleton closure used in Chapter 1. The canonical
predicate `IsCyclic` is related explicitly to both descriptions of generation.
All ambient groups are arbitrary; no finiteness, commutativity, or
nontriviality hypothesis is imposed. In particular, the final proposition
includes every one-element group.
-/

namespace Specs.D07.Ch02.CyclicDefinition

universe u

/-- The set of all integer powers is the carrier of the canonical subgroup. -/
def CyclicSubgroupCarrier : Prop :=
  ∀ (G : Type u) [Group G] (x : G),
    (Subgroup.zpowers x : Set G) = {y : G | ∃ k : ℤ, x ^ k = y}

/-- The indicated generator belongs to this subgroup. -/
def GeneratorMem : Prop :=
  ∀ (G : Type u) [Group G] (x : G), x ∈ Subgroup.zpowers x

/-- A subgroup contains all powers exactly when it contains the generator. -/
def CyclicSubgroupLeIff : Prop :=
  ∀ (G : Type u) [Group G] (x : G) (H : Subgroup G),
    Subgroup.zpowers x ≤ H ↔ x ∈ H

/-- Agreement with the subgroup generated by a singleton in Chapter 1. -/
def CyclicSubgroupEqGenerated : Prop :=
  ∀ (G : Type u) [Group G] (x : G),
    Subgroup.zpowers x = Subgroup.closure ({x} : Set G)

/-- Cyclicity means every element is an integer power of one chosen element. -/
def CyclicIffIntegerPowers : Prop :=
  ∀ (G : Type u) [Group G],
    IsCyclic G ↔ ∃ x : G, ∀ y : G, ∃ k : ℤ, x ^ k = y

/-- Equivalently, the cyclic subgroup of some element is the entire group. -/
def CyclicIffCyclicSubgroupEqTop : Prop :=
  ∀ (G : Type u) [Group G],
    IsCyclic G ↔ ∃ x : G, Subgroup.zpowers x = ⊤

/-- The definition includes the trivial group, with its given group operations. -/
def TrivialGroupIsCyclic : Prop :=
  ∀ (G : Type u) [Group G] [Subsingleton G], IsCyclic G

end Specs.D07.Ch02.CyclicDefinition
