import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.AlgebraicIndependent.Basic

/-! The concrete two-variable inseparable counterexample, paper.tex:3824–3829.
`E` is the fraction field of the polynomial ring in two independent formal
variables. `K` is the subfield generated by the prime field and their p-th
powers; it is not an unspecified field satisfying the desired conclusions. -/
namespace Specs.D07.Ch12.PrimitiveElementInseparableNonsimpleExample

noncomputable section

abbrev P (p : ℕ) := MvPolynomial (Fin 2) (ZMod p)
abbrev E (p : ℕ) [Fact p.Prime] := FractionRing (P p)

def indeterminate (p : ℕ) [Fact p.Prime] (i : Fin 2) : E p :=
  algebraMap (P p) (E p) (MvPolynomial.X i)

def K (p : ℕ) [Fact p.Prime] : Subfield (E p) :=
  Subfield.closure (Set.range (algebraMap (ZMod p) (E p)) ∪
    {indeterminate p 0 ^ p, indeterminate p 1 ^ p})

def monomials (p : ℕ) [Fact p.Prime] (ij : Fin p × Fin p) : E p :=
  indeterminate p 0 ^ (ij.1 : ℕ) * indeterminate p 1 ^ (ij.2 : ℕ)

/-- The fraction-field model realizes two algebraically independent generators. -/
def RationalFunctionModel : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    AlgebraicIndependent (ZMod p) (indeterminate p) ∧
    IntermediateField.adjoin (ZMod p) (Set.range (indeterminate p)) = ⊤

def MonomialBasis : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    ∃ b : Module.Basis (Fin p × Fin p) (K p) (E p), ∀ ij, b ij = monomials p ij

def PowersInBase : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (x : E p), x ^ p ∈ K p

def DegreeAndAlgebraicity : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    FiniteDimensional (K p) (E p) ∧ Algebra.IsAlgebraic (K p) (E p) ∧
    Module.finrank (K p) (E p) = p ^ 2 ∧ Module.rank (K p) (E p) = (p ^ 2 : ℕ)

def SimpleDegreeBound : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (x : E p),
    FiniteDimensional (K p) (IntermediateField.adjoin (K p) {x}) ∧
    Module.finrank (K p) (IntermediateField.adjoin (K p) {x}) ≤ p

def NotSimple : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    ¬ ∃ x : E p, IntermediateField.adjoin (K p) {x} = ⊤

end
end Specs.D07.Ch12.PrimitiveElementInseparableNonsimpleExample
