import MathGenome.Internal.Specs.D07.Ch12.PerfectFields
import MathGenome.Internal.Specs.D07.Ch12.DegreeDefinition
import MathGenome.Internal.Specs.D07.Ch12.PrimitiveElementInseparableNonsimpleExample
import MathGenome.Internal.Specs.D07.Ch12.FiniteAlgebraicAlgebraicClosureInfiniteDegree

/-!
K07.12.primitive_element, paper.tex:3809–3824.

The embedding and scalar action are the specified `Algebra K E`. Simplicity
means generation as a field, with no requirement on multiplicative order.
Finite-dimensionality means finite vector-space degree, not a finite set.
The cardinal formulation uses the existing source degree predicate.

The counterexamples use the canonical concrete objects from the separately
allocated upstream goals. In particular, the positive-characteristic example
is the fraction field in two independent variables over ZMod p with base the
subfield generated by their p-th powers, and the closure statement applies to
every algebraic closure of the rationals, without any premise about ℂ.
-/

universe u v

namespace Specs.D07.Ch12.PrimitiveElement

def FiniteSeparableSimple : Prop :=
  ∀ (K : Type u) (E : Type v) [Field K] [Field E] [Algebra K E]
    [FiniteDimensional K E],
    SeparableDefinition.extensionSeparableValue K E →
      ∃ a : E, IntermediateField.adjoin K {a} = ⊤

def CardinalFiniteSeparableSimple : Prop :=
  ∀ (K : Type u) (E : Type v) [Field K] [Field E] [Algebra K E],
    DegreeDefinition.finiteExtensionValue K E →
    SeparableDefinition.extensionSeparableValue K E →
      ∃ a : E, IntermediateField.adjoin K {a} = ⊤

def CharacteristicZeroSimple : Prop :=
  ∀ (K : Type u) (E : Type v) [Field K] [Field E] [Algebra K E]
    [CharZero K] [FiniteDimensional K E],
    ∃ a : E, IntermediateField.adjoin K {a} = ⊤

def FiniteBaseSimple : Prop :=
  ∀ (K : Type u) (E : Type v) [Field K] [Field E] [Algebra K E]
    [Finite K] [FiniteDimensional K E],
    ∃ a : E, IntermediateField.adjoin K {a} = ⊤

/-- The complete finite counterexample, retaining the independent variables,
the displayed monomial basis, and the bound on every simple subextension. -/
def InseparableCounterexample : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    let E := PrimitiveElementInseparableNonsimpleExample.E p
    let K := PrimitiveElementInseparableNonsimpleExample.K p
    let x := PrimitiveElementInseparableNonsimpleExample.indeterminate p
    AlgebraicIndependent (ZMod p) x ∧
    IntermediateField.adjoin (ZMod p) (Set.range x) = ⊤ ∧
    (∃ b : Module.Basis (Fin p × Fin p) K E,
      ∀ ij, b ij = PrimitiveElementInseparableNonsimpleExample.monomials p ij) ∧
    FiniteDimensional K E ∧ Algebra.IsAlgebraic K E ∧
    Module.finrank K E = p ^ 2 ∧ Module.rank K E = (p ^ 2 : ℕ) ∧
    (∀ a : E, a ^ p ∈ K) ∧
    (∀ a : E, FiniteDimensional K (IntermediateField.adjoin K {a}) ∧
      Module.finrank K (IntermediateField.adjoin K {a}) ≤ p) ∧
    ¬ ∃ a : E, IntermediateField.adjoin K {a} = ⊤

/-- The infinite algebraic counterexample, for any chosen closure of ℚ. -/
def AlgebraicClosureCounterexample : Prop :=
  ∀ (Ω : Type u) [Field Ω] [Algebra ℚ Ω]
    [Algebra.IsAlgebraic ℚ Ω] [IsAlgClosed Ω],
    Algebra.IsAlgebraic ℚ Ω ∧
    (¬ ∃ n : ℕ, Module.rank ℚ Ω = (n : Cardinal.{u})) ∧
    Cardinal.aleph0 ≤ Module.rank ℚ Ω ∧
    (∀ m : ℕ, 1 ≤ m → ∃ a : Ω, a ^ m = (2 : Ω) ∧
      minpoly ℚ a = Polynomial.X ^ m - Polynomial.C (2 : ℚ) ∧
      Module.rank ℚ (IntermediateField.adjoin ℚ {a}) = (m : Cardinal.{u})) ∧
    ∀ a : Ω, IntermediateField.adjoin ℚ {a} ≠ ⊤

end Specs.D07.Ch12.PrimitiveElement
