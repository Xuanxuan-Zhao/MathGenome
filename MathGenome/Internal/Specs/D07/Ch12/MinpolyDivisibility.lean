import MathGenome.Internal.Specs.D07.Ch12.MinpolyExistence
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Span

/-!
Independent specification for K07.12.minpoly_divisibility
(paper.tex:3591–3597; chapters/M07.12.tex:50–56).

The extension is given by `Algebra K L`; `Polynomial.aeval α` evaluates
using precisely its structure map. We use the same canonical `minpoly K α`
as the upstream existence specification. Only the element α is assumed
algebraic: the extension need not be algebraic, finite, or embedded in an
algebraically closed field. The polynomial f is arbitrary, including zero.
The kernel below is an equality of ideals in the formal polynomial ring.
-/

universe u v

namespace Specs.D07.Ch12.MinpolyDivisibility

/-- A polynomial vanishes at an algebraic element exactly when the minimal
polynomial divides it. -/
def EvaluationZeroIffDivisible : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] (α : L),
    IsAlgebraic K α → ∀ f : Polynomial K,
      Polynomial.aeval α f = 0 ↔ minpoly K α ∣ f

/-- The evaluation kernel is the principal ideal generated by the minimal
polynomial of the algebraic element. -/
def EvaluationKernel : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] (α : L),
    IsAlgebraic K α →
      RingHom.ker (Polynomial.aeval α : Polynomial K →ₐ[K] L) =
        Ideal.span ({minpoly K α} : Set (Polynomial K))

end Specs.D07.Ch12.MinpolyDivisibility
