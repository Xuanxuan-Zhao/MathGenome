import MathGenome.Internal.Specs.D07.Ch12.SeparableDefinition
import MathGenome.Internal.Specs.D07.Ch12.AdjoinDefinition
import Mathlib.Algebra.Algebra.Tower

/-!
Independent specification for K07.12.separable_towers
(paper.tex:3790–3800; chapters/M07.12.tex:249–259).

All fields carry their specified embeddings, compatible via `IsScalarTower`.
The tower is algebraic, with no finite-degree assumption. The predicates
are the canonical separability predicates fixed by the upstream Specs.
For generation, the ambient field need not itself be algebraic: only the
generators are assumed algebraic and separable. The generating set may be
empty or infinite. `generatedFieldValue` is the field adjoin from the
upstream generated-field specification, so inverses are included.
-/

universe u v w

namespace Specs.D07.Ch12.SeparableTowers

/-- Separability of the total algebraic extension gives both separable steps. -/
def SeparabilityDescends : Prop :=
  ∀ (K : Type u) (E : Type v) (L : Type w)
    [Field K] [Field E] [Field L]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L],
    Algebra.IsAlgebraic K E → Algebra.IsAlgebraic E L →
    SeparableDefinition.extensionSeparableValue K L →
      SeparableDefinition.extensionSeparableValue K E ∧
      SeparableDefinition.extensionSeparableValue E L

/-- Both separable steps imply separability of the total extension,
including towers of infinite algebraic degree. -/
def SeparabilityTransitive : Prop :=
  ∀ (K : Type u) (E : Type v) (L : Type w)
    [Field K] [Field E] [Field L]
    [Algebra K E] [Algebra E L] [Algebra K L] [IsScalarTower K E L],
    Algebra.IsAlgebraic K E → Algebra.IsAlgebraic E L →
    SeparableDefinition.extensionSeparableValue K E →
    SeparableDefinition.extensionSeparableValue E L →
      SeparableDefinition.extensionSeparableValue K L

/-- The field generated by any set of separable algebraic elements is separable. -/
def GeneratedFieldSeparable : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] (S : Set L),
    (∀ a ∈ S, IsAlgebraic K a ∧ SeparableDefinition.elementSeparableValue K L a) →
      SeparableDefinition.extensionSeparableValue K
        (AdjoinDefinition.generatedFieldValue K L S)

/-- The corresponding whole-extension statement when S generates L over K. -/
def ExtensionSeparableOfGenerators : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] (S : Set L),
    AdjoinDefinition.generatedFieldValue K L S = ⊤ →
    (∀ a ∈ S, IsAlgebraic K a ∧ SeparableDefinition.elementSeparableValue K L a) →
      SeparableDefinition.extensionSeparableValue K L

end Specs.D07.Ch12.SeparableTowers
