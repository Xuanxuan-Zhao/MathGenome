import Mathlib.FieldTheory.Galois.Basic
import Mathlib.Analysis.Real.Sqrt
import Mathlib.Data.ZMod.Basic

/-! Independent specification of K07.14.biquadratic_example, paper.tex:4256–4263.
The field is the actual subfield of ℝ generated by the positive square roots.
The three subfields are formed inside this field. The product generator of
`E6` is identified with √6 by a separate asserted equality. -/
namespace Specs.D07.Ch14.BiquadraticExample

open IntermediateField

noncomputable abbrev L : IntermediateField ℚ ℝ :=
  adjoin ℚ ({Real.sqrt 2, Real.sqrt 3} : Set ℝ)

noncomputable def u : L :=
  ⟨Real.sqrt 2, subset_adjoin ℚ _ (Set.mem_insert _ _)⟩

noncomputable def v : L :=
  ⟨Real.sqrt 3, subset_adjoin ℚ _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩

noncomputable abbrev E2 : IntermediateField ℚ L := adjoin ℚ {u}
noncomputable abbrev E3 : IntermediateField ℚ L := adjoin ℚ {v}
noncomputable abbrev E6 : IntermediateField ℚ L := adjoin ℚ {u * v}

/-- The ordinary finite extension degree and Galois property. -/
def DegreeAndGalois : Prop :=
  FiniteDimensional ℚ L ∧ Module.finrank ℚ L = 4 ∧ IsGalois ℚ L

/-- The cyclic factors use additive ZMod 2, written multiplicatively. -/
def GaloisGroup : Prop :=
  Nonempty ((L ≃ₐ[ℚ] L) ≃* (Multiplicative (ZMod 2) × Multiplicative (ZMod 2)))

/-- The displayed product is the positive real square root of six. -/
def ProductRoot : Prop := ((u * v : L) : ℝ) = Real.sqrt 6

/-- Under inclusion into ℝ the internal fields are exactly the three fields
named in the source. -/
def EmbeddedFields : Prop :=
  E2.map L.val = adjoin ℚ ({Real.sqrt 2} : Set ℝ) ∧
  E3.map L.val = adjoin ℚ ({Real.sqrt 3} : Set ℝ) ∧
  E6.map L.val = adjoin ℚ ({Real.sqrt 6} : Set ℝ)

/-- Each of the three named fields is quadratic, they are distinct, and the
proper nontrivial intermediate fields are precisely these three. -/
def IntermediateFields : Prop :=
  Module.finrank ℚ E2 = 2 ∧ Module.finrank ℚ E3 = 2 ∧ Module.finrank ℚ E6 = 2 ∧
  E2 ≠ E3 ∧ E2 ≠ E6 ∧ E3 ≠ E6 ∧
  E2 ≠ ⊥ ∧ E2 ≠ ⊤ ∧ E3 ≠ ⊥ ∧ E3 ≠ ⊤ ∧ E6 ≠ ⊥ ∧ E6 ≠ ⊤ ∧
  ∀ E : IntermediateField ℚ L,
    (E ≠ ⊥ ∧ E ≠ ⊤) ↔ (E = E2 ∨ E = E3 ∨ E = E6)

end Specs.D07.Ch14.BiquadraticExample
