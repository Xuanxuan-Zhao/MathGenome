import MathGenome.Internal.Specs.D07.Ch14.FundamentalCorrespondence
import MathGenome.Internal.Specs.D07.Ch01.GeneratedWords

/-!
Independent specification of K07.14.lattice_operations
(paper.tex:4211–4220; chapters/M07.14.tex:129–138).

The specified embedding is `Algebra K L`, and finite degree and Galois
are separate assumptions. Both intermediate fields lie in this same L;
neither is required to be normal over K. The compositum is the upstream
field adjoin of the union, and the generated subgroup is the closure of
the union, allowing all finite products and inverses. Infima are actual
intersections. All subgroups, including the trivial and full ones, occur.
-/

universe u v

namespace Specs.D07.Ch14.LatticeOperations

open Specs.D07.Ch12

/-- Automorphisms fixing the compositum fix exactly both fields. -/
def FixingSubgroupCompositum : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (E₁ E₂ : IntermediateField K L),
    FixedField.fixingSubgroupValue K L (AdjoinDefinition.compositumValue K L E₁ E₂) =
      FixedField.fixingSubgroupValue K L E₁ ⊓ FixedField.fixingSubgroupValue K L E₂

/-- The fixing subgroup of the field intersection is generated by the two
pointwise fixing subgroups, rather than their set union. -/
def FixingSubgroupIntersection : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (E₁ E₂ : IntermediateField K L),
    FixedField.fixingSubgroupValue K L (E₁ ⊓ E₂) =
      Subgroup.closure ((FixedField.fixingSubgroupValue K L E₁ : Set (L ≃ₐ[K] L)) ∪
        (FixedField.fixingSubgroupValue K L E₂ : Set (L ≃ₐ[K] L)))

/-- Fixation by the generated subgroup is fixation by both subgroups. -/
def FixedFieldGenerated : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (H₁ H₂ : Subgroup (L ≃ₐ[K] L)),
    FixedField.fixedFieldValue K L
        (Subgroup.closure ((H₁ : Set (L ≃ₐ[K] L)) ∪ (H₂ : Set (L ≃ₐ[K] L)))) =
      FixedField.fixedFieldValue K L H₁ ⊓ FixedField.fixedFieldValue K L H₂

/-- The fixed field of the subgroup intersection is the compositum of their
fixed fields, rather than their set union. -/
def FixedFieldIntersection : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (H₁ H₂ : Subgroup (L ≃ₐ[K] L)),
    FixedField.fixedFieldValue K L (H₁ ⊓ H₂) =
      AdjoinDefinition.compositumValue K L
        (FixedField.fixedFieldValue K L H₁) (FixedField.fixedFieldValue K L H₂)

end Specs.D07.Ch14.LatticeOperations
