import MathGenome.Internal.Specs.D07.Ch22.LocalizationIdealsExtensionSaturation
import Mathlib.RingTheory.Ideal.Prime
import Mathlib.Order.Hom.Basic

/-!
Independent specifications for K07.22.localization_ideals,
paper.tex:7126–7167, with the chapter conventions at 6699–6703.

The ring and fractions are the canonical localization used by the upstream
construction. Extension is `Ideal.map` (the ideal generated by the image),
and contraction is the literal inverse image `Ideal.comap`. Prime ideals
are proper. Disjointness is set disjointness between the denominator
submonoid and the ideal. Neither a domain nor Noetherianity, nontriviality,
or exclusion of zero from the denominators is assumed.
-/

universe u

namespace Specs.D07.Ch22.LocalizationIdeals

/-- Retain the full extension, saturation, and ideal-recovery assertions
proved by the separately allocated prerequisite. -/
def IdealFormulas : Prop :=
  LocalizationIdealsExtensionSaturation.ExtendedIdealFractions.{u} ∧
  LocalizationIdealsExtensionSaturation.ContractionSaturation.{u} ∧
  LocalizationIdealsExtensionSaturation.EveryIdealExtended.{u} ∧
  LocalizationIdealsExtensionSaturation.ExtensionTopIffMeets.{u}

/-- The extension of a prime ideal missing the denominators is prime. -/
def PrimeExtension : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (P : Ideal R),
    P.IsPrime → Disjoint (S : Set R) (P : Set R) →
      (Ideal.map (algebraMap R (Localization S)) P).IsPrime

/-- Contraction of a localized prime is prime and misses every denominator. -/
def PrimeContraction : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R)
      (Q : Ideal (Localization S)),
    Q.IsPrime →
      (Ideal.comap (algebraMap R (Localization S)) Q).IsPrime ∧
      Disjoint (S : Set R)
        (Ideal.comap (algebraMap R (Localization S)) Q : Set R)

/-- Saturation of a prime disjoint from S equals that same prime. -/
def ContractionExtension : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (P : Ideal R),
    P.IsPrime → Disjoint (S : Set R) (P : Set R) →
      Ideal.comap (algebraMap R (Localization S))
        (Ideal.map (algebraMap R (Localization S)) P) = P

/-- An order isomorphism is an inclusion-preserving bijection with an
inclusion-preserving inverse. Both directions are fixed to the source's
extension and contraction, rather than to unspecified bijections. -/
def PrimeCorrespondence : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R),
    ∃ e : {P : Ideal R // P.IsPrime ∧ Disjoint (S : Set R) (P : Set R)} ≃o
        {Q : Ideal (Localization S) // Q.IsPrime},
      (∀ P, (e P).val = Ideal.map (algebraMap R (Localization S)) P.val) ∧
      (∀ Q, (e.symm Q).val = Ideal.comap (algebraMap R (Localization S)) Q.val)

/-- If zero is a denominator, each of the two prime sets is empty,
and the localization is the zero ring. This also covers a zero base ring. -/
def ZeroDenominatorPrimes : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R), (0 : R) ∈ S →
    IsEmpty {P : Ideal R // P.IsPrime ∧ Disjoint (S : Set R) (P : Set R)} ∧
    IsEmpty {Q : Ideal (Localization S) // Q.IsPrime} ∧
    Subsingleton (Localization S)

end Specs.D07.Ch22.LocalizationIdeals
