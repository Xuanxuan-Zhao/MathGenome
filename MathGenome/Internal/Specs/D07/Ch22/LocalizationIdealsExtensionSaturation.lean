import MathGenome.Internal.Specs.D07.Ch22.LocalizationConstruction
import Mathlib.RingTheory.Ideal.Maps

/-!
Independent specifications for the extension/saturation part of
K07.22.localization_ideals, paper.tex:7126–7156.

The canonical ring and fractions are those of `LocalizationConstruction`.
`Ideal.map f I` is the ideal generated by the image of `I` under `f`,
so it is exactly extension; `Ideal.comap f` is contraction (preimage).
Over a commutative ring these are two-sided ideals. `Submonoid R`
requires one and multiplicative closure but does not exclude zero.
All statements allow the zero ring, zero divisors and zero denominators.
-/

universe u

namespace Specs.D07.Ch22.LocalizationIdealsExtensionSaturation

/-- The extended ideal consists precisely of fractions with a numerator in I.
This is an existential representation, not a condition on every numerator
of a given fraction. -/
def ExtendedIdealFractions : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (I : Ideal R)
      (z : Localization S),
    z ∈ Ideal.map (algebraMap R (Localization S)) I ↔
      ∃ a : R, a ∈ I ∧ ∃ s : S, z = Localization.mk a s

/-- Contraction of extension is the saturation, with an existential
denominator multiplier; no injectivity or cancellation is assumed. -/
def ContractionSaturation : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (I : Ideal R) (r : R),
    r ∈ Ideal.comap (algebraMap R (Localization S))
        (Ideal.map (algebraMap R (Localization S)) I) ↔
      ∃ s : S, (s : R) * r ∈ I

/-- Every ideal in the localization is the extension of its contraction. -/
def EveryIdealExtended : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (J : Ideal (Localization S)),
    Ideal.map (algebraMap R (Localization S))
      (Ideal.comap (algebraMap R (Localization S)) J) = J

/-- Extension is the whole ring exactly when I intersects S. -/
def ExtensionTopIffMeets : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Submonoid R) (I : Ideal R),
    Ideal.map (algebraMap R (Localization S)) I = ⊤ ↔
      ((I : Set R) ∩ (S : Set R)).Nonempty

end Specs.D07.Ch22.LocalizationIdealsExtensionSaturation
