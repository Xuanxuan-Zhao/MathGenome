import MathGenome.Internal.Specs.D07.Ch22.IntegralClosureTransitivityFiniteIntegralGeneration
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.Polynomial.Eisenstein.Basic

/-!
Independent statements for K07.22.integral_closure_transitivity,
paper.tex:7230–7267. Rings and algebras are commutative and unital; the
zero ring and the empty generating tuple are allowed. Scalar towers
record compatibility of the structure maps. Transitivity is stated for
all such maps, in particular for the injective inclusions in the source.
The example uses algebraic closures of Q, not an arbitrary integral
extension or a default natural dimension of an infinite vector space.
-/

universe u v w
namespace Specs.D07.Ch22.IntegralClosureTransitivity
open Polynomial

/-- Exactly the integral elements form a subalgebra. -/
def IntegralElementsSubalgebra : Prop :=
  IntegralClosureTransitivityFiniteIntegralGeneration.IntegralElementsSubalgebra.{u, v}

/-- Module finiteness of the algebra generated by a finite integral tuple. -/
def FiniteIntegralGeneration : Prop :=
  ∀ (R : Type u) (B : Type v) [CommRing R] [CommRing B] [Algebra R B]
    (t : ℕ) (x : Fin t → B), (∀ i, IsIntegral R (x i)) →
      Module.Finite R (Algebra.adjoin R (Set.range x))

/-- All elements of any module-finite algebra are integral. -/
def FiniteAlgebraIntegral : Prop :=
  IntegralClosureTransitivityFiniteIntegralGeneration.FiniteAlgebraIntegral.{u, v}

/-- Elementwise transitivity; the upper algebra need not be module-finite. -/
def IntegralTransitivity : Prop :=
  ∀ (R : Type u) (B : Type v) (C : Type w)
    [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra B C] [Algebra R C] [IsScalarTower R B C],
    (∀ b : B, IsIntegral R b) → ∀ z : C, IsIntegral B z → IsIntegral R z

/-- Transitivity of integral algebras in a compatible tower. -/
def IntegralAlgebraTransitivity : Prop :=
  ∀ (R : Type u) (B : Type v) (C : Type w)
    [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra B C] [Algebra R C] [IsScalarTower R B C],
    Algebra.IsIntegral R B → Algebra.IsIntegral B C → Algebra.IsIntegral R C

/-- The equivalence for any specified finite algebra generating tuple. -/
def FiniteGeneratedIffIntegralGenerators : Prop :=
  ∀ (R : Type u) (B : Type v) [CommRing R] [CommRing B] [Algebra R B]
    (t : ℕ) (x : Fin t → B), Algebra.adjoin R (Set.range x) = ⊤ →
      (Module.Finite R B ↔ ∀ i, IsIntegral R (x i))

/-- Finite module generation is precisely integrality plus finite algebra generation. -/
def FiniteIffIntegralAndFiniteType : Prop :=
  ∀ (R : Type u) (B : Type v) [CommRing R] [CommRing B] [Algebra R B],
    Module.Finite R B ↔ Algebra.IsIntegral R B ∧ Algebra.FiniteType R B

/-- The polynomials used in the example are monic Eisenstein polynomials
at the integer prime ideal (2), of every positive degree. -/
def RationalPowerTwoEisenstein : Prop :=
  ∀ n : ℕ, 0 < n →
    (X ^ n - C (2 : ℤ)).Monic ∧ (X ^ n - C (2 : ℤ)).natDegree = n ∧
    (X ^ n - C (2 : ℤ)).IsEisensteinAt (Ideal.span {(2 : ℤ)}) ∧
    Irreducible (X ^ n - C (2 : ℤ))

/-- Eisenstein polynomials yield finite subfields of every positive degree
inside any algebraically closed extension of Q. Both the element's degree
and the actual intermediate field degree are specified. -/
def RationalClosureRootDegrees : Prop :=
  ∀ (Ω : Type v) [Field Ω] [Algebra ℚ Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n →
      Irreducible (X ^ n - C (2 : ℚ)) ∧
      ∃ x : Ω, x ^ n = 2 ∧ IsIntegral ℚ x ∧
        minpoly ℚ x = X ^ n - C (2 : ℚ) ∧
        (minpoly ℚ x).natDegree = n ∧
        Module.Finite ℚ (IntermediateField.adjoin ℚ ({x} : Set Ω)) ∧
        Module.finrank ℚ (IntermediateField.adjoin ℚ ({x} : Set Ω)) = n

/-- An arbitrary algebraic closure of Q is integral but neither module-finite
nor finitely generated as a Q-algebra. -/
def RationalClosureNotFinite : Prop :=
  ∀ (Ω : Type v) [Field Ω] [Algebra ℚ Ω]
    [Algebra.IsAlgebraic ℚ Ω] [IsAlgClosed Ω],
    Algebra.IsIntegral ℚ Ω ∧ ¬ Module.Finite ℚ Ω ∧ ¬ Algebra.FiniteType ℚ Ω

/-- A concrete example exists without making an algebraic closure a premise. -/
def IntegralNotFiniteExample : Prop :=
  ∃ (B : Type) (_ : Field B) (_ : Algebra ℚ B),
    Algebra.IsIntegral ℚ B ∧ IsAlgClosed B ∧ ¬ Module.Finite ℚ B ∧
      ¬ Algebra.FiniteType ℚ B

end Specs.D07.Ch22.IntegralClosureTransitivity
