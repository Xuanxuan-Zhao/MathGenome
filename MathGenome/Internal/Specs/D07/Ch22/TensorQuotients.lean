import MathGenome.Internal.Specs.D07.Ch22.TensorFunctor
import MathGenome.Internal.Specs.D07.Foundations.IntegerArithmetic
import Mathlib.LinearAlgebra.TensorProduct.Quotient
import Mathlib.RingTheory.Ideal.Operations

/-! Independent statements for paper.tex:6820–6853. Rings may be zero,
modules are arbitrary, and the two tensor maps below are used only through
their images. Integer moduli are integers, including negative integers and zero. -/

noncomputable section
universe u v w
namespace Specs.D07.Ch22.TensorQuotients
open scoped TensorProduct

-- Use the quotient and tensor module actions also when the scalar ring is ℤ.
attribute [-instance] AddCommGroup.toIntModule

section General
variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]
variable {N : Type w} [AddCommGroup N] [Module R N]

/-- The source's submodule generated by the two families of elementary tensors. -/
def relations (U : Submodule R M) (V : Submodule R N) : Submodule R (M ⊗[R] N) :=
  Submodule.span R {t | (∃ m ∈ U, ∃ n : N, m ⊗ₜ[R] n = t) ∨
    (∃ m : M, ∃ n ∈ V, m ⊗ₜ[R] n = t)}

/-- Finite linear combinations of ideal multiples. -/
def idealAction (I : Ideal R) (N : Type w) [AddCommGroup N] [Module R N] :
    Submodule R N :=
  Submodule.span R {x | ∃ a ∈ I, ∃ n : N, a • n = x}
end General

def RelationsImages : Prop :=
  ∀ (R : Type u) [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M]
    (N : Type w) [AddCommGroup N] [Module R N]
    (U : Submodule R M) (V : Submodule R N),
    relations U V =
      LinearMap.range (TensorProduct.map U.subtype (LinearMap.id : N →ₗ[R] N)) ⊔
      LinearMap.range (TensorProduct.map (LinearMap.id : M →ₗ[R] M) V.subtype)

def QuotientIsomorphism : Prop :=
  ∀ (R : Type u) [CommRing R]
    (M : Type v) [AddCommGroup M] [Module R M]
    (N : Type w) [AddCommGroup N] [Module R N]
    (U : Submodule R M) (V : Submodule R N),
    ∃ e : ((M ⧸ U) ⊗[R] (N ⧸ V)) ≃ₗ[R] ((M ⊗[R] N) ⧸ relations U V),
      (∀ m n, e (U.mkQ m ⊗ₜ[R] V.mkQ n) = (relations U V).mkQ (m ⊗ₜ[R] n)) ∧
      (∀ m n, e.symm ((relations U V).mkQ (m ⊗ₜ[R] n)) = U.mkQ m ⊗ₜ[R] V.mkQ n)

def IdealActionEquality : Prop :=
  ∀ (R : Type u) [CommRing R]
    (N : Type w) [AddCommGroup N] [Module R N] (I : Ideal R),
    idealAction I N = I • (⊤ : Submodule R N)

/-- Finitely supported coefficient sums specify precisely the finite sums in IN. -/
def IdealActionFiniteSums : Prop :=
  ∀ (R : Type u) [CommRing R]
    (N : Type w) [AddCommGroup N] [Module R N] (I : Ideal R) (x : N),
    x ∈ idealAction I N ↔
      ∃ a : N →₀ R, (∀ n, a n ∈ I) ∧ (a.sum fun n c => c • n) = x

def IdealTensorImage : Prop :=
  ∀ (R : Type u) [CommRing R]
    (N : Type w) [AddCommGroup N] [Module R N] (I : Ideal R),
    Submodule.map (TensorProduct.lid R N).toLinearMap
      (LinearMap.range (TensorProduct.map I.subtype (LinearMap.id : N →ₗ[R] N))) =
        idealAction I N

def IdealQuotientIsomorphism : Prop :=
  ∀ (R : Type u) [CommRing R]
    (N : Type w) [AddCommGroup N] [Module R N] (I : Ideal R),
    ∃ e : ((R ⧸ I) ⊗[R] N) ≃ₗ[R] (N ⧸ idealAction I N),
      (∀ r n, e (Ideal.Quotient.mk I r ⊗ₜ[R] n) = (idealAction I N).mkQ (r • n)) ∧
      (∀ n, e.symm ((idealAction I N).mkQ n) = Ideal.Quotient.mk I 1 ⊗ₜ[R] n)

/-- Integer ideal quotients, with no finiteness convention at modulus zero. -/
abbrev cyclic (m : ℤ) := ℤ ⧸ Ideal.span ({m} : Set ℤ)

def CyclicPairIsomorphism : Prop :=
  ∀ m n : ℤ,
    ∃ e : (cyclic m ⊗[ℤ] cyclic n) ≃ₗ[ℤ] (ℤ ⧸ Ideal.span ({m, n} : Set ℤ)),
      ∀ a b : ℤ, e (Ideal.Quotient.mk _ a ⊗ₜ[ℤ] Ideal.Quotient.mk _ b) =
        Ideal.Quotient.mk _ (a * b)

def GcdIdealEquality : Prop :=
  ∀ m n : ℤ, Ideal.span ({m, n} : Set ℤ) = Ideal.span ({(Int.gcd m n : ℤ)} : Set ℤ)

def CyclicGcdIsomorphism : Prop :=
  ∀ m n : ℤ,
    ∃ e : (cyclic m ⊗[ℤ] cyclic n) ≃ₗ[ℤ] cyclic (Int.gcd m n : ℤ),
      ∀ a b : ℤ, e (Ideal.Quotient.mk _ a ⊗ₜ[ℤ] Ideal.Quotient.mk _ b) =
        Ideal.Quotient.mk _ (a * b)

def CyclicBoundaries : Prop :=
  (∃ e : cyclic 0 ≃ₗ[ℤ] ℤ, ∀ a : ℤ, e (Ideal.Quotient.mk _ a) = a) ∧
  (∀ m : ℤ, IsUnit m → Subsingleton (cyclic m)) ∧
  (∃ e : (cyclic 0 ⊗[ℤ] cyclic 0) ≃ₗ[ℤ] ℤ,
    ∀ a b : ℤ, e (Ideal.Quotient.mk _ a ⊗ₜ[ℤ] Ideal.Quotient.mk _ b) = a * b) ∧
  (∀ m n : ℤ, IsUnit m ∨ IsUnit n → Subsingleton (cyclic m ⊗[ℤ] cyclic n)) ∧
  (Int.gcd 0 0 : ℤ) = 0

end Specs.D07.Ch22.TensorQuotients
