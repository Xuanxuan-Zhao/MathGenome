import MathGenome.Internal.Specs.D07.Ch13.Existence
import Mathlib.Data.Nat.GCD.Basic

/-! Independent statements for K07.13.intersection_compositum,
paper.tex:3939–3951. The finite base K has q elements and Ω is one fixed
algebraic closure over that base. We reuse the specified root fields, rather
than identifying abstract finite-field copies. Infimum is intersection;
the compositum is the field generated by the union in this same Ω. -/

universe u v

namespace Specs.D07.Ch13.IntersectionCompositum

open Existence

def InclusionIffDivides : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    [Finite K] [Algebra.IsAlgebraic K Ω] [IsAlgClosed Ω]
    (q a b : ℕ), Nat.card K = q → 1 ≤ a → 1 ≤ b →
      (rootFieldValue K Ω q a ≤ rootFieldValue K Ω q b ↔ a ∣ b)

def IntersectionEquality : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    [Finite K] [Algebra.IsAlgebraic K Ω] [IsAlgClosed Ω]
    (q a b : ℕ), Nat.card K = q → 1 ≤ a → 1 ≤ b →
      rootFieldValue K Ω q a ⊓ rootFieldValue K Ω q b =
        rootFieldValue K Ω q (Nat.gcd a b)

def CompositumEquality : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    [Finite K] [Algebra.IsAlgebraic K Ω] [IsAlgClosed Ω]
    (q a b : ℕ), Nat.card K = q → 1 ≤ a → 1 ≤ b →
      IntermediateField.adjoin K
        ((rootFieldValue K Ω q a : Set Ω) ∪ (rootFieldValue K Ω q b : Set Ω)) =
        rootFieldValue K Ω q (Nat.lcm a b)

end Specs.D07.Ch13.IntersectionCompositum
