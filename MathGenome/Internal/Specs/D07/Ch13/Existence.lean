import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.FieldTheory.SplittingField.IsSplittingField
import Mathlib.FieldTheory.IsAlgClosed.Basic
import Mathlib.FieldTheory.Finiteness

/-!
Independent statements for K07.13.existence, paper.tex:3899–3905.
The specified embedded field is the field generated by the actual roots in Ω.
Membership will assert that taking this generated field adds no new elements.
All scalar maps are the prescribed ones; no unrelated finite-field copy is
identified with a subfield of Ω. Finite-dimensionality accompanies finrank,
and finiteness accompanies natural cardinality.
-/

universe u v

namespace Specs.D07.Ch13.Existence

open Polynomial

def RootFieldType : Type (max u v + 1) :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω],
    ℕ → ℕ → IntermediateField K Ω

noncomputable def rootFieldValue : RootFieldType.{u, v} :=
  fun K Ω _ _ _ q n => IntermediateField.adjoin K {x : Ω | x ^ (q ^ n) = x}

/-- Closure under all field operations, including the base scalars, is expressed
by the exact membership equivalence for this intermediate field. -/
def RootFieldMembership : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    [Finite K] (q n : ℕ), Nat.card K = q →
    ∀ x : Ω, x ∈ rootFieldValue K Ω q n ↔ x ^ (q ^ n) = x

/-- In any fixed algebraic closure, the particular embedded root field has the
claimed size, degree, and splitting-field property. The polynomial's nonzero
condition and its simple roots are conclusions, not assumed certificates. -/
def EmbeddedExistence : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    [Finite K] [Algebra.IsAlgebraic K Ω] [IsAlgClosed Ω]
    (q n : ℕ), Nat.card K = q → 1 ≤ n →
    let E := rootFieldValue K Ω q n
    Finite E ∧ Nat.card E = q ^ n ∧
      FiniteDimensional K E ∧ Module.finrank K E = n ∧
      (X ^ (q ^ n) - X : Polynomial K) ≠ 0 ∧
      (X ^ (q ^ n) - X : Polynomial K).Separable ∧
      Polynomial.IsSplittingField K E (X ^ (q ^ n) - X)

/-- The prime-field case includes all positive n, without assuming an existing
field of this size. -/
def PrimePowerExistence : Prop :=
  ∀ (p n : ℕ), p.Prime → 1 ≤ n →
    ∃ (F : Type) (_ : Field F), Finite F ∧ Nat.card F = p ^ n

end Specs.D07.Ch13.Existence
