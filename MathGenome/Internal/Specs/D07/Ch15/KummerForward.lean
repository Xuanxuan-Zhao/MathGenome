import MathGenome.Internal.Specs.D07.Ch15.RootsUnity

/-!
Independent specification for K07.15.kummer_forward (paper.tex:4390–4403).
The algebra structure fixes the embedding in the chosen algebraically closed
root overfield. The hypothesis on roots quantifies over every n-th root of
unity there; it does not assume the binomial irreducible. The extension is
the actual intermediate field generated by the given root, including degree
one steps. Finite degree is a conclusion, separate from the Galois property.
-/

namespace Specs.D07.Ch15.KummerForward

universe u v

/-- A nonzero radical step in the presence of all n-th roots of unity. -/
def RadicalStepCyclicGalois : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
    (∀ ζ : Ω, ζ ^ n = 1 → ∃ c : K, algebraMap K Ω c = ζ) →
    ∀ (a : Kˣ) (u : Ω), u ^ n = algebraMap K Ω (a : K) →
      let E := IntermediateField.adjoin K {u}
      FiniteDimensional K E ∧ IsGalois K E ∧ IsCyclic (E ≃ₐ[K] E) ∧
        Module.finrank K E ∣ n

end Specs.D07.Ch15.KummerForward
