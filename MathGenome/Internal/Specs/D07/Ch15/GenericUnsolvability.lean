import MathGenome.Internal.Specs.D07.Ch15.GenericUnsolvabilitySymmetricRationalFixedField
import MathGenome.Internal.Specs.D07.Ch15.RadicalDefinition
import Mathlib.FieldTheory.PolynomialGaloisGroup
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-! The general polynomial, paper.tex:4450–4465.
The coefficient field is the field generated by the prescribed independent
coefficient tuple in its given overfield. The polynomial is the alternating
monic expression `tuplePolynomial`, not a polynomial with independent roots.
The index n includes zero. Polynomial.Gal is the automorphism group of the
splitting field. The radical conclusion uses membership in actual finite radical towers
for the roots in the specified algebraic closure. -/

universe u v w
namespace Specs.D07.Ch15.GenericUnsolvability
open GenericUnsolvabilitySymmetricRationalFixedField RadicalDefinition

/-- With no coefficients the generated field is K and the splitting field is
that same field, represented by its embedded image. -/
def EmptyTupleCase : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M]
    (s : Fin 0 → M),
    IntermediateField.adjoin K (Set.range s) = ⊥ ∧
    tuplePolynomial K 0 M s = 1 ∧
    Polynomial.IsSplittingField (IntermediateField.adjoin K (Set.range s))
      (IntermediateField.adjoin K (Set.range s)) (tuplePolynomial K 0 M s)

/-- All independent coefficient tuples, including the empty tuple. -/
def GenericGaloisGroup : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M] [CharZero K]
    (n : ℕ) (s : Fin n → M), AlgebraicIndependent K s →
    Nonempty ((tuplePolynomial K n M s).Gal ≃* Equiv.Perm (Fin n))

/-- Some root is not radical: the source definition of polynomial insolubility. -/
def GenericNotSolvableByRadicals : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M] [CharZero K]
    (n : ℕ) (s : Fin n → M), AlgebraicIndependent K s → 5 ≤ n →
    ∀ (Ω : Type w) [Field Ω]
      [Algebra (IntermediateField.adjoin K (Set.range s)) Ω]
      [Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range s)) Ω]
      [IsAlgClosed Ω],
      ¬ (∀ a : Ω, Polynomial.aeval a (tuplePolynomial K n M s) = 0 →
        solvableByRadicalsValue (IntermediateField.adjoin K (Set.range s)) Ω a)

end Specs.D07.Ch15.GenericUnsolvability
