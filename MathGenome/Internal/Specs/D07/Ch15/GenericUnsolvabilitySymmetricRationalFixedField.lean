import Mathlib.FieldTheory.Galois.Basic
import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
import Mathlib.RingTheory.MvPolynomial.Symmetric.Defs
import Mathlib.Data.Fintype.Perm

/-! Characteristic-free symmetric rational function field model, paper.tex:4450–4465
and 6136–6147. The roots are formal independent indeterminates; both transport
statements use the specified K-embeddings into arbitrary overfields. -/

universe u v
noncomputable section
namespace Specs.D07.Ch15.GenericUnsolvabilitySymmetricRationalFixedField

abbrev Rational (K : Type u) [Field K] (n : ℕ) :=
  FractionRing (MvPolynomial (Fin n) K)

variable (K : Type u) [Field K] (n : ℕ)

def root (i : Fin n) : Rational K n := algebraMap (MvPolynomial (Fin n) K) (Rational K n) (MvPolynomial.X i)

def elementaryNat (j : ℕ) : Rational K n :=
  algebraMap _ _ (MvPolynomial.esymm (Fin n) K j)

def elementary (i : Fin n) : Rational K n := elementaryNat K n (i.val + 1)

def coefficients : IntermediateField K (Rational K n) :=
  IntermediateField.adjoin K (Set.range (elementary K n))

def variablePerm (π : Equiv.Perm (Fin n)) : Rational K n ≃ₐ[K] Rational K n :=
  IsFractionRing.algEquivOfAlgEquiv (MvPolynomial.renameEquiv K π)

def fixedField : IntermediateField K (Rational K n) where
  carrier := {z | ∀ π, variablePerm K n π z = z}
  zero_mem' := fun _ => map_zero _
  one_mem' := fun _ => map_one _
  add_mem' := fun ha hb π => by rw [map_add, ha π, hb π]
  mul_mem' := fun ha hb π => by rw [map_mul, ha π, hb π]
  inv_mem' := fun a ha π => by rw [map_inv₀, ha π]
  algebraMap_mem' := fun a π => (variablePerm K n π).commutes a

/-- e_0=1 and e_j for 1≤j≤n, viewed in the coefficient field. -/
def coefficient (j : Fin (n + 1)) : coefficients K n :=
  ⟨elementaryNat K n j, by
    rcases j with ⟨j, hj⟩
    cases j with
    | zero => simp [elementaryNat, MvPolynomial.esymm_zero]
    | succ j =>
      exact IntermediateField.subset_adjoin K _
        ⟨⟨j, by omega⟩, rfl⟩⟩

/-- The alternating monic polynomial, over the actual generated coefficient field. -/
def genericPolynomial : Polynomial (coefficients K n) :=
  ∑ j : Fin (n + 1), (-1) ^ j.val *
    (Polynomial.C (coefficient K n j) * Polynomial.X ^ (n - j.val))

/-- Alternating monic syntax over the field generated by a coefficient tuple. -/
def tuplePolynomial (M : Type v) [Field M] [Algebra K M] (s : Fin n → M) :
    Polynomial (IntermediateField.adjoin K (Set.range s)) :=
  Polynomial.X ^ n + ∑ i : Fin n, (-1) ^ (i.val + 1) *
    (Polynomial.C ⟨s i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩ *
      Polynomial.X ^ (n - (i.val + 1)))

def Action : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ),
    variablePerm K n 1 = AlgEquiv.refl ∧
    (∀ π τ, variablePerm K n (π * τ) = variablePerm K n π * variablePerm K n τ) ∧
    (∀ π i, variablePerm K n π (root K n i) = root K n (π i)) ∧
    Function.Injective (variablePerm K n)

def RootIndependence : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), AlgebraicIndependent K (root K n)

def RootsGenerate : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ),
    IntermediateField.adjoin K (Set.range (root K n)) = ⊤

def Factorization : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ),
    (genericPolynomial K n).map (algebraMap (coefficients K n) (Rational K n)) =
      ∏ i : Fin n, (Polynomial.X - Polynomial.C (root K n i))

def SeparableSplittingField : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), 1 ≤ n →
    (genericPolynomial K n).Monic ∧ (genericPolynomial K n).natDegree = n ∧
    (genericPolynomial K n).Separable ∧
    Polynomial.IsSplittingField (coefficients K n) (Rational K n) (genericPolynomial K n)

def FixedFieldEquality : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), 1 ≤ n →
    coefficients K n = fixedField K n

def Degree : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), 1 ≤ n →
    FiniteDimensional (coefficients K n) (Rational K n) ∧
    IsGalois (coefficients K n) (Rational K n) ∧
    Module.finrank (coefficients K n) (Rational K n) = n.factorial

def AutomorphismGroup : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), 1 ≤ n →
    ∃ e : Equiv.Perm (Fin n) ≃* (Rational K n ≃ₐ[coefficients K n] Rational K n),
      ∀ π z, e π z = variablePerm K n π z

def ElementaryIndependence : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), AlgebraicIndependent K (elementary K n)

/-- The formal model represents every independent root tuple in its given ambient field. -/
def RootTransport : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M]
    (n : ℕ) (x : Fin n → M), AlgebraicIndependent K x →
    ∃ e : Rational K n ≃ₐ[K] IntermediateField.adjoin K (Set.range x),
      ∀ i, (e (root K n i) : M) = x i

/-- In particular arbitrary independent coefficients transport to e_1,...,e_n. -/
def CoefficientTransport : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M]
    (n : ℕ) (s : Fin n → M), AlgebraicIndependent K s →
    ∃ e : IntermediateField.adjoin K (Set.range s) ≃ₐ[K] coefficients K n,
      ∀ i, (e ⟨s i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩ : Rational K n) =
        elementary K n i

/-- The coefficient-field isomorphism transports the polynomial itself. -/
def CoefficientPolynomialTransport : Prop :=
  ∀ (K : Type u) (M : Type v) [Field K] [Field M] [Algebra K M]
    (n : ℕ) (s : Fin n → M), AlgebraicIndependent K s →
    ∃ e : IntermediateField.adjoin K (Set.range s) ≃ₐ[K] coefficients K n,
      (∀ i, (e ⟨s i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩ : Rational K n) =
        elementary K n i) ∧
      (tuplePolynomial K n M s).map e.toRingHom = genericPolynomial K n

end Specs.D07.Ch15.GenericUnsolvabilitySymmetricRationalFixedField
