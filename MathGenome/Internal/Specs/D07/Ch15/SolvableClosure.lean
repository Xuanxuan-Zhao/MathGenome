import Mathlib.GroupTheory.Solvable

/-!
Independent specification of `K07.15.solvable_closure`, paper.tex:4321–4328.

`Group.IsSolvable G` means `∃ n : ℕ, derivedSeries G n = ⊥`.
The canonical series starts at `⊤` and takes the subgroup generated by
commutators of the preceding term with itself. Thus it is the source's
series, with no finiteness or nontriviality assumption on the group.

Subgroups have the inherited operations. Quotient groups require the stated
normality hypothesis. The series consequence uses a finite chain from `⊥`
to `⊤`, with normality only in the next member; its factors are quotients
of those members, not quotients of the ambient group. Repeated terms and
a chain of length zero are permitted. No field hypotheses are needed for
this purely group theoretic entry.
-/

namespace Specs.D07.Ch15.SolvableClosure

universe u v

/-- The subgroup comparison used in the source proof, inside the ambient group. -/
def SubgroupDerivedLe : Prop :=
  ∀ (G : Type u) [Group G] (H : Subgroup G) (n : ℕ),
    (derivedSeries H n).map H.subtype ≤ derivedSeries G n

/-- Surjections carry every derived term onto the corresponding term. -/
def SurjectiveDerivedEq : Prop :=
  ∀ (G : Type u) (Q : Type v) [Group G] [Group Q]
    (q : G →* Q), Function.Surjective q → ∀ n : ℕ,
      (derivedSeries G n).map q = derivedSeries Q n

def SubgroupSolvable : Prop :=
  ∀ (G : Type u) [Group G] (H : Subgroup G),
    Group.IsSolvable G → Group.IsSolvable H

def QuotientSolvable : Prop :=
  ∀ (G : Type u) [Group G] (N : Subgroup G) [N.Normal],
    Group.IsSolvable G → Group.IsSolvable (G ⧸ N)

/-- The source's explicit bound on termination in an extension. -/
def ExtensionDerivedLength : Prop :=
  ∀ (G : Type u) [Group G] (N : Subgroup G) [N.Normal] (r s : ℕ),
    derivedSeries (G ⧸ N) r = ⊥ → derivedSeries N s = ⊥ →
      derivedSeries G (r + s) = ⊥

def ExtensionSolvable : Prop :=
  ∀ (G : Type u) [Group G] (N : Subgroup G) [N.Normal],
    Group.IsSolvable N → Group.IsSolvable (G ⧸ N) → Group.IsSolvable G

/-- The concluding consequence for any finite subnormal series. -/
def SubnormalSeriesSolvable : Prop :=
  ∀ (G : Type u) [Group G] (n : ℕ) (H : ℕ → Subgroup G),
    H 0 = ⊥ → H n = ⊤ →
    (∀ i < n, H i ≤ H (i + 1)) →
    ∀ (hNormal : ∀ i < n, ((H i).subgroupOf (H (i + 1))).Normal),
      (∀ (i : ℕ) (hi : i < n),
        letI := hNormal i hi
        Group.IsSolvable (H (i + 1) ⧸ (H i).subgroupOf (H (i + 1)))) →
      Group.IsSolvable G

end Specs.D07.Ch15.SolvableClosure
