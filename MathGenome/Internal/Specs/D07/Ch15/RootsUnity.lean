import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
Independent specification of K07.15.roots_unity (paper.tex:4329–4338).
`Algebra K Ω` fixes the embedding into the algebraically closed overfield.
The canonical `rootsOfUnity n Ω` is a subgroup of the units, with inherited
multiplication and inverses. `RootField` is the intermediate FIELD generated
by all solutions of x^n = 1, not the cyclotomic polynomial's abstract field.
The closure may be chosen to be `AlgebraicClosure K`; no characteristic-zero
or finite-base-field restriction is imposed. Positivity includes n = 1.
-/

namespace Specs.D07.Ch15.RootsUnity

universe u v

/-- The source's K(μ_n), in the specified overfield. -/
def RootField (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    (n : ℕ) : IntermediateField K Ω :=
  IntermediateField.adjoin K {x : Ω | x ^ n = 1}

/-- Units in the canonical group are exactly the polynomial roots. -/
def RootGroupMembership : Prop :=
  ∀ (Ω : Type v) [Field Ω] (n : ℕ) (x : Ωˣ),
    x ∈ rootsOfUnity n Ω ↔
      Polynomial.IsRoot (Polynomial.X ^ n - 1 : Polynomial Ω) (x : Ω)

/-- Every scalar root, not just an already chosen unit, occurs in the group. -/
def ScalarRootMembership : Prop :=
  ∀ (Ω : Type v) [Field Ω] (n : ℕ), 0 < n → ∀ x : Ω,
    (Polynomial.IsRoot (Polynomial.X ^ n - 1 : Polynomial Ω) x ↔
      ∃ ζ : rootsOfUnity n Ω, ((ζ : Ωˣ) : Ω) = x)

/-- Finiteness is explicit, since Nat.card alone has an infinite fallback. -/
def RootGroupStructure : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
      Finite (rootsOfUnity n Ω) ∧ IsCyclic (rootsOfUnity n Ω) ∧
        Nat.card (rootsOfUnity n Ω) = n

/-- A primitive root means exact multiplicative order n, as usual. -/
def PrimitiveRootExists : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 → ∃ ζ : Ω, IsPrimitiveRoot ζ n

/-- Complete enumeration of primitive roots by the coprime residue exponents. -/
def PrimitiveRootClassification : Prop :=
  ∀ (Ω : Type v) [Field Ω] (n : ℕ), 0 < n →
    ∀ ζ : Ω, IsPrimitiveRoot ζ n → ∀ ξ : Ω,
      (IsPrimitiveRoot ξ n ↔ ∃ a : ℕ, a < n ∧ a.Coprime n ∧ ζ ^ a = ξ)

/-- For every exponent, primitivity of the power is precisely coprimality. -/
def PrimitivePowerCriterion : Prop :=
  ∀ (Ω : Type v) [Field Ω] (n : ℕ), 0 < n →
    ∀ ζ : Ω, IsPrimitiveRoot ζ n → ∀ a : ℕ,
      (IsPrimitiveRoot (ζ ^ a) n ↔ a.Coprime n)

/-- The same criterion for all integer exponents, including zero and negatives. -/
def PrimitiveIntegerPowerCriterion : Prop :=
  ∀ (Ω : Type v) [Field Ω] (n : ℕ), 0 < n →
    ∀ ζ : Ω, IsPrimitiveRoot ζ n → ∀ a : ℤ,
      (IsPrimitiveRoot (ζ ^ a) n ↔ a.natAbs.Coprime n)

/-- The field generated by all roots is generated by any primitive one. -/
def GeneratedByPrimitiveRoot : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω]
    (n : ℕ), 0 < n → ∀ ζ : Ω, IsPrimitiveRoot ζ n →
      RootField K Ω n = IntermediateField.adjoin K {ζ}

/-- The binomial is separable under exactly the stated characteristic restriction. -/
def BinomialSeparable : Prop :=
  ∀ (K : Type u) [Field K] (n : ℕ), 0 < n → (n : K) ≠ 0 →
    (Polynomial.X ^ n - 1 : Polynomial K).Separable

/-- The generated field really is the binomial's splitting field. -/
def RootFieldSplitting : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
      Polynomial.IsSplittingField K (RootField K Ω n) (Polynomial.X ^ n - 1)

/-- Finite degree, Galois, and an abelian automorphism group are conclusions. -/
def RootFieldFiniteGaloisAbelian : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
      FiniteDimensional K (RootField K Ω n) ∧ IsGalois K (RootField K Ω n) ∧
        ∀ σ τ : (RootField K Ω n) ≃ₐ[K] (RootField K Ω n), σ * τ = τ * σ

/-- There is a primitive root in the generated field itself. -/
def RootFieldPrimitiveRoot : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
      ∃ ζ : RootField K Ω n, IsPrimitiveRoot ζ n

/-- For any chosen primitive root the embedding records its exponent.
The equality specifies the map, while the monoid-hom type gives composition
as multiplication of exponents. No surjectivity over arbitrary K is asserted. -/
def GaloisExponentEmbedding : Prop :=
  ∀ (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ), 0 < n → (n : K) ≠ 0 →
      ∀ ζ : RootField K Ω n, IsPrimitiveRoot ζ n →
        ∃ χ : ((RootField K Ω n) ≃ₐ[K] (RootField K Ω n)) →* (ZMod n)ˣ,
          Function.Injective χ ∧ ∀ σ, ζ ^ (χ σ : ZMod n).val = σ ζ

/-- The source's characteristic-p warning: there is only one distinct p-th root. -/
def PrimeCharacteristicFailure : Prop :=
  ∀ (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p],
    (Polynomial.X ^ p - 1 : Polynomial K) = (Polynomial.X - 1) ^ p ∧
      ∀ x : K, x ^ p = 1 ↔ x = 1

end Specs.D07.Ch15.RootsUnity
