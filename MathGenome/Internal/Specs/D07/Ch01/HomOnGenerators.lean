import MathGenome.Internal.Specs.D07.Ch01.GeneratedWords
import MathGenome.Internal.Specs.D07.Ch01.HomPreservesPowers

/-!
Independent specification of `K07.01.hom_on_generators`
(paper.tex:343–350; chapters/M07.01.tex:128–135).

The generated subgroup is the canonical `Subgroup.closure`, identified
with the source's intersection by the upstream specification. The maps
are arbitrary group homomorphisms with a common source and target.
The generating set may be empty or infinite, and neither group is
assumed finite, commutative, or nontrivial. Images are ordinary set images.
-/

namespace Specs.D07.Ch01.HomOnGenerators

universe u v

/-- Agreement on any set extends to its entire generated subgroup. -/
def AgreeOnGenerated : Prop :=
  ∀ (G : Type u) (H : Type v) [Group G] [Group H]
    (f g : G →* H) (S : Set G),
    (∀ s ∈ S, f s = g s) →
      ∀ x ∈ Subgroup.closure S, f x = g x

/-- The image of a generated subgroup is generated by the image set. -/
def ImageGenerated : Prop :=
  ∀ (G : Type u) (H : Type v) [Group G] [Group H]
    (f : G →* H) (S : Set G),
    f '' (Subgroup.closure S : Set G) =
      (Subgroup.closure (f '' S) : Set H)

end Specs.D07.Ch01.HomOnGenerators
