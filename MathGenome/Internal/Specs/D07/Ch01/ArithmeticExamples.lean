import MathGenome.Internal.Specs.D07.Ch01.GroupDefinition
import Mathlib.Basic.Complex.Basic
import Mathlib.Data.ZMod.Basic

/-!
Independent statements for `K07.01.arithmetic_examples` (paper.tex:351–356).
Residues are the canonical `ZMod n`. Equality of integer casts is explicitly
identified with integer congruence. `Fˣ` and `(ZMod n)ˣ` mean units of the
specified multiplication, with their canonical coercions to the underlying ring.
Positive moduli include 1; modulus 0 is treated separately without a finiteness
assumption. All field assertions are uniform in the field and its universe.
-/

namespace Specs.D07.Ch01.ArithmeticExamples

universe u

/-- The additive analogues of the source's five group laws, and commutativity. -/
def AdditiveAbelianLaws (A : Type*) [Add A] [Zero A] [Neg A] : Prop :=
  (∀ a b c : A, (a + b) + c = a + (b + c)) ∧
  (∀ a : A, 0 + a = a) ∧ (∀ a : A, a + 0 = a) ∧
  (∀ a : A, a + -a = 0) ∧ (∀ a : A, -a + a = 0) ∧
  (∀ a b : A, a + b = b + a)

def AdditiveArithmeticGroups : Prop :=
  AdditiveAbelianLaws ℤ ∧ AdditiveAbelianLaws ℚ ∧
  AdditiveAbelianLaws ℝ ∧ AdditiveAbelianLaws ℂ

def FieldNonzeroOperations : Prop :=
  ∀ (F : Type u) [Field F],
    (1 : F) ≠ 0 ∧
    (∀ a b : F, a ≠ 0 → b ≠ 0 → a * b ≠ 0) ∧
    (∀ a : F, a ≠ 0 → a⁻¹ ≠ 0 ∧ a * a⁻¹ = 1 ∧ a⁻¹ * a = 1)

/-- The units contain exactly the nonzero field elements, including neither
zero nor any additional element. -/
def FieldUnitsCorrespondence : Prop :=
  ∀ (F : Type u) [Field F] (a : F), (∃ v : Fˣ, (v : F) = a) ↔ a ≠ 0

def FieldUnitsGroup : Prop :=
  ∀ (F : Type u) [Field F],
    GroupDefinition.groupAxiomsValue Fˣ (· * ·) 1 Inv.inv ∧
    ∀ a b : Fˣ, a * b = b * a

/-- This bridge also applies at modulus zero. The orientation of the difference
is immaterial to divisibility, and is fixed here as b - a. -/
def CongruenceBridge : Prop :=
  ∀ (n : ℕ) (a b : ℤ), (a : ZMod n) = (b : ZMod n) ↔ (n : ℤ) ∣ b - a

def CongruenceAddition : Prop :=
  ∀ (n : ℕ) (a b c d : ℤ),
    (n : ℤ) ∣ b - a → (n : ℤ) ∣ d - c →
      (n : ℤ) ∣ (b + d) - (a + c)

def ResidueAdditiveGroup : Prop :=
  ∀ n : ℕ, 1 ≤ n → AdditiveAbelianLaws (ZMod n)

/-- Being generated by [1] means every class is an integer multiple of [1]. -/
def ResidueOneGenerates : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∀ a : ZMod n, ∃ k : ℤ, k • (1 : ZMod n) = a

/-- Exactly one representative in the list 0,...,n-1, for each class. -/
def UniqueRepresentatives : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∀ a : ZMod n, ∃! r : ℕ, r < n ∧ (r : ZMod n) = a

/-- A Bézout equation supplies the specific inverse [x] of [a]. -/
def BezoutInverse : Prop :=
  ∀ (n : ℕ) (a x y : ℤ), x * a + y * n = 1 →
    (a : ZMod n) * (x : ZMod n) = 1 ∧ (x : ZMod n) * (a : ZMod n) = 1

/-- Conversely the congruence ab = 1 forces each common divisor to divide 1. -/
def InverseCommonDivisor : Prop :=
  ∀ (n : ℕ) (a b : ℤ), (n : ℤ) ∣ a * b - 1 →
    ∀ d : ℤ, d ∣ a → d ∣ (n : ℤ) → d ∣ 1

/-- The gcd of a signed integer and the nonnegative modulus is the normalized
natural gcd `Int.gcd`; equality to 1 expresses ordinary relative primality. -/
def ResidueUnitCriterion : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∀ a : ℤ, IsUnit (a : ZMod n) ↔ Int.gcd a (n : ℤ) = 1

def ResidueInverseCriterion : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∀ a : ℤ,
    (∃ b : ZMod n, (a : ZMod n) * b = 1 ∧ b * (a : ZMod n) = 1) ↔
      Int.gcd a (n : ℤ) = 1

/-- This identifies the unit carrier with precisely the invertible classes. -/
def ResidueUnitsCorrespondence : Prop :=
  ∀ (n : ℕ) (a : ZMod n),
    (∃ u : (ZMod n)ˣ, (u : ZMod n) = a) ↔
      ∃ b : ZMod n, a * b = 1 ∧ b * a = 1

def ResidueUnitsGroup : Prop :=
  ∀ n : ℕ, GroupDefinition.groupAxiomsValue (ZMod n)ˣ (· * ·) 1 Inv.inv ∧
    ∀ a b : (ZMod n)ˣ, a * b = b * a

def ResidueInvertibilityClosed : Prop :=
  ∀ n : ℕ, IsUnit (1 : ZMod n) ∧
    (∀ a b : ZMod n, IsUnit a → IsUnit b → IsUnit (a * b)) ∧
    (∀ u : (ZMod n)ˣ, IsUnit ((u⁻¹ : (ZMod n)ˣ) : ZMod n))

def ModulusOneTrivial : Prop :=
  (∀ a b : ZMod 1, a = b) ∧
  (∀ a b : (ZMod 1)ˣ, a = b) ∧
  ∀ a : ℤ, Int.gcd a 1 = 1

/-- The obstruction concerns the original residue multiplication and identity;
it does not deny the additive group on the same carrier. -/
def ModulusGreaterOne : Prop :=
  ∀ n : ℕ, 1 < n →
    (¬ ∃ b : ZMod n, (0 : ZMod n) * b = 1) ∧
    ¬ ∃ g : Group (ZMod n),
      g.mul = ((· * ·) : ZMod n → ZMod n → ZMod n) ∧ g.one = (1 : ZMod n)

def ModulusZeroCongruence : Prop :=
  ∀ a b : ℤ, ((0 : ℤ) ∣ a - b) ↔ a = b

/-- The identification preserves the ordinary integer class map and both ring
operations; in particular it is an additive group isomorphism. -/
def ModulusZeroIdentification : Prop :=
  (∃ e : ZMod 0 ≃+* ℤ, ∀ a : ℤ, e (a : ZMod 0) = a) ∧ Infinite (ZMod 0)

def ModulusZeroNoFiniteList : Prop :=
  ∀ N : ℕ, ¬ ∀ a : ZMod 0, ∃ r : ℕ, r < N ∧ (r : ZMod 0) = a

end Specs.D07.Ch01.ArithmeticExamples
