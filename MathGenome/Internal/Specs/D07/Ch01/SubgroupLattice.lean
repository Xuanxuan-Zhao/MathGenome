import MathGenome.Internal.Specs.D07.Ch01.SubgroupDefinitionTest
import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
Independent specification of `K07.01.subgroup_lattice`
(paper.tex:272–282; chapters/M07.01.tex:57–67).

Subgroups have their inherited ambient group operations. We use the canonical
`Subgroup.closure` for the generated subgroup, and explicitly require its
identification with the source's intersection. The families of subgroups and
generating sets are arbitrary, including empty ones. No commutativity,
finiteness, or nontriviality is imposed.
-/

namespace Specs.D07.Ch01.SubgroupLattice

universe u

/-- The intersection of any set of subgroups is itself a subgroup. -/
def IntersectionIsSubgroup : Prop :=
  ∀ (G : Type u) [Group G] (A : Set (Subgroup G)),
    ∃ L : Subgroup G, (L : Set G) = ⋂ H ∈ A, (H : Set G)

/-- An empty intersection means the whole ambient carrier. -/
def EmptyIntersection : Prop :=
  ∀ (G : Type u) [Group G],
    (⋂ H ∈ (∅ : Set (Subgroup G)), (H : Set G)) = Set.univ

/-- The canonical generated subgroup is the intersection in the source. -/
def GeneratedEqIntersection : Prop :=
  ∀ (G : Type u) [Group G] (S : Set G),
    (Subgroup.closure S : Set G) =
      ⋂ H ∈ {H : Subgroup G | S ⊆ (H : Set G)}, (H : Set G)

/-- Every prescribed generator belongs to the generated subgroup. -/
def SubsetGenerated : Prop :=
  ∀ (G : Type u) [Group G] (S : Set G), S ⊆ Subgroup.closure S

/-- The defining least-subgroup property, in both directions. -/
def GeneratedLeIff : Prop :=
  ∀ (G : Type u) [Group G] (S : Set G) (H : Subgroup G),
    Subgroup.closure S ≤ H ↔ S ⊆ (H : Set G)

/-- The empty set generates exactly the singleton identity, also in a trivial group. -/
def GeneratedEmpty : Prop :=
  ∀ (G : Type u) [Group G],
    (Subgroup.closure (∅ : Set G) : Set G) = {(1 : G)}

/-- The lattice join is the subgroup generated by the set union. -/
def JoinEqGenerated : Prop :=
  ∀ (G : Type u) [Group G] (H K : Subgroup G),
    H ⊔ K = Subgroup.closure ((H : Set G) ∪ (K : Set G))

/-- In particular, this generated subgroup is the least upper bound. -/
def JoinLeIff : Prop :=
  ∀ (G : Type u) [Group G] (H K L : Subgroup G),
    Subgroup.closure ((H : Set G) ∪ (K : Set G)) ≤ L ↔ H ≤ L ∧ K ≤ L

/-- A set union is a subgroup precisely when the two subgroups are comparable. -/
def UnionIsSubgroupIff : Prop :=
  ∀ (G : Type u) [Group G] (H K : Subgroup G),
    (∃ L : Subgroup G, (L : Set G) = (H : Set G) ∪ (K : Set G)) ↔
      H ≤ K ∨ K ≤ H

/-- The boundary case from the source proof, stated explicitly. -/
def IncomparableUnionNotSubgroup : Prop :=
  ∀ (G : Type u) [Group G] (H K : Subgroup G),
    (¬ H ≤ K) → (¬ K ≤ H) →
      ¬ ∃ L : Subgroup G, (L : Set G) = (H : Set G) ∪ (K : Set G)

end Specs.D07.Ch01.SubgroupLattice
