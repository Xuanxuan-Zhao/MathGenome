import MathGenome.Internal.Specs.D07.Ch08.KernelImage
import MathGenome.Internal.Specs.D07.Ch09.QuotientProjection
import Mathlib.Data.Rat.Defs

/-!
Independent specifications for K07.09.ideal_correspondence,
paper.tex:1610–1633. The theorem precedes the chapter's switch to
commutative rings. Thus both sides of the correspondence explicitly
consist of two-sided ideals in arbitrary associative unital rings.
The zero ring and the whole ideal are allowed.

The forward map is the actual inverse image. The inverse has carrier
equal to the actual set image, rather than merely an ideal generated by
that image. The last two statements formalize the source's warning about
the nonsurjective inclusion of the integers into the rationals.
-/

universe u v

namespace Specs.D07.Ch09.IdealCorrespondence

def PreimageProperties : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S] (f : R →+* S)
    (H : Ideal S) [H.IsTwoSided],
    (H.comap f).IsTwoSided ∧ RingHom.ker f ≤ H.comap f ∧
      (H.comap f : Set R) = f ⁻¹' (H : Set S)

def ImageProperties : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S] (f : R →+* S),
    Function.Surjective f → ∀ (J : Ideal R) [J.IsTwoSided],
      (J.map f).IsTwoSided ∧ (J.map f : Set S) = f '' (J : Set R)

/-- An ordered bijection on exactly the two-sided ideals, with its
forward map and inverse identified by their actual carriers. -/
def SurjectiveCorrespondence : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S] (f : R →+* S),
    Function.Surjective f →
      ∃ e : {H : Ideal S // H.IsTwoSided} ≃o
        {J : Ideal R // J.IsTwoSided ∧ RingHom.ker f ≤ J},
        (∀ H, (e H).val = H.val.comap f) ∧
        (∀ J, ((e.symm J).val : Set S) = f '' (J.val : Set R))

/-- Quotient ideals correspond to two-sided ideals above the original
ideal I; no properness or commutativity is needed. -/
def QuotientCorrespondence : Prop :=
  ∀ (R : Type u) [Ring R] (I : Ideal R) [I.IsTwoSided],
    ∃ e : {H : Ideal (R ⧸ I) // H.IsTwoSided} ≃o
      {J : Ideal R // J.IsTwoSided ∧ I ≤ J},
      (∀ H, (e H).val = H.val.comap (Ideal.Quotient.mk I)) ∧
      (∀ J, ((e.symm J).val : Set (R ⧸ I)) =
        (Ideal.Quotient.mk I) '' (J.val : Set R))

def IntegerRationalImageNotIdeal : Prop :=
  Function.Injective (Int.castRingHom ℚ) ∧
    ¬ ∃ H : Ideal ℚ, (H : Set ℚ) = Set.range (Int.castRingHom ℚ)

/-- The image of the whole integer ideal is the integer range, whereas
its generated ideal is all of Q and has a different carrier. -/
def GeneratedImageDiffers : Prop :=
  (Int.castRingHom ℚ) '' (↑(⊤ : Ideal ℤ) : Set ℤ) =
      Set.range (Int.castRingHom ℚ) ∧
    (⊤ : Ideal ℤ).map (Int.castRingHom ℚ) = ⊤ ∧
    ((⊤ : Ideal ℤ).map (Int.castRingHom ℚ) : Set ℚ) ≠
      (Int.castRingHom ℚ) '' (↑(⊤ : Ideal ℤ) : Set ℤ)

end Specs.D07.Ch09.IdealCorrespondence
