import MathGenome.Internal.Specs.D07.Ch08.IdealProduct
import MathGenome.Internal.Specs.D07.Ch08.PrincipalDivisibility

/-!
Independent statements for K07.09.prime_ideal, paper.tex:1632–1640.
The source restricts to commutative rings immediately before this entry.
`Ideal R` therefore represents two-sided ideals, and the upstream product
specification identifies `I * J` with finite sums of products.
No nontriviality or domain assumption is made on the ambient ring.
-/

universe u

namespace Specs.D07.Ch09.PrimeIdeal

/-- Primality includes properness and the elementwise product condition. -/
def PrimeCharacterization : Prop :=
  ∀ (R : Type u) [CommRing R] (P : Ideal R),
    P.IsPrime ↔ P ≠ ⊤ ∧ ∀ a b : R, a * b ∈ P → a ∈ P ∨ b ∈ P

/-- The product of the principal ideals generated by `a` and `b` is `(ab)`.
The upstream commutative-span compatibility identifies these spans with the
canonical two-sided spans used earlier in the paper. -/
def PrincipalProduct : Prop :=
  ∀ (R : Type u) [CommRing R] (a b : R),
    (Ideal.span {a}) * (Ideal.span {b}) = Ideal.span {a * b}

/-- The ideal-product criterion is equivalent to primality, with properness
retained: without it the whole ring would satisfy the right-hand product law. -/
def PrimeProductCharacterization : Prop :=
  ∀ (R : Type u) [CommRing R] (P : Ideal R),
    P.IsPrime ↔
      P ≠ ⊤ ∧ ∀ I J : Ideal R, I * J ≤ P → I ≤ P ∨ J ≤ P

end Specs.D07.Ch09.PrimeIdeal
