import Mathlib.Algebra.Module.FinitePresentation
import Mathlib.Algebra.MvPolynomial.Variables
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
Independent statements for the counterexample and presentation-independence
argument in paper.tex:3101–3122 (K07.16.finite_presentation).

`MvPolynomial ℕ k` is the formal polynomial ring in countably many commuting
indeterminates. Its exponent vectors and its coefficient functions have finite
support, so each polynomial uses only finitely many variables. Index `i`
corresponds to the source's `x_(i+1)`. The ideal is generated by all these
variables, not by an assumed finite subset. The residue is compared with k as
a k-algebra, and finite presentation refers to the R-module structure.
The general presentation-independence statement allows every commutative
ring, including the zero ring, and every ideal.
-/

universe u

noncomputable section

namespace Specs.D07.Ch16.FinitePresentationFiniteRelationsCounterexample

abbrev PolynomialRing (k : Type u) [CommRing k] := MvPolynomial ℕ k

def variablesIdeal (k : Type u) [CommRing k] : Ideal (PolynomialRing k) :=
  Ideal.span (Set.range MvPolynomial.X)

/-- The library's finite presentation means precisely a finite free cover
with finitely generated kernel, as in the source. -/
def FinitePresentationCriterion : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    Module.FinitePresentation R (R ⧸ I) ↔
      ∃ (n : ℕ) (π : (Fin n → R) →ₗ[R] (R ⧸ I)),
        Function.Surjective π ∧ (LinearMap.ker π).FG

/-- No choice of a different finite presentation can remove the obstruction. -/
def PresentationIndependence : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    Module.FinitePresentation R (R ⧸ I) → I.FG

/-- Explicit version quantified over every finite free presentation. -/
def EveryPresentation : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R) (n : ℕ)
    (π : (Fin n → R) →ₗ[R] (R ⧸ I)),
    Function.Surjective π → (LinearMap.ker π).FG → I.FG

def IdealNotFinitelyGenerated : Prop :=
  ∀ (k : Type u) [Field k], ¬ (variablesIdeal k).FG

def ResidueCyclic : Prop :=
  ∀ (k : Type u) [Field k],
    Submodule.span (PolynomialRing k)
      ({1} : Set (PolynomialRing k ⧸ variablesIdeal k)) = ⊤

/-- The quotient is the residue algebra k, by evaluation at the origin. -/
def ResidueAlgebra : Prop :=
  ∀ (k : Type u) [Field k],
    ∃ e : (PolynomialRing k ⧸ variablesIdeal k) ≃ₐ[k] k,
      (∀ p : PolynomialRing k,
        e (Ideal.Quotient.mk (variablesIdeal k) p) = MvPolynomial.constantCoeff p) ∧
      ∀ a : k, e.symm a = Ideal.Quotient.mk (variablesIdeal k) (MvPolynomial.C a)

def ResidueNotFinitelyPresented : Prop :=
  ∀ (k : Type u) [Field k],
    ¬ Module.FinitePresentation (PolynomialRing k)
      (PolynomialRing k ⧸ variablesIdeal k)

end Specs.D07.Ch16.FinitePresentationFiniteRelationsCounterexample
