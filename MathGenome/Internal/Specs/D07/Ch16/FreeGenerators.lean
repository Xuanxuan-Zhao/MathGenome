import MathGenome.Internal.Specs.D07.Ch16.Definition
import Mathlib.LinearAlgebra.FreeModule.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.Data.ZMod.Basic

/-!
Independent specification of K07.16.free_generators, paper.tex:2979–2992.
The basis and generation assertions apply to arbitrary unital left modules
(including zero modules) over associative unital, possibly noncommutative
rings. Finitely supported coefficient functions encode finite sums with
unique coefficients, without imposing finiteness on the basis index type.
Only the rank assertions require a commutative domain. The subsequent
primitive-vector lemma is separately allocated to support.pid_primitive_basis.
-/

universe u v w z

namespace Specs.D07.Ch16.FreeGenerators

open Module

/-- A family is a basis precisely when every vector has a unique finitely
supported coefficient expansion in that family. -/
def BasisCharacterization : Prop :=
  ∀ (R : Type u) [Ring R] (M : Type v) [AddCommGroup M] [Module R M]
    (ι : Type w) (e : ι → M),
    (∃ b : Basis ι R M, (b : ι → M) = e) ↔
      ∀ x : M, ∃! c : ι →₀ R, c.sum (fun i r => r • e i) = x

/-- Freeness means existence of a basis; the index type may be empty. -/
def FreeCharacterization : Prop :=
  ∀ (R : Type u) [Ring R] (M : Type v) [AddCommGroup M] [Module R M],
    Module.Free R M ↔ ∃ ι : Type v, Nonempty (Basis ι R M)

/-- Finite generation asks only for a finite spanning set, with no
independence condition. -/
def FiniteGenerationCharacterization : Prop :=
  ∀ (R : Type u) [Ring R] (M : Type v) [AddCommGroup M] [Module R M],
    Module.Finite R M ↔
      ∃ s : Set M, s.Finite ∧ Submodule.span R s = ⊤

/-- A free integer module has no nonzero vector killed by two. -/
def IntegerFreeTwoTorsion : Prop :=
  ∀ (M : Type v) [AddCommGroup M] [Module ℤ M] [Module.Free ℤ M]
    (x : M), (2 : ℤ) • x = 0 → x = 0

/-- The residue module is generated by one vector but is not free.
Its displayed nonzero vector is killed by the nonzero integer two. -/
def CyclicTwoCounterexample : Prop :=
  Submodule.span ℤ ({1} : Set (ZMod 2)) = ⊤ ∧
    Module.Finite ℤ (ZMod 2) ∧
    (1 : ZMod 2) ≠ 0 ∧ (2 : ℤ) • (1 : ZMod 2) = 0 ∧
    ¬ Module.Free ℤ (ZMod 2)

/-- Isomorphic finite coordinate modules over a domain have the same rank,
including rank zero. -/
def FiniteFreeRankInvariant : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R] (m n : ℕ),
    ((Fin m → R) ≃ₗ[R] (Fin n → R)) → m = n

/-- Consequently any two finite bases of a module over a domain have the
same cardinality. No finite-generation hypothesis on M is added: the
supplied bases already express it. -/
def FiniteBasisCardinality : Prop :=
  ∀ (R : Type u) [CommRing R] [IsDomain R]
    (M : Type v) [AddCommGroup M] [Module R M]
    (ι : Type w) (κ : Type z) [Fintype ι] [Fintype κ],
    Basis ι R M → Basis κ R M → Fintype.card ι = Fintype.card κ

/-- A zero module has an empty basis, as allowed by the source. -/
def EmptyBasis : Prop :=
  ∀ (R : Type u) [Ring R] (M : Type v) [AddCommGroup M] [Module R M]
    [Subsingleton M], Nonempty (Basis (Fin 0) R M)

end Specs.D07.Ch16.FreeGenerators
