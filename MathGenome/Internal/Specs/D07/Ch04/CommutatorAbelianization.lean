import MathGenome.Internal.Specs.D07.Ch04.CharacteristicSubgroups
import MathGenome.Internal.Specs.D07.Ch04.QuotientUniversalProperty
import Mathlib.GroupTheory.Commutator.Basic

/-!
Independent specification of `K07.04.commutator_abelianization`,
paper.tex:769–775 (chapters/M07.04.tex:110–116).

The canonical `commutator G` is identified with the subgroup generated by
exactly the elements `x * y * x⁻¹ * y⁻¹`, rather than the set of single
commutators. The alternate convention is also compared at the level of sets
of generators. Commutativity uses the existing `abelianPredicateValue` for
the given group operations, so no change of group structure is involved.

For each general quotient `G ⧸ N`, normality is an explicit hypothesis.
For the canonical quotient by `commutator G`, Mathlib supplies unconditional
normality; `CommutatorNormal` independently records that fact. The projection
is the same canonical `QuotientGroup.mk'` used in the upstream Specs.
All groups may be infinite or trivial, and source and target universes are
independent. Unique factorization is among bundled group homomorphisms.
-/

namespace Specs.D07.Ch04.CommutatorAbelianization

open Specs.D07.Ch01.GroupDefinition (abelianPredicateValue)

universe u v

def CommutatorGenerated : Prop :=
  ∀ (G : Type u) [Group G],
    commutator G = Subgroup.closure {z : G | ∃ x y : G, x * y * x⁻¹ * y⁻¹ = z}

def ConventionGeneratorsAgree : Prop :=
  ∀ (G : Type u) [Group G],
    {z : G | ∃ x y : G, x⁻¹ * y⁻¹ * x * y = z} =
      {z : G | ∃ x y : G, x * y * x⁻¹ * y⁻¹ = z}

def CommutatorCharacteristic : Prop :=
  ∀ (G : Type u) [Group G], (commutator G).Characteristic

def CommutatorNormal : Prop :=
  ∀ (G : Type u) [Group G], (commutator G).Normal

def QuotientAbelianIff : Prop :=
  ∀ (G : Type u) [Group G] (N : Subgroup G) [N.Normal],
    abelianPredicateValue (G ⧸ N) ↔ commutator G ≤ N

def AbelianQuotient : Prop :=
  ∀ (G : Type u) [Group G], abelianPredicateValue (G ⧸ commutator G)

def CommutatorLeKernel : Prop :=
  ∀ (G : Type u) (A : Type v) [Group G] [Group A],
    abelianPredicateValue A → ∀ f : G →* A, commutator G ≤ f.ker

def FactorsUniquely : Prop :=
  ∀ (G : Type u) (A : Type v) [Group G] [Group A],
    abelianPredicateValue A → ∀ f : G →* A,
      ∃! fbar : G ⧸ commutator G →* A,
        fbar.comp (QuotientGroup.mk' (commutator G)) = f

def FactorizationFormula : Prop :=
  ∀ (G : Type u) (A : Type v) [Group G] [Group A],
    abelianPredicateValue A → ∀ (f : G →* A)
      (fbar : G ⧸ commutator G →* A),
      fbar.comp (QuotientGroup.mk' (commutator G)) = f →
      ∀ g : G, fbar (QuotientGroup.mk' (commutator G) g) = f g

end Specs.D07.Ch04.CommutatorAbelianization
