import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.UniqueFactorizationDomain.Defs
import Mathlib.Algebra.Field.Defs

/-!
Independent statements for the bivariate nonprincipal-ideal example in
K07.11.multivariate_boundary (paper.tex:2851–2863).

`MvPolynomial (Fin 2) F` is the formal polynomial ring in two commuting
indeterminates: finitely supported coefficients on exponent vectors.
The variables indexed by 0 and 1 are respectively the source's X and Y.
The field is arbitrary, with no restriction on characteristic or cardinality.
Primality includes being nonzero and a nonunit. In the final statement the
ambient ring is a domain, so failure of `IsPrincipalIdealRing` is failure
of the PID property.
-/

universe u

namespace Specs.D07.Ch11.MultivariateBoundaryBivariateNonprincipalIdeal

open MvPolynomial

/-- The ideal generated by the two formal variables. -/
noncomputable abbrev originIdeal (F : Type u) [CommRing F] : Ideal (MvPolynomial (Fin 2) F) :=
  Ideal.span {X 0, X 1}

def VariablesPrime : Prop :=
  ∀ (F : Type u) [Field F],
    Prime (X 0 : MvPolynomial (Fin 2) F) ∧ Prime (X 1 : MvPolynomial (Fin 2) F)

def XNotDvdY : Prop :=
  ∀ (F : Type u) [Field F],
    ¬ (X 0 : MvPolynomial (Fin 2) F) ∣ X 1

def VariablesNotAssociated : Prop :=
  ∀ (F : Type u) [Field F],
    ¬ Associated (X 0 : MvPolynomial (Fin 2) F) (X 1)

def OriginIdealProper : Prop :=
  ∀ (F : Type u) [Field F], originIdeal F ≠ ⊤

def OriginIdealNotPrincipal : Prop :=
  ∀ (F : Type u) [Field F], ¬ (originIdeal F).IsPrincipal

/-- A concrete UFD that is not a PID, for every coefficient field. -/
def UfdNotPid : Prop :=
  ∀ (F : Type u) [Field F],
    IsDomain (MvPolynomial (Fin 2) F) ∧
    UniqueFactorizationMonoid (MvPolynomial (Fin 2) F) ∧
    ¬ IsPrincipalIdealRing (MvPolynomial (Fin 2) F)

end Specs.D07.Ch11.MultivariateBoundaryBivariateNonprincipalIdeal
