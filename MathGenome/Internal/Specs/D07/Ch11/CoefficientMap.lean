import Mathlib.Algebra.Polynomial.Degree.Lemmas
import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
Independent specification of K07.11.coefficient_map, paper.tex:2255–2283.

The coefficient map is the canonical unital `Polynomial.mapRingHom`. The
first assertions allow arbitrary associative unital rings, including the zero
ring. Only the ideal and quotient assertions require commutative rings.
Degree means `WithBot ℕ`, with bottom degree for zero. Leading coefficients
are transported by the original coefficient homomorphism.

The shared ideal below is represented as the ideal generated by constants.
`CoefficientIdealMembership` identifies its carrier with exactly the
coefficientwise condition defining I[X] in the paper; this identification is
an obligation, not an assumption. No properness assumption on I is made.
-/

universe u v

namespace Specs.D07.Ch11.CoefficientMap

open Polynomial

/-- A canonical representation of I[X], with its coefficient carrier to be proved. -/
noncomputable def coefficientIdeal {R : Type u} [CommRing R] (I : Ideal R) : Ideal (Polynomial R) :=
  I.map (C : R →+* Polynomial R)

def CoefficientFormula : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S) (f : Polynomial R) (n : ℕ),
    (mapRingHom φ f).coeff n = φ (f.coeff n)

/-- The coefficient prescription specifies a unique unital ring homomorphism. -/
def CoefficientHomomorphism : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S] (φ : R →+* S),
    ∃! Φ : Polynomial R →+* Polynomial S,
      ∀ (f : Polynomial R) (n : ℕ), (Φ f).coeff n = φ (f.coeff n)

def ConstantsAndIndeterminate : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S] (φ : R →+* S),
    (∀ a, mapRingHom φ (C a) = C (φ a)) ∧ mapRingHom φ X = X

def CoefficientZeroIff : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S), Function.Injective φ →
      ∀ (f : Polynomial R) (n : ℕ),
        (mapRingHom φ f).coeff n = 0 ↔ f.coeff n = 0

def MapInjective : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S), Function.Injective φ → Function.Injective (mapRingHom φ)

def DegreePreserved : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S), Function.Injective φ →
      ∀ f : Polynomial R, (mapRingHom φ f).degree = f.degree

def NatDegreePreserved : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S), Function.Injective φ →
      ∀ f : Polynomial R, (mapRingHom φ f).natDegree = f.natDegree

def LeadingCoefficientPreserved : Prop :=
  ∀ (R : Type u) (S : Type v) [Ring R] [Ring S]
    (φ : R →+* S), Function.Injective φ →
      ∀ f : Polynomial R, (mapRingHom φ f).leadingCoeff = φ f.leadingCoeff

/-- Reduction of the actual formal polynomial 2X+1 from ℤ modulo 2. -/
def DegreeDropExample : Prop :=
  let φ : ℤ →+* ZMod 2 := Int.castRingHom (ZMod 2)
  let f : Polynomial ℤ := C 2 * X + 1
  ¬ Function.Injective φ ∧
    mapRingHom φ f = 1 ∧ f.degree = (1 : WithBot ℕ) ∧
    (mapRingHom φ f).degree = (0 : WithBot ℕ) ∧
    f.leadingCoeff = 2 ∧ φ f.leadingCoeff = 0 ∧
    (mapRingHom φ f).leadingCoeff = 1

def CoefficientIdealMembership : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R) (f : Polynomial R),
    f ∈ coefficientIdeal I ↔ ∀ n, f.coeff n ∈ I

def CoefficientIdealGenerated : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    coefficientIdeal I = Ideal.span ((C : R →+* Polynomial R) '' (I : Set R))

def QuotientMapSurjective : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    Function.Surjective (mapRingHom (Ideal.Quotient.mk I))

def QuotientMapKernel : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    RingHom.ker (mapRingHom (Ideal.Quotient.mk I)) = coefficientIdeal I

/-- The isomorphism is induced by the coefficient quotient map itself. -/
def CoefficientQuotientIsomorphism : Prop :=
  ∀ (R : Type u) [CommRing R] (I : Ideal R),
    ∃ e : (Polynomial R ⧸ coefficientIdeal I) ≃+* Polynomial (R ⧸ I),
      ∀ f : Polynomial R,
        e (Ideal.Quotient.mk (coefficientIdeal I) f) =
          mapRingHom (Ideal.Quotient.mk I) f

end Specs.D07.Ch11.CoefficientMap
