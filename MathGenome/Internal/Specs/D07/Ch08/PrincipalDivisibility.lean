import MathGenome.Internal.Specs.D07.Ch08.IdealGeneration
import MathGenome.Internal.Specs.D07.Foundations.IntegerArithmetic

/-!
Independent statements for K07.08.principal_divisibility, paper.tex:1381–1391.
The generated ideals in the commutative formula use the same two-sided span as
IdealGeneration. The compatibility statement identifies it with Mathlib's
`Ideal.span`; over a commutative ring every `Ideal` is two-sided. No domain or
nontriviality assumption is made in the general statements.
-/

universe u
namespace Specs.D07.Ch08.PrincipalDivisibility

/-- Both canonical representations generate the same ideal in a commutative ring. -/
def CommutativeSpanCompatibility : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Set R),
    (TwoSidedIdeal.span S).asIdeal = Ideal.span S

/-- The principal ideal is exactly the set of single multiples, including zero. -/
def PrincipalIdealFormula : Prop :=
  ∀ (R : Type u) [CommRing R] (a x : R),
    x ∈ TwoSidedIdeal.span {a} ↔ ∃ r : R, x = r * a

/-- The two equivalences in the source; `≤` is inclusion of ideals. -/
def DivisibilityEquivalences : Prop :=
  ∀ (R : Type u) [CommRing R] (a b : R),
    (b ∈ TwoSidedIdeal.span {a} ↔ a ∣ b) ∧
      (a ∣ b ↔ TwoSidedIdeal.span {b} ≤ TwoSidedIdeal.span {a})

/-- A nonzero integer ideal has a least positive element, which generates it. -/
def IntegerNonzeroIdealPositiveGenerator : Prop :=
  ∀ I : Ideal ℤ, I ≠ ⊥ →
    ∃ d : ℤ, 0 < d ∧ d ∈ I ∧
      (∀ a : ℤ, a ∈ I → 0 < a → d ≤ a) ∧ I = Ideal.span {d}

/-- The zero ideal is generated by zero in either representation. -/
def IntegerZeroIdeal : Prop :=
  Ideal.span ({0} : Set ℤ) = ⊥ ∧ TwoSidedIdeal.span ({0} : Set ℤ) = ⊥

/-- Mutual divisibility determines the sign-normalized positive generator. -/
def PositiveGeneratorUnique : Prop :=
  ∀ d e : ℤ, 0 < d → 0 < e →
    Ideal.span {d} = Ideal.span {e} → d = e

/-- Every integer ideal, including zero, has a unique nonnegative generator. -/
def IntegerIdealClassification : Prop :=
  ∀ I : Ideal ℤ, ∃! d : ℤ, 0 ≤ d ∧ I = Ideal.span {d}

/-- The same classification for the upstream canonical two-sided ideals. -/
def IntegerTwoSidedIdealClassification : Prop :=
  ∀ I : TwoSidedIdeal ℤ, ∃! d : ℤ, 0 ≤ d ∧ I = TwoSidedIdeal.span {d}

end Specs.D07.Ch08.PrincipalDivisibility
