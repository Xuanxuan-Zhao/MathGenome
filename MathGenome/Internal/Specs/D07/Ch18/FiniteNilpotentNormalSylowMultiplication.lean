import Mathlib.GroupTheory.Sylow

/-!
Independent specification for the normal-Sylow multiplication stage of
K07.18.finite_nilpotent (paper.tex:5103–5135). No nilpotence premise is used.
The index is exactly the primes dividing the finite group's order. A family P
chooses one actual Sylow subgroup for each such prime. The list formula below
specifies multiplication in every enumeration, without assuming G abelian.
-/
namespace Specs.D07.Ch18.FiniteNilpotentNormalSylowMultiplication

universe u

/-- The source's normality hypothesis, including every choice of Sylow subgroup. -/
def AllSylowNormal (G : Type u) [Group G] : Prop :=
  ∀ (p : ℕ), p.Prime → ∀ Q : Sylow p G, Q.toSubgroup.Normal

/-- Canonical index of one factor for each prime divisor of the group order. -/
abbrev PrimeDivisors (G : Type u) := ↥(Nat.card G).primeFactors

/-- Distinct factors commute elementwise; elements within one factor need not. -/
def CommutingFactors : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (P : ∀ p : PrimeDivisors G, Sylow p.val G), AllSylowNormal G →
    Pairwise (fun p q => ∀ x y : G,
      x ∈ (P p).toSubgroup → y ∈ (P q).toSubgroup → Commute x y)

/-- Each factor meets the subgroup generated by ALL other factors trivially. -/
def TrivialIntersections : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (P : ∀ p : PrimeDivisors G, Sylow p.val G), AllSylowNormal G →
    ∀ p, (P p).toSubgroup ⊓ (⨆ (q) (_ : q ≠ p), (P q).toSubgroup) = ⊥

/-- Together the factors exhaust the ambient group. -/
def Exhaustion : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (P : ∀ p : PrimeDivisors G, Sylow p.val G), AllSylowNormal G →
    (⨆ p, (P p).toSubgroup) = ⊤

/-- Multiplication itself is an isomorphism, with both the full product formula
and its restriction to every individual coordinate. Lists enumerate each prime
exactly once, in any order. -/
def MultiplicationIsomorphism : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (P : ∀ p : PrimeDivisors G, Sylow p.val G), AllSylowNormal G →
    ∃ e : (∀ p, P p) ≃* G,
      (∀ (x : ∀ p, P p) (l : List (PrimeDivisors G)),
        l.Nodup → l.toFinset = Finset.univ →
        e x = (l.map (fun p => (x p : G))).prod) ∧
      (∀ (p : PrimeDivisors G) (y : P p),
        e (Pi.mulSingle p y) = (y : G))

/-- For a trivial group the indexing set is empty and the empty product map
is the isomorphism to G. No prime or nontrivial factor is artificially added. -/
def EmptyProduct : Prop :=
  ∀ (G : Type u) [Group G] [Finite G] [Subsingleton G],
    IsEmpty (PrimeDivisors G) ∧
    ∀ P : ∀ p : PrimeDivisors G, Sylow p.val G,
      ∃ e : (∀ p, P p) ≃* G, ∀ x, e x = 1

end Specs.D07.Ch18.FiniteNilpotentNormalSylowMultiplication
