import MathGenome.Internal.ODEDynamics.D13Unified.Ch07.ExponentialCalculus
import MathGenome.Internal.ODEDynamics.Specs.D13Unified.Ch08.MatrixLogarithm
import Mathlib.Analysis.Calculus.InverseFunctionTheorem.FDeriv
import Mathlib.Analysis.Normed.Module.Connected
import Mathlib.LinearAlgebra.Eigenspace.Minpoly
import Mathlib.LinearAlgebra.Complex.FiniteDimensional
import Mathlib.RingTheory.Adjoin.Polynomial.Basic
import Mathlib.Topology.Algebra.OpenSubgroup

/-!
The proof works in the commutative, finite-dimensional subalgebra generated by
`M`. The inverse function theorem makes the exponentials an open subgroup of
its units. A complex affine line from `1` to any unit has only finitely many
nonunit parameters, so its remaining parameter space is connected. Hence the
unit belongs to that subgroup. This argument includes arbitrary Jordan blocks.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false
open NormedSpace Set Filter
open scoped Matrix.Norms.Operator Topology

namespace D13Unified.Ch08

variable {A : Type*} [NormedCommRing A] [NormedAlgebra ℂ A] [CompleteSpace A]

lemma exp_range_mem_nhds_one : Set.range (NormedSpace.exp : A → A) ∈ 𝓝 (1 : A) := by
  have h : HasStrictFDerivAt (NormedSpace.exp : A → A)
      (ContinuousLinearEquiv.refl ℂ A : A →L[ℂ] A) 0 :=
    hasStrictFDerivAt_exp_zero
  have hm := h.map_nhds_eq_of_equiv
  rw [NormedSpace.exp_zero] at hm
  rw [← hm]
  exact Filter.mem_map.mpr (Filter.Eventually.of_forall fun x => ⟨x, rfl⟩)

/-- The exponentials in a commutative Banach algebra form a subgroup of its units. -/
def exponentialSubgroup : Subgroup Aˣ := by
  letI : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  exact {
    carrier := {u | ∃ x : A, NormedSpace.exp x = (u : A)}
    one_mem' := ⟨0, NormedSpace.exp_zero⟩
    mul_mem' := by
      rintro u v ⟨x, hx⟩ ⟨y, hy⟩
      exact ⟨x + y, by
        rw [NormedSpace.exp_add_of_commute (Commute.all x y), hx, hy]
        rfl⟩
    inv_mem' := by
      rintro u ⟨x, hx⟩
      refine ⟨-x, ?_⟩
      have h := NormedSpace.exp_add_of_commute (Commute.all x (-x))
      have he : NormedSpace.exp x * NormedSpace.exp (-x) = 1 := by
        simpa using h.symm
      have he' := congrArg (fun a : A => (↑(u⁻¹) : A) * a) he
      simpa [hx, ← mul_assoc] using he' }

lemma exponentialSubgroup_isOpen : IsOpen (exponentialSubgroup (A := A) : Set Aˣ) := by
  apply Subgroup.isOpen_of_mem_nhds (g := 1)
  change Units.val ⁻¹' Set.range (NormedSpace.exp : A → A) ∈ 𝓝 (1 : Aˣ)
  exact Units.continuous_val.continuousAt.preimage_mem_nhds
    (show Set.range (NormedSpace.exp : A → A) ∈ 𝓝 ((1 : Aˣ) : A) from
      exp_range_mem_nhds_one)

omit [CompleteSpace A] in
lemma finite_algebra_spectrum [FiniteDimensional ℂ A] (a : A) :
    (spectrum ℂ a).Finite := by
  have h : spectrum ℂ a = spectrum ℂ (Algebra.lmul ℂ A a) := by
    ext z
    rw [spectrum.mem_iff, spectrum.mem_iff, ← (Algebra.lmul ℂ A).commutes z,
      ← map_sub, Algebra.lmul_isUnit_iff]
  rw [h]
  exact Module.End.finite_spectrum _

omit [CompleteSpace A] in
/-- Only finitely many parameters on a complex affine line through `1`
fail to be units. -/
lemma finite_nonunits_affine [FiniteDimensional ℂ A] (b : A) :
    {z : ℂ | ¬ IsUnit (1 + z • b)}.Finite := by
  apply ((finite_algebra_spectrum b).image (fun z : ℂ => -z⁻¹)).subset
  intro z hz
  have hz0 : z ≠ 0 := by
    intro h
    simp [h] at hz
  refine ⟨-z⁻¹, ?_, by simp⟩
  rw [spectrum.mem_iff]
  have he : algebraMap ℂ A (-z⁻¹) - b = (-z⁻¹) • (1 + z • b) := by
    rw [Algebra.algebraMap_eq_smul_one, smul_add, smul_smul]
    simp [hz0, sub_eq_add_neg]
  rw [he]
  intro h
  exact hz (isUnit_of_mul_isUnit_right (by simpa only [Algebra.smul_def] using h))

/-- Every unit in a finite-dimensional commutative complex Banach algebra
is an exponential. No choice of a scalar logarithm branch is needed. -/
theorem exists_exp_of_isUnit [FiniteDimensional ℂ A] (a : A) (ha : IsUnit a) :
    ∃ x : A, NormedSpace.exp x = a := by
  let bad : Set ℂ := {z | ¬ IsUnit (1 + z • (a - 1))}
  let D := badᶜ
  have hD : IsPreconnected D :=
    ((finite_nonunits_affine (a - 1)).countable.isPathConnected_compl_of_one_lt_rank
      (by rw [Complex.rank_real_complex]; norm_num)).isConnected.isPreconnected
  have hu (z : D) : IsUnit (1 + (z : ℂ) • (a - 1)) := by
    simpa only [D, bad, mem_compl_iff, mem_ofPred_eq, not_not] using z.property
  let f : D → Aˣ := fun z => (hu z).unit
  have hf : Continuous f := by
    apply Units.isOpenEmbedding_val.isEmbedding.continuous_iff.mpr
    change Continuous (fun z : D => 1 + (z : ℂ) • (a - 1))
    fun_prop
  have h0 : (0 : ℂ) ∈ D := by simp [D, bad]
  have h1 : (1 : ℂ) ∈ D := by simpa [D, bad] using ha
  have hc : IsPreconnected (Set.range f) := by
    let : PreconnectedSpace D := isPreconnected_iff_preconnectedSpace.mp hD
    exact isPreconnected_range hf
  have hcl : IsClopen (exponentialSubgroup (A := A) : Set Aˣ) :=
    ⟨(exponentialSubgroup (A := A)).isClosed_of_isOpen exponentialSubgroup_isOpen,
      exponentialSubgroup_isOpen⟩
  have hone : f ⟨0, h0⟩ = 1 := by apply Units.ext; simp [f]
  have hsub := hc.subset_isClopen hcl
    (show (Set.range f ∩ (exponentialSubgroup (A := A) : Set Aˣ)).Nonempty from
      ⟨1, ⟨⟨⟨0, h0⟩, hone⟩, (exponentialSubgroup (A := A)).one_mem⟩⟩)
  have hh := hsub (show f ⟨1, h1⟩ ∈ Set.range f from ⟨⟨1, h1⟩, rfl⟩)
  change ∃ x : A, NormedSpace.exp x = (f ⟨1, h1⟩ : A) at hh
  simpa [f] using hh

/-- A finite-dimensional subalgebra is inverse closed. -/
lemma isUnit_subalgebra_of_isUnit {B : Type*} [Ring B] [Algebra ℂ B]
    (S : Subalgebra ℂ B) [FiniteDimensional ℂ S] (x : S) (hx : IsUnit (x : B)) :
    IsUnit x := by
  apply (Algebra.lmul_isUnit_iff (R := ℂ)).mp
  rw [Module.End.isUnit_iff]
  have hinj : Function.Injective (Algebra.lmul ℂ S x) := by
    intro y z h
    apply Subtype.ext
    apply hx.mul_left_cancel
    exact congrArg (fun t : S => (t : B)) h
  exact ⟨hinj, LinearMap.surjective_of_injective hinj⟩

/-- The complex matrix logarithm, in every finite dimension. -/
theorem matrix_exists_log {n : Type*} [Fintype n] [DecidableEq n]
    (M : Matrix n n ℂ) (hM : IsUnit M) :
    ∃ L : Matrix n n ℂ, D13Unified.Ch07.matrixExp L 1 = M := by
  let S := Algebra.adjoin ℂ ({M} : Set (Matrix n n ℂ))
  let : NormedCommRing S :=
    { (inferInstance : NormedRing S), (inferInstance : CommRing S) with }
  let : CompleteSpace S := FiniteDimensional.complete ℂ S
  let m : S := ⟨M, Algebra.subset_adjoin (by simp)⟩
  have hm : IsUnit m := isUnit_subalgebra_of_isUnit S m hM
  obtain ⟨L, hL⟩ := exists_exp_of_isUnit m hm
  refine ⟨(L : Matrix n n ℂ), ?_⟩
  let : NormedAlgebra ℚ S := .restrictScalars ℚ ℂ S
  have he := NormedSpace.map_exp S.val continuous_subtype_val L
  have hval := congrArg (fun x : S => (x : Matrix n n ℂ)) hL
  simpa [D13Unified.Ch07.matrixExp, m] using he.symm.trans hval

end D13Unified.Ch08
