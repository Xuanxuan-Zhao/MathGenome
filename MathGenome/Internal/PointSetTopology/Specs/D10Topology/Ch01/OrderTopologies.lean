import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch01.BasesAndNeighborhoods
import Mathlib.Topology.Order.Basic

/-! Independent specifications for `d10:01:order-topology` and
`d10:01:ordered-spaces`. There is no ambient topology parameter: the
topology in each assertion is the one generated by the two kinds of rays.
Convexity refers to the order, with no topological connectedness premise. -/

open Set
open scoped Topology
universe u

namespace Specs.D10Topology.Ch01.OrderTopologies

def raysType : Type (u + 1) :=
  (L : Type u) → [LinearOrder L] → Set (Set L)

def raysValue : raysType := fun L _ =>
  {U : Set L | ∃ a, U = Ioi a ∨ U = Iio a}

def topologyType : Type (u + 1) :=
  (L : Type u) → [LinearOrder L] → TopologicalSpace L

def topologyValue : topologyType := fun L _ =>
  TopologicalSpace.generateFrom (raysValue L)

def intervalsType : Type (u + 1) :=
  (L : Type u) → [LinearOrder L] → Set (Set L)

/-- Ordinary intervals and the two endpoint intervals, when endpoints exist. -/
def intervalsValue : intervalsType := fun L _ =>
  {U : Set L | (∃ a b, a < b ∧ U = Ioo a b) ∨
    (∃ m b, IsBot m ∧ m < b ∧ U = Ico m b) ∨
    (∃ a M, IsTop M ∧ a < M ∧ U = Ioc a M)}

def topology_eq_mathlib : Prop :=
  ∀ (L : Type u) [LinearOrder L], topologyValue L = Preorder.topology L

def rays_open : Prop :=
  ∀ (L : Type u) [LinearOrder L] (a : L),
    IsOpen[topologyValue L] (Iio a) ∧ IsOpen[topologyValue L] (Ioi a)

def interval_basis : Prop :=
  ∀ (L : Type u) [LinearOrder L] [Nontrivial L],
    BasesAndNeighborhoods.BasisFor (topologyValue L) (intervalsValue L)

def hausdorff : Prop :=
  ∀ (L : Type u) [LinearOrder L], @T2Space L (topologyValue L)

def convex_subspace : Prop :=
  ∀ (L : Type u) [LinearOrder L] (A : Set L),
    (∀ x ∈ A, ∀ y ∈ A, ∀ z, x ≤ z → z ≤ y → z ∈ A) →
    topologyValue A = TopologicalSpace.induced (Subtype.val : A → L) (topologyValue L)

/-- The open-set form of the same subspace conclusion. -/
def convex_subspace_opens : Prop :=
  ∀ (L : Type u) [LinearOrder L] (A : Set L),
    (∀ x ∈ A, ∀ y ∈ A, ∀ z, x ≤ z → z ≤ y → z ∈ A) →
    ∀ U : Set A, IsOpen[topologyValue A] U ↔
      ∃ V : Set L, IsOpen[topologyValue L] V ∧ U = (Subtype.val : A → L) ⁻¹' V

end Specs.D10Topology.Ch01.OrderTopologies
