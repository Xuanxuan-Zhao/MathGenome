import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch01.OrderTopologies
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch05.Compactness
import Mathlib.SetTheory.Ordinal.Basic

/-!
Independent statements for `paper.tex`, `d10:18:ordinal-compact`.
The ordinal interval is the subtype `Set.Icc 0 β`, with its restricted
linear order and the topology generated by its open order rays.
The ordinal and its universe are arbitrary; there is no countability premise.
-/

open Set
universe u

namespace Specs.D10Topology.Ch18.OrdinalCompact

/-- The intrinsic order topology agrees with the ordinal subspace topology. -/
def ordinalInterval_orderTopology_eq_subspace : Prop :=
  ∀ β : Ordinal.{u},
    Ch01.OrderTopologies.topologyValue (Icc (0 : Ordinal.{u}) β) =
      TopologicalSpace.induced (Subtype.val : Icc (0 : Ordinal.{u}) β → Ordinal.{u})
        (Ch01.OrderTopologies.topologyValue Ordinal.{u})

/-- Every closed ordinal interval is compact Hausdorff in its order topology.
Compactness here is exactly the finite-subcover property from Chapter 5. -/
def ordinalInterval_compact_hausdorff : Prop :=
  ∀ β : Ordinal.{u},
    @Ch05.Compactness.CoverCompact (Icc (0 : Ordinal.{u}) β)
      (Ch01.OrderTopologies.topologyValue (Icc (0 : Ordinal.{u}) β)) ∧
    @T2Space (Icc (0 : Ordinal.{u}) β)
      (Ch01.OrderTopologies.topologyValue (Icc (0 : Ordinal.{u}) β))

end Specs.D10Topology.Ch18.OrdinalCompact
