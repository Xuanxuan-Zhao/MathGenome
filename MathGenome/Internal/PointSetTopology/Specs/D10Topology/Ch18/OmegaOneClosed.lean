import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch18.OrdinalCompact
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch08.CountabilityConventions
import Mathlib.SetTheory.Cardinal.Aleph

/-!
Independent statements for `paper.tex`, `d10:18:omega-one`, concerning
Z = [0, ω₁]. The initial segment is the actual subset [0, ω₁) of Z.
The topology is generated by order rays, as in Chapter 1; its equality
with the ambient ordinal subspace topology is an explicit target.
-/

open Set Filter
open scoped Ordinal Topology
universe u
noncomputable section

namespace Specs.D10Topology.Ch18.OmegaOneClosed

abbrev ClosedInterval := Icc (0 : Ordinal.{u}) ω₁

def endpoint : ClosedInterval.{u} := ⟨ω₁, zero_le, le_rfl⟩
def initialSegment : Set ClosedInterval.{u} := {x | x.val < ω₁}

def intervalType : Type (u + 2) := Type (u + 1)
def intervalValue : intervalType.{u} := ↥ClosedInterval.{u}
def endpointType : Type (u + 1) := ClosedInterval.{u}
def endpointValue : endpointType.{u} := endpoint

def initialSegmentType := Set ClosedInterval.{u}
def initialSegmentValue : initialSegmentType.{u} := initialSegment

def orderTopology_eq_subspace : Prop :=
  Ch01.OrderTopologies.topologyValue ClosedInterval.{u} =
    TopologicalSpace.induced (Subtype.val : ClosedInterval.{u} → Ordinal.{u})
      (Ch01.OrderTopologies.topologyValue Ordinal.{u})

def compact_hausdorff : Prop :=
  @Ch05.Compactness.CoverCompact ClosedInterval.{u}
      (Ch01.OrderTopologies.topologyValue ClosedInterval.{u}) ∧
    @T2Space ClosedInterval.{u} (Ch01.OrderTopologies.topologyValue ClosedInterval.{u})

def endpoint_mem_closure : Prop :=
  letI := Ch01.OrderTopologies.topologyValue ClosedInterval.{u}
  endpoint ∈ closure initialSegment

/-- Failure of the countable local-base property at the specified endpoint. -/
def not_firstCountableAt_endpoint : Prop :=
  ¬ Ch04.FirstCountableSequences.FirstCountableAt
    (Ch01.OrderTopologies.topologyValue ClosedInterval.{u}) endpoint

def not_firstCountable : Prop :=
  ¬ Ch08.CountabilityConventions.firstCountableValue
    (Ch01.OrderTopologies.topologyValue ClosedInterval.{u})

/-- Every sequence in the actual initial segment fails to converge to ω₁ in Z. -/
def no_sequence_tendsto_endpoint : Prop :=
  letI := Ch01.OrderTopologies.topologyValue ClosedInterval.{u}
  ∀ a : ℕ → ClosedInterval.{u}, (∀ n, a n ∈ initialSegment) →
    ¬ Tendsto a atTop (𝓝 endpoint)

end Specs.D10Topology.Ch18.OmegaOneClosed
