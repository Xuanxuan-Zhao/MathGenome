import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch01.ElementaryTopologies
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch07.SeparationConventions
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch08.CountabilityConventions
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch09.MetricConventions

/-! Independent statements for paper.tex, d10:08:sorgenfrey-line.
The topology is the chapter 1 topology generated by nonempty [a,b) on ℝ.
T₃ means regular plus T₁. Lindelöfness and normality are allocated separately.
-/
open Set TopologicalSpace
open scoped Topology

namespace Specs.D10Topology.Ch08.SorgenfreyLine

open Ch01.ElementaryTopologies

def basic_clopen : Prop := ∀ a b : ℝ, a < b →
  @IsClopen ℝ lowerLimitTopology (Ico a b)

def t3 : Prop :=
  @RegularSpace ℝ lowerLimitTopology ∧ @T1Space ℝ lowerLimitTopology

def reciprocal_localBase : Prop := ∀ x : ℝ,
  Ch01.BasesAndNeighborhoods.LocalBase lowerLimitTopology x
    (range (fun n : ℕ => Ico x (x + 1 / (n + 1 : ℝ))))

def firstCountable : Prop :=
  Ch04.FirstCountableSequences.FirstCountable lowerLimitTopology

def rationals_dense : Prop :=
  @Dense ℝ lowerLimitTopology (range ((↑) : ℚ → ℝ))

def separable : Prop := @SeparableSpace ℝ lowerLimitTopology

def not_secondCountable : Prop := ¬ @SecondCountableTopology ℝ lowerLimitTopology

def not_metrizable : Prop := ¬ Ch09.MetricConventions.Metrizable lowerLimitTopology

end Specs.D10Topology.Ch08.SorgenfreyLine
