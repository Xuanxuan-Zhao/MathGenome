import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch06.Connectedness
import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch01.OrderTopologies
import Mathlib.Topology.Order.Real

/-! Independent statements of `d10:06:intervals` and
`d10:06:linear-continuum`. Connectedness includes empty subsets.
The general completeness assumption is explicitly existence of least upper
bounds, with no chosen supremum operation or additional countability axiom. -/

open Set
universe u

namespace Specs.D10Topology.Ch06.OrderedConnectedness
open _root_.D10Topology.Ch06.ConnectednessData

/-- Strict-between convexity, exactly as stated for subsets of the real line. -/
def real_connectedSubset_iff_orderConvex : Prop :=
  ∀ A : Set ℝ, ConnectedSubset A ↔
    ∀ a ∈ A, ∀ b ∈ A, ∀ t : ℝ, a < t → t < b → t ∈ A

/-- Endpoints are allowed, as well as every strictly intermediate value.
The quantified domain may be any connected space, including the empty space. -/
def real_intermediate_value : Prop :=
  ∀ {X : Type u} [TopologicalSpace X] (f : X → ℝ),
    Connected X → Continuous f → ∀ a b : X, ∀ t : ℝ,
      f a ≤ t → t ≤ f b → ∃ x : X, f x = t

/-- The topology is generated by order rays, as in Chapter 1. Both the
ambient-subspace connectedness and the connectedness for the restricted
order are included, together with the equality of these topologies. -/
def linear_continuum_convex_connected : Prop :=
  ∀ (L : Type u) [LinearOrder L] [Nontrivial L] [DenselyOrdered L],
    (∀ S : Set L, S.Nonempty → BddAbove S → ∃ c : L, IsLUB S c) →
    ∀ A : Set L,
      (∀ a ∈ A, ∀ b ∈ A, ∀ t : L, a < t → t < b → t ∈ A) →
      @ConnectedSubset L (Ch01.OrderTopologies.topologyValue L) A ∧
      Ch01.OrderTopologies.topologyValue A =
        TopologicalSpace.induced (Subtype.val : A → L)
          (Ch01.OrderTopologies.topologyValue L) ∧
      @Connected A (Ch01.OrderTopologies.topologyValue A)

end Specs.D10Topology.Ch06.OrderedConnectedness
