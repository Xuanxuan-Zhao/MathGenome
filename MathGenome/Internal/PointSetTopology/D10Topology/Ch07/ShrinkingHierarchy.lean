import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch07.ShrinkingHierarchy
import MathGenome.Internal.PointSetTopology.D10Topology.Ch07.SeparationConventions

/-! Shrinking, the separation hierarchy, and the normal nonregular upper-ray real line.
These results formalize paper.tex, d10:07:shrinking and d10:07:hierarchy. -/

open Set
open scoped Topology
universe u

namespace D10Topology.Ch07

variable (X : Type u) [TopologicalSpace X]

theorem regular_iff_shrinking : Regular X ↔
    ∀ (x : X) (U : Set X), IsOpen U → x ∈ U →
      ∃ V : Set X, IsOpen V ∧ x ∈ V ∧ V ⊆ closure V ∧ closure V ⊆ U := by
  rw [regular_iff_disjoint_open]
  constructor
  · intro h x U hU hx
    obtain ⟨V, W, hV, hW, hxV, hUW, hd⟩ := h Uᶜ hU.isClosed_compl x (by simpa using hx)
    refine ⟨V, hV, hxV, subset_closure, ?_⟩
    have hc : closure V ⊆ Wᶜ := closure_minimal
      (fun y hy hyW => Set.disjoint_left.mp hd hy hyW) hW.isClosed_compl
    intro y hy
    by_contra hyU
    exact hc hy (hUW hyU)
  · intro h F hF x hx
    obtain ⟨V, hV, hxV, _, hc⟩ := h x Fᶜ hF.isOpen_compl hx
    refine ⟨V, (closure V)ᶜ, hV, isClosed_closure.isOpen_compl, hxV, ?_, ?_⟩
    · intro y hy hyc
      exact hc hyc hy
    · exact Set.disjoint_left.mpr fun y hy hyc => hyc (subset_closure hy)

theorem normal_iff_shrinking : Normal X ↔
    ∀ (F U : Set X), IsClosed F → IsOpen U → F ⊆ U →
      ∃ V : Set X, IsOpen V ∧ F ⊆ V ∧ V ⊆ closure V ∧ closure V ⊆ U := by
  rw [normal_iff_disjoint_open]
  constructor
  · intro h F U hF hU hFU
    have hd : Disjoint F Uᶜ := Set.disjoint_left.mpr fun x hx hxU => hxU (hFU hx)
    obtain ⟨V, W, hV, hW, hFV, hUW, hdVW⟩ := h F Uᶜ hF hU.isClosed_compl hd
    refine ⟨V, hV, hFV, subset_closure, ?_⟩
    have hc : closure V ⊆ Wᶜ := closure_minimal
      (fun y hy hyW => Set.disjoint_left.mp hdVW hy hyW) hW.isClosed_compl
    intro y hy
    by_contra hyU
    exact hc hy (hUW hyU)
  · intro h A B hA hB hd
    have hAB : A ⊆ Bᶜ := fun y hy hyB => Set.disjoint_left.mp hd hy hyB
    obtain ⟨V, hV, hAV, _, hc⟩ := h A Bᶜ hA hB.isOpen_compl hAB
    refine ⟨V, (closure V)ᶜ, hV, isClosed_closure.isOpen_compl, hAV, ?_, ?_⟩
    · intro y hy hyc
      exact hc hyc hy
    · exact Set.disjoint_left.mpr fun y hy hyc => hyc (subset_closure hy)

theorem t2_implies_t1 (h : T2 X) : T1 X := by
  let := h
  infer_instance

theorem t1_implies_t0 (h : T1 X) : T0 X := by
  let := h
  infer_instance

theorem completelyRegular_implies_regular (h : CompletelyRegular X) : Regular X := by
  let := (completelyRegular_iff_mathlib X).mp h
  infer_instance

theorem regular_t0_implies_t1 (hR : Regular X) (h0 : T0 X) : T1 X := by
  let := hR
  let := h0
  infer_instance

theorem regular_t0_implies_t3 (hR : Regular X) (h0 : T0 X) : T3 X :=
  ⟨hR, regular_t0_implies_t1 X hR h0⟩

theorem t3_implies_t2 (h : T3 X) : T2 X := by
  let := (t3_iff_mathlib X).mp h
  infer_instance

theorem normal_t1_implies_regular (hN : Normal X) (h1 : T1 X) : Regular X := by
  let := (t4_iff_mathlib X).mp ⟨hN, h1⟩
  infer_instance

theorem t4_implies_t3 (h : T4 X) : T3 X :=
  ⟨normal_t1_implies_regular X h.1 h.2, h.2⟩

/-- The topology generated by all real upper rays. -/
abbrev upperRayTopology : TopologicalSpace ℝ :=
  Specs.D10Topology.Ch07.ShrinkingHierarchy.upperRayTopologyValue

/-- Each generated open set is also open in the usual real topology. -/
lemma upperRay_isOpen_usual {U : Set ℝ} (hU : IsOpen[upperRayTopology] U) :
    IsOpen U := by
  change TopologicalSpace.GenerateOpen (range (fun a : ℝ => Ioi a)) U at hU
  induction hU with
  | basic U hU =>
    obtain ⟨a, rfl⟩ := hU
    exact isOpen_Ioi
  | univ => exact isOpen_univ
  | inter U V _ _ ihU ihV => exact ihU.inter ihV
  | sUnion S _ ih => exact isOpen_sUnion ih

/-- A nonempty proper upper set open in the usual real topology has an excluded infimum. -/
private lemma real_open_upperSet_form {U : Set ℝ} (hU : IsOpen U) (hu : IsUpperSet U) :
    U = ∅ ∨ U = univ ∨ ∃ a : ℝ, U = Ioi a := by
  classical
  by_cases hne : U.Nonempty
  · by_cases hfull : U = univ
    · exact Or.inr (Or.inl hfull)
    · have hex : ∃ b : ℝ, b ∉ U := by
        by_contra h
        push_neg at h
        exact hfull (Set.eq_univ_of_forall h)
      obtain ⟨b, hb⟩ := hex
      have hbd : BddBelow U := ⟨b, fun y hy => le_of_not_gt
        (fun hyb => hb (hu hyb.le hy))⟩
      have hnot : sInf U ∉ U := by
        intro hc
        obtain ⟨l, r, ⟨hl, hr⟩, hsub⟩ :=
          mem_nhds_iff_exists_Ioo_subset.mp (hU.mem_nhds hc)
        obtain ⟨y, hly, hyc⟩ := exists_between hl
        have hy : y ∈ U := hsub ⟨hly, hyc.trans hr⟩
        exact (not_lt_of_ge (csInf_le hbd hy)) hyc
      refine Or.inr (Or.inr ⟨sInf U, ?_⟩)
      ext x
      constructor
      · intro hx
        exact lt_of_le_of_ne (csInf_le hbd hx) (fun he => hnot (he.symm ▸ hx))
      · intro hx
        obtain ⟨y, hy, hyx⟩ := exists_lt_of_csInf_lt hne hx
        exact hu hyx.le hy
  · exact Or.inl (Set.not_nonempty_iff_eq_empty.mp hne)

section UpperRay

local instance : TopologicalSpace ℝ := upperRayTopology

lemma upperRay_isOpen_Ioi (a : ℝ) : IsOpen (Ioi a) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨a, rfl⟩

lemma upperRay_isUpperSet {U : Set ℝ} (hU : IsOpen U) : IsUpperSet U := by
  change TopologicalSpace.GenerateOpen (range (fun a : ℝ => Ioi a)) U at hU
  induction hU with
  | basic U hU =>
    obtain ⟨a, rfl⟩ := hU
    exact isUpperSet_Ioi a
  | univ => exact isUpperSet_univ
  | inter U V _ _ ihU ihV => exact ihU.inter ihV
  | sUnion S _ ih => exact isUpperSet_sUnion ih

/-- These are exactly the opens listed in the paper, not merely an upper-set topology. -/
theorem upperRay_opens (U : Set ℝ) : IsOpen U ↔
    U = ∅ ∨ U = univ ∨ ∃ a : ℝ, U = Ioi a := by
  constructor
  · intro hU
    exact real_open_upperSet_form (upperRay_isOpen_usual hU) (upperRay_isUpperSet hU)
  · rintro (rfl | rfl | ⟨a, rfl⟩)
    · exact isOpen_empty
    · exact isOpen_univ
    · exact upperRay_isOpen_Ioi a

lemma upperRay_isLowerSet {F : Set ℝ} (hF : IsClosed F) : IsLowerSet F :=
  isUpperSet_compl.mp (upperRay_isUpperSet hF.isOpen_compl)

lemma upperRay_closed_nonempty_inter {A B : Set ℝ} (hA : IsClosed A) (hB : IsClosed B)
    (hneA : A.Nonempty) (hneB : B.Nonempty) : (A ∩ B).Nonempty := by
  obtain ⟨a, ha⟩ := hneA
  obtain ⟨b, hb⟩ := hneB
  exact ⟨min a b, upperRay_isLowerSet hA (min_le_left _ _) ha,
    upperRay_isLowerSet hB (min_le_right _ _) hb⟩

theorem upperRay_normal : Normal ℝ := by
  apply (normal_iff_disjoint_open ℝ).mpr
  intro A B hA hB hd
  by_cases hneA : A.Nonempty
  · have hB0 : B = ∅ := by
      apply Set.not_nonempty_iff_eq_empty.mp
      intro hneB
      obtain ⟨x, hxA, hxB⟩ := upperRay_closed_nonempty_inter hA hB hneA hneB
      exact Set.disjoint_left.mp hd hxA hxB
    subst B
    exact ⟨univ, ∅, isOpen_univ, isOpen_empty, subset_univ _, subset_rfl,
      disjoint_empty univ⟩
  · have hA0 : A = ∅ := Set.not_nonempty_iff_eq_empty.mp hneA
    subst A
    exact ⟨∅, univ, isOpen_empty, isOpen_univ, subset_rfl, subset_univ _,
      empty_disjoint univ⟩

theorem upperRay_obstruction :
    IsClosed (Iic (0 : ℝ)) ∧ (1 : ℝ) ∉ Iic (0 : ℝ) ∧
      ¬ ∃ U V : Set ℝ, IsOpen U ∧ IsOpen V ∧ (1 : ℝ) ∈ U ∧ Iic (0 : ℝ) ⊆ V ∧
        Disjoint U V := by
  refine ⟨?_, by norm_num, ?_⟩
  · rw [← isOpen_compl_iff, compl_Iic]
    exact upperRay_isOpen_Ioi 0
  · rintro ⟨U, V, _, hV, h1U, hFV, hd⟩
    have h1V : (1 : ℝ) ∈ V :=
      upperRay_isUpperSet hV (by norm_num : (0 : ℝ) ≤ 1) (hFV (by simp))
    exact Set.disjoint_left.mp hd h1U h1V

theorem upperRay_not_regular : ¬ Regular ℝ := by
  intro hR
  have h := (regular_iff_disjoint_open ℝ).mp hR (Iic 0)
    upperRay_obstruction.1 1 upperRay_obstruction.2.1
  exact upperRay_obstruction.2.2 h

end UpperRay
end D10Topology.Ch07
