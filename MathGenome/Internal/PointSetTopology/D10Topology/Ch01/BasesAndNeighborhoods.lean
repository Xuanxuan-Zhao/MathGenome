import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch01.BasesAndNeighborhoods
import MathGenome.Internal.PointSetTopology.D10Topology.Ch01.TopologicalFoundations

/-!
Bases, subbases, neighborhoods and local bases (paper.tex, Chapter 1).
The predicates below use open witnesses and unions of basis members,
with independent value specifications in the Spec module. The first bridge below justifies using Mathlib's basis API.
No nonemptiness, separation, or covering assumption on a subbasis is added.
-/

open Set
open scoped Topology
universe u

namespace D10Topology.Ch01

/-- The paper's basis formulation: open members, with every open set a union
of members. It is bridged to Mathlib's basis interface by the implementation. -/
def BasisFor {X : Type u} (t : TopologicalSpace X) (B : Set (Set X)) : Prop :=
  (∀ V ∈ B, IsOpen[t] V) ∧
    ∀ U : Set X, IsOpen[t] U → ∃ A : Set (Set X), A ⊆ B ∧ U = ⋃₀ A

/-- Covering and local refinement of pairwise intersections. -/
def BasisCriterion {X : Type u} (B : Set (Set X)) : Prop :=
  (⋃₀ B = univ) ∧
    ∀ V ∈ B, ∀ W ∈ B, ∀ x ∈ V ∩ W, ∃ Z ∈ B, x ∈ Z ∧ Z ⊆ V ∩ W

/-- Finite subfamilies include the empty subfamily, whose intersection is X. -/
def finiteIntersections {X : Type u} (S : Set (Set X)) : Set (Set X) :=
  (fun F : Set (Set X) => ⋂₀ F) '' {F | F.Finite ∧ F ⊆ S}

/-- An open witness inside a neighborhood; there is no openness requirement on N. -/
def Neighborhood {X : Type u} (t : TopologicalSpace X) (x : X) (N : Set X) : Prop :=
  ∃ U : Set X, IsOpen[t] U ∧ x ∈ U ∧ U ⊆ N

/-- A subfamily of neighborhoods refining every neighborhood. -/
def LocalBase {X : Type u} (t : TopologicalSpace X) (x : X)
    (L : Set (Set X)) : Prop :=
  (∀ V ∈ L, Neighborhood t x V) ∧
    ∀ N : Set X, Neighborhood t x N → ∃ V ∈ L, V ⊆ N

/-- Equivalence of the paper's union formulation with the library interface. -/
theorem basis_iff_mathlib {X : Type u} (t : TopologicalSpace X) (B : Set (Set X)) :
    BasisFor t B ↔ TopologicalSpace.IsTopologicalBasis (t := t) B := by
  let := t
  constructor
  · intro h
    apply TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds h.1
    intro x U hx hU
    obtain ⟨A, hAB, hUA⟩ := h.2 U hU
    have hxA : x ∈ ⋃₀ A := hUA ▸ hx
    obtain ⟨V, hVA, hxV⟩ := hxA
    refine ⟨V, hAB hVA, hxV, ?_⟩
    rw [hUA]
    exact subset_sUnion_of_mem hVA
  · intro h
    exact ⟨fun _ hV => h.isOpen hV, fun _ hU => h.open_eq_sUnion hU⟩

/-- The two set-theoretic criteria construct the topology generated by B. -/
theorem basis_generated {X : Type u} (B : Set (Set X)) (h : BasisCriterion B) :
    BasisFor (TopologicalSpace.generateFrom B) B := by
  let := TopologicalSpace.generateFrom B
  apply (basis_iff_mathlib _ _).mpr
  exact ⟨h.2, h.1, rfl⟩

theorem basis_criterion {X : Type u} (B : Set (Set X)) :
    (∃ t : TopologicalSpace X, BasisFor t B) ↔ BasisCriterion B := by
  constructor
  · rintro ⟨t, h⟩
    have hb := (basis_iff_mathlib t B).mp h
    exact ⟨hb.sUnion_eq, hb.exists_subset_inter⟩
  · intro h
    exact ⟨TopologicalSpace.generateFrom B, basis_generated B h⟩

theorem basis_open_iff_union {X : Type u} (t : TopologicalSpace X) (B : Set (Set X))
    (h : BasisFor t B) (U : Set X) :
    IsOpen[t] U ↔ ∃ A : Set (Set X), A ⊆ B ∧ U = ⋃₀ A := by
  let := t
  constructor
  · exact h.2 U
  · rintro ⟨A, hAB, rfl⟩
    exact isOpen_sUnion fun V hV => h.1 V (hAB hV)

theorem generated_basis_opens {X : Type u} (B : Set (Set X)) (h : BasisCriterion B)
    (U : Set X) :
    IsOpen[TopologicalSpace.generateFrom B] U ↔
      ∃ A : Set (Set X), A ⊆ B ∧ U = ⋃₀ A :=
  basis_open_iff_union _ B (basis_generated B h) U

/-- Inclusion of open families has the paper's direction, regardless of the
reverse order used internally for TopologicalSpace. -/
theorem basis_comparison {X : Type u} (t s : TopologicalSpace X) (B C : Set (Set X))
    (hB : BasisFor t B) (hC : BasisFor s C) :
    (openSets t ⊆ openSets s ↔
      ∀ V ∈ B, ∀ x ∈ V, ∃ W ∈ C, x ∈ W ∧ W ⊆ V) := by
  let := s
  have hc := (basis_iff_mathlib s C).mp hC
  constructor
  · intro h V hV x hx
    exact hc.isOpen_iff.mp (h (hB.1 V hV)) x hx
  · intro h U hU
    obtain ⟨A, hAB, rfl⟩ := hB.2 U hU
    apply isOpen_sUnion
    intro V hV
    exact hc.isOpen_iff.mpr (h V (hAB hV))

/-- All finite intersections, including X itself, are a basis without
requiring S to cover X. -/
theorem finiteIntersections_basis {X : Type u} (S : Set (Set X)) :
    BasisFor (TopologicalSpace.generateFrom S) (finiteIntersections S) := by
  let := TopologicalSpace.generateFrom S
  apply (basis_iff_mathlib _ _).mpr
  exact TopologicalSpace.isTopologicalBasis_of_subbasis rfl

theorem finiteIntersections_empty {X : Type u} (S : Set (Set X)) :
    univ ∈ finiteIntersections S := by
  exact ⟨∅, ⟨finite_empty, empty_subset S⟩, sInter_empty⟩

theorem subbasis_generated_eq {X : Type u} (S : Set (Set X)) :
    TopologicalSpace.generateFrom (finiteIntersections S) = TopologicalSpace.generateFrom S := by
  let := TopologicalSpace.generateFrom S
  exact ((basis_iff_mathlib _ _).mp (finiteIntersections_basis S)).eq_generateFrom.symm

theorem subbasis_smallest {X : Type u} (S : Set (Set X)) :
    S ⊆ openSets (TopologicalSpace.generateFrom S) ∧
      ∀ t : TopologicalSpace X, S ⊆ openSets t →
        openSets (TopologicalSpace.generateFrom S) ⊆ openSets t :=
  generated_smallest S

theorem subbasis_opens {X : Type u} (S : Set (Set X)) (U : Set X) :
    IsOpen[TopologicalSpace.generateFrom S] U ↔
      ∃ A : Set (Set X), A ⊆ finiteIntersections S ∧ U = ⋃₀ A :=
  basis_open_iff_union _ _ (finiteIntersections_basis S) U

/-- This verifies the witness formulation before using the neighborhood filter. -/
theorem neighborhood_iff_mem_nhds {X : Type u} (t : TopologicalSpace X)
    (x : X) (N : Set X) : Neighborhood t x N ↔ N ∈ @nhds X t x := by
  let := t
  constructor
  · rintro ⟨U, hU, hx, hUN⟩
    exact mem_nhds_iff.mpr ⟨U, hUN, hU, hx⟩
  · intro h
    obtain ⟨U, hUN, hU, hx⟩ := mem_nhds_iff.mp h
    exact ⟨U, hU, hx, hUN⟩

theorem neighborhood_contains {X : Type u} (t : TopologicalSpace X)
    (x : X) (N : Set X) (h : Neighborhood t x N) : x ∈ N := by
  obtain ⟨U, _, hx, hUN⟩ := h
  exact hUN hx

theorem neighborhood_mono {X : Type u} (t : TopologicalSpace X)
    (x : X) (N M : Set X) (h : Neighborhood t x N) (hNM : N ⊆ M) :
    Neighborhood t x M := by
  obtain ⟨U, hU, hx, hUN⟩ := h
  exact ⟨U, hU, hx, hUN.trans hNM⟩

theorem neighborhood_univ {X : Type u} (t : TopologicalSpace X) (x : X) :
    Neighborhood t x univ := by
  let := t
  exact ⟨univ, isOpen_univ, mem_univ x, Subset.rfl⟩

theorem neighborhood_inter {X : Type u} (t : TopologicalSpace X)
    (x : X) (N M : Set X) (hN : Neighborhood t x N) (hM : Neighborhood t x M) :
    Neighborhood t x (N ∩ M) := by
  let := t
  obtain ⟨U, hU, hxU, hUN⟩ := hN
  obtain ⟨V, hV, hxV, hVM⟩ := hM
  exact ⟨U ∩ V, hU.inter hV, ⟨hxU, hxV⟩, inter_subset_inter hUN hVM⟩

theorem neighborhood_finite_inter {X : Type u} (t : TopologicalSpace X)
    (x : X) (A : Set (Set X)) (hA : A.Finite)
    (h : ∀ N ∈ A, Neighborhood t x N) : Neighborhood t x (⋂₀ A) := by
  induction A, hA using Set.Finite.induction_on with
  | empty => simpa using neighborhood_univ t x
  | @insert N A hNA hfin ih =>
    rw [sInter_insert]
    apply neighborhood_inter t x
    · exact h N (mem_insert N A)
    · exact ih (fun M hM => h M (mem_insert_of_mem N hM))

theorem open_iff_neighborhood {X : Type u} (t : TopologicalSpace X) (G : Set X) :
    IsOpen[t] G ↔ ∀ x ∈ G, Neighborhood t x G := by
  let := t
  simp only [neighborhood_iff_mem_nhds]
  exact isOpen_iff_mem_nhds

/-- Local bases may contain nonopen neighborhoods. The filter-basis interface
has exactly the same content, with no extra separation or nonemptiness premise. -/
theorem localBase_iff_hasBasis {X : Type u} (t : TopologicalSpace X)
    (x : X) (L : Set (Set X)) :
    LocalBase t x L ↔ (@nhds X t x).HasBasis (fun V : Set X => V ∈ L) id := by
  let := t
  constructor
  · intro h
    refine ⟨fun N => ?_⟩
    constructor
    · intro hN
      exact h.2 N ((neighborhood_iff_mem_nhds t x N).mpr hN)
    · rintro ⟨V, hVL, hVN⟩
      exact (neighborhood_iff_mem_nhds t x N).mp
        (neighborhood_mono t x V N (h.1 V hVL) hVN)
  · intro h
    constructor
    · intro V hV
      exact (neighborhood_iff_mem_nhds t x V).mpr (h.mem_of_mem hV)
    · intro N hN
      exact h.mem_iff.mp ((neighborhood_iff_mem_nhds t x N).mp hN)

theorem basis_localBase {X : Type u} (t : TopologicalSpace X) (B : Set (Set X))
    (h : BasisFor t B) (x : X) : LocalBase t x {V ∈ B | x ∈ V} := by
  apply (localBase_iff_hasBasis t x _).mpr
  exact ((basis_iff_mathlib t B).mp h).nhds_hasBasis

end D10Topology.Ch01
