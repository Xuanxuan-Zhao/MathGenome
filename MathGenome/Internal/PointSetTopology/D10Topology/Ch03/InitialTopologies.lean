import MathGenome.Internal.PointSetTopology.Specs.D10Topology.Ch03.InitialTopologies
import MathGenome.Internal.PointSetTopology.D10Topology.Ch01.BasesAndNeighborhoods
import MathGenome.Internal.PointSetTopology.D10Topology.Ch02.ContinuityTests

/-!
Initial topologies, paper.tex, `d10:03:initial`.
Generate the topology from all inverse images of target opens. The
generated-topology minimality theorem proves coarseness in terms of opens;
the subbasis continuity test proves its universal mapping property.
All families and spaces may be empty.
-/

open Set
open scoped Topology
universe u v w z

namespace D10Topology.Ch03
open D10Topology.Ch01

/-- All inverse images of target opens, with no covering assumption. -/
def initialSubbasis {X : Type u} {I : Type v} {Y : I → Type w}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) : Set (Set X) :=
  {U | ∃ i V, IsOpen[tY i] V ∧ U = f i ⁻¹' V}

/-- The topology on the given type X generated by those inverse images. -/
@[instance_reducible] def initialTopology {X : Type u} {I : Type v} {Y : I → Type w}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) : TopologicalSpace X :=
  TopologicalSpace.generateFrom (initialSubbasis tY f)

theorem initial_generated {X : Type u} {I : Type v} {Y : I → Type w}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) :
    initialTopology tY f =
      TopologicalSpace.generateFrom {U | ∃ i V, IsOpen[tY i] V ∧ U = f i ⁻¹' V} := rfl

theorem initial_maps_continuous {X : Type u} {I : Type v} {Y : I → Type w}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) (i : I) :
    Continuous[initialTopology tY f, tY i] (f i) := by
  apply continuous_def.mpr
  intro V hV
  exact (generated_smallest (initialSubbasis tY f)).1 ⟨i, V, hV, rfl⟩

/-- Every topology making all fᵢ continuous contains all initial opens. -/
theorem initial_coarsest {X : Type u} {I : Type v} {Y : I → Type w}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i)
    (τ : TopologicalSpace X) (hτ : ∀ i, Continuous[τ, tY i] (f i)) :
    openSets (initialTopology tY f) ⊆ openSets τ := by
  apply (generated_smallest (initialSubbasis tY f)).2 τ
  rintro U ⟨i, V, hV, rfl⟩
  exact (hτ i).isOpen_preimage V hV

/-- The universal property holds for every topological domain Z. -/
theorem continuous_initial_iff {X : Type u} {I : Type v} {Y : I → Type w} {Z : Type z}
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i)
    (tZ : TopologicalSpace Z) (g : Z → X) :
    Continuous[tZ, initialTopology tY f] g ↔
      ∀ i, Continuous[tZ, tY i] (f i ∘ g) := by
  constructor
  · intro hg i
    letI : TopologicalSpace X := initialTopology tY f
    exact (initial_maps_continuous tY f i).comp hg
  · intro h
    apply continuous_generateFrom_iff.mpr
    rintro U ⟨i, V, hV, rfl⟩
    exact (h i).isOpen_preimage V hV

theorem initialSubbasis_empty {X : Type u} {I : Type v} {Y : I → Type w} [IsEmpty I]
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) :
    initialSubbasis tY f = ∅ := by
  apply Set.eq_empty_iff_forall_notMem.mpr
  rintro U ⟨i, _⟩
  exact isEmptyElim i

theorem initial_empty {X : Type u} {I : Type v} {Y : I → Type w} [IsEmpty I]
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) :
    initialTopology tY f = ⊤ := by
  apply le_antisymm le_top
  exact initial_coarsest tY f ⊤ (fun i => isEmptyElim i)

/-- This identifies ⊤ as the paper's indiscrete open family, including X = ∅. -/
theorem initial_empty_opens {X : Type u} {I : Type v} {Y : I → Type w} [IsEmpty I]
    (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i) :
    openSets (initialTopology tY f) = {∅, univ} := by
  rw [initial_empty tY f]
  exact indiscrete_opens X

theorem continuous_initial_empty {X : Type u} {I : Type v} {Y : I → Type w} {Z : Type z}
    [IsEmpty I] (tY : ∀ i, TopologicalSpace (Y i)) (f : ∀ i, X → Y i)
    (tZ : TopologicalSpace Z) (g : Z → X) :
    Continuous[tZ, initialTopology tY f] g := by
  exact (continuous_initial_iff tY f tZ g).mpr (fun i => isEmptyElim i)

end D10Topology.Ch03
