import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.CSA.MaximalSubfield
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.CSA.ReducedNorm
import MathGenome.Internal.Specs.D07.Ch23.QuaternionAlgebra
import Mathlib.RingTheory.Adjoin.Basic

/-! The complex splitting and reduced norm in RM03-C04.12. -/

namespace Specs.RM03.Brauer.QuaternionSplitting

open scoped TensorProduct
open Specs.D07.Ch23.QuaternionAlgebra (H iH jH kH)

def HamiltonCentralDivision : Prop :=
  CSA.isCentralDivision ℝ H

/-- The complex embedding has image exactly the real algebra generated by the first unit. -/
def ComplexSubfield : Prop :=
  ∃ f : ℂ →ₐ[ℝ] H,
    (∀ z : ℂ, f z = ⟨z.re, z.im, 0, 0⟩) ∧
    Function.Injective f ∧
    f.range = Algebra.adjoin ℝ ({iH} : Set H) ∧
    Module.finrank ℝ f.range = 2 ∧
    ∃ h : CSA.isMaximalSubfield f.range,
      letI := h.1.toField
      Nonempty (CSA.baseChange ℝ f.range H ≃ₐ[f.range]
        Matrix (Fin 2) (Fin 2) f.range)

/-- A single complex splitting realizes both specified matrices and the norm formula. -/
def ComplexSplitting : Prop :=
  ∃ e : CSA.baseChange ℝ ℂ H ≃ₐ[ℂ] Matrix (Fin 2) (Fin 2) ℂ,
    e (1 ⊗ₜ[ℝ] iH) = !![Complex.I, 0; 0, -Complex.I] ∧
    e (1 ⊗ₜ[ℝ] jH) = !![0, 1; -1, 0] ∧
    ∀ a b c d : ℝ,
      (e (1 ⊗ₜ[ℝ] ((a : H) + b • iH + c • jH + d • kH))).det =
        ((a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2 : ℝ) : ℂ)

def ReducedNorm : Prop :=
  ∀ (h : CSA.isCentralSimple ℝ H) (a b c d : ℝ),
    CSA.reducedNorm h ((a : H) + b • iH + c • jH + d • kH) =
      a ^ 2 + b ^ 2 + c ^ 2 + d ^ 2

end Specs.RM03.Brauer.QuaternionSplitting
