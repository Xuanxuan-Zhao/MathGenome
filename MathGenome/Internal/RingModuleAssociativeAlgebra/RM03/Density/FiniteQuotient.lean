import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Density.Action
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Topology.Constructions

universe u v

namespace RM03.Density

variable (R : Type u) (M : Type v) [Ring R] [AddCommGroup M] [Module R M]

/-- Pointwise convergence on the discrete underlying module. -/
@[instance_reducible]
def finiteTopology : TopologicalSpace (RightEnd R M) :=
  letI : TopologicalSpace M := ⊥
  TopologicalSpace.induced (fun T : RightEnd R M ↦ (T : M → M)) inferInstance

/-- Neighborhoods are generated by agreement on finite sets of vectors. -/
theorem finiteTopology_nhds_basis (T : RightEnd R M) :
    letI : TopologicalSpace (RightEnd R M) := finiteTopology R M
    (nhds T).HasBasis Set.Finite (fun S : Set M ↦ {F | ∀ m ∈ S, F m = T m}) := by
  let : TopologicalSpace M := ⊥
  let : DiscreteTopology M := ⟨rfl⟩
  let coeFn : RightEnd R M → (M → M) := fun F ↦ F
  change (@nhds _ (TopologicalSpace.induced coeFn inferInstance) T).HasBasis _ _
  rw [nhds_induced, nhds_pi]
  simp only [nhds_discrete]
  exact (Filter.hasBasis_pi_pure (coeFn T)).comap coeFn

variable [IsSimpleModule R M]

/-- A single scalar agrees with the given endomorphism on the entire finite set. -/
theorem action_agrees_on_finite (T : RightEnd R M) (S : Set M) (hS : S.Finite) :
    ∃ r : R, ∀ m ∈ S, action R M r m = T m := by
  obtain ⟨r, hr⟩ := jacobson_density T hS.toFinset
  exact ⟨r, fun m hm ↦ (hr m (hS.mem_toFinset.mpr hm)).symm⟩

theorem action_dense :
    letI : TopologicalSpace (RightEnd R M) := finiteTopology R M
    Dense (Set.range (action R M)) := by
  let : TopologicalSpace (RightEnd R M) := finiteTopology R M
  intro T
  apply (mem_closure_iff_nhds_basis (finiteTopology_nhds_basis R M T)).mpr
  intro S hS
  obtain ⟨r, hr⟩ := action_agrees_on_finite R M T S hS
  exact ⟨action R M r, ⟨r, rfl⟩, hr⟩

variable [Module.Finite (Module.End R M) M]

theorem action_surjective_of_finite : Function.Surjective (action R M) :=
  Module.Finite.toModuleEnd_moduleEnd_surjective

/-- The induced equivalence carries the class of a scalar to its action. -/
theorem quotient_action_isomorphism :
    ∃ e : (R ⧸ Module.annihilator R M) ≃+* RightEnd R M,
      ∀ r : R, e (Ideal.Quotient.mk (Module.annihilator R M) r) = action R M r := by
  refine ⟨(Ideal.quotEquivOfEq (action_ker R M).symm).trans
    ((action R M).quotientKerEquivOfSurjective (action_surjective_of_finite R M)), ?_⟩
  intro r
  simp

end RM03.Density
