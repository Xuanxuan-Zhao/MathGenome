import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Morita.Corner
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.Morita.ProductCorner
import Mathlib.RingTheory.TwoSidedIdeal.Kernel

/-! The corner of `A × B` at `(1, 0)` sees the first factor and kills the second. -/

universe u v

namespace RM03.Morita

open CategoryTheory CategoryTheory.Limits MulOpposite

/-- The first projection identifies the corner ring with `A`. -/
theorem product_corner_equiv : ProductCornerSpec.cornerEquivType.{u, v} := by
  intro A B _ _ _ _
  refine ⟨{
    toFun := fun x => x.val.1
    invFun := fun a => ⟨(a, 0), by
      change ((1 * a, (0 : B) * 0) = (a, 0)) ∧ ((a * 1, (0 : B) * 0) = (a, 0))
      simp⟩
    left_inv := fun x => by
      apply Subtype.ext
      refine Prod.ext rfl ?_
      have hx := congrArg Prod.snd x.property.1
      change (0 : B) * x.val.2 = x.val.2 at hx
      simpa only [zero_mul] using hx
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl }, fun _ => rfl, fun _ => rfl⟩

/-- The two-sided ideal generated by `(1, 0)` is `A × 0` and is proper. -/
theorem product_corner_ideal : ProductCornerSpec.idealType.{u, v} := by
  intro A B _ _ _ _
  let e := productIdempotent A B
  let I := TwoSidedIdeal.span ({e.val} : Set (A × B))
  have he : e.val ∈ I := TwoSidedIdeal.subset_span (Set.mem_singleton _)
  have hI : I = TwoSidedIdeal.ker (RingHom.snd A B) := by
    apply le_antisymm
    · apply TwoSidedIdeal.span_le.mpr
      intro x hx
      change x ∈ TwoSidedIdeal.ker (RingHom.snd A B)
      rw [Set.mem_singleton_iff.mp hx, TwoSidedIdeal.mem_ker]
      rfl
    · intro x hx
      have hx₂ : x.2 = 0 := (TwoSidedIdeal.mem_ker (RingHom.snd A B)).mp hx
      have hxe : x * e.val = x := Prod.ext (mul_one x.1) (by
        change x.2 * 0 = x.2
        rw [mul_zero, hx₂])
      exact hxe ▸ I.mul_mem_left x e.val he
  change (I : Set (A × B)) = Set.univ ×ˢ ({0} : Set B) ∧ I ≠ ⊤
  constructor
  · ext x
    rw [SetLike.mem_coe, hI, TwoSidedIdeal.mem_ker]
    simp
  · intro hTop
    have hOne : (1 : A × B) ∈ I := TwoSidedIdeal.one_mem I hTop
    rw [hI, TwoSidedIdeal.mem_ker] at hOne
    exact (one_ne_zero : (1 : B) ≠ 0) hOne

/-- The corner functor kills the nonzero right module obtained from `B`. -/
theorem product_corner_functor : ProductCornerSpec.functorType.{u, v} := by
  intro A B _ _ _ _
  let e := productIdempotent A B
  let M := productRightModule A B
  let F : ModuleCat.{v} (A × B)ᵐᵒᵖ ⥤ ModuleCat.{v} (Corner e)ᵐᵒᵖ := cornerFunctor e
  change Nontrivial M ∧ (∀ b : M, op e.val • b = 0) ∧ IsZero (F.obj M) ∧ ¬ F.IsEquivalence
  have hNontrivial : Nontrivial M := ‹Nontrivial B›
  have hAction (b : M) : op e.val • b = 0 := by
    let x : B := b
    change x * 0 = 0
    exact mul_zero x
  have hZero : IsZero (F.obj M) := by
    let : Subsingleton (F.obj M) := subsingleton_of_forall_eq 0 fun b => by
      apply Subtype.ext
      exact b.property.symm.trans (hAction b.val)
    exact ModuleCat.isZero_of_subsingleton _
  refine ⟨hNontrivial, hAction, hZero, fun hF => ?_⟩
  let : F.Faithful := hF.faithful
  have hId : 𝟙 M = (0 : M ⟶ M) := F.map_injective (hZero.eq_of_src _ _)
  have hSub := ModuleCat.subsingleton_of_isZero ((IsZero.iff_id_eq_zero M).mpr hId)
  exact (one_ne_zero : (1 : B) ≠ 0) (hSub.elim (1 : B) 0)

end RM03.Morita
