import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Quivers.PathAlgebra
import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Quivers.Representations
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.Quivers.Relations
import Mathlib.RingTheory.TwoSidedIdeal.BigOperators

/-! Quiver relations, generation of two-sided ideals by relations, and admissibility. -/

open scoped BigOperators

universe u v w d

namespace RM03

/-- Finite coefficients on the paths from `i` to `j`, including the trivial path for `i = j`. -/
abbrev QuiverRelation (k : Type w) [Zero k] {Q : Type u} [Quiver.{v} Q] (i j : Q) :=
  QuiverRelationSpec.Coefficients k i j

namespace QuiverRelation

variable {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q]

/-- A relation with its source and target recorded. -/
abbrev Bundled (k : Type w) [Zero k] (Q : Type u) [Quiver.{v} Q] :=
  QuiverRelationSpec.Bundled k Q

/-- View a relation as a linear combination in the path algebra. -/
noncomputable def toPathAlgebra (i j : Q) : QuiverRelation k i j →ₗ[k] PathAlgebra k Q :=
  Finsupp.linearCombination k (fun p : Quiver.Path i j => PathAlgebra.ofPath k (Path.ofPath p))

/-- Apply the relation's linear combination to the maps of the representation. -/
noncomputable def evaluate (F : QuiverRepresentation.{u, v, w, d} k Q) (i j : Q) :
    QuiverRelation k i j →ₗ[k] (F.vertex i →ₗ[k] F.vertex j) :=
  Finsupp.linearCombination k (fun p : Quiver.Path i j => F.mapPath p)

/-- A representation satisfies a relation when the resulting linear map is zero. -/
def Satisfies (F : QuiverRepresentation.{u, v, w, d} k Q) {i j : Q}
    (r : QuiverRelation k i j) : Prop :=
  evaluate F i j r = 0

/-- Forget the endpoints after including the relation in the path algebra. -/
noncomputable def toElement (r : Bundled k Q) : PathAlgebra k Q :=
  toPathAlgebra r.1 r.2.1 r.2.2

theorem toPathAlgebra_injective (i j : Q) :
    Function.Injective (toPathAlgebra (k := k) i j) := by
  apply linearIndependent_iff_injective_finsuppLinearCombination.mp
  simpa only [Function.comp_def, PathAlgebra.basis_apply] using
    (PathAlgebra.basis k Q).linearIndependent.comp (fun p : Quiver.Path i j => Path.ofPath p)
      (fun _ _ h => by cases h; rfl)

theorem range_toPathAlgebra (i j : Q) :
    LinearMap.range (toPathAlgebra (k := k) i j) = PathAlgebra.corner k i j := by
  rw [toPathAlgebra, Finsupp.range_linearCombination, PathAlgebra.corner_eq_span]

variable [Fintype Q]

/-- The two-sided ideal generated by any set of relations. -/
noncomputable def generatedIdeal (S : Set (Bundled k Q)) : TwoSidedIdeal (PathAlgebra k Q) :=
  TwoSidedIdeal.span (toElement '' S)

theorem generatedIdeal_le_iff (S : Set (Bundled k Q)) (I : TwoSidedIdeal (PathAlgebra k Q)) :
    generatedIdeal S ≤ I ↔ ∀ r ∈ S, toElement r ∈ I := by
  rw [generatedIdeal, TwoSidedIdeal.span_le]
  exact Set.image_subset_iff

end QuiverRelation

namespace PathAlgebra

variable {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]

theorem sum_vertex_mul_mul_vertex (x : PathAlgebra k Q) :
    (∑ i : Q, ∑ j : Q, vertex k j * x * vertex k i) = x := by
  simp only [← Finset.sum_mul, sum_vertices, one_mul, ← Finset.mul_sum, mul_one]

theorem generated_by_relations (I : TwoSidedIdeal (PathAlgebra k Q)) :
    QuiverRelation.generatedIdeal {r : QuiverRelation.Bundled k Q | QuiverRelation.toElement r ∈ I} = I := by
  apply le_antisymm ((QuiverRelation.generatedIdeal_le_iff _ _).2 fun _ hr => hr)
  intro x hx
  rw [← sum_vertex_mul_mul_vertex x]
  refine TwoSidedIdeal.finsetSum_mem _ _ _ fun i _ => ?_
  refine TwoSidedIdeal.finsetSum_mem _ _ _ fun j _ => ?_
  have hcorner : vertex k j * x * vertex k i ∈ corner k i j :=
    (mem_corner _ _ _).2 ⟨x, rfl⟩
  rw [← QuiverRelation.range_toPathAlgebra] at hcorner
  obtain ⟨r, hr⟩ := hcorner
  apply TwoSidedIdeal.subset_span
  refine ⟨⟨i, j, r⟩, ?_, hr⟩
  change QuiverRelation.toPathAlgebra i j r ∈ I
  rw [hr]
  exact I.mul_mem_right _ _ (I.mul_mem_left _ _ hx)

/-- The ideal generated by the length-one paths. -/
noncomputable def arrowIdeal (k : Type w) (Q : Type u) [Field k] [Quiver.{v} Q] [Fintype Q] :
    TwoSidedIdeal (PathAlgebra k Q) :=
  TwoSidedIdeal.span (Set.range fun a : Arrow Q => arrow k a.2.2)

/-- The ordinary power of a two-sided ideal, viewed again as a two-sided ideal. -/
noncomputable def idealPower (I : TwoSidedIdeal (PathAlgebra k Q)) (n : ℕ) :
    TwoSidedIdeal (PathAlgebra k Q) :=
  QuiverRelationSpec.spanProductPowers I n

theorem spanProductPowers_asIdeal {R : Type*} [Ring R] (I : TwoSidedIdeal R) (n : ℕ) :
    (QuiverRelationSpec.spanProductPowers I n).asIdeal = I.asIdeal ^ n := by
  induction n with
  | zero =>
    rw [QuiverRelationSpec.spanProductPowers, Submodule.pow_zero, Ideal.one_eq_top]
    exact rfl
  | succ n ih =>
    rw [QuiverRelationSpec.spanProductPowers, Submodule.pow_succ, ← ih]
    apply le_antisymm
    · rw [← Ideal.asIdeal_toTwoSided ((QuiverRelationSpec.spanProductPowers I n).asIdeal * I.asIdeal)]
      apply (TwoSidedIdeal.asIdeal (R := R)).monotone
      apply TwoSidedIdeal.span_le.mpr
      rintro z ⟨x, hx, y, hy, rfl⟩
      exact Ideal.mem_toTwoSided.mpr
        (Ideal.mul_mem_mul (TwoSidedIdeal.mem_asIdeal.mpr hx) (TwoSidedIdeal.mem_asIdeal.mpr hy))
    · apply Ideal.mul_le.mpr
      intro x hx y hy
      exact TwoSidedIdeal.subset_span ⟨x, hx, y, hy, rfl⟩

theorem idealPower_asIdeal (I : TwoSidedIdeal (PathAlgebra k Q)) (n : ℕ) :
    (idealPower I n).asIdeal = I.asIdeal ^ n :=
  spanProductPowers_asIdeal I n

/-- Admissibility is the existence of an integer exponent at least two giving the two
containments with powers of the arrow ideal. -/
def IsAdmissible (I : TwoSidedIdeal (PathAlgebra k Q)) : Prop :=
  ∃ m : ℤ, 2 ≤ m ∧ idealPower (arrowIdeal k Q) m.toNat ≤ I ∧ I ≤ idealPower (arrowIdeal k Q) 2

theorem isAdmissible_iff (I : TwoSidedIdeal (PathAlgebra k Q)) :
    IsAdmissible I ↔
      ∃ m : ℤ, 2 ≤ m ∧ (arrowIdeal k Q).asIdeal ^ m.toNat ≤ I.asIdeal ∧
        I.asIdeal ≤ (arrowIdeal k Q).asIdeal ^ 2 := by
  simp only [IsAdmissible, ← idealPower_asIdeal]
  rfl

end PathAlgebra
end RM03
