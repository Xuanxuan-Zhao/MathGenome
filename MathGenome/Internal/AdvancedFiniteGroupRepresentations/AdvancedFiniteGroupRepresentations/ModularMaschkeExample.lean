import MathGenome.Internal.AdvancedFiniteGroupRepresentations.Specs.AdvancedFiniteGroupRepresentations.ModularMaschkeExample

namespace AdvancedFiniteGroupRepresentations.ModularMaschke

lemma group_elements : ∀ g : G, g = 1 ∨ g = s := by decide

lemma s_ne_one : s ≠ 1 := by decide

lemma generator_apply (g : G) : (eOne + eSwap) g = 1 := by
  rcases group_elements g with rfl | rfl <;>
    simp [eOne, eSwap, s_ne_one, Ne.symm s_ne_one]

lemma swap_one : regular s eOne = eSwap := by
  funext g
  rcases group_elements g with rfl | rfl <;>
    simp [regular, eOne, eSwap, s, Equiv.swap_mul_self]

lemma swap_swap : regular s eSwap = eOne := by
  funext g
  rcases group_elements g with rfl | rfl <;>
    simp [regular, eOne, eSwap, s, Equiv.swap_mul_self]

theorem concrete_model : ModelStatement := by
  refine ⟨group_elements, ?_, ?_, swap_one, swap_swap, ?_⟩
  · simp [eOne, groupBasis, Pi.basisFun_apply]
  · simp [eSwap, groupBasis, Pi.basisFun_apply]
  · intro h
    have := congrFun h 1
    rw [generator_apply] at this
    exact one_ne_zero this

lemma mem_invariants_iff_constant (v : V) :
    v ∈ regular.invariants ↔ ∀ g, v g = v 1 := by
  constructor
  · intro hv g
    have h := congrFun (hv g⁻¹) 1
    simpa [regular] using h
  · intro hv g
    funext h
    change v (g⁻¹ * h) = v h
    exact (hv _).trans (hv _).symm

/-- The fixed space is exactly the line generated by the sum of the group basis. -/
theorem fixed_space : FixedSpaceStatement := by
  change regular.invariants = fixedLine
  ext v
  rw [mem_invariants_iff_constant, fixedLine, Submodule.mem_span_singleton]
  constructor
  · intro hv
    refine ⟨v 1, ?_⟩
    funext g
    simp only [Pi.smul_apply, smul_eq_mul, generator_apply, mul_one]
    exact (hv g).symm
  · rintro ⟨a, rfl⟩ g
    simp only [Pi.smul_apply, smul_eq_mul, generator_apply]

lemma s_sq : s * s = 1 := by simp [s]

lemma trace_mem_invariants (v : V) : v + regular s v ∈ regular.invariants := by
  intro g
  rcases group_elements g with rfl | rfl
  · simp
  · have hinvol : regular s (regular s v) = v := by
      change (regular s * regular s) v = v
      rw [← map_mul, s_sq, map_one]
      rfl
    simp only [map_add, hinvol, add_comm]

lemma char_two_cancel : ∀ a b : K, a + b = 0 → a = b := by decide

/-- An invariant subspace disjoint from the fixed line must itself be zero. -/
lemma invariant_disjoint_eq_bot (U : Submodule K V) (hU : IsInvariant U)
    (hd : Disjoint fixedLine U) : U = ⊥ := by
  apply (Submodule.eq_bot_iff U).mpr
  intro v hv
  have htU : v + regular s v ∈ U := U.add_mem hv (hU s v hv)
  have htL : v + regular s v ∈ fixedLine := by
    rw [← fixed_space]
    exact trace_mem_invariants v
  have ht0 := Submodule.disjoint_def.mp hd _ htL htU
  have hsv : regular s v = v := by
    funext g
    exact (char_two_cancel _ _ (congrFun ht0 g)).symm
  have hvL : v ∈ fixedLine := by
    rw [← fixed_space]
    intro g
    rcases group_elements g with rfl | rfl
    · simp
    · exact hsv
  exact Submodule.disjoint_def.mp hd v hvL hv

/-- The fixed line has no invariant linear complement over F₂. -/
theorem no_invariant_complement : NoComplementStatement := by
  rintro ⟨U, hU, hcompl⟩
  have hzero := invariant_disjoint_eq_bot U hU hcompl.disjoint
  have htop : fixedLine = ⊤ := by
    simpa [hzero] using hcompl.sup_eq_top
  have he : eOne ∈ regular.invariants := by
    rw [fixed_space, htop]
    trivial
  have h := congrFun (he s) 1
  rw [swap_one] at h
  simp [eOne, eSwap, Ne.symm s_ne_one] at h

end AdvancedFiniteGroupRepresentations.ModularMaschke
