noncomputable section
open scoped BigOperators IsMulCommutative
attribute [local instance] LieRing.ofAssociativeRing
universe u v
namespace AdvancedFiniteGroupRepresentations

/-- Newton's recurrence can be evaluated in a noncommutative algebra, provided
an algebra homomorphism from the polynomial ring has already been constructed. -/
theorem evaluated_esymm_mem {ι : Type*} [Fintype ι]
    {E : Type v} [Ring E] [Algebra ℂ E]
    (f : MvPolynomial ι ℂ →ₐ[ℂ] E) (S : Subalgebra ℂ E)
    (h : ∀ k : ℕ, f (MvPolynomial.psum ι ℂ k) ∈ S) (k : ℕ) :
    f (MvPolynomial.esymm ι ℂ k) ∈ S := by
  classical
  induction k using Nat.strong_induction_on with
  | h k ih =>
    by_cases hk : k = 0
    · subst k; simpa using S.one_mem
    have hn : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hk
    have he := congrArg f (MvPolynomial.mul_esymm_eq_sum ι ℂ k)
    simp only [map_mul, map_natCast, map_pow, map_neg, map_one, map_sum] at he
    have hm : (k : ℂ) • f (MvPolynomial.esymm ι ℂ k) ∈ S := by
      rw [Algebra.smul_def]
      rw [map_natCast]
      rw [he]
      apply S.mul_mem (S.pow_mem (S.neg_mem S.one_mem) _)
      apply S.sum_mem
      intro a ha
      apply S.mul_mem
      · apply S.mul_mem (S.pow_mem (S.neg_mem S.one_mem) _)
        exact ih a.1 (Finset.mem_filter.mp ha).2
      · exact h a.2
    simpa only [smul_smul, inv_mul_cancel₀ hn, one_smul] using S.smul_mem hm (k : ℂ)⁻¹

/-- Induction on a universal enveloping algebra needs only scalars, Lie
algebra generators, sums and products; it does not require PBW. -/
theorem enveloping_induction {L : Type v} [LieRing L] [LieAlgebra ℂ L]
    {P : UniversalEnvelopingAlgebra ℂ L → Prop}
    (scalar : ∀ c, P (algebraMap ℂ (UniversalEnvelopingAlgebra ℂ L) c))
    (generator : ∀ T, P (UniversalEnvelopingAlgebra.ι ℂ T))
    (mul : ∀ a b, P a → P b → P (a * b))
    (add : ∀ a b, P a → P b → P (a + b))
    (a : UniversalEnvelopingAlgebra ℂ L) : P a := by
  obtain ⟨t, rfl⟩ : ∃ t, UniversalEnvelopingAlgebra.mkAlgHom ℂ L t = a :=
    (UniversalEnvelopingAlgebra.ringCon ℂ L).mkₐ_surjective a
  induction t using TensorAlgebra.induction with
  | algebraMap c => simpa only [AlgHom.commutes] using scalar c
  | ι T => exact generator T
  | mul a b ha hb => simpa only [map_mul] using mul _ _ ha hb
  | add a b ha hb => simpa only [map_add] using add _ _ ha hb

variable (V : Type u) [AddCommGroup V] [Module ℂ V]

/-- Taking powers in a single slot does not alter the other slots. -/
theorem tensorSlotInsertion_pow (n : ℕ) (i : Fin n) (T : Module.End ℂ V) (k : ℕ) :
    tensorSlotInsertion V n i (T ^ k) = (tensorSlotInsertion V n i T) ^ k := by
  induction k with
  | zero => simp [tensorSlotInsertion_eq_map, PiTensorProduct.map_one]
  | succ k ih => rw [pow_succ, tensorSlotInsertion_mul, ih, pow_succ]

/-- The algebra generated by the derived operators contains every diagonal
power, by Newton's identities for the commuting one-slot operators. -/
theorem operatorPower_mem_enveloping_range (n : ℕ) (T : Module.End ℂ V) :
    PiTensorProduct.map (fun _ : Fin n => T) ∈ (derivedTensorEnveloping V n).range := by
  classical
  let C := Algebra.adjoin ℂ (Set.range (fun i : Fin n => tensorSlotInsertion V n i T))
  haveI : IsMulCommutative C := Algebra.isMulCommutative_adjoin ℂ (by
    rintro a ⟨i, rfl⟩ b ⟨j, rfl⟩ _
    by_cases hij : i = j
    · subst j; exact Commute.refl _
    · exact tensorSlotInsertion_commute V n i j hij T T)
  let x : Fin n → C := fun i => ⟨tensorSlotInsertion V n i T,
    Algebra.subset_adjoin ⟨i, rfl⟩⟩
  let f : MvPolynomial (Fin n) ℂ →ₐ[ℂ] Module.End ℂ (TensorPower V n) :=
    C.val.comp (MvPolynomial.aeval x)
  have hf (i : Fin n) : f (MvPolynomial.X i) = tensorSlotInsertion V n i T := by
    simp [f, x]
  have hp (k : ℕ) : f (MvPolynomial.psum (Fin n) ℂ k) ∈
      (derivedTensorEnveloping V n).range := by
    have he : f (MvPolynomial.psum (Fin n) ℂ k) = derivedTensorOperator V n (T ^ k) := by
      simp only [MvPolynomial.psum, map_sum, map_pow, hf,
        ← tensorSlotInsertion_pow, derivedTensorOperator_eq_sum]
    rw [he]
    exact ⟨UniversalEnvelopingAlgebra.ι ℂ (T ^ k), derivedTensorEnveloping_ι V n _⟩
  have h := evaluated_esymm_mem f (derivedTensorEnveloping V n).range hp n
  have he : MvPolynomial.esymm (Fin n) ℂ n = ∏ i : Fin n, MvPolynomial.X i := by
    unfold MvPolynomial.esymm
    have hs : Finset.powersetCard n (Finset.univ : Finset (Fin n)) = {Finset.univ} := by
      simpa only [Finset.card_univ, Fintype.card_fin] using
        Finset.powersetCard_self (Finset.univ : Finset (Fin n))
    rw [hs, Finset.sum_singleton]
  rw [he] at h
  have prod_slots (s : Finset (Fin n)) :
      (∏ i ∈ s, x i).val = PiTensorProduct.map
        (fun j => if j ∈ s then T else 1) := by
    induction s using Finset.induction_on with
    | empty => simp [PiTensorProduct.map_one]
    | @insert i s hi ih =>
      rw [Finset.prod_insert hi]
      change tensorSlotInsertion V n i T * (∏ j ∈ s, x j).val = _
      rw [ih, tensorSlotInsertion_eq_map, ← PiTensorProduct.map_mul]
      congr 1
      funext j
      by_cases hji : j = i
      · subst j; simp [hi]
      · simp [Function.update_of_ne hji, hji]
  have hprod : (∏ i : Fin n, x i).val = PiTensorProduct.map (fun _ : Fin n => T) := by
    simpa using prod_slots Finset.univ
  change (MvPolynomial.aeval x (∏ i : Fin n, MvPolynomial.X i)).val ∈ _ at h
  simpa only [map_prod, MvPolynomial.aeval_X, hprod] using h

variable [FiniteDimensional ℂ V]

/-- The inclusion into B follows directly from the first centralizer theorem. -/
theorem derivedTensorEnveloping_range_le (n : ℕ) :
    (derivedTensorEnveloping V n).range ≤ tensorB V n := by
  rw [← firstCentralizer V n]
  rintro F ⟨a, rfl⟩
  intro b hb
  have h : tensorA V n ≤ Subalgebra.centralizer ℂ
      ({derivedTensorEnveloping V n a} : Set (Module.End ℂ (TensorPower V n))) := by
    apply Algebra.adjoin_le
    rintro _ ⟨s, rfl⟩ _ rfl
    exact (derivedTensorEnveloping_commute V n s a).symm
  exact ((h hb) _ rfl).symm

/-- Equality of the actual unital enveloping image and the diagonal GL span. -/
theorem derivedTensorEnveloping_range (n : ℕ) :
    (derivedTensorEnveloping V n).range = tensorB V n := by
  apply le_antisymm (derivedTensorEnveloping_range_le V n)
  apply Algebra.adjoin_le
  rintro _ ⟨g, rfl⟩
  exact operatorPower_mem_enveloping_range V n g.toLinearMap

/-- The centralizer of the enveloping-algebra action is A. -/
theorem lieSchurWeyl_centralizer (n : ℕ) :
    Subalgebra.centralizer ℂ ((derivedTensorEnveloping V n).range :
      Set (Module.End ℂ (TensorPower V n))) = tensorA V n := by
  rw [derivedTensorEnveloping_range V n, secondCentralizer V n]

/-- Stability under the infinitesimal action implies stability under the
unital enveloping action. -/
theorem multiplicity_lie_invariant_enveloping {n : ℕ} (p : Partition n)
    (W : Submodule ℂ (TensorMultiplicity V p))
    (hW : ∀ T f, f ∈ W → derivedTensorMultiplicityLieHom V p T f ∈ W)
    (a : UniversalEnvelopingAlgebra ℂ (Module.End ℂ V)) :
    ∀ f, f ∈ W → derivedTensorMultiplicityEnveloping V p a f ∈ W := by
  induction a using enveloping_induction with
  | scalar c =>
    intro f hf
    simpa only [AlgHom.commutes, Module.algebraMap_end_apply] using W.smul_mem c hf
  | generator T => simpa only [derivedTensorMultiplicityEnveloping_ι] using hW T
  | mul a b ha hb =>
    intro f hf
    simpa only [map_mul, Module.End.mul_apply] using ha _ (hb f hf)
  | add a b ha hb =>
    intro f hf
    simpa only [map_add, LinearMap.add_apply] using W.add_mem (ha f hf) (hb f hf)

/-- Every diagonal group element has an enveloping preimage which acts by
postcomposition on every canonical multiplicity space at once. -/
theorem diagonal_enveloping_preimage (n : ℕ) (g : LinearGroup V) :
    ∃ a : UniversalEnvelopingAlgebra ℂ (Module.End ℂ V),
      derivedTensorEnveloping V n a = diagonalOperator V n g ∧
      ∀ p : Partition n, derivedTensorMultiplicityEnveloping V p a =
        tensorMultiplicityOperator V p g := by
  have hg : diagonalOperator V n g ∈ (derivedTensorEnveloping V n).range := by
    rw [derivedTensorEnveloping_range V n]
    exact Algebra.subset_adjoin ⟨g, rfl⟩
  obtain ⟨a, ha⟩ := hg
  change derivedTensorEnveloping V n a = diagonalOperator V n g at ha
  refine ⟨a, ha, ?_⟩
  intro p
  ext f v
  change derivedTensorEnveloping V n a (f.val v) = diagonalOperator V n g (f.val v)
  rw [ha]

/-- Infinitesimal invariance gives group invariance on the multiplicity
spaces, without assuming the comparison of images. -/
theorem multiplicity_lie_invariant_group {n : ℕ} (p : Partition n)
    (W : Submodule ℂ (TensorMultiplicity V p))
    (hW : ∀ T f, f ∈ W → derivedTensorMultiplicityLieHom V p T f ∈ W)
    (g : LinearGroup V) (f : TensorMultiplicity V p) (hf : f ∈ W) :
    tensorMultiplicityOperator V p g f ∈ W := by
  obtain ⟨a, _, ha⟩ := diagonal_enveloping_preimage V n g
  rw [← ha p]
  exact multiplicity_lie_invariant_enveloping V p W hW a f hf

/-- The nonzero canonical multiplicity spaces are irreducible for gl(V),
expressed directly as the absence of proper invariant linear subspaces. -/
theorem tensorMultiplicity_lie_irreducible {n : ℕ} (p : Partition n)
    [Nontrivial (TensorMultiplicity V p)]
    (W : Submodule ℂ (TensorMultiplicity V p))
    (hW : ∀ T f, f ∈ W → derivedTensorMultiplicityLieHom V p T f ∈ W) :
    W = ⊥ ∨ W = ⊤ := by
  by_cases hzero : W = ⊥
  · exact Or.inl hzero
  right
  have hex : ∃ f : TensorMultiplicity V p, f ∈ W ∧ f ≠ 0 := by
    by_contra h
    apply hzero
    apply le_antisymm
    · intro f hf
      change f = 0
      by_contra hf0
      exact h ⟨f, hf, hf0⟩
    · exact bot_le
  obtain ⟨f, hf, hf0⟩ := hex
  obtain ⟨φ, hφ⟩ := Module.Projective.exists_dual_eq_one ℂ hf0
  apply top_unique
  intro y _
  have h := multiplicity_invariant_endomorphism V p W
    (multiplicity_lie_invariant_group V p W hW) (φ.smulRight y) f hf
  simpa only [LinearMap.smulRight_apply, hφ, one_smul] using h

/-- A Lie intertwiner also intertwines the enveloping action. -/
theorem multiplicity_lie_intertwiner_enveloping {n : ℕ} (p q : Partition n)
    (k : TensorMultiplicity V p →ₗ[ℂ] TensorMultiplicity V q)
    (hk : ∀ T f, k (derivedTensorMultiplicityLieHom V p T f) =
      derivedTensorMultiplicityLieHom V q T (k f))
    (a : UniversalEnvelopingAlgebra ℂ (Module.End ℂ V)) :
    ∀ f, k (derivedTensorMultiplicityEnveloping V p a f) =
      derivedTensorMultiplicityEnveloping V q a (k f) := by
  induction a using enveloping_induction with
  | scalar c => intro f; simp [Module.algebraMap_end_apply]
  | generator T => simpa only [derivedTensorMultiplicityEnveloping_ι] using hk T
  | mul a b ha hb =>
    intro f
    simp only [map_mul, Module.End.mul_apply, ha, hb]
  | add a b ha hb =>
    intro f
    simp only [map_add, LinearMap.add_apply, ha, hb]

/-- Distinct multiplicity spaces have no nonzero Lie intertwiner. -/
theorem tensorMultiplicity_lie_intertwiner_eq_zero {n : ℕ} (p q : Partition n)
    (hpq : p ≠ q) (k : TensorMultiplicity V p →ₗ[ℂ] TensorMultiplicity V q)
    (hk : ∀ T f, k (derivedTensorMultiplicityLieHom V p T f) =
      derivedTensorMultiplicityLieHom V q T (k f)) : k = 0 := by
  apply tensorMultiplicity_intertwiner_eq_zero V p q hpq k
  intro g f
  obtain ⟨a, _, ha⟩ := diagonal_enveloping_preimage V n g
  rw [← ha p, ← ha q]
  exact multiplicity_lie_intertwiner_enveloping V p q k hk a f

/-- Pairwise nonisomorphism for the Lie actions, including their actual
postcomposition formulas via the accepted construction. -/
theorem tensorMultiplicity_lie_nonisomorphic {n : ℕ} (p q : Partition n)
    [Nontrivial (TensorMultiplicity V p)] [Nontrivial (TensorMultiplicity V q)]
    (hpq : p ≠ q) :
    ¬ ∃ e : TensorMultiplicity V p ≃ₗ[ℂ] TensorMultiplicity V q,
      ∀ T f, e (derivedTensorMultiplicityLieHom V p T f) =
        derivedTensorMultiplicityLieHom V q T (e f) := by
  rintro ⟨e, he⟩
  have hz := tensorMultiplicity_lie_intertwiner_eq_zero V p q hpq e.toLinearMap he
  obtain ⟨f, hf⟩ := exists_ne (0 : TensorMultiplicity V p)
  apply hf
  apply e.injective
  simpa using DFunLike.congr_fun hz f

/-- The unital image in degree zero is precisely the scalar algebra. -/
theorem lieSchurWeyl_zero_scalar_image : (derivedTensorEnveloping V 0).range = ⊥ :=
  derivedTensor_zero_scalar_image V _

/-- For a zero-dimensional input in positive degree, the representation space
and its endomorphism algebra are zero. -/
theorem lieSchurWeyl_zero_dimension (n : ℕ) (hn : 0 < n)
    (hd : Module.finrank ℂ V = 0) :
    (derivedTensorEnveloping V n).range = ⊥ ∧
      (0 : Module.End ℂ (TensorPower V n)) = 1 := by
  letI := tensorPower_zero_dimension V n hn hd
  constructor
  · apply le_antisymm _ bot_le
    intro F _
    rw [Subsingleton.elim F 0]
    exact Subalgebra.zero_mem _
  · exact tensorEnd_zero_dimension V n hn hd

/-- The full Lie Schur–Weyl comparison for the specified unital extension and
the canonical multiplicity spaces, with all boundary cases retained. -/
theorem lieSchurWeyl : Specs.AdvancedFiniteGroupRepresentations.lieSchurWeylType.{u} := by
  intro V _ _ _ n
  refine ⟨derivedTensorEnveloping V n, fun p => derivedTensorMultiplicityLieHom V p,
    derivedTensorEnveloping_ι V n, derivedTensorEnveloping_range V n,
    lieSchurWeyl_centralizer V n, derivedTensorMultiplicityLieHom_apply V, ?_, ?_, ?_, ?_, ?_⟩
  · intro p hp W hW
    letI := hp
    exact tensorMultiplicity_lie_irreducible V p W hW
  · intro p q hpq k hk
    exact tensorMultiplicity_lie_intertwiner_eq_zero V p q hpq k hk
  · intro p q hp hq hpq
    letI := hp
    letI := hq
    exact tensorMultiplicity_lie_nonisomorphic V p q hpq
  · intro hn
    subst n
    exact lieSchurWeyl_zero_scalar_image V
  · exact lieSchurWeyl_zero_dimension V n

end AdvancedFiniteGroupRepresentations
