import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
import Mathlib.LinearAlgebra.TensorAlgebra.ToTensorPower
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.RingTheory.TwoSidedIdeal.Operations

namespace Specs.Alg01SymmetricWitt.Symmetric.Algebra

universe u v

section
variable (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]

/-- The two-sided ideal of the tensor algebra generated by the degree-two commutators. -/
def commutatorIdeal : TwoSidedIdeal (TensorAlgebra R M) :=
  TwoSidedIdeal.span (Set.range fun p : M × M =>
    TensorAlgebra.ι R p.1 * TensorAlgebra.ι R p.2 -
      TensorAlgebra.ι R p.2 * TensorAlgebra.ι R p.1)

/-- The tensor-to-symmetric-algebra map on one tensor degree. -/
def degreeMap (n : ℕ) : TensorPower R n M →ₗ[R] SymmetricAlgebra R M :=
  (SymmetricAlgebra.algHom R M).toLinearMap.comp (TensorPower.toTensorAlgebra (n := n))

/-- The image of the nth tensor power under the canonical algebra quotient. -/
def degree (n : ℕ) : Submodule R (SymmetricAlgebra R M) :=
  LinearMap.range (degreeMap R M n)

/-- The pure-product map taking values in the nth symmetric degree. -/
def pureProduct (n : ℕ) : MultilinearMap R (fun _ : Fin n => M) (degree R M n) :=
  ((degreeMap R M n).rangeRestrict).compMultilinearMap (PiTensorProduct.tprod R)

end

set_option linter.checkUnivs false

def commutatorIdealType :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M],
    TwoSidedIdeal (TensorAlgebra R M)

def degreeMapType :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M] (n : ℕ),
    TensorPower R n M →ₗ[R] SymmetricAlgebra R M

def degreeType :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M] (_ : ℕ),
    Submodule R (SymmetricAlgebra R M)

def pureProductType :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M] (n : ℕ),
    MultilinearMap R (fun _ : Fin n => M) (degree R M n)

def quotientKernel : Prop :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M],
    Function.Surjective (SymmetricAlgebra.algHom R M) ∧
      TwoSidedIdeal.ker (SymmetricAlgebra.algHom R M) = commutatorIdeal R M

open scoped DirectSum in
def tensorPresentation : Prop :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M],
    ∃ e : (⨁ n, TensorPower R n M) ≃ₐ[R] TensorAlgebra R M,
      ∀ (n : ℕ) (x : Fin n → M),
        e (DirectSum.of (fun n => TensorPower R n M) n (PiTensorProduct.tprod R x)) =
          TensorAlgebra.tprod R M n x

def pureProductCoe : Prop :=
  ∀ (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]
    (n : ℕ) (x : Fin n → M),
    ((pureProduct R M n x : degree R M n) : SymmetricAlgebra R M) =
      ∏ i, SymmetricAlgebra.ι R M (x i)

end Specs.Alg01SymmetricWitt.Symmetric.Algebra
