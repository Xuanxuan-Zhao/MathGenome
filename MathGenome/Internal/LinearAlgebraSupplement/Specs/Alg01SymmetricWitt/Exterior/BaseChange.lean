import Mathlib.LinearAlgebra.ExteriorPower.Basic
import Mathlib.LinearAlgebra.PiTensorProduct.Basic
import Mathlib.LinearAlgebra.TensorProduct.Tower

/-! The alternating quotient and the degreewise comparisons in ALG-01 C05. -/

open scoped TensorProduct

namespace Specs.Alg01SymmetricWitt.Exterior

universe u v w

/-- The submodule generated by pure tensors with two equal entries. -/
def repeatedTensors (R : Type u) [CommRing R] (M : Type w) [AddCommGroup M] [Module R M]
    (q : ℕ) : Submodule R (⨂[R] _ : Fin q, M) :=
  Submodule.span R
    {t | ∃ x : Fin q → M, (∃ i j, i ≠ j ∧ x i = x j) ∧
      PiTensorProduct.tprod R x = t}

/-- The actual exterior power is the tensor power modulo the repeated-entry relations. -/
def AlternatingQuotient : Prop :=
  ∀ (R : Type u) [CommRing R] (M : Type w) [AddCommGroup M] [Module R M] (q : ℕ),
    ∃ p : (⨂[R] _ : Fin q, M) →ₗ[R] ⋀[R]^q M,
      Function.Surjective p ∧ LinearMap.ker p = repeatedTensors R M q ∧
      ∀ x : Fin q → M, p (PiTensorProduct.tprod R x) = exteriorPower.ιMulti R q x

variable {R : Type u} [CommRing R] {S : Type v} [CommRing S] [Algebra R S]
variable {M : Type w} [AddCommGroup M] [Module R M]

/-- The formula on pure wedges characterizes the comparison in each degree. -/
def IsComparison {q : ℕ} (e : S ⊗[R] (⋀[R]^q M) ≃ₗ[S] ⋀[S]^q (S ⊗[R] M)) : Prop :=
  ∀ (s : S) (x : Fin q → M),
    e (s ⊗ₜ[R] exteriorPower.ιMulti R q x) =
      s • exteriorPower.ιMulti S q (fun i => (1 : S) ⊗ₜ[R] x i)

/-- All exterior degrees commute with extension along an arbitrary unital ring map.
In degree zero the comparison becomes multiplication after the identifications with the rings. -/
def ExteriorPowerComparison : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Type v) [CommRing S] (φ : R →+* S)
    (M : Type w) [AddCommGroup M] [Module R M],
    letI : Algebra R S := φ.toAlgebra
    ∃! e : ∀ q : ℕ, S ⊗[R] (⋀[R]^q M) ≃ₗ[S] ⋀[S]^q (S ⊗[R] M),
      (∀ q, IsComparison (e q)) ∧
      ∀ (s : S) (x : ⋀[R]^0 M),
        exteriorPower.zeroEquiv S (S ⊗[R] M) (e 0 (s ⊗ₜ[R] x)) =
          s * φ (exteriorPower.zeroEquiv R M x)

/-- The degree-q term of the nonnegative Koszul complex of a linear functional. -/
abbrev koszulTerm (_u : M →ₗ[R] R) (q : ℕ) : Submodule R (ExteriorAlgebra R M) :=
  ⋀[R]^q M

/-- The functional obtained by extension of scalars and the identification S ⊗ R ≃ S. -/
noncomputable def extendForm (u : M →ₗ[R] R) : S ⊗[R] M →ₗ[S] S :=
  (TensorProduct.AlgebraTensorModule.rid R S S).toLinearMap.comp (u.baseChange S)

/-- The same pure-wedge comparison identifies the terms of the two Koszul complexes. -/
def KoszulTermComparison : Prop :=
  ∀ (R : Type u) [CommRing R] (S : Type v) [CommRing S] (φ : R →+* S)
    (E : Type w) [AddCommGroup E] [Module R E] (u : E →ₗ[R] R),
    letI : Algebra R S := φ.toAlgebra
    let uS := extendForm (S := S) u
    (∀ (s : S) (x : E), uS (s ⊗ₜ[R] x) = s * φ (u x)) ∧
    ∃ e : ∀ q : ℕ, S ⊗[R] koszulTerm u q ≃ₗ[S] koszulTerm uS q,
      ∀ q, IsComparison (e q)

end Specs.Alg01SymmetricWitt.Exterior
