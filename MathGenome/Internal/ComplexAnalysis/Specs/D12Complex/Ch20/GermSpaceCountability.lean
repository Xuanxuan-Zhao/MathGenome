import MathGenome.Internal.ComplexAnalysis.Specs.D12Complex.Ch19.GermTopology

/-! The full-space assertion in paper.tex:3376–3377 (d12:20-04).
The topology is the canonical topology generated by holomorphic sections,
with no restriction to one continuation component. -/

namespace Specs.D12Complex.Ch20.GermSpaceCountability

/-- The full holomorphic germ space over the plane is not second countable. -/
def fullSpace_not_secondCountable_type : Prop :=
  ¬ SecondCountableTopology (_root_.D12Complex.GermTopology.Space (Set.univ : Set ℂ))

end Specs.D12Complex.Ch20.GermSpaceCountability
