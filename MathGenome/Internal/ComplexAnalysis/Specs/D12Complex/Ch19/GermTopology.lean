import MathGenome.Internal.ComplexAnalysis.Specs.D12Complex.Ch19.GermsContinuation
import Mathlib.Topology.Bases
import Mathlib.Topology.Homeomorph.Defs

/-! Independent statements for the germ-topology part of d12:19-02.
The fibers are the upstream quotient germs. The topology is generated by graphs
of holomorphic function elements on connected open subsets of the base. -/
open scoped Topology
noncomputable section
namespace D12Complex.GermTopology

/-- All holomorphic germs over the indicated subset of the complex plane. -/
def Space (Ω : Set ℂ) := Σ a : Ω, HolomorphicGerm (a : ℂ)

/-- Projection to the basepoint, with the base's subspace topology. -/
def projection (Ω : Set ℂ) : Space Ω → Ω := Sigma.fst

/-- Graph of an element's germs, restricted to basepoints in Ω. -/
def basicSet (Ω : Set ℂ) (e : FunctionElement) : Set (Space Ω) :=
  {p | ∃ ha : (p.1 : ℂ) ∈ e.domain, p.2 = e.germAt p.1 ha}

/-- Only elements with connected open domain contained in Ω generate the topology. -/
def basicSets (Ω : Set ℂ) : Set (Set (Space Ω)) :=
  {S | ∃ e : FunctionElement, e.domain ⊆ Ω ∧ S = basicSet Ω e}

/-- The germ topology; the basis assertion is a theorem, not part of this definition. -/
instance topology (Ω : Set ℂ) : TopologicalSpace (Space Ω) :=
  TopologicalSpace.generateFrom (basicSets Ω)

/-- The section of the projection defined by a holomorphic function element. -/
def sectionMap {Ω : Set ℂ} (e : FunctionElement) (h : e.domain ⊆ Ω) :
    e.domain → Space Ω :=
  fun z => ⟨⟨z, h z.property⟩, e.germAt z z.property⟩

/-- The lift associated with a family of germs along γ. -/
def lift {Ω : Set ℂ} (γ : unitInterval → ℂ) (hγ : ∀ t, γ t ∈ Ω)
    (Φ : GermFamily γ) : unitInterval → Space Ω :=
  fun t => ⟨⟨γ t, hγ t⟩, Φ t⟩

end D12Complex.GermTopology

namespace Specs.D12Complex.Ch19.GermTopology
open _root_.D12Complex _root_.D12Complex.GermTopology

def Space_type := Set ℂ → Type
def Space_value : Space_type := Space

def projection_type := (Ω : Set ℂ) → Space Ω → Ω
def projection_value : projection_type := projection

def basicSet_type := (Ω : Set ℂ) → FunctionElement → Set (Space Ω)
def basicSet_value : basicSet_type := basicSet

def basicSets_type := (Ω : Set ℂ) → Set (Set (Space Ω))
def basicSets_value : basicSets_type := basicSets

def topology_type := (Ω : Set ℂ) → TopologicalSpace (Space Ω)
def topology_value : topology_type := topology

def sectionMap_type := ∀ {Ω : Set ℂ} (e : FunctionElement),
  e.domain ⊆ Ω → e.domain → Space Ω
def sectionMap_value : sectionMap_type := @sectionMap

def lift_type := ∀ {Ω : Set ℂ} (γ : unitInterval → ℂ),
  (∀ t, γ t ∈ Ω) → GermFamily γ → unitInterval → Space Ω
def lift_value : lift_type := @lift

def germ_equality_persists_type : Prop :=
  ∀ (a : ℂ) (e d : FunctionElement) (he : a ∈ e.domain) (hd : a ∈ d.domain),
    e.germAt a he = d.germAt a hd →
    ∃ (W : Set ℂ) (hW : W ⊆ e.domain ∩ d.domain), IsOpen W ∧ a ∈ W ∧
      ∀ (z : ℂ) (hz : z ∈ W),
        e.germAt z (hW hz).1 = d.germAt z (hW hz).2

def isTopologicalBasis_type : Prop :=
  ∀ (Ω : Set ℂ), IsOpen Ω → TopologicalSpace.IsTopologicalBasis (basicSets Ω)

def continuous_sectionMap_type : Prop :=
  ∀ (Ω : Set ℂ) (e : FunctionElement) (h : e.domain ⊆ Ω),
    Continuous (sectionMap e h)

def continuous_projection_type : Prop :=
  ∀ (Ω : Set ℂ), IsOpen Ω → Continuous (projection Ω)

def basic_chart_type : Prop :=
  ∀ (Ω : Set ℂ) (_hΩ : IsOpen Ω) (e : FunctionElement) (_h : e.domain ⊆ Ω),
    ∃ E : basicSet Ω e ≃ₜ e.domain,
      ∀ p : basicSet Ω e, (E p : ℂ) = (p.val.1 : ℂ)

def local_projection_chart_type : Prop :=
  ∀ (Ω : Set ℂ), IsOpen Ω → ∀ p : Space Ω,
    ∃ (e : FunctionElement) (_h : e.domain ⊆ Ω),
      p ∈ basicSet Ω e ∧ IsOpen (basicSet Ω e) ∧
      ∃ E : basicSet Ω e ≃ₜ e.domain,
        ∀ q : basicSet Ω e, (E q : ℂ) = (q.val.1 : ℂ)

def locallyRepresented_iff_continuous_lift_type : Prop :=
  ∀ (Ω : Set ℂ) (_hΩ : IsOpen Ω) (γ : unitInterval → ℂ)
    (_hc : Continuous γ) (hγ : ∀ t, γ t ∈ Ω) (Φ : GermFamily γ),
    LocallyRepresented γ Φ ↔ Continuous (lift γ hγ Φ)

def isContinuation_iff_continuous_lift_type : Prop :=
  ∀ (Ω : Set ℂ) (γ : unitInterval → ℂ) (hγ : ∀ t, γ t ∈ Ω)
    (φ : HolomorphicGerm (γ 0)) (Φ : GermFamily γ),
    IsContinuation Ω γ φ Φ ↔
      IsDomain Ω ∧ Continuous γ ∧ Φ 0 = φ ∧ Continuous (lift γ hγ Φ)

end Specs.D12Complex.Ch19.GermTopology
