import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Algebra.Tower
import Mathlib.LinearAlgebra.Span.Basic

/-! Shared commutative-ring interface for HA Chapter 6 and LA Theorem A04.
No freeness, finite dimension, characteristic restriction or PBW is assumed.
Mathlib's `LieRing` includes alternation, including in characteristic two.
The quotient uses the congruence generated by `[x,y] + yx = xy`, i.e. the
(two-sided) tensor-algebra relations `xy - yx - [x,y] = 0`. -/
attribute [local instance 100] LieRing.ofAssociativeRing

namespace Shared.Lie
universe u v w w'
variable (k : Type u) (g : Type v) [CommRing k] [LieRing g] [LieAlgebra k g]

abbrev U := UniversalEnvelopingAlgebra k g
abbrev inclusion : g →ₗ⁅k⁆ U k g := UniversalEnvelopingAlgebra.ι k
abbrev tensorQuotient : TensorAlgebra k g →ₐ[k] U k g :=
  UniversalEnvelopingAlgebra.mkAlgHom k g

def augmentation : U k g →ₐ[k] k := UniversalEnvelopingAlgebra.lift k (0 : g →ₗ⁅k⁆ k)

def word (xs : List g) : U k g := (xs.map (inclusion k g)).prod

/-- The span of all words of length at most `m`; negative steps are zero. -/
def filtration (m : ℤ) : Submodule k (U k g) :=
  Submodule.span k {a | ∃ xs : List g, (xs.length : ℤ) ≤ m ∧ word k g xs = a}

/-- Every unital U-module has this underlying k-module, with no extra assumption. -/
abbrev underlyingModule (M : Type w) [AddCommGroup M] [Module (U k g) M] : Module k M :=
  Module.compHom M (algebraMap k (U k g))

variable (M : Type w) [AddCommGroup M] [Module k M]
/-- Algebra maps to endomorphisms are unital, k-compatible left actions. -/
abbrev ModuleAction := U k g →ₐ[k] Module.End k M
abbrev Representation := g →ₗ⁅k⁆ Module.End k M

/-- Native unital U-module structures compatible with the given k-module. -/
def CompatibleModule := {a : Module (U k g) M //
  letI := a
  IsScalarTower k (U k g) M}

def representationEquiv : Representation k g M ≃ ModuleAction k g M :=
  UniversalEnvelopingAlgebra.lift k

abbrev actionModule (a : ModuleAction k g M) : Module (U k g) M :=
  Module.compHom M a.toRingHom

/-- The actual Lie module structure on a representation's carrier. -/
abbrev representationLieRingModule (ρ : Representation k g M) : LieRingModule g M :=
  LieRingModule.compLieHom M ρ

abbrev representationLieModule (ρ : Representation k g M) :
    @LieModule k g M _ _ _ _ _ (representationLieRingModule k g M ρ) :=
  LieModule.compLieHom M ρ

variable {k g M}
def Intertwines {N : Type w'} [AddCommGroup N] [Module k N]
    (a : ModuleAction k g M) (b : ModuleAction k g N) (f : M →ₗ[k] N) : Prop :=
  ∀ u m, f (a u m) = b u (f m)

def LieIntertwines {N : Type w'} [AddCommGroup N] [Module k N]
    (ρ : Representation k g M) (σ : Representation k g N) (f : M →ₗ[k] N) : Prop :=
  ∀ x m, f (ρ x m) = σ x (f m)
end Shared.Lie

namespace Specs.Shared.Lie
open _root_.Shared.Lie
universe u v w w'
variable (k : Type u) (g : Type v) [CommRing k] [LieRing g] [LieAlgebra k g]

def quotientType : Prop :=
  Function.Surjective (tensorQuotient k g) ∧
  ∀ x y : g, inclusion k g x * inclusion k g y - inclusion k g y * inclusion k g x =
    inclusion k g ⁅x,y⁆

def universalType : Prop := ∀ (A : Type w) [Ring A] [Algebra k A]
    (f : g →ₗ⁅k⁆ A), ∃! F : U k g →ₐ[k] A, ∀ x, F (inclusion k g x) = f x

def augmentationType : Prop :=
  (∀ x : g, augmentation k g (inclusion k g x) = 0) ∧
  (∀ r : k, augmentation k g (algebraMap k (U k g) r) = r)

variable (M : Type w) [AddCommGroup M] [Module k M]
def actionTowerType : Prop := ∀ a : ModuleAction k g M,
  letI := actionModule k g M a
  IsScalarTower k (U k g) M

def actionRoundtripType : Prop := ∀ a : ModuleAction k g M,
  letI := actionModule k g M a
  ∀ (h : IsScalarTower k (U k g) M),
    letI := h
    (Algebra.lsmul k k M : U k g →ₐ[k] Module.End k M) = a

/-- Both inverse laws, and the actual action formula on the original carrier. -/
def representationType : Prop :=
  (∀ ρ : Representation k g M, ∀ x m,
    representationEquiv k g M ρ (inclusion k g x) m = ρ x m) ∧
  (∀ a : ModuleAction k g M,
    representationEquiv k g M ((representationEquiv k g M).symm a) = a)

def moduleRestrictionType [Module (U k g) M] [IsScalarTower k (U k g) M] : Prop :=
  ∀ u m, representationEquiv k g M
    (((Algebra.lsmul k k M : U k g →ₐ[k] Module.End k M) :
      U k g →ₗ⁅k⁆ Module.End k M).comp (inclusion k g)) u m = u • m

def lieExtensionType [LieRingModule g M] [LieModule k g M] : Prop :=
  ∀ x m, representationEquiv k g M (LieModule.toEnd k g M) (inclusion k g x) m = ⁅x,m⁆

def morphismType : Prop := ∀ (N : Type w') [AddCommGroup N] [Module k N]
    (ρ : Representation k g M) (σ : Representation k g N) (f : M →ₗ[k] N),
  Intertwines (representationEquiv k g M ρ) (representationEquiv k g N σ) f ↔
    LieIntertwines ρ σ f

def filtrationType : Prop :=
  Monotone (filtration k g) ∧
  (∀ m : ℤ, m < 0 → filtration k g m = ⊥) ∧
  (1 : U k g) ∈ filtration k g 0 ∧
  (∀ x : g, inclusion k g x ∈ filtration k g 1) ∧
  (∀ (i j : ℤ) (a b : U k g), a ∈ filtration k g i → b ∈ filtration k g j →
    a * b ∈ filtration k g (i+j)) ∧
  (∀ a : U k g, ∃ m : ℤ, a ∈ filtration k g m)

def underlyingTowerType (N : Type w) [AddCommGroup N] [Module (U k g) N] : Prop :=
  letI := underlyingModule k g N
  IsScalarTower k (U k g) N

def lieRoundtripType : Prop := ∀ ρ : Representation k g M,
  letI := representationLieRingModule k g M ρ
  letI := representationLieModule k g M ρ
  LieModule.toEnd k g M = ρ

def moduleRoundtripType [Module (U k g) M] [IsScalarTower k (U k g) M] : Prop :=
  actionModule k g M (Algebra.lsmul k k M) = (inferInstance : Module (U k g) M)

/-- The morphism bijections preserve the underlying maps, hence identities and composition. -/
def morphismEquivType : Prop := ∀ (N : Type w') [AddCommGroup N] [Module k N]
    (ρ : Representation k g M) (σ : Representation k g N),
  ∃ e : {f : M →ₗ[k] N // LieIntertwines ρ σ f} ≃
    {f : M →ₗ[k] N // Intertwines (representationEquiv k g M ρ)
      (representationEquiv k g N σ) f}, ∀ f, (e f).val = f.val

def moduleStructuresType : Prop :=
  ∃ e : Representation k g M ≃ CompatibleModule k g M,
    ∀ (ρ : Representation k g M) (u : U k g) (m : M),
      letI := (e ρ).val
      u • m = representationEquiv k g M ρ u m

end Specs.Shared.Lie

namespace Specs.Shared.Lie
open _root_.Shared.Lie
universe u v w w'

-- Full quantified types for independently checked bindings.
def algebraExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], Type (max u v)
def algebraExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] : Type (max u v) := U k g

def inclusionExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], g →ₗ⁅k⁆ U k g
def inclusionExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] := inclusion k g

def projectionExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], TensorAlgebra k g →ₐ[k] U k g
def projectionExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] := tensorQuotient k g

def augmentationExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], U k g →ₐ[k] k
def augmentationExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] := augmentation k g

def filtrationExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], ℤ → Submodule k (U k g)
def filtrationExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] := filtration k g

def equivalenceExpectedType := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
    Representation k g M ≃ ModuleAction k g M
def equivalenceExpectedValue (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M] := representationEquiv k g M

def quotientExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], quotientType k g

def universalExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], universalType.{u,v,w} k g

def augmentationExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], augmentationType k g

def filtrationExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g], filtrationType k g

def actionTowerExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  actionTowerType k g M

def actionRoundtripExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  actionRoundtripType k g M

def representationExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  representationType k g M

def moduleRestrictionExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M] [Module (U k g) M] [IsScalarTower k (U k g) M],
  moduleRestrictionType k g M

def lieExtensionExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M] [LieRingModule g M] [LieModule k g M],
  lieExtensionType k g M

def morphismExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  morphismType.{u,v,w,w'} k g M

def lieRoundtripExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  lieRoundtripType k g M

def moduleRoundtripExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M] [Module (U k g) M] [IsScalarTower k (U k g) M],
  moduleRoundtripType k g M

def morphismEquivExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  morphismEquivType.{u,v,w,w'} k g M

def underlyingTowerExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module (U k g) M],
  underlyingTowerType k g M
end Specs.Shared.Lie

namespace Specs.Shared.Lie
universe u v w
def moduleStructuresExpected := ∀ (k : Type u) (g : Type v) [CommRing k] [LieRing g]
  [LieAlgebra k g] (M : Type w) [AddCommGroup M] [Module k M],
  moduleStructuresType k g M
end Specs.Shared.Lie
