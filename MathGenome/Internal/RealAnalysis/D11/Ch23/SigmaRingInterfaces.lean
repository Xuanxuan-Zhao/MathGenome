import MathGenome.Internal.RealAnalysis.Specs.D11.Ch23.SigmaRingInterfaces

/-! Sigma-rings, measures on their explicit domains, and generation by intersection.
No measurable-space structure, nonemptiness, finite mass, or lattice is assumed. -/

open Set
open scoped ENNReal

universe u

namespace D11.Ch23

/-- The sigma-ring generated by a family: intersect all sigma-rings containing it. -/
def generatedSigmaRing {X : Type u} (F : Set (Set X)) : SigmaRing X where
  sets := {A | ∀ R : SigmaRing X, F ⊆ (R : Set (Set X)) → A ∈ R}
  empty_mem := fun R _ => R.empty_mem
  diff_mem := fun {_ _} hA hB R hF => R.diff_mem (hA R hF) (hB R hF)
  iUnion_mem := fun A hA R hF => R.iUnion_mem A (fun n => hA n R hF)

/-- The three closure properties are the entire sigma-ring requirement. -/
theorem sigmaRing_characterization {X : Type u} (S : Set (Set X)) :
    (∃ R : SigmaRing X, (R : Set (Set X)) = S) ↔
      ∅ ∈ S ∧
      (∀ ⦃A B : Set X⦄, A ∈ S → B ∈ S → A \ B ∈ S) ∧
      (∀ (A : ℕ → Set X), (∀ n, A n ∈ S) → (⋃ n, A n) ∈ S) := by
  constructor
  · rintro ⟨R, rfl⟩
    exact ⟨R.empty_mem, R.diff_mem, R.iUnion_mem⟩
  · rintro ⟨he, hd, hu⟩
    exact ⟨⟨S, he, hd, hu⟩, rfl⟩

/-- No condition beyond zero empty mass and disjoint countable additivity is
imposed on a nonnegative extended-valued function on a sigma-ring. -/
theorem sigmaRingMeasure_characterization {X : Type u} (R : SigmaRing X)
    (m : {A : Set X // A ∈ R} → ℝ≥0∞) :
    (∃ μ : SigmaRingMeasure R, μ.toFun = m) ↔
      m ⟨∅, R.empty_mem⟩ = 0 ∧
      (∀ (A : ℕ → Set X) (hA : ∀ n, A n ∈ R),
        Pairwise (fun i j => Disjoint (A i) (A j)) →
          m ⟨⋃ n, A n, R.iUnion_mem A hA⟩ = ∑' n, m ⟨A n, hA n⟩) := by
  constructor
  · rintro ⟨μ, rfl⟩
    exact ⟨μ.empty', μ.iUnion'⟩
  · rintro ⟨he, hu⟩
    exact ⟨⟨m, he, hu⟩, rfl⟩

theorem subset_generatedSigmaRing {X : Type u} (F : Set (Set X)) :
    F ⊆ (generatedSigmaRing F : Set (Set X)) := by
  intro A hA R hF
  exact hF hA

theorem generatedSigmaRing_le {X : Type u} (F : Set (Set X)) (R : SigmaRing X)
    (hF : F ⊆ (R : Set (Set X))) :
    (generatedSigmaRing F : Set (Set X)) ⊆ (R : Set (Set X)) := by
  intro A hA
  exact hA R hF

theorem generatedSigmaRing_eq_iInter {X : Type u} (F : Set (Set X)) :
    (generatedSigmaRing F : Set (Set X)) =
      ⋂ (R : SigmaRing X) (_ : F ⊆ (R : Set (Set X))), (R : Set (Set X)) := by
  ext A
  simp only [mem_iInter]
  rfl

end D11.Ch23
