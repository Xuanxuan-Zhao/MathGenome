import MathGenome.Internal.RealAnalysis.Specs.D11.Ch18.BorelBaire

/-!
# Borel and Cc-generated Baire sigma-algebras

This is the definition in paper.tex:5318–5322. The Borel structure is the native
one, and the Baire structure uses exactly the shared `D11.Ch19.Cc X ℝ` interface.
No global measurable-space instance is installed. In particular a later Borel
measure can use `@MeasureTheory.Measure X (borelSpace X)` explicitly.

The definitions and proofs work on every topological space, hence in particular
on the source's locally compact Hausdorff spaces. No equality of the Baire and
Borel structures is asserted here.
-/

namespace D11.Ch18

open scoped MeasureTheory

universe u

/-- The sigma-algebra generated by the open subsets of X. -/
abbrev borelSpace (X : Type u) [TopologicalSpace X] : MeasurableSpace X := borel X

/-- All inverse images of real Borel sets under the canonical Cc functions. -/
def baireGenerators (X : Type u) [TopologicalSpace X] : Set (Set X) :=
  {s | ∃ f : D11.Ch19.Cc X ℝ, ∃ A : Set ℝ,
    MeasurableSet[borel ℝ] A ∧ (f : X → ℝ) ⁻¹' A = s}

/-- The exact Cc-real-generated Baire sigma-algebra of the source. -/
@[instance_reducible]
def baireSpace (X : Type u) [TopologicalSpace X] : MeasurableSpace X :=
  MeasurableSpace.generateFrom (baireGenerators X)

theorem borelSpace_eq_generateFrom (X : Type u) [TopologicalSpace X] :
    borelSpace X = MeasurableSpace.generateFrom {s : Set X | IsOpen s} := rfl

theorem continuous_borel_measurable (X : Type u) [TopologicalSpace X]
    (f : X → ℝ) (hf : Continuous f) :
    @Measurable X ℝ (borelSpace X) (borel ℝ) f :=
  hf.borel_measurable

theorem cc_baire_measurable (X : Type u) [TopologicalSpace X]
    (f : D11.Ch19.Cc X ℝ) :
    @Measurable X ℝ (baireSpace X) (borel ℝ) f := by
  intro A hA
  exact MeasurableSpace.measurableSet_generateFrom ⟨f, A, hA, rfl⟩

theorem baireSpace_le_iff (X : Type u) [TopologicalSpace X]
    (m : MeasurableSpace X) :
    baireSpace X ≤ m ↔ ∀ f : D11.Ch19.Cc X ℝ, @Measurable X ℝ m (borel ℝ) f := by
  constructor
  · intro h f A hA
    exact h _ (cc_baire_measurable X f hA)
  · intro h
    apply MeasurableSpace.generateFrom_le
    rintro s ⟨f, A, hA, rfl⟩
    exact h f hA

theorem baireSpace_le_borelSpace (X : Type u) [TopologicalSpace X] :
    baireSpace X ≤ borelSpace X := by
  apply (baireSpace_le_iff X (borelSpace X)).mpr
  intro f
  exact continuous_borel_measurable X f f.continuous

theorem baire_measurableSet_borel (X : Type u) [TopologicalSpace X] (s : Set X)
    (hs : MeasurableSet[baireSpace X] s) : MeasurableSet[borelSpace X] s :=
  baireSpace_le_borelSpace X s hs

end D11.Ch18
