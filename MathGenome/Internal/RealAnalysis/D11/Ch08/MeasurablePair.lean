import MathGenome.Internal.RealAnalysis.Specs.D11.Ch08.MeasurablePair
import MathGenome.Internal.RealAnalysis.D11.Ch08.ProductSigma

/-!
Pairs and fixed-coordinate inclusions (paper.tex:2533–2547).
The upstream product is generated by measurable rectangles and has measurable
projections. Composition with those projections proves necessity; the native
product construction proves sufficiency. Constants and the identity then give
both fixed-coordinate maps, without assumptions on measures or nonemptiness.
-/

universe u v w

namespace D11.Ch08.MeasurablePair

theorem measurable_iff_components :
    Specs.D11.Ch08.MeasurablePair.measurable_iff_components := by
  intro X Y Z m n p h
  let : MeasurableSpace X := m
  let : MeasurableSpace Y := n
  let : MeasurableSpace Z := p
  constructor
  · intro hh
    obtain ⟨hfst, hsnd⟩ := D11.Ch08.ProductSigma.projections_measurable m n
    exact ⟨hfst.comp hh, hsnd.comp hh⟩
  · rintro ⟨hf, hg⟩
    exact Measurable.prod hf hg

theorem pair_iff : Specs.D11.Ch08.MeasurablePair.pair_iff := by
  intro X Y Z m n p f g
  exact measurable_iff_components m n p (fun z => (f z, g z))

theorem fixed_left : Specs.D11.Ch08.MeasurablePair.fixed_left := by
  intro X Y m n x
  let : MeasurableSpace X := m
  let : MeasurableSpace Y := n
  exact (pair_iff m n n (fun _ => x) id).mpr ⟨measurable_const, measurable_id⟩

theorem fixed_right : Specs.D11.Ch08.MeasurablePair.fixed_right := by
  intro X Y m n y
  let : MeasurableSpace X := m
  let : MeasurableSpace Y := n
  exact (pair_iff m n m id (fun _ => y)).mpr ⟨measurable_id, measurable_const⟩

end D11.Ch08.MeasurablePair
