import MathGenome.Internal.RealAnalysis.Specs.D11.Ch23.ElementaryIntegral
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch23.GeneratedRingAlgebra
import Mathlib.MeasureTheory.Integral.Bochner.Basic

/-! Independent statement of paper.tex:6288–6294.
The measure lives on A_V, the sigma-algebra generated by the positive levels
of the original finite real-valued functions. Its uniqueness is asserted on
R_V only. No unit, nonemptiness, finiteness, or sigma-finiteness is assumed.
-/

open Set MeasureTheory
universe u

namespace Specs.D11.Ch23.DaniellStoneRepresentation

open _root_.D11.Ch23.Specs

/-- An elementary integral on a Stone vector lattice admits an absolutely
integrable measure representation, unique on its generated sigma-ring. -/
def daniell_stone_representation : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)),
    IsVectorLattice V → IsStone V →
    ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
    letI : MeasurableSpace X := positiveLevelMeasurableSpace V
    ∃ μ : Measure X,
      (∀ f : V, Measurable (f : X → ℝ) ∧ Integrable (f : X → ℝ) μ ∧
        (∫ x, (f : X → ℝ) x ∂μ) = L f) ∧
      (∀ ν : Measure X,
        (∀ f : V, Integrable (f : X → ℝ) ν ∧
          (∫ x, (f : X → ℝ) x ∂ν) = L f) →
        ∀ A : Set X, A ∈ positiveLevelSigmaRing V → μ A = ν A)

end Specs.D11.Ch23.DaniellStoneRepresentation
