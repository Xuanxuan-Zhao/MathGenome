    ∀ m : MeasurableSpace X,
      _root_.D11.Ch23.Specs.positiveLevelMeasurableSpace V ≤ m ↔
        ∀ f ∈ V, @Measurable X ℝ m (borel ℝ) f

/-- Even for a Stone lattice, the ring need not contain the whole space. -/
