/-! Independent definitions and full statements for paper.tex:6203--6211.
The domain may be empty. Generation does not impose Stone truncation or a unit.
The sigma-ring and sigma-algebra are different objects. -/

open Set MeasurableSpace
open scoped MeasureTheory
universe u

namespace D11.Ch23.Specs

/-- The paper's family F of strictly positive superlevel sets. -/
def positiveLevelFamily {X : Type u} (V : Submodule ℝ (X → ℝ)) : Set (Set X) :=
  {A | ∃ f ∈ V, ∃ b : ℝ, 0 < b ∧ A = {x | b < f x}}

/-- The canonical sigma-ring generated by F, using the upstream intersection. -/
def positiveLevelSigmaRing {X : Type u} (V : Submodule ℝ (X → ℝ)) : SigmaRing X :=
  _root_.Specs.D11.Ch23.SigmaRingInterfaces.generatedSigmaRingValue (positiveLevelFamily V)

/-- The canonical sigma-algebra A_V = sigma(F). -/
@[instance_reducible]
def positiveLevelMeasurableSpace {X : Type u} (V : Submodule ℝ (X → ℝ)) :
    MeasurableSpace X :=
  generateFrom (positiveLevelFamily V)

end D11.Ch23.Specs

namespace Specs.D11.Ch23.GeneratedRingAlgebra

open _root_.D11.Ch23

def positiveLevelFamily_type := {X : Type u} → Submodule ℝ (X → ℝ) → Set (Set X)
