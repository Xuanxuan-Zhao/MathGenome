  @_root_.D11.Ch23.Specs.positiveLevelMeasurableSpace

def positiveLevel_mem_sigmaRing : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)) (f : X → ℝ), f ∈ V →
    ∀ b : ℝ, 0 < b → {x | b < f x} ∈ _root_.D11.Ch23.Specs.positiveLevelSigmaRing V

def positiveLevelSigmaRing_le : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)) (R : SigmaRing X),
    _root_.D11.Ch23.Specs.positiveLevelFamily V ⊆ (R : Set (Set X)) →
      (_root_.D11.Ch23.Specs.positiveLevelSigmaRing V : Set (Set X)) ⊆ (R : Set (Set X))

def positiveLevelSigmaRing_eq_iInter : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)),
    (_root_.D11.Ch23.Specs.positiveLevelSigmaRing V : Set (Set X)) =
      ⋂ (R : SigmaRing X) (_ : _root_.D11.Ch23.Specs.positiveLevelFamily V ⊆ (R : Set (Set X))),
