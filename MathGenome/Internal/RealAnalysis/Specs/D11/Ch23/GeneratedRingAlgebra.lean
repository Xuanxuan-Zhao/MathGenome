/-- Every original function, with its value at every point, is Borel measurable. -/
def measurable_of_mem : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)), _root_.D11.Ch23.Specs.IsVectorLattice V →
    ∀ f ∈ V, @Measurable X ℝ (_root_.D11.Ch23.Specs.positiveLevelMeasurableSpace V) (borel ℝ) f

/-- Exact leastness among *all* measurable structures making V measurable. -/
