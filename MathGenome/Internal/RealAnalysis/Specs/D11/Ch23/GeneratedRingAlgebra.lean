def positiveLevel_measurableSet : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)) (f : X → ℝ), f ∈ V →
    ∀ b : ℝ, 0 < b → MeasurableSet[_root_.D11.Ch23.Specs.positiveLevelMeasurableSpace V] {x | b < f x}

def positiveLevelMeasurableSpace_le_iff : Prop :=
  ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)) (m : MeasurableSpace X),
    _root_.D11.Ch23.Specs.positiveLevelMeasurableSpace V ≤ m ↔
      _root_.D11.Ch23.Specs.positiveLevelFamily V ⊆ {A | MeasurableSet[m] A}

def positiveLevelMeasurableSpace_eq_sInf : Prop :=
