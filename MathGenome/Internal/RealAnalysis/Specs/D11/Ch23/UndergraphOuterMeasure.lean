import MathGenome.Internal.RealAnalysis.Specs.D11.Ch23.UndergraphContent
import Mathlib.MeasureTheory.OuterMeasure.Induced
import Mathlib.MeasureTheory.Measure.OuterMeasure

/-! Independent specification of paper.tex:6236–6248. No covering of the
whole product, unit, or measurable structure on X is assumed. -/
noncomputable section
universe u
open Set MeasureTheory
open scoped ENNReal
namespace D11.Ch23.Specs

/-- The paper's infimum, including value infinity for an empty cover class. -/
def UndergraphCoverCost {X : Type u} (V : Submodule ℝ (X → ℝ))
    (L : V →ₗ[ℝ] ℝ) (A : Set (X × ℝ)) : ℝ≥0∞ :=
  ⨅ (a : ℕ → Set (X × ℝ)) (_ : ∀ n, a n ∈ UndergraphFamily V)
    (_ : A ⊆ ⋃ n, a n), ∑' n, UndergraphContent V L (a n)

private theorem content_empty {X : Type u} (V : Submodule ℝ (X → ℝ))
    (L : V →ₗ[ℝ] ℝ) : UndergraphContent V L ∅ = 0 := by
  have hl : UndergraphLength (∅ : Set (X × ℝ)) = 0 := by
    funext x
    simp [UndergraphLength]
  simp only [UndergraphContent, hl, V.zero_mem, dite_true]
  have hz : (⟨(0 : X → ℝ), V.zero_mem⟩ : V) = 0 := rfl
  simp [hz]

private theorem empty_mem {X : Type u} (V : Submodule ℝ (X → ℝ)) :
    ∅ ∈ UndergraphFamily V := by
  refine ⟨0, 0, ?_⟩
  ext p
  simp [Undergraph]

/-- Extend J by infinity off the family and take its covering outer measure. -/
def UndergraphOuterMeasure {X : Type u} (V : Submodule ℝ (X → ℝ))
    (L : V →ₗ[ℝ] ℝ) : OuterMeasure (X × ℝ) :=
  inducedOuterMeasure (fun s (_ : s ∈ UndergraphFamily V) => UndergraphContent V L s)
    (empty_mem V) (content_empty V L)

/-- B is the sigma-algebra generated by the actual undergraph intervals. -/
def UndergraphMeasurableSpace {X : Type u} (V : Submodule ℝ (X → ℝ)) :
    MeasurableSpace (X × ℝ) := MeasurableSpace.generateFrom (UndergraphFamily V)

/-- Canonical restriction when the generated sets pass the splitting test.
The zero branch only totalizes this definition outside the integral hypotheses;
UndergraphGeneratedLe proves that branch is never used under those hypotheses. -/
def UndergraphMeasure {X : Type u} (V : Submodule ℝ (X → ℝ))
    (L : V →ₗ[ℝ] ℝ) : @Measure (X × ℝ) (UndergraphMeasurableSpace V) := by
  classical
  exact if h : UndergraphMeasurableSpace V ≤ (UndergraphOuterMeasure V L).caratheodory
    then @OuterMeasure.toMeasure _ (UndergraphMeasurableSpace V) (UndergraphOuterMeasure V L) h
    else 0

def UndergraphCoverCostType := ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)),
  (V →ₗ[ℝ] ℝ) → Set (X × ℝ) → ℝ≥0∞
def UndergraphOuterMeasureType := ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)),
  (V →ₗ[ℝ] ℝ) → OuterMeasure (X × ℝ)
def UndergraphMeasurableSpaceType := ∀ {X : Type u},
  Submodule ℝ (X → ℝ) → MeasurableSpace (X × ℝ)
def UndergraphMeasureType := ∀ {X : Type u} (V : Submodule ℝ (X → ℝ)),
  (V →ₗ[ℝ] ℝ) → @Measure (X × ℝ) (UndergraphMeasurableSpace V)

def UndergraphOuterMeasureFormula : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)) (L : V →ₗ[ℝ] ℝ) (A : Set (X × ℝ)),
  UndergraphOuterMeasure V L A = UndergraphCoverCost V L A

def UndergraphCoverCostAxioms : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)) (L : V →ₗ[ℝ] ℝ),
  UndergraphCoverCost V L ∅ = 0 ∧ Monotone (UndergraphCoverCost V L) ∧
    ∀ a : ℕ → Set (X × ℝ),
      UndergraphCoverCost V L (⋃ n, a n) ≤ ∑' n, UndergraphCoverCost V L (a n)

def UndergraphNoCover : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)) (L : V →ₗ[ℝ] ℝ) (A : Set (X × ℝ)),
  (∀ a : ℕ → Set (X × ℝ), (∀ n, a n ∈ UndergraphFamily V) → ¬ A ⊆ ⋃ n, a n) →
    UndergraphOuterMeasure V L A = ⊤

def UndergraphCaratheodory : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)), IsVectorLattice V →
  ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
  ∀ s ∈ UndergraphFamily V, (UndergraphOuterMeasure V L).IsCaratheodory s

def UndergraphOuterMeasureExact : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)), IsVectorLattice V →
  ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
  ∀ s ∈ UndergraphFamily V, UndergraphOuterMeasure V L s = UndergraphContent V L s

def UndergraphGeneratedLe : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)), IsVectorLattice V →
  ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
  UndergraphMeasurableSpace V ≤ (UndergraphOuterMeasure V L).caratheodory

def UndergraphMeasureApply : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)), IsVectorLattice V →
  ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
  ∀ A, MeasurableSet[UndergraphMeasurableSpace V] A →
    UndergraphMeasure V L A = UndergraphOuterMeasure V L A

def UndergraphMeasureExact : Prop := ∀ {X : Type u}
  (V : Submodule ℝ (X → ℝ)), IsVectorLattice V →
  ∀ L : V →ₗ[ℝ] ℝ, IsElementaryIntegral V L →
  ∀ s ∈ UndergraphFamily V, UndergraphMeasure V L s = UndergraphContent V L s

end D11.Ch23.Specs
