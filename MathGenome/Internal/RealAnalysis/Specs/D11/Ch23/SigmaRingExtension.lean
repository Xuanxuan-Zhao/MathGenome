import MathGenome.Internal.RealAnalysis.Specs.D11.Ch23.SigmaRingInterfaces
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch01.MeasureDefinitions

/-!
Independent statements for paper.tex:6211--6215. The measurable space is precisely
that generated by the given sigma-ring. The initial measure evaluates only ring
members; the extended measure is required to have the displayed values only on
its measurable domain. No whole-space cover or finiteness assumption is made.
-/

open Set MeasureTheory
open scoped ENNReal
universe u

namespace Specs.D11.Ch23.SigmaRingExtension
open _root_.D11.Ch23

def generated_domain : Prop :=
  ∀ {X : Type u} (R : SigmaRing X),
    {A : Set X | MeasurableSet[MeasurableSpace.generateFrom (R : Set (Set X))] A} =
      (R : Set (Set X)) ∪ {A : Set X | ∃ B ∈ R, A = Bᶜ}

def extensionMass_type : Type (u + 1) :=
  ∀ {X : Type u} (R : SigmaRing X), SigmaRingMeasure R → Set X → ℝ≥0∞

noncomputable def extensionMass_value : extensionMass_type.{u} := by
  classical
  exact fun _ μ A => if h : A ∈ _ then μ ⟨A, h⟩ else ∞

def extension_empty : Prop :=
  ∀ {X : Type u} (R : SigmaRing X) (μ : SigmaRingMeasure R),
    extensionMass_value R μ ∅ = 0

def extension_countably_additive : Prop :=
  ∀ {X : Type u} (R : SigmaRing X) (μ : SigmaRingMeasure R) (A : ℕ → Set X),
    (∀ n, MeasurableSet[MeasurableSpace.generateFrom (R : Set (Set X))] (A n)) →
    Pairwise (fun i j => Disjoint (A i) (A j)) →
    extensionMass_value R μ (⋃ n, A n) = ∑' n, extensionMass_value R μ (A n)

def exists_extension : Prop :=
  ∀ {X : Type u} (R : SigmaRing X) (μ : SigmaRingMeasure R),
    ∃ ν : @Measure X (MeasurableSpace.generateFrom (R : Set (Set X))),
      ∀ A : Set X,
        MeasurableSet[MeasurableSpace.generateFrom (R : Set (Set X))] A →
          ν A = extensionMass_value R μ A

end Specs.D11.Ch23.SigmaRingExtension
