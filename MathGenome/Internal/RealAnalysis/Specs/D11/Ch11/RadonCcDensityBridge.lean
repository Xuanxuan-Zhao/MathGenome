import MathGenome.Internal.RealAnalysis.Specs.D11.Ch18.RadonPredicates
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch19.CcCzero
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch02.Completion
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch10.QuotientConstruction
import Mathlib.MeasureTheory.Function.LpSpace.Indicator

/-! The Radon-space bridge, paper.tex:3667–3694. Borel means precisely the
sigma-algebra generated by the opens. No countability or sigma-finiteness is
assumed. Compact support means compactness of the closure of the nonzero set.
Native Lp is the ordinary a.e. quotient, identified with the literal measurable
raw-function quotient by the upstream quotient-construction obligation.
Completion below is only the ordinary completion of that specified measure. -/
open Set MeasureTheory
open scoped ENNReal
universe u
noncomputable section
namespace Specs.D11.Ch11.RadonCcDensityBridge

local instance {X : Type u} [TopologicalSpace X] : MeasurableSpace X := borel X

/-- Norm approximation by actual compactly supported continuous scalar maps. -/
def radon_cc_density : Prop :=
  ∀ {X : Type u} [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X]
    {𝕜 : Type} [RCLike 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
    (μ : @Measure X (borel X)),
    Specs.D11.Ch18.RadonPredicates.isRadonValue μ →
    ∀ (p : ℝ≥0∞) [Fact (1 ≤ p)], p ≠ ∞ →
    ∀ f : Lp 𝕜 p μ, ∀ ε : ℝ, 0 < ε →
      ∃ (g : CompactlySupportedContinuousMap X 𝕜) (hg : MemLp g p μ),
        ‖f - hg.toLp g‖ < ε

open Specs.D11.Ch10.QuotientConstruction

/-- Density on the literal quotient of ordinary Borel measurable functions.
The normed structures and representative-compatible native isometry are supplied
as conclusions, using the already fixed quotient interface. -/
def ordinary_quotient_density : Prop :=
  ∀ {X : Type u} [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X]
    {𝕜 : Type} [RCLike 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
    (μ : @Measure X (borel X)),
    Specs.D11.Ch18.RadonPredicates.isRadonValue μ →
    ∀ (p : ℝ≥0∞) [Fact (1 ≤ p)], p ≠ ∞ →
    ∃ G : NormedAddCommGroup (QuotientLp (𝕜 := 𝕜) μ p),
    letI := G
    ∃ V : NormedSpace 𝕜 (QuotientLp (𝕜 := 𝕜) μ p),
    letI := V
    ∃ F : QuotientLp (𝕜 := 𝕜) μ p ≃ₗᵢ[𝕜] Lp 𝕜 p μ,
      (∀ r : Raw (𝕜 := 𝕜) μ p, F (classOf r) = r.property.2.toLp r.val) ∧
      ∀ f : QuotientLp (𝕜 := 𝕜) μ p, ∀ ε : ℝ, 0 < ε →
        ∃ (g : CompactlySupportedContinuousMap X 𝕜) (hg : MemLp g p μ),
          ‖f - classOf (⟨g, by
            letI : BorelSpace X := ⟨rfl⟩
            exact g.continuous.measurable, hg⟩ : Raw (𝕜 := 𝕜) μ p)‖ < ε

/-- The canonical isometry is characterized by preservation of representatives.
Its inverse supplies an originally measurable representative of every completed
class. This statement holds for any positive measure, even at p = infinity. -/
def completion_isometry : Prop :=
  ∀ {X : Type u} [m : MeasurableSpace X]
    {𝕜 : Type} [RCLike 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
    (μ : Measure X) (p : ℝ≥0∞) [Fact (1 ≤ p)],
    ∃! e : Lp 𝕜 p μ ≃ₗᵢ[𝕜]
        Lp 𝕜 p μ.completion,
      (∀ f : Lp 𝕜 p μ, (e f : X → 𝕜) =ᵐ[μ] (f : X → 𝕜)) ∧
      (∀ f, Measurable (e.symm f : X → 𝕜) ∧
        (e.symm f : X → 𝕜) =ᵐ[μ] (f : X → 𝕜))

/-- In particular the completed Lp space has the same Cc approximants. The
original MemLp condition is retained, so each approximant has its Borel class. -/
def completed_radon_cc_density : Prop :=
  ∀ {X : Type u} [TopologicalSpace X] [T2Space X] [LocallyCompactSpace X]
    {𝕜 : Type} [RCLike 𝕜] [MeasurableSpace 𝕜] [BorelSpace 𝕜]
    (μ : @Measure X (borel X)),
    Specs.D11.Ch18.RadonPredicates.isRadonValue μ →
    ∀ (p : ℝ≥0∞) [Fact (1 ≤ p)], p ≠ ∞ →
    ∀ f : Lp 𝕜 p μ.completion,
      ∀ ε : ℝ, 0 < ε →
      ∃ (g : CompactlySupportedContinuousMap X 𝕜)
        (hg : MemLp (fun x : NullMeasurableSpace X μ => g x) p μ.completion),
        MemLp g p μ ∧
        ‖f - hg.toLp (fun x : NullMeasurableSpace X μ => g x)‖ < ε

end Specs.D11.Ch11.RadonCcDensityBridge
