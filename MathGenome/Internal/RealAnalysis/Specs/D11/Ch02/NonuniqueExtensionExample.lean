import MathGenome.Internal.RealAnalysis.Specs.D11.Ch02.PremeasureAgreement
import MathGenome.Internal.RealAnalysis.Specs.D11.Ch03.BorelGenerators
import Mathlib.MeasureTheory.Measure.Count
import Mathlib.MeasureTheory.Measure.CompleteLattice

/-! Independent statements of the nonunique-extension example, paper.tex:732–745.
The canonical algebra is generated by closed lower rays; `algebra_description`
requires its exact identification with the literal finite-union family in the
source. All measures below use the Borel sigma-algebra, without completion. -/

open Set MeasureTheory
open scoped ENNReal

namespace D11.Ch02.NonuniqueExtensionExample

/-- The elementary sets from the example, including its two exceptional sets. -/
def intervalFamily : Set (Set ℝ) :=
  {s | s = ∅ ∨ s = univ ∨ (∃ b, s = Iic b) ∨ (∃ a, s = Ioi a) ∨
    ∃ a b, a < b ∧ s = Ioc a b}

/-- Finite unions of exactly those elementary sets. -/
def finiteIntervalUnions : Set (Set ℝ) :=
  {s | ∃ C : Finset (Set ℝ), (∀ t ∈ C, t ∈ intervalFamily) ∧ s = ⋃ t ∈ C, t}

/-- Canonical algebra, to be identified with `finiteIntervalUnions`. -/
def intervalAlgebra : Set (Set ℝ) := generateSetAlgebra (range (Iic : ℝ → Set ℝ))

/-- The zero-or-infinity cost, evaluated only on the source algebra. -/
noncomputable def premeasureValue (s : intervalAlgebra) : ℝ≥0∞ :=
  if s.1 = ∅ then 0 else ∞

end D11.Ch02.NonuniqueExtensionExample

namespace Specs.D11.Ch02.NonuniqueExtensionExample

open _root_.D11.Ch02.NonuniqueExtensionExample
open _root_.D11.Ch02.PremeasureAgreement

def algebra_description : Prop := intervalAlgebra = finiteIntervalUnions

def algebra_isSetAlgebra : Prop := IsSetAlgebra intervalAlgebra

def nonempty_contains_interval : Prop :=
  ∀ s ∈ intervalAlgebra, s.Nonempty → ∃ a b : ℝ, a < b ∧ Ioc a b ⊆ s

def generated_eq_borel : Prop := MeasurableSpace.generateFrom intervalAlgebra = borel ℝ

def is_premeasure : Prop :=
  ∀ hA : IsSetAlgebra intervalAlgebra,
    ∃ p : Premeasure intervalAlgebra hA, p.value = premeasureValue

def counting_extends : Prop :=
  ∀ s : intervalAlgebra, (Measure.count : Measure ℝ) s.1 = premeasureValue s

def infinite_measure_values : Prop :=
  ∀ s : Set ℝ, MeasurableSet s → (⊤ : Measure ℝ) s = if s = ∅ then 0 else ∞

def infinite_extends : Prop :=
  ∀ s : intervalAlgebra, (⊤ : Measure ℝ) s.1 = premeasureValue s

def singleton_values : Prop :=
  ∀ x : ℝ, (Measure.count : Measure ℝ) {x} = 1 ∧ (⊤ : Measure ℝ) {x} = ∞

def distinct_extensions : Prop :=
  ∃ μ ν : Measure ℝ, μ ≠ ν ∧
    (∀ s : intervalAlgebra, μ s.1 = premeasureValue s ∧ ν s.1 = premeasureValue s) ∧
    ∀ x : ℝ, μ {x} = 1 ∧ ν {x} = ∞

end Specs.D11.Ch02.NonuniqueExtensionExample
