import MathGenome.Internal.RealAnalysis.Specs.D11.Ch02.PremeasureAgreement

/-!
Independent statement of paper.tex:626–650. The measure lives on precisely
the sigma-algebra generated by the original algebra. The first conjunct
identifies it with the covering outer measure on that measurable domain.
Existence, maximality, and equality on its finite measurable sets require
no finiteness assumption. Sigma-finiteness is used only for full uniqueness.
All objects are the shared upstream objects; empty spaces are admitted.
-/

open Set MeasureTheory MeasurableSpace
open scoped ENNReal

universe u

namespace Specs.D11.Ch02.Extension

open _root_.D11.Ch02.PremeasureAgreement

def extension_existence_uniqueness : Prop :=
  ∀ {α : Type u} {A : Set (Set α)} {hA : IsSetAlgebra A}
    (p : Premeasure A hA),
    ∃ μ : @Measure α (generateFrom A),
      (∀ E : Set α, MeasurableSet[generateFrom A] E →
        μ E = PremeasureAgreement.coveringOuterMeasure_value p E) ∧
      (∀ s : A, μ s.1 = p.value s) ∧
      (∀ ν : @Measure α (generateFrom A), (∀ s : A, ν s.1 = p.value s) →
        ∀ E : Set α, MeasurableSet[generateFrom A] E →
          ν E ≤ μ E ∧ (μ E < ∞ → ν E = μ E)) ∧
      (PremeasureAgreement.isSigmaFinite_value p →
        ∀ ν : @Measure α (generateFrom A), (∀ s : A, ν s.1 = p.value s) → ν = μ)

end Specs.D11.Ch02.Extension
