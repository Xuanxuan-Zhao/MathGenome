import MathGenome.Internal.TopologyRiemannianGeometry.P202Specs.Homology.CellularDegrees
import MathGenome.Internal.TopologyRiemannianGeometry.P202Specs.Homology.CellularComparison
import Mathlib.Analysis.Complex.Circle
import Mathlib.Data.ZMod.Basic
import Mathlib.LinearAlgebra.Isomorphisms

/-! Standard polygon surfaces, paper.tex 1612–1616 and 1653–1662.

The spaces below are actual topological quotients of the closed complex disk.
The boundary is traversed counterclockwise, split into equally sized arcs.
Occurrences of the same letter are identified in their indicated direction.
For the empty word (oriented genus zero), the entire boundary is collapsed.
No classification theorem and no assumed CW or homology certificate occurs in
these definitions. The algebraic statements are separate from the geometric
and singular-homology obligations.
-/
noncomputable section
open CategoryTheory CategoryTheory.Limits
open P202.Cellular P202Specs.CellularChains P202Specs.SingularChains

namespace P202Specs.SurfaceHomology

/-- `true` means the direction of the boundary traversal agrees with the edge. -/
abbrev Word (n : ℕ) := List (Fin n × Bool)

def orientedWord (g : ℕ) : Word (2*g) :=
  (List.finRange g).flatMap fun i =>
    let a : Fin (2*g) := ⟨2*i.val, by omega⟩
    let b : Fin (2*g) := ⟨2*i.val+1, by omega⟩
    [(a, true), (b, true), (a, false), (b, false)]

def nonorientableWord (k : ℕ) : Word k :=
  (List.finRange k).flatMap fun i => [(i, true), (i, true)]

/-- The exponent sum, before identifying it with a topological degree. -/
def exponentSum {n : ℕ} (w : Word n) (e : Fin n) : ℤ :=
  (w.map fun l => if l.1 = e then (if l.2 then 1 else -1) else 0).sum

abbrev ClosedDisk := Metric.closedBall (0 : ℂ) 1

/-- A point on side i of an m-sided polygon in its circular disk model. -/
def sidePoint (m i : ℕ) (t : ℝ) : ClosedDisk :=
  ⟨(Circle.exp (2 * Real.pi * ((i : ℝ) + t) / (m : ℝ)) : ℂ), by
    simp only [Metric.mem_closedBall, dist_zero_right, Circle.norm_coe, le_refl]⟩

/-- Generating identifications of equally labelled oriented polygon sides. -/
def sideRelation {n : ℕ} (w : Word n) (x y : ClosedDisk) : Prop :=
  (w = [] ∧ ‖x.val‖ = 1 ∧ ‖y.val‖ = 1) ∨
  ∃ (i j : Fin w.length) (t : unitInterval),
    (w.get i).1 = (w.get j).1 ∧
    x = sidePoint w.length i.val (if (w.get i).2 then t.val else 1-t.val) ∧
    y = sidePoint w.length j.val (if (w.get j).2 then t.val else 1-t.val)

def polygonSetoid {n : ℕ} (w : Word n) : Setoid ClosedDisk :=
  Relation.EqvGen.setoid (sideRelation w)

def PolygonSurface {n : ℕ} (w : Word n) := Quotient (polygonSetoid w)

instance {n : ℕ} (w : Word n) : TopologicalSpace (PolygonSurface w) :=
  inferInstanceAs (TopologicalSpace (Quotient (polygonSetoid w)))

abbrev OrientedSurface (g : ℕ) := PolygonSurface (orientedWord g)
abbrev NonorientableSurface (k : ℕ) := PolygonSurface (nonorientableWord k)

def polygonProjection {n : ℕ} (w : Word n) : C(ClosedDisk, PolygonSurface w) :=
  ⟨Quotient.mk (polygonSetoid w), continuous_quotient_mk'⟩

/-- One vertex, e edges, one two-cell, and no cells in other dimensions. -/
def PolygonCellCounts (X : Type) [TopologicalSpace X] [CellStructure X] (e : ℕ) : Prop :=
  Nonempty (Cell X 0 ≃ Fin 1) ∧ Nonempty (Cell X 1 ≃ Fin e) ∧
  Nonempty (Cell X 2 ≃ Fin 1) ∧ ∀ n, 2 < n → IsEmpty (Cell X n)

/-- Charts identify the cells with the polygon's actual vertex, oriented
edges, and quotient disk. An arbitrary chart on the closed two-disk is allowed;
its orientation is fixed later by its chosen relative generator. -/
structure PolygonCharts {e : ℕ} (w : Word e) [CellStructure (PolygonSurface w)] where
  vertex : Cell (PolygonSurface w) 0
  edges : Fin e ≃ Cell (PolygonSurface w) 1
  face : Cell (PolygonSurface w) 2
  disk : Disk 2 ≃ₜ ClosedDisk
  vertex_chart : ∀ x, characteristic (PolygonSurface w) 0 vertex x =
    polygonProjection w (sidePoint w.length 0 0)
  edge_chart : ∀ (i : Fin w.length) (x : Disk 1),
    characteristic (PolygonSurface w) 1 (edges (w.get i).1) x =
      polygonProjection w (sidePoint w.length i.val
        (if (w.get i).2 then (x.val 0 + 1)/2 else 1-(x.val 0+1)/2))
  face_chart : ∀ x, characteristic (PolygonSurface w) 2 face x =
    polygonProjection w (disk x)

/-- The two positive differentials in coordinates generated by the specified
characteristic maps. The reference disk orientations are chosen explicitly.
Thus arbitrary unrelated module isomorphisms do not witness this property. -/
def PolygonDifferentials {e : ℕ} (w : Word e) [CWStructure (PolygonSurface w)]
    (charts : PolygonCharts w) (coefficient : ℤ) : Prop :=
  ∃ (c₀ : chainGroup (PolygonSurface w) ℤ ℤ 0 ≃ₗ[ℤ] ℤ)
    (c₁ : chainGroup (PolygonSurface w) ℤ ℤ 1 ≃ₗ[ℤ] (Fin e → ℤ))
    (c₂ : chainGroup (PolygonSurface w) ℤ ℤ 2 ≃ₗ[ℤ] ℤ)
    (g₀ : ℤ ≃ₗ[ℤ] P202Specs.RelativeSingularChains.relativeHomology ℤ ℤ
      (referenceDiskPair.{0} 0) 0)
    (g₁ : ℤ ≃ₗ[ℤ] P202Specs.RelativeSingularChains.relativeHomology ℤ ℤ
      (referenceDiskPair.{0} 1) 1)
    (g₂ : ℤ ≃ₗ[ℤ] P202Specs.RelativeSingularChains.relativeHomology ℤ ℤ
      (referenceDiskPair.{0} 2) 2),
    (∀ z, c₀ (P202Specs.CellularDegrees.cellClass (PolygonSurface w) ℤ ℤ 0
      charts.vertex (g₀ z)) = z) ∧
    (∀ i z, c₁ (P202Specs.CellularDegrees.cellClass (PolygonSurface w) ℤ ℤ 1
      (charts.edges i) (g₁ z)) = Pi.single i z) ∧
    (∀ z, c₂ (P202Specs.CellularDegrees.cellClass (PolygonSurface w) ℤ ℤ 2
      charts.face (g₂ z)) = z) ∧
    (∀ z, c₀ (differential (PolygonSurface w) ℤ ℤ 0 z) = 0) ∧
    (∀ z i, c₁ (differential (PolygonSurface w) ℤ ℤ 1 z) i = coefficient * c₂ z)

/-- The column 2(1,...,1), as a map of integral free modules. -/
def twiceDiagonal (k : ℕ) : ℤ →ₗ[ℤ] (Fin k → ℤ) where
  toFun z _ := 2*z
  map_add' _ _ := by ext; simp [mul_add]
  map_smul' _ _ := by ext; simp [mul_left_comm]

namespace Expected

/-- Actual quotient models have the stated finite CW structures. -/
def polygonCellStructures : Prop :=
  (∀ g, ∃ C : CWStructure (OrientedSurface g),
    letI := C
    PolygonCellCounts (OrientedSurface g) (2*g) ∧
      Nonempty (PolygonCharts (orientedWord g))) ∧
  (∀ k, 1 ≤ k → ∃ C : CWStructure (NonorientableSurface k),
    letI := C
    PolygonCellCounts (NonorientableSurface k) k ∧
      Nonempty (PolygonCharts (nonorientableWord k)))

/-- Compute the differential of actual skeletal relative homology, rather
than merely postulating an abstract three-term complex. -/
def attachingDifferentials : Prop :=
  (∀ g, ∃ C : CWStructure (OrientedSurface g),
    letI := C
    PolygonCellCounts (OrientedSurface g) (2*g) ∧
      ∃ charts : PolygonCharts (orientedWord g),
        PolygonDifferentials (orientedWord g) charts 0) ∧
  (∀ k, 1 ≤ k → ∃ C : CWStructure (NonorientableSurface k),
    letI := C
    PolygonCellCounts (NonorientableSurface k) k ∧
      ∃ charts : PolygonCharts (nonorientableWord k),
        PolygonDifferentials (nonorientableWord k) charts 2)

def orientedHomology : Prop :=
  ∀ g,
    Nonempty (homology ℤ ℤ (TopCat.of (OrientedSurface g)) 0 ≃ₗ[ℤ] ℤ) ∧
    Nonempty (homology ℤ ℤ (TopCat.of (OrientedSurface g)) 1 ≃ₗ[ℤ] (Fin (2*g) → ℤ)) ∧
    Nonempty (homology ℤ ℤ (TopCat.of (OrientedSurface g)) 2 ≃ₗ[ℤ] ℤ) ∧
    ∀ j : ℕ, 2 < j → IsZero (homology ℤ ℤ (TopCat.of (OrientedSurface g)) (j : ℤ))

def nonorientableHomology : Prop :=
  ∀ k, 1 ≤ k →
    Nonempty (homology ℤ ℤ (TopCat.of (NonorientableSurface k)) 0 ≃ₗ[ℤ] ℤ) ∧
    Nonempty (homology ℤ ℤ (TopCat.of (NonorientableSurface k)) 1 ≃ₗ[ℤ]
      ((Fin (k-1) → ℤ) × ZMod 2)) ∧
    IsZero (homology ℤ ℤ (TopCat.of (NonorientableSurface k)) 2) ∧
    ∀ j : ℕ, 2 < j → IsZero (homology ℤ ℤ (TopCat.of (NonorientableSurface k)) (j : ℤ))

/-- These are word calculations; the attaching-degree bridge is independently
required by `attachingDifferentials`. -/
def wordCoefficients : Prop :=
  (∀ g (e : Fin (2*g)), exponentSum (orientedWord g) e = 0) ∧
  (∀ k (e : Fin k), exponentSum (nonorientableWord k) e = 2)

/-- Every disk polygon quotient is nonempty and path connected, so its
integral degree-zero homology is one copy of the integers. This stronger
statement includes both named families and the empty word. -/
def degreeZero : Prop :=
  ∀ (n : ℕ) (word : Word n),
    Nonempty (homology ℤ ℤ (TopCat.of (PolygonSurface word)) 0 ≃ₗ[ℤ] ℤ)

/-- The row-operation computation, for every positive edge count. -/
def nonorientableSmith : Prop :=
  ∀ k, 1 ≤ k → Function.Injective (twiceDiagonal k) ∧
    Nonempty (((Fin k → ℤ) ⧸ LinearMap.range (twiceDiagonal k)) ≃ₗ[ℤ]
      ((Fin (k-1) → ℤ) × ZMod 2))

end Expected
end P202Specs.SurfaceHomology
