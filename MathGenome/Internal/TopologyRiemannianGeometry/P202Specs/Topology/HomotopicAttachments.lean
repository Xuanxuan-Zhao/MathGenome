import MathGenome.Internal.TopologyRiemannianGeometry.P202Specs.Topology.CellStructures
import Mathlib.Topology.Homotopy.Basic

/-!
The third assertion of `prop:p202-cw-neighborhood`, paper.tex 618–625,
660–672. The adjunction is the quotient of the topological disjoint union
by the boundary identifications. Arbitrary families, including empty families
and zero-dimensional disks, are allowed. No embedding hypothesis is imposed
on the attaching maps.
-/
noncomputable section
open Set Topology
universe u v w z

namespace P202.Attachments

section Adjunction
variable {X : Type u} [TopologicalSpace X] {J : Type v}
  {A B : J → Type w} [∀ j, TopologicalSpace (A j)] [∀ j, TopologicalSpace (B j)]

/-- The generating identifications for an actual topological adjunction. -/
inductive Relation (i : ∀ j, C(A j, B j)) (a : ∀ j, C(A j, X)) :
    (X ⊕ (Σ j, B j)) → (X ⊕ (Σ j, B j)) → Prop where
  | boundary (j : J) (x : A j) : Relation i a (.inl (a j x)) (.inr ⟨j, i j x⟩)

/-- `Quot` takes the equivalence relation generated by these identifications,
with the quotient topology from the sum and sigma topologies. -/
def Adjunction (i : ∀ j, C(A j, B j)) (a : ∀ j, C(A j, X)) := Quot (Relation i a)

instance (i : ∀ j, C(A j, B j)) (a : ∀ j, C(A j, X)) :
    TopologicalSpace (Adjunction i a) := inferInstanceAs (TopologicalSpace (Quot _))

def base (i : ∀ j, C(A j, B j)) (a : ∀ j, C(A j, X)) : C(X, Adjunction i a) :=
  ⟨fun x => Quot.mk _ (.inl x), continuous_quot_mk.comp continuous_inl⟩

def cell (i : ∀ j, C(A j, B j)) (a : ∀ j, C(A j, X)) (j : J) :
    C(B j, Adjunction i a) :=
  ⟨fun x => Quot.mk _ (.inr ⟨j, x⟩),
    continuous_quot_mk.comp (continuous_inr.comp continuous_sigmaMk)⟩
end Adjunction

/-- Maps under `X`, with both inverse homotopies stationary on the image of `X`.
The maps `i` and `j` themselves are not assumed to be embeddings. -/
structure RelativeEquivalence {X : Type u} {Y : Type v} {Z : Type w}
    [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]
    (i : C(X, Y)) (j : C(X, Z)) where
  forward : C(Y, Z)
  backward : C(Z, Y)
  forward_base : ∀ x, forward (i x) = j x
  backward_base : ∀ x, backward (j x) = i x
  left : (backward.comp forward).HomotopyRel (ContinuousMap.id Y) (range i)
  right : (forward.comp backward).HomotopyRel (ContinuousMap.id Z) (range j)

open P202.Cellular

def diskBoundary (n : ℕ) : C(Sphere n, Disk n) :=
  ⟨boundaryInclusion n, continuous_subtype_val.subtype_mk _⟩

abbrev Attached {X : Type u} [TopologicalSpace X] {J : Type v}
    (n : J → ℕ) (a : ∀ j, C(Sphere (n j), X)) :=
  Adjunction (fun j => diskBoundary (n j)) a

abbrev inclusion {X : Type u} [TopologicalSpace X] {J : Type v}
    (n : J → ℕ) (a : ∀ j, C(Sphere (n j), X)) :=
  base (fun j => diskBoundary (n j)) a

end P202.Attachments

namespace P202Specs.Topology.HomotopicAttachments
open P202.Cellular P202.Attachments

/-- The full family version, in particular including a single attached disk.
The dimensions may even vary across the specified family. -/
def homotopicAttachments : Prop :=
  ∀ {X : Type u} [TopologicalSpace X] [CWStructure X] {J : Type v}
    (n : J → ℕ) (a₀ a₁ : ∀ j, C(Sphere (n j), X)),
    (∀ j, (a₀ j).Homotopy (a₁ j)) →
    Nonempty (RelativeEquivalence (inclusion n a₀) (inclusion n a₁))

end P202Specs.Topology.HomotopicAttachments
