import MathGenome.Internal.Specs.D05.M10.CyclicTest
import MathGenome.Internal.D05.M10.Cyclic
import MathGenome.Internal.D05.M10.InvariantFactors
import MathGenome.Internal.D05.M08.CayleyHamilton

/-! The cyclic-vector test over the original field, including dimension zero. -/
noncomputable section
open Polynomial
open scoped BigOperators
namespace D05.M10.CyclicTest

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V]

theorem cyclic_annihilator : Specs.D05.M10.CyclicTest.cyclic_annihilator := by
  intro K V _ _ _ _ T v hv
  let d := Cyclic.vectorAnnihilator K V T v
  have hd : d.Monic := (Cyclic.monic_generator T v).1
  have hdv : Polynomial.aeval T d v = 0 :=
    (Cyclic.divides_iff_annihilates T v d).mp dvd_rfl
  have hdT : Polynomial.aeval T d = 0 := by
    ext w
    obtain ⟨q, hq⟩ := (Cyclic.module_bridge T v w).mpr (hv ▸ Submodule.mem_top)
    have hq' : Polynomial.aeval T q v = w :=
      congrArg (Module.AEval'.of T).symm hq
    rw [← hq']
    change (Polynomial.aeval T d * Polynomial.aeval T q) v = 0
    rw [← map_mul, mul_comm d q, map_mul]
    change Polynomial.aeval T q (Polynomial.aeval T d v) = 0
    rw [hdv, map_zero]
  have h₁ : minpoly K T ∣ d := minpoly.dvd_iff.mpr hdT
  have h₂ : d ∣ minpoly K T :=
    (Cyclic.divides_iff_annihilates T v _).mpr (by
      change Polynomial.aeval T (minpoly K T) v = 0
      rw [minpoly.aeval, LinearMap.zero_apply])
  exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le (M08.Minpoly.monic T) hd h₁
    (Polynomial.natDegree_le_of_dvd h₂ (M08.Minpoly.ne_zero T))

theorem cyclic_degree : Specs.D05.M10.CyclicTest.cyclic_degree := by
  intro K V _ _ _ _ T v hv
  have h := Cyclic.dimension T v
  rw [cyclic_annihilator T v hv] at h
  rw [hv, finrank_top] at h
  exact h.symm

theorem minpoly_eq_charpoly_of_cyclic :
    Specs.D05.M10.CyclicTest.minpoly_eq_charpoly_of_cyclic := by
  intro K V _ _ _ _ T v hv
  symm
  exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le (M08.Minpoly.monic T)
    (M08.Charpoly.monic T) (M08.CayleyHamilton.minpoly_divides_charpoly T)
    (by
      change (Specs.D05.M08.Charpoly.charpoly_value T).natDegree ≤ _
      rw [M08.Charpoly.natDegree T, cyclic_degree T v hv])

/-- With equal minimal and characteristic polynomials, a nonempty rational
factor list has only its last entry: cancellation makes the earlier product 1. -/
lemma one_rational_factor (T : Module.End K V) {r : ℕ}
    (d : Fin (r+1) → K[X])
    (hd : Specs.D05.M10.InvariantFactors.RationalFactors T d)
    (h : minpoly K T = T.charpoly) : r = 0 := by
  classical
  have hp := hd.2.1
  have he : (∏ i : Fin r, d i.castSucc) * d (Fin.last r) =
      1 * d (Fin.last r) := by
    rw [← Fin.prod_univ_castSucc, ← InvariantFactors.charpoly_product T d hd,
      ← h, InvariantFactors.minpoly_largest T d hd, one_mul]
  have hprod : (∏ i : Fin r, d i.castSucc) = 1 :=
    mul_right_cancel₀ (hd.1 (Fin.last r)).ne_zero he
  by_contra hr
  let i : Fin r := ⟨0, Nat.pos_of_ne_zero hr⟩
  have hu : IsUnit (d i.castSucc) := by
    apply isUnit_of_dvd_one
    rw [← hprod]
    exact Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
  have hdeg : (d i.castSucc).natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hu
  exact (Nat.ne_of_gt (hp i.castSucc)) hdeg

omit [FiniteDimensional K V] in
/-- A single polynomial quotient is generated by the residue class of 1;
transport this generator through the actual rational module isomorphism. -/
lemma cyclic_of_single_quotient (T : Module.End K V) (d : Fin 1 → K[X])
    (e : Module.AEval' T ≃ₗ[K[X]] (∀ i, Specs.D05.M10.Rational.Residue (d i))) :
    ∃ v : V, Cyclic.cyclicSpace K V T v = ⊤ := by
  let z : ∀ i, Specs.D05.M10.Rational.Residue (d i) :=
    fun _ => Submodule.Quotient.mk (1 : K[X])
  let v := (Module.AEval'.of T).symm (e.symm z)
  refine ⟨v, top_unique ?_⟩
  intro w _
  obtain ⟨q, hq⟩ := Submodule.Quotient.mk_surjective
    (Ideal.span {d 0} : Submodule K[X] K[X])
    (e (Module.AEval'.of T w) (0 : Fin 1))
  apply (Cyclic.module_bridge T v w).mp
  refine ⟨q, ?_⟩
  change q • Module.AEval'.of T v = Module.AEval'.of T w
  apply e.injective
  rw [map_smul]
  simp only [v, LinearEquiv.apply_symm_apply]
  change q • z = e (Module.AEval'.of T w)
  funext i
  have hi : i = (0 : Fin 1) := Subsingleton.elim _ _
  subst i
  change q • (Submodule.Quotient.mk (1 : K[X]) :
    Specs.D05.M10.Rational.Residue (d 0)) = _
  rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
  exact hq

theorem zero_case : Specs.D05.M10.CyclicTest.zero_case := by
  intro K V _ _ _ _ T hV
  have hz := InvariantFactors.zero_case T hV
  have hbot : (⊥ : Submodule K V) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    simpa using hV.symm
  exact ⟨(Cyclic.zero_vector T).2.1.trans hbot, (Cyclic.zero_vector T).1,
    hz.2.2, hz.2.1⟩

theorem exists_cyclic_of_minpoly_eq_charpoly :
    Specs.D05.M10.CyclicTest.exists_cyclic_of_minpoly_eq_charpoly := by
  intro K V _ _ _ _ T h
  obtain ⟨r, d, hm, hp, hdiv, ⟨e⟩, b, hb, _⟩ := Rational.rational_form T
  cases r with
  | zero =>
    have hV : Module.finrank K V = 0 :=
      (InvariantFactors.nonempty_factors T d ⟨hm, hp, hdiv, b, hb⟩).mp rfl
    exact ⟨0, (zero_case T hV).1⟩
  | succ r =>
    have hr := one_rational_factor T d ⟨hm, hp, hdiv, b, hb⟩ h
    subst r
    exact cyclic_of_single_quotient T d e

theorem cyclic_iff_minpoly_eq_charpoly :
    Specs.D05.M10.CyclicTest.cyclic_iff_minpoly_eq_charpoly := by
  intro K V _ _ _ _ T
  constructor
  · rintro ⟨v, hv⟩
    exact minpoly_eq_charpoly_of_cyclic T v hv
  · exact exists_cyclic_of_minpoly_eq_charpoly T

end D05.M10.CyclicTest
