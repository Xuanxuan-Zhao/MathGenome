import Mathlib.CategoryTheory.Sites.LeftExact
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Sheafification
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.Localization.FractionRing
import Mathlib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous
import Mathlib.Algebra.Category.ModuleCat.Presheaf.Monoidal

noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open scoped BigOperators
open HomogeneousLocalization

namespace DerivedFormalization.ProjectiveTwists

universe u

variable (k : Type u) [Field k] (n : ℕ)

abbrev Index := Fin (n + 1)
abbrev Polynomials := MvPolynomial (Index n) k
abbrev grading := MvPolynomial.homogeneousSubmodule (Index n) k
attribute [local instance] MvPolynomial.gradedAlgebra

/-- Projective space for the total-degree grading. -/
abbrev projectiveSpace : Scheme := Proj (grading k n)

abbrev Base := ProjectiveSpectrum.top (grading k n)
abbrev OpensOfProj := Opens (Base k n)

abbrev variablePolynomial (i : Index n) : Polynomials k n := MvPolynomial.X i

/-- The standard open indexed by a coordinate. -/
def chart (i : Index n) : OpensOfProj k n :=
  Proj.basicOpen (grading k n) (variablePolynomial k n i)

/-- The product of the coordinates inverted on an intersection. -/
def chartProduct (J : Finset (Index n)) : Polynomials k n :=
  ∏ i ∈ J, variablePolynomial k n i

/-- The intersection, including the empty intersection convention. -/
def intersection (J : Finset (Index n)) : OpensOfProj k n :=
  J.inf (chart k n)

abbrev ChartRing (J : Finset (Index n)) :=
  HomogeneousLocalization.Away (grading k n) (chartProduct k n J)

abbrev ChartLocalization (J : Finset (Index n)) :=
  Localization.Away (chartProduct k n J)

/-- The multiplicative set generated by the coordinates indexed by `J`. -/
def invertedCoordinates (J : Finset (Index n)) : Submonoid (Polynomials k n) :=
  Submonoid.closure (variablePolynomial k n '' (J : Set (Index n)))

abbrev RationalFunctions := FractionRing (Polynomials k n)
abbrev intoFraction : Polynomials k n →+* RationalFunctions k n :=
  algebraMap (Polynomials k n) (RationalFunctions k n)

def fraction (a b : Polynomials k n) : RationalFunctions k n :=
  intoFraction k n a / intoFraction k n b

/-- A homogeneous fraction of degree `m`, with denominator in the given multiplicative set. -/
def homogeneousFraction (P : Submonoid (Polynomials k n)) (m : ℤ)
    (s : RationalFunctions k n) : Prop :=
  ∃ (a b : Polynomials k n) (d e : ℕ), a ∈ grading k n d ∧ b ∈ grading k n e ∧
    b ∈ P ∧ (d : ℤ) - e = m ∧ s = fraction k n a b

def chartDenominator (J : Finset (Index n)) (t : ℕ) :
    Submonoid.powers (chartProduct k n J) := ⟨chartProduct k n J ^ t, t, rfl⟩

/-- Fractions with a homogeneous numerator and a power denominator. When `J` is nonempty,
these are the degree-`m` elements of the ordinary localization at the chart product. -/
def DegreePiece (J : Finset (Index n)) (m : ℤ) :=
  {s : ChartLocalization k n J // ∃ (a : Polynomials k n) (t d : ℕ),
    a ∈ grading k n d ∧ (d : ℤ) - (t * J.card : ℕ) = m ∧
    s = Localization.mk a (chartDenominator k n J t)}

abbrev ChartVariables (i : Index n) := {j : Index n // j ≠ i}
abbrev CoordinatePolynomials (i : Index n) := MvPolynomial (ChartVariables n i) k

/-- Setting the distinguished coordinate to one gives the affine coordinates. -/
def dehomogenizedVariable (i j : Index n) : CoordinatePolynomials k n i :=
  if h : j = i then 1 else MvPolynomial.X ⟨j, h⟩

def ratioProduct (J : Finset (Index n)) (i : Index n) : CoordinatePolynomials k n i :=
  ∏ j ∈ J.erase i, dehomogenizedVariable k n i j

abbrev CoordinateLocalization (J : Finset (Index n)) (i : Index n) :=
  Localization.Away (ratioProduct k n J i)

/-- The local description of a section of the twist before imposing locality. -/
def twistPrelocal (m : ℤ) :
    TopCat.PrelocalPredicate (fun _ : Base k n => RationalFunctions k n) where
  pred {U} f :=
    ∃ (a b : Polynomials k n) (d e : ℕ), a ∈ grading k n d ∧ b ∈ grading k n e ∧
      (d : ℤ) - e = m ∧
      (∀ x : U, b ∉ ProjectiveSpectrum.asHomogeneousIdeal x.1) ∧
      (∀ x, f x = fraction k n a b)
  res i _ h := by
    obtain ⟨a, b, d, e, ha, hb, hm, hden, hf⟩ := h
    exact ⟨a, b, d, e, ha, hb, hm, fun x ↦ hden (i x), fun x ↦ hf (i x)⟩

/-- The actual sheaf of locally homogeneous rational functions on `Proj`. -/
def twistTypes (m : ℤ) : TopCat.Sheaf (Type u) (Base k n) :=
  TopCat.subsheafToTypes (twistPrelocal k n m).sheafify

abbrev TwistSections (m : ℤ) (U : OpensOfProj k n) :=
  (twistTypes k n m).obj.obj (op U)

def frame (i : Index n) (m : ℤ) : RationalFunctions k n :=
  intoFraction k n (variablePolynomial k n i) ^ m

theorem variable_degree (i : Index n) : variablePolynomial k n i ∈ grading k n 1 :=
  MvPolynomial.isHomogeneous_X k i

theorem chartProduct_degree (J : Finset (Index n)) :
    chartProduct k n J ∈ grading k n J.card := by
  simpa [chartProduct] using
    (SetLike.prod_mem_graded (grading k n) (fun _ : Index n ↦ (1 : ℕ))
      (variablePolynomial k n) (F := J) fun i _ ↦ variable_degree k n i)

theorem chartProduct_ne_zero (J : Finset (Index n)) : chartProduct k n J ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr fun i _ ↦ MvPolynomial.X_ne_zero i

abbrev PrimeComplement (x : projectiveSpace k n) : Submonoid (Polynomials k n) :=
  @Ideal.primeCompl _ _ x.asHomogeneousIdeal.toIdeal x.isPrime

abbrev Fiber (x : projectiveSpace k n) :=
  HomogeneousLocalization (grading k n) (PrimeComplement k n x)

theorem intoFraction_injective : Function.Injective (intoFraction k n) :=
  IsFractionRing.injective _ _

theorem intoFraction_ne_zero {a : Polynomials k n} (ha : a ≠ 0) :
    intoFraction k n a ≠ 0 := by
  simpa only [map_zero] using (intoFraction_injective k n).ne ha

theorem unit_in_fraction (P : Submonoid (Polynomials k n))
    (hP : P ≤ nonZeroDivisors _) (b : P) : IsUnit (intoFraction k n (b : Polynomials k n)) :=
  (isUnit_iff_ne_zero).mpr (intoFraction_ne_zero k n (nonZeroDivisors.ne_zero (hP b.2)))

def localizationToFraction (P : Submonoid (Polynomials k n)) (hP : P ≤ nonZeroDivisors _) :
    Localization P →+* RationalFunctions k n :=
  IsLocalization.lift (M := P) (S := Localization P) (unit_in_fraction k n P hP)

def homogeneousToFraction (P : Submonoid (Polynomials k n)) (hP : P ≤ nonZeroDivisors _) :
    HomogeneousLocalization (grading k n) P →+* RationalFunctions k n :=
  (localizationToFraction k n P hP).comp (algebraMap _ _)

abbrev fiberToFraction (x : projectiveSpace k n) : Fiber k n x →+* RationalFunctions k n :=
  homogeneousToFraction k n _ (@Ideal.primeCompl_le_nonZeroDivisors _ _ _
    x.asHomogeneousIdeal.toIdeal x.isPrime)

abbrev structureSections (U : OpensOfProj k n) := (ProjectiveSpectrum.Proj.structureSheaf (grading k n)).obj.obj (op U)

/-- The values of a structure section embedded into the common fraction field. -/
def structureToFunctions (U : OpensOfProj k n) :
    structureSections k n U →+* (U → RationalFunctions k n) where
  toFun s x := fiberToFraction k n x.1 (s.val x)
  map_zero' := funext fun _ ↦ map_zero _
  map_one' := funext fun _ ↦ map_one _
  map_add' _ _ := funext fun _ ↦ map_add _ _ _
  map_mul' _ _ := funext fun _ ↦ map_mul _ _ _

abbrev moduleRingSheaf : CategoryTheory.Sheaf (Opens.grothendieckTopology (Base k n)) RingCat :=
  (sheafCompose (Opens.grothendieckTopology (Base k n))
    (forget₂ CommRingCat.{u} RingCat.{u})).obj (projectiveSpace k n).sheaf

abbrev structurePresheaf : (OpensOfProj k n)ᵒᵖ ⥤ RingCat.{u} :=
  (moduleRingSheaf k n).obj

theorem powers_product_le_nonZeroDivisors (J : Finset (Index n)) :
    Submonoid.powers (chartProduct k n J) ≤ nonZeroDivisors (Polynomials k n) :=
  Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero (chartProduct_ne_zero k n J))

abbrev chartToFraction (J : Finset (Index n)) : ChartLocalization k n J →+*
    RationalFunctions k n :=
  localizationToFraction k n _ (powers_product_le_nonZeroDivisors k n J)

abbrev chartRingToFraction (J : Finset (Index n)) :
    ChartRing k n J →+* RationalFunctions k n :=
  homogeneousToFraction k n _ (powers_product_le_nonZeroDivisors k n J)

theorem intersection_antitone : Antitone (intersection k n) :=
  fun _ _ h ↦ Finset.le_inf fun _ hi ↦ Finset.inf_le (h hi)

private theorem product_dvd {J K : Finset (Index n)} (h : J ⊆ K) :
    chartProduct k n J ∣ chartProduct k n K :=
  Finset.prod_dvd_prod_of_subset J K _ h

/-- The canonical further localization at the added coordinates. -/
def localizationRestriction {J K : Finset (Index n)} (h : J ⊆ K) :
    ChartLocalization k n J →+* ChartLocalization k n K :=
  Localization.awayLift (algebraMap _ _) (chartProduct k n J)
    (IsLocalization.Away.isUnit_of_dvd (chartProduct k n K) (product_dvd k n h))

def restriction {U V : OpensOfProj k n} (h : V ≤ U) (m : ℤ) :
    TwistSections k n m U → TwistSections k n m V :=
  (twistTypes k n m).obj.map (homOfLE h).op

abbrev SingletonRing (i : Index n) := Away (grading k n) (variablePolynomial k n i)

def coordinateRatio (i j : Index n) : SingletonRing k n i :=
  HomogeneousLocalization.Away.mk _ (variable_degree k n i) 1
    (variablePolynomial k n j) (by simpa using variable_degree k n j)

/-- Constants land in degree zero of the graded polynomial ring. -/
def constantInDegreeZero : k →+* grading k n 0 where
  toFun r := ⟨MvPolynomial.C r, MvPolynomial.isHomogeneous_C _ r⟩
  map_one' := Subtype.ext (map_one MvPolynomial.C)
  map_mul' _ _ := Subtype.ext (map_mul MvPolynomial.C _ _)
  map_zero' := Subtype.ext (map_zero MvPolynomial.C)
  map_add' _ _ := Subtype.ext (map_add MvPolynomial.C _ _)

def constantInSingleton (i : Index n) : k →+* SingletonRing k n i :=
  (fromZeroRingHom (grading k n) _).comp (constantInDegreeZero k n)

def ratios (i : Index n) : CoordinatePolynomials k n i →+* SingletonRing k n i :=
  MvPolynomial.eval₂Hom (constantInSingleton k n i) (fun j ↦ coordinateRatio k n i j)

theorem chartProduct_eq_variable_mul_erase {J : Finset (Index n)}
    {i : Index n} (hi : i ∈ J) :
    chartProduct k n J = variablePolynomial k n i * chartProduct k n (J.erase i) :=
  (Finset.mul_prod_erase J (variablePolynomial k n) hi).symm

abbrev commStructurePresheaf : (OpensOfProj k n)ᵒᵖ ⥤ CommRingCat.{u} :=
  (projectiveSpace k n).presheaf

abbrev twistSheafification :=
  PresheafOfModules.sheafification (𝟙 (moduleRingSheaf k n).obj)

theorem chartProduct_eq_mul_sdiff {J K : Finset (Index n)} (h : J ⊆ K) :
    chartProduct k n K = chartProduct k n J * chartProduct k n (K \ J) := by
  classical
  exact (mul_comm _ _).trans (Finset.prod_sdiff h) |>.symm

def chartRingRestriction {J K : Finset (Index n)} (h : J ⊆ K) :
    ChartRing k n J →+* ChartRing k n K :=
  awayMap _ (chartProduct_degree k n (K \ J)) (chartProduct_eq_mul_sdiff k n h)

namespace Expected

def projectiveSpaceType := ∀ (k : Type u) [Field k], ℕ → Scheme.{u}
def projectiveSpaceValue (k : Type u) [Field k] (n : ℕ) := Proj (grading k n)

def structureMapType :=
  ∀ (k : Type u) [Field k] (n : ℕ), projectiveSpace k n ⟶ Spec (CommRingCat.of k)

def structureMapValue (k : Type u) [Field k] (n : ℕ) :
    projectiveSpace k n ⟶ Spec (CommRingCat.of k) :=
  Proj.toSpecZero (grading k n) ≫ Spec.map (CommRingCat.ofHom (constantInDegreeZero k n))

def standardCover : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ), ⨆ i, chart k n i = ⊤

def intersectionBasicOpen : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)),
    intersection k n J = Proj.basicOpen (grading k n) (chartProduct k n J)

def chartScheme : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)), J.Nonempty →
    Nonempty (Scheme.Opens.toScheme (X := projectiveSpace k n) (intersection k n J) ≅
      Spec (CommRingCat.of (ChartRing k n J)))

def chartCoordinateScheme : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)) (i : Index n), i ∈ J →
    Nonempty (Scheme.Opens.toScheme (X := projectiveSpace k n) (intersection k n J) ≅
      Spec (CommRingCat.of (CoordinateLocalization k n J i)))

def chartLocalization : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)),
    IsLocalization (invertedCoordinates k n J) (ChartLocalization k n J)

def chartRingNoetherian : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)),
    J.Nonempty → IsNoetherianRing (ChartRing k n J)

def degreePieceImage : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)) (m : ℤ)
    (s : RationalFunctions k n),
    (∃ w : DegreePiece k n J m, chartToFraction k n J w.val = s) ↔
      homogeneousFraction k n (invertedCoordinates k n J) m s

def chartRingImage : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)) (s : RationalFunctions k n),
    (∃ w : ChartRing k n J, chartRingToFraction k n J w = s) ↔
      homogeneousFraction k n (invertedCoordinates k n J) 0 s

def singletonCoordinates : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (i : Index n),
    ∃ e : SingletonRing k n i ≃+* CoordinatePolynomials k n i,
      (∀ r, e (constantInSingleton k n i r) = MvPolynomial.C r) ∧
      ∀ j : ChartVariables n i, e (coordinateRatio k n i j.val) = MvPolynomial.X j

def intersectionCoordinates : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) (J : Finset (Index n)) (i : Index n) (hi : i ∈ J),
    let toIntersection := awayMap (grading k n) (chartProduct_degree k n (J.erase i))
      (chartProduct_eq_variable_mul_erase k n hi)
    ∃ e : ChartRing k n J ≃+* CoordinateLocalization k n J i,
      (∀ r, e (toIntersection (constantInSingleton k n i r)) =
        algebraMap (CoordinatePolynomials k n i) (CoordinateLocalization k n J i)
          (MvPolynomial.C r)) ∧
      ∀ j : ChartVariables n i,
        e (toIntersection (coordinateRatio k n i j.val)) =
          algebraMap (CoordinatePolynomials k n i) (CoordinateLocalization k n J i)
            (MvPolynomial.X j)

def chartStructureComparisons : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ),
    ∃ e : ∀ (J : Finset (Index n)), J.Nonempty →
        ChartRing k n J ≃+* structureSections k n (intersection k n J),
      (∀ J hJ a x, structureToFunctions k n _ (e J hJ a) x = chartRingToFraction k n J a) ∧
      ∀ J K (h : J ⊆ K) hJ hK a,
        (projectiveSpace k n).presheaf.map (homOfLE (intersection_antitone k n h)).op (e J hJ a) =
          e K hK (chartRingRestriction k n h a)

def chartRingRestrictionLocalization : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ) {J K : Finset (Index n)} (h : J ⊆ K), J.Nonempty →
    letI := (chartRingRestriction k n h).toAlgebra
    IsLocalization.Away
      (Away.isLocalizationElem (chartProduct_degree k n J) (chartProduct_degree k n (K \ J)))
      (ChartRing k n K)

def localizedTwistSections : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ),
    ∃ e : ∀ (J : Finset (Index n)), J.Nonempty → ∀ m,
        DegreePiece k n J m ≃ TwistSections k n m (intersection k n J),
      (∀ J hJ m p x, (e J hJ m p).val x = chartToFraction k n J p.val) ∧
      (∀ J K (h : J ⊆ K) hJ hK m p,
        ∃ q : DegreePiece k n K m,
          q.val = localizationRestriction k n h p.val ∧
          restriction k n (intersection_antitone k n h) m (e J hJ m p) = e K hK m q) ∧
      ∀ J hJ m l p q, ∃ r : DegreePiece k n J (m + l),
        r.val = p.val * q.val ∧ ∀ x, (e J hJ (m + l) r).val x =
          (e J hJ m p).val x * (e J hJ l q).val x

open scoped TensorProduct MonoidalCategory

abbrev moduleOn (M : SheafOfModules (moduleRingSheaf k n)) (U : OpensOfProj k n) :
    ModuleCat ((moduleRingSheaf k n).obj.obj (op U)) := M.val.obj (op U)

abbrev tensorOf (M N : SheafOfModules (moduleRingSheaf k n)) :
    PresheafOfModulesOfCommRing (commStructurePresheaf k n) :=
  PresheafOfModulesOfCommRing.Monoidal.tensorObj M.val N.val

set_option backward.isDefEq.respectTransparency false in
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false in
def twistingModules : Prop :=
  ∀ (k : Type u) [Field k] (n : ℕ),
    ∃ (M : ℤ → SheafOfModules (moduleRingSheaf k n))
      (e : ∀ m U, moduleOn k n (M m) U ≃ TwistSections k n m U)
      (f : ∀ (i : Index n) (m : ℤ) (U : OpensOfProj k n), U ≤ chart k n i →
        structureSections k n U ≃ moduleOn k n (M m) U),
      (∀ m U (s t : moduleOn k n (M m) U) x,
        (e m U (s + t)).val x = (e m U s).val x + (e m U t).val x) ∧
      (∀ m U (r : (moduleRingSheaf k n).obj.obj (op U)) (s : moduleOn k n (M m) U) x,
        (e m U (r • s)).val x = structureToFunctions k n U r x * (e m U s).val x) ∧
      (∀ m U V (h : V ≤ U) (s : moduleOn k n (M m) U),
        e m V ((M m).val.map (homOfLE h).op s) = restriction k n h m (e m U s)) ∧
      (∀ i m U hi r x, (e m U (f i m U hi r)).val x =
        structureToFunctions k n U r x * frame k n i m) ∧
      (∀ i j m U hi hj x,
        structureToFunctions k n U ((f i m U hi).symm (f j m U hj 1)) x =
          fraction k n (variablePolynomial k n j) (variablePolynomial k n i) ^ m) ∧
      (∀ (i : Index n) (m : ℤ) (U : OpensOfProj k n) (hU : U ≤ chart k n i),
        ∃ t : SheafOfModules.unit ((moduleRingSheaf k n).over U) ≅ (M m).over U,
          ∀ (V : Over U) (r : structureSections k n V.left),
            t.hom.val.app (op V) r = f i m V.left (V.hom.le.trans hU) r) ∧
      ∀ m l, ∃ μ : (twistSheafification k n).obj (tensorOf k n (M m) (M l)) ⟶ M (m + l),
        let p := PresheafOfModules.sheafificationHomEquiv (𝟙 (moduleRingSheaf k n).obj) μ
        ∀ U (a : moduleOn k n (M m) U) (b : moduleOn k n (M l) U) x,
          (e (m + l) U (p.app (op U) (a ⊗ₜ b))).val x =
            (e m U a).val x * (e l U b).val x

end Expected
end DerivedFormalization.ProjectiveTwists
