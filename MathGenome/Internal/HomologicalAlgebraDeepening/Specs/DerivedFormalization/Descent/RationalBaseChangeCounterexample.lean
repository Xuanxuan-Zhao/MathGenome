import Mathlib.Algebra.Category.ModuleCat.Descent
import Mathlib.Algebra.Homology.DerivedCategory.ExactFunctor
import Mathlib.CategoryTheory.Adjunction.Additive
import Mathlib.RingTheory.Flat.Localization
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.Localization.FractionRing

open CategoryTheory CategoryTheory.Limits

namespace DerivedFormalization.Descent.RationalBaseChange

attribute [local instance] HasDerivedCategory.standard

/-- Extension of scalars along the canonical inclusion of the integers in the rationals,
applied degreewise and descended to the unbounded derived categories. -/
noncomputable def rationalization :
    DerivedCategory (ModuleCat.{0} ℤ) ⥤ DerivedCategory (ModuleCat.{0} ℚ) :=
  letI : PreservesFiniteLimits (ModuleCat.extendScalars (algebraMap ℤ ℚ)) :=
    ModuleCat.preservesFiniteLimits_extendScalars_of_flat <|
      RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat ℚ (nonZeroDivisors ℤ))
  letI := (ModuleCat.extendRestrictScalarsAdj (algebraMap ℤ ℚ)).left_adjoint_additive
  (ModuleCat.extendScalars (algebraMap ℤ ℚ)).mapDerivedCategory

/-- The integer quotient by the principal ideal generated by `ℓ`, placed in degree zero. -/
noncomputable def residueComplex (ℓ : ℤ) : DerivedCategory (ModuleCat.{0} ℤ) :=
  (DerivedCategory.singleFunctor (ModuleCat.{0} ℤ) 0).obj
    (ModuleCat.of ℤ (ℤ ⧸ Ideal.span ({ℓ} : Set ℤ)))

namespace Specs

def intToRatFlat : Prop := (algebraMap ℤ ℚ).Flat

def rationalBaseChangeCounterexample : Prop :=
  ∀ ℓ : ℤ, Prime ℓ →
    ¬ IsZero (residueComplex ℓ) ∧ IsZero (rationalization.obj (residueComplex ℓ))

end Specs
end DerivedFormalization.Descent.RationalBaseChange
