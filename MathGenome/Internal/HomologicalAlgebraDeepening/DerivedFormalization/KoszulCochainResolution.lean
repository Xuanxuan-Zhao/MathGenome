import MathGenome.Internal.HomologicalAlgebraDeepening.DerivedFormalization.Cochains
import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Koszul.Resolution
import Mathlib.Algebra.Homology.Embedding.ExtendHomology

/-! The exterior Koszul resolution in cochain degrees. -/

noncomputable section

namespace DerivedFormalization

open CategoryTheory CategoryTheory.Limits HomologicalComplex
open ComplexShape (embeddingDownNat)
open AdvCommAlg.Koszul

universe u

variable {A : Type u} [CommRing A]

/-- The Koszul complex of a list, with the (n)-th exterior power in degree (-n). -/
abbrev koszulCochain (a : List A) : Comp.{u} A :=
  (listComplex a).extend embeddingDownNat

/-- The identification of a nonpositive cochain term with its exterior power. -/
def koszulCochainTermIso (a : List A) (n : ℕ) :
    (koszulCochain a).X (-(n : ℤ)) ≅ ModuleCat.of A (⋀[A]^n (Fin a.length → A)) :=
  (listComplex a).extendXIso embeddingDownNat (i := n) rfl

/-- Reindexing the homological degree-zero stalk gives the cochain degree-zero stalk. -/
def koszulStalkIso (M : ModuleCat.{u} A) :
    ((ChainComplex.single₀ (ModuleCat A)).obj M).extend embeddingDownNat ≅
      (stalk A).obj M :=
  extendSingleIso embeddingDownNat M 0 0 rfl

/-- The canonical augmentation to the quotient by the ideal generated by the list. -/
def koszulCochainAugmentation (a : List A) :
    koszulCochain a ⟶ (stalk A).obj (ModuleCat.of A (A ⧸ listIdeal a)) :=
  extendMap (augmentation a) embeddingDownNat ≫ (koszulStalkIso _).hom

/-- Cohomology in degree `-n` identifies with homology in degree `n`. -/
def koszulCochainHomologyIso (a : List A) (n : ℕ) :
    (koszulCochain a).homology (-(n : ℤ)) ≅ (listComplex a).homology n :=
  (listComplex a).extendHomologyIso embeddingDownNat (j := n) rfl

/-- Reindexing transports the differential with its original sign. -/
theorem koszulCochain_d (a : List A) (p q : ℕ) :
    (koszulCochain a).d (-(p : ℤ)) (-(q : ℤ)) ≫ (koszulCochainTermIso a q).hom =
      (koszulCochainTermIso a p).hom ≫ (listComplex a).d p q := by
  change ((listComplex a).extend embeddingDownNat).d (embeddingDownNat.f p)
      (embeddingDownNat.f q) ≫ ((listComplex a).extendXIso embeddingDownNat (i := q) rfl).hom =
    ((listComplex a).extendXIso embeddingDownNat (i := p) rfl).hom ≫ (listComplex a).d p q
  rw [(listComplex a).extend_d_eq embeddingDownNat (i := p) (j := q) rfl rfl]
  simp

private theorem koszulCochain_d_apply (a : List A) (n : ℕ)
    (x : ⋀[A]^(n + 1) (Fin a.length → A)) :
    (koszulCochainTermIso a n).hom
        ((koszulCochain a).d (-((n + 1 : ℕ) : ℤ)) (-(n : ℤ))
          ((koszulCochainTermIso a (n + 1)).inv x)) =
      differential (listForm a) n x := by
  let e := koszulCochainTermIso a (n + 1)
  have hd : (listComplex a).d (n + 1) n = ModuleCat.ofHom (differential (listForm a) n) :=
    ChainComplex.of_d (fun k => ModuleCat.of A (⋀[A]^k (Fin a.length → A)))
      (fun k => ModuleCat.ofHom (differential (listForm a) k)) n
  have h : (koszulCochain a).d (-((n + 1 : ℕ) : ℤ)) (-(n : ℤ)) ≫
      (koszulCochainTermIso a n).hom = e.hom ≫ ModuleCat.ofHom (differential (listForm a) n) :=
    (koszulCochain_d a (n + 1) n).trans
      (congrArg (fun f : (listComplex a).X (n + 1) ⟶ (listComplex a).X n => e.hom ≫ f) hd)
  have he : e.hom (e.inv x) = x := ModuleCat.hom_inv_apply e x
  change (koszulCochainTermIso a n).hom ((koszulCochain a).d _ _ (e.inv x)) =
    ModuleCat.ofHom (differential (listForm a) n) x
  simpa only [CategoryTheory.comp_apply, he] using congrArg (fun f => f (e.inv x)) h

/-- In exterior coordinates the cochain differential deletes one wedge factor at a time. -/
theorem koszulCochain_d_wedge (a : List A) (n : ℕ) (x : Fin (n + 1) → (Fin a.length → A)) :
    (koszulCochainTermIso a n).hom
        ((koszulCochain a).d (-((n + 1 : ℕ) : ℤ)) (-(n : ℤ))
          ((koszulCochainTermIso a (n + 1)).inv (exteriorPower.ιMulti A (n + 1) x))) =
      ∑ i : Fin (n + 1), (-1 : A)^i.val •
        (listForm a (x i) • exteriorPower.ιMulti A n (x ∘ i.succAbove)) := by
  refine (koszulCochain_d_apply a n _).trans ?_
  apply Subtype.ext
  simpa only [differential_coe, exteriorPower.ιMulti_apply_coe, Submodule.coe_sum,
    SetLike.val_smul] using contraction_formula (listForm a) n x

/-- The differential sends each degree `-1` exterior generator to the corresponding entry. -/
theorem koszulCochain_d_generator (a : List A) (i : Fin a.length) :
    exteriorPower.zeroEquiv A (Fin a.length → A)
      ((koszulCochainTermIso a 0).hom
        ((koszulCochain a).d (-1) 0
          ((koszulCochainTermIso a 1).inv (exteriorPower.ιMulti A 1
            (fun _ => Pi.basisFun A (Fin a.length) i))))) = a.get i := by
  let x := exteriorPower.ιMulti A 1 (fun _ => Pi.basisFun A (Fin a.length) i)
  calc
    _ = exteriorPower.zeroEquiv A _ (differential (listForm a) 0 x) :=
      congrArg (exteriorPower.zeroEquiv A _) (koszulCochain_d_apply a 0 x)
    _ = _ := by
      rw [differential_one]
      simp only [x, exteriorPower.oneEquiv_ιMulti, listForm_basis]

set_option backward.isDefEq.respectTransparency false in
/-- In degree zero the augmentation is the quotient map after identifying `Λ⁰` with `A`. -/
theorem koszulCochainAugmentation_f_zero (a : List A) :
    (koszulCochainAugmentation a).f 0 ≫
        (singleObjXSelf (.up ℤ) 0 (ModuleCat.of A (A ⧸ listIdeal a))).hom =
      (koszulCochainTermIso a 0).hom ≫
        ModuleCat.ofHom ((listIdeal a).mkQ.comp
          (exteriorPower.zeroEquiv A (Fin a.length → A)).toLinearMap) := by
  have h : embeddingDownNat.f 0 = 0 := rfl
  simp only [koszulCochainAugmentation, koszulStalkIso, comp_f, Category.assoc]
  erw [extendMap_f (augmentation a) _ h, extendSingleIso_hom_f _ _ _ _ h]
  simp [koszulCochainTermIso, augmentationZero]

set_option backward.isDefEq.respectTransparency false in
/-- The comparison of cohomology with homology intertwines the actual augmentations. -/
theorem koszulCochainAugmentation_homology (a : List A) (n : ℕ) :
    homologyMap (koszulCochainAugmentation a) (-(n : ℤ)) =
      (koszulCochainHomologyIso a n).hom ≫ homologyMap (augmentation a) n ≫
        (extendHomologyIso
          ((ChainComplex.single₀ (ModuleCat A)).obj (ModuleCat.of A (A ⧸ listIdeal a)))
          embeddingDownNat (j := n) rfl).inv ≫
        homologyMap (koszulStalkIso (ModuleCat.of A (A ⧸ listIdeal a))).hom (-(n : ℤ)) := by
  rw [koszulCochainAugmentation, homologyMap_comp, koszulCochainHomologyIso]
  erw [← extendHomologyIso_hom_naturality_assoc (augmentation a) embeddingDownNat
    (j := n) (j' := -(n : ℤ)) rfl]
  simp

private theorem koszulCochain_isZero_pos (a : List A) (i : ℤ) (hi : 0 < i) :
    IsZero ((koszulCochain a).X i) := by
  refine (listComplex a).isZero_extend_X embeddingDownNat i (fun n hn => ?_)
  change -(n : ℤ) = i at hn
  omega

/-- A finite regular sequence gives a bounded finite free resolution of its quotient. -/
theorem koszulCochain_finiteFree_resolution (a : List A) (ha : RingTheory.Sequence.IsRegular A a) :
    QuasiIso (koszulCochainAugmentation a) ∧
    (∀ i : ℤ, Epi ((koszulCochainAugmentation a).f i)) ∧
    (∀ i : ℤ, Module.Free A ((koszulCochain a).X i) ∧
      Module.Finite A ((koszulCochain a).X i)) ∧
    (∀ i : ℤ, i ∉ Set.Icc (-(a.length : ℤ)) 0 → IsZero ((koszulCochain a).X i)) := by
  obtain ⟨_, _, _, hFree, hBound⟩ := finite_free_resolution a ha
  refine ⟨?_, ?_, ?_, ?_⟩
  · have := augmentation_quasiIso a ha
    exact quasiIso_comp (extendMap (augmentation a) embeddingDownNat) (koszulStalkIso _).hom
  · intro i
    by_cases hi : i = 0
    · subst i
      let σ := singleObjXSelf (.up ℤ) 0 (ModuleCat.of A (A ⧸ listIdeal a))
      have hπ : Epi (augmentationZero a) :=
        (ModuleCat.epi_iff_surjective _).mpr (augmentationZero_surjective a)
      have hcomp : Epi ((koszulCochainAugmentation a).f 0 ≫ σ.hom) := by
        rw [koszulCochainAugmentation_f_zero]
        change Epi ((koszulCochainTermIso a 0).hom ≫ augmentationZero a)
        exact epi_comp' (f := (koszulCochainTermIso a 0).hom) (by infer_instance) hπ
      exact (epi_comp_iff_of_isIso ((koszulCochainAugmentation a).f 0) σ.hom).mp hcomp
    · exact (isZero_single_obj_X (.up ℤ) 0 _ i hi).epi _
  · intro i
    by_cases hi : 0 < i
    · have : Subsingleton ((koszulCochain a).X i) :=
        ModuleCat.isZero_iff_subsingleton.mp (koszulCochain_isZero_pos a i hi)
      refine ⟨inferInstance, ⟨?_⟩⟩
      rw [Subsingleton.elim (⊤ : Submodule A ((koszulCochain a).X i)) ⊥]
      exact Submodule.fg_bot
    · obtain ⟨n, rfl⟩ : ∃ n : ℕ, -(n : ℤ) = i :=
        ⟨(-i).toNat, by rw [Int.toNat_of_nonneg (by omega : 0 ≤ -i), neg_neg]⟩
      obtain ⟨hF, hG⟩ := hFree n
      let e := (koszulCochainTermIso a n).symm.toLinearEquiv
      exact ⟨Module.Free.of_equiv' hF e, Module.Finite.equiv e⟩
  · intro i hi
    by_cases hp : 0 < i
    · exact koszulCochain_isZero_pos a i hp
    · obtain ⟨n, rfl⟩ : ∃ n : ℕ, -(n : ℤ) = i :=
        ⟨(-i).toNat, by rw [Int.toNat_of_nonneg (by omega : 0 ≤ -i), neg_neg]⟩
      have hn : a.length < n := by
        simp only [Set.mem_Icc, not_and_or, not_le] at hi
        omega
      exact (hBound n hn).of_iso (koszulCochainTermIso a n)

end DerivedFormalization
