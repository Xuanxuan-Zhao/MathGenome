import MathGenome.Internal.GroupTheorySupplement.Specs.ALG02GroupTheory.Homology.FiveTerm
import MathGenome.Internal.GroupTheorySupplement.Specs.ALG02GroupTheory.Homology.FreeGroupVanishing

universe u

namespace ALG02GroupTheory.HopfFormula

open IntegralBar BarProjectionKernel FiveTerm

noncomputable section

variable {R F G R' F' G' R'' F'' : Type u}
variable [Group R] [Group F] [Group G] [Group R'] [Group F'] [Group G']
variable [Group R''] [Group F'']

/-- The intersection in the middle group of the relators and the derived subgroup. -/
abbrev numerator (M : Subgroup F) : Subgroup F := M ⊓ commutator F

/-- The ambient subgroup generated by commutators with the relators. -/
abbrev denominator (M : Subgroup F) : Subgroup F := ⁅(⊤ : Subgroup F), M⁆

/-- The Hopf quotient with the ambient denominator restricted to the numerator. -/
abbrev PresentationQuotient (M : Subgroup F) [M.Normal] :=
  numerator M ⧸ (denominator M).subgroupOf (numerator M)

/-- Inclusion of the Hopf quotient into the conjugation coinvariants of the kernel. -/
def toKernelQuotient (S : GroupExtension R F G) :
    PresentationQuotient S.inl.range →* KernelQuotient S :=
  QuotientGroup.map _ _
    ((MonoidHom.ofInjective S.inl_injective).symm.toMonoidHom.comp
      (Subgroup.inclusion inf_le_left)) (by
    intro x hx
    change S.inl ((MonoidHom.ofInjective S.inl_injective).symm
      (Subgroup.inclusion inf_le_left x)) ∈ denominator S.inl.range
    rw [show S.inl ((MonoidHom.ofInjective S.inl_injective).symm
      (Subgroup.inclusion inf_le_left x)) = x.val from congrArg Subtype.val
        ((MonoidHom.ofInjective S.inl_injective).apply_symm_apply
          (Subgroup.inclusion inf_le_left x))]
    exact hx)

/-- The map on kernel coinvariants induced by inclusion into the middle group
and projection to its abelianization. -/
def toAbelianization (S : GroupExtension R F G) : KernelQuotient S →* Abelianization F :=
  QuotientGroup.lift _ (Abelianization.of.comp S.inl) (by
    intro r hr
    change Abelianization.of (S.inl r) = 1
    apply (QuotientGroup.eq_one_iff _).2
    exact (Subgroup.commutator_mono_right (show S.inl.range ≤ ⊤ from le_top)) hr)

private theorem map_relators_le {S : GroupExtension R F G} {T : GroupExtension R' F' G'}
    (f : ExtensionHom S T) : S.inl.range.map f.middle ≤ T.inl.range := by
  rw [MonoidHom.map_range, f.inl_comm]
  rintro _ ⟨r, rfl⟩
  exact ⟨f.kernel r, rfl⟩

/-- Restrict the middle map to the intersection of the relators and the derived subgroup. -/
def mapNumerator {S : GroupExtension R F G} {T : GroupExtension R' F' G'}
    (f : ExtensionHom S T) : numerator S.inl.range →* numerator T.inl.range :=
  (f.middle.comp (numerator S.inl.range).subtype).codRestrict (numerator T.inl.range)
    (fun x => by
      refine ⟨map_relators_le f (Subgroup.mem_map_of_mem _ x.2.1), ?_⟩
      have h : (commutator F).map f.middle ≤ commutator F' := by
        rw [map_commutator_eq, commutator_def]
        exact Subgroup.commutator_mono le_top le_top
      exact h (Subgroup.mem_map_of_mem _ x.2.2))

/-- The map of Hopf quotients sends the class of a relator in the derived
subgroup to the class of its image under the middle homomorphism. -/
def presentationMap {S : GroupExtension R F G} {T : GroupExtension R' F' G'}
    (f : ExtensionHom S T) :
    PresentationQuotient S.inl.range →* PresentationQuotient T.inl.range :=
  QuotientGroup.map _ _ (mapNumerator f) (by
    intro x hx
    change f.middle x.val ∈ denominator T.inl.range
    apply Subgroup.commutator_mono le_top (map_relators_le f)
    rw [← Subgroup.map_commutator]
    exact Subgroup.mem_map_of_mem _ hx)

namespace Spec

/-- The displayed quotient is abelian. -/
def QuotientAbelian : Prop :=
  ∀ (F : Type u) [Group F] (M : Subgroup F) [M.Normal],
    IsMulCommutative (PresentationQuotient M)

/-- The inclusion of the displayed quotient identifies it with the kernel of
the induced map from the relator coinvariants to the abelianization. -/
def KernelIdentification : Prop :=
  ∀ {R F G : Type u} [Group R] [Group F] [Group G] (S : GroupExtension R F G),
    Function.Injective (toKernelQuotient S) ∧
      Function.MulExact (toKernelQuotient S) (toAbelianization S)

/-- Hopf's isomorphism, with its sign and map fixed by the five-term
transgression, and its naturality for maps of free presentations. -/
def NaturalHopfFormula : Prop :=
  ∃ (e : ∀ {R F G : Type u} [Group R] [Group F] [Group G] [IsFreeGroup F]
      (S : GroupExtension R F G), Multiplicative (homology G 2) ≃*
        PresentationQuotient S.inl.range)
    (d : ∀ {R F G : Type u} [Group R] [Group F] [Group G] [IsFreeGroup F]
      (S : GroupExtension R F G), Multiplicative (homology G 2) →* KernelQuotient S),
    (∀ {R F G : Type u} [Group R] [Group F] [Group G] [IsFreeGroup F]
      (S : GroupExtension R F G), FiveTerm.Spec.IsSignedTransgression S (d S) ∧
        ∀ x, toKernelQuotient S (e S x) = d S x) ∧
    (∀ {R F G R' F' G' : Type u} [Group R] [Group F] [Group G]
      [Group R'] [Group F'] [Group G'] [IsFreeGroup F] [IsFreeGroup F']
      {S : GroupExtension R F G} {T : GroupExtension R' F' G'}
      (f : ExtensionHom S T) (x : homology G 2),
      presentationMap f (e S (Multiplicative.ofAdd x)) =
        e T (Multiplicative.ofAdd (homologyMap f.quotient 2 x)))

/-- Every middle homomorphism lifting the quotient homomorphism restricts
to a map of the specified kernels. -/
def LiftExtension : Prop :=
  ∀ {R F G R' F' G' : Type u} [Group R] [Group F] [Group G]
    [Group R'] [Group F'] [Group G'] (S : GroupExtension R F G) (T : GroupExtension R' F' G')
    (b : G →* G') (a : F →* F') (_ : T.rightHom.comp a = b.comp S.rightHom),
    ∃ f : ExtensionHom S T, f.middle = a ∧ f.quotient = b

/-- A quotient homomorphism can be lifted through any free presentation of
its source and any presentation of its target. -/
def LiftExistence : Prop :=
  ∀ {R F G R' F' G' : Type u} [Group R] [Group F] [Group G]
    [Group R'] [Group F'] [Group G'] [IsFreeGroup F]
    (S : GroupExtension R F G) (T : GroupExtension R' F' G') (b : G →* G'),
    ∃ f : ExtensionHom S T, f.quotient = b

/-- The map on the displayed quotient depends only on the quotient homomorphism. -/
def LiftIndependence : Prop :=
  ∀ {R F G R' F' G' : Type u} [Group R] [Group F] [Group G]
    [Group R'] [Group F'] [Group G'] {S : GroupExtension R F G} {T : GroupExtension R' F' G'}
    (f g : ExtensionHom S T), f.quotient = g.quotient → presentationMap f = presentationMap g

/-- The identity of the quotient group yields the canonical comparison of
two free presentations. These comparisons satisfy identity and composition. -/
def PresentationComparison : Prop :=
  ∃ c : ∀ {R F R' F' G : Type u} [Group R] [Group F] [Group R'] [Group F'] [Group G]
      [IsFreeGroup F] [IsFreeGroup F'] (S : GroupExtension R F G) (T : GroupExtension R' F' G),
      PresentationQuotient S.inl.range ≃* PresentationQuotient T.inl.range,
    (∀ {R F R' F' G : Type u} [Group R] [Group F] [Group R'] [Group F'] [Group G]
      [IsFreeGroup F] [IsFreeGroup F'] {S : GroupExtension R F G} {T : GroupExtension R' F' G}
      (f : ExtensionHom S T), f.quotient = MonoidHom.id G → (c S T).toMonoidHom = presentationMap f) ∧
    (∀ {R F G : Type u} [Group R] [Group F] [Group G] [IsFreeGroup F]
      (S : GroupExtension R F G), c S S = MulEquiv.refl _) ∧
    (∀ {R F R' F' R'' F'' G : Type u} [Group R] [Group F] [Group R'] [Group F']
      [Group R''] [Group F''] [Group G] [IsFreeGroup F] [IsFreeGroup F'] [IsFreeGroup F'']
      (S : GroupExtension R F G) (T : GroupExtension R' F' G) (U : GroupExtension R'' F'' G),
      (c S T).trans (c T U) = c S U)

end Spec
end
end ALG02GroupTheory.HopfFormula
