import Mathlib.Algebra.Colimit.DirectLimit
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.LinearAlgebra.Matrix.Reindex

/-!
# Stable general linear, elementary, and Steinberg groups

The matrix index `i : ℕ` encodes the positive index `i + 1`. Finite matrices
of rank `n` accordingly have indices `Fin n`. All constructions use an
associative unital ring, with no commutativity assumption on multiplication.
-/

namespace ALG02GroupTheory.Extensions.StableSteinberg.Spec

open scoped commutatorElement

variable {R : Type*} [Ring R]

/-- The group of invertible matrices of rank `n`. -/
abbrev FiniteGL (R : Type*) [Ring R] (n : ℕ) := (Matrix (Fin n) (Fin n) R)ˣ

private def blockIndex {n m : ℕ} (h : n ≤ m) : Fin n ⊕ Fin (m - n) ≃ Fin m :=
  finSumFinEquiv.trans (finCongr (Nat.add_sub_of_le h))

/-- Pad a square matrix with an identity matrix in the lower-right block. -/
def blockMatrix {n m : ℕ} (h : n ≤ m) :
    Matrix (Fin n) (Fin n) R →* Matrix (Fin m) (Fin m) R where
  toFun A := Matrix.reindexRingEquiv R (blockIndex h)
    (Matrix.fromBlocks A 0 0 (1 : Matrix (Fin (m - n)) (Fin (m - n)) R))
  map_one' := by simp
  map_mul' A B := by simp [Matrix.fromBlocks_multiply]

theorem blockMatrix_apply {n m : ℕ} (h : n ≤ m)
    (A : Matrix (Fin n) (Fin n) R) (i j : Fin m) :
    blockMatrix h A i j =
      if hi : (i : ℕ) < n then
        if hj : (j : ℕ) < n then A ⟨i, hi⟩ ⟨j, hj⟩ else 0
      else if (j : ℕ) < n then 0 else (1 : Matrix (Fin m) (Fin m) R) i j := by
  obtain ⟨i, rfl⟩ := (blockIndex h).surjective i
  obtain ⟨j, rfl⟩ := (blockIndex h).surjective j
  have left (a : Fin n) : ((blockIndex h (Sum.inl a) : Fin m) : ℕ) = a := rfl
  have right (a : Fin (m - n)) :
      ((blockIndex h (Sum.inr a) : Fin m) : ℕ) = n + a := rfl
  have right_not_lt (a : Fin (m - n)) :
      ¬ ((blockIndex h (Sum.inr a) : Fin m) : ℕ) < n := by rw [right]; omega
  change Matrix.fromBlocks A 0 0 (1 : Matrix (Fin (m - n)) (Fin (m - n)) R)
    ((blockIndex h).symm ((blockIndex h) i)) ((blockIndex h).symm ((blockIndex h) j)) = _
  simp only [Equiv.symm_apply_apply]
  rcases i with i | i <;> rcases j with j | j <;>
    simp [left, right_not_lt, Fin.is_lt, Matrix.one_apply]

/-- The block inclusion `g ↦ diag(g, I)` on matrix units. -/
def blockGL {n m : ℕ} (h : n ≤ m) : FiniteGL R n →* FiniteGL R m :=
  Units.map (blockMatrix h)

instance finiteGLDirectedSystem (R : Type*) [Ring R] :
    DirectedSystem (FiniteGL R) (fun _ _ h ↦ blockGL h) where
  map_self {_} A := by
    apply Units.ext
    ext i j
    simp [blockGL, blockMatrix_apply, i.is_lt, j.is_lt]
  map_map {k j i} hij hjk A := by
    apply Units.ext
    ext a b
    change blockMatrix hjk (blockMatrix hij A.val) a b =
      blockMatrix (hij.trans hjk) A.val a b
    by_cases ha : (a : ℕ) < j <;> by_cases hb : (b : ℕ) < j <;>
      by_cases hai : (a : ℕ) < i <;> by_cases hbi : (b : ℕ) < i
    all_goals try omega
    all_goals simp [blockMatrix_apply, ha, hb, hai, hbi, Matrix.one_apply, ← Fin.val_inj]
    all_goals omega

/-- The direct limit of the finite general linear groups by block inclusion. -/
abbrev StableGL (R : Type*) [Ring R] :=
  DirectLimit (FiniteGL R) (fun _ _ h ↦ blockGL h)

/-- The canonical inclusion from finite rank into the stable group. -/
noncomputable def ofFinite (n : ℕ) : FiniteGL R n →* StableGL R where
  toFun A := ⟦⟨n, A⟩⟧
  map_one' := (DirectLimit.one_def n).symm
  map_mul' _ _ := (DirectLimit.mul_def n _ _).symm

/-- The indices and ring coefficient of (x_{ij}(r)). -/
structure Generator (R : Type*) where
  row : ℕ
  col : ℕ
  distinct : row ≠ col
  coeff : R

/-- The finite invertible matrix (I+rE_{ij}). -/
def finiteTransvection {n : ℕ} (i j : Fin n) (hij : i ≠ j) (r : R) : FiniteGL R n where
  val := 1 + Matrix.single i j r
  inv := 1 + Matrix.single i j (-r)
  val_inv := by
    simp [Matrix.add_mul, Matrix.mul_add, hij.symm, add_assoc, ← Matrix.single_add]
  inv_val := by
    simp [Matrix.add_mul, Matrix.mul_add, hij.symm, add_assoc, ← Matrix.single_add]

/-- The stable transvection is represented at any finite rank containing the indices. -/
noncomputable def transvection (g : Generator R) : StableGL R :=
  let n := max g.row g.col + 1
  ofFinite n (finiteTransvection (⟨g.row, by dsimp [n]; omega⟩ : Fin n)
    ⟨g.col, by dsimp [n]; omega⟩ (fun h ↦ g.distinct (congrArg Fin.val h)) g.coeff)

/-- The stable elementary subgroup generated by all transvections. -/
noncomputable def ElementarySubgroup (R : Type*) [Ring R] : Subgroup (StableGL R) :=
  Subgroup.closure (Set.range (transvection (R := R)))

/-- The stable elementary group (E(R)). -/
abbrev Elementary (R : Type*) [Ring R] := ↥(ElementarySubgroup R)

/-- A stable transvection as an element of (E(R)). -/
noncomputable def elementary (g : Generator R) : Elementary R :=
  ⟨transvection g, Subgroup.subset_closure ⟨g, rfl⟩⟩

/-- Free group words imposing the three stable Steinberg relations. -/
inductive IsRelator (R : Type*) [Ring R] : FreeGroup (Generator R) → Prop
  | add {i j : ℕ} (hij : i ≠ j) (r s : R) :
      IsRelator R (FreeGroup.of ⟨i, j, hij, r⟩ * FreeGroup.of ⟨i, j, hij, s⟩ *
        (FreeGroup.of ⟨i, j, hij, r + s⟩)⁻¹)
  | disjoint (g h : Generator R) (hjk : g.col ≠ h.row) (hil : g.row ≠ h.col) :
      IsRelator R ⁅FreeGroup.of g, FreeGroup.of h⁆
  | chain {i j k : ℕ} (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (r s : R) :
      IsRelator R (⁅FreeGroup.of (⟨i, j, hij, r⟩ : Generator R), FreeGroup.of ⟨j, k, hjk, s⟩⁆ *
        (FreeGroup.of ⟨i, k, hik, r * s⟩)⁻¹)

/-- The set of relators in the free group on the stable generators. -/
def relators (R : Type*) [Ring R] : Set (FreeGroup (Generator R)) :=
  {w | IsRelator R w}

/-- The stable Steinberg group, given by the presentation on all distinct index pairs. -/
abbrev Steinberg (R : Type*) [Ring R] := PresentedGroup (relators R)

/-- The canonical generator of the presented group. -/
def generator (g : Generator R) : Steinberg R := PresentedGroup.of g

theorem ofFinite_blockGL {n m : ℕ} (h : n ≤ m) (A : FiniteGL R n) :
    ofFinite m (blockGL h A) = ofFinite n A :=
  DirectLimit.mk_apply n m A h

theorem blockGL_finiteTransvection {n m : ℕ} (h : n ≤ m) (i j : Fin n)
    (hij : i ≠ j) (r : R) :
    blockGL h (finiteTransvection i j hij r) =
      finiteTransvection (Fin.castLE h i) (Fin.castLE h j)
        (fun e ↦ hij (Fin.ext (congrArg (fun a : Fin m ↦ (a : ℕ)) e))) r := by
  apply Units.ext
  ext a b
  change blockMatrix h (1 + Matrix.single i j r) a b =
    (1 + Matrix.single (Fin.castLE h i) (Fin.castLE h j) r) a b
  have row_out (ha : ¬ (a : ℕ) < n) : (i : ℕ) ≠ (a : ℕ) := by
    have := i.is_lt
    omega
  have col_out (hb : ¬ (b : ℕ) < n) : (j : ℕ) ≠ (b : ℕ) := by
    have := j.is_lt
    omega
  by_cases ha : (a : ℕ) < n <;> by_cases hb : (b : ℕ) < n
  all_goals simp [blockMatrix_apply, ha, hb, Matrix.single, Matrix.one_apply, ← Fin.val_inj,
    row_out, col_out]
  all_goals omega

theorem transvection_eq_ofFinite (g : Generator R) {n : ℕ}
    (hi : g.row < n) (hj : g.col < n) :
    transvection g = ofFinite n (finiteTransvection (⟨g.row, hi⟩ : Fin n) ⟨g.col, hj⟩
      (fun e ↦ g.distinct (congrArg Fin.val e)) g.coeff) := by
  have h : max g.row g.col + 1 ≤ n := by omega
  unfold transvection
  rw [← ofFinite_blockGL h, blockGL_finiteTransvection]
  rfl

theorem finiteTransvection_add {n : ℕ} (i j : Fin n) (hij : i ≠ j) (r s : R) :
    finiteTransvection i j hij r * finiteTransvection i j hij s =
      finiteTransvection i j hij (r + s) := by
  apply Units.ext
  change (1 + Matrix.single i j r) * (1 + Matrix.single i j s) =
    1 + Matrix.single i j (r + s)
  simp [Matrix.add_mul, Matrix.mul_add, hij.symm, Matrix.single_add, add_assoc]

theorem finiteTransvection_disjoint {n : ℕ} (i j k l : Fin n) (hij : i ≠ j) (hkl : k ≠ l)
    (hjk : j ≠ k) (hil : i ≠ l) (r s : R) :
    ⁅finiteTransvection i j hij r, finiteTransvection k l hkl s⁆ = 1 := by
  rw [commutatorElement_eq_one_iff_mul_comm]
  apply Units.ext
  change (1 + Matrix.single i j r) * (1 + Matrix.single k l s) =
    (1 + Matrix.single k l s) * (1 + Matrix.single i j r)
  simp [Matrix.add_mul, Matrix.mul_add, hjk, hil.symm, add_comm, add_left_comm]

theorem finiteTransvection_chain {n : ℕ} (i j k : Fin n) (hij : i ≠ j) (hjk : j ≠ k)
    (hik : i ≠ k) (r s : R) :
    ⁅finiteTransvection i j hij r, finiteTransvection j k hjk s⁆ =
      finiteTransvection i k hik (r * s) := by
  let A := finiteTransvection i j hij r
  let B := finiteTransvection j k hjk s
  let C := finiteTransvection i k hik (r * s)
  change ⁅A, B⁆ = C
  have h : A * B = C * (B * A) := by
    apply Units.ext
    change (1 + Matrix.single i j r) * (1 + Matrix.single j k s) =
      (1 + Matrix.single i k (r * s)) * ((1 + Matrix.single j k s) * (1 + Matrix.single i j r))
    simp [Matrix.add_mul, Matrix.mul_add, hjk.symm, hik.symm,
      add_assoc, add_comm, add_left_comm]
  rw [commutatorElement_def, h]
  simp [mul_assoc]

/-- The three defining Steinberg equations for a family of elements of a group. -/
def SatisfiesRelations {G : Type*} [Group G] (x : Generator R → G) : Prop :=
  (∀ (i j : ℕ) (hij : i ≠ j) (r s : R),
    x ⟨i, j, hij, r⟩ * x ⟨i, j, hij, s⟩ = x ⟨i, j, hij, r + s⟩) ∧
  (∀ (g h : Generator R), g.col ≠ h.row → g.row ≠ h.col → ⁅x g, x h⁆ = 1) ∧
  (∀ (i j k : ℕ) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (r s : R),
    ⁅x ⟨i, j, hij, r⟩, x ⟨j, k, hjk, s⟩⁆ = x ⟨i, k, hik, r * s⟩)

theorem transvection_satisfiesRelations : SatisfiesRelations (transvection (R := R)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro i j hij r s
    let n := max i j + 1
    have hi : i < n := by dsimp [n]; omega
    have hj : j < n := by dsimp [n]; omega
    have h : (⟨i, hi⟩ : Fin n) ≠ ⟨j, hj⟩ := fun e ↦ hij (congrArg Fin.val e)
    rw [transvection_eq_ofFinite ⟨i, j, hij, r⟩ hi hj,
      transvection_eq_ofFinite ⟨i, j, hij, s⟩ hi hj,
      transvection_eq_ofFinite ⟨i, j, hij, r + s⟩ hi hj, ← map_mul,
      finiteTransvection_add _ _ h]
  · intro g h hjk hil
    let n := max (max g.row g.col) (max h.row h.col) + 1
    have hi : g.row < n := by dsimp [n]; omega
    have hj : g.col < n := by dsimp [n]; omega
    have hk : h.row < n := by dsimp [n]; omega
    have hl : h.col < n := by dsimp [n]; omega
    let i : Fin n := ⟨g.row, hi⟩
    let j : Fin n := ⟨g.col, hj⟩
    let k : Fin n := ⟨h.row, hk⟩
    let l : Fin n := ⟨h.col, hl⟩
    rw [transvection_eq_ofFinite g hi hj, transvection_eq_ofFinite h hk hl, ← map_commutatorElement]
    rw [finiteTransvection_disjoint i j k l _ _ (fun e ↦ hjk (congrArg Fin.val e))
      (fun e ↦ hil (congrArg Fin.val e)), map_one]
  · intro i j k hij hjk hik r s
    let n := max (max i j) k + 1
    have hi : i < n := by dsimp [n]; omega
    have hj : j < n := by dsimp [n]; omega
    have hk : k < n := by dsimp [n]; omega
    rw [transvection_eq_ofFinite ⟨i, j, hij, r⟩ hi hj,
      transvection_eq_ofFinite ⟨j, k, hjk, s⟩ hj hk,
      transvection_eq_ofFinite ⟨i, k, hik, r * s⟩ hi hk,
      ← map_commutatorElement, finiteTransvection_chain]

theorem elementary_satisfiesRelations : SatisfiesRelations (elementary (R := R)) := by
  have h := transvection_satisfiesRelations (R := R)
  refine ⟨?_, ?_, ?_⟩
  · intro i j hij r s
    exact Subtype.ext (h.1 i j hij r s)
  · intro g k hjk hil
    apply (ElementarySubgroup R).subtype_injective
    rw [map_commutatorElement, map_one]
    exact h.2.1 g k hjk hil
  · intro i j k hij hjk hik r s
    apply (ElementarySubgroup R).subtype_injective
    rw [map_commutatorElement]
    exact h.2.2 i j k hij hjk hik r s

theorem killsRelators {G : Type*} [Group G] {x : Generator R → G} (hx : SatisfiesRelations x) :
    ∀ w ∈ relators R, FreeGroup.lift x w = 1 := by
  intro w hw
  change IsRelator R w at hw
  cases hw with
  | add hij r s => simp [hx.1 _ _ hij r s]
  | disjoint g h hjk hil =>
    simpa only [map_commutatorElement, FreeGroup.lift_apply_of] using hx.2.1 g h hjk hil
  | chain hij hjk hik r s =>
    simp [map_commutatorElement, hx.2.2 _ _ _ hij hjk hik r s]

/-- The map out of the Steinberg presentation determined by a family satisfying its relations. -/
def lift {G : Type*} [Group G] {x : Generator R → G} (hx : SatisfiesRelations x) :
    Steinberg R →* G :=
  PresentedGroup.toGroup (killsRelators hx)

/-- The canonical map taking Steinberg generators to elementary matrices. -/
noncomputable def toElementary : Steinberg R →* Elementary R :=
  lift elementary_satisfiesRelations

/-- The classical (K_2(R)), viewed as the kernel subgroup of (operatorname{St}(R)). -/
noncomputable def K₂ (R : Type*) [Ring R] : Subgroup (Steinberg R) :=
  (toElementary (R := R)).ker


universe u v

def FiniteGLType := ∀ (R : Type u) [Ring R], ℕ → Type u

def BlockGLType := ∀ {R : Type u} [Ring R] {n m : ℕ}, n ≤ m → FiniteGL R n →* FiniteGL R m

def StableGroupType := ∀ (R : Type u) [Ring R], Type u

def OfFiniteType := ∀ {R : Type u} [Ring R] (n : ℕ), FiniteGL R n →* StableGL R

def FiniteTransvectionType :=
  ∀ {R : Type u} [Ring R] {n : ℕ} (i j : Fin n), i ≠ j → R → FiniteGL R n

def TransvectionType := ∀ {R : Type u} [Ring R], Generator R → StableGL R

def ElementarySubgroupType := ∀ (R : Type u) [Ring R], Subgroup (StableGL R)

def ElementaryGeneratorType := ∀ {R : Type u} [Ring R], Generator R → Elementary R

def RelatorsType := ∀ (R : Type u) [Ring R], Set (FreeGroup (Generator R))

def SteinbergGeneratorType := ∀ {R : Type u} [Ring R], Generator R → Steinberg R

def SteinbergMapType := ∀ {R : Type u} [Ring R], Steinberg R →* Elementary R

def K₂Type := ∀ (R : Type u) [Ring R], Subgroup (Steinberg R)

def BlockGLCoordinates : Prop :=
  ∀ {R : Type u} [Ring R] {n m : ℕ} (h : n ≤ m) (A : FiniteGL R n) (i j : Fin m),
    (blockGL h A).val i j =
      if hi : (i : ℕ) < n then
        if hj : (j : ℕ) < n then A.val ⟨i, hi⟩ ⟨j, hj⟩ else 0
      else if (j : ℕ) < n then 0 else (1 : Matrix (Fin m) (Fin m) R) i j

def BlockGLInjective : Prop :=
  ∀ {R : Type u} [Ring R] {n m : ℕ} (h : n ≤ m),
    Function.Injective (blockGL (R := R) h)

def StableInclusionsInjective : Prop :=
  ∀ {R : Type u} [Ring R] (n : ℕ), Function.Injective (ofFinite (R := R) n)

def StableInclusionsCompatible : Prop :=
  ∀ {R : Type u} [Ring R] {n m : ℕ} (h : n ≤ m) (A : FiniteGL R n),
    ofFinite m (blockGL h A) = ofFinite n A

def StableElementsAtFiniteRank : Prop :=
  ∀ {R : Type u} [Ring R] (A : StableGL R),
    ∃ (n : ℕ) (B : FiniteGL R n), A = ofFinite n B

def TransvectionAtFiniteRank : Prop :=
  ∀ {R : Type u} [Ring R] (g : Generator R) {n : ℕ} (hi : g.row < n) (hj : g.col < n),
    transvection g = ofFinite n (finiteTransvection (⟨g.row, hi⟩ : Fin n) ⟨g.col, hj⟩
      (fun e ↦ g.distinct (congrArg Fin.val e)) g.coeff)

def SteinbergRelations : Prop :=
  ∀ {R : Type u} [Ring R], SatisfiesRelations (generator (R := R))

def ElementaryRelations : Prop :=
  ∀ {R : Type u} [Ring R], SatisfiesRelations (elementary (R := R))

def ReverseChainRelation : Prop :=
  ∀ {R : Type u} [Ring R] {G : Type v} [Group G] {x : Generator R → G},
    SatisfiesRelations x → ∀ {i j k : ℕ} (hij : i ≠ j) (hki : k ≠ i) (hkj : k ≠ j) (r s : R),
      ⁅x ⟨i, j, hij, r⟩, x ⟨k, i, hki, s⟩⁆ = x ⟨k, j, hkj, -(s * r)⟩

def SteinbergUniversalProperty : Prop :=
  ∀ {R : Type u} [Ring R] {G : Type v} [Group G] (x : Generator R → G),
    SatisfiesRelations x → ∃! φ : Steinberg R →* G, ∀ g, φ (generator g) = x g

def SteinbergMapOnGenerators : Prop :=
  ∀ {R : Type u} [Ring R] (g : Generator R), toElementary (generator g) = elementary g

def SteinbergMapSurjective : Prop :=
  ∀ {R : Type u} [Ring R], Function.Surjective (toElementary (R := R))

end ALG02GroupTheory.Extensions.StableSteinberg.Spec
