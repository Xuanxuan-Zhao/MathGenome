import MathGenome.Internal.GroupTheorySupplement.ALG02GroupTheory.Profinite.Cofinal
import MathGenome.Internal.GroupTheorySupplement.Specs.ALG02GroupTheory.Profinite.Integers
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Subgroup

/-! The completion of the additive integers, in residue and factorial coordinates. -/

namespace ALG02GroupTheory.Profinite

open AdvancedFieldTheory.ProfiniteIntegers.ResidueSystem
open Multiplicative (ofAdd toAdd)

abbrev IntegerGroup := Specs.ALG02GroupTheory.Profinite.IntegerGroup

/-- The finite-index subgroup corresponding to a positive modulus. -/
abbrev integerIndex := Specs.ALG02GroupTheory.Profinite.integerIndexValue

/-- Inclusion of integer subgroups reverses divisibility of their moduli. -/
theorem integer_index_le (m n : ℕ+) :
    integerIndex m ≤ integerIndex n ↔ (n : ℕ) ∣ (m : ℕ) := by
  change AddSubgroup.zmultiples ((m : ℕ) : ℤ) ≤ AddSubgroup.zmultiples ((n : ℕ) : ℤ) ↔ _
  rw [Int.zmultiples_le_zmultiples_iff, Int.natCast_dvd_natCast]

private theorem integer_index_injective : Function.Injective integerIndex := by
  intro m n h
  apply Subtype.ext
  exact Nat.dvd_antisymm ((integer_index_le n m).mp h.ge) ((integer_index_le m n).mp h.le)

/-- An additive subgroup of the integers has finite index exactly when it is
generated by a unique positive integer. -/
theorem integer_finite_index (H : AddSubgroup ℤ) :
    H.FiniteIndex ↔ ∃! n : ℕ+, H = AddSubgroup.zmultiples ((n : ℕ) : ℤ) := by
  constructor
  · intro hH
    obtain ⟨a, ha⟩ := H.isAddCyclic_iff_exists_zmultiples_eq_top.mp inferInstance
    have ha0 : a.natAbs ≠ 0 := by
      have hi := hH.index_ne_zero
      rwa [← ha, Int.index_zmultiples] at hi
    refine ⟨⟨a.natAbs, Nat.pos_of_ne_zero ha0⟩, ha.symm.trans (Int.zmultiples_natAbs a).symm, ?_⟩
    intro m hm
    apply integer_index_injective
    apply FiniteIndexNormalSubgroup.toSubgroup_injective
    apply congrArg AddSubgroup.toSubgroup
    exact hm.symm.trans (ha.symm.trans (Int.zmultiples_natAbs a).symm)
  · rintro ⟨n, hn, _⟩
    rw [AddSubgroup.finiteIndex_iff, hn, Int.index_zmultiples, Int.natAbs_natCast]
    exact n.ne_zero

/-- Positive moduli enumerate all the indices in the completion of the integers. -/
theorem integer_index_bijective : Function.Bijective integerIndex := by
  refine ⟨integer_index_injective, fun N => ?_⟩
  have hN : N.toSubgroup.toAddSubgroup.FiniteIndex :=
    AddSubgroup.finiteIndex_iff.mpr N.isFiniteIndex'.index_ne_zero
  obtain ⟨n, hn, _⟩ := (integer_finite_index N.toSubgroup.toAddSubgroup).mp hN
  exact ⟨n, FiniteIndexNormalSubgroup.toSubgroup_injective
    (congrArg AddSubgroup.toSubgroup hn.symm)⟩

/-- The quotient by the multiples of a modulus, identified with its residue group. -/
abbrev integerQuotientEquiv := Specs.ALG02GroupTheory.Profinite.integerQuotientEquivValue

@[simp]
theorem integer_quotient_mk (n : ℕ+) (a : ℤ) :
    integerQuotientEquiv n (QuotientGroup.mk (ofAdd a)) = ofAdd (a : ZMod (n : ℕ)) :=
  rfl

/-- The quotient transitions become ordinary reduction of residues. -/
theorem integer_transition (m n : ℕ+) (h : integerIndex m ≤ integerIndex n)
    (h' : (n : ℕ) ∣ (m : ℕ)) (x : finiteQuotient (integerIndex m)) :
    (integerQuotientEquiv n (transition h x)).toAdd =
      reduction n m h' (integerQuotientEquiv m x).toAdd := by
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
  change (a.toAdd : ZMod (n : ℕ)) = reduction n m h' (a.toAdd : ZMod (m : ℕ))
  exact (map_intCast (ZMod.castHom h' (ZMod (n : ℕ))) a.toAdd).symm

local instance (N : FiniteIndexNormalSubgroup IntegerGroup) :
    DiscreteTopology (finiteQuotient N) := ⟨rfl⟩

private def toIntegerResidues (x : Completion IntegerGroup) : Multiplicative ResidueFamily :=
  ofAdd ⟨fun n => (integerQuotientEquiv n (projection (integerIndex n) x)).toAdd, by
    intro n m h
    let hmn := (integer_index_le m n).mpr h
    rw [← integer_transition m n hmn h, projection_compatible]⟩

/-- Recover the finite-quotient coordinates by indexing them by the corresponding moduli. -/
private noncomputable def fromIntegerResidueCoordinates (x : Multiplicative ResidueFamily) :
    ∀ N : FiniteIndexNormalSubgroup IntegerGroup, finiteQuotient N :=
  (Equiv.piCongrLeft (fun N => ↥(finiteQuotient N)) (Equiv.ofBijective _ integer_index_bijective))
    (fun n => (integerQuotientEquiv n).symm (ofAdd (coordinate n x.toAdd)))

@[simp]
private theorem fromIntegerResidueCoordinates_apply (x : Multiplicative ResidueFamily)
    (n : ℕ+) :
    fromIntegerResidueCoordinates x (integerIndex n) =
      (integerQuotientEquiv n).symm (ofAdd (coordinate n x.toAdd)) :=
  Equiv.piCongrLeft_apply_apply _ _ _ n

private noncomputable def fromIntegerResidues (x : Multiplicative ResidueFamily) :
    Completion IntegerGroup :=
  (toCompatibleTuples IntegerGroup).symm ⟨fromIntegerResidueCoordinates x, by
    intro M N h
    obtain ⟨m, rfl⟩ := integer_index_bijective.surjective M
    obtain ⟨n, rfl⟩ := integer_index_bijective.surjective N
    apply (integerQuotientEquiv n).injective
    apply toAdd.injective
    change (integerQuotientEquiv n
      (transition h (fromIntegerResidueCoordinates x (integerIndex m)))).toAdd =
        (integerQuotientEquiv n (fromIntegerResidueCoordinates x (integerIndex n))).toAdd
    rw [integer_transition m n h ((integer_index_le m n).mp h)]
    simp only [fromIntegerResidueCoordinates_apply, MulEquiv.apply_symm_apply]
    exact x.toAdd.property n m ((integer_index_le m n).mp h)⟩

private noncomputable def integerCompletionEquiv :
    Completion IntegerGroup ≃ₜ* Multiplicative ResidueFamily where
  toFun := toIntegerResidues
  invFun := fromIntegerResidues
  left_inv x := by
    apply Subtype.ext
    funext N
    obtain ⟨n, rfl⟩ := integer_index_bijective.surjective N
    change fromIntegerResidueCoordinates (toIntegerResidues x) (integerIndex n) =
      projection (integerIndex n) x
    rw [fromIntegerResidueCoordinates_apply]
    exact (integerQuotientEquiv n).symm_apply_apply _
  right_inv x := by
    apply toAdd.injective
    apply Subtype.ext
    funext n
    change (integerQuotientEquiv n (fromIntegerResidueCoordinates x (integerIndex n))).toAdd =
      coordinate n x.toAdd
    rw [fromIntegerResidueCoordinates_apply, MulEquiv.apply_symm_apply]
    rfl
  map_mul' x y := by
    apply toAdd.injective
    apply Subtype.ext
    funext n
    change (integerQuotientEquiv n (projection (integerIndex n) (x * y))).toAdd =
      (integerQuotientEquiv n (projection (integerIndex n) x) *
        integerQuotientEquiv n (projection (integerIndex n) y)).toAdd
    rw [map_mul, map_mul]
  continuous_toFun := by
    apply continuous_induced_rng.mpr
    refine continuous_pi fun n => ?_
    exact (continuous_of_discreteTopology (f := fun q : finiteQuotient (integerIndex n) =>
      (integerQuotientEquiv n q).toAdd)).comp (projection (integerIndex n)).continuous_toFun
  continuous_invFun := by
    refine (toCompatibleTuples IntegerGroup).continuous_invFun.comp
      (continuous_induced_rng.mpr (continuous_pi fun N => ?_))
    change Continuous (fun x : Multiplicative ResidueFamily => fromIntegerResidueCoordinates x N)
    obtain ⟨n, rfl⟩ := integer_index_bijective.surjective N
    simp only [fromIntegerResidueCoordinates_apply]
    exact (continuous_of_discreteTopology (f := fun a : ZMod (n : ℕ) =>
      (integerQuotientEquiv n).symm (ofAdd a))).comp
      ((continuous_apply n).comp (continuous_subtype_val (p := fun a => Compatible a)))

/-- The completion is the compatible residue families, and its canonical map is
the family of ordinary integer residues. -/
theorem integer_completion : Specs.ALG02GroupTheory.Profinite.IntegerCompletion := by
  refine ⟨integerCompletionEquiv, fun _ _ => rfl, fun a => ?_⟩
  apply toAdd.injective
  apply Subtype.ext
  funext n
  change (integerQuotientEquiv n (projection (integerIndex n) (eta IntegerGroup (ofAdd a)))).toAdd =
    (a : ZMod (n : ℕ))
  rw [projection_eta, integer_quotient_mk]
  rfl

abbrev factorialModulus := Specs.ALG02GroupTheory.Profinite.factorialModulusValue

abbrev factorialIndices := Specs.ALG02GroupTheory.Profinite.factorialIndicesValue

/-- Each positive modulus divides its own factorial. -/
theorem factorial_cofinal :
    ∀ N : FiniteIndexNormalSubgroup IntegerGroup, ∃ d : factorialIndices, d.1 ≤ N := by
  intro N
  obtain ⟨n, rfl⟩ := integer_index_bijective.surjective N
  refine ⟨⟨integerIndex (factorialModulus n), ⟨n, rfl⟩⟩, (integer_index_le _ _).mpr ?_⟩
  exact Nat.dvd_factorial n.pos le_rfl

/-- Restriction to the factorial subgroups is a topological group isomorphism. -/
theorem factorial_completion : Specs.ALG02GroupTheory.Profinite.FactorialCompletion :=
  cofinal_restriction factorialIndices factorial_cofinal

/-- In the residue model the same map keeps the residues at the factorial moduli. -/
theorem factorial_residue_restriction :
    Specs.ALG02GroupTheory.Profinite.FactorialResidueRestriction := by
  obtain ⟨e, he, _⟩ := integer_completion
  obtain ⟨f, hf, _⟩ := factorial_completion
  refine ⟨e.symm.trans f, fun x j => ?_⟩
  change (integerQuotientEquiv (factorialModulus j)
    ((f (e.symm x)).1 ⟨_, ⟨j, rfl⟩⟩)).toAdd = coordinate (factorialModulus j) x.toAdd
  rw [congrFun hf (e.symm x)]
  change (integerQuotientEquiv (factorialModulus j)
    (projection (integerIndex (factorialModulus j)) (e.symm x))).toAdd = _
  exact (he (e.symm x) (factorialModulus j)).symm.trans
    (congrArg (fun y : Multiplicative ResidueFamily => coordinate (factorialModulus j) y.toAdd)
      (e.apply_symm_apply x))

end ALG02GroupTheory.Profinite
