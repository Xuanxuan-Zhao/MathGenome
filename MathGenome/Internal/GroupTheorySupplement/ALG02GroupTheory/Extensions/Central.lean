import Mathlib.Algebra.Group.ULift
import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.GroupTheory.GroupExtension.Defs
import Mathlib.GroupTheory.IsPerfect
import Mathlib.GroupTheory.QuotientGroup.Basic

namespace ALG02GroupTheory.Extensions

universe u v w t u' v'

/-- A central extension has its included kernel in the center of the middle group. -/
def IsCentralExtension {N : Type u} {E : Type v} {G : Type w}
    [Group N] [Group E] [Group G] (S : GroupExtension N E G) : Prop :=
  S.inl.range ≤ Subgroup.center E

/-- Centrality can also be checked directly on the prescribed projection. -/
theorem isCentralExtension_iff_ker_le_center {N : Type u} {E : Type v} {G : Type w}
    [Group N] [Group E] [Group G] (S : GroupExtension N E G) :
    IsCentralExtension S ↔ S.rightHom.ker ≤ Subgroup.center E := by
  unfold IsCentralExtension
  rw [S.range_inl_eq_ker_rightHom]

-- The comparison universe is a parameter of the universal property.
set_option linter.checkUnivs false in
/-- A universal central extension admits exactly one homomorphism over the fixed base group
to each central extension in the comparison universe. The comparison universe includes
the source middle group and base group and can be enlarged through the parameter `t`. -/
def IsUniversalCentralExtension {N : Type u} {E : Type v} {G : Type w}
    [Group N] [Group E] [Group G] (S : GroupExtension N E G) : Prop :=
  IsCentralExtension S ∧
    ∀ {K D : Type (max v w t)} [Group K] [Group D] (T : GroupExtension K D G),
      IsCentralExtension T → ∃! f : E →* D, T.rightHom.comp f = S.rightHom

/-- Apply universality to the actual target projection when the comparison universe contains
the target kernel and middle groups. The lifts leave the base group fixed. -/
theorem IsUniversalCentralExtension.existsUniqueHomOver
    {N : Type u} {E : Type v} {G : Type w} [Group N] [Group E] [Group G]
    {S : GroupExtension N E G} {K : Type u'} {D : Type v'} [Group K] [Group D]
    (hS : IsUniversalCentralExtension.{u, v, w, max t u' v'} S) (T : GroupExtension K D G)
    (hT : IsCentralExtension T) :
    ∃! f : E →* D, T.rightHom.comp f = S.rightHom := by
  let kernelEquiv : ULift.{max v w t u' v'} K ≃* K := MulEquiv.ulift
  let middleEquiv : ULift.{max v w t u' v'} D ≃* D := MulEquiv.ulift
  let lifted : GroupExtension (ULift.{max v w t u' v'} K) (ULift.{max v w t u' v'} D) G :=
    { inl := middleEquiv.symm.toMonoidHom.comp (T.inl.comp kernelEquiv.toMonoidHom)
      rightHom := T.rightHom.comp middleEquiv.toMonoidHom
      inl_injective := middleEquiv.symm.injective.comp (T.inl_injective.comp kernelEquiv.injective)
      range_inl_eq_ker_rightHom := by
        ext x
        change (∃ k, middleEquiv.symm (T.inl (kernelEquiv k)) = x) ↔
          T.rightHom (middleEquiv x) = 1
        rw [← MonoidHom.mem_ker, ← T.range_inl_eq_ker_rightHom]
        constructor
        · rintro ⟨k, rfl⟩
          exact ⟨kernelEquiv k, (middleEquiv.apply_symm_apply _).symm⟩
        · rintro ⟨k, hk⟩
          exact ⟨kernelEquiv.symm k, by
            rw [kernelEquiv.apply_symm_apply, hk, middleEquiv.symm_apply_apply]⟩
      rightHom_surjective := T.rightHom_surjective.comp middleEquiv.surjective }
  have hLifted : IsCentralExtension lifted := by
    rw [isCentralExtension_iff_ker_le_center]
    intro x hx
    have hImage : middleEquiv x ∈ Subgroup.center D :=
      (isCentralExtension_iff_ker_le_center T).mp hT hx
    apply Subgroup.mem_center_iff.mpr
    intro y
    apply middleEquiv.injective
    simpa only [map_mul] using Subgroup.mem_center_iff.mp hImage (middleEquiv y)
  obtain ⟨liftedMap, hLiftedMap, hUnique⟩ := hS.2 lifted hLifted
  refine ⟨middleEquiv.toMonoidHom.comp liftedMap, ?_, ?_⟩
  · change (T.rightHom.comp middleEquiv.toMonoidHom).comp liftedMap = S.rightHom at hLiftedMap
    simpa only [MonoidHom.comp_assoc] using hLiftedMap
  · intro f hf
    let g := middleEquiv.symm.toMonoidHom.comp f
    have hg : lifted.rightHom.comp g = S.rightHom := by
      ext x
      change T.rightHom (middleEquiv (middleEquiv.symm (f x))) = S.rightHom x
      rw [middleEquiv.apply_symm_apply]
      exact DFunLike.congr_fun hf x
    have heq := hUnique g hg
    ext x
    have hx := DFunLike.congr_fun heq x
    change middleEquiv.symm (f x) = liftedMap x at hx
    change f x = middleEquiv (liftedMap x)
    simpa only [middleEquiv.apply_symm_apply] using congrArg middleEquiv hx

/-- Use the quotient of the free group on a small family of target elements to apply
universality. This compares all maps whose values lie in the subgroup generated by the family. -/
private theorem compareGeneratedExtension
    {N : Type u} {E : Type v} {G : Type w} [Group N] [Group E] [Group G]
    {S : GroupExtension N E G} (hS : IsUniversalCentralExtension.{u, v, w, t} S)
    {K : Type u'} {D : Type v'} [Group K] [Group D] (T : GroupExtension K D G)
    (hT : IsCentralExtension T) {A : Type (max v w t)} (generators : A → D)
    (hGenerators : Function.Surjective (T.rightHom ∘ generators)) :
    ∃ f : E →* D, T.rightHom.comp f = S.rightHom ∧
      ∀ g : E →* D, T.rightHom.comp g = S.rightHom →
        (∀ x, g x ∈ (FreeGroup.lift generators).range) → g = f := by
  let φ : FreeGroup A →* D := FreeGroup.lift generators
  let H := FreeGroup A ⧸ φ.ker
  let e : H ≃* φ.range := QuotientGroup.quotientKerEquivRange φ
  let i : H →* D := φ.range.subtype.comp e.toMonoidHom
  have hi : Function.Injective i := Subtype.val_injective.comp e.injective
  let p : H →* G := T.rightHom.comp i
  let U : GroupExtension p.ker H G :=
    { inl := p.ker.subtype
      rightHom := p
      inl_injective := Subtype.val_injective
      range_inl_eq_ker_rightHom := p.ker.range_subtype
      rightHom_surjective := by
        intro q
        obtain ⟨a, ha⟩ := hGenerators q
        refine ⟨QuotientGroup.mk (FreeGroup.of a), ?_⟩
        change T.rightHom (FreeGroup.lift generators (FreeGroup.of a)) = q
        rw [FreeGroup.lift_apply_of]
        exact ha }
  have hU : IsCentralExtension U := by
    rw [isCentralExtension_iff_ker_le_center]
    intro x hx
    have hix : i x ∈ Subgroup.center D :=
      (isCentralExtension_iff_ker_le_center T).mp hT hx
    apply Subgroup.mem_center_iff.mpr
    intro y
    apply hi
    simpa only [map_mul] using Subgroup.mem_center_iff.mp hix (i y)
  obtain ⟨f, hf, hUnique⟩ := hS.2 U hU
  refine ⟨i.comp f, ?_, ?_⟩
  · change p.comp f = S.rightHom at hf
    simpa only [p, MonoidHom.comp_assoc] using hf
  · intro g hg hRange
    let g' : E →* H := e.symm.toMonoidHom.comp (g.codRestrict φ.range hRange)
    have hg' : i.comp g' = g := by
      ext x
      change ((e (e.symm ⟨g x, hRange x⟩) : φ.range) : D) = g x
      rw [e.apply_symm_apply]
    have hp : U.rightHom.comp g' = S.rightHom := by
      change T.rightHom.comp (i.comp g') = S.rightHom
      rwa [hg']
    rw [← hg', hUnique g' hp]

/-- Universality at a fixed comparison level gives the unique map over the base group to a
central extension whose kernel and middle group are in arbitrary universes. -/
theorem IsUniversalCentralExtension.existsUniqueHomOverArbitrary
    {N : Type u} {E : Type v} {G : Type w} [Group N] [Group E] [Group G]
    {S : GroupExtension N E G} {K : Type u'} {D : Type v'} [Group K] [Group D]
    (hS : IsUniversalCentralExtension.{u, v, w, t} S) (T : GroupExtension K D G)
    (hT : IsCentralExtension T) :
    ∃! f : E →* D, T.rightHom.comp f = S.rightHom := by
  obtain ⟨s, hs⟩ := T.rightHom_surjective.hasRightInverse
  let lifts : ULift.{max v w t} G → D := fun q => s q.down
  have hLifts : Function.Surjective (T.rightHom ∘ lifts) :=
    fun q => ⟨ULift.up q, hs q⟩
  obtain ⟨f, hf, _⟩ := compareGeneratedExtension hS T hT lifts hLifts
  refine ⟨f, hf, ?_⟩
  intro g hg
  let generators : ULift.{max v w t} (G ⊕ (E ⊕ E)) → D :=
    fun a => a.down.elim s (Sum.elim g f)
  have hGenerators : Function.Surjective (T.rightHom ∘ generators) :=
    fun q => ⟨ULift.up (Sum.inl q), hs q⟩
  obtain ⟨k, _, hk⟩ := compareGeneratedExtension hS T hT generators hGenerators
  have hgk : g = k := hk g hg fun x =>
    ⟨FreeGroup.of (ULift.up (Sum.inr (Sum.inl x))), FreeGroup.lift_apply_of⟩
  have hfk : f = k := hk f hf fun x =>
    ⟨FreeGroup.of (ULift.up (Sum.inr (Sum.inr x))), FreeGroup.lift_apply_of⟩
  exact hgk.trans hfk.symm

/-- Perfectness is Mathlib's predicate for equality with the commutator subgroup. -/
abbrev IsPerfect (G : Type w) [Group G] : Prop := Group.IsPerfect G

theorem isPerfect_iff (G : Type w) [Group G] :
    IsPerfect G ↔ commutator G = ⊤ :=
  Group.isPerfect_def

end ALG02GroupTheory.Extensions
