import MathGenome.Internal.SmoothManifolds.Specs.SmoothManifolds.Ch08.Frobenius
import Mathlib.Topology.Connected.Basic
import Mathlib.Logic.Relation

/-! Intrinsic leaf structures, the construction stage of M08.03
(paper.tex 1657--1662). Topology is tested on plaques with their ambient
subspace topologies; it is never set equal to the ambient subspace topology
on a whole leaf. All geometric conclusions below are outputs.
-/
set_option autoImplicit false
noncomputable section

namespace SmoothManifolds.LeafData
open ModelData AtlasData FrobeniusData DistributionData CovectorData BundleOperationsData
  TangentData DifferentialData MapData Set
universe u

section Plaques
variable {n : ℕ} {M : Type u} [TopologicalSpace M]

/-- Two points in one plaque of one of the selected charts. -/
def SamePlaque (A : Set (ModelChart n .euclidean M)) (k : ℕ) (p q : M) : Prop :=
  ∃ e ∈ A, ∃ z : Euclidean (n-k),
    p ∈ coordinateSlice e k z ∧ q ∈ coordinateSlice e k z

/-- Equivalence generated by finite intersecting plaque chains. -/
def LeafRelation (A : Set (ModelChart n .euclidean M)) (k : ℕ) : M → M → Prop :=
  Relation.EqvGen (SamePlaque A k)

def leafSet (A : Set (ModelChart n .euclidean M)) (k : ℕ) (p : M) : Set M :=
  {q | LeafRelation A k p q}

/-- The final topology of the inclusions of all plaques. Its open sets are
exactly those whose intersection with each plaque is relatively open there.
When plaque overlaps are relatively open this is the topology with
plaque-open sets as a basis. The whole space need not be second countable. -/
@[instance_reducible] def plaqueTopology (A : Set (ModelChart n .euclidean M)) (k : ℕ) : TopologicalSpace M where
  IsOpen U := ∀ e ∈ A, ∀ z : Euclidean (n-k),
    IsOpen (Subtype.val ⁻¹' U : Set (coordinateSlice e k z))
  isOpen_univ := by intros; exact isOpen_univ
  isOpen_inter := by
    intro U V hU hV e he z
    exact (hU e he z).inter (hV e he z)
  isOpen_sUnion := by
    intro S hS e he z
    rw [preimage_sUnion]
    exact isOpen_biUnion (fun U hU => hS U hU e he z)

/-- Restrict the plaque topology, rather than the ambient topology, to a class. -/
@[instance_reducible] def leafTopology (A : Set (ModelChart n .euclidean M)) (k : ℕ) (p : M) :
    TopologicalSpace (leafSet A k p) :=
  (plaqueTopology A k).induced Subtype.val

/-- The proposed basis consists of all relatively open subsets of plaques
contained in the specified class. -/
def plaqueBasis (A : Set (ModelChart n .euclidean M)) (k : ℕ) (p : M) :
    Set (Set (leafSet A k p)) :=
  {V | ∃ e ∈ A, ∃ z : Euclidean (n-k),
    coordinateSlice e k z ⊆ leafSet A k p ∧
    ∃ W : Set (coordinateSlice e k z), IsOpen W ∧
      V = {q | q.val ∈ Subtype.val '' W}}

/-- Longitudinal coordinates used by every plaque chart. -/
def longitudinalCoordinates {k : ℕ} (hk : k ≤ n) (x : Euclidean n) : Euclidean k :=
  fun i => x ⟨i.val, lt_of_lt_of_le i.isLt hk⟩

/-- A product of genuine positive-radius open balls, also in dimension zero. -/
def IsProductBallChart (k : ℕ) (e : ModelChart n .euclidean M) : Prop :=
  ∃ (hk : k ≤ n) (a : Euclidean k) (b : Euclidean (n-k)) (r s : ℝ),
    0 < r ∧ 0 < s ∧
    e.target = {x | longitudinalCoordinates hk x.val ∈ Metric.ball a r ∧
      transverseCoordinates k x.val ∈ Metric.ball b s}

variable {k : ℕ} {S : SmoothManifold n .euclidean M} {C : CotangentBundle S}

/-- All input conditions concern only the adapted atlas, never leaf outputs. -/
def IsCountableAdaptedAtlas (D : SmoothDistribution C k)
    (A : Set (ModelChart n .euclidean M)) : Prop :=
  A.Countable ∧ (∀ p : M, ∃ e ∈ A, p ∈ e.source) ∧
    ∀ e ∈ A, ∃ he : e ∈ S.smoothStructure.val,
      IsAdaptedChart D e he ∧ IsProductBallChart k e

/-- Genuine charts in the constructed maximal atlas, with precisely the plaque
as source and its longitudinal coordinates as the chart function. -/
def HasPlaqueCharts (A : Set (ModelChart n .euclidean M)) (p : M)
    (T : @SmoothManifold k .euclidean (leafSet A k p) (leafTopology A k p)) : Prop :=
  letI := leafTopology A k p
  ∀ e ∈ A, ∀ z : Euclidean (n-k), coordinateSlice e k z ⊆ leafSet A k p →
    ∃ hk : k ≤ n, ∃ c : ModelChart k .euclidean (leafSet A k p),
      c ∈ T.smoothStructure.val ∧
      c.source = {q | q.val ∈ coordinateSlice e k z} ∧
      ∀ q ∈ c.source, (c q).val = longitudinalCoordinates hk (e q.val).val

/-- The smooth immersion and its actual intrinsic tangent image, with the
specified leaf topology. Injectivity is that of the set inclusion. -/
def IsIntegralLeaf (D : SmoothDistribution C k)
    (A : Set (ModelChart n .euclidean M)) (p : M)
    (T : @SmoothManifold k .euclidean (leafSet A k p) (leafTopology A k p)) : Prop :=
  letI := leafTopology A k p
  IsSmoothMap T S Subtype.val ∧ MapClassData.IsImmersion T S Subtype.val ∧
    Function.Injective (Subtype.val : leafSet A k p → M) ∧
    ∃ L : (q : leafSet A k p) → TangentSpace T q →ₗ[ℝ] TangentSpace S q.val,
      (∀ q, IsDifferential T S Subtype.val q (L q)) ∧
      ∀ q, LinearMap.range (L q) = D.fiber q.val

end Plaques
end SmoothManifolds.LeafData

namespace Specs.SmoothManifolds.Ch08.LeafStructures
open _root_.SmoothManifolds _root_.SmoothManifolds.ModelData
  _root_.SmoothManifolds.AtlasData _root_.SmoothManifolds.FrobeniusData
  _root_.SmoothManifolds.DistributionData _root_.SmoothManifolds.CovectorData
  _root_.SmoothManifolds.BundleOperationsData
  _root_.SmoothManifolds.LeafData Set
universe u

/-- Existence, including empty and disconnected ambient manifolds. -/
def countable_adapted_atlasType : Prop :=
  ∀ {n k : ℕ} {M : Type u} [TopologicalSpace M]
    {S : SmoothManifold n .euclidean M} {C : CotangentBundle S}
    (D : SmoothDistribution C k), IsInvolutive D →
    ∃ A : Set (ModelChart n .euclidean M), IsCountableAdaptedAtlas D A

/-- The complete intrinsic construction for every choice of the specified
atlas. Hausdorffness and second countability are fields of T, not hypotheses.
Maximality among integral immersions is a separately allocated next stage. -/
def leaf_structuresType : Prop :=
  ∀ {n k : ℕ} {M : Type u} [TopologicalSpace M]
    {S : SmoothManifold n .euclidean M} {C : CotangentBundle S}
    (D : SmoothDistribution C k) (A : Set (ModelChart n .euclidean M)),
    IsCountableAdaptedAtlas D A → ∀ p : M,
    ∃ T : @SmoothManifold k .euclidean (leafSet A k p) (leafTopology A k p),
      @ConnectedSpace (leafSet A k p) (leafTopology A k p) ∧
      @TopologicalSpace.IsTopologicalBasis (leafSet A k p) (leafTopology A k p)
        (plaqueBasis A k p) ∧
      HasPlaqueCharts A p T ∧ IsIntegralLeaf D A p T

/-- The classes cover the ambient manifold and two classes either agree or
are disjoint, including the empty-manifold case. -/
def partitionType : Prop :=
  ∀ {n : ℕ} {M : Type u} [TopologicalSpace M]
    (A : Set (ModelChart n .euclidean M)) (k : ℕ),
    (∀ p : M, p ∈ leafSet A k p) ∧
    (∀ p q : M, leafSet A k p = leafSet A k q ∨ Disjoint (leafSet A k p) (leafSet A k q))

/-- Hausdorffness follows from the continuous injective inclusion. -/
def hausdorffType : Prop :=
  ∀ {n : ℕ} {M : Type u} [TopologicalSpace M]
    (A : Set (ModelChart n .euclidean M)) (k : ℕ) [T2Space M] (p : M),
    @T2Space (leafSet A k p) (leafTopology A k p)

/-- Connectedness with the actual adapted atlas hypotheses. -/
def connectedType : Prop :=
  ∀ {n k : ℕ} {M : Type u} [TopologicalSpace M]
    {S : SmoothManifold n .euclidean M} {C : CotangentBundle S}
    (D : SmoothDistribution C k) (A : Set (ModelChart n .euclidean M)),
    IsCountableAdaptedAtlas D A → ∀ p : M,
    @ConnectedSpace (leafSet A k p) (leafTopology A k p)

/-- A topological gluing helper. The geometric proof must supply open overlaps
before this is applicable to the full leaf_structuresType. -/
def basis_from_open_overlapsType : Prop :=
  ∀ {n : ℕ} {M : Type u} [TopologicalSpace M]
    (A : Set (ModelChart n .euclidean M)) (k : ℕ),
    (∀ q : M, ∃ e ∈ A, q ∈ e.source) →
    (∀ e ∈ A, ∀ z : Euclidean (n-k), ∀ d ∈ A, ∀ w : Euclidean (n-k),
      IsOpen (Subtype.val ⁻¹' coordinateSlice d k w : Set (coordinateSlice e k z))) →
    ∀ p : M, @TopologicalSpace.IsTopologicalBasis (leafSet A k p) (leafTopology A k p)
      (plaqueBasis A k p)

end Specs.SmoothManifolds.Ch08.LeafStructures
