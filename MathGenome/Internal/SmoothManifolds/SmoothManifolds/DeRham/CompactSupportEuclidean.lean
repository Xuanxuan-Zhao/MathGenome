/-! M11.06: the compact-support Poincaré calculation. Global coordinates
identify the full intrinsic compact complex with genuine smooth compact
alternating fields. Corrected fiber integration gives the degree shift; the
actual coordinate integral then identifies the one-dimensional top quotient.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 2000000
set_option linter.unusedVariables false
noncomputable section

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData LocalIntegrationData FormPullbackData MeasureTheory Set Function
universe u

/-- The ordinary standard atlas, generated by its single identity chart. -/
private theorem presentation_exists_proof :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.presentation_existsType := by
  intro n
  let c : ModelChart n .euclidean (ModelSpace n .euclidean) :=
    OpenPartialHomeomorph.refl _
  have hA : IsContDiffAtlas ⊤ ({c} : Set (ModelChart n .euclidean
      (ModelSpace n .euclidean))) := by
    refine ⟨?_, ?_⟩
    · intro p
      exact ⟨c, mem_singleton c, mem_univ p⟩
    · intro e he d hd
      obtain rfl := mem_singleton_iff.mp he
      obtain rfl := mem_singleton_iff.mp hd
      constructor <;> intro x hx
      all_goals
        refine ⟨univ, isOpen_univ, mem_univ _, id, contDiffOn_id, ?_⟩
        intro y hy hyU
        rfl
  let S : SmoothManifold n .euclidean (ModelSpace n .euclidean) := {
    topologicalManifold := {
      hausdorff := inferInstance
      secondCountable := inferInstance
      atlas := {c}
      covers := hA.1 }
    smoothStructure := ⟨maximalExtension ⊤ {c}, maximalExtension_isMaximal hA⟩ }
  exact ⟨⟨S, c, subset_maximalExtension hA (mem_singleton c), rfl, rfl⟩⟩

/-- Injectivity of the compact inclusion transports the elementary vanishing
of actual exterior fibers above the manifold dimension. -/
private theorem above_dimension_proof :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.above_dimensionType.{u} := by
  intro n a M _ S C B K U D k hk
  have hz (ω : K.forms k) : ω = 0 := by
    apply Subtype.ext
    funext p
    exact ExteriorAlgebraResults.fields_above_dimension C k hk ω.val p
  letI : Subsingleton (D.complex.Obj k) := ⟨fun x y =>
    D.injective k ((hz (D.inclusion.map k x)).trans (hz (D.inclusion.map k y)).symm)⟩
  change Subsingleton (D.complex.closed k ⧸ D.complex.boundaries k)
  infer_instance

/-- Negative degree groups are the zero vector space, not a truncated
predecessor of degree zero. -/
theorem negative_degrees {n : ℕ} {a : ModelKind} {M : Type u} [TopologicalSpace M]
    {S : SmoothManifold n a M} {C : CotangentBundle S} {B : ∀ k, FormBundle C k}
    {K : Calculus C B} {U : TopologicalSpace.Opens M} (D : CompactCalculus K U)
    (j : ℕ) : Subsingleton (cohomologyZ D (.negSucc j)) :=
  inferInstanceAs (Subsingleton (ULift.{u} (Fin 0) → ℝ))

theorem point_subsingleton {M : Type u} [TopologicalSpace M]
    (P : Presentation 0 M) : Subsingleton M := by
  refine ⟨fun p q => P.chart.injOn ?_ ?_ (Subsingleton.elim _ _)⟩ <;>
    simp [P.source_eq]

private theorem point_proof :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.pointType.{u} := by
  intro M _ P C B K D ω p
  letI : Subsingleton M := point_subsingleton P
  constructor
  · change ω ∈ (⊥ : Submodule ℝ (D.complex.Obj 0)) ↔ _
    rw [Submodule.mem_bot]
    constructor
    · rintro rfl
      change ((D.inclusion.map 0) 0 : K.forms 0).val = 0
      rw [map_zero]
      rfl
    · intro h
      apply D.injective 0
      rw [map_zero]
      exact (show (D.inclusion.map 0 ω : K.forms 0) = 0 from Subtype.ext h)
  · unfold totalIntegral
    have he : coordinateCoefficient C.tangent.fiberCoordinates P.chart P.chart_mem
        (D.inclusion.map 0 ω).val =
        fun _ : Euclidean 0 => zeroCoefficient (D.inclusion.map 0 ω).val p := by
      funext z
      have hz : z ∈ ModelData.modelSet 0 .euclidean := mem_univ z
      dsimp only [coordinateCoefficient, extendModel]
      rw [dite_eq_left hz]
      dsimp only [modelCoefficient]
      rw [dite_eq_left (show (⟨z, hz⟩ : ModelSpace 0 .euclidean) ∈ P.chart.target by
        rw [P.target_eq]; exact mem_univ _)]
      rw [LocalIntegrationResults.topCoefficient_zero C.tangent.fiberCoordinates P.chart
        P.chart_mem (D.inclusion.map 0 ω).val
        ⟨P.chart.symm ⟨z, hz⟩, P.chart.map_target (by rw [P.target_eq]; exact mem_univ _)⟩]
      congr 1
      exact Subsingleton.elim _ _
    rw [he]
    simp [Measure.real, volume_pi]


section Point
variable {M : Type u} [TopologicalSpace M] (P : Presentation 0 M)
  (C : CotangentBundle P.manifold) (B : ∀ k, FormBundle C k) (K : Calculus C B)
  (D : CompactCalculus K ⊤)

def pointEvaluation (p : M) : D.complex.Obj 0 →ₗ[ℝ] ℝ :=
  (exteriorPower.zeroEquiv ℝ (Module.Dual ℝ (TangentSpace P.manifold p))).toLinearMap.comp
    ((LinearMap.proj p).comp ((K.forms 0).subtype.comp (D.inclusion.map 0)))

theorem pointEvaluation_bijective (p : M) :
    Function.Bijective (pointEvaluation P C B K D p) := by
  letI : Subsingleton M := point_subsingleton P
  constructor
  · intro x y hxy
    apply D.injective 0
    apply Subtype.ext
    funext q
    have hqp : q = p := Subsingleton.elim _ _
    subst q
    exact (exteriorPower.zeroEquiv ℝ _).injective hxy
  · intro r
    let η : Field P.manifold 0 := scalarField P.manifold (fun _ => r)
    have hs : IsForm (B 0) η := by
      apply (ExteriorAlgebraResults.smooth_iff_coefficients C 0 (B 0) η).mpr
      intro c hc I q
      have he : (fun t : c.source => coefficients C 0 c hc η t I) =
          fun _ => coefficients C 0 c hc η q I := by
        funext t
        exact congrArg (fun t : c.source => coefficients C 0 c hc η t I)
          (Subsingleton.elim t q)
      rw [he]
      exact FrameData.VectorSmoothAt.const _ _ _
    let ω : K.forms 0 := ⟨η, (K.mem_forms 0 η).mpr hs⟩
    obtain ⟨x, hx⟩ := (D.range 0 ω).mp
      ⟨(Set.toFinite (sectionSupport η)).isCompact, fun _ _ => Set.mem_univ _⟩
    refine ⟨x, ?_⟩
    change zeroCoefficient (D.inclusion.map 0 x).val p = r
    rw [hx]
    simp [ω, η, zeroCoefficient, FormPullbackData.scalarField]

theorem point_all_closed (x : D.complex.Obj 0) : D.complex.d 0 x = 0 := by
  apply D.injective 1
  rw [← D.inclusion.comm, map_zero]
  apply Subtype.ext
  funext q
  exact ExteriorAlgebraResults.fields_above_dimension C 1 (by decide)
    (K.d 0 (D.inclusion.map 0 x)).val q

theorem zero_boundaries (A : Cochain.{u}) : A.boundaries 0 = ⊥ := by
  ext x
  change x.val ∈ (⊥ : Submodule ℝ (A.Obj 0)) ↔ x ∈ (⊥ : Submodule ℝ (A.closed 0))
  simp only [Submodule.mem_bot]
  exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩

theorem point_equiv (p : M) :
    ∃ e : D.Cohomology 0 ≃ₗ[ℝ] ℝ,
      ∀ ω : D.complex.closed 0, e (D.complex.classOf 0 ω) =
        zeroCoefficient (D.inclusion.map 0 ω.val).val p := by
  let ec : D.complex.closed 0 ≃ₗ[ℝ] D.complex.Obj 0 :=
    LinearEquiv.ofBijective (D.complex.closed 0).subtype
      ⟨Subtype.val_injective, fun x => ⟨⟨x, point_all_closed P C B K D x⟩, rfl⟩⟩
  let ee := LinearEquiv.ofBijective (pointEvaluation P C B K D p)
    (pointEvaluation_bijective P C B K D p)
  let e : D.Cohomology 0 ≃ₗ[ℝ] ℝ :=
    ((D.complex.boundaries 0).quotEquivOfEqBot (zero_boundaries D.complex)).trans (ec.trans ee)
  exact ⟨e, fun ω => rfl⟩
end Point

private theorem zero_dimension_proof :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.zero_dimensionType.{u} := by
  intro M _ P C B K D
  let p : M := P.chart.symm ⟨0, mem_univ _⟩
  obtain ⟨e, he⟩ := point_equiv P C B K D p
  refine ⟨?_, negative_degrees D, ⟨e, ?_⟩, ?_⟩
  · intro k hk
    exact above_dimension_proof D k (Nat.pos_of_ne_zero hk)
  · intro ω
    exact (he ω).trans (point_proof P C B K D ω.val p).2.symm
  · intro ω
    rw [(point_proof P C B K D ω p).2]
    constructor
    · intro h
      have hz := (point_proof P C B K D ω p).1.mp h
      simp [zeroCoefficient, hz]
    · intro h
      apply (point_proof P C B K D ω p).1.mpr
      letI : Subsingleton M := point_subsingleton P
      funext q
      have hqp : q = p := Subsingleton.elim _ _
      subst q
      exact (exteriorPower.zeroEquiv ℝ _).injective (by simpa [zeroCoefficient] using h)

def presentationHomeomorph {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) : M ≃ₜ ModelData.Euclidean n :=
  (P.chart.toHomeomorphOfSourceEqUnivTargetEqUniv P.source_eq P.target_eq).trans
    (Homeomorph.Set.univ _)


section GlobalCoefficients
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation n M) (C : CotangentBundle P.manifold) (k : ℕ)

/-- The actual increasing coordinate wedge basis at a point of a global chart. -/
def globalExteriorBasis (p : M) :
    Module.Basis (Index n k) ℝ (Fiber (TangentSpace P.manifold p) k) :=
  (((Pi.basisFun ℝ (Fin n)).map
    (C.tangent.fiberCoordinates.equiv P.chart P.chart_mem p
      (by rw [P.source_eq]; exact mem_univ p)).symm).dualBasis.exteriorPower k)

/-- Coordinate analysis and synthesis on all fields, before imposing regularity.
The fibers are the original intrinsic exterior powers. -/
def globalCoefficientEquiv : Field P.manifold k ≃ₗ[ℝ]
    (Euclidean n → Index n k → ℝ) :=
  (LinearEquiv.piCongrRight (fun p : M => (globalExteriorBasis P C k p).equivFun)).trans
    (LinearEquiv.piCongrLeft' ℝ (fun _ : M => Index n k → ℝ)
      (presentationHomeomorph P).toEquiv)

/-- Analysis at the coordinates of an original point returns its actual coefficients. -/
theorem globalCoefficientEquiv_at (ω : Field P.manifold k) (p : M) :
    globalCoefficientEquiv P C k ω (presentationHomeomorph P p) =
      fun I => coefficients C k P.chart P.chart_mem ω
        ⟨p, by rw [P.source_eq]; exact mem_univ p⟩ I := by
  exact congrArg (fun q : M => (globalExteriorBasis P C k q).equivFun (ω q))
    ((presentationHomeomorph P).symm_apply_apply p)

/-- In a global chart the ambient zero extension has no artificial edge. -/
theorem globalCoefficientEquiv_apply (ω : Field P.manifold k) (z : Euclidean n)
    (I : Index n k) :
    globalCoefficientEquiv P C k ω z I =
      ExteriorDerivativeData.ambientCoefficient C k P.chart P.chart_mem ω I z := by
  have hz : z ∈ modelSet n .euclidean := mem_univ z
  have ht : (⟨z, hz⟩ : ModelSpace n .euclidean) ∈ P.chart.target := by
    rw [P.target_eq]; exact mem_univ _
  simp only [ExteriorDerivativeData.ambientCoefficient, dite_eq_left hz, dite_eq_left ht]
  rfl

/-- The simultaneous coefficient vector is zero precisely where the section is zero. -/
theorem globalCoefficientEquiv_zero_iff (ω : Field P.manifold k) (z : Euclidean n) :
    globalCoefficientEquiv P C k ω z = 0 ↔
      ω ((presentationHomeomorph P).symm z) = 0 := by
  exact (globalExteriorBasis P C k ((presentationHomeomorph P).symm z)).equivFun.map_eq_zero_iff

/-- The complete closed support, including all coefficients at once, is
transported exactly by the global coordinate homeomorphism. -/
theorem globalCoefficientEquiv_tsupport (ω : Field P.manifold k) :
    tsupport (globalCoefficientEquiv P C k ω) =
      presentationHomeomorph P '' sectionSupport ω := by
  change closure (support (globalCoefficientEquiv P C k ω)) =
    presentationHomeomorph P '' closure {p : M | ω p ≠ 0}
  rw [Homeomorph.image_closure]
  apply congrArg closure
  ext z
  constructor
  · intro hz
    refine ⟨(presentationHomeomorph P).symm z, ?_, Homeomorph.apply_symm_apply _ _⟩
    intro h
    exact hz ((globalCoefficientEquiv_zero_iff P C k ω z).mpr h)
  · rintro ⟨p, hp, rfl⟩ h
    apply hp
    have he := (globalCoefficientEquiv_zero_iff P C k ω (presentationHomeomorph P p)).mp h
    exact (congrArg (fun q : M => ω q = 0)
      ((presentationHomeomorph P).symm_apply_apply p)).mp he

/-- Compact support of a field and of its finite coordinate vector are equivalent. -/
theorem globalCoefficientEquiv_hasCompactSupport_iff (ω : Field P.manifold k) :
    HasCompactSupport (globalCoefficientEquiv P C k ω) ↔
      IsCompact (sectionSupport ω) := by
  change IsCompact (tsupport _) ↔ _
  rw [globalCoefficientEquiv_tsupport]
  exact (presentationHomeomorph P).isCompact_image

/-- Smooth intrinsic forms have globally smooth finite coordinate vectors. -/
theorem globalCoefficientEquiv_contDiff (B : FormBundle C k) (ω : Field P.manifold k)
    (hω : IsForm B ω) :
    ContDiff ℝ (⊤ : ℕ∞) (globalCoefficientEquiv P C k ω) := by
  apply contDiff_iff_contDiffAt.mpr
  intro z
  let p : P.chart.source := ⟨(presentationHomeomorph P).symm z,
    by rw [P.source_eq]; exact mem_univ _⟩
  have hreg := (ExteriorDerivativeResults.smooth_coefficients C k B ω).mp hω
  obtain ⟨U, hU, hpU, F, hF, heF⟩ := hreg P.chart P.chart_mem p
  have hchart (q : P.chart.source) :
      (P.chart q.val).val = presentationHomeomorph P q.val := rfl
  have hpz : (P.chart p.val).val = z := by
    change presentationHomeomorph P ((presentationHomeomorph P).symm z) = z
    exact Homeomorph.apply_symm_apply _ _
  change (P.chart p.val).val ∈ U at hpU
  rw [hpz] at hpU
  apply (hF.contDiffAt (hU.mem_nhds hpU)).congr_of_eventuallyEq
  filter_upwards [hU.mem_nhds hpU] with y hy
  let q : P.chart.source := ⟨(presentationHomeomorph P).symm y,
    by rw [P.source_eq]; exact mem_univ _⟩
  have hqy : (P.chart q.val).val = y := by
    change presentationHomeomorph P ((presentationHomeomorph P).symm y) = y
    exact (presentationHomeomorph P).apply_symm_apply y
  have hqyU : (fun p : P.chart.source => (P.chart p.val).val) q ∈ U := by
    change (P.chart q.val).val ∈ U
    rwa [hqy]
  have he := heF q hqyU
  change F ((P.chart q.val).val) = _ at he
  rw [hqy] at he
  exact he.symm

/-- Conversely, a globally smooth coefficient vector synthesizes a genuine
smooth intrinsic section in the supplied exterior bundle. -/
theorem globalCoefficientEquiv_isForm (B : FormBundle C k) (ω : Field P.manifold k)
    (hω : ContDiff ℝ (⊤ : ℕ∞) (globalCoefficientEquiv P C k ω)) : IsForm B ω := by
  letI := (cotangentSpace C).topology
  letI := B.space.topology
  have hv : FrameData.VectorSmooth
      (openSubsetAtlas P.manifold.smoothStructure.val P.chart.source P.chart.open_source)
      (fun p : P.chart.source => fun I : Index n k =>
        coefficients C k P.chart P.chart_mem ω p I) := by
    apply (ExteriorDerivativeResults.locallySmoothAlong_chart_iff P.chart P.chart_mem _).mp
    intro p
    refine ⟨univ, isOpen_univ, mem_univ _, globalCoefficientEquiv P C k ω,
      hω.contDiffOn, ?_⟩
    intro q hq
    exact globalCoefficientEquiv_at P C k ω q.val
  have hlocal := (ExteriorAlgebraResults.local_smooth_iff_coefficients C B P.chart
    P.chart_mem ω).mpr (fun I p => (hv p).postcomp
      (ContinuousLinearMap.proj (R := ℝ) (φ := fun _ : Index n k => ℝ) I).contDiff)
  intro p
  exact (manifoldContDiff_restrict_open (⊤ : ℕ∞) P.manifold.smoothStructure.val
    B.space.bundle.totalManifold.smoothStructure.val
    (fun p : M => (⟨p, ω p⟩ : Bundle.TotalSpace (Euclidean (n.choose k))
      (fun q => Fiber (TangentSpace P.manifold q) k)))
    P.chart.source P.chart.open_source).mpr hlocal p (by rw [P.source_eq]; exact mem_univ p)

theorem globalCoefficientEquiv_smooth_iff (B : FormBundle C k) (ω : Field P.manifold k) :
    IsForm B ω ↔ ContDiff ℝ (⊤ : ℕ∞) (globalCoefficientEquiv P C k ω) :=
  ⟨globalCoefficientEquiv_contDiff P C k B ω, globalCoefficientEquiv_isForm P C k B ω⟩

end GlobalCoefficients

/-- Smooth compactly supported finite vectors of increasing-wedge coefficients. -/
def compactCoefficientForms (n k : ℕ) :
    Submodule ℝ (Euclidean n → Index n k → ℝ) where
  carrier := {f | ContDiff ℝ (⊤ : ℕ∞) f ∧ HasCompactSupport f}
  zero_mem' := ⟨contDiff_const, HasCompactSupport.zero⟩
  add_mem' hf hg := ⟨hf.1.add hg.1, hf.2.add hg.2⟩
  smul_mem' r f hf := ⟨hf.1.const_smul r,
    show HasCompactSupport (fun x => r • f x) from hf.2.comp_left (by simp)⟩

section CompactCoordinates
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation n M) (C : CotangentBundle P.manifold)
  (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤) (k : ℕ)

/-- Analysis of compact intrinsic forms into all smooth compact coefficient vectors. -/
def compactCoefficientMap : D.complex.Obj k →ₗ[ℝ] compactCoefficientForms n k :=
  ((globalCoefficientEquiv P C k).toLinearMap.comp
    ((K.forms k).subtype.comp (D.inclusion.map k))).codRestrict _ (fun ω => by
      change ContDiff ℝ (⊤ : ℕ∞)
          (globalCoefficientEquiv P C k (D.inclusion.map k ω).val) ∧
        HasCompactSupport (globalCoefficientEquiv P C k (D.inclusion.map k ω).val)
      constructor
      · exact globalCoefficientEquiv_contDiff P C k (B k) (D.inclusion.map k ω).val
          ((K.mem_forms k _).mp (D.inclusion.map k ω).property)
      · exact (globalCoefficientEquiv_hasCompactSupport_iff P C k _).mpr
          ((D.range k _).mpr ⟨ω, rfl⟩).1)

theorem compactCoefficientMap_bijective :
    Bijective (compactCoefficientMap P C B K D k) := by
  constructor
  · intro x y hxy
    apply D.injective k
    apply Subtype.ext
    apply (globalCoefficientEquiv P C k).injective
    exact congrArg Subtype.val hxy
  · intro f
    have hf : ContDiff ℝ (⊤ : ℕ∞) f.val ∧ HasCompactSupport f.val := f.property
    let ω : Field P.manifold k := (globalCoefficientEquiv P C k).symm f.val
    have he : globalCoefficientEquiv P C k ω = f.val :=
      (globalCoefficientEquiv P C k).apply_symm_apply f.val
    have hs : IsForm (B k) ω :=
      globalCoefficientEquiv_isForm P C k (B k) ω (by rw [he]; exact hf.1)
    let η : K.forms k := ⟨ω, (K.mem_forms k ω).mpr hs⟩
    have hc : IsCompact (sectionSupport ω) :=
      (globalCoefficientEquiv_hasCompactSupport_iff P C k ω).mp (by rw [he]; exact hf.2)
    obtain ⟨x, hx⟩ := (D.range k η).mp ⟨hc, subset_univ _⟩
    refine ⟨x, Subtype.ext ?_⟩
    change globalCoefficientEquiv P C k (D.inclusion.map k x).val = f.val
    rw [hx]
    exact he

/-- A genuine degreewise linear equivalence, including every compact form in
both directions. Compatibility with the differential is established separately. -/
def compactCoefficientEquiv : D.complex.Obj k ≃ₗ[ℝ] compactCoefficientForms n k :=
  LinearEquiv.ofBijective (compactCoefficientMap P C B K D k)
    (compactCoefficientMap_bijective P C B K D k)

end CompactCoordinates

/-- The literal Euclidean coefficient differential, with the new covector placed first. -/
def coefficientDifferential (n k : ℕ) (f : Euclidean n → Index n k → ℝ)
    (z : Euclidean n) : Index n (k+1) → ℝ :=
  ExteriorDerivativeResults.coefficientDerivativeMap n k
    (fun I => fderiv ℝ (fun y => f y I) z)

/-- The intrinsic differential becomes the actual coordinate differential,
including the degree-zero and high-degree cases. -/
theorem globalCoefficientEquiv_derivative {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (C : CotangentBundle P.manifold)
    (B : ∀ k, FormBundle C k) (K : Calculus C B) (k : ℕ) (ω : K.forms k)
    (z : Euclidean n) :
    globalCoefficientEquiv P C (k+1) (K.d k ω).val z =
      coefficientDifferential n k (globalCoefficientEquiv P C k ω.val) z := by
  let p : M := (presentationHomeomorph P).symm z
  have hp : p ∈ P.chart.source := by rw [P.source_eq]; exact mem_univ p
  have hchart : (P.chart p).val = z := (presentationHomeomorph P).apply_symm_apply z
  have htarget : Subtype.val '' P.chart.target = (univ : Set (Euclidean n)) := by
    rw [P.target_eq]
    ext y
    constructor
    · intro h; exact mem_univ y
    · intro h; exact ⟨⟨y, mem_univ y⟩, mem_univ _, rfl⟩
  have hscalar (I : Index n k) :
      ExteriorDerivativeData.ambientCoefficient C k P.chart P.chart_mem ω.val I =
        fun y => globalCoefficientEquiv P C k ω.val y I :=
    funext (fun y => (globalCoefficientEquiv_apply P C k ω.val y I).symm)
  change (globalExteriorBasis P C (k+1) p).equivFun (K.D k ω.val p) = _
  rw [K.coordinates k ω.val ((K.mem_forms k ω.val).mp ω.property)
    P.chart P.chart_mem p hp]
  unfold ExteriorDerivativeData.coordinateDerivative
  dsimp only [globalExteriorBasis]
  rw [ExteriorDerivativeResults.coordinateExpression_coefficients]
  change ExteriorDerivativeResults.coefficientDerivativeMap n k _ = _
  congr 1
  funext I
  rw [htarget, hscalar I, fderivWithin_univ, hchart]

/-- The coordinate realization also intertwines with Mathlib's analytic
exterior derivative of continuous alternating forms. -/
theorem globalCoefficientEquiv_extDeriv {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (C : CotangentBundle P.manifold)
    (B : ∀ k, FormBundle C k) (K : Calculus C B) (k : ℕ) (ω : K.forms k)
    (z : Euclidean n) :
    ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n (k+1)
      (globalCoefficientEquiv P C (k+1) (K.d k ω).val z) =
    extDeriv (fun y => ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k
      (globalCoefficientEquiv P C k ω.val y)) z := by
  rw [globalCoefficientEquiv_derivative]
  exact (ExteriorDerivativeResults.Euclidean.extDeriv_coefficientAlternatingEquiv _ z
    ((globalCoefficientEquiv_contDiff P C k (B k) ω.val
      ((K.mem_forms k _).mp ω.property)).contDiffAt.differentiableAt (by norm_num))).symm

theorem compact_locally_constant_zero {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (hn : 0 < n) (ω : Field P.manifold 0)
    (hs : IsCompact (sectionSupport ω))
    (hf : IsLocallyConstant (fun p =>
      exteriorPower.zeroEquiv ℝ (Module.Dual ℝ (TangentSpace P.manifold p)) (ω p))) :
    ω = 0 := by
  let e := presentationHomeomorph P
  letI : ConnectedSpace M := (e.connectedSpace_iff).mpr inferInstance
  let i : Fin n := ⟨0, hn⟩
  let coord (p : M) : ℝ := e p i
  have hcoord : Continuous coord := (continuous_apply i).comp e.continuous
  obtain ⟨b, hb⟩ := (hs.image hcoord).bddAbove
  let q : M := e.symm (fun _ => b+1)
  have hq : q ∉ sectionSupport ω := by
    intro hq
    have hqb := hb (show coord q ∈ coord '' sectionSupport ω from ⟨q, hq, rfl⟩)
    have heq : coord q = b+1 := by simp [coord, q]
    rw [heq] at hqb
    linarith
  have hzero : ω q = 0 := by
    by_contra hz
    exact hq (subset_closure hz)
  funext p
  apply (exteriorPower.zeroEquiv ℝ _).injective
  simp only [Pi.zero_apply, map_zero]
  rw [hf.apply_eq_of_preconnectedSpace p q]
  simp [hzero]

private theorem degree_zero_proof :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.degree_zeroType.{u} := by
  intro n M _ P hn C B K D
  obtain ⟨e, he⟩ := DeRhamResults.h0_locally_constant K
  have hz (x : D.complex.closed 0) : x = 0 := by
    let y : K.closed 0 := D.inclusion.onClosed 0 x
    have hy : IsLocallyConstant (fun p => exteriorPower.zeroEquiv ℝ
        (Module.Dual ℝ (TangentSpace P.manifold p)) (y.val.val p)) := by
      have heq : (fun p => exteriorPower.zeroEquiv ℝ
          (Module.Dual ℝ (TangentSpace P.manifold p)) (y.val.val p)) =
          fun p => e (K.classOf 0 y) p := by
        funext p
        exact (he y p).symm
      rw [heq]
      exact (e (K.classOf 0 y)).isLocallyConstant
    have hcompact : IsCompact (sectionSupport y.val.val) :=
      ((D.range 0 (D.inclusion.map 0 x.val)).mpr ⟨x.val, rfl⟩).1
    have hyzero : y.val.val = 0 := compact_locally_constant_zero P hn _ hcompact hy
    apply Subtype.ext
    apply D.injective 0
    change D.inclusion.map 0 x.val = D.inclusion.map 0 (0 : D.complex.Obj 0)
    rw [map_zero]
    exact (show (D.inclusion.map 0 x.val : K.forms 0) = 0 from Subtype.ext hyzero)
  letI : Subsingleton (D.complex.closed 0) := ⟨fun x y => (hz x).trans (hz y).symm⟩
  change Subsingleton (D.complex.closed 0 ⧸ D.complex.boundaries 0)
  infer_instance


section Support
variable {X E : Type*} [TopologicalSpace X] [T2Space X]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

def correctedCoefficient (β : ℝ × X → E) (ρ : ℝ → ℝ) (t : ℝ) (x : X) : E :=
  β (t,x) - ρ t • ∫ s : ℝ, β (s,x)

omit [TopologicalSpace X] [T2Space X] in
theorem corrected_total_integral (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : ∀ x, Integrable (fun t => β (t,x))) (hρ : Integrable ρ)
    (hρ1 : (∫ t, ρ t) = 1) (x : X) :
    (∫ t : ℝ, correctedCoefficient β ρ t x) = 0 := by
  change (∫ t : ℝ, β (t,x) - ρ t • ∫ s : ℝ, β (s,x)) = 0
  rw [integral_sub (hβ x) (hρ.smul_const _), integral_smul_const, hρ1, one_smul, sub_self]

theorem corrected_primitive_support (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : ∀ x, Integrable (fun t => β (t,x))) (hρ : Integrable ρ)
    (hρ1 : (∫ t, ρ t) = 1) (a b : ℝ) (K : Set X) (hK : IsCompact K)
    (hβs : support β ⊆ Ioo a b ×ˢ K) (hρs : support ρ ⊆ Ioo a b) :
    HasCompactSupport (fun p : ℝ × X => ∫ t in a..p.1, correctedCoefficient β ρ t p.2) := by
  have htime (x : X) : support (fun t => correctedCoefficient β ρ t x) ⊆ Ioo a b := by
    intro t ht
    by_contra hn
    have hb : β (t,x) = 0 := by
      by_contra hb
      exact hn (hβs hb).1
    have hr : ρ t = 0 := by
      by_contra hr
      exact hn (hρs hr)
    exact ht (by simp [correctedCoefficient, hb, hr])
  have hspace (x : X) (hx : x ∉ K) : ∀ t, correctedCoefficient β ρ t x = 0 := by
    have hb (t : ℝ) : β (t,x) = 0 := by
      by_contra hb
      exact hx (hβs hb).2
    intro t
    simp [correctedCoefficient, hb]
  apply HasCompactSupport.intro (isCompact_Icc.prod hK)
  intro p hp
  by_cases hx : p.2 ∈ K
  · have ht : p.1 < a ∨ b < p.1 := by
      simpa only [mem_prod, mem_Icc, hx, and_true, not_and_or, not_le] using hp
    rcases ht with ht | ht
    · calc
        (∫ t in a..p.1, correctedCoefficient β ρ t p.2) = ∫ t in a..p.1, (0 : E) := by
          apply intervalIntegral.integral_congr
          intro t ht'
          have hta : t ≤ a := (show p.1 ≤ t ∧ t ≤ a by
            simpa only [uIcc_of_ge ht.le, mem_Icc] using ht').2
          have hg : t ∉ support (fun t => correctedCoefficient β ρ t p.2) := by
            intro hg
            exact (not_lt_of_ge hta) (htime p.2 hg).1
          simpa using hg
        _ = 0 := intervalIntegral.integral_zero
    · rw [intervalIntegral.integral_eq_integral_of_support_subset (fun t ht' =>
        ⟨(htime p.2 ht').1, (htime p.2 ht').2.le.trans ht.le⟩)]
      exact corrected_total_integral β ρ hβ hρ hρ1 p.2
  · simp [hspace p.2 hx]
end Support

section Uniform
variable {X E : Type*} [TopologicalSpace X] [T2Space X]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

theorem corrected_primitive_hasCompactSupport (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : ∀ x, Integrable (fun t => β (t,x))) (hρ : Integrable ρ)
    (hρ1 : (∫ t, ρ t) = 1) (hβs : HasCompactSupport β) (hρs : HasCompactSupport ρ) :
    ∃ a : ℝ, HasCompactSupport
      (fun p : ℝ × X => ∫ t in a..p.1, correctedCoefficient β ρ t p.2) := by
  let T : Set ℝ := Prod.fst '' tsupport β ∪ tsupport ρ
  have hT : IsCompact T := (hβs.image continuous_fst).union hρs
  obtain ⟨a, ha⟩ := hT.bddBelow
  obtain ⟨b, hb⟩ := hT.bddAbove
  refine ⟨a - 1, corrected_primitive_support β ρ hβ hρ hρ1 (a-1) (b+1)
    (Prod.snd '' tsupport β) (hβs.image continuous_snd) ?_ ?_⟩
  · intro p hp
    have hp' : p ∈ tsupport β := subset_tsupport β hp
    have hpT : p.1 ∈ T := Or.inl ⟨p, hp', rfl⟩
    have hal := ha hpT
    have hbu := hb hpT
    exact ⟨⟨by linarith, by linarith⟩, ⟨p, hp', rfl⟩⟩
  · intro t ht
    have htT : t ∈ T := Or.inr (subset_tsupport ρ ht)
    have hal := ha htT
    have hbu := hb htT
    exact ⟨by linarith, by linarith⟩
end Uniform


section CompactSlices
variable {X E : Type*} [TopologicalSpace X] [T2Space X]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Every time slice has compact support in a single compact time projection. -/
theorem compact_slice_hasCompactSupport (β : ℝ × X → E)
    (hβ : HasCompactSupport β) (x : X) :
    HasCompactSupport (fun t : ℝ => β (t, x)) := by
  apply HasCompactSupport.intro (hβ.image continuous_fst)
  intro t ht
  by_contra h
  exact ht ⟨(t,x), subset_tsupport β h, rfl⟩

/-- Slice integrability follows from joint continuity and actual compact support. -/
theorem compact_slice_integrable (β : ℝ × X → E) (hβ : Continuous β)
    (hs : HasCompactSupport β) (x : X) : Integrable (fun t : ℝ => β (t,x)) :=
  (hβ.comp (continuous_id.prodMk continuous_const)).integrable_of_hasCompactSupport
    (compact_slice_hasCompactSupport β hs x)

/-- Fiber integration cannot enlarge the compact spatial projection of support. -/
theorem fiberIntegral_hasCompactSupport (β : ℝ × X → E)
    (hβ : HasCompactSupport β) : HasCompactSupport (fun x : X => ∫ t : ℝ, β (t,x)) := by
  apply HasCompactSupport.intro (hβ.image continuous_snd)
  intro x hx
  have hz (t : ℝ) : β (t,x) = 0 := by
    by_contra h
    exact hx ⟨(t,x), subset_tsupport β h, rfl⟩
  simp only [hz, integral_zero]

/-- The marginal integral is continuous, using the uniform compact time support. -/
theorem fiberIntegral_continuous (β : ℝ × X → E) (hβ : Continuous β)
    (hs : HasCompactSupport β) : Continuous (fun x : X => ∫ t : ℝ, β (t,x)) := by
  rw [← continuousOn_univ]
  apply continuousOn_integral_of_compact_support (hs.image continuous_fst)
  · exact (hβ.comp continuous_swap).continuousOn
  · intro x t hx ht
    by_contra h
    exact ht ⟨(t,x), subset_tsupport β h, rfl⟩

/-- The corrected integrand itself is jointly compactly supported. -/
theorem correctedCoefficient_hasCompactSupport (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : HasCompactSupport β) (hρ : HasCompactSupport ρ) :
    HasCompactSupport (fun p : ℝ × X => correctedCoefficient β ρ p.1 p.2) := by
  have hi := fiberIntegral_hasCompactSupport β hβ
  have hprod : HasCompactSupport
      (fun p : ℝ × X => ρ p.1 • ∫ t : ℝ, β (t,p.2)) := by
    apply HasCompactSupport.intro (hρ.prod hi)
    intro p hp
    have hp' : p.1 ∉ tsupport ρ ∨ p.2 ∉ tsupport (fun x : X => ∫ t : ℝ, β (t,x)) := by
      simpa only [mem_prod, not_and_or] using hp
    rcases hp' with ht | hx
    · rw [image_eq_zero_of_notMem_tsupport ht, zero_smul]
    · rw [image_eq_zero_of_notMem_tsupport hx, smul_zero]
  exact hβ.sub hprod

/-- For continuous compact coefficients, all analytic integrability hypotheses
of the compact-support correction lemma follow automatically. -/
theorem corrected_primitive_of_continuous (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : Continuous β) (hρ : Continuous ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) :
    ∃ a : ℝ, HasCompactSupport
      (fun p : ℝ × X => ∫ t in a..p.1, correctedCoefficient β ρ t p.2) :=
  corrected_primitive_hasCompactSupport β ρ (compact_slice_integrable β hβ hsβ)
    (hρ.integrable_of_hasCompactSupport hsρ) hρ1 hsβ hsρ

end CompactSlices


section SmoothFiberIntegral
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Partial differentiation in the spatial variables, using the actual Fréchet derivative. -/
def spatialDerivative (β : ℝ × H → E) (p : ℝ × H) : H →L[ℝ] E :=
  (fderiv ℝ β p).comp (ContinuousLinearMap.inr ℝ ℝ H)

theorem spatialDerivative_hasCompactSupport (β : ℝ × H → E)
    (hs : HasCompactSupport β) : HasCompactSupport (spatialDerivative β) := by
  exact (hs.fderiv ℝ).comp_left
    (g := fun L : (ℝ × H) →L[ℝ] E => L.comp (ContinuousLinearMap.inr ℝ ℝ H)) (by simp)

theorem spatialDerivative_contDiff (β : ℝ × H → E) {r s : WithTop ℕ∞}
    (hf : ContDiff ℝ r β) (hrs : s + 1 ≤ r) : ContDiff ℝ s (spatialDerivative β) :=
  (hf.fderiv_right hrs).clm_comp contDiff_const

/-- Differentiation of the full fiber integral; the compact support supplies a
single integrable dominating function for every spatial parameter. -/
theorem fiberIntegral_hasFDerivAt (β : ℝ × H → E) (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (x : H) :
    HasFDerivAt (fun y : H => ∫ t : ℝ, β (t,y))
      (∫ t : ℝ, spatialDerivative β (t,x)) x := by
  let G := spatialDerivative β
  have hcG : Continuous G := (spatialDerivative_contDiff β hf (s := 0) (by norm_num)).continuous
  have hsG : HasCompactSupport G := spatialDerivative_hasCompactSupport β hs
  obtain ⟨C, hC⟩ := hcG.bounded_above_of_compact_support hsG
  let T : Set ℝ := Prod.fst '' tsupport G
  have hT : IsCompact T := hsG.image continuous_fst
  have hb : Integrable (T.indicator (fun _ : ℝ => C)) :=
    (integrableOn_const hT.measure_ne_top).integrable_indicator hT.measurableSet
  apply hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F' := fun y t => G (t,y)) (s := univ) (bound := T.indicator (fun _ => C))
    (Filter.univ_mem)
  · exact Filter.Eventually.of_forall (fun y =>
      (hf.continuous.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
  · exact compact_slice_integrable β hf.continuous hs x
  · exact (hcG.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
  · apply Filter.Eventually.of_forall
    intro t y hy
    by_cases ht : t ∈ T
    · rw [Set.indicator_of_mem ht]
      exact hC (t,y)
    · rw [Set.indicator_of_notMem ht]
      have hz : G (t,y) = 0 := by
        by_contra h
        exact ht ⟨(t,y), subset_tsupport G h, rfl⟩
      simp [hz]
  · exact hb
  · apply Filter.Eventually.of_forall
    intro t y hy
    exact (hf.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp y
      (hasFDerivAt_prodMk_right t y)

/-- Smoothness of marginal integrals, proved for each finite order so that the
induction applies to the derivative's complete normed target as well. -/
theorem fiberIntegral_contDiff_nat (r : ℕ) :
    ∀ {F : Type u} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (β : ℝ × H → F), ContDiff ℝ r β → HasCompactSupport β →
      ContDiff ℝ r (fun x : H => ∫ t : ℝ, β (t,x)) := by
  induction r with
  | zero =>
    intro F _ _ _ β hf hs
    exact contDiff_zero.mpr (fiberIntegral_continuous β hf.continuous hs)
  | succ r ih =>
    intro F _ _ _ β hf hs
    have hf1 : ContDiff ℝ 1 β := hf.of_le (by exact_mod_cast Nat.succ_pos r)
    have hd (x : H) := fiberIntegral_hasFDerivAt β hf1 hs x
    rw [Nat.cast_add, Nat.cast_one] at hf ⊢
    apply contDiff_succ_iff_fderiv.mpr
    refine ⟨fun x => (hd x).differentiableAt, ?_, ?_⟩
    · intro h
      simp at h
    · have he : fderiv ℝ (fun x : H => ∫ t : ℝ, β (t,x)) =
          fun x : H => ∫ t : ℝ, spatialDerivative β (t,x) := funext (fun x => (hd x).fderiv)
      rw [he]
      exact ih (spatialDerivative β) (spatialDerivative_contDiff β hf (by norm_num))
        (spatialDerivative_hasCompactSupport β hs)

/-- A smooth compact coefficient has a smooth, compactly supported marginal integral. -/
theorem fiberIntegral_contDiff (β : ℝ × H → E) (hf : ContDiff ℝ (⊤ : ℕ∞) β)
    (hs : HasCompactSupport β) :
    ContDiff ℝ (⊤ : ℕ∞) (fun x : H => ∫ t : ℝ, β (t,x)) := by
  apply contDiff_infty.mpr
  intro r
  exact fiberIntegral_contDiff_nat r β (hf.of_le (by simp)) hs

end SmoothFiberIntegral

section CorrectedSmoothness
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- The support correction is jointly smooth in time and space. -/
theorem correctedCoefficient_contDiff (β : ℝ × H → E) (ρ : ℝ → ℝ)
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) :
    ContDiff ℝ (⊤ : ℕ∞) (fun p : ℝ × H => correctedCoefficient β ρ p.1 p.2) :=
  hβ.sub ((hρ.comp contDiff_fst).smul
    ((fiberIntegral_contDiff β hβ hsβ).comp contDiff_snd))

/-- Fundamental theorem of calculus in the time coordinate of the corrected primitive. -/
theorem corrected_primitive_hasDerivAt (β : ℝ × H → E) (ρ : ℝ → ℝ)
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) (a t : ℝ) (x : H) :
    HasDerivAt (fun u : ℝ => ∫ s in a..u, correctedCoefficient β ρ s x)
      (correctedCoefficient β ρ t x) t :=
  (((correctedCoefficient_contDiff β ρ hβ hρ hsβ).continuous.comp
    (continuous_id.prodMk continuous_const)).integral_hasStrictDerivAt a t).hasDerivAt

end CorrectedSmoothness


section LowerPrimitive
variable {X E : Type*} [TopologicalSpace X] [T2Space X]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Canonical integration from minus infinity, with no support-dependent choice
of lower endpoint. This definition is suitable for linear homotopy operators. -/
def lowerPrimitive (β : ℝ × X → E) (p : ℝ × X) : E :=
  ∫ t in Iic p.1, β (t,p.2)

/-- Zero total fiber integrals make the canonical primitive compactly supported. -/
theorem lowerPrimitive_hasCompactSupport (β : ℝ × X → E)
    (hs : HasCompactSupport β) (hzero : ∀ x : X, (∫ t : ℝ, β (t,x)) = 0) :
    HasCompactSupport (lowerPrimitive β) := by
  have hT := hs.image continuous_fst
  have hK := hs.image continuous_snd
  obtain ⟨a, ha⟩ := hT.bddBelow
  obtain ⟨b, hb⟩ := hT.bddAbove
  apply HasCompactSupport.intro (isCompact_Icc.prod hK) (K := Icc a b ×ˢ (Prod.snd '' tsupport β))
  intro p hp
  have hv (t : ℝ) (h : β (t,p.2) ≠ 0) : a ≤ t ∧ t ≤ b :=
    ⟨ha ⟨(t,p.2), subset_tsupport β h, rfl⟩,
      hb ⟨(t,p.2), subset_tsupport β h, rfl⟩⟩
  by_cases hx : p.2 ∈ Prod.snd '' tsupport β
  · have ht : p.1 < a ∨ b < p.1 := by
      simpa only [mem_prod, mem_Icc, hx, and_true, not_and_or, not_le] using hp
    rcases ht with ht | ht
    · change (∫ t in Iic p.1, β (t,p.2)) = 0
      apply setIntegral_eq_zero_of_forall_eq_zero
      intro t ht'
      by_contra h
      exact (not_lt_of_ge ((hv t h).1.trans (mem_Iic.mp ht'))) ht
    · change (∫ t in Iic p.1, β (t,p.2)) = 0
      rw [setIntegral_eq_integral_of_forall_compl_eq_zero ?_, hzero p.2]
      intro t ht'
      by_contra h
      apply ht'
      exact ((hv t h).2.trans ht.le)
  · have hz (t : ℝ) : β (t,p.2) = 0 := by
      by_contra h
      exact hx ⟨(t,p.2), subset_tsupport β h, rfl⟩
    simp [lowerPrimitive, hz]

/-- Additivity of canonical primitives, with exactly the necessary slice integrability. -/
theorem lowerPrimitive_add (β γ : ℝ × X → E)
    (hβ : ∀ x, Integrable (fun t : ℝ => β (t,x)))
    (hγ : ∀ x, Integrable (fun t : ℝ => γ (t,x))) :
    lowerPrimitive (β+γ) = lowerPrimitive β + lowerPrimitive γ := by
  funext p
  exact integral_add (hβ p.2).integrableOn (hγ p.2).integrableOn

/-- Real homogeneity of canonical primitives. -/
theorem lowerPrimitive_smul (β : ℝ × X → E) (r : ℝ) :
    lowerPrimitive (r • β) = r • lowerPrimitive β := by
  funext p
  exact integral_smul r (fun t : ℝ => β (t,p.2))

/-- The canonical half-line primitive has the expected derivative in time. -/
theorem lowerPrimitive_hasDerivAt (β : ℝ × X → E) (hc : Continuous β)
    (hs : HasCompactSupport β) (t : ℝ) (x : X) :
    HasDerivAt (fun s : ℝ => lowerPrimitive β (s,x)) (β (t,x)) t := by
  have hi := compact_slice_integrable β hc hs x
  have he : (fun s : ℝ => lowerPrimitive β (s,x)) =
      fun s => (∫ r in (0 : ℝ)..s, β (r,x)) + ∫ r in Iic (0 : ℝ), β (r,x) := by
    funext s
    exact sub_eq_iff_eq_add.mp (intervalIntegral.integral_Iic_sub_Iic hi.integrableOn hi.integrableOn)
  rw [he]
  exact ((hc.comp (continuous_id.prodMk continuous_const)).integral_hasStrictDerivAt 0 t).hasDerivAt.add_const _

/-- The manuscript's canonical corrected primitive has actual compact support. -/
theorem corrected_lowerPrimitive_hasCompactSupport (β : ℝ × X → E) (ρ : ℝ → ℝ)
    (hβ : Continuous β) (hρ : Continuous ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) :
    HasCompactSupport (lowerPrimitive (fun p : ℝ × X => correctedCoefficient β ρ p.1 p.2)) :=
  lowerPrimitive_hasCompactSupport _ (correctedCoefficient_hasCompactSupport β ρ hsβ hsρ)
    (corrected_total_integral β ρ (compact_slice_integrable β hβ hsβ)
      (hρ.integrable_of_hasCompactSupport hsρ) hρ1)

end LowerPrimitive

section MeasuredFiberIntegral
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (μ : Measure ℝ) [IsFiniteMeasureOnCompacts μ]

/-- Slice integrability follows from joint continuity and actual compact support. -/
theorem compact_slice_integrable_measure (β : ℝ × H → E) (hβ : Continuous β)
    (hs : HasCompactSupport β) (x : H) : Integrable (fun t : ℝ => β (t,x)) μ :=
  (hβ.comp (continuous_id.prodMk continuous_const)).integrable_of_hasCompactSupport
    (compact_slice_hasCompactSupport β hs x)

/-- The marginal integral is continuous, using the uniform compact time support. -/
theorem fiberIntegral_continuous_measure (β : ℝ × H → E) (hβ : Continuous β)
    (hs : HasCompactSupport β) : Continuous (fun x : H => ∫ t : ℝ, β (t,x) ∂μ) := by
  rw [← continuousOn_univ]
  apply continuousOn_integral_of_compact_support (hs.image continuous_fst)
  · exact (hβ.comp continuous_swap).continuousOn
  · intro x t hx ht
    by_contra h
    exact ht ⟨(t,x), subset_tsupport β h, rfl⟩
/-- Differentiation of the full fiber integral; the compact support supplies a
single integrable dominating function for every spatial parameter. -/
theorem fiberIntegral_hasFDerivAt_measure (β : ℝ × H → E) (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (x : H) :
    HasFDerivAt (fun y : H => ∫ t : ℝ, β (t,y) ∂μ)
      (∫ t : ℝ, spatialDerivative β (t,x) ∂μ) x := by
  let G := spatialDerivative β
  have hcG : Continuous G := (spatialDerivative_contDiff β hf (s := 0) (by norm_num)).continuous
  have hsG : HasCompactSupport G := spatialDerivative_hasCompactSupport β hs
  obtain ⟨C, hC⟩ := hcG.bounded_above_of_compact_support hsG
  let T : Set ℝ := Prod.fst '' tsupport G
  have hT : IsCompact T := hsG.image continuous_fst
  have hb : Integrable (T.indicator (fun _ : ℝ => C)) μ :=
    (integrableOn_const hT.measure_ne_top).integrable_indicator hT.measurableSet
  apply hasFDerivAt_integral_of_dominated_of_fderiv_le
    (F' := fun y t => G (t,y)) (s := univ) (bound := T.indicator (fun _ => C))
    (Filter.univ_mem)
  · exact Filter.Eventually.of_forall (fun y =>
      (hf.continuous.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
  · exact compact_slice_integrable_measure μ β hf.continuous hs x
  · exact (hcG.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
  · apply Filter.Eventually.of_forall
    intro t y hy
    by_cases ht : t ∈ T
    · rw [Set.indicator_of_mem ht]
      exact hC (t,y)
    · rw [Set.indicator_of_notMem ht]
      have hz : G (t,y) = 0 := by
        by_contra h
        exact ht ⟨(t,y), subset_tsupport G h, rfl⟩
      simp [hz]
  · exact hb
  · apply Filter.Eventually.of_forall
    intro t y hy
    exact (hf.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp y
      (hasFDerivAt_prodMk_right t y)

/-- Smoothness of marginal integrals, proved for each finite order so that the
induction applies to the derivative's complete normed target as well. -/
theorem fiberIntegral_contDiff_nat_measure (r : ℕ) :
    ∀ {F : Type u} [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
      (β : ℝ × H → F), ContDiff ℝ r β → HasCompactSupport β →
      ContDiff ℝ r (fun x : H => ∫ t : ℝ, β (t,x) ∂μ) := by
  induction r with
  | zero =>
    intro F _ _ _ β hf hs
    exact contDiff_zero.mpr (fiberIntegral_continuous_measure μ β hf.continuous hs)
  | succ r ih =>
    intro F _ _ _ β hf hs
    have hf1 : ContDiff ℝ 1 β := hf.of_le (by exact_mod_cast Nat.succ_pos r)
    have hd (x : H) := fiberIntegral_hasFDerivAt_measure μ β hf1 hs x
    rw [Nat.cast_add, Nat.cast_one] at hf ⊢
    apply contDiff_succ_iff_fderiv.mpr
    refine ⟨fun x => (hd x).differentiableAt, ?_, ?_⟩
    · intro h
      simp at h
    · have he : fderiv ℝ (fun x : H => ∫ t : ℝ, β (t,x) ∂μ) =
          fun x : H => ∫ t : ℝ, spatialDerivative β (t,x) ∂μ := funext (fun x => (hd x).fderiv)
      rw [he]
      exact ih (spatialDerivative β) (spatialDerivative_contDiff β hf (by norm_num))
        (spatialDerivative_hasCompactSupport β hs)

/-- A smooth compact coefficient has a smooth, compactly supported marginal integral. -/
theorem fiberIntegral_contDiff_measure (β : ℝ × H → E) (hf : ContDiff ℝ (⊤ : ℕ∞) β)
    (hs : HasCompactSupport β) :
    ContDiff ℝ (⊤ : ℕ∞) (fun x : H => ∫ t : ℝ, β (t,x) ∂μ) := by
  apply contDiff_infty.mpr
  intro r
  exact fiberIntegral_contDiff_nat_measure μ r β (hf.of_le (by simp)) hs


end MeasuredFiberIntegral

section SmoothLowerPrimitive
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (β : ℝ × H → E)

theorem lowerPrimitive_hasFDerivAt_space (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (t : ℝ) (x : H) :
    HasFDerivAt (fun y : H => lowerPrimitive β (t,y))
      (lowerPrimitive (spatialDerivative β) (t,x)) x :=
  fiberIntegral_hasFDerivAt_measure (volume.restrict (Iic t)) β hf hs x

/-- Translating the halfline of integration turns its variable endpoint into
an ordinary smooth parameter. -/
theorem lowerPrimitive_eq_shift (t : ℝ) (x : H) :
    lowerPrimitive β (t,x) = ∫ s in Iic (0 : ℝ), β (s+t,x) := by
  have hm := (measurePreserving_add_right volume t).setIntegral_preimage_emb
    (Homeomorph.addRight t).measurableEmbedding (fun s => β (s,x)) (Iic t)
  have he : (fun s : ℝ => s+t) ⁻¹' Iic t = Iic (0 : ℝ) := by
    ext s
    simp only [mem_preimage, mem_Iic, add_le_iff_nonpos_left]
  simpa only [lowerPrimitive, he] using hm.symm

/-- A compact cutoff in the translating parameter makes the sheared coefficient
compactly supported on the complete product. -/
theorem compactlySupported_shearedCoefficient (ψ : ℝ → ℝ) (hsψ : HasCompactSupport ψ)
    (hs : HasCompactSupport β) :
    HasCompactSupport (fun q : ℝ × (ℝ × H) => ψ q.2.1 • β (q.1+q.2.1,q.2.2)) := by
  let K := (fun q : ℝ × (ℝ × H) => (q.2.1-q.1,(q.1,q.2.2))) ''
    (tsupport ψ ×ˢ tsupport β)
  have hK : IsCompact K := (hsψ.prod hs).image
    ((continuous_snd.fst.sub continuous_fst).prodMk
      (continuous_fst.prodMk continuous_snd.snd))
  apply HasCompactSupport.intro hK
  intro q hq
  by_contra hz
  have hψ : ψ q.2.1 ≠ 0 := by
    intro h
    exact hz (by simp [h])
  have hβ : β (q.1+q.2.1,q.2.2) ≠ 0 := by
    intro h
    exact hz (by simp [h])
  apply hq
  refine ⟨(q.2.1,(q.1+q.2.1,q.2.2)), ⟨subset_tsupport ψ hψ, subset_tsupport β hβ⟩, ?_⟩
  simp [sub_eq_add_neg]

/-- Joint smoothness of the canonical primitive. -/
theorem lowerPrimitive_contDiff (hf : ContDiff ℝ (⊤ : ℕ∞) β)
    (hs : HasCompactSupport β) : ContDiff ℝ (⊤ : ℕ∞) (lowerPrimitive β) := by
  rw [contDiff_iff_contDiffAt]
  intro p
  let ψ : ContDiffBump p.1 := ⟨1, 2, by norm_num, by norm_num⟩
  let G : ℝ × (ℝ × H) → E := fun q => ψ q.2.1 • β (q.1+q.2.1,q.2.2)
  have hG : ContDiff ℝ (⊤ : ℕ∞) G :=
    (ψ.contDiff.comp (contDiff_fst.comp contDiff_snd)).smul
      (hf.comp ((contDiff_fst.add (contDiff_fst.comp contDiff_snd)).prodMk
        (contDiff_snd.comp contDiff_snd)))
  have hsG : HasCompactSupport G := compactlySupported_shearedCoefficient β ψ ψ.hasCompactSupport hs
  have hI := fiberIntegral_contDiff_measure (volume.restrict (Iic (0 : ℝ))) G hG hsG
  apply hI.contDiffAt.congr_of_eventuallyEq
  have he : (fun q : ℝ × H => ψ q.1) =ᶠ[nhds p] 1 :=
    ψ.eventuallyEq_one.comp_tendsto continuous_fst.continuousAt
  filter_upwards [he] with q hq
  change ψ q.1 = (1 : ℝ) at hq
  change lowerPrimitive β q = (∫ s in Iic (0 : ℝ), ψ q.1 • β (s+q.1,q.2))
  simp only [hq, one_smul]
  exact lowerPrimitive_eq_shift β q.1 q.2

theorem lowerPrimitive_spatialDerivative (hf : ContDiff ℝ (⊤ : ℕ∞) β)
    (hs : HasCompactSupport β) (p : ℝ × H) :
    spatialDerivative (lowerPrimitive β) p = lowerPrimitive (spatialDerivative β) p := by
  have hfull := ((lowerPrimitive_contDiff β hf hs).contDiffAt.differentiableAt
    (by norm_num)).hasFDerivAt.comp p.2 (hasFDerivAt_prodMk_right p.1 p.2)
  exact hfull.unique (lowerPrimitive_hasFDerivAt_space β (hf.of_le (by simp)) hs p.1 p.2)
end SmoothLowerPrimitive

section FullPrimitiveDerivative
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (β : ℝ × H → E)
/-- The complete derivative includes both endpoint variation and differentiation
of the integrand in the spatial variable. -/
theorem lowerPrimitive_hasFDerivAt (hf : ContDiff ℝ (⊤ : ℕ∞) β)
    (hs : HasCompactSupport β) (p : ℝ × H) :
    HasFDerivAt (lowerPrimitive β)
      ((ContinuousLinearMap.fst ℝ ℝ H).smulRight (β p) +
        (lowerPrimitive (spatialDerivative β) p).comp (ContinuousLinearMap.snd ℝ ℝ H)) p := by
  have hd : HasFDerivAt (lowerPrimitive β) (fderiv ℝ (lowerPrimitive β) p) p :=
    ((lowerPrimitive_contDiff β hf hs).contDiffAt.differentiableAt (by norm_num)).hasFDerivAt
  have ht := (hd.comp (f := fun t : ℝ => (t,p.2)) p.1 (hasFDerivAt_prodMk_left (𝕜 := ℝ) p.1 p.2)).unique
    (lowerPrimitive_hasDerivAt β hf.continuous hs p.1 p.2).hasFDerivAt
  have hx := lowerPrimitive_spatialDerivative β hf hs p
  have he := ContinuousLinearMap.coprod_comp_inl_inr (fderiv ℝ (lowerPrimitive β) p)
  change (fderiv ℝ (lowerPrimitive β) p).comp (ContinuousLinearMap.inr ℝ ℝ H) = _ at hx
  rw [ht, hx] at he
  convert hd using 1
  rw [← he]
  ext q <;> simp

end FullPrimitiveDerivative

section ExteriorIntegral
open ContinuousAlternatingMap
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (μ : Measure ℝ) [IsFiniteMeasureOnCompacts μ]
variable {n : ℕ} (β : ℝ × H → H [⋀^Fin n]→L[ℝ] E)

theorem extDeriv_fiberIntegral (hf : ContDiff ℝ 1 β) (hs : HasCompactSupport β) (x : H) :
    extDeriv (fun y : H => ∫ t, β (t,y) ∂μ) x =
      ∫ t, extDeriv (fun y : H => β (t,y)) x ∂μ := by
  have hfd (t : ℝ) : fderiv ℝ (fun y : H => β (t,y)) x = spatialDerivative β (t,x) :=
    ((hf.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp x
      (hasFDerivAt_prodMk_right t x)).fderiv
  unfold extDeriv
  rw [(fiberIntegral_hasFDerivAt_measure μ β hf hs x).fderiv]
  simp_rw [hfd]
  exact (alternatizeUncurryFinCLM ℝ H E).integral_comp_comm
    (compact_slice_integrable_measure μ (spatialDerivative β)
      ((spatialDerivative_contDiff β hf (s := 0) (by norm_num)).continuous)
      (spatialDerivative_hasCompactSupport β hs) x) |>.symm

theorem extDeriv_lowerPrimitive_space (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (t : ℝ) (x : H) :
    extDeriv (fun y : H => lowerPrimitive β (t,y)) x =
      lowerPrimitive
        (fun p : ℝ × H => extDeriv (fun y : H => β (p.1,y)) p.2) (t,x) :=
  extDeriv_fiberIntegral (volume.restrict (Iic t)) β hf hs x
end ExteriorIntegral

section CorrectedPrimitiveRegularity
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (β : ℝ × H → E) (ρ : ℝ → ℝ)

/-- Spatial differentiation commutes with the support correction. -/
theorem spatialDerivative_correctedCoefficient
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) :
    spatialDerivative (fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2) =
      fun p => correctedCoefficient (spatialDerivative β) ρ p.1 p.2 := by
  funext p
  have hβ1 : ContDiff ℝ 1 β := hβ.of_le (by simp)
  have hfirst : HasFDerivAt (fun y : H => β (p.1,y))
      (spatialDerivative β p) p.2 :=
    (hβ1.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp p.2
      (hasFDerivAt_prodMk_right p.1 p.2)
  have hm := fiberIntegral_hasFDerivAt β hβ1 hsβ p.2
  have hcorrected := hfirst.sub (hm.const_smul (ρ p.1))
  have hfull := ((correctedCoefficient_contDiff β ρ hβ hρ hsβ).contDiffAt.differentiableAt
    (by norm_num)).hasFDerivAt.comp p.2 (hasFDerivAt_prodMk_right p.1 p.2)
  exact hfull.unique hcorrected

theorem corrected_lowerPrimitive_contDiff
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ) :
    ContDiff ℝ (⊤ : ℕ∞)
      (lowerPrimitive (fun p : ℝ × H => correctedCoefficient β ρ p.1 p.2)) :=
  lowerPrimitive_contDiff _ (correctedCoefficient_contDiff β ρ hβ hρ hsβ)
    (correctedCoefficient_hasCompactSupport β ρ hsβ hsρ)

theorem corrected_lowerPrimitive_spatialDerivative
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ) (p : ℝ × H) :
    spatialDerivative
      (lowerPrimitive (fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2)) p =
      lowerPrimitive
        (spatialDerivative (fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2)) p :=
  lowerPrimitive_spatialDerivative _ (correctedCoefficient_contDiff β ρ hβ hρ hsβ)
    (correctedCoefficient_hasCompactSupport β ρ hsβ hsρ) p

theorem corrected_lowerPrimitive_hasFDerivAt
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ) (p : ℝ × H) :
    HasFDerivAt (lowerPrimitive (fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2))
      ((ContinuousLinearMap.fst ℝ ℝ H).smulRight (correctedCoefficient β ρ p.1 p.2) +
        (lowerPrimitive (spatialDerivative
          (fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2)) p).comp
          (ContinuousLinearMap.snd ℝ ℝ H)) p :=
  lowerPrimitive_hasFDerivAt _ (correctedCoefficient_contDiff β ρ hβ hρ hsβ)
    (correctedCoefficient_hasCompactSupport β ρ hsβ hsρ) p
end CorrectedPrimitiveRegularity

section TimePrimitive
variable {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable (β : ℝ × H → E)

theorem fiberIntegral_timeDeriv_eq_zero (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (x : H) :
    (∫ t : ℝ, deriv (fun s : ℝ => β (s,x)) t) = 0 := by
  have hslice : ContDiff ℝ 1 (fun s : ℝ => β (s,x)) :=
    hf.comp (contDiff_id.prodMk contDiff_const)
  have hsupport := compact_slice_hasCompactSupport β hs x
  exact integral_eq_zero_of_hasDerivAt_of_integrable
    (fun t => (hslice.differentiable one_ne_zero t).hasDerivAt)
    (hslice.continuous_deriv le_rfl |>.integrable_of_hasCompactSupport hsupport.deriv)
    (compact_slice_integrable β hf.continuous hs x)

theorem lowerPrimitive_timeDeriv (hf : ContDiff ℝ 1 β) (hs : HasCompactSupport β) :
    lowerPrimitive (fun p : ℝ × H => deriv (fun s : ℝ => β (s,p.2)) p.1) = β := by
  funext p
  exact HasCompactSupport.integral_Iic_deriv_eq
    (hf.comp (contDiff_id.prodMk contDiff_const))
    (compact_slice_hasCompactSupport β hs p.2) p.1
theorem timeDeriv_eq_fderiv (hf : ContDiff ℝ 1 β) (t : ℝ) (x : H) :
    deriv (fun s : ℝ => β (s,x)) t = fderiv ℝ β (t,x) (1,0) :=
  ((hf.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp t
    (hasFDerivAt_prodMk_left (𝕜 := ℝ) t x)).hasDerivAt.deriv

theorem fiberIntegral_timeFDeriv_eq_zero (hf : ContDiff ℝ 1 β)
    (hs : HasCompactSupport β) (x : H) :
    (∫ t : ℝ, fderiv ℝ β (t,x) (1,0)) = 0 := by
  simp_rw [← timeDeriv_eq_fderiv β hf]
  exact fiberIntegral_timeDeriv_eq_zero β hf hs x

theorem lowerPrimitive_timeFDeriv (hf : ContDiff ℝ 1 β) (hs : HasCompactSupport β) :
    lowerPrimitive (fun p : ℝ × H => fderiv ℝ β p (1,0)) = β := by
  have he : (fun p : ℝ × H => fderiv ℝ β p (1,0)) =
      (fun p : ℝ × H => deriv (fun s : ℝ => β (s,p.2)) p.1) := by
    funext p
    exact (timeDeriv_eq_fderiv β hf p.1 p.2).symm
  rw [he]
  exact lowerPrimitive_timeDeriv β hf hs
end TimePrimitive

section PrimitiveOperatorCommutation
variable {H E F : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]

theorem lowerPrimitive_clm_comm (L : E →L[ℝ] F) (β : ℝ × H → E)
    (hc : Continuous β) (hs : HasCompactSupport β) :
    lowerPrimitive (fun p : ℝ × H => L (β p)) = fun p => L (lowerPrimitive β p) := by
  funext p
  exact L.integral_comp_comm (compact_slice_integrable β hc hs p.2).integrableOn
end PrimitiveOperatorCommutation




theorem corrected_lowerPrimitive_hasDerivAt
    {H E : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (β : ℝ × H → E) (ρ : ℝ → ℝ)
    (hβ : ContDiff ℝ (⊤ : ℕ∞) β) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsβ : HasCompactSupport β) (hsρ : HasCompactSupport ρ) (t : ℝ) (x : H) :
    HasDerivAt (fun s : ℝ =>
      lowerPrimitive (fun p : ℝ × H => correctedCoefficient β ρ p.1 p.2) (s,x))
      (correctedCoefficient β ρ t x) t :=
  lowerPrimitive_hasDerivAt _ (correctedCoefficient_contDiff β ρ hβ hρ hsβ).continuous
    (correctedCoefficient_hasCompactSupport β ρ hsβ hsρ) t x

theorem scalar_compact_primitive (f : ℝ → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hs : HasCompactSupport f) (hI : (∫ x, f x) = 0) :
    ∃ g : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧ HasCompactSupport g ∧
      ∀ x, HasDerivAt g (f x) x := by
  obtain ⟨a, ha⟩ := hs.bddBelow
  obtain ⟨b, hb⟩ := hs.bddAbove
  let g (x : ℝ) := ∫ t in (a-1)..x, f t
  have hd (x : ℝ) : HasDerivAt g (f x) x :=
    (hf.continuous.integral_hasStrictDerivAt (a-1) x).hasDerivAt
  refine ⟨g, ?_, ?_, hd⟩
  · apply contDiff_infty_iff_deriv.mpr
    refine ⟨fun x => (hd x).differentiableAt, ?_⟩
    have he : deriv g = f := funext (fun x => (hd x).deriv)
    rwa [he]
  · apply HasCompactSupport.intro (K := Icc (a-1) (b+1)) isCompact_Icc
    intro x hx
    have hx' : x < a-1 ∨ b+1 < x := by
      simpa only [mem_Icc, not_and_or, not_le] using hx
    rcases hx' with hx | hx
    · change (∫ t in (a-1)..x, f t) = 0
      rw [intervalIntegral.integral_congr (g := fun _ => 0) ?_, intervalIntegral.integral_zero]
      intro t ht
      have hta : t ≤ a-1 := (show x ≤ t ∧ t ≤ a-1 by
        simpa only [uIcc_of_ge hx.le, mem_Icc] using ht).2
      by_contra hfz
      have ht' : t ∈ tsupport f := subset_tsupport f hfz
      have hat := ha ht'
      linarith
    · change (∫ t in (a-1)..x, f t) = 0
      rw [intervalIntegral.integral_eq_integral_of_support_subset ?_, hI]
      intro t ht
      have ht' := subset_tsupport f ht
      have hat := ha ht'
      have hbt := hb ht'
      exact ⟨by linarith, by linarith⟩

theorem scalar_compact_primitive_iff (f : ℝ → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hs : HasCompactSupport f) :
    (∃ g : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) g ∧ HasCompactSupport g ∧
      ∀ x, HasDerivAt g (f x) x) ↔ (∫ x, f x) = 0 := by
  constructor
  · rintro ⟨g, hg, hgs, hd⟩
    exact integral_eq_zero_of_hasDerivAt_of_integrable hd
      (hf.continuous.integrable_of_hasCompactSupport hs)
      (hg.continuous.integrable_of_hasCompactSupport hgs)
  · exact scalar_compact_primitive f hf hs

/-- Every compactly supported top form is closed, on any manifold and open set. -/
theorem top_all_closed {n : ℕ} {a : ModelKind} {M : Type u} [TopologicalSpace M]
    {S : SmoothManifold n a M} {C : CotangentBundle S} {B : ∀ k, FormBundle C k}
    {K : Calculus C B} {U : TopologicalSpace.Opens M} (D : CompactCalculus K U)
    (ω : D.complex.Obj n) : D.complex.d n ω = 0 := by
  apply D.injective (n+1)
  rw [← D.inclusion.comm, map_zero]
  apply Subtype.ext
  funext p
  exact ExteriorAlgebraResults.fields_above_dimension C (n+1) (Nat.lt_succ_self n)
    (K.d n (D.inclusion.map n ω)).val p

theorem exact_iff_zero_of_equiv (A : Cochain.{u}) (n : ℕ)
    (f : A.Obj n → ℝ) (e : A.H n ≃ₗ[ℝ] ℝ)
    (he : ∀ x : A.closed n, e (A.classOf n x) = f x.val)
    (hc : ∀ x : A.Obj n, A.d n x = 0) (x : A.Obj n) :
    x ∈ A.exact n ↔ f x = 0 := by
  let y : A.closed n := ⟨x, hc x⟩
  have hq : A.classOf n y = 0 ↔ x ∈ A.exact n :=
    Submodule.Quotient.mk_eq_zero (A.boundaries n)
  rw [← hq, ← he y]
  exact ⟨fun h => by rw [h, map_zero], fun h => e.injective (by simpa using h)⟩

/-- The normalized cutoff used in the corrected integration construction exists
with its actual smoothness, support, integrability, and normalization. -/
theorem normalized_cutoff_exists : ∃ ρ : ℝ → ℝ,
    ContDiff ℝ (⊤ : ℕ∞) ρ ∧ HasCompactSupport ρ ∧ Integrable ρ ∧ (∫ t : ℝ, ρ t) = 1 := by
  let f : ContDiffBump (0 : ℝ) := default
  exact ⟨f.normed volume, f.contDiff_normed, f.hasCompactSupport_normed,
    f.integrable_normed, f.integral_normed⟩

/-- The standard Euclidean models have global smooth coordinate presentations. -/
theorem presentation_exists :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.presentation_existsType :=
  presentation_exists_proof

/-- The full compact-support calculation on a point, with integration. -/
theorem zero_dimension :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.zero_dimensionType.{u} :=
  zero_dimension_proof

/-- There are no nonzero compactly supported closed functions in positive dimension. -/
theorem degree_zero :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.degree_zeroType.{u} :=
  degree_zero_proof

/-- Exactness and the value of integration at the zero-dimensional endpoint. -/
theorem point :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.pointType.{u} :=
  point_proof

/-- Compact-support cohomology vanishes above the manifold dimension. -/
theorem above_dimension :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.above_dimensionType.{u} :=
  above_dimension_proof

end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u
/-- A surjective linear functional whose kernel is exactly the compact
boundaries induces the required integration equivalence on cohomology. -/
theorem cohomology_equiv_of_exact_iff (A : Cochain.{u}) (n : ℕ)
    (F : A.Obj n →ₗ[ℝ] ℝ) (hc : ∀ x, A.d n x = 0)
    (hs : Function.Surjective F)
    (he : ∀ x, x ∈ A.exact n ↔ F x = 0) :
    ∃ e : A.H n ≃ₗ[ℝ] ℝ, ∀ x : A.closed n, e (A.classOf n x) = F x.val := by
  let f : A.closed n →ₗ[ℝ] ℝ := F.comp (A.closed n).subtype
  have hf : Function.Surjective f := by
    intro r
    obtain ⟨x, hx⟩ := hs r
    exact ⟨⟨x, hc x⟩, hx⟩
  have hk : A.boundaries n = f.ker := by
    ext x
    exact he x.val
  let e : A.H n ≃ₗ[ℝ] ℝ :=
    (Submodule.quotEquivOfEq _ _ hk).trans (f.quotKerEquivOfSurjective hf)
  exact ⟨e, fun x => rfl⟩

/-- Exactness of every closed representative makes a cohomology group zero. -/
theorem cohomology_subsingleton_of_closed_exact (A : Cochain.{u}) (k : ℕ)
    (h : ∀ x : A.closed k, x.val ∈ A.exact k) : Subsingleton (A.H k) := by
  have hb : A.boundaries k = ⊤ := by
    apply top_unique
    intro x hx
    exact h x
  change Subsingleton (A.closed k ⧸ A.boundaries k)
  rw [hb]
  infer_instance
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u v
/-- Inverse maps modulo exact forms give an actual linear equivalence of the
original cohomology quotients. The maps may shift degrees. -/
theorem cohomology_equiv_of_closed_maps (A : Cochain.{u}) (B : Cochain.{v}) (p q : ℕ)
    (I : A.closed p →ₗ[ℝ] B.closed q) (J : B.closed q →ₗ[ℝ] A.closed p)
    (hI : ∀ x, x ∈ A.boundaries p → I x ∈ B.boundaries q)
    (hJ : ∀ y, y ∈ B.boundaries q → J y ∈ A.boundaries p)
    (hJI : ∀ x, J (I x) - x ∈ A.boundaries p)
    (hIJ : ∀ y, I (J y) - y ∈ B.boundaries q) :
    ∃ e : A.H p ≃ₗ[ℝ] B.H q,
      ∀ x : A.closed p, e (A.classOf p x) = B.classOf q (I x) := by
  let f : A.H p →ₗ[ℝ] B.H q :=
    (A.boundaries p).mapQ (B.boundaries q) I hI
  let g : B.H q →ₗ[ℝ] A.H p :=
    (B.boundaries q).mapQ (A.boundaries p) J hJ
  have hfg : f.comp g = LinearMap.id := by
    apply LinearMap.ext
    intro z
    induction z using Submodule.Quotient.induction_on with
    | _ y => exact (Submodule.Quotient.eq _).mpr (hIJ y)
  have hgf : g.comp f = LinearMap.id := by
    apply LinearMap.ext
    intro z
    induction z using Submodule.Quotient.induction_on with
    | _ x => exact (Submodule.Quotient.eq _).mpr (hJI x)
  exact ⟨LinearEquiv.ofLinearMap f g hfg hgf, fun x => rfl⟩
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u
variable (A B : Cochain.{u})
    (I : ∀ k, A.Obj (k+1) →ₗ[ℝ] B.Obj k)
    (J : ∀ k, B.Obj k →ₗ[ℝ] A.Obj (k+1))
    (hI : ∀ k x, I (k+1) (A.d (k+1) x) = -B.d k (I k x))
    (hJ : ∀ k y, A.d (k+1) (J k y) = -J (k+1) (B.d k y))

def integrationOnClosed (k : ℕ) : A.closed (k+1) →ₗ[ℝ] B.closed k where
  toFun x := ⟨I k x.val, by
    have h := hI k x.val
    rw [show A.d (k+1) x.val = 0 from x.property, map_zero] at h
    exact neg_eq_zero.mp h.symm⟩
  map_add' x y := Subtype.ext (map_add _ _ _)
  map_smul' r x := Subtype.ext (map_smul _ _ _)

def insertionOnClosed (k : ℕ) : B.closed k →ₗ[ℝ] A.closed (k+1) where
  toFun y := ⟨J k y.val, by
    change A.d (k+1) (J k y.val) = 0
    rw [hJ, show B.d k y.val = 0 from y.property, map_zero, neg_zero]⟩
  map_add' x y := Subtype.ext (map_add _ _ _)
  map_smul' r x := Subtype.ext (map_smul _ _ _)

theorem integrationOnClosed_boundary
    (hI0 : ∀ x, I 0 (A.d 0 x) = 0) (k : ℕ)
    (x : A.closed (k+1)) (hx : x ∈ A.boundaries (k+1)) :
    integrationOnClosed A B I hI k x ∈ B.boundaries k := by
  obtain ⟨a, ha⟩ := hx
  change A.d k a = x.val at ha
  change (integrationOnClosed A B I hI k x).val ∈ B.exact k
  change I k x.val ∈ B.exact k
  rw [← ha]
  cases k with
  | zero => exact (Submodule.mem_bot ℝ).mpr (hI0 a)
  | succ k =>
    rw [hI]
    exact ⟨-I k a, by simp⟩

theorem insertionOnClosed_boundary (k : ℕ)
    (y : B.closed k) (hy : y ∈ B.boundaries k) :
    insertionOnClosed A B J hJ k y ∈ A.boundaries (k+1) := by
  change J k y.val ∈ A.exact (k+1)
  cases k with
  | zero =>
    have hz : y.val = 0 := (Submodule.mem_bot ℝ).mp hy
    exact ⟨0, by simp [hz]⟩
  | succ k =>
    obtain ⟨b, hb⟩ := hy
    change B.d k b = y.val at hb
    rw [← hb]
    refine ⟨-J k b, ?_⟩
    rw [map_neg, hJ, neg_neg]
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u
/-- The algebraic degree shift used by corrected fiber integration. Its
hypotheses are identities to prove for the actual operators, not extra
hypotheses in the Euclidean calculation. -/
theorem suspension_cohomology_equiv (A B : Cochain.{u})
    (I : ∀ k, A.Obj (k+1) →ₗ[ℝ] B.Obj k)
    (J : ∀ k, B.Obj k →ₗ[ℝ] A.Obj (k+1))
    (hI : ∀ k x, I (k+1) (A.d (k+1) x) = -B.d k (I k x))
    (hI0 : ∀ x, I 0 (A.d 0 x) = 0)
    (hJ : ∀ k y, A.d (k+1) (J k y) = -J (k+1) (B.d k y))
    (hIJ : ∀ k y, I k (J k y) = y)
    (hB : ∀ k (x : A.closed (k+1)), x.val - J k (I k x.val) ∈ A.exact (k+1))
    (k : ℕ) :
    ∃ e : A.H (k+1) ≃ₗ[ℝ] B.H k,
      ∀ x : A.closed (k+1),
        e (A.classOf (k+1) x) = B.classOf k (integrationOnClosed A B I hI k x) := by
  apply cohomology_equiv_of_closed_maps A B (k+1) k
    (integrationOnClosed A B I hI k) (insertionOnClosed A B J hJ k)
  · exact integrationOnClosed_boundary A B I hI hI0 k
  · exact insertionOnClosed_boundary A B J hJ k
  · intro x
    change J k (I k x.val) - x.val ∈ A.exact (k+1)
    simpa only [neg_sub] using (A.exact (k+1)).neg_mem (hB k x)
  · intro y
    change I k (J k y.val) - y.val ∈ B.exact k
    rw [hIJ, sub_self]
    exact (B.exact k).zero_mem
end SmoothManifolds.EuclideanCompactResults


namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u v
/-- A genuine degreewise equivalence commuting with the differentials gives
an equivalence of the original quotients, even across universe levels. -/
theorem cohomology_equiv_of_complex_equiv (A : Cochain.{u}) (B : Cochain.{v})
    (e : ∀ k, A.Obj k ≃ₗ[ℝ] B.Obj k)
    (he : ∀ k x, e (k+1) (A.d k x) = B.d k (e k x)) (k : ℕ) :
    ∃ E : A.H k ≃ₗ[ℝ] B.H k,
      ∀ x : A.closed k, ∃ y : B.closed k,
        y.val = e k x.val ∧ E (A.classOf k x) = B.classOf k y := by
  have he' (k : ℕ) (y : B.Obj k) :
      (e (k+1)).symm (B.d k y) = A.d k ((e k).symm y) := by
    apply (e (k+1)).injective
    rw [LinearEquiv.apply_symm_apply, he, LinearEquiv.apply_symm_apply]
  let I : A.closed k →ₗ[ℝ] B.closed k :=
    ((e k).toLinearMap.comp (A.closed k).subtype).codRestrict _ (fun x => by
      change B.d k (e k x.val) = 0
      rw [← he, show A.d k x.val = 0 from x.property, map_zero])
  let J : B.closed k →ₗ[ℝ] A.closed k :=
    ((e k).symm.toLinearMap.comp (B.closed k).subtype).codRestrict _ (fun y => by
      change A.d k ((e k).symm y.val) = 0
      rw [← he', show B.d k y.val = 0 from y.property, map_zero])
  have hI (x : A.closed k) (hx : x ∈ A.boundaries k) : I x ∈ B.boundaries k := by
    change e k x.val ∈ B.exact k
    cases k with
    | zero =>
      have hz : x.val = 0 := (Submodule.mem_bot ℝ).mp hx
      simpa [hz] using (B.exact 0).zero_mem
    | succ k =>
      obtain ⟨a, ha⟩ := hx
      change A.d k a = x.val at ha
      exact ⟨e k a, by rw [← he, ha]⟩
  have hJ (y : B.closed k) (hy : y ∈ B.boundaries k) : J y ∈ A.boundaries k := by
    change (e k).symm y.val ∈ A.exact k
    cases k with
    | zero =>
      have hz : y.val = 0 := (Submodule.mem_bot ℝ).mp hy
      simpa [hz] using (A.exact 0).zero_mem
    | succ k =>
      obtain ⟨b, hb⟩ := hy
      change B.d k b = y.val at hb
      exact ⟨(e k).symm b, by rw [← he', hb]⟩
  obtain ⟨E, hE⟩ := cohomology_equiv_of_closed_maps A B k k I J hI hJ
    (fun x => by
      change (e k).symm (e k x.val) - x.val ∈ A.exact k
      rw [LinearEquiv.symm_apply_apply, sub_self]
      exact (A.exact k).zero_mem)
    (fun y => by
      change e k ((e k).symm y.val) - y.val ∈ B.exact k
      rw [LinearEquiv.apply_symm_apply, sub_self]
      exact (B.exact k).zero_mem)
  exact ⟨E, fun x => ⟨I x, rfl, hE x⟩⟩
end SmoothManifolds.EuclideanCompactResults

set_option autoImplicit false
namespace SmoothManifolds.EuclideanCompactResults
open MayerVietorisData
universe u
variable (H : Type u) [NormedAddCommGroup H] [NormedSpace ℝ H]
/-- The full space of genuine smooth compactly supported alternating fields. -/
def compactAlternatingForms (k : ℕ) :
    Submodule ℝ (H → H [⋀^Fin k]→L[ℝ] ℝ) where
  carrier := {f | ContDiff ℝ (⊤ : ℕ∞) f ∧ HasCompactSupport f}
  zero_mem' := ⟨contDiff_const, HasCompactSupport.zero⟩
  add_mem' hf hg := ⟨hf.1.add hg.1, hf.2.add hg.2⟩
  smul_mem' r f hf := ⟨hf.1.const_smul r,
    show HasCompactSupport (fun x => r • f x) from hf.2.comp_left (by simp)⟩

theorem compactAlternatingForms_extDeriv (k : ℕ) (ω : compactAlternatingForms H k) :
    extDeriv ω.val ∈ compactAlternatingForms H (k+1) := by
  obtain ⟨hf, hs⟩ := ω.property
  constructor
  · exact (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ H ℝ).contDiff.comp
      (hf.fderiv_right (m := (⊤ : ℕ∞)) (by simp))
  · exact (hs.fderiv ℝ).comp_left (g :=
      ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ H ℝ)
      (map_zero (ContinuousAlternatingMap.alternatizeUncurryFinCLM ℝ H ℝ))

/-- The compact Euclidean exterior derivative, without a chosen primitive. -/
def compactAlternatingDifferential (k : ℕ) :
    compactAlternatingForms H k →ₗ[ℝ] compactAlternatingForms H (k+1) where
  toFun ω := ⟨extDeriv ω.val, compactAlternatingForms_extDeriv H k ω⟩
  map_add' ω η := by
    apply Subtype.ext
    funext x
    exact extDeriv_add
      (ω.property.1.contDiffAt.differentiableAt (by norm_num))
      (η.property.1.contDiffAt.differentiableAt (by norm_num))
  map_smul' r ω := by
    apply Subtype.ext
    funext x
    exact extDeriv_smul r ω.val

/-- The genuine compact alternating-form complex in a normed real vector space. -/
def compactAlternatingComplex : Cochain.{u} where
  Obj k := compactAlternatingForms H k
  d := compactAlternatingDifferential H
  square k ω := by
    apply Subtype.ext
    funext x
    exact extDeriv_extDeriv_apply ω.property.1.contDiffAt (by simp)
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData
universe u
/-- Full compact coefficient vectors and compact alternating fields are the
same smooth functions through the actual determinant-normalized fiber map. -/
def compactCoefficientAlternatingEquiv (n k : ℕ) :
    compactCoefficientForms n k ≃ₗ[ℝ] compactAlternatingForms (Euclidean n) k where
  toFun f := ⟨fun z => ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k (f.val z),
    ⟨(ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).contDiff.comp f.property.1,
      f.property.2.comp_left (map_zero (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k))⟩⟩
  invFun ω := ⟨fun z => (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).symm (ω.val z),
    ⟨(ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).symm.contDiff.comp ω.property.1,
      ω.property.2.comp_left (map_zero (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).symm)⟩⟩
  left_inv f := Subtype.ext (funext fun z =>
    (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).symm_apply_apply (f.val z))
  right_inv ω := Subtype.ext (funext fun z =>
    (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).apply_symm_apply (ω.val z))
  map_add' f g := Subtype.ext (funext fun z =>
    map_add (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k) (f.val z) (g.val z))
  map_smul' r f := Subtype.ext (funext fun z =>
    map_smul (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k) r (f.val z))

section IntrinsicAlternating
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation n M) (C : CotangentBundle P.manifold)
  (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤)

def compactIntrinsicAlternatingEquiv (k : ℕ) :
    D.complex.Obj k ≃ₗ[ℝ] (compactAlternatingComplex (Euclidean n)).Obj k :=
  (compactCoefficientEquiv P C B K D k).trans (compactCoefficientAlternatingEquiv n k)

theorem compactIntrinsicAlternatingEquiv_derivative (k : ℕ) (ω : D.complex.Obj k) :
    compactIntrinsicAlternatingEquiv P C B K D (k+1) (D.complex.d k ω) =
      (compactAlternatingComplex (Euclidean n)).d k
        (compactIntrinsicAlternatingEquiv P C B K D k ω) := by
  apply Subtype.ext
  funext z
  change ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n (k+1)
      (globalCoefficientEquiv P C (k+1) (D.inclusion.map (k+1) (D.complex.d k ω)).val z) = _
  rw [← D.inclusion.comm]
  exact globalCoefficientEquiv_extDeriv P C B K k (D.inclusion.map k ω) z
end IntrinsicAlternating
