namespace SmoothManifolds.EuclideanCompactResults
open ContinuousAlternatingMap Function
section ProductForms
variable {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] {n : ℕ}
def contractCLM (v : E) : (E [⋀^Fin (n+1)]→L[ℝ] F) →L[ℝ] E [⋀^Fin n]→L[ℝ] F :=
  (ContinuousLinearMap.apply ℝ (E [⋀^Fin n]→L[ℝ] F) v).comp
    ContinuousAlternatingMap.curryLeftLI.toContinuousLinearMap
@[simp] theorem contractCLM_apply (v : E) (ω : E [⋀^Fin (n+1)]→L[ℝ] F) :
  contractCLM v ω = ω.curryLeft v := rfl

theorem contraction_alt (v : E) (f : E →L[ℝ] E [⋀^Fin (n+1)]→L[ℝ] F) :
  contractCLM v (alternatizeUncurryFin f) = f v - alternatizeUncurryFin ((contractCLM v).comp f) := by
  ext w
  simp only [contractCLM_apply, curryLeft_apply_apply, alternatizeUncurryFin_apply,
    ContinuousLinearMap.comp_apply, ContinuousAlternatingMap.sub_apply]
  rw [Fin.sum_univ_succ]
  have hr (i : Fin (n+1)) :
      i.succ.removeNth (Matrix.vecCons v w) = Matrix.vecCons v (i.removeNth w) :=
    Fin.cons_comp_succ_succAbove v w i
  simp only [Matrix.vecCons, Fin.cons_zero, Fin.cons_succ, Fin.val_zero, Fin.val_succ,
    Fin.removeNth_zero, Fin.tail_cons, pow_zero, one_smul]
  simp only [pow_succ, mul_neg_one, neg_smul, Finset.sum_neg_distrib, sub_eq_add_neg]
  congr 2
  apply Finset.sum_congr rfl
  intro i hi
  exact congrArg (fun z : Fin (n+1) → E => (-1 : ℤ)^i.val • f (w i) z) (hr i)

theorem extDeriv_contract (v : E) (ω : E → E [⋀^Fin (n+1)]→L[ℝ] F) (x : E)
    (hω : DifferentiableAt ℝ ω x) :
    extDeriv (fun y => contractCLM v (ω y)) x + contractCLM v (extDeriv ω x) =
      fderiv ℝ ω x v := by
  have hf : fderiv ℝ (fun y => contractCLM v (ω y)) x =
      (contractCLM v).comp (fderiv ℝ ω x) :=
    ((contractCLM (F := F) (n := n) v).hasFDerivAt.comp x hω.hasFDerivAt).fderiv
  rw [extDeriv, hf, extDeriv, contraction_alt]
  exact add_sub_cancel _ _

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]

theorem map_eq_zero_two_smul {ι : Type*} [DecidableEq ι] (ω : E [⋀^ι]→L[ℝ] F)
    (w : ι → E) {i j : ι} (hij : i ≠ j) (v : E) (a b : ℝ)
    (hi : w i = a • v) (hj : w j = b • v) : ω w = 0 := by
  have he : w = Function.update (Function.update w i (a • v)) j (b • v) := by
    rw [← hi, ← hj, Function.update_eq_self, Function.update_eq_self]
  rw [he, ω.map_update_smul]
  rw [Function.update_comm hij]
  rw [ω.map_update_smul]
  have hz : ω (Function.update (Function.update w j v) i v) = 0 := by
    exact ω.map_eq_zero_of_eq _ (by simp [hij, hij.symm]) hij
  rw [hz, smul_zero, smul_zero]

theorem map_rankOne_add {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ω : E [⋀^ι]→L[ℝ] F) (w : ι → E) (a : ι → ℝ) (v : E) :
    ω (w + fun i => a i • v) = ω w + ∑ i, a i • ω (Function.update w i v) := by
  change ω.toMultilinearMap (w + fun i => a i • v) = _
  rw [ω.toMultilinearMap.map_add_eq_map_add_linearDeriv_add]
  have hz : ∑ s : Finset ι with 2 ≤ s.card,
      ω.toMultilinearMap (s.piecewise (fun i => a i • v) w) = 0 := by
    apply Finset.sum_eq_zero
    intro s hs
    obtain ⟨i, hi, j, hj, hij⟩ := Finset.one_lt_card.mp (Finset.mem_filter.mp hs).2
    exact map_eq_zero_two_smul ω _ hij v (a i) (a j)
      (Finset.piecewise_eq_of_mem _ _ _ hi) (Finset.piecewise_eq_of_mem _ _ _ hj)
  rw [hz, add_zero, MultilinearMap.linearDeriv_apply]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  exact ω.map_update_smul w i (a i) v

theorem contract_rankOne_add (ω : E [⋀^Fin (n+1)]→L[ℝ] F)
    (w : Fin n → E) (a : Fin n → ℝ) (v : E) :
    ω.curryLeft v (w + fun i => a i • v) = ω.curryLeft v w := by
  rw [map_rankOne_add]
  have hz (i : Fin n) : ω.curryLeft v (Function.update w i v) = 0 := by
    rw [curryLeft_apply_apply]
    exact ω.map_eq_zero_of_eq _ (i := 0) (j := i.succ)
      (by simp) (Fin.succ_ne_zero i).symm
  simp only [hz, smul_zero, Finset.sum_const_zero, add_zero]

abbrev horIncl : H →L[ℝ] ℝ × H := ContinuousLinearMap.inr ℝ ℝ H
abbrev horProj : ℝ × H →L[ℝ] H := ContinuousLinearMap.snd ℝ ℝ H
abbrev timeCovector : ℝ × H →L[ℝ] ℝ := ContinuousLinearMap.fst ℝ ℝ H
abbrev timeVector : ℝ × H := (1, 0)
abbrev horizontal : ℝ × H →L[ℝ] ℝ × H := horIncl.comp horProj

def horizontalPartCLM (n : ℕ) :
    ((ℝ × H) [⋀^Fin n]→L[ℝ] F) →L[ℝ] H [⋀^Fin n]→L[ℝ] F :=
  compContinuousLinearMapCLM horIncl

def verticalPartCLM (n : ℕ) :
    ((ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) →L[ℝ] H [⋀^Fin n]→L[ℝ] F :=
  (horizontalPartCLM n).comp (contractCLM timeVector)

theorem contraction_horizontal (ω : (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) :
    (ω.curryLeft timeVector).compContinuousLinearMap horizontal = ω.curryLeft timeVector := by
  ext w
  have he : w = (fun i => horizontal (w i)) + fun i => (w i).1 • timeVector := by
    funext i
    exact Prod.ext (by simp) (by simp)
  simpa only [ContinuousAlternatingMap.compContinuousLinearMap_apply, Function.comp_def] using
    (contract_rankOne_add ω (fun i => horizontal (w i)) (fun i => (w i).1) timeVector).symm.trans
      (congrArg (fun z => ω.curryLeft timeVector z) he.symm)

def dtWedge (β : H [⋀^Fin n]→L[ℝ] F) : (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F :=
  alternatizeUncurryFin (timeCovector.smulRight (β.compContinuousLinearMap horProj))

theorem product_reconstruction (ω : (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) :
    ω = (horizontalPartCLM (n+1) ω).compContinuousLinearMap horProj +
      dtWedge (verticalPartCLM n ω) := by
  ext w
  have he : w = (fun i => horizontal (w i)) + fun i => (w i).1 • timeVector := by
    funext i
    exact Prod.ext (by simp) (by simp)
  conv_lhs => rw [he, map_rankOne_add]
  simp only [ContinuousAlternatingMap.add_apply, dtWedge, alternatizeUncurryFin_apply,
    ContinuousLinearMap.smulRight_apply, ContinuousAlternatingMap.smul_apply,
    horizontalPartCLM, verticalPartCLM, ContinuousLinearMap.comp_apply, contractCLM_apply,
    ContinuousAlternatingMap.compContinuousLinearMapCLM_apply,
    ContinuousAlternatingMap.compContinuousLinearMap_apply, curryLeft_apply_apply]
  change ω (fun i => horizontal (w i)) + _ = ω (fun i => horizontal (w i)) + _
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  change (w i).1 • ω (Function.update (fun j => horizontal (w j)) i timeVector) =
    (-1 : ℤ)^i.val • (w i).1 • ω (Matrix.vecCons timeVector (i.removeNth (fun j => horizontal (w j))))
  rw [← Fin.insertNth_removeNth, ω.map_insertNth]
  exact smul_comm _ _ _

theorem contDiff_horizontalPart {r : WithTop ℕ∞}
    (ω : ℝ × H → (ℝ × H) [⋀^Fin n]→L[ℝ] F) (hω : ContDiff ℝ r ω) :
    ContDiff ℝ r (fun p => horizontalPartCLM n (ω p)) :=
  (horizontalPartCLM (H := H) (F := F) n).contDiff.comp hω

theorem contDiff_verticalPart {r : WithTop ℕ∞}
    (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) (hω : ContDiff ℝ r ω) :
    ContDiff ℝ r (fun p => verticalPartCLM n (ω p)) :=
  (verticalPartCLM (H := H) (F := F) n).contDiff.comp hω

theorem hasCompactSupport_horizontalPart
    (ω : ℝ × H → (ℝ × H) [⋀^Fin n]→L[ℝ] F) (hω : HasCompactSupport ω) :
    HasCompactSupport (fun p => horizontalPartCLM n (ω p)) :=
  hω.comp_left (map_zero _)

theorem hasCompactSupport_verticalPart
    (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) (hω : HasCompactSupport ω) :
    HasCompactSupport (fun p => verticalPartCLM n (ω p)) :=
  hω.comp_left (map_zero _)

theorem slice_hasFDerivAt (t : ℝ) (x : H) :
    HasFDerivAt (fun y : H => (t,y)) horIncl x := by
  convert (hasFDerivAt_const t x).prodMk (hasFDerivAt_id x) using 1 <;> rfl

theorem horizontalPart_extDeriv
    (ω : ℝ × H → (ℝ × H) [⋀^Fin n]→L[ℝ] F) (t : ℝ) (x : H)
    (hω : DifferentiableAt ℝ ω (t,x)) :
    horizontalPartCLM (n+1) (extDeriv ω (t,x)) =
      extDeriv (fun y => horizontalPartCLM n (ω (t,y))) x := by
  have h := extDeriv_pullback hω
    ((contDiff_const.prodMk contDiff_id : ContDiff ℝ ⊤ (fun y : H => (t,y))).contDiffAt)
    (by simp : minSmoothness ℝ 2 ≤ (⊤ : WithTop ℕ∞))
  simp only [(slice_hasFDerivAt t _).fderiv] at h
  exact h.symm

theorem verticalPart_extDeriv
    (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) (t : ℝ) (x : H)
    (hω : DifferentiableAt ℝ ω (t,x)) :
    verticalPartCLM (n+1) (extDeriv ω (t,x)) =
      horizontalPartCLM (n+1) (fderiv ℝ ω (t,x) timeVector) -
        extDeriv (fun y => verticalPartCLM n (ω (t,y))) x := by
  have hc := extDeriv_contract timeVector ω (t,x) hω
  have hp := congrArg (horizontalPartCLM (H := H) (F := F) (n+1)) hc
  rw [map_add] at hp
  have hcontract : DifferentiableAt ℝ (fun y => contractCLM timeVector (ω y)) (t,x) :=
    (contractCLM (F := F) (n := n) timeVector).differentiableAt.comp (t,x) hω
  rw [horizontalPart_extDeriv _ t x hcontract] at hp
  exact eq_sub_of_add_eq' hp

theorem timeSlice_hasDerivAt (t : ℝ) (x : H) :
    HasDerivAt (fun s : ℝ => (s,x)) timeVector t := by
  simpa using ((ContinuousLinearMap.inl ℝ ℝ H).hasFDerivAt (x := t)).add_const (0,x) |>.hasDerivAt

theorem timeDerivative_horizontalPart
    (ω : ℝ × H → (ℝ × H) [⋀^Fin n]→L[ℝ] F) (t : ℝ) (x : H)
    (hω : DifferentiableAt ℝ ω (t,x)) :
    deriv (fun s => horizontalPartCLM n (ω (s,x))) t =
      horizontalPartCLM n (fderiv ℝ ω (t,x) timeVector) := by
  have h := (horizontalPartCLM (H := H) (F := F) n).hasFDerivAt.comp (t,x) hω.hasFDerivAt
  exact (h.comp_hasDerivAt t (timeSlice_hasDerivAt t x)).deriv

theorem verticalPart_extDeriv'
    (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F) (t : ℝ) (x : H)
    (hω : DifferentiableAt ℝ ω (t,x)) :
    verticalPartCLM (n+1) (extDeriv ω (t,x)) =
      deriv (fun s => horizontalPartCLM (n+1) (ω (s,x))) t -
        extDeriv (fun y => verticalPartCLM n (ω (t,y))) x := by
  rw [timeDerivative_horizontalPart _ t x hω]
  exact verticalPart_extDeriv ω t x hω


def dtWedgeCLM (n : ℕ) : (H [⋀^Fin n]→L[ℝ] F) →L[ℝ] (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F :=
  (alternatizeUncurryFinCLM ℝ (ℝ × H) F).comp
    ((ContinuousLinearMap.smulRightL ℝ (ℝ × H) ((ℝ × H) [⋀^Fin n]→L[ℝ] F) timeCovector).comp
      (compContinuousLinearMapCLM horProj))

@[simp] theorem dtWedgeCLM_apply (β : H [⋀^Fin n]→L[ℝ] F) :
    dtWedgeCLM n β = dtWedge β := by
  simp only [dtWedgeCLM, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.smulRightL_apply_apply, compContinuousLinearMapCLM_apply,
    alternatizeUncurryFinCLM_apply, dtWedge]

theorem horizontalPart_dtWedge (β : H [⋀^Fin n]→L[ℝ] F) :
    horizontalPartCLM (n+1) (dtWedge β) = 0 := by
  ext w
  simp [horizontalPartCLM, dtWedge, alternatizeUncurryFin_apply, Function.comp_def]

theorem verticalPart_dtWedge (β : H [⋀^Fin n]→L[ℝ] F) :
    verticalPartCLM n (dtWedge β) = β := by
  ext w
  simp only [verticalPartCLM, horizontalPartCLM, ContinuousLinearMap.comp_apply,
    compContinuousLinearMapCLM_apply, compContinuousLinearMap_apply, contractCLM_apply,
    curryLeft_apply_apply, dtWedge, alternatizeUncurryFin_apply]
  rw [Fin.sum_univ_succ]
  simp [Function.comp_def, Matrix.vecCons, Fin.removeNth_zero]

theorem product_ext (ω η : (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F)
    (hα : horizontalPartCLM (n+1) ω = horizontalPartCLM (n+1) η)
    (hβ : verticalPartCLM n ω = verticalPartCLM n η) : ω = η := by
  rw [product_reconstruction ω, product_reconstruction η, hα, hβ]

theorem dtWedge_extDeriv (ρ : ℝ → ℝ) (γ : H → H [⋀^Fin n]→L[ℝ] F)
    (t : ℝ) (x : H) (hρ : DifferentiableAt ℝ ρ t) (hγ : DifferentiableAt ℝ γ x) :
    extDeriv (fun p : ℝ × H => dtWedge (ρ p.1 • γ p.2)) (t,x) =
      -dtWedge (ρ t • extDeriv γ x) := by
  have hs : DifferentiableAt ℝ (fun p : ℝ × H => ρ p.1 • γ p.2) (t,x) :=
    (hρ.comp (t,x) (ContinuousLinearMap.fst ℝ ℝ H).differentiableAt).smul
      (hγ.comp (t,x) (ContinuousLinearMap.snd ℝ ℝ H).differentiableAt)
  have hJ : DifferentiableAt ℝ (fun p : ℝ × H => dtWedge (ρ p.1 • γ p.2)) (t,x) :=
    (dtWedgeCLM (H := H) (F := F) n).differentiableAt.comp (t,x) hs
  apply product_ext
  · rw [horizontalPart_extDeriv _ t x hJ]
    simp only [horizontalPart_dtWedge, map_neg, neg_zero]
    unfold extDeriv
    rw [(hasFDerivAt_const (0 : H [⋀^Fin (n+1)]→L[ℝ] F) x).fderiv]
    exact (alternatizeUncurryFinCLM ℝ H F).map_zero
  · rw [verticalPart_extDeriv' _ t x hJ]
    simp only [horizontalPart_dtWedge, deriv_const, verticalPart_dtWedge,
      zero_sub, map_neg]
    exact congrArg Neg.neg (extDeriv_fun_smul (x := x) (ρ t) γ)

end ProductForms
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData LocalIntegrationData FormPullbackData MeasureTheory Set Function
universe u

section IntegralBridge
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation n M) (C : CotangentBundle P.manifold)

/-- The ordered coefficient equals evaluation of the global alternating form
on the ordered standard frame; there is no orientation factor. -/
theorem coordinateCoefficient_eq_alternating (ω : Field P.manifold n) (z : Euclidean n) :
    coordinateCoefficient C.tangent.fiberCoordinates P.chart P.chart_mem ω z =
      ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
        (globalCoefficientEquiv P C n ω z) (Pi.basisFun ℝ (Fin n)) := by
  have hz : z ∈ modelSet n .euclidean := mem_univ z
  have ht : (⟨z, hz⟩ : ModelSpace n .euclidean) ∈ P.chart.target := by
    rw [P.target_eq]; exact mem_univ _
  simp only [coordinateCoefficient, extendModel, modelCoefficient,
    dite_eq_left hz, dite_eq_left ht]
  symm
  change ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      ((globalExteriorBasis P C n ((presentationHomeomorph P).symm z)).equivFun
        (ω ((presentationHomeomorph P).symm z))) (Pi.basisFun ℝ (Fin n)) = _
  have h := @ExteriorDerivativeResults.coefficientAlternating_evaluate.{u}
    (TangentSpace P.manifold ((presentationHomeomorph P).symm z)) _ _ n n
    (C.tangent.fiberCoordinates.equiv P.chart P.chart_mem
      ((presentationHomeomorph P).symm z) (by rw [P.source_eq]; exact mem_univ _))
    (ω ((presentationHomeomorph P).symm z)) (Pi.basisFun ℝ (Fin n))
  refine h.trans ?_
  unfold topCoefficient CovectorData.coordinateVector
  congr 1
  funext i
  exact congrArg (C.tangent.fiberCoordinates.equiv P.chart P.chart_mem
    ((presentationHomeomorph P).symm z) (by rw [P.source_eq]; exact mem_univ _)).symm
    (Pi.basisFun_apply ℝ (Fin n) i)

theorem totalIntegral_eq_alternating (B : ∀ k, FormBundle C k) (K : Calculus C B)
    (D : CompactCalculus K ⊤) (ω : D.complex.Obj n) :
    totalIntegral P D ω = ∫ z : Euclidean n,
      ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
        (globalCoefficientEquiv P C n (D.inclusion.map n ω).val z)
        (Pi.basisFun ℝ (Fin n)) := by
  unfold totalIntegral
  apply integral_congr_ae
  exact Filter.Eventually.of_forall (coordinateCoefficient_eq_alternating P C _)

variable (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤)

/-- Actual integrability of every compact top coefficient. -/
theorem coordinateCoefficient_integrable (ω : D.complex.Obj n) :
    Integrable (coordinateCoefficient C.tangent.fiberCoordinates P.chart P.chart_mem
      (D.inclusion.map n ω).val) := by
  let L : (Index n n → ℝ) →L[ℝ] ℝ :=
    (ContinuousAlternatingMap.apply ℝ (Euclidean n) ℝ (Pi.basisFun ℝ (Fin n))).comp
      (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n).toContinuousLinearMap
  have hf := (compactCoefficientMap P C B K D n ω).property
  have hh : coordinateCoefficient C.tangent.fiberCoordinates P.chart P.chart_mem
      (D.inclusion.map n ω).val =
      fun z => L (globalCoefficientEquiv P C n (D.inclusion.map n ω).val z) :=
    funext (coordinateCoefficient_eq_alternating P C _)
  rw [hh]
  exact (L.continuous.comp hf.1.continuous).integrable_of_hasCompactSupport
    (hf.2.comp_left (map_zero L))

/-- Integration as a linear functional on the full compact complex. -/
def totalIntegralLinear : D.complex.Obj n →ₗ[ℝ] ℝ where
  toFun := totalIntegral P D
  map_add' ω η := by
    rw [totalIntegral_eq_alternating P C B K D,
      totalIntegral_eq_alternating P C B K D,
      totalIntegral_eq_alternating P C B K D]
    let L : (Index n n → ℝ) →L[ℝ] ℝ :=
      (ContinuousAlternatingMap.apply ℝ (Euclidean n) ℝ (Pi.basisFun ℝ (Fin n))).comp
        (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n).toContinuousLinearMap
    have hi (ξ : D.complex.Obj n) : Integrable (fun z =>
        L ((compactCoefficientMap P C B K D n ξ).val z)) :=
      (L.continuous.comp (compactCoefficientMap P C B K D n ξ).property.1.continuous).integrable_of_hasCompactSupport
        ((compactCoefficientMap P C B K D n ξ).property.2.comp_left (map_zero L))
    have hf := hi ω
    have hg := hi η
    change (∫ z, ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      (compactCoefficientMap P C B K D n (ω+η) |>.val z) (Pi.basisFun ℝ (Fin n))) = _
    rw [map_add]
    change (∫ z, ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      ((compactCoefficientMap P C B K D n ω).val z +
        (compactCoefficientMap P C B K D n η).val z) (Pi.basisFun ℝ (Fin n))) = _
    simp only [map_add, ContinuousAlternatingMap.add_apply]
    exact integral_add hf hg
  map_smul' r ω := by
    rw [totalIntegral_eq_alternating P C B K D,
      totalIntegral_eq_alternating P C B K D]
    change (∫ z, ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      (compactCoefficientMap P C B K D n (r • ω) |>.val z) (Pi.basisFun ℝ (Fin n))) = _
    rw [map_smul]
    change (∫ z, ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      (r • (compactCoefficientMap P C B K D n ω).val z) (Pi.basisFun ℝ (Fin n))) = _
    simp only [map_smul, ContinuousAlternatingMap.smul_apply]
    exact integral_smul r _

end IntegralBridge

section ExactIntegral
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation (n+1) M) (C : CotangentBundle P.manifold)
  (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤)

theorem totalIntegral_d (ω : D.complex.Obj n) : totalIntegral P D (D.complex.d n ω) = 0 := by
  let f := fun z : Euclidean (n+1) =>
    ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv (n+1) n
      (globalCoefficientEquiv P C n (D.inclusion.map n ω).val z)
  have hf := (compactCoefficientMap P C B K D n ω).property
  have hreg : ContDiff ℝ 1 f :=
    ((ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv (n+1) n).contDiff.comp hf.1).of_le (by simp)
  have hs : HasCompactSupport f := hf.2.comp_left
    (map_zero (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv (n+1) n))
  have h := (LocalStokesResults.fullSpaceStokes_proof n f hreg hs).2
  rw [totalIntegral_eq_alternating P C B K D]
  have he : (D.inclusion.map (n+1) (D.complex.d n ω)) =
      K.d n (D.inclusion.map n ω) := (D.inclusion.comm n ω).symm
  rw [he]
  apply (integral_congr_ae (Filter.Eventually.of_forall (fun z => ?_))).trans h
  rw [globalCoefficientEquiv_extDeriv P C B K n (D.inclusion.map n ω) z]
  change extDeriv f z (Pi.basisFun ℝ (Fin (n+1))) =
    extDeriv f z (LocalStokesData.frame (n+1))
  congr 1
  funext i
  exact Pi.basisFun_apply ℝ (Fin (n+1)) i

end ExactIntegral

/-- Integration vanishes on the actual compact exact submodule, including degree zero. -/
theorem totalIntegral_exact_zero {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (C : CotangentBundle P.manifold)
    (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤)
    (ω : D.complex.Obj n) (hω : ω ∈ D.complex.exact n) : totalIntegral P D ω = 0 := by
  cases n with
  | zero =>
    have h : ω = 0 := by simpa only [Cochain.exact, Submodule.mem_bot] using hω
    rw [h]
    exact map_zero (totalIntegralLinear P C B K D)
  | succ n =>
    obtain ⟨η, rfl⟩ := (LinearMap.mem_range).mp hω
    exact totalIntegral_d P C B K D η

section IntegralSurjectivity

/-- The determinant-normalized top wedge takes value one on the ordered frame. -/
theorem top_coefficient_value_one (n : ℕ) :
    ∃ a : Index n n → ℝ,
      ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n a
        (Pi.basisFun ℝ (Fin n)) = 1 := by
  let ξ : Fiber (Euclidean n) n :=
    exteriorPower.ιMulti ℝ n (Pi.basisFun ℝ (Fin n)).dualBasis
  refine ⟨(ExteriorDerivativeResults.Euclidean.euclideanExteriorBasis n n).equivFun ξ, ?_⟩
  change evaluate (Euclidean n) n
    ((ExteriorDerivativeResults.Euclidean.euclideanExteriorBasis n n).equivFun.symm
      ((ExteriorDerivativeResults.Euclidean.euclideanExteriorBasis n n).equivFun ξ))
      (Pi.basisFun ℝ (Fin n)) = 1
  rw [LinearEquiv.symm_apply_apply]
  rw [show ξ = exteriorPower.ιMulti ℝ n (Pi.basisFun ℝ (Fin n)).dualBasis from rfl,
    ExteriorAlgebraResults.determinant_normalization]
  have hm : (Matrix.of fun i j : Fin n => Pi.single j (1 : ℝ) i) = 1 := by
    ext i j
    simp [Pi.single_apply, Matrix.one_apply]
  simp only [Module.Basis.dualBasis_apply, Pi.basisFun_repr, Pi.basisFun_apply, hm,
    Matrix.det_one]

theorem totalIntegral_surjective {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (C : CotangentBundle P.manifold)
    (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤) :
    Surjective (totalIntegral P D) := by
  obtain ⟨a, ha⟩ := top_coefficient_value_one n
  let b : ContDiffBump (0 : Euclidean n) := default
  intro r
  let f : compactCoefficientForms n n := ⟨fun z => b.normed volume z • (r • a),
    b.contDiff_normed.smul contDiff_const,
    b.hasCompactSupport_normed.smul_right⟩
  let ω : D.complex.Obj n := (compactCoefficientEquiv P C B K D n).symm f
  have he : globalCoefficientEquiv P C n (D.inclusion.map n ω).val = f.val :=
    congrArg Subtype.val ((compactCoefficientEquiv P C B K D n).apply_symm_apply f)
  refine ⟨ω, ?_⟩
  rw [totalIntegral_eq_alternating P C B K D, he]
  change (∫ z : Euclidean n,
    ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n n
      (b.normed volume z • (r • a)) (Pi.basisFun ℝ (Fin n))) = r
  simp only [map_smul, ContinuousAlternatingMap.smul_apply, ha, smul_eq_mul,
    mul_one]
  rw [integral_mul_const, b.integral_normed, one_mul]

end IntegralSurjectivity


end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData MayerVietorisData ContinuousAlternatingMap
universe u v
variable {H : Type u} {E : Type v} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E]
/-- Pullback under a global linear coordinate equivalence transports all smooth
compact alternating forms, in both directions. -/
def compactAlternatingPullbackEquiv (e : H ≃L[ℝ] E) (k : ℕ) :
    compactAlternatingForms E k ≃ₗ[ℝ] compactAlternatingForms H k where
  toFun ω := ⟨fun x => (ω.val (e x)).compContinuousLinearMap e.toContinuousLinearMap,
    ⟨(compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.toContinuousLinearMap).contDiff.comp
      (ω.property.1.comp e.contDiff),
     (ω.property.2.comp_isClosedEmbedding e.toHomeomorph.isClosedEmbedding).comp_left
      (map_zero (compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.toContinuousLinearMap))⟩⟩
  invFun η := ⟨fun y => (η.val (e.symm y)).compContinuousLinearMap e.symm.toContinuousLinearMap,
    ⟨(compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.symm.toContinuousLinearMap).contDiff.comp
      (η.property.1.comp e.symm.contDiff),
     (η.property.2.comp_isClosedEmbedding e.symm.toHomeomorph.isClosedEmbedding).comp_left
      (map_zero (compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.symm.toContinuousLinearMap))⟩⟩
  left_inv ω := by
    apply Subtype.ext
    funext x
    ext w
    simp only [compContinuousLinearMap_apply, ContinuousLinearEquiv.coe_coe,
      ContinuousLinearEquiv.apply_symm_apply, Function.comp_def]
  right_inv η := by
    apply Subtype.ext
    funext x
    ext w
    simp only [compContinuousLinearMap_apply, ContinuousLinearEquiv.coe_coe,
      ContinuousLinearEquiv.symm_apply_apply, Function.comp_def]
  map_add' ω η := by
    apply Subtype.ext
    funext x
    exact map_add (compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.toContinuousLinearMap) _ _
  map_smul' r ω := by
    apply Subtype.ext
    funext x
    exact map_smul (compContinuousLinearMapCLM (F := ℝ) (ι := Fin k) e.toContinuousLinearMap) _ _

theorem compactAlternatingPullbackEquiv_derivative (e : H ≃L[ℝ] E)
    (k : ℕ) (ω : (compactAlternatingComplex E).Obj k) :
    compactAlternatingPullbackEquiv e (k+1) ((compactAlternatingComplex E).d k ω) =
      (compactAlternatingComplex H).d k (compactAlternatingPullbackEquiv e k ω) := by
  apply Subtype.ext
  funext x
  change (extDeriv ω.val (e x)).compContinuousLinearMap e.toContinuousLinearMap =
    extDeriv (fun y => (ω.val (e y)).compContinuousLinearMap e.toContinuousLinearMap) x
  have h := extDeriv_pullback
    (ω.property.1.contDiffAt.differentiableAt (by norm_num) : DifferentiableAt ℝ ω.val (e x))
    (e.contDiff.contDiffAt : ContDiffAt ℝ (⊤ : ℕ∞) e x)
    (by simp : minSmoothness ℝ 2 ≤ ((⊤ : ℕ∞) : WithTop ℕ∞))
  simpa only [ContinuousLinearEquiv.fderiv] using h.symm

/-- The first coordinate is the new time variable; this fixes the orientation
used in each induction step. -/
def euclideanSuccEquiv (n : ℕ) : Euclidean (n+1) ≃L[ℝ] ℝ × Euclidean n :=
  (show Euclidean (n+1) ≃ₗ[ℝ] ℝ × Euclidean n from {
    toFun z := (z 0, Fin.tail z)
    invFun p := Fin.cons p.1 p.2
    left_inv z := Fin.cons_self_tail z
    right_inv p := by simp
    map_add' z w := by ext i <;> rfl
    map_smul' r z := by ext i <;> rfl }).toContinuousLinearEquiv
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData ExteriorData MayerVietorisData ContinuousAlternatingMap Set Function
universe u

theorem compactAlternating_above_dimension (n k : ℕ) (hk : n < k) :
    Subsingleton ((compactAlternatingComplex (Euclidean n)).Obj k) := by
  have he : Set.powersetCard (Fin n) k = ∅ :=
    Set.powersetCard.eq_empty_iff.mpr (by simpa using hk)
  letI : IsEmpty (Index n k) := by
    unfold Index
    rw [he]
    infer_instance
  have hz (ω : (compactAlternatingComplex (Euclidean n)).Obj k) : ω = 0 := by
    apply Subtype.ext
    funext x
    apply (ExteriorDerivativeResults.Euclidean.coefficientAlternatingEquiv n k).symm.injective
    exact Subsingleton.elim _ _
  exact ⟨fun x y => (hz x).trans (hz y).symm⟩

theorem compactAlternating_zero_closed (n : ℕ) (hn : 0 < n)
    (ω : (compactAlternatingComplex (Euclidean n)).closed 0) : ω.val = 0 := by
  let e := constOfIsEmptyLIE ℝ (Euclidean n) ℝ (Fin 0)
  let f : Euclidean n → ℝ := fun x => e.symm (ω.val.val x)
  have hf : ContDiff ℝ (⊤ : ℕ∞) f := e.symm.contDiff.comp ω.val.property.1
  have hs : HasCompactSupport f := ω.val.property.2.comp_left (map_zero e.symm)
  have he (x : Euclidean n) : ω.val.val x = constOfIsEmpty ℝ (Euclidean n) (Fin 0) (f x) :=
    (e.apply_symm_apply _).symm
  have hω : ω.val.val = fun x => constOfIsEmpty ℝ (Euclidean n) (Fin 0) (f x) := funext he
  have hd (x : Euclidean n) : fderiv ℝ f x = 0 := by
    have h0 : extDeriv ω.val.val x = 0 := congrArg (fun a => a.val x) ω.property
    rw [hω, extDeriv_constOfIsEmpty] at h0
    ext v
    have hv := congrArg (fun a => a (fun _ : Fin 1 => v)) h0
    simpa using hv
  have hc (x y : Euclidean n) : f x = f y :=
    is_const_of_fderiv_eq_zero (hf.differentiable (by norm_num)) hd x y
  let i : Fin n := ⟨0, hn⟩
  obtain ⟨b, hb⟩ := (hs.image (continuous_apply i)).bddAbove
  let q : Euclidean n := fun _ => b+1
  have hq : q ∉ tsupport f := by
    intro hq
    have := hb (show q i ∈ (fun z : Euclidean n => z i) '' tsupport f from ⟨q,hq,rfl⟩)
    dsimp [q] at this
    linarith
  have hz : f q = 0 := image_eq_zero_of_notMem_tsupport hq
  apply Subtype.ext
  funext x
  rw [he, hc x q, hz]
  exact map_zero e

theorem compactAlternating_degree_zero (n : ℕ) (hn : 0 < n) :
    Subsingleton ((compactAlternatingComplex (Euclidean n)).H 0) := by
  apply cohomology_subsingleton_of_closed_exact
  intro ω
  change ω.val ∈ (⊥ : Submodule ℝ _)
  exact (Submodule.mem_bot ℝ).mpr (compactAlternating_zero_closed n hn ω)
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData MayerVietorisData ContinuousAlternatingMap Set Function
/-- Evaluation of the genuine degree-zero alternating field at the unique point. -/
def compactAlternatingPointEvaluation :
    (compactAlternatingComplex (Euclidean 0)).Obj 0 →ₗ[ℝ] ℝ where
  toFun ω := ω.val 0 (fun i : Fin 0 => Fin.elim0 i)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem compactAlternatingPointEvaluation_bijective :
    Bijective compactAlternatingPointEvaluation := by
  constructor
  · intro ω η h
    apply Subtype.ext
    funext p
    ext w
    have hp : p = (0 : Euclidean 0) := Subsingleton.elim _ _
    have hw : w = fun i : Fin 0 => Fin.elim0 i := Subsingleton.elim _ _
    subst p
    rw [hw]
    exact h
  · intro r
    let ω : (compactAlternatingComplex (Euclidean 0)).Obj 0 :=
      ⟨fun _ => constOfIsEmpty ℝ (Euclidean 0) (Fin 0) r,
        ⟨contDiff_const, (Set.toFinite _).isCompact⟩⟩
    exact ⟨ω, rfl⟩

theorem compactAlternating_point_cohomology :
    Nonempty ((compactAlternatingComplex (Euclidean 0)).H 0 ≃ₗ[ℝ] ℝ) := by
  have hc (ω : (compactAlternatingComplex (Euclidean 0)).Obj 0) :
      (compactAlternatingComplex (Euclidean 0)).d 0 ω = 0 := by
    letI := compactAlternating_above_dimension 0 1 (by decide)
    exact Subsingleton.elim _ _
  obtain ⟨e, he⟩ := cohomology_equiv_of_exact_iff (compactAlternatingComplex (Euclidean 0)) 0
    compactAlternatingPointEvaluation hc compactAlternatingPointEvaluation_bijective.2
    (fun ω => by
      change ω ∈ (⊥ : Submodule ℝ _) ↔ _
      rw [Submodule.mem_bot]
      exact ⟨fun h => by rw [h, _root_.map_zero], fun h =>
        compactAlternatingPointEvaluation_bijective.1 (by simpa using h)⟩)
  exact ⟨e⟩
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData LocalIntegrationData FormPullbackData MeasureTheory Set Function
universe u

theorem compactIntrinsicCohomologyEquiv {n : ℕ} {M : Type u} [TopologicalSpace M]
    (P : Presentation n M) (C : CotangentBundle P.manifold)
    (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤) (k : ℕ) :
    Nonempty (D.Cohomology k ≃ₗ[ℝ] (compactAlternatingComplex (Euclidean n)).H k) := by
  obtain ⟨e, he⟩ := cohomology_equiv_of_complex_equiv D.complex
    (compactAlternatingComplex (Euclidean n))
    (compactIntrinsicAlternatingEquiv P C B K D)
    (compactIntrinsicAlternatingEquiv_derivative P C B K D) k
  exact ⟨e⟩

/-- Dimension induction needs just the proved degree shift; no choice of
integration normalization enters the vanishing or one-dimensionality argument. -/
theorem euclidean_cohomology_of_shift
    (hshift : ∀ n k : ℕ, Nonempty
      ((compactAlternatingComplex (Euclidean (n+1))).H (k+1) ≃ₗ[ℝ]
        (compactAlternatingComplex (Euclidean n)).H k)) :
    (∀ n k : ℕ, k ≠ n → Subsingleton ((compactAlternatingComplex (Euclidean n)).H k)) ∧
    (∀ n : ℕ, Nonempty ((compactAlternatingComplex (Euclidean n)).H n ≃ₗ[ℝ] ℝ)) := by
  constructor
  · intro n
    induction n with
    | zero =>
      intro k hk
      letI := compactAlternating_above_dimension 0 k (Nat.pos_of_ne_zero hk)
      change Subsingleton ((compactAlternatingComplex (Euclidean 0)).closed k ⧸
        (compactAlternatingComplex (Euclidean 0)).boundaries k)
      infer_instance
    | succ n ih =>
      intro k hk
      cases k with
      | zero => exact compactAlternating_degree_zero (n+1) (Nat.succ_pos n)
      | succ k =>
        obtain ⟨e⟩ := hshift n k
        letI := ih k (fun h => hk (congrArg Nat.succ h))
        exact ⟨fun x y => e.injective (Subsingleton.elim _ _)⟩
  · intro n
    induction n with
    | zero => exact compactAlternating_point_cohomology
    | succ n ih =>
      obtain ⟨e⟩ := hshift n n
      obtain ⟨f⟩ := ih
      exact ⟨e.trans f⟩
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData LocalIntegrationData FormPullbackData MeasureTheory Set Function
universe u

section TopIntegration
variable {n : ℕ} {M : Type u} [TopologicalSpace M]
  (P : Presentation n M) (C : CotangentBundle P.manifold)
  (B : ∀ k, FormBundle C k) (K : Calculus C B) (D : CompactCalculus K ⊤)

/-- Actual top integration descends because the actual compact exact submodule
is annihilated by the actual coordinate Lebesgue integral. -/
def topIntegrationMap : D.Cohomology n →ₗ[ℝ] ℝ :=
  (D.complex.boundaries n).liftQ
    ((totalIntegralLinear P C B K D).comp (D.complex.closed n).subtype)
    (fun ω hω => totalIntegral_exact_zero P C B K D ω.val hω)

@[simp] theorem topIntegrationMap_classOf (ω : D.complex.closed n) :
    topIntegrationMap P C B K D (D.complex.classOf n ω) = totalIntegral P D ω.val := rfl

theorem topIntegrationMap_surjective : Surjective (topIntegrationMap P C B K D) := by
  intro r
  obtain ⟨ω, hω⟩ := totalIntegral_surjective P C B K D r
  exact ⟨D.complex.classOf n ⟨ω, top_all_closed D ω⟩, hω⟩

/-- Once the top cohomology has been computed abstractly as one dimensional,
its actual integration map is necessarily an equivalence. This step requires
no choice of normalization for the abstract computation. -/
theorem top_integration_equiv_of_nonempty
    (h : Nonempty (D.Cohomology n ≃ₗ[ℝ] ℝ)) :
    ∃ e : D.Cohomology n ≃ₗ[ℝ] ℝ,
      ∀ ω : D.complex.closed n,
        e (D.complex.classOf n ω) = totalIntegral P D ω.val := by
  obtain ⟨e₀⟩ := h
  let F := topIntegrationMap P C B K D
  let G : ℝ →ₗ[ℝ] ℝ := F.comp e₀.symm.toLinearMap
  have hs : Surjective F := topIntegrationMap_surjective P C B K D
  have hGs : Surjective G := hs.comp e₀.symm.surjective
  have hGi : Injective G := LinearMap.injective_iff_surjective.mpr hGs
  have hFi : Injective F := by
    intro x y hxy
    apply e₀.injective
    apply hGi
    simpa only [G, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
      LinearEquiv.symm_apply_apply] using hxy
  exact ⟨LinearEquiv.ofBijective F ⟨hFi, hs⟩, fun ω => rfl⟩

/-- The compact primitive criterion follows for every top form from the
computed top cohomology and the actual integration equivalence. -/
theorem top_exact_iff_of_nonempty
    (h : Nonempty (D.Cohomology n ≃ₗ[ℝ] ℝ)) (ω : D.complex.Obj n) :
    ω ∈ D.complex.exact n ↔ totalIntegral P D ω = 0 := by
  obtain ⟨e, he⟩ := top_integration_equiv_of_nonempty P C B K D h
  exact exact_iff_zero_of_equiv D.complex n (totalIntegral P D) e he (top_all_closed D) ω

end TopIntegration

end SmoothManifolds.EuclideanCompactResults

