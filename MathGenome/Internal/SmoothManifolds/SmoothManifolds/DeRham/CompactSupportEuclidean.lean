open ContinuousAlternatingMap
section ZeroDegreeExterior
variable {H F : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
theorem verticalPart_extDeriv_zero
    (ω : ℝ × H → (ℝ × H) [⋀^Fin 0]→L[ℝ] F) (t : ℝ) (x : H)
    (hω : DifferentiableAt ℝ ω (t,x)) :
    verticalPartCLM 0 (extDeriv ω (t,x)) =
      deriv (fun s => horizontalPartCLM 0 (ω (s,x))) t := by
  rw [timeDerivative_horizontalPart _ t x hω]
  ext w
  simp [verticalPartCLM, horizontalPartCLM, extDeriv, alternatizeUncurryFin_apply,
    Function.comp_def, Fin.sum_univ_succ]

end ZeroDegreeExterior
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MeasureTheory Set ContinuousAlternatingMap
universe v
section ProductIntegral
variable {H E : Type v} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
variable {n : ℕ}

def verticalIntegral (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] E)
    (x : H) : H [⋀^Fin n]→L[ℝ] E := ∫ t : ℝ, verticalPartCLM n (ω (t,x))

def verticalInsert (ρ : ℝ → ℝ) (γ : H → H [⋀^Fin n]→L[ℝ] E)
    (p : ℝ × H) : (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] E := dtWedge (ρ p.1 • γ p.2)

theorem verticalIntegral_verticalInsert (ρ : ℝ → ℝ)
    (γ : H → H [⋀^Fin n]→L[ℝ] E) (hρ : (∫ t : ℝ, ρ t) = 1) :
    verticalIntegral (verticalInsert ρ γ) = γ := by
  funext x
  simp only [verticalIntegral, verticalInsert, verticalPart_dtWedge,
    integral_smul_const, hρ, one_smul]

theorem verticalIntegral_extDeriv
    (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] E)
    (hf : ContDiff ℝ 1 ω) (hs : HasCompactSupport ω) (x : H) :
    verticalIntegral (extDeriv ω) x = -extDeriv (verticalIntegral ω) x := by
  let α := fun p => horizontalPartCLM (n+1) (ω p)
  let β := fun p => verticalPartCLM n (ω p)
  have hα : ContDiff ℝ 1 α := contDiff_horizontalPart ω hf
  have hβ : ContDiff ℝ 1 β := contDiff_verticalPart ω hf
  have hsα : HasCompactSupport α := hasCompactSupport_horizontalPart ω hs
  have hsβ : HasCompactSupport β := hasCompactSupport_verticalPart ω hs
  have ht : Integrable (fun t : ℝ => deriv (fun s => α (s,x)) t) :=
    ((hα.comp (contDiff_id.prodMk contDiff_const)).continuous_deriv le_rfl).integrable_of_hasCompactSupport
      (compact_slice_hasCompactSupport α hsα x).deriv
  have hx : Integrable (fun t : ℝ => extDeriv (fun y => β (t,y)) x) := by
    have hi := compact_slice_integrable (spatialDerivative β)
      ((spatialDerivative_contDiff β hβ (s := 0) (by norm_num)).continuous)
      (spatialDerivative_hasCompactSupport β hsβ) x
    convert (alternatizeUncurryFinCLM ℝ H E).integrable_comp hi using 1
    funext t
    unfold extDeriv spatialDerivative
    congr 1
    exact ((hβ.contDiffAt.differentiableAt (by norm_num)).hasFDerivAt.comp x
      (hasFDerivAt_prodMk_right t x)).fderiv
  unfold verticalIntegral
  simp_rw [verticalPart_extDeriv' ω _ x (hf.differentiable one_ne_zero _)]
  rw [integral_sub ht hx, fiberIntegral_timeDeriv_eq_zero α hα hsα x, zero_sub]
  rw [extDeriv_fiberIntegral volume β hβ hsβ x]

theorem verticalIntegral_extDeriv_zero
    (ω : ℝ × H → (ℝ × H) [⋀^Fin 0]→L[ℝ] E)
    (hf : ContDiff ℝ 1 ω) (hs : HasCompactSupport ω) :
    verticalIntegral (extDeriv ω) = 0 := by
  funext x
  unfold verticalIntegral
  simp_rw [verticalPart_extDeriv_zero ω _ x (hf.differentiable one_ne_zero _)]
  exact fiberIntegral_timeDeriv_eq_zero _ (contDiff_horizontalPart ω hf)
    (hasCompactSupport_horizontalPart ω hs) x

end ProductIntegral

section CompactIntegrationOperators
variable {H : Type} [NormedAddCommGroup H] [NormedSpace ℝ H]
variable {n : ℕ}

theorem verticalInsert_mem (ρ : ℝ → ℝ) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsρ : HasCompactSupport ρ) (γ : compactAlternatingForms H n) :
    verticalInsert ρ γ.val ∈ compactAlternatingForms (ℝ × H) (n+1) := by
  have hf : ContDiff ℝ (⊤ : ℕ∞) (fun p : ℝ × H => ρ p.1 • γ.val p.2) :=
    (hρ.comp contDiff_fst).smul (γ.property.1.comp contDiff_snd)
  have hs : HasCompactSupport (fun p : ℝ × H => ρ p.1 • γ.val p.2) := by
    apply HasCompactSupport.intro (hsρ.prod γ.property.2)
    intro p hp
    have hp' : p.1 ∉ tsupport ρ ∨ p.2 ∉ tsupport γ.val := by
      simpa only [mem_prod, not_and_or] using hp
    rcases hp' with ht | hx
    · rw [image_eq_zero_of_notMem_tsupport ht, zero_smul]
    · rw [image_eq_zero_of_notMem_tsupport hx, smul_zero]
  exact ⟨(dtWedgeCLM (H := H) (F := ℝ) n).contDiff.comp hf,
    hs.comp_left (g := dtWedgeCLM n) (map_zero _)⟩

def compactVerticalIntegral (n : ℕ) :
    compactAlternatingForms (ℝ × H) (n+1) →ₗ[ℝ] compactAlternatingForms H n where
  toFun ω := ⟨verticalIntegral ω.val,
    fiberIntegral_contDiff _ (contDiff_verticalPart ω.val ω.property.1)
      (hasCompactSupport_verticalPart ω.val ω.property.2),
    fiberIntegral_hasCompactSupport _ (hasCompactSupport_verticalPart ω.val ω.property.2)⟩
  map_add' ω η := by
    apply Subtype.ext
    funext x
    change (∫ t : ℝ, verticalPartCLM n (ω.val (t,x) + η.val (t,x))) = _
    simp only [map_add]
    exact integral_add
      (compact_slice_integrable _ (contDiff_verticalPart ω.val ω.property.1).continuous
        (hasCompactSupport_verticalPart ω.val ω.property.2) x)
      (compact_slice_integrable _ (contDiff_verticalPart η.val η.property.1).continuous
        (hasCompactSupport_verticalPart η.val η.property.2) x)
  map_smul' r ω := by
    apply Subtype.ext
    funext x
    change (∫ t : ℝ, verticalPartCLM n (r • ω.val (t,x))) = _
    simp only [map_smul, integral_smul]
    rfl

def compactVerticalInsert (ρ : ℝ → ℝ) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsρ : HasCompactSupport ρ) (n : ℕ) :
    compactAlternatingForms H n →ₗ[ℝ] compactAlternatingForms (ℝ × H) (n+1) where
  toFun γ := ⟨verticalInsert ρ γ.val, verticalInsert_mem ρ hρ hsρ γ⟩
  map_add' γ δ := by
    apply Subtype.ext
    funext p
    change dtWedgeCLM n (ρ p.1 • (γ.val p.2 + δ.val p.2)) = _
    rw [smul_add, map_add]
    rfl
  map_smul' r γ := by
    apply Subtype.ext
    funext p
    change dtWedgeCLM n (ρ p.1 • (r • γ.val p.2)) = _
    rw [smul_comm (ρ p.1) r, map_smul]
    rfl

theorem compactVerticalIntegral_extDeriv (n : ℕ)
    (ω : compactAlternatingForms (ℝ × H) (n+1)) :
    compactVerticalIntegral (H := H) (n+1)
      ((compactAlternatingComplex (ℝ × H)).d (n+1) ω) =
      -(compactAlternatingComplex H).d n (compactVerticalIntegral n ω) := by
  apply Subtype.ext
  funext x
  exact verticalIntegral_extDeriv ω.val (ω.property.1.of_le (by simp)) ω.property.2 x

theorem compactVerticalIntegral_extDeriv_zero
    (ω : compactAlternatingForms (ℝ × H) 0) :
    compactVerticalIntegral (H := H) 0 ((compactAlternatingComplex (ℝ × H)).d 0 ω) = 0 := by
  apply Subtype.ext
  exact verticalIntegral_extDeriv_zero ω.val (ω.property.1.of_le (by simp)) ω.property.2

theorem compactVerticalInsert_extDeriv (ρ : ℝ → ℝ) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hsρ : HasCompactSupport ρ) (n : ℕ) (γ : compactAlternatingForms H n) :
    (compactAlternatingComplex (ℝ × H)).d (n+1) (compactVerticalInsert ρ hρ hsρ n γ) =
      -compactVerticalInsert ρ hρ hsρ (n+1) ((compactAlternatingComplex H).d n γ) := by
  apply Subtype.ext
  funext p
  exact dtWedge_extDeriv ρ γ.val p.1 p.2
    (hρ.differentiable (by norm_num) p.1) (γ.property.1.differentiable (by norm_num) p.2)

theorem compactVerticalIntegral_verticalInsert (ρ : ℝ → ℝ)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) (n : ℕ) (γ : compactAlternatingForms H n) :
    compactVerticalIntegral n (compactVerticalInsert ρ hρ hsρ n γ) = γ := by
  apply Subtype.ext
  exact verticalIntegral_verticalInsert ρ γ.val hρ1

end CompactIntegrationOperators
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ContinuousAlternatingMap MeasureTheory Set Function
universe u
section PrimitiveLift
variable {H F : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
variable {n : ℕ} (β : ℝ × H → H [⋀^Fin n]→L[ℝ] F)

theorem horizontalLift_lowerPrimitive_extDeriv
    (hf : ContDiff ℝ (⊤ : ℕ∞) β) (hs : HasCompactSupport β) (t : ℝ) (x : H) :
    extDeriv (fun p : ℝ × H => (lowerPrimitive β p).compContinuousLinearMap horProj) (t,x) =
      (extDeriv (fun y : H => lowerPrimitive β (t,y)) x).compContinuousLinearMap horProj +
        dtWedge (β (t,x)) := by
  have hd := (compContinuousLinearMapCLM (F := F) (ι := Fin n) (horProj (H := H))).hasFDerivAt.comp (t,x)
    (lowerPrimitive_hasFDerivAt β hf hs (t,x))
  change HasFDerivAt (fun p : ℝ × H => (lowerPrimitive β p).compContinuousLinearMap horProj) _ (t,x) at hd
  have hx := (lowerPrimitive_hasFDerivAt_space β (hf.of_le (by simp)) hs t x).fderiv
  unfold extDeriv
  rw [hd.fderiv, hx]
  ext v
  simp only [alternatizeUncurryFin_apply, ContinuousLinearMap.comp_apply,
    _root_.add_apply, ContinuousLinearMap.smulRight_apply,
    compContinuousLinearMapCLM_apply, ContinuousAlternatingMap.compContinuousLinearMap_apply,
    ContinuousAlternatingMap.add_apply, ContinuousAlternatingMap.smul_apply,
    dtWedge, Function.comp_def, Fin.removeNth, smul_add, Finset.sum_add_distrib]
  rw [add_comm]
  rfl

theorem extDeriv_correctedCoefficient_space (ρ : ℝ → ℝ)
    (hf : ContDiff ℝ 1 β) (hs : HasCompactSupport β) (t : ℝ) (x : H) :
    extDeriv (fun y : H => correctedCoefficient β ρ t y) x =
      extDeriv (fun y : H => β (t,y)) x -
        ρ t • ∫ s : ℝ, extDeriv (fun y : H => β (s,y)) x := by
  have hfirst : DifferentiableAt ℝ (fun y : H => β (t,y)) x :=
    (hf.contDiffAt.differentiableAt (by norm_num)).comp x (slice_hasFDerivAt t x).differentiableAt
  have hm := (fiberIntegral_hasFDerivAt β hf hs x).differentiableAt
  have he : (fun y : H => correctedCoefficient β ρ t y) =
      (fun y : H => β (t,y)) + (-ρ t) • (fun y : H => ∫ s : ℝ, β (s,y)) := by
    funext y
    simp [correctedCoefficient, sub_eq_add_neg, neg_smul]
  rw [he, extDeriv_add hfirst (hm.const_smul (-ρ t)), extDeriv_smul]
  rw [extDeriv_fiberIntegral volume β hf hs x]
  simp only [neg_smul, sub_eq_add_neg]
end PrimitiveLift

section ClosedProductForms
variable {H F : Type u} [NormedAddCommGroup H] [NormedSpace ℝ H]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [CompleteSpace F]
variable {n : ℕ} (ω : ℝ × H → (ℝ × H) [⋀^Fin (n+1)]→L[ℝ] F)

theorem closed_verticalPart_extDeriv (hf : ContDiff ℝ 1 ω)
    (hclosed : ∀ p, extDeriv ω p = 0) (t : ℝ) (x : H) :
    extDeriv (fun y : H => verticalPartCLM n (ω (t,y))) x =
      deriv (fun s : ℝ => horizontalPartCLM (n+1) (ω (s,x))) t := by
  have h := verticalPart_extDeriv' ω t x (hf.differentiable one_ne_zero (t,x))
  rw [hclosed, _root_.map_zero] at h
  exact (sub_eq_zero.mp h.symm).symm

theorem closed_verticalPart_integral_extDeriv (hf : ContDiff ℝ 1 ω)
    (hs : HasCompactSupport ω) (hclosed : ∀ p, extDeriv ω p = 0) (x : H) :
    extDeriv (fun y : H => ∫ t : ℝ, verticalPartCLM n (ω (t,y))) x = 0 := by
  rw [extDeriv_fiberIntegral volume _ (contDiff_verticalPart ω hf)
    (hasCompactSupport_verticalPart ω hs) x]
  simp_rw [closed_verticalPart_extDeriv ω hf hclosed]
  exact fiberIntegral_timeDeriv_eq_zero _ (contDiff_horizontalPart ω hf)
    (hasCompactSupport_horizontalPart ω hs) x

def compactProductPrimitive (ρ : ℝ → ℝ) : ℝ × H → (ℝ × H) [⋀^Fin n]→L[ℝ] F :=
  fun p => (lowerPrimitive (fun q : ℝ × H =>
    correctedCoefficient (fun r => verticalPartCLM n (ω r)) ρ q.1 q.2) p).compContinuousLinearMap horProj

theorem compactProductPrimitive_contDiff (ρ : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) ω) (hs : HasCompactSupport ω)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ) :
    ContDiff ℝ (⊤ : ℕ∞) (compactProductPrimitive ω ρ) :=
  (compContinuousLinearMapCLM (F := F) (ι := Fin n) (horProj (H := H))).contDiff.comp
    (corrected_lowerPrimitive_contDiff _ ρ (contDiff_verticalPart ω hf) hρ
      (hasCompactSupport_verticalPart ω hs) hsρ)

theorem compactProductPrimitive_hasCompactSupport (ρ : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) ω) (hs : HasCompactSupport ω)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) :
    HasCompactSupport (compactProductPrimitive ω ρ) :=
  (corrected_lowerPrimitive_hasCompactSupport _ ρ (contDiff_verticalPart ω hf).continuous
    hρ.continuous (hasCompactSupport_verticalPart ω hs) hsρ hρ1).comp_left
      (g := compContinuousLinearMapCLM (F := F) (ι := Fin n) (horProj (H := H)))
      (_root_.map_zero _)

theorem closed_corrected_primitive_spatialDeriv (ρ : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) ω) (hs : HasCompactSupport ω)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hclosed : ∀ p, extDeriv ω p = 0) (t : ℝ) (x : H) :
    extDeriv (fun y : H => lowerPrimitive (fun q : ℝ × H =>
      correctedCoefficient (fun r => verticalPartCLM n (ω r)) ρ q.1 q.2) (t,y)) x =
        horizontalPartCLM (n+1) (ω (t,x)) := by
  let α := fun p => horizontalPartCLM (n+1) (ω p)
  let β := fun p => verticalPartCLM n (ω p)
  let C := fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2
  have hf1 : ContDiff ℝ 1 ω := hf.of_le (by simp)
  have hα : ContDiff ℝ 1 α := contDiff_horizontalPart ω hf1
  have hβ : ContDiff ℝ (⊤ : ℕ∞) β := contDiff_verticalPart ω hf
  have hβ1 : ContDiff ℝ 1 β := hβ.of_le (by simp)
  have hsα : HasCompactSupport α := hasCompactSupport_horizontalPart ω hs
  have hsβ : HasCompactSupport β := hasCompactSupport_verticalPart ω hs
  have hC : ContDiff ℝ (⊤ : ℕ∞) C := correctedCoefficient_contDiff β ρ hβ hρ hsβ
  have hsC : HasCompactSupport C := correctedCoefficient_hasCompactSupport β ρ hsβ hsρ
  have hI (y : H) : extDeriv (fun z : H => ∫ s : ℝ, β (s,z)) y = 0 :=
    closed_verticalPart_integral_extDeriv ω hf1 hs hclosed y
  have hCder (s : ℝ) (y : H) : extDeriv (fun z : H => C (s,z)) y =
      deriv (fun r : ℝ => α (r,y)) s := by
    change extDeriv (fun z : H => correctedCoefficient β ρ s z) y = _
    rw [extDeriv_correctedCoefficient_space β ρ hβ1 hsβ s y,
      ← extDeriv_fiberIntegral volume β hβ1 hsβ y, hI, smul_zero, sub_zero]
    exact closed_verticalPart_extDeriv ω hf1 hclosed s y
  change extDeriv (fun y : H => lowerPrimitive C (t,y)) x = α (t,x)
  rw [extDeriv_lowerPrimitive_space C (hC.of_le (by simp)) hsC t x]
  have he : (fun q : ℝ × H => extDeriv (fun y : H => C (q.1,y)) q.2) =
      (fun q : ℝ × H => deriv (fun s : ℝ => α (s,q.2)) q.1) := by
    funext q
    exact hCder q.1 q.2
  rw [he]
  exact congrFun (lowerPrimitive_timeDeriv α hα hsα) (t,x)

theorem compactProductPrimitive_extDeriv_of_closed (ρ : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) ω) (hs : HasCompactSupport ω)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hclosed : ∀ p, extDeriv ω p = 0) (p : ℝ × H) :
    extDeriv (compactProductPrimitive ω ρ) p =
      ω p - ρ p.1 • dtWedge (∫ s : ℝ, verticalPartCLM n (ω (s,p.2))) := by
  let β := fun q => verticalPartCLM n (ω q)
  let C := fun q : ℝ × H => correctedCoefficient β ρ q.1 q.2
  have hβ : ContDiff ℝ (⊤ : ℕ∞) β := contDiff_verticalPart ω hf
  have hsβ : HasCompactSupport β := hasCompactSupport_verticalPart ω hs
  have hC : ContDiff ℝ (⊤ : ℕ∞) C := correctedCoefficient_contDiff β ρ hβ hρ hsβ
  have hsC : HasCompactSupport C := correctedCoefficient_hasCompactSupport β ρ hsβ hsρ
  change extDeriv (fun q : ℝ × H => (lowerPrimitive C q).compContinuousLinearMap horProj) p = _
  rw [horizontalLift_lowerPrimitive_extDeriv C hC hsC p.1 p.2,
    closed_corrected_primitive_spatialDeriv ω ρ hf hs hρ hsρ hclosed p.1 p.2]
  have hdt : dtWedge (C p) = dtWedge (β p) -
      ρ p.1 • dtWedge (∫ s : ℝ, β (s,p.2)) := by
    change dtWedgeCLM n (β p - ρ p.1 • ∫ s : ℝ, β (s,p.2)) = _
    rw [_root_.map_sub, _root_.map_smul]
    rfl
  rw [hdt]
  have hrec := product_reconstruction (ω p)
  change ω p = (horizontalPartCLM (n+1) (ω p)).compContinuousLinearMap horProj +
    dtWedge (β p) at hrec
  rw [← add_sub_assoc, ← hrec]
end ClosedProductForms
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open MeasureTheory ContinuousAlternatingMap
section BundledCompactProductHomotopy
variable {H : Type} [NormedAddCommGroup H] [NormedSpace ℝ H]

theorem compactProductPrimitive_difference_exact (ρ : ℝ → ℝ)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) (n : ℕ)
    (x : (compactAlternatingComplex (ℝ × H)).closed (n+1)) :
    Sub.sub (α := (compactAlternatingComplex (ℝ × H)).Obj (n+1)) x.val
      (compactVerticalInsert ρ hρ hsρ n (compactVerticalIntegral n x.val)) ∈
      (compactAlternatingComplex (ℝ × H)).exact (n+1) := by
  let b : compactAlternatingForms (ℝ × H) n :=
    ⟨compactProductPrimitive x.val.val ρ,
      compactProductPrimitive_contDiff x.val.val ρ x.val.property.1 x.val.property.2 hρ hsρ,
      compactProductPrimitive_hasCompactSupport x.val.val ρ x.val.property.1 x.val.property.2 hρ hsρ hρ1⟩
  have hz (p : ℝ × H) : extDeriv x.val.val p = 0 :=
    congrArg (fun z : compactAlternatingForms (ℝ × H) (n+2) => z.val p) x.property
  refine ⟨b, ?_⟩
  apply Subtype.ext
  funext p
  change extDeriv (compactProductPrimitive x.val.val ρ) p =
    x.val.val p - dtWedge (ρ p.1 • ∫ s : ℝ, verticalPartCLM n (x.val.val (s,p.2)))
  have hdt : dtWedge (ρ p.1 • ∫ s : ℝ, verticalPartCLM n (x.val.val (s,p.2))) =
      ρ p.1 • dtWedge (∫ s : ℝ, verticalPartCLM n (x.val.val (s,p.2))) :=
    (dtWedgeCLM n).map_smul (ρ p.1) _
  rw [hdt]
  exact compactProductPrimitive_extDeriv_of_closed x.val.val ρ
    x.val.property.1 x.val.property.2 hρ hsρ hz p
end BundledCompactProductHomotopy
end SmoothManifolds.EuclideanCompactResults

namespace SmoothManifolds.EuclideanCompactResults
open ModelData AtlasData TangentData TangentBundleData BundleOperationsData
  CovectorData ExteriorData DeRhamData MayerVietorisData CompactSupportData
  EuclideanCompactData LocalIntegrationData FormPullbackData MeasureTheory Set Function
universe u

/-- Corrected integration gives the degree shift on the actual compact
alternating-form complexes. All support and differential identities have been
proved for these operators. -/
theorem compactAlternating_product_shift {H : Type}
    [NormedAddCommGroup H] [NormedSpace ℝ H]
    (ρ : ℝ → ℝ) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hsρ : HasCompactSupport ρ)
    (hρ1 : (∫ t : ℝ, ρ t) = 1) (k : ℕ) :
    Nonempty ((compactAlternatingComplex (ℝ × H)).H (k+1) ≃ₗ[ℝ]
      (compactAlternatingComplex H).H k) := by
  obtain ⟨e, he⟩ := suspension_cohomology_equiv
    (compactAlternatingComplex (ℝ × H)) (compactAlternatingComplex H)
    (compactVerticalIntegral (H := H)) (compactVerticalInsert (H := H) ρ hρ hsρ)
    compactVerticalIntegral_extDeriv compactVerticalIntegral_extDeriv_zero
    (compactVerticalInsert_extDeriv ρ hρ hsρ)
    (compactVerticalIntegral_verticalInsert ρ hρ hsρ hρ1)
    (compactProductPrimitive_difference_exact ρ hρ hsρ hρ1) k
  exact ⟨e⟩

/-- Reindexing the ordered Euclidean coordinates and applying corrected
integration removes exactly one coordinate and one cohomological degree. -/
theorem euclidean_compact_shift (n k : ℕ) :
    Nonempty ((compactAlternatingComplex (Euclidean (n+1))).H (k+1) ≃ₗ[ℝ]
      (compactAlternatingComplex (Euclidean n)).H k) := by
  obtain ⟨ρ, hρ, hsρ, hiρ, hρ1⟩ := normalized_cutoff_exists
  obtain ⟨c, hc⟩ := cohomology_equiv_of_complex_equiv
    (compactAlternatingComplex (Euclidean (n+1)))
    (compactAlternatingComplex (ℝ × Euclidean n))
    (compactAlternatingPullbackEquiv (euclideanSuccEquiv n).symm)
    (compactAlternatingPullbackEquiv_derivative (euclideanSuccEquiv n).symm) (k+1)
  obtain ⟨e⟩ := compactAlternating_product_shift (H := Euclidean n) ρ hρ hsρ hρ1 k
  exact ⟨c.trans e⟩

/-- The complete compact-support Poincaré calculation, including the actual
integration map, compact primitives, and the zero negative-degree convention. -/
theorem calculation :
    Specs.SmoothManifolds.DeRham.CompactSupportEuclidean.calculationType.{u} := by
  intro n M _ P C B K D
  have hdim := euclidean_cohomology_of_shift euclidean_compact_shift
  obtain ⟨a⟩ := compactIntrinsicCohomologyEquiv P C B K D n
  obtain ⟨b⟩ := hdim.2 n
  have htop : Nonempty (D.Cohomology n ≃ₗ[ℝ] ℝ) := ⟨a.trans b⟩
  refine ⟨?_, negative_degrees D,
    top_integration_equiv_of_nonempty P C B K D htop,
    top_exact_iff_of_nonempty P C B K D htop⟩
  intro k hk
  obtain ⟨e⟩ := compactIntrinsicCohomologyEquiv P C B K D k
  letI := hdim.1 n k hk
  exact ⟨fun x y => e.injective (Subsingleton.elim _ _)⟩
end SmoothManifolds.EuclideanCompactResults
