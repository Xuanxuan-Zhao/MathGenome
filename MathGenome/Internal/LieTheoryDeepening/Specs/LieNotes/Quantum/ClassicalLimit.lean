import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.Quantum.Completion
import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.Quantum.MatrixSpecialization

noncomputable section

open scoped TensorProduct

namespace Specs.LieNotes.Quantum.ClassicalLimit

open Completion (AtLevel CompletedSquare HopfMaps Level Limit Square TensorPower Uh project)
open MatrixSpecialization (Classical ClassicalHopf GeneratorImages LevelOne)

universe u

/-- The first positive truncation is the specialization at the zero parameter. -/
def firstLevel : Level := ⟨1, le_rfl⟩

variable (k : Type u) [Field k] [CharZero k]

scoped instance limitBaseAlgebra (p : TensorPower) : Algebra k (Limit k p) :=
  Algebra.compHom _ PowerSeries.C

scoped instance levelBaseAlgebra (p : TensorPower) (N : Level) : Algebra k (AtLevel k p N) :=
  Algebra.compHom _ (algebraMap k (Completion.A k N))

/-- The ideal generated by the central formal parameter in the indicated limit. -/
def parameterIdeal (p : TensorPower) : Ideal (Limit k p) :=
  Ideal.span {algebraMap (PowerSeries k) (Limit k p) PowerSeries.X}

instance parameterIdeal_isTwoSided (p : TensorPower) : (parameterIdeal k p).IsTwoSided where
  mul_mem_of_left b ha := by
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    exact Ideal.mem_span_singleton'.mpr
      ⟨y * b, by
        simpa only [mul_assoc] using
          congrArg (y * ·) ((Algebra.commutes (A := Limit k p) (PowerSeries.X : PowerSeries k) b).symm)⟩

/-- Reduction modulo the formal parameter, for the algebra or a completed tensor power. -/
abbrev ModParameter (p : TensorPower) := Limit k p ⧸ parameterIdeal k p

def modParameter (p : TensorPower) : Limit k p →ₐ[k] ModParameter k p :=
  Ideal.Quotient.mkₐ k (parameterIdeal k p)

/-- The compatible tuples of simple positive, simple negative, and Cartan generators. -/
def formalE (i : Presentation.Root) : Uh k :=
  ⟨fun N => Presentation.E (Presentation.truncated k N) i,
    fun _ _ e => Presentation.reduce_E e i⟩

def formalF (i : Presentation.Root) : Uh k :=
  ⟨fun N => Presentation.F (Presentation.truncated k N) i,
    fun _ _ e => Presentation.reduce_F e i⟩

def formalH (i : Presentation.Root) : Uh k :=
  ⟨fun N => Coproduct.H k N i, fun M N e => by
    change Presentation.reduce (k := k) e
      (Presentation.cartan (Presentation.truncated k N) (MvPolynomial.X i)) =
      Presentation.cartan (Presentation.truncated k M) (MvPolynomial.X i)
    rw [Presentation.reduce_cartan]
    simp [Presentation.cartanReduce]⟩

variable {k}

/-- The level-one identification of the quotients and its comparison with the ordinary
enveloping Hopf algebra. The three diagrams specify the operations induced modulo h
by the completed operations. -/
structure ClassicalReduction (D : HopfMaps k) where
  levelEquiv (p : TensorPower) : ModParameter k p ≃ₐ[k] AtLevel k p firstLevel
  levelEquiv_mk (p : TensorPower) (x : Limit k p) :
    levelEquiv p (modParameter k p x) = project k p firstLevel x
  comparison : LevelOne k ≃ₐ[k] Classical k
  generators : GeneratorImages comparison
  hopf : ClassicalHopf k
  tensorComparison : Square k firstLevel ≃+* (Classical k ⊗[k] Classical k)
  tensorComparison_tmul (x y : LevelOne k) :
    tensorComparison (x ⊗ₜ[Completion.A k firstLevel] y) = comparison x ⊗ₜ[k] comparison y
  comul (x : Uh k) :
    tensorComparison (levelEquiv .square (modParameter k .square (D.comul x))) =
      hopf.comul (comparison (levelEquiv .single (modParameter k .single x)))
  counit (x : Uh k) :
    PowerSeries.constantCoeff (D.counit x) =
      hopf.counit (comparison (levelEquiv .single (modParameter k .single x)))
  antipode (x : Uh k) :
    comparison (levelEquiv .single (modParameter k .single (D.antipode x).unop)) =
      hopf.antipode (comparison (levelEquiv .single (modParameter k .single x)))

/-- The classical specialization is the algebra equivalence induced by the
level-one projection and the matrix comparison. -/
abbrev ClassicalReduction.equiv {D : HopfMaps k} (r : ClassicalReduction D) :
    ModParameter k .single ≃ₐ[k] Classical k :=
  (r.levelEquiv .single).trans r.comparison

/-- The topologically free completed quantization and its ordinary Hopf specialization. -/
def ClassicalLimitProp : Prop :=
  Completion.SeriesDescriptionProp.{u} ∧ Completion.ReductionProp.{u} ∧
  Completion.TopologicalAlgebrasProp.{u} ∧
  ∀ (k : Type u) [Field k] [CharZero k],
    (∀ p : TensorPower, Function.Bijective
      (fun x : Completion.Series k (Completion.Index p) => fun n => Completion.seriesCoeff k n x)) ∧
    ∃ (d : ∀ N : Level, Coproduct.TruncatedData k N)
      (s : ∀ N : Level, Hopf.TruncatedData k N (d N)) (D : HopfMaps k),
      Completion.ProjectsTo D d s ∧ Completion.HopfIdentities D ∧
      Completion.ContinuousHopfMaps D ∧ Nonempty (ClassicalReduction D)

end Specs.LieNotes.Quantum.ClassicalLimit
