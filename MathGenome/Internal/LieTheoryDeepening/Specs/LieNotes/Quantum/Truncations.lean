import Mathlib.Algebra.Algebra.Rat
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Algebra.Polynomial.Div
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.PowerSeries.Exp
import Mathlib.RingTheory.PowerSeries.Trunc

noncomputable section

namespace Specs.LieNotes.Quantum.Truncations

variable (R : Type*) [CommRing R]

/-- The ideal generated by the Nth power of the formal parameter. -/
def truncationIdeal (N : ℕ) : Ideal (Polynomial R) :=
  Ideal.span {(Polynomial.X : Polynomial R) ^ N}

/-- The coefficient ring R[h]/(h^N). The definitions also allow N=0. -/
abbrev A (N : ℕ) :=
  Polynomial R ⧸ truncationIdeal R N

def mk (N : ℕ) : Polynomial R →ₐ[R] A R N :=
  Ideal.Quotient.mkₐ R (truncationIdeal R N)

def h (N : ℕ) : A R N :=
  mk R N Polynomial.X

variable {R}

private theorem mem_truncationIdeal {N : ℕ} {p : Polynomial R} :
    p ∈ truncationIdeal R N ↔ ∀ j < N, p.coeff j = 0 :=
  Ideal.mem_span_singleton.trans Polynomial.X_pow_dvd_iff

def reduce {M N : ℕ} (e : M ≤ N) : A R N →ₐ[R] A R M :=
  Ideal.Quotient.factorₐ R <| Ideal.span_le.mpr <| by
    rw [Set.singleton_subset_iff]
    exact Ideal.mem_span_singleton.mpr (pow_dvd_pow (Polynomial.X : Polynomial R) e)

private theorem mk_trunc_coe (N : ℕ) (p : Polynomial R) :
    mk R N (PowerSeries.trunc N (p : PowerSeries R)) = mk R N p := by
  change Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _
  rw [Ideal.Quotient.mk_eq_mk_iff_sub_mem, mem_truncationIdeal]
  intro j hj
  simp [PowerSeries.coeff_trunc, hj]

/-- Truncate a formal series and send the resulting polynomial to the quotient. -/
def truncate (N : ℕ) : PowerSeries R →ₐ[R] A R N where
  toFun f := mk R N (PowerSeries.trunc N f)
  map_zero' := by simp
  map_add' f g := by simp
  map_one' := by simpa using mk_trunc_coe (R := R) N 1
  map_mul' f g := by
    rw [← map_mul, ← PowerSeries.trunc_trunc_mul_trunc (n := N) f g, ← Polynomial.coe_mul]
    exact mk_trunc_coe N (PowerSeries.trunc N f * PowerSeries.trunc N g)
  commutes' r := by
    change mk R N (PowerSeries.trunc N (PowerSeries.C r)) = mk R N (Polynomial.C r)
    simpa only [Polynomial.coe_C] using mk_trunc_coe (R := R) N (Polynomial.C r)

/-- Truncated evaluation at a nilpotent element with a specified coefficient map. -/
def evalTrunc {S : Type*} [CommRing S] (N : ℕ) (f : R →+* S) (z : S)
    (hz : z ^ N = 0) : PowerSeries R →+* S :=
  (Ideal.Quotient.lift (truncationIdeal R N) (Polynomial.eval₂RingHom f z) (by
    intro p hp
    obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
    simp [hz])).comp (truncate N).toRingHom

/-- Interpret the series in h with polynomial coefficients in the Cartan variables
as a polynomial over the truncated scalar ring. Specialize σ to Fin 2. -/
def cartanTruncate (σ : Type*) (N : ℕ) :
    PowerSeries (MvPolynomial σ R) →+* MvPolynomial σ (A R N) :=
  evalTrunc N (MvPolynomial.map (algebraMap R (A R N))) (MvPolynomial.C (h R N)) (by
    rw [← map_pow, h, ← map_pow]
    change MvPolynomial.C (Ideal.Quotient.mk (truncationIdeal R N) _) = 0
    have hp : (Polynomial.X : Polynomial R) ^ N ∈ truncationIdeal R N :=
      Ideal.subset_span (Set.mem_singleton _)
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp, map_zero])

/-- The jth coefficient of a representative, which is well defined for j<N. -/
def coeff {N : ℕ} (j : Fin N) : A R N →ₗ[R] R :=
  ((truncationIdeal R N).restrictScalars R).liftQ (Polynomial.lcoeff R j) (by
    intro p hp
    exact LinearMap.mem_ker.mpr (mem_truncationIdeal.mp hp j j.isLt))

/-- The class of the polynomial written in the ordered powers of h. -/
def ofCoeffs {N : ℕ} (a : Fin N → R) : A R N :=
  ∑ j : Fin N, algebraMap R (A R N) (a j) * h R N ^ (j : ℕ)

/-- The formal exponential with argument ha. -/
def expH {S : Type*} [CommRing S] [Algebra ℚ S] (a : S) : PowerSeries S :=
  PowerSeries.rescale a (PowerSeries.exp S)

universe u v

def TruncationIdealType := ∀ (R : Type u) [CommRing R], ℕ → Ideal (Polynomial R)

def CoefficientRingType := ∀ (R : Type u) [CommRing R], ℕ → Type u

def QuotientMapType := ∀ (R : Type u) [CommRing R] (N : ℕ), Polynomial R →ₐ[R] A R N

def ParameterType := ∀ (R : Type u) [CommRing R] (N : ℕ), A R N

def ReductionType := ∀ {R : Type u} [CommRing R] {M N : ℕ}, M ≤ N → (A R N →ₐ[R] A R M)

def TruncationType := ∀ {R : Type u} [CommRing R] (N : ℕ), PowerSeries R →ₐ[R] A R N

set_option linter.checkUnivs false in
def TruncatedEvaluationType := ∀ {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    (N : ℕ) (_f : R →+* S) (z : S), z ^ N = 0 → (PowerSeries R →+* S)

set_option linter.checkUnivs false in
def CartanTruncationType := ∀ {R : Type u} [CommRing R] (σ : Type v) (N : ℕ),
    PowerSeries (MvPolynomial σ R) →+* MvPolynomial σ (A R N)

def CoefficientType := ∀ {R : Type u} [CommRing R] {N : ℕ}, Fin N → (A R N →ₗ[R] R)

def OfCoeffsType := ∀ {R : Type u} [CommRing R] {N : ℕ}, (Fin N → R) → A R N

def ExpHType := ∀ {S : Type u} [CommRing S] [Algebra ℚ S], S → PowerSeries S

def ParameterNilpotent : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ), h R N ^ N = 0

def ReductionOnPolynomials : Prop :=
  ∀ {R : Type u} [CommRing R] {M N : ℕ} (e : M ≤ N) (p : Polynomial R),
    reduce e (mk R N p) = mk R M p

def ReductionOnParameter : Prop :=
  ∀ {R : Type u} [CommRing R] {M N : ℕ} (e : M ≤ N), reduce e (h R N) = h R M

def ReductionIdentity : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ), reduce (R := R) (le_refl N) = AlgHom.id R (A R N)

def ReductionComposition : Prop :=
  ∀ {R : Type u} [CommRing R] {L M N : ℕ} (e : M ≤ N) (d : L ≤ M),
    (reduce (R := R) d).comp (reduce e) = reduce (d.trans e)

def CoeffOnPolynomials : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} (p : Polynomial R) (j : Fin N),
    coeff j (mk R N p) = p.coeff j

def ReductionPreservesCoeffs : Prop :=
  ∀ {R : Type u} [CommRing R] {M N : ℕ} (e : M ≤ N) (j : Fin M) (a : A R N),
    coeff j (reduce e a) = coeff (Fin.castLE e j) a

def CoeffExtensionality : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} {a b : A R N},
    (∀ j : Fin N, coeff j a = coeff j b) → a = b

def CoeffOfRepresentative : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} (a : Fin N → R) (j : Fin N), coeff j (ofCoeffs a) = a j

def RepresentativeFromCoeffs : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} (a : A R N), ofCoeffs (fun j => coeff j a) = a

def UniqueRepresentative : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} (a : A R N), ∃! c : Fin N → R, ofCoeffs c = a

def CoeffOfTruncation : Prop :=
  ∀ {R : Type u} [CommRing R] {N : ℕ} (f : PowerSeries R) (j : Fin N),
    coeff j (truncate N f) = PowerSeries.coeff j f

def TruncationCompatibility : Prop :=
  ∀ {R : Type u} [CommRing R] {M N : ℕ} (e : M ≤ N),
    (reduce (R := R) e).comp (truncate N) = truncate M

def TruncationAsSum : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ) (f : PowerSeries R),
    truncate N f =
      ∑ j : Fin N, algebraMap R (A R N) (PowerSeries.coeff j f) * h R N ^ (j : ℕ)

def TruncationOnPolynomials : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ) (p : Polynomial R), truncate N (p : PowerSeries R) = mk R N p

def TruncationOnParameter : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ), truncate N (PowerSeries.X : PowerSeries R) = h R N

def TruncationSurjective : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ), Function.Surjective (truncate (R := R) N)

def TruncationKernel : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ) (f : PowerSeries R),
    truncate N f = 0 ↔ (PowerSeries.X : PowerSeries R) ^ N ∣ f

def TruncatedEvaluationAsSum : Prop :=
  ∀ {R : Type u} [CommRing R] {S : Type v} [CommRing S] (N : ℕ) (f : R →+* S) (z : S)
    (hz : z ^ N = 0) (p : PowerSeries R),
    evalTrunc N f z hz p = ∑ j ∈ Finset.range N, f (PowerSeries.coeff j p) * z ^ j

def TruncatedEvaluationOnPolynomials : Prop :=
  ∀ {R : Type u} [CommRing R] {S : Type v} [CommRing S] (N : ℕ) (f : R →+* S) (z : S)
    (hz : z ^ N = 0) (p : Polynomial R),
    evalTrunc N f z hz (p : PowerSeries R) = p.eval₂ f z

def CartanTruncationAsSum : Prop :=
  ∀ {R : Type u} [CommRing R] (σ : Type v) (N : ℕ) (p : PowerSeries (MvPolynomial σ R)),
    cartanTruncate σ N p =
      ∑ j ∈ Finset.range N,
        MvPolynomial.map (algebraMap R (A R N)) (PowerSeries.coeff j p) *
          MvPolynomial.C (h R N) ^ j

def CartanTruncationOnConstants : Prop :=
  ∀ {R : Type u} [CommRing R] (N : ℕ) {σ : Type v} (p : MvPolynomial σ R),
    cartanTruncate σ N (PowerSeries.C p) = MvPolynomial.map (algebraMap R (A R N)) p

def CartanTruncationOnParameter : Prop :=
  ∀ {R : Type u} [CommRing R] (σ : Type v) (N : ℕ),
    cartanTruncate σ N PowerSeries.X = MvPolynomial.C (h R N)

def CartanTruncationOnScalars : Prop :=
  ∀ {R : Type u} [CommRing R] (σ : Type v) (N : ℕ) (p : PowerSeries R),
    cartanTruncate σ N (p.map MvPolynomial.C) = MvPolynomial.C (truncate N p)

def CartanTruncationCompatibility : Prop :=
  ∀ {R : Type u} [CommRing R] {M N : ℕ} (σ : Type v) (e : M ≤ N)
      (p : PowerSeries (MvPolynomial σ R)),
    MvPolynomial.map (reduce (R := R) e).toRingHom (cartanTruncate σ N p) = cartanTruncate σ M p

def ExpHCoeff : Prop :=
  ∀ {S : Type u} [CommRing S] [Algebra ℚ S] (a : S) (j : ℕ),
    PowerSeries.coeff j (expH a) = a ^ j * algebraMap ℚ S (1 / (j.factorial : ℚ))

def ExpHZero : Prop :=
  ∀ {S : Type u} [CommRing S] [Algebra ℚ S], expH (0 : S) = 1

def ExpHAddition : Prop :=
  ∀ {S : Type u} [CommRing S] [Algebra ℚ S] (a b : S), expH (a + b) = expH a * expH b

def ExpHInverse : Prop :=
  ∀ {S : Type u} [CommRing S] [Algebra ℚ S] (a : S), expH a * expH (-a) = 1

def ExpHMap : Prop :=
  ∀ {S : Type u} {T : Type v} [CommRing S] [CommRing T] [Algebra ℚ S] [Algebra ℚ T]
      (f : S →+* T) (a : S), (expH a).map f = expH (f a)

end Specs.LieNotes.Quantum.Truncations
