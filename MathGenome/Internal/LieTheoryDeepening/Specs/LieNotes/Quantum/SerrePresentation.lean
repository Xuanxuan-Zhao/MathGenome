import Mathlib.Algebra.FreeAlgebra
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-! The type A₂ Serre presentation over a commutative ring with a chosen unit. -/

namespace Specs.LieNotes.Quantum.SerrePresentation

universe u v w

set_option linter.checkUnivs false in
def serrePolynomialType :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B],
    Aˣ → B → B → B

/-- The scalar coefficient acts through the given algebra structure. -/
def serrePolynomial {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    (q : Aˣ) (a b : B) : B :=
  a ^ 2 * b - (↑q + ↑(q⁻¹) : A) • (a * b * a) + b * a ^ 2

variable {A : Type u} [CommRing A]

def relationType :=
  ∀ {A : Type u} [CommRing A], Aˣ → FreeAlgebra A (Fin 2)

def relationXY (q : Aˣ) : FreeAlgebra A (Fin 2) :=
  serrePolynomial q (FreeAlgebra.ι A 0) (FreeAlgebra.ι A 1)

def relationYX (q : Aˣ) : FreeAlgebra A (Fin 2) :=
  serrePolynomial q (FreeAlgebra.ι A 1) (FreeAlgebra.ι A 0)

def serreIdealType :=
  ∀ {A : Type u} [CommRing A], Aˣ → TwoSidedIdeal (FreeAlgebra A (Fin 2))

/-- The ideal generated by the two ordered Serre polynomials in the free algebra. -/
def serreIdeal (q : Aˣ) : TwoSidedIdeal (FreeAlgebra A (Fin 2)) :=
  TwoSidedIdeal.span {relationXY q, relationYX q}

def serreAlgebraType :=
  ∀ (A : Type u) [CommRing A], Aˣ → Type u

abbrev SerreAlgebra (A : Type u) [CommRing A] (q : Aˣ) : Type u :=
  FreeAlgebra A (Fin 2) ⧸ (serreIdeal q).asIdeal

def quotientMapType :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), FreeAlgebra A (Fin 2) →ₐ[A] SerreAlgebra A q

def quotientMap (q : Aˣ) : FreeAlgebra A (Fin 2) →ₐ[A] SerreAlgebra A q :=
  Ideal.Quotient.mkₐ A (serreIdeal q).asIdeal

def generatorType :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), Fin 2 → SerreAlgebra A q

/-- The classes of the free generators, with indices 0 and 1 for x and y. -/
def generator (q : Aˣ) (i : Fin 2) : SerreAlgebra A q :=
  quotientMap q (FreeAlgebra.ι A i)

def elementType :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), SerreAlgebra A q

def x (q : Aˣ) : SerreAlgebra A q := generator q 0

def y (q : Aˣ) : SerreAlgebra A q := generator q 1

def z (q : Aˣ) : SerreAlgebra A q := x q * y q - (↑(q⁻¹) : A) • (y q * x q)

def mapSerrePolynomialProp : Prop :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    {C : Type w} [Ring C] [Algebra A C]
    (f : B →ₐ[A] C) (q : Aˣ) (a b : B),
    f (serrePolynomial q a b) = serrePolynomial q (f a) (f b)

def relationXYMemProp : Prop :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), relationXY q ∈ serreIdeal q

def relationYXMemProp : Prop :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), relationYX q ∈ serreIdeal q

def relationXYZeroProp : Prop :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), serrePolynomial q (x q) (y q) = 0

def relationYXZeroProp : Prop :=
  ∀ {A : Type u} [CommRing A] (q : Aˣ), serrePolynomial q (y q) (x q) = 0

set_option linter.checkUnivs false in
def liftType :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    (q : Aˣ) (f : Fin 2 → B),
    serrePolynomial q (f 0) (f 1) = 0 →
    serrePolynomial q (f 1) (f 0) = 0 →
    SerreAlgebra A q →ₐ[A] B

/-- The morphism on the presentation is the quotient lift of free evaluation. -/
def lift {B : Type v} [Ring B] [Algebra A B] (q : Aˣ) (f : Fin 2 → B)
    (hxy : serrePolynomial q (f 0) (f 1) = 0)
    (hyx : serrePolynomial q (f 1) (f 0) = 0) : SerreAlgebra A q →ₐ[A] B :=
  Ideal.Quotient.liftₐ (serreIdeal q).asIdeal (FreeAlgebra.lift A f) (by
    let ev := FreeAlgebra.lift A f
    have hle : serreIdeal q ≤ TwoSidedIdeal.ker (ev : FreeAlgebra A (Fin 2) →+* B) := by
      apply TwoSidedIdeal.span_le.mpr
      intro r hr
      change r = relationXY q ∨ r = relationYX q at hr
      rcases hr with rfl | rfl
      · apply (TwoSidedIdeal.mem_ker (ev : FreeAlgebra A (Fin 2) →+* B)).mpr
        simpa [ev, relationXY, serrePolynomial] using hxy
      · apply (TwoSidedIdeal.mem_ker (ev : FreeAlgebra A (Fin 2) →+* B)).mpr
        simpa [ev, relationYX, serrePolynomial] using hyx
    exact fun r hr => (TwoSidedIdeal.mem_ker (ev : FreeAlgebra A (Fin 2) →+* B)).mp
      (hle (TwoSidedIdeal.mem_asIdeal.mp hr)))

def liftCompQuotientMapProp : Prop :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    (q : Aˣ) (f : Fin 2 → B)
    (hxy : serrePolynomial q (f 0) (f 1) = 0)
    (hyx : serrePolynomial q (f 1) (f 0) = 0),
    (lift q f hxy hyx).comp (quotientMap q) = FreeAlgebra.lift A f

def liftGeneratorProp : Prop :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    (q : Aˣ) (f : Fin 2 → B)
    (hxy : serrePolynomial q (f 0) (f 1) = 0)
    (hyx : serrePolynomial q (f 1) (f 0) = 0)
    (i : Fin 2), lift q f hxy hyx (generator q i) = f i

def homExtProp : Prop :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    {q : Aˣ} {F G : SerreAlgebra A q →ₐ[A] B},
    (∀ i, F (generator q i) = G (generator q i)) → F = G

def universalPropertyProp : Prop :=
  ∀ {A : Type u} [CommRing A] {B : Type v} [Ring B] [Algebra A B]
    (q : Aˣ) (f : Fin 2 → B),
    (∃! F : SerreAlgebra A q →ₐ[A] B, ∀ i, F (generator q i) = f i) ↔
      serrePolynomial q (f 0) (f 1) = 0 ∧ serrePolynomial q (f 1) (f 0) = 0

end Specs.LieNotes.Quantum.SerrePresentation
