import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.SuperRestricted.RestrictedLie
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-! The p-center and reduced enveloping algebra constructions in SR08. -/

namespace Specs.LieNotes.SuperRestricted.ReducedEnveloping

open _root_.Shared.Lie (U inclusion)
open _root_.Specs.LieAlgebrasAndRepresentations.RestrictedOperationBoundary
  (restrictedRelationsValue restrictedEnvelopingValue)
open _root_.Specs.LieNotes.SuperRestricted.RestrictedLie (restrictedPowerValue)

universe u v

-- Keep the field and Lie algebra universes independent in the expected types.
set_option linter.checkUnivs false

variable {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
  {G : Type v} [LieRing G] [LieAlgebra k G]

variable (power : restrictedPowerValue k p G) (χ : G →ₗ[k] k)

/-- The element `z(x) = ι(x)^p - ι(x^[p])` in the ordinary enveloping algebra. -/
def pCenterElementValue (x : G) : U k G :=
  inclusion k G x ^ p - inclusion k G (power.val x)

def pCenterElementType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G], restrictedPowerValue k p G → G → U k G

/-- The unital `k`-subalgebra generated by all the elements `z(x)`. -/
def pCenterValue : Subalgebra k (U k G) :=
  Algebra.adjoin k (Set.range (pCenterElementValue power))

def pCenterType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G],
    restrictedPowerValue k p G → Subalgebra k (U k G)

/-- The two-sided ideal generated by `z(x) - χ(x)^p` for all `x : G`. -/
def reducedRelationsValue : Ideal (U k G) :=
  (TwoSidedIdeal.span (Set.range fun x : G =>
    pCenterElementValue power x - algebraMap k (U k G) (χ x ^ p))).asIdeal

instance : (reducedRelationsValue power χ).IsTwoSided := by
  unfold reducedRelationsValue
  infer_instance

def reducedRelationsType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G],
    restrictedPowerValue k p G → (G →ₗ[k] k) → Ideal (U k G)

/-- The reduced enveloping algebra is the quotient of the ordinary enveloping algebra. -/
abbrev reducedEnvelopingValue := U k G ⧸ reducedRelationsValue power χ

def reducedEnvelopingType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G],
    restrictedPowerValue k p G → (G →ₗ[k] k) → Type (max u v)

/-- The canonical quotient map from the ordinary enveloping algebra. -/
def quotientMapValue : U k G →ₐ[k] reducedEnvelopingValue power χ :=
  Ideal.Quotient.mkₐ k (reducedRelationsValue power χ)

def quotientMapType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G]
    (power : restrictedPowerValue k p G) (χ : G →ₗ[k] k),
    U k G →ₐ[k] reducedEnvelopingValue power χ

def quotientMap_specType : Prop :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G]
    (power : restrictedPowerValue k p G) (χ : G →ₗ[k] k),
    Function.Surjective (quotientMapValue power χ) ∧
    (∀ a, quotientMapValue power χ a = 0 ↔ a ∈ reducedRelationsValue power χ) ∧
    (∀ x : G, quotientMapValue power χ (pCenterElementValue power x) =
      algebraMap k (reducedEnvelopingValue power χ) (χ x ^ p))

private theorem reducedRelations_zero :
    reducedRelationsValue power 0 = restrictedRelationsValue k p power := by
  simp [reducedRelationsValue, restrictedRelationsValue, pCenterElementValue, NeZero.ne p]

/-- The canonical identification at the zero character, induced by the identity on `U`. -/
def zeroCharacterEquivValue :
    reducedEnvelopingValue power 0 ≃ₐ[k] restrictedEnvelopingValue k p power :=
  Ideal.quotientEquivAlgOfEq k (reducedRelations_zero power)

def zeroCharacterEquivType :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G] (power : restrictedPowerValue k p G),
    reducedEnvelopingValue power 0 ≃ₐ[k] restrictedEnvelopingValue k p power

def zeroCharacterEquiv_quotientMapType : Prop :=
  ∀ {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
    {G : Type v} [LieRing G] [LieAlgebra k G]
    (power : restrictedPowerValue k p G) (a : U k G),
    zeroCharacterEquivValue power (quotientMapValue power 0 a) =
      Specs.LieAlgebrasAndRepresentations.RestrictedOperationBoundary.quotientMapValue k p power a

end Specs.LieNotes.SuperRestricted.ReducedEnveloping
