import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.Contragredient.CartanQuotient
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.BorelInduction
import Mathlib.LinearAlgebra.FiniteDimensional.Defs

/-! Verma modules for the canonical contragredient Lie algebra of a realization. -/

namespace Specs.LieNotes.Contragredient.VermaModules

open CartanData CartanQuotient WeightExtraction
open _root_.RepTheorySurvey.CategoryO.BorelInduction
open UniversalEnvelopingAlgebra (ι)
open scoped DirectSum

noncomputable section

universe u v w
set_option linter.checkUnivs false

variable {I : Type u} {A : Matrix I I ℤ} {H : Type v}
  [AddCommGroup H] [Module ℂ H] [Finite I]

/-- The Borel is the Lie subalgebra generated by the Cartan and positive side. -/
def borel (R : Realization A H) : LieSubalgebra ℂ (Algebra R) :=
  LieSubalgebra.lieSpan ℂ (Algebra R) (Set.range (cartan R) ∪ (positive R : Set (Algebra R)))

def cartanInBorel (R : Realization A H) (h : H) : borel R :=
  ⟨cartan R h, LieSubalgebra.subset_lieSpan (Or.inl ⟨h, rfl⟩)⟩

def positiveInBorel (R : Realization A H) (x : positive R) : borel R :=
  ⟨x, LieSubalgebra.subset_lieSpan (Or.inr x.property)⟩

/-- An enveloping-algebra character giving the required one-dimensional Borel action. -/
def IsWeightCharacter (R : Realization A H) (Λ : Module.Dual ℂ H)
    (χ : U (borel R) →ₐ[ℂ] ℂ) : Prop :=
  (∀ h : H, χ (ι ℂ (cartanInBorel R h)) = Λ h) ∧
    ∀ x : positive R, χ (ι ℂ (positiveInBorel R x)) = 0

def WeightCharacterExists : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H), ∃! χ, IsWeightCharacter R Λ χ

/-- The existence theorem supplies this proof argument for every realization and weight. -/
def weightCharacter (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) : U (borel R) →ₐ[ℂ] ℂ :=
  Classical.choose hχ.exists

theorem weightCharacter_spec (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) : IsWeightCharacter R Λ (weightCharacter R Λ hχ) :=
  Classical.choose_spec hχ.exists

/-- The one-dimensional inducing module has underlying vector space `ℂ`. -/
abbrev characterModule (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) : Module (U (borel R)) ℂ :=
  Module.compHom ℂ (weightCharacter R Λ hχ).toRingHom

abbrev Verma (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) :=
  letI := characterModule R Λ hχ
  Induced (inclusion (borel R)) ℂ

/-- The class of `1 ⊗ 1` in the balanced induction. -/
def top (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) : Verma R Λ hχ :=
  letI := characterModule R Λ hχ
  induceTensor (inclusion (borel R)) 1 (1 : ℂ)

def IsHighestVector (R : Realization A H) {V : Type w} [AddCommGroup V]
    [Module (U (Algebra R)) V] [Module ℂ V] (Λ : Module.Dual ℂ H) (z : V) : Prop :=
  (∀ h : H, (ι ℂ (cartan R h) : U (Algebra R)) • z = Λ h • z) ∧
    ∀ x : positive R, (ι ℂ (x : Algebra R) : U (Algebra R)) • z = 0

attribute [local instance 100] LieRing.ofAssociativeRing in
/-- The Cartan action on any complex enveloping-algebra module. -/
def cartanAction (R : Realization A H) (V : Type w) [AddCommGroup V]
    [Module (U (Algebra R)) V] [Module ℂ V] [IsScalarTower ℂ (U (Algebra R)) V] :
    H →ₗ[ℂ] Module.End ℂ V :=
  (Algebra.lsmul ℂ ℂ V).toLinearMap.comp ((ι ℂ).toLinearMap.comp (cartan R))

def weightSpaceAt (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) (μ : Module.Dual ℂ H) :
    Submodule ℂ (Verma R Λ hχ) :=
  weightSpace (cartanAction R (Verma R Λ hχ)) μ

/-- The multiplicity of a letter in a word is its coordinate in this vector. -/
def wordMultiplicity (word : List I) : I →₀ ℕ :=
  (word.map fun i ↦ Finsupp.single i (1 : ℕ)).sum

def lowerWeight (R : Realization A H) (Λ : Module.Dual ℂ H) (m : I →₀ ℕ) :
    Module.Dual ℂ H :=
  Λ - R.rootWeight (m.mapRange (fun n : ℕ ↦ (n : ℤ)) rfl)

/-- Apply the product of negative simple generators, in the given order, to the top. -/
def wordVector (R : Realization A H) (Λ : Module.Dual ℂ H)
    (hχ : ∃! χ, IsWeightCharacter R Λ χ) (word : List I) : Verma R Λ hχ :=
  ((word.map fun i ↦ (ι ℂ (f R i) : U (Algebra R))).prod) • top R Λ hχ

def BorelType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H), LieSubalgebra ℂ (Algebra R)

def WeightCharacterType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H),
    (∃! χ, IsWeightCharacter R Λ χ) → (U (borel R) →ₐ[ℂ] ℂ)

def CharacterModuleType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H),
    (∃! χ, IsWeightCharacter R Λ χ) → Module (U (borel R)) ℂ

def VermaType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H),
    (∃! χ, IsWeightCharacter R Λ χ) → Type (max u v)

def TopType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    Verma R Λ hχ

def WeightSpaceAtType :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    Module.Dual ℂ H → Submodule ℂ (Verma R Λ hχ)

def BorelUnderlying : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H),
    (borel R).toSubmodule = (cartan R).range ⊔ (positive R).toSubmodule ∧
      Disjoint (cartan R).range (positive R).toSubmodule

/-- Negative multiplication gives a linear equivalence and sends the unit to the cyclic top. -/
def PBW : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    ∃ F : U (negative R) ≃ₗ[ℂ] Verma R Λ hχ,
      ∀ a, F a = inclusion (negative R) a • top R Λ hχ

/-- Adjunction for the balanced tensor product, with its specified maps. -/
def InductionUniversal : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ)
    (V : Type w) [AddCommGroup V] [Module (U (Algebra R)) V],
    letI := characterModule R Λ hχ
    Universal (E := ℂ) (inclusion (borel R)) V

/-- In highest-weight terms, giving a homomorphism is giving the image of the top. -/
def HighestWeightUniversal : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    IsHighestVector R Λ (top R Λ hχ) ∧
    ∀ (V : Type w) [AddCommGroup V] [Module (U (Algebra R)) V],
      letI := scalarModule (B := U (Algebra R)) V
      ∀ z : V, IsHighestVector R Λ z →
        ∃! φ : Verma R Λ hχ →ₗ[U (Algebra R)] V, φ (top R Λ hχ) = z

open Classical in
def WeightDecomposition : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    DirectSum.IsInternal (weightSpaceAt R Λ hχ)

def WeightSupport : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ)
    (μ : Module.Dual ℂ H),
    μ ∉ Set.range (lowerWeight R Λ) → weightSpaceAt R Λ hχ μ = ⊥

def WeightSpaceWordSpan : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ)
    (m : I →₀ ℕ),
    weightSpaceAt R Λ hχ (lowerWeight R Λ m) =
      Submodule.span ℂ (wordVector R Λ hχ '' {word | wordMultiplicity word = m})

def FiniteWeightSpaces : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ)
    (μ : Module.Dual ℂ H), FiniteDimensional ℂ (weightSpaceAt R Λ hχ μ)

def TopWeightSpace : Prop :=
  ∀ {I : Type u} {A : Matrix I I ℤ} {H : Type v} [AddCommGroup H] [Module ℂ H] [Finite I]
    (R : Realization A H) (Λ : Module.Dual ℂ H) (hχ : ∃! χ, IsWeightCharacter R Λ χ),
    top R Λ hχ ≠ 0 ∧ weightSpaceAt R Λ hχ Λ = ℂ ∙ top R Λ hχ

end

end Specs.LieNotes.Contragredient.VermaModules
