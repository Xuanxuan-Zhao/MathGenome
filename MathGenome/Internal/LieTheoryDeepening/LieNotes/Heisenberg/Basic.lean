import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.Heisenberg.Basic

/-! The three-dimensional Heisenberg Lie algebra and its normalized two-cochains. -/

universe u v

namespace LieNotes.Heisenberg

/-- The ordered coordinate space, equipped with the Heisenberg Lie structure. -/
abbrev Model (k : Type u) := Specs.LieNotes.Heisenberg.ModelValue k

variable (k : Type u) [Field k]

/-- The linear coordinate isomorphism in the order x, y, z. -/
def coordinates : Model k ≃ₗ[k] (Fin 3 → k) :=
  Specs.LieNotes.Heisenberg.coordinatesValue k

noncomputable def basis : Module.Basis (Fin 3) k (Model k) :=
  Specs.LieNotes.Heisenberg.basisValue k

def x : Model k := Specs.LieNotes.Heisenberg.xValue k
def y : Model k := Specs.LieNotes.Heisenberg.yValue k
def z : Model k := Specs.LieNotes.Heisenberg.zValue k

abbrev lieRing : LieRing (Model k) := inferInstance
abbrev lieAlgebra : LieAlgebra k (Model k) := inferInstance

/-- The line generated by the third basis vector. -/
def centerLine : Submodule k (Model k) := k ∙ z k

@[simp] theorem coordinates_apply (p : Model k) (i : Fin 3) :
    coordinates k p i = p.coords i :=
  rfl

@[simp] theorem basis_repr (p : Model k) (i : Fin 3) :
    (basis k).repr p i = p.coords i :=
  Module.Basis.ofEquivFun_repr_apply (coordinates k) p i

theorem dimension : Module.finrank k (Model k) = 3 := by
  rw [Module.finrank_eq_card_basis (basis k), Fintype.card_fin]

theorem basis_vectors : basis k 0 = x k ∧ basis k 1 = y k ∧ basis k 2 = z k := by
  simp only [basis, Specs.LieNotes.Heisenberg.basisValue, Module.Basis.coe_ofEquivFun]
  exact ⟨rfl, rfl, rfl⟩

theorem bracket_formula (p q : Model k) :
    ⁅p, q⁆ = (p.coords 0 * q.coords 1 - p.coords 1 * q.coords 0) • z k :=
  rfl

open Specs.LieNotes.Heisenberg (coords_zero coords_add coords_smul)

private theorem lie_x (p : Model k) : ⁅x k, p⁆ = p.coords 1 • z k := by
  simp [bracket_formula, x, Specs.LieNotes.Heisenberg.xValue]

private theorem lie_y (p : Model k) : ⁅y k, p⁆ = (-p.coords 0) • z k := by
  simp [bracket_formula, y, Specs.LieNotes.Heisenberg.yValue]

@[simp] theorem lie_xy : ⁅x k, y k⁆ = z k := by
  simp [lie_x, y, Specs.LieNotes.Heisenberg.yValue]

@[simp] theorem lie_z_right (p : Model k) : ⁅p, z k⁆ = 0 := by
  simp [bracket_formula, z, Specs.LieNotes.Heisenberg.zValue]

@[simp] theorem lie_z_left (p : Model k) : ⁅z k, p⁆ = 0 := by
  rw [← lie_skew, lie_z_right, neg_zero]

theorem bracket_table : ⁅x k, y k⁆ = z k ∧ ∀ p : Model k, ⁅p, z k⁆ = 0 :=
  ⟨lie_xy k, lie_z_right k⟩

/-- The span of z is exactly the center. -/
theorem center_eq : (LieAlgebra.center k (Model k)).toSubmodule = centerLine k := by
  ext p
  change p ∈ LieAlgebra.center k (Model k) ↔ p ∈ k ∙ z k
  rw [LieModule.mem_maxTrivSubmodule, Submodule.mem_span_singleton]
  constructor
  · intro h
    have h0 := congrArg (fun q : Model k => q.coords 2) (h (y k))
    have h1 := congrArg (fun q : Model k => q.coords 2) (h (x k))
    have hz2 : (z k).coords 2 = 1 := by simp [z, Specs.LieNotes.Heisenberg.zValue]
    simp only [lie_y, lie_x, coords_smul, coords_zero, hz2, mul_one, neg_eq_zero] at h0 h1
    refine ⟨p.coords 2, ?_⟩
    apply Specs.LieNotes.Heisenberg.ModelValue.ext
    funext i
    fin_cases i <;> simp [z, Specs.LieNotes.Heisenberg.zValue, h0, h1]
  · rintro ⟨r, rfl⟩ p
    rw [lie_smul, lie_z_right, smul_zero]

/-- Every bracket is in the center, and every vector on the central line
is already one bracket. -/
theorem bracket_image (r : Model k) :
    (∃ p q : Model k, ⁅p, q⁆ = r) ↔ r ∈ centerLine k := by
  rw [centerLine, Submodule.mem_span_singleton]
  constructor
  · rintro ⟨p, q, rfl⟩
    exact ⟨p.coords 0 * q.coords 1 - p.coords 1 * q.coords 0, (bracket_formula k p q).symm⟩
  · rintro ⟨t, rfl⟩
    exact ⟨x k, t • y k, by rw [lie_smul, lie_xy]⟩

section Identification

variable {k} {L : Type v} [LieRing L] [LieAlgebra k L]

/-- The coordinate model identified with any Lie algebra with the same
ordered basis and bracket table. -/
noncomputable def basisLieEquiv (b : Module.Basis (Fin 3) k L)
    (hxy : ⁅b 0, b 1⁆ = b 2) (hxz : ⁅b 0, b 2⁆ = 0) (hyz : ⁅b 1, b 2⁆ = 0) :
    Model k ≃ₗ⁅k⁆ L :=
  Specs.LieNotes.Heisenberg.basisLieEquivValue b hxy hxz hyz

@[simp] theorem basisLieEquiv_apply_basis (b : Module.Basis (Fin 3) k L)
    (hxy : ⁅b 0, b 1⁆ = b 2) (hxz : ⁅b 0, b 2⁆ = 0) (hyz : ⁅b 1, b 2⁆ = 0)
    (i : Fin 3) : basisLieEquiv b hxy hxz hyz (basis k i) = b i := by
  change (basis k).equiv b (Equiv.refl _) (basis k i) = b i
  simp

end Identification

/-- The normalized two-cochain with parameters a, b, c, d, e. -/
def phi (a b c d e : k) : Model k [⋀^Fin 2]→ₗ[k] Model k :=
  Specs.LieNotes.Heisenberg.phiValue k a b c d e

theorem phi_apply (a b c d e : k) (p q : Model k) :
    phi k a b c d e ![p, q] =
      (p.coords 0 * q.coords 2 - p.coords 2 * q.coords 0) • (a • x k + b • y k + c • z k) +
      (p.coords 1 * q.coords 2 - p.coords 2 * q.coords 1) • (d • x k - a • y k + e • z k) :=
  Specs.LieNotes.Heisenberg.phiValue_apply k a b c d e p q

@[simp] theorem phi_xy (a b c d e : k) : phi k a b c d e ![x k, y k] = 0 := by
  simp [phi_apply, x, y, Specs.LieNotes.Heisenberg.xValue,
    Specs.LieNotes.Heisenberg.yValue]

@[simp] theorem phi_xz (a b c d e : k) :
    phi k a b c d e ![x k, z k] = a • x k + b • y k + c • z k := by
  simp [phi_apply, x, z, Specs.LieNotes.Heisenberg.xValue,
    Specs.LieNotes.Heisenberg.zValue]

@[simp] theorem phi_yz (a b c d e : k) :
    phi k a b c d e ![y k, z k] = d • x k - a • y k + e • z k := by
  simp [phi_apply, y, z, Specs.LieNotes.Heisenberg.yValue,
    Specs.LieNotes.Heisenberg.zValue]

theorem phi_pairs (a b c d e : k) :
    phi k a b c d e ![x k, y k] = 0 ∧
    phi k a b c d e ![x k, z k] = a • x k + b • y k + c • z k ∧
    phi k a b c d e ![y k, z k] = d • x k - a • y k + e • z k :=
  ⟨phi_xy k a b c d e, phi_xz k a b c d e, phi_yz k a b c d e⟩

/-- The same two-cochain as a linear map on the second exterior power. -/
noncomputable def phiExterior (a b c d e : k) : (⋀[k]^2 (Model k)) →ₗ[k] Model k :=
  exteriorPower.alternatingMapLinearEquiv (phi k a b c d e)

@[simp] theorem phiExterior_apply (a b c d e : k) (p q : Model k) :
    phiExterior k a b c d e (exteriorPower.ιMulti k 2 ![p, q]) = phi k a b c d e ![p, q] :=
  exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ _

end LieNotes.Heisenberg
