import MathGenome.Internal.LieTheoryDeepening.LieNotes.Virasoro.VirasoroCocycle
import MathGenome.Internal.LieTheoryDeepening.LieNotes.Virasoro.WittSimplicity
import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.Virasoro.VirasoroStructure

/-! The center and perfectness of the canonical Virasoro extension. -/

namespace LieNotes.Virasoro.Vir

theorem mem_center_iff_mem_span (x : Vir) :
    x ∈ LieAlgebra.center ℂ Vir ↔ x ∈ Submodule.span ℂ {C} := by
  rw [LieModule.mem_maxTrivSubmodule, Submodule.mem_span_singleton]
  constructor
  · intro hx
    have hW : LieAlgebra.center ℂ Witt.W = ⊥ :=
      (Witt.isSimple.eq_bot_or_eq_top _).resolve_right fun h =>
        Witt.isSimple.non_abelian ((LieAlgebra.isLieAbelian_iff_center_eq_top ℂ Witt.W).mpr h)
    have hp : proj x ∈ LieAlgebra.center ℂ Witt.W := by
      rw [LieModule.mem_maxTrivSubmodule]
      intro w
      obtain ⟨y, rfl⟩ := proj_surjective w
      rw [← proj.map_lie, hx y, map_zero]
    rw [hW, LieSubmodule.mem_bot] at hp
    obtain ⟨a, ha⟩ := (proj_eq_zero_iff x).mp hp
    exact ⟨a, ha.symm⟩
  · rintro ⟨a, rfl⟩ y
    rw [lie_smul, ← lie_skew y C, lie_C, neg_zero, smul_zero]

/-- The center of Virasoro is the complex line generated by its central element. -/
theorem center_eq_span :
    (LieAlgebra.center ℂ Vir).toSubmodule = Submodule.span ℂ {C} :=
  Submodule.ext mem_center_iff_mem_span

/-- Every vector in the Virasoro algebra is a linear combination of commutators. -/
theorem span_brackets_eq_top :
    Submodule.span ℂ {⁅x, y⁆ | (x : Vir) (y : Vir)} = ⊤ := by
  let D : Submodule ℂ Vir := Submodule.span ℂ {⁅x, y⁆ | (x : Vir) (y : Vir)}
  have bracket_mem (x y : Vir) : ⁅x, y⁆ ∈ D :=
    Submodule.subset_span ⟨x, y, rfl⟩
  have h0 : L 0 ∈ D := by
    have hbr : ⁅L 1, L (-1)⁆ = (2 : ℂ) • L 0 := by
      norm_num [lie_L, VirasoroSpec.centralCoefficient]
    have h : (2 : ℂ) • L 0 ∈ D := hbr ▸ bracket_mem (L 1) (L (-1))
    exact (D.smul_mem_iff (by norm_num : (2 : ℂ) ≠ 0)).mp h
  have hL (n : ℤ) : L n ∈ D := by
    by_cases hn : n = 0
    · simpa [hn] using h0
    · have h : (-(n : ℂ)) • L n ∈ D := by
        simpa [lie_L, VirasoroSpec.centralCoefficient] using bracket_mem (L 0) (L n)
      exact (D.smul_mem_iff (neg_ne_zero.mpr (Int.cast_ne_zero.mpr hn))).mp h
  have hC : C ∈ D := by
    have hbr : ⁅L 2, L (-2)⁆ = (4 : ℂ) • L 0 + (1 / 2 : ℂ) • C := by
      norm_num [lie_L, VirasoroSpec.centralCoefficient]
    have h := D.sub_mem (bracket_mem (L 2) (L (-2))) (D.smul_mem 4 h0)
    rw [hbr, add_sub_cancel_left] at h
    exact (D.smul_mem_iff (by norm_num : (1 / 2 : ℂ) ≠ 0)).mp h
  let lift : Witt.W →ₗ[ℂ] Vir :=
    coordinates.symm.toLinearMap ∘ₗ LinearMap.inl ℂ Witt.W ℂ
  have hlift : (⊤ : Submodule ℂ Witt.W) ≤ D.comap lift := by
    rw [← Witt.basis.span_eq, Submodule.span_le]
    rintro _ ⟨n, rfl⟩
    change lift (Witt.basis n) ∈ D
    rw [Witt.basis_apply]
    exact hL n
  apply top_unique
  intro x _
  have hx : x = lift (coordinates x).1 + (coordinates x).2 • C := by
    apply coordinates.injective
    have h (w : Witt.W) : coordinates (lift w) = (w, 0) :=
      coordinates.apply_symm_apply (w, 0)
    rw [map_add, map_smul, h, coordinates_C]
    simp
  have hw : lift (coordinates x).1 ∈ D := hlift (Submodule.mem_top)
  rw [hx]
  exact D.add_mem hw (D.smul_mem _ hC)

/-- The derived algebra of Virasoro is all of Virasoro. -/
theorem derived_eq_top : LieAlgebra.derivedSeries ℂ Vir 1 = ⊤ := by
  apply (LieSubmodule.toSubmodule_eq_top _).mp
  simpa only [LieIdeal.toLieSubalgebra_toSubmodule] using
    (LieAlgebra.coe_derivedSeries_one_eq ℂ Vir).trans span_brackets_eq_top

end LieNotes.Virasoro.Vir
