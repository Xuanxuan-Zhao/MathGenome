import MathGenome.Internal.LieTheoryDeepening.Specs.LieNotes.SuperRestricted.RestrictedCenter
import MathGenome.Internal.LieTheoryDeepening.LieNotes.SuperRestricted.AssociativePrimePowers
import MathGenome.Internal.LieTheoryDeepening.LieNotes.SuperRestricted.RestrictedLie
import MathGenome.Internal.LieTheoryDeepening.LieNotes.SuperRestricted.ReducedEnveloping
import Batteries.Tactic.OpenPrivate

/-! The central p-semilinear map into the ordinary enveloping algebra. -/

namespace LieNotes.SuperRestricted.RestrictedCenter

open _root_.Shared.Lie (U inclusion)
open _root_.LieNotes.SuperRestricted.ReducedEnveloping (pCenterElement pCenter)
open _root_.LieNotes.SuperRestricted.RestrictedLie (RestrictedPower)
open _root_.Specs.LieAlgebrasAndRepresentations.RestrictedOperationBoundary
  (jacobsonCorrectionValue)
open _root_.Specs.LieNotes.SuperRestricted.JacobsonPolynomials (jacobsonTermValue)
open _root_.Specs.LieNotes.SuperRestricted.ReducedEnveloping (pCenterElementValue pCenterValue)

open private map_ad_pow_apply map_jacobsonCorrection from MathGenome.Internal.LieTheoryDeepening.LieNotes.SuperRestricted.RestrictedLie

attribute [local instance 100] LieRing.ofAssociativeRing

universe u v w

variable {k : Type u} [Field k] {p : ℕ} [CharP k p] [NeZero p]
  {G : Type v} [LieRing G] [LieAlgebra k G]

private theorem adjoin_range_inclusion :
    Algebra.adjoin k (Set.range (inclusion k G)) = ⊤ := by
  let q := UniversalEnvelopingAlgebra.mkAlgHom k G
  have hq : Function.Surjective q := RingCon.mkₐ_surjective _
  have hrange : Set.range (inclusion k G) = q '' Set.range (TensorAlgebra.ι k (M := G)) := by
    rw [← Set.range_comp]
    rfl
  rw [hrange, ← AlgHom.map_adjoin, TensorAlgebra.adjoin_range_ι, Algebra.map_top]
  exact (AlgHom.range_eq_top q).2 hq

/-- The difference between associative and restricted powers commutes with all of the enveloping algebra. -/
theorem pCenterElement_commute (power : RestrictedPower k p G) (x : G) (a : U k G) :
    Commute (pCenterElement power x) a := by
  apply Algebra.commute_of_mem_adjoin_of_forall_mem_commute
    (s := Set.range (inclusion k G)) (by rw [adjoin_range_inclusion]; exact Algebra.mem_top)
  rintro _ ⟨y, rfl⟩
  have had := congrArg (inclusion k G) (DFunLike.congr_fun (power.property.1 x) y)
  rw [LieAlgebra.ad_apply, LieHom.map_lie, map_ad_pow_apply,
    AssociativePrimePowers.ad_pow, LieAlgebra.ad_apply] at had
  apply commute_iff_lie_eq.mpr
  change ⁅pCenterElementValue power x, inclusion k G y⁆ = 0
  rw [pCenterElementValue, sub_lie, ← had, sub_self]

/-- The subalgebra generated by the p-center elements is central. -/
theorem pCenter_le_center (power : RestrictedPower k p G) :
    pCenter power ≤ Subalgebra.center k (U k G) := by
  change Algebra.adjoin k (Set.range (pCenterElement power)) ≤ _
  apply Algebra.adjoin_le
  rintro _ ⟨x, rfl⟩
  exact Subalgebra.mem_center_iff.mpr fun a => (pCenterElement_commute power x a).symm.eq

/-- The two Jacobson corrections cancel in the difference of powers. -/
theorem pCenterElement_add (power : RestrictedPower k p G) (x y : G) :
    pCenterElement power (x + y) = pCenterElement power x + pCenterElement power y := by
  have hpow := AssociativePrimePowers.pow_add (p := p) (k := k) (inclusion k G x) (inclusion k G y)
  have hsum : (∑ i ∈ Finset.Ico 1 p, jacobsonTermValue k p i (inclusion k G x) (inclusion k G y)) =
      jacobsonCorrectionValue k p (inclusion k G x) (inclusion k G y) :=
    JacobsonPolynomials.sum_jacobsonTerm k p (inclusion k G x) (inclusion k G y)
  rw [hsum, ← map_jacobsonCorrection] at hpow
  simp only [pCenterElement, pCenterElementValue, power.property.2.2 x y, map_add, hpow]
  abel

/-- The p-center map sends scaling by `a` to scaling by `a ^ p`. -/
theorem pCenterElement_smul (power : RestrictedPower k p G) (a : k) (x : G) :
    pCenterElement power (a • x) = a ^ p • pCenterElement power x := by
  simp only [pCenterElement, pCenterElementValue, power.property.2.1 a x, map_smul,
    smul_pow, smul_sub]

/-- The p-center is generated as a k-subalgebra by the images of any k-basis. -/
theorem pCenter_eq_adjoin_basis (power : RestrictedPower k p G) {ι : Type w}
    (b : Module.Basis ι k G) :
    pCenter power = Algebra.adjoin k (Set.range fun i => pCenterElement power (b i)) := by
  classical
  change Algebra.adjoin k (Set.range (pCenterElement power)) = _
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨x, rfl⟩
    let z : G →+ U k G :=
      { toFun := pCenterElement power
        map_zero' := by
          simpa only [zero_smul, zero_pow (NeZero.ne p)] using pCenterElement_smul power 0 (0 : G)
        map_add' := pCenterElement_add power }
    have hx := b.linearCombination_repr x
    rw [Finsupp.linearCombination_apply, Finsupp.sum] at hx
    change z x ∈ _
    rw [← hx, map_sum]
    apply Subalgebra.sum_mem
    intro i _
    change pCenterElement power (b.repr x i • b i) ∈ _
    rw [pCenterElement_smul]
    exact Subalgebra.smul_mem _ (Algebra.subset_adjoin (Set.mem_range_self i)) _
  · apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    exact Algebra.subset_adjoin (Set.mem_range_self (b i))

end LieNotes.SuperRestricted.RestrictedCenter
