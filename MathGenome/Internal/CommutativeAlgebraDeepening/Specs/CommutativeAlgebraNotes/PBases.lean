import MathGenome.Internal.CommutativeAlgebraDeepening.Specs.CommutativeAlgebraNotes.FrobeniusCoefficientDefinitions
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

namespace Specs.CommutativeAlgebraNotes.PBases

open Specs.CommutativeAlgebraNotes.FrobeniusCoefficientDefinitions

universe u v

noncomputable section

def ExtendPIndependent : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p] {ι : Type v} {H : Subfield L}
    (hH : frobeniusSubfield L p ≤ H) (a : ι → L), pIndependent p H hH a →
    ∃ (s : Set L) (e : ι ↪ s), (∀ i, (e i : L) = a i) ∧
      isPBasis p H hH (fun x : s => (x : L))

def ExistsPBasis : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p] {H : Subfield L}
    (hH : frobeniusSubfield L p ≤ H),
    ∃ s : Set L, isPBasis p H hH (fun x : s => (x : L))

def SingletonPIndependent : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p] {H : Subfield L}
    (hH : frobeniusSubfield L p ≤ H) {x : L}, x ∉ H →
    pIndependent p H hH (fun _ : Unit => x)

set_option linter.checkUnivs false in
def ComplementFieldType :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v}, (ι → L) → Finset ι → Subfield L

/-- The subfield generated by the (p)-th powers and the (a_i) with (i
otin J). -/
def complementField {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v} (a : ι → L) (J : Finset ι) : Subfield L :=
  (IntermediateField.adjoin (frobeniusSubfield L p)
    (Set.range fun i : {i : ι // i ∉ J} => a i)).toSubfield

theorem frobenius_le_complementField {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v} (a : ι → L) (J : Finset ι) :
    frobeniusSubfield L p ≤ complementField (p := p) a J :=
  fun x hx => (IntermediateField.adjoin (frobeniusSubfield L p)
    (Set.range fun i : {i : ι // i ∉ J} => a i)).algebraMap_mem ⟨x, hx⟩

def FrobeniusLeComplementField : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v} (a : ι → L) (J : Finset ι),
    frobeniusSubfield L p ≤ complementField (p := p) a J

def PBasisOverComplement : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v} (a : ι → L), isPBasis p (frobeniusSubfield L p) le_rfl a →
    ∀ J : Finset ι, isPBasis p (complementField a J)
      (frobenius_le_complementField a J) (fun i : {i : ι // i ∈ J} => a i)

def ComplementFieldIntersection : Prop :=
  ∀ {L : Type u} [Field L] {p : ℕ} [Fact p.Prime] [CharP L p]
    {ι : Type v} (a : ι → L), isPBasis p (frobeniusSubfield L p) le_rfl a →
    (⨅ J : Finset ι, complementField (p := p) a J) = frobeniusSubfield L p

def FiniteRestrictedExponents : Prop :=
  ∀ {p : ℕ} {ι : Type v} [Finite ι], Finite (RestrictedExponents ι p)

end

end Specs.CommutativeAlgebraNotes.PBases
