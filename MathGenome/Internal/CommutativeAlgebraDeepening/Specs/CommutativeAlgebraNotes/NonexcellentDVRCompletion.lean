import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.AdicCompletion.Algebra
import Mathlib.RingTheory.LaurentSeries
import Mathlib.RingTheory.LocalRing.ResidueField.Fiber

noncomputable section

open scoped LaurentSeries PowerSeries Polynomial RatFunc WithZero

namespace CommutativeAlgebraNotes.NonexcellentDVRCompletion.Specs

universe u

/-- The usual embedding of rational functions into Laurent series, over the coefficient field. -/
def rationalEmbedding (k : Type u) [Field k] : RatFunc k →ₐ[k] k⸨X⸩ where
  __ := algebraMap (RatFunc k) k⸨X⸩
  commutes' a := by
    change algebraMap (RatFunc k) k⸨X⸩ (RatFunc.coePolynomial (Polynomial.C a)) =
      algebraMap k k⸨X⸩ a
    rw [← RatFunc.coe_coe]
    simp [LaurentSeries.algebraMap_apply]

/-- The copy of the rational function field inside the Laurent series field. -/
abbrev rationalField (k : Type u) [Field k] : IntermediateField k k⸨X⸩ :=
  (rationalEmbedding k).fieldRange

/-- The subfield generated by the rational functions and the (p)-th power of (f). -/
def generatedField (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)) :
    IntermediateField (ZMod p) (LaurentSeries (ZMod p)) :=
  rationalField (ZMod p) ⊔ IntermediateField.adjoin (ZMod p)
    {((f : LaurentSeries (ZMod p)) ^ p)}

theorem rationalField_le_generatedField (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)) :
    rationalField (ZMod p) ≤ generatedField p f :=
  le_sup_left

variable {k : Type u} [Field k]

/-- The restriction of the (X)-adic valuation to an intermediate field. -/
def restrictedValuation (F : IntermediateField k k⸨X⸩) : Valuation F ℤᵐ⁰ :=
  (Valued.v : Valuation k⸨X⸩ ℤᵐ⁰).comap F.val.toRingHom

/-- The intersection of the intermediate field and the power series ring. -/
abbrev valuationRing (F : IntermediateField k k⸨X⸩) : ValuationSubring F :=
  (restrictedValuation F).valuationSubring

/-- The inclusion of the intersection ring into the power series ring. -/
def powerSeriesInclusion (F : IntermediateField k k⸨X⸩) :
    valuationRing F →+* k⟦X⟧ :=
  (LaurentSeries.powerSeriesEquivSubring k).symm.toRingHom.comp <|
    (F.val.toRingHom.comp (algebraMap (valuationRing F) F)).codRestrict
      (LaurentSeries.powerSeries_as_subring k) fun x => by
        obtain ⟨s, hs⟩ := (LaurentSeries.val_le_one_iff_eq_coe k _).mp x.property
        exact Subring.mem_map.mpr ⟨s, trivial, hs⟩

instance (F : IntermediateField k k⸨X⸩) : Algebra (valuationRing F) k⟦X⟧ :=
  (powerSeriesInclusion F).toAlgebra

/-- Polynomials included in the intersection ring via their Laurent series expansions. -/
def polynomialInclusion (F : IntermediateField k k⸨X⸩) (hF : rationalField k ≤ F) :
    k[X] →+* valuationRing F :=
  (((IntermediateField.inclusion hF).comp (rationalEmbedding k).rangeRestrict).toRingHom.comp
    (algebraMap k[X] (RatFunc k))).codRestrict (valuationRing F) fun g => by
      change Valued.v ((rationalEmbedding k) (RatFunc.coePolynomial g)) ≤ (1 : ℤᵐ⁰)
      rw [show rationalEmbedding k (RatFunc.coePolynomial g) =
        ((g : k⟦X⟧) : k⸨X⸩) from (RatFunc.coe_coe g).symm]
      exact (LaurentSeries.val_le_one_iff_eq_coe k _).mpr ⟨g, rfl⟩

/-- The element (t=X) of the intersection ring. -/
abbrev uniformizer (F : IntermediateField k k⸨X⸩) (hF : rationalField k ≤ F) : valuationRing F :=
  polynomialInclusion F hF Polynomial.X

/-- Transcendence is taken over the embedded rational function field. -/
def SeriesTranscendental (k : Type u) [Field k] (f : k⟦X⟧) : Prop :=
  Transcendental (rationalField k) (f : k⸨X⸩)

def ExistsTranscendentalSeries : Prop :=
  ∀ (p : ℕ) [Fact p.Prime], ∃ f : PowerSeries (ZMod p), SeriesTranscendental (ZMod p) f

def MemIntersection (F : IntermediateField k k⸨X⸩) : Prop :=
  ∀ x : F, x ∈ valuationRing F ↔ ∃ s : k⟦X⟧, (s : k⸨X⸩) = (x : k⸨X⸩)

def RestrictedValuationSurjective (F : IntermediateField k k⸨X⸩) : Prop :=
  rationalField k ≤ F → Function.Surjective (restrictedValuation F)

def DiscreteValuationRing (F : IntermediateField k k⸨X⸩) : Prop :=
  rationalField k ≤ F → IsDiscreteValuationRing (valuationRing F)

abbrev maximalIdeal (F : IntermediateField k k⸨X⸩) : Ideal (valuationRing F) :=
  IsLocalRing.maximalIdeal (valuationRing F)

def Uniformizer (F : IntermediateField k k⸨X⸩) : Prop :=
  ∀ hF : rationalField k ≤ F, maximalIdeal F = Ideal.span {uniformizer F hF}

def FractionField (F : IntermediateField k k⸨X⸩) : Prop :=
  IsFractionRing (valuationRing F) F

abbrev polynomialIdeal (k : Type u) [Field k] : Ideal k[X] := Ideal.span {Polynomial.X}

abbrev seriesIdeal (k : Type u) [Field k] : Ideal k⟦X⟧ := Ideal.span {PowerSeries.X}

/-- The natural map from polynomial truncations gives the indicated compatible isomorphisms. -/
def CompatibleQuotients (F : IntermediateField k k⸨X⸩) : Prop :=
  ∀ hF : rationalField k ≤ F,
    ∃ e : ∀ n : ℕ, (k[X] ⧸ polynomialIdeal k ^ n) ≃+*
        (valuationRing F ⧸ maximalIdeal F ^ n),
      (∀ n g, e n (Ideal.Quotient.mk _ g) =
        Ideal.Quotient.mk _ (polynomialInclusion F hF g)) ∧
      ∀ (m n : ℕ) (h : m ≤ n) x,
        Ideal.Quotient.factorPow (maximalIdeal F) h (e n x) =
          e m (Ideal.Quotient.factorPow (polynomialIdeal k) h x)

abbrev Completion (F : IntermediateField k k⸨X⸩) :=
  AdicCompletion (maximalIdeal F) (valuationRing F)

/-- An algebra equivalence over the intersection ring extends its canonical inclusion. -/
def CompletionIdentification (F : IntermediateField k k⸨X⸩) : Prop :=
  rationalField k ≤ F → Nonempty (Completion F ≃ₐ[valuationRing F] k⟦X⟧)

abbrev GenericFiber (F : IntermediateField k k⸨X⸩) :=
  (⊥ : Ideal (valuationRing F)).Fiber (Completion F)



abbrev GenericResidueField (F : IntermediateField k k⸨X⸩) :=
  (⊥ : Ideal (valuationRing F)).ResidueField

/-- The residue field at the zero prime, identified with the actual embedded fraction field. -/
def genericResidueEquiv (F : IntermediateField k k⸨X⸩) :
    GenericResidueField F ≃ₐ[valuationRing F] F :=
  IsLocalization.algEquiv (nonZeroDivisors (valuationRing F)) _ _

/-- Scalars act through the fraction field (F) and its inclusion into Laurent series. -/
instance (F : IntermediateField k k⸨X⸩) : Algebra (GenericResidueField F) k⸨X⸩ :=
  (F.val.toRingHom.comp (genericResidueEquiv F).toRingEquiv.toRingHom).toAlgebra

def FractionFieldByInverting (F : IntermediateField k k⸨X⸩) : Prop :=
  ∀ hF : rationalField k ≤ F, IsLocalization.Away (uniformizer F hF) F

/-- The generic formal fibre is the localization of the completion at the uniformizer. -/
def GenericFiberByInverting (F : IntermediateField k k⸨X⸩) : Prop :=
  letI : Algebra (Completion F) (GenericFiber F) := Algebra.TensorProduct.rightAlgebra
  ∀ hF : rationalField k ≤ F,
    IsLocalization.Away (algebraMap (valuationRing F) (Completion F) (uniformizer F hF))
      (GenericFiber F)

open scoped TensorProduct

/-- The two factors of the fibre map by the fraction-field and completed inclusions. -/
def GenericFiberIdentification (F : IntermediateField k k⸨X⸩) : Prop :=
  rationalField k ≤ F →
    ∃ e : Completion F ≃ₐ[valuationRing F] k⟦X⟧,
      ∃ g : GenericFiber F ≃ₐ[GenericResidueField F] k⸨X⸩,
        ∀ (a : GenericResidueField F) (s : Completion F),
          g (a ⊗ₜ[valuationRing F] s) =
            ((genericResidueEquiv F a : F) : k⸨X⸩) * (e s : k⸨X⸩)

/-- All the ring and completion properties apply to the field constructed from any (f). -/
def Construction : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)),
    let F := generatedField p f
    MemIntersection F ∧ FractionField F ∧
      Function.Surjective (restrictedValuation F) ∧ IsDiscreteValuationRing (valuationRing F) ∧
      maximalIdeal F = Ideal.span {uniformizer F (rationalField_le_generatedField p f)} ∧
      CompatibleQuotients F ∧ CompletionIdentification F ∧ FractionFieldByInverting F ∧
      GenericFiberByInverting F ∧ GenericFiberIdentification F

def RationalEmbeddingType :=
  ∀ (k : Type u) [Field k], RatFunc k →ₐ[k] k⸨X⸩

def RationalFieldType :=
  ∀ (k : Type u) [Field k], IntermediateField k k⸨X⸩

def GeneratedFieldType :=
  ∀ (p : ℕ) [Fact p.Prime], PowerSeries (ZMod p) → IntermediateField (ZMod p) (ZMod p)⸨X⸩

def RestrictedValuationType :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), Valuation F ℤᵐ⁰

def ValuationRingType :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), ValuationSubring F

def PowerSeriesInclusionType :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), valuationRing F →+* k⟦X⟧

def PolynomialInclusionType :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩),
    rationalField k ≤ F → k[X] →+* valuationRing F

def UniformizerType :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), rationalField k ≤ F → valuationRing F

def SeriesTranscendentalType :=
  ∀ (k : Type u) [Field k], k⟦X⟧ → Prop

def PowerSeriesInclusionCoe (F : IntermediateField k k⸨X⸩) : Prop :=
  ∀ x : valuationRing F, (powerSeriesInclusion F x : k⸨X⸩) = ((x : F) : k⸨X⸩)

def GeneratedFieldContainsPower : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)),
    ((f : LaurentSeries (ZMod p)) ^ p) ∈ generatedField p f

def RationalFieldLeGeneratedField : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (f : PowerSeries (ZMod p)),
    rationalField (ZMod p) ≤ generatedField p f

def MemIntersectionType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), MemIntersection F

def FractionFieldType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), FractionField F

def PowerSeriesInclusionCoeType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), PowerSeriesInclusionCoe F

def RestrictedValuationSurjectiveType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), RestrictedValuationSurjective F

def DiscreteValuationRingType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), DiscreteValuationRing F

def MaximalIdealEqSpanType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), Uniformizer F

def CompatibleQuotientsType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), CompatibleQuotients F

def CompletionIdentificationType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), CompletionIdentification F

def FractionFieldByInvertingType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), FractionFieldByInverting F

def GenericFiberByInvertingType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), GenericFiberByInverting F

def GenericFiberIdentificationType : Prop :=
  ∀ {k : Type u} [Field k] (F : IntermediateField k k⸨X⸩), GenericFiberIdentification F

end CommutativeAlgebraNotes.NonexcellentDVRCompletion.Specs
