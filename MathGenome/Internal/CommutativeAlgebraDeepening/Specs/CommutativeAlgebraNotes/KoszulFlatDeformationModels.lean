import MathGenome.Internal.CommutativeAlgebraDeepening.Specs.CommutativeAlgebraNotes.LocalArtinAlgebras
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.Algebra.MvPolynomial.Eval

/-! Polynomial presentations and their marked special fibres over local Artin rings. -/

universe u v

namespace CommutativeAlgebraNotes.KoszulFlatDeformationModelsSpec

open scoped TensorProduct

/-- The quotient by the ideal generated by the ordered list of equations. -/
abbrev Model {R : Type*} [CommRing R] {n : ℕ} (g : List (MvPolynomial (Fin n) R)) :=
  MvPolynomial (Fin n) R ⧸ Ideal.ofList g

def FreeModel : Prop :=
  ∀ {k : Type u} [Field k] (A : LocalArtinAlgebra.{u,v} k) {n : ℕ}
    (g : List (MvPolynomial (Fin n) A)) (f : List (MvPolynomial (Fin n) k)),
    g.map (MvPolynomial.map A.residue.toRingHom) = f →
    RingTheory.Sequence.IsRegular (MvPolynomial (Fin n) k) f →
    Module.Free A (Model g)

def FlatModel : Prop :=
  ∀ {k : Type u} [Field k] (A : LocalArtinAlgebra.{u,v} k) {n : ℕ}
    (g : List (MvPolynomial (Fin n) A)) (f : List (MvPolynomial (Fin n) k)),
    g.map (MvPolynomial.map A.residue.toRingHom) = f →
    RingTheory.Sequence.IsRegular (MvPolynomial (Fin n) k) f →
    Module.Flat A (Model g)

/-- The marking sends the class of each polynomial to its coefficientwise reduction. -/
def CanonicalSpecialFibre : Prop :=
  ∀ {k : Type u} [Field k] (A : LocalArtinAlgebra.{u,v} k) {n : ℕ}
    (g : List (MvPolynomial (Fin n) A)) (f : List (MvPolynomial (Fin n) k)),
    g.map (MvPolynomial.map A.residue.toRingHom) = f →
    ∃ e : MarkedDeformation.SpecialFibre A (Model g) ≃ₐ[k] Model f,
      ∀ (c : k) (p : MvPolynomial (Fin n) A),
        e (c ⊗ₜ[A] Ideal.Quotient.mk (Ideal.ofList g) p) =
          c • Ideal.Quotient.mk (Ideal.ofList f) (MvPolynomial.map A.residue.toRingHom p)

end CommutativeAlgebraNotes.KoszulFlatDeformationModelsSpec
