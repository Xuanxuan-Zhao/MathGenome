import MathGenome.Internal.CommutativeAlgebraDeepening.Specs.CommutativeAlgebraNotes.Intersection.ExteriorTensorProduct
import Mathlib.RingTheory.MvPowerSeries.Equiv
import Mathlib.RingTheory.TensorProduct.Maps

open scoped TensorProduct
open CommutativeAlgebraNotes.Intersection.ExteriorTensorProduct

namespace CommutativeAlgebraNotes.Intersection.ExteriorTensorInverseLimit

noncomputable section

set_option maxHeartbeats 600000

/-- The ideal generated by all the variables. -/
def variableIdeal (k : Type*) [CommRing k] (σ : Type*) : Ideal (MvPowerSeries σ k) :=
  Ideal.span (Set.range MvPowerSeries.X)

variable (k : Type*) [Field k] (a b : ℕ)

abbrev xIdeal (i : ℕ) : Ideal (X k a) := variableIdeal k (Fin a) ^ i
abbrev yIdeal (j : ℕ) : Ideal (Y k b) := variableIdeal k (YIndex b) ^ j

/-- Separate bounds on the degree in the left and right variables. -/
def rectangle (i j : ℕ) : Ideal (S k a b) :=
  (xIdeal k a i).map (includeX k a b).toRingHom ⊔
  (yIdeal k b j).map (includeY k a b).toRingHom

abbrev jointIdeal := variableIdeal k (Fin a ⊕ YIndex b)

abbrev XRing (i : ℕ) := X k a ⧸ xIdeal k a i
abbrev YRing (j : ℕ) := Y k b ⧸ yIdeal k b j
abbrev RingLevel (i j : ℕ) := S k a b ⧸ rectangle k a b i j
abbrev TensorRing (i j : ℕ) := XRing k a i ⊗[k] YRing k b j

/-- The canonical map to the rectangular quotient, given by multiplication of
the images of the two rings. -/
def tensorRingToLevel (i j : ℕ) : TensorRing k a b i j →ₐ[k] RingLevel k a b i j :=
  Algebra.TensorProduct.lift
    (Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ k _).comp (includeX k a b))
      fun _r hr => Ideal.Quotient.eq_zero_iff_mem.mpr
        (Submodule.mem_sup_left (Ideal.mem_map_of_mem (includeX k a b).toRingHom hr)))
    (Ideal.Quotient.liftₐ _ ((Ideal.Quotient.mkₐ k _).comp (includeY k a b))
      fun _r hr => Ideal.Quotient.eq_zero_iff_mem.mpr
        (Submodule.mem_sup_right (Ideal.mem_map_of_mem (includeY k a b).toRingHom hr)))
    fun _ _ => Commute.all _ _

def RingComparison : Prop :=
  ∀ (k : Type*) [Field k] (a b i j : ℕ),
    Function.Bijective (tensorRingToLevel k a b i j)

def CofinalPowers : Prop :=
  ∀ (k : Type*) [Field k] (a b n : ℕ), 1 ≤ n →
    jointIdeal k a b ^ (2 * n - 1) ≤ rectangle k a b n n ∧
    rectangle k a b n n ≤ jointIdeal k a b ^ n

theorem rectangle_antitone {i i' j j' : ℕ} (hi : i ≤ i') (hj : j ≤ j') :
    rectangle k a b i' j' ≤ rectangle k a b i j :=
  sup_le_sup (Ideal.map_mono (Ideal.pow_le_pow_right hi))
    (Ideal.map_mono (Ideal.pow_le_pow_right hj))

section ModuleLevels

variable (M N : Type*) [AddCommGroup M] [Module (X k a) M]
  [AddCommGroup N] [Module (Y k b) N]

abbrev xSubmodule (i : ℕ) : Submodule (X k a) M := xIdeal k a i • ⊤
abbrev ySubmodule (j : ℕ) : Submodule (Y k b) N := yIdeal k b j • ⊤
abbrev XM (i : ℕ) := M ⧸ xSubmodule k a M i
abbrev YN (j : ℕ) := N ⧸ ySubmodule k b N j

scoped instance : Module k (XM k a M i) :=
  Module.compHom _ (algebraMap k (X k a))

scoped instance : Module k (YN k b N j) :=
  Module.compHom _ (algebraMap k (Y k b))

scoped instance : IsScalarTower k (X k a) (XM k a M i) :=
  IsScalarTower.of_algebraMap_smul fun _ _ => rfl

scoped instance : IsScalarTower k (Y k b) (YN k b N j) :=
  IsScalarTower.of_algebraMap_smul fun _ _ => rfl

open scoped ExteriorTensorInverseLimit

abbrev ModuleTensor (i j : ℕ) := XM k a M i ⊗[k] YN k b N j

/-- Canonical quotient-module transition maps. -/
def xTransition {i i' : ℕ} (hi : i ≤ i') : XM k a M i' →ₗ[X k a] XM k a M i :=
  Submodule.factor (Submodule.smul_mono_left (Ideal.pow_le_pow_right hi))

def yTransition {j j' : ℕ} (hj : j ≤ j') : YN k b N j' →ₗ[Y k b] YN k b N j :=
  Submodule.factor (Submodule.smul_mono_left (Ideal.pow_le_pow_right hj))

def tensorTransition {i i' j j' : ℕ} (hi : i ≤ i') (hj : j ≤ j') :
    ModuleTensor k a b M N i' j' →ₗ[k] ModuleTensor k a b M N i j :=
  TensorProduct.map ((xTransition k a M hi).restrictScalars k)
    ((yTransition k b N hj).restrictScalars k)

/-- Scalar multiplication on a quotient module, factored through the quotient ring. -/
def quotientAction {R L : Type*} [CommRing R] [Algebra k R]
    [AddCommGroup L] [Module R L] (I : Ideal R)
    [Module k (L ⧸ (I • ⊤ : Submodule R L))]
    [IsScalarTower k R (L ⧸ (I • ⊤ : Submodule R L))] :
    R ⧸ I →ₐ[k] Module.End k (L ⧸ (I • ⊤ : Submodule R L)) :=
  Ideal.Quotient.liftₐ I (Algebra.lsmul k k (L ⧸ (I • ⊤ : Submodule R L))) fun r hr => by
    apply LinearMap.ext
    intro q
    induction q using Submodule.Quotient.induction_on with
    | _ l =>
      change (Submodule.Quotient.mk (r • l) : L ⧸ (I • ⊤ : Submodule R L)) = 0
      exact (Submodule.Quotient.mk_eq_zero _).2 (Submodule.smul_mem_smul hr Submodule.mem_top)

/-- The action of the tensor product of the two quotient algebras on the tensor
product of the two quotient modules. -/
def tensorAction (i j : ℕ) :
    TensorRing k a b i j →ₐ[k] Module.End k (ModuleTensor k a b M N i j) :=
  (Module.endTensorEndAlgHom (R := k) (S := k) (A := k)).comp
    (Algebra.TensorProduct.map (quotientAction k (L := M) (xIdeal k a i))
      (quotientAction k (L := N) (yIdeal k b j)))

def tensorActionOfSeries (h : RingComparison) (i j : ℕ) :
    S k a b →ₐ[k] Module.End k (ModuleTensor k a b M N i j) :=
  (tensorAction k a b M N i j).comp
    ((AlgEquiv.ofBijective (tensorRingToLevel k a b i j) (h k a b i j)).symm.toAlgHom.comp
      (Ideal.Quotient.mkₐ k _))

/-- The joint series acts through its image in the tensor product of the two
truncated series rings. -/
@[instance_reducible] def tensorModule (h : RingComparison) (i j : ℕ) :
    Module (S k a b) (ModuleTensor k a b M N i j) :=
  Module.compHom _ (tensorActionOfSeries k a b M N h i j).toRingHom

end ModuleLevels

section RectangularQuotients

variable (E : Type*) [AddCommGroup E] [Module (S k a b) E]

abbrev levelSubmodule (i j : ℕ) : Submodule (S k a b) E := rectangle k a b i j • ⊤

abbrev ModuleLevel (i j : ℕ) := E ⧸ levelSubmodule k a b E i j

def levelTransition {i i' j j' : ℕ} (hi : i ≤ i') (hj : j ≤ j') :
    ModuleLevel k a b E i' j' →ₗ[S k a b] ModuleLevel k a b E i j :=
  Submodule.factor (Submodule.smul_mono_left (rectangle_antitone k a b hi hj))

/-- The actual two-index inverse limit of rectangular quotients. -/
def LevelLimit : Submodule (S k a b) (∀ i j : ℕ, ModuleLevel k a b E i j) where
  carrier := {f | ∀ i i' j j' (hi : i ≤ i') (hj : j ≤ j'),
    levelTransition k a b E hi hj (f i' j') = f i j}
  zero_mem' := by
    intro i i' j j' hi hj
    exact map_zero (levelTransition k a b E hi hj)
  add_mem' hf hg := by
    intro i i' j j' hi hj
    change levelTransition k a b E hi hj ( _ + _) = _ + _
    rw [map_add, hf i i' j j' hi hj, hg i i' j j' hi hj]
  smul_mem' r f hf := by
    intro i i' j j' hi hj
    change levelTransition k a b E hi hj (r • _) = r • _
    rw [map_smul, hf i i' j j' hi hj]

def toLevelLimit : E →ₗ[S k a b] LevelLimit k a b E where
  toFun e := ⟨fun _ _ => Submodule.Quotient.mk e, fun _ _ _ _ _ _ => rfl⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

def QuotientLimitComparison : Prop :=
  ∀ (k : Type*) [Field k] (a b : ℕ) (E : Type*) [AddCommGroup E]
    [Module (S k a b) E] [Module.Finite (S k a b) E],
    Function.Bijective (toLevelLimit k a b E)

end RectangularQuotients

section TensorLimit

variable {R : Type*} [CommRing R] (F : ℕ → ℕ → Type*)
  [∀ i j, AddCommGroup (F i j)] [∀ i j, Module R (F i j)]
  (transition : ∀ {i i' j j' : ℕ}, i ≤ i' → j ≤ j' → F i' j' →ₗ[R] F i j)

/-- Compatible families for a system indexed by two nonnegative integers. -/
def compatibleLimit : Submodule R (∀ i j, F i j) where
  carrier := {f | ∀ i i' j j' (hi : i ≤ i') (hj : j ≤ j'),
    transition hi hj (f i' j') = f i j}
  zero_mem' := by
    intro i i' j j' hi hj
    exact map_zero (transition hi hj)
  add_mem' hf hg := by
    intro i i' j j' hi hj
    change transition hi hj (_ + _) = _ + _
    rw [map_add, hf i i' j j' hi hj, hg i i' j j' hi hj]
  smul_mem' r f hf := by
    intro i i' j j' hi hj
    change transition hi hj (r • _) = r • _
    rw [map_smul, hf i i' j j' hi hj]

/-- Compatible families indexed by positive integers, represented by successors. -/
abbrev compatibleLimitSucc :=
  compatibleLimit (fun i j => F (i + 1) (j + 1))
    (fun hi hj => transition (Nat.succ_le_succ hi) (Nat.succ_le_succ hj))

end TensorLimit

open scoped ExteriorTensorInverseLimit

universe u v w

/-- Finite-level identifications, with their prescribed maps, and the resulting
inverse-limit identification for finite modules. -/
def ExteriorComparison : Prop :=
  ∀ (k : Type u) [Field k] (a b : ℕ)
    (M : Type v) (N : Type w) [AddCommGroup M] [Module (X k a) M]
    [AddCommGroup N] [Module (Y k b) N]
    (h : RingComparison.{u}),
    let T := ExteriorTensorProduct.Spec.productValue k a b M N
    let F := ModuleTensor k a b M N
    letI : ∀ i j, Module (S k a b) (F i j) := tensorModule k a b M N h
    ∃ e : ∀ i j, ModuleLevel k a b T i j ≃ₗ[S k a b] F i j,
      (∀ i j (m : M) (n : N),
        e i j (Submodule.Quotient.mk (((1 : S k a b) ⊗ₜ[X k a] m) ⊗ₜ[Y k b] n)) =
          (xSubmodule k a M i).mkQ m ⊗ₜ[k] (ySubmodule k b N j).mkQ n) ∧
      ∃ tr : ∀ {i i' j j'}, i ≤ i' → j ≤ j' → F i' j' →ₗ[S k a b] F i j,
        (∀ i i' j j' (hi : i ≤ i') (hj : j ≤ j') (z : F i' j'),
          tr hi hj z = tensorTransition k a b M N hi hj z) ∧
        (∀ i i' j j' (hi : i ≤ i') (hj : j ≤ j') (t : ModuleLevel k a b T i' j'),
          tr hi hj (e i' j' t) = e i j (levelTransition k a b T hi hj t)) ∧
        (∀ [Module.Finite (X k a) M] [Module.Finite (Y k b) N],
          ∃ lim : T ≃ₗ[S k a b] compatibleLimitSucc F (@tr),
            ∀ t i j, (lim t).val i j = e (i + 1) (j + 1) (Submodule.Quotient.mk t))


end

end CommutativeAlgebraNotes.Intersection.ExteriorTensorInverseLimit
