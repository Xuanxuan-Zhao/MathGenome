import MathGenome.Internal.CommutativeAlgebraDeepening.Specs.CommutativeAlgebraNotes.NonexcellentDVRCompletion
import MathGenome.Internal.CommutativeAlgebraDeepening.Specs.CommutativeAlgebraNotes.ExcellenceDefinitions
import Mathlib.RingTheory.AdjoinRoot

noncomputable section

open scoped Polynomial PowerSeries LaurentSeries TensorProduct
open Polynomial

namespace CommutativeAlgebraNotes.InseparableDVRFormalFiber.Specs

open NonexcellentDVRCompletion.Specs

variable (p : ℕ) [Fact p.Prime] (f : (ZMod p)⟦X⟧)

abbrev ExtendedField :=
  IntermediateField.adjoin (generatedField p f) {(f : (ZMod p)⸨X⸩)}

abbrev extendedGenerator : ExtendedField p f :=
  ⟨f, IntermediateField.mem_adjoin_simple_self _ _⟩

abbrev FiberPolynomial : (ZMod p)⸨X⸩[X] :=
  X ^ p - C ((f : (ZMod p)⸨X⸩) ^ p)

/-- The extension is generated by the restricted power basis
\(1,f,\ldots,f^{p-1}\). -/
def ExtensionDegree : Prop :=
  ∃ b : PowerBasis (generatedField p f) (ExtendedField p f),
    b.gen = extendedGenerator p f ∧ b.dim = p ∧
      Module.finrank (generatedField p f) (ExtendedField p f) = p

/-- The scalar action on the extension uses the canonical identification
of the residue field of the zero prime with the fraction field. -/
abbrev residueExtensionAlgebra :
    Algebra (GenericResidueField (generatedField p f)) (ExtendedField p f) :=
  ((algebraMap (generatedField p f) (ExtendedField p f)).comp
    (genericResidueEquiv (generatedField p f)).toRingEquiv.toRingHom).toAlgebra

/-- The base change of the identified generic fibre, with its Laurent series
algebra structure and with the new field generator sent to the polynomial class. -/
def FiberPresentation : Prop :=
  ∃ e : ((ZMod p)⸨X⸩ ⊗[generatedField p f] ExtendedField p f) ≃ₐ[(ZMod p)⸨X⸩]
      AdjoinRoot (FiberPolynomial p f),
    e (1 ⊗ₜ[generatedField p f] extendedGenerator p f) =
      AdjoinRoot.root (FiberPolynomial p f) ∧
    (let K := generatedField p f
     let R := GenericResidueField K
     letI := residueExtensionAlgebra p f
     ∀ g : GenericFiber K ≃ₐ[R] (ZMod p)⸨X⸩,
       ∃ e' : (ExtendedField p f ⊗[R] GenericFiber K) ≃+* AdjoinRoot (FiberPolynomial p f),
         ∀ l a, e' (l ⊗ₜ[R] g.symm a) = e (a ⊗ₜ[K] l))

def FiberPolynomialFactorization : Prop :=
  FiberPolynomial p f = (X - C (f : (ZMod p)⸨X⸩)) ^ p

def FiberNilpotent : Prop :=
  let z := AdjoinRoot.mk (FiberPolynomial p f) (X - C (f : (ZMod p)⸨X⸩))
  z ≠ 0 ∧ z ^ p = 0

/-- The contrast ring is the localization of the coefficient polynomial ring at (X). -/
def ExcellentPolynomialDVR : Prop :=
  ∀ (p : ℕ) [Fact p.Prime],
    letI : (polynomialIdeal (ZMod p)).IsPrime := (Ideal.span_singleton_prime X_ne_zero).mpr
      prime_X
    IsDiscreteValuationRing (Localization.AtPrime (polynomialIdeal (ZMod p))) ∧
      Excellence.Specs.ExcellentValue (Localization.AtPrime (polynomialIdeal (ZMod p)))

/-- The inseparable part of Example 5.23 holds for every transcendental choice.
The ring, truncations and completion are those of the preceding construction. -/
def InseparableExample : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (f : (ZMod p)⟦X⟧), SeriesTranscendental (ZMod p) f →
    let K := generatedField p f
    let V := valuationRing K
    ∃ _h : IsDiscreteValuationRing V,
      MemIntersection K ∧ FractionField K ∧
      Function.Surjective (restrictedValuation K) ∧
      maximalIdeal K = Ideal.span {uniformizer K (rationalField_le_generatedField p f)} ∧
      CompatibleQuotients K ∧ CompletionIdentification K ∧ FractionFieldByInverting K ∧
      GenericFiberByInverting K ∧ GenericFiberIdentification K ∧
      ExtensionDegree p f ∧ FiberPresentation p f ∧ FiberPolynomialFactorization p f ∧
      FiberNilpotent p f ∧
      ¬ Excellence.Specs.GeometricallyRegularValue (GenericResidueField K) (GenericFiber K) ∧
      ¬ Excellence.Specs.IsGRingValue V ∧ ¬ Excellence.Specs.ExcellentValue V

/-- Example 5.23 in full, including the existence for every prime and the contrast. -/
def ExampleType : Prop :=
  ExistsTranscendentalSeries ∧ InseparableExample ∧ ExcellentPolynomialDVR

end CommutativeAlgebraNotes.InseparableDVRFormalFiber.Specs
