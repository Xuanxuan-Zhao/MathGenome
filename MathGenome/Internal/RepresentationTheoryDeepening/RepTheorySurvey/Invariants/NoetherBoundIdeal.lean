import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.Actions
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Invariants.NoetherBoundIdeal
import Mathlib.Data.Nat.Choose.Multinomial
import Mathlib.RingTheory.Invariant.Basic
import Mathlib.RingTheory.Polynomial.Vieta

noncomputable section

universe u v w

namespace RepTheorySurvey.Invariants

open MvPolynomial

variable {k : Type u} {G : Type v} {ι : Type w} [Field k] [Group G]

/-- The ideal generated by fixed homogeneous polynomials of degrees 1 through the bound. -/
abbrev lowDegreeInvariantIdeal (ρ : GroupAlgebraAction k G (MvPolynomial ι k))
    (bound : ℕ) : Ideal (MvPolynomial ι k) :=
  Specs.lowDegreeInvariantIdeal ρ bound

private abbrev Aux (ι : Type w) (k : Type u) [Field k] :=
  MvPolynomial ι (MvPolynomial ι k)

/-- Extend the action coefficientwise, fixing the auxiliary variables. -/
private abbrev auxiliaryAction (ρ : GroupAlgebraAction k G (MvPolynomial ι k)) :
    MulSemiringAction G (Aux ι k) :=
  MulSemiringAction.compHom (Aux ι k)
    (show G →* (Aux ι k ≃ₐ[k] Aux ι k) from
      { toFun g := mapAlgEquiv ι (ρ g)
        map_one' := by rw [map_one]; exact mapAlgEquiv_refl ι
        map_mul' g h := by
          rw [map_mul]
          change mapAlgEquiv ι ((ρ h).trans (ρ g)) =
            (mapAlgEquiv ι (ρ h)).trans (mapAlgEquiv ι (ρ g))
          exact (mapAlgEquiv_trans ι (ρ h) (ρ g)).symm })

private theorem coeff_mul_isHomogeneous (p q : Aux ι k) {a b : ℕ}
    (hp : ∀ e, (p.coeff e).IsHomogeneous a) (hq : ∀ e, (q.coeff e).IsHomogeneous b) :
    ∀ e, ((p * q).coeff e).IsHomogeneous (a + b) := by
  classical
  intro e
  rw [coeff_mul]
  exact IsHomogeneous.sum _ _ _ fun i _ ↦ (hp i.1).mul (hq i.2)

private theorem coeff_prod_isHomogeneous {α : Type*} (s : Finset α) (f : α → Aux ι k)
    (h : ∀ i ∈ s, ∀ e, ((f i).coeff e).IsHomogeneous 1) :
    ∀ e, ((∏ i ∈ s, f i).coeff e).IsHomogeneous s.card := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro e
    by_cases he : e = 0
    · simp [he, isHomogeneous_one]
    · simp [coeff_one, Ne.symm he, isHomogeneous_zero]
  | insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.card_insert_of_notMem hi, add_comm]
    refine coeff_mul_isHomogeneous _ _ (h i (Finset.mem_insert_self i s)) (ih ?_)
    exact fun j hj ↦ h j (Finset.mem_insert_of_mem hj)

/-- In the quotient by the bounded invariant ideal, the auxiliary linear form has zero
power at the group order. -/
private theorem auxiliaryForm_pow_eq_zero [Fintype G] [Fintype ι]
    (ρ : GroupAlgebraAction k G (MvPolynomial ι k))
    (hρ : ∀ g i, (ρ g (X i)).IsHomogeneous 1) :
    let I := lowDegreeInvariantIdeal ρ (Fintype.card G)
    (∑ i : ι, C (Ideal.Quotient.mk I (X i)) * X i) ^ Fintype.card G = 0 := by
  classical
  dsimp only
  let m := Fintype.card G
  let I := lowDegreeInvariantIdeal ρ m
  let q : Aux ι k →+* MvPolynomial ι (MvPolynomial ι k ⧸ I) :=
    MvPolynomial.map (Ideal.Quotient.mk I)
  let z : Aux ι k := ∑ i : ι, C (X i) * X i
  let : MulSemiringAction G (Aux ι k) := auxiliaryAction ρ
  let P := MulSemiringAction.charpoly G z
  have hdeg : P.natDegree = m := by
    simp [P, m, MulSemiringAction.charpoly_eq]
  have htop : P.coeff m = 1 := by
    rw [← hdeg]
    exact (MulSemiringAction.monic_charpoly G z).coeff_natDegree
  have hcoeff (j : ℕ) (hj : j < m) : q (P.coeff j) = 0 := by
    ext e
    simp only [AddMonoidAlgebra.coeff_zero]
    change (MvPolynomial.map (Ideal.Quotient.mk I) (P.coeff j)).coeff e = 0
    rw [coeff_map, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.subset_span
    refine ⟨?_, m - j, by omega, Nat.sub_le _ _, ?_⟩
    · intro g
      have hg := MulSemiringAction.smul_coeff_charpoly z j g
      change MvPolynomial.map (ρ g).toRingHom (P.coeff j) = P.coeff j at hg
      change ρ g ((P.coeff j).coeff e) = (P.coeff j).coeff e
      have hc : (MvPolynomial.map (ρ g).toRingHom (P.coeff j)).coeff e = (P.coeff j).coeff e :=
        congrArg (fun p : Aux ι k ↦ p.coeff e) hg
      rw [coeff_map] at hc
      exact hc
    · have hv : P.coeff j =
          ∑ s ∈ (Finset.univ : Finset G).powersetCard (m - j), ∏ g ∈ s, -(g • z) := by
        simpa only [P, MulSemiringAction.charpoly_eq, sub_eq_add_neg, ← map_neg,
          Finset.card_univ, m] using
          (Finset.prod_X_add_C_coeff (Finset.univ : Finset G) (fun g ↦ -(g • z)) hj.le)
      rw [hv, coeff_sum]
      apply IsHomogeneous.sum
      intro s hs
      rw [← (Finset.mem_powersetCard.mp hs).2]
      apply coeff_prod_isHomogeneous
      intro g _ d
      have hz : g • z = ∑ i : ι, C (ρ g (X i)) * X i := by
        change MvPolynomial.map (ρ g).toRingHom z = _
        simp [z]
      rw [hz, coeff_neg, coeff_sum]
      apply IsHomogeneous.neg
      apply IsHomogeneous.sum
      intro i _
      rw [coeff_C_mul, coeff_X]
      split
      · simpa using hρ g i
      · simp [isHomogeneous_zero]
  have he := MulSemiringAction.eval_charpoly G z
  change P.eval z = 0 at he
  rw [Polynomial.eval_eq_sum_range, hdeg, Finset.sum_range_succ, htop, one_mul] at he
  have hq := congrArg q he
  rw [map_add, map_sum, map_pow, map_zero] at hq
  have hs : (∑ j ∈ Finset.range m, q (P.coeff j * z ^ j)) = 0 := by
    apply Finset.sum_eq_zero
    intro j hj
    rw [map_mul, hcoeff j (Finset.mem_range.mp hj), zero_mul]
  rw [hs, zero_add] at hq
  simpa [q, z, m] using hq

private theorem coeff_auxiliaryForm_pow {R : Type*} [CommSemiring R] [Fintype ι]
    (x : ι → R) (a : ι →₀ ℕ) :
    ((∑ i : ι, C (x i) * X i) ^ a.degree).coeff a =
      (Nat.multinomial Finset.univ a : R) * ∏ i : ι, x i ^ a i := by
  classical
  rw [Finset.sum_pow_eq_sum_piAntidiag, coeff_sum]
  have he (b : ι → ℕ) :
      (∏ i : ι, (C (x i) * X i) ^ b i) =
        C (∏ i : ι, x i ^ b i) * ∏ i : ι, (X i : MvPolynomial ι R) ^ b i := by
    simp only [mul_pow, map_pow, Finset.prod_mul_distrib, map_prod]
  have hind (b : ι → ℕ) :
      a = Finsupp.indicator Finset.univ (fun i _ ↦ b i) ↔ (a : ι → ℕ) = b := by
    constructor
    · intro h
      funext i
      rw [congrArg (fun c : ι →₀ ℕ ↦ c i) h, Finsupp.indicator_apply, dite_eq_left (Finset.mem_univ i)]
    · intro h
      ext i
      simp [Finsupp.indicator_apply, congrFun h i]
  simp_rw [he, ← C_eq_coe_nat, ← mul_assoc, ← map_mul, coeff_C_mul, coeff_prod_X_pow, hind]
  rw [Finset.sum_eq_single_of_mem (a : ι → ℕ)]
  · simp
  · simp [Finset.mem_piAntidiag, Finsupp.degree_eq_sum]
  · intro b _ hb
    simp [Ne.symm hb]

private theorem factorial_ne_zero {m : ℕ} (h : ringChar k = 0 ∨ m < ringChar k) :
    (m.factorial : k) ≠ 0 := by
  rcases h with h | h
  · let : CharZero k := (CharP.ringChar_zero_iff_CharZero k).mp h
    exact Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  · induction m with
    | zero => simp
    | succ m ih =>
      rw [Nat.factorial_succ, Nat.cast_mul]
      exact mul_ne_zero ((ringChar.spec k _).not.mpr (Nat.not_dvd_of_pos_of_lt (Nat.succ_pos _) h))
        (ih (Nat.lt_of_succ_lt h))

/-- Every monomial of degree equal to the group order belongs to the bounded invariant ideal. -/
theorem monomial_mem_lowDegreeInvariantIdeal [Fintype G] [Fintype ι]
    (ρ : GroupAlgebraAction k G (MvPolynomial ι k))
    (hρ : ∀ g i, (ρ g (X i)).IsHomogeneous 1)
    (hchar : ringChar k = 0 ∨ Fintype.card G < ringChar k)
    (a : ι →₀ ℕ) (ha : a.degree = Fintype.card G) :
    monomial a (1 : k) ∈ lowDegreeInvariantIdeal ρ (Fintype.card G) := by
  classical
  let I := lowDegreeInvariantIdeal ρ (Fintype.card G)
  have hp := auxiliaryForm_pow_eq_zero ρ hρ
  dsimp only at hp
  change (∑ i : ι, C (Ideal.Quotient.mk I (X i)) * X i) ^ Fintype.card G = 0 at hp
  let y : MvPolynomial ι (MvPolynomial ι k ⧸ I) :=
    ∑ i : ι, C (Ideal.Quotient.mk I (X i)) * X i
  have hy : y ^ a.degree = 0 := (congrArg (y ^ ·) ha).trans hp
  have hc : (y ^ a.degree).coeff a = 0 := by
    rw [hy]
    rfl
  dsimp only [y] at hc
  rw [coeff_auxiliaryForm_pow] at hc
  simp_rw [← map_pow, ← map_prod] at hc
  have hprod : (∏ i : ι, (X i : MvPolynomial ι k) ^ a i) = monomial a 1 := by
    rw [monomial_eq, map_one, one_mul]
    exact (Finsupp.prod_fintype _ _ fun _ ↦ pow_zero _).symm
  rw [hprod] at hc
  let c := Nat.multinomial Finset.univ a
  change (c : MvPolynomial ι k ⧸ I) * Ideal.Quotient.mk I (monomial a 1) = 0 at hc
  have hfac := factorial_ne_zero (k := k) hchar
  have hmul := congrArg (Nat.cast : ℕ → k) (Nat.multinomial_spec Finset.univ a)
  rw [← Finsupp.degree_eq_sum, ha, Nat.cast_mul] at hmul
  have hcn : (c : k) ≠ 0 := by
    intro hzero
    change (_ : k) * (c : k) = _ at hmul
    rw [hzero, mul_zero] at hmul
    exact hfac hmul.symm
  apply (Ideal.Quotient.eq_zero_iff_mem).mp
  have hu : IsUnit (c : MvPolynomial ι k ⧸ I) := by
    simpa using (isUnit_iff_ne_zero.mpr hcn).map (algebraMap k (MvPolynomial ι k ⧸ I))
  exact hu.mul_right_inj.mp (hc.trans (mul_zero _).symm)

/-- All homogeneous pieces of degree at least the group order lie in the bounded invariant
ideal. -/
theorem homogeneous_mem_lowDegreeInvariantIdeal [Fintype G] [Fintype ι]
    (ρ : GroupAlgebraAction k G (MvPolynomial ι k))
    (hρ : ∀ g i, (ρ g (X i)).IsHomogeneous 1)
    (hchar : ringChar k = 0 ∨ Fintype.card G < ringChar k)
    (d : ℕ) (hd : Fintype.card G ≤ d) (p : MvPolynomial ι k) (hp : p.IsHomogeneous d) :
    p ∈ lowDegreeInvariantIdeal ρ (Fintype.card G) := by
  classical
  rw [p.as_sum]
  apply Submodule.sum_mem
  intro a ha
  have ha' : a.degree = d := by
    rw [Finsupp.degree_eq_weight_one]
    exact hp (mem_support_iff.mp ha)
  obtain ⟨b, hab, hb⟩ := a.exists_le_degree_eq (Fintype.card G) (ha' ▸ hd)
  obtain ⟨c, rfl⟩ := le_iff_exists_add.mp hab
  have hm := monomial_mem_lowDegreeInvariantIdeal ρ hρ hchar b hb
  simpa only [monomial_mul_monomial, one_mul] using
    Ideal.mul_mem_right (monomial c (p.coeff (b + c))) _ hm

end RepTheorySurvey.Invariants
