private theorem fixed_shortExact
    {k : Type*} {U V W : Type w} [Field k] [AddCommGroup U] [Module k U]
    [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
    {I : Submodule k U} {J : Submodule k V} {K : Submodule k W}
    {f : U →ₗ[k] V} {g : V →ₗ[k] W} {hf : I ≤ J.comap f} {hg : J ≤ K.comap g}
    (h : ShortExact f g) (reflect : ∀ x, f x ∈ J → x ∈ I)
    (lift : Function.Surjective (fixedMap J K g hg)) :
    ShortExact (fixedMap I J f hf) (fixedMap J K g hg) := by
  refine ⟨fun x y e ↦ Subtype.ext (h.1 (congrArg Subtype.val e)), ?_, lift⟩
  intro y
  change (fixedMap J K g hg y = 0) ↔ y ∈ Set.range (fixedMap I J f hf)
  constructor
  · intro hy
    obtain ⟨x, hx⟩ := (h.2.1 y.val).mp (congrArg Subtype.val hy)
    exact ⟨⟨x, reflect x (hx ▸ y.property)⟩, Subtype.ext hx⟩
  · rintro ⟨x, rfl⟩
    exact Subtype.ext ((h.2.1 (f x)).mpr ⟨x, rfl⟩)

private theorem postcomp_surjective {k U V W : Type*} [Field k]
    [AddCommGroup U] [Module k U] [AddCommGroup V] [Module k V]
    [AddCommGroup W] [Module k W] (g : V →ₗ[k] W) (hg : Function.Surjective g) :
    Function.Surjective ((LinearMap.llcomp k U V W g : (U →ₗ[k] V) →ₗ[k] (U →ₗ[k] W))) := by
  obtain ⟨s, hs⟩ := g.exists_rightInverse_of_surjective (LinearMap.range_eq_top.mpr hg)
  intro t
  refine ⟨s.comp t, ?_⟩
  ext x
  exact DFunLike.congr_fun hs (t x)

private theorem compl_range_of_quotient_section {k V : Type*} [Field k]
    [AddCommGroup V] [Module k V] (S : Submodule k V) (s : (V ⧸ S) →ₗ[k] V)
    (hs : S.mkQ.comp s = LinearMap.id) : IsCompl S (LinearMap.range s) := by
  refine ⟨Submodule.disjoint_def.mpr ?_, codisjoint_iff.mpr ?_⟩
  · intro x hx hx'
    obtain ⟨y, rfl⟩ := hx'
    have he : S.mkQ (s y) = y := DFunLike.congr_fun hs y
    have hz : S.mkQ (s y) = 0 := by
      rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    rw [hz] at he
    rw [← he, map_zero]
  · rw [eq_top_iff]
    intro x _
    have he : S.mkQ (s (S.mkQ x)) = S.mkQ x := DFunLike.congr_fun hs _
    refine Submodule.mem_sup.mpr ⟨x - s (S.mkQ x), ?_, s (S.mkQ x), ⟨_, rfl⟩, sub_add_cancel ..⟩
    have hz : S.mkQ (x - s (S.mkQ x)) = 0 := by rw [map_sub, he, sub_self]
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hz

open private Deviations.Stable Deviations.Simple
  from MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.CanonicalProjection

/-- Apply the semisimple-module decomposition to the algebra generated by the action. -/
private theorem decomposition_of_complements {k V ι : Type*} [Field k]
    [AddCommGroup V] [Module k V] [FiniteDimensional k V] (d : ι → Module.End k V)
    (complements : ∀ S, Deviations.Stable d S → ∃ T, Deviations.Stable d T ∧ IsCompl S T) :
    ∃ (n : ℕ) (S : Fin n → Submodule k V), (∀ i, Deviations.Simple d (S i)) ∧ DirectSum.IsInternal S := by
  classical
  let A := Algebra.adjoin k (Set.range d)
  let enlarge (S : Submodule k V) (h : Deviations.Stable d S) : Submodule A V :=
    { S.toAddSubmonoid with
      smul_mem' := fun a x hx ↦ by
        change (a : Module.End k V) x ∈ S
        refine Algebra.adjoin_induction (p := fun f _ ↦ ∀ y ∈ S, f y ∈ S)
          ?_ ?_ ?_ ?_ a.property x hx
        · rintro _ ⟨i, rfl⟩
          exact h i
        · exact fun r y hy ↦ S.smul_mem r hy
        · exact fun f g _ _ hf hg y hy ↦ S.add_mem (hf y hy) (hg y hy)
        · exact fun f g _ _ hf hg y hy ↦ hf _ (hg y hy) }
  have stable (S : Submodule A V) : Deviations.Stable d (S.restrictScalars k) :=
    fun i x hx ↦ S.smul_mem ⟨d i, Algebra.subset_adjoin ⟨i, rfl⟩⟩ hx
  let res := Submodule.restrictScalarsEmbedding k A V
  have : ComplementedLattice (Submodule A V) := ⟨fun S ↦ by
    obtain ⟨T, ht, hc⟩ := complements (S.restrictScalars k) (stable S)
    let T' := enlarge T ht
    refine ⟨T', ⟨?_, ?_⟩⟩
    · apply disjoint_iff.mpr
      apply res.injective
      change (S ⊓ T').restrictScalars k = (⊥ : Submodule A V).restrictScalars k
      rw [Submodule.restrictScalars_inf, Submodule.restrictScalars_bot]
      exact hc.disjoint.eq_bot
    · apply codisjoint_iff.mpr
      apply res.injective
      change (S ⊔ T').restrictScalars k = (⊤ : Submodule A V).restrictScalars k
      rw [Submodule.restrictScalars_sup, Submodule.restrictScalars_top]
      exact hc.sup_eq_top⟩
  have : IsSemisimpleModule A V := {}
  obtain ⟨s, hs, htop, ha⟩ := IsSemisimpleModule.exists_sSupIndep_sSup_simples_eq_top A V
  let T : s → Submodule A V := Subtype.val
  let S : s → Submodule k V := fun i ↦ (T i).restrictScalars k
  have hi : iSupIndep S := by
    intro i
    have h := (sSupIndep_iff s).mp hs i
    rw [disjoint_iff] at h ⊢
    change T i ⊓ (⨆ j, ⨆ (_ : j ≠ i), T j) = ⊥ at h
    simp only [S, ← Submodule.restrictScalars_iSup, ← Submodule.restrictScalars_inf,
      h, Submodule.restrictScalars_bot]
  have hS (i : s) : Deviations.Simple d (S i) := by
    have at_i := isSimpleModule_iff_isAtom.mp (ha i.val i.property)
    refine ⟨stable _, fun h ↦ at_i.ne_bot (res.injective h), ?_⟩
    intro R hR hst
    rcases at_i.le_iff.mp (show enlarge R hst ≤ T i from hR) with h | h
    · exact Or.inl (congrArg (Submodule.restrictScalars k) h)
    · exact Or.inr (congrArg (Submodule.restrictScalars k) h)
  have : Finite s := WellFoundedGT.finite_of_iSupIndep hi (fun i ↦ (hS i).2.1)
  let e := Finite.equivFin s
  refine ⟨_, S ∘ e.symm, fun i ↦ hS _, ?_⟩
  apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
  · exact hi.comp e.symm.injective
  · change (⨆ i, S (e.symm i)) = ⊤
    rw [e.symm.surjective.iSup_comp]
    change (⨆ i, (T i).restrictScalars k) = ⊤
    rw [← Submodule.restrictScalars_iSup]
    change (⨆ i : s, i.val).restrictScalars k = ⊤
    rw [← sSup_eq_iSup', htop]
    rfl

namespace GroupRepresentation

theorem locallyFinite_exact : GroupLocallyFiniteExact.{u,v,w} := by
  intro k G _ _ h U V W _ _ _ _ _ _ τ ρ σ hτ hρ hσ f g hf hg hseq
  apply fixed_shortExact hseq
  · intro x hx a
    exact hseq.1 ((hf.isIntertwining a x).trans (hx a))
  · intro y
    obtain ⟨x, hx⟩ := hseq.2.2 y.val
    obtain ⟨P, hP, _⟩ := canonicalProjection h ρ hρ
    obtain ⟨Q, hQ, _⟩ := canonicalProjection h σ hσ
    refine ⟨P x, Subtype.ext ?_⟩
    change g (P x : V) = y.val
    rw [← canonicalProjection_natural h ρ σ hρ hσ P Q hP hQ g hg x]
    exact congrArg Subtype.val (show Q (g x) = y by rw [hx]; exact hQ.2.1 y)

private theorem lift_fixed {k : Type u} {G : Type v} {V W : Type w}
    [Field k] [Group G] [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    [AddCommGroup W] [Module k W] [FiniteDimensional k W]
    (h : GroupExact (k := k) G (fun {V : Type w} _ _ _ ↦ FiniteDimensional k V))
    (ρ : Representation k G V) (σ : Representation k G W)
    (f : V →ₗ[k] W) (hf : ρ.IsIntertwiningMap σ f) (hs : Function.Surjective f) :
    Function.Surjective (fixedMap _ _ f (group_preserves_fixed hf)) := by
  let S : Subrepresentation ρ :=
    ⟨LinearMap.ker f, fun a x hx ↦ by
      change f (ρ a x) = 0
      rw [hf.isIntertwining, LinearMap.mem_ker.mp hx, map_zero]⟩
  exact (h S.toRepresentation ρ σ inferInstance inferInstance inferInstance
    S.toSubmodule.subtype f ⟨fun _ _ ↦ rfl⟩ hf
    ⟨S.toSubmodule.injective_subtype, f.exact_subtype_ker_map, hs⟩).2.2

private theorem split_surjection {k : Type u} {G : Type v} {V W : Type w}
    [Field k] [Group G] [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    [AddCommGroup W] [Module k W] [FiniteDimensional k W]
    (h : GroupExact (k := k) G (fun {V : Type w} _ _ _ ↦ FiniteDimensional k V))
    (ρ : Representation k G V) (σ : Representation k G W)
    (f : V →ₗ[k] W) (hf : ρ.IsIntertwiningMap σ f) (hs : Function.Surjective f) :
    ∃ s : W →ₗ[k] V, σ.IsIntertwiningMap ρ s ∧ f.comp s = LinearMap.id := by
  let p : (W →ₗ[k] V) →ₗ[k] (W →ₗ[k] W) := LinearMap.llcomp k W V W f
  have hp : (Representation.linHom σ ρ).IsIntertwiningMap (Representation.linHom σ σ) p := by
    constructor
    intro a t
    ext x
    simpa [p, Representation.linHom_apply] using hf.isIntertwining a (t (σ a⁻¹ x))
  have hid : (LinearMap.id : W →ₗ[k] W) ∈ (Representation.linHom σ σ).invariants :=
    (Representation.mem_linHom_invariants_iff_isIntertwining _).mpr ⟨fun _ _ ↦ rfl⟩
  obtain ⟨s, he⟩ := lift_fixed h _ _ p hp (postcomp_surjective f hs) ⟨_, hid⟩
  exact ⟨s, (Representation.mem_linHom_invariants_iff_isIntertwining _).mp s.property,
    congrArg Subtype.val he⟩

open private GroupRepresentation.deviation GroupRepresentation.stable_iff GroupRepresentation.simple_iff_atom
  from MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.CanonicalProjection

theorem finite_exact_converse : GroupFiniteExactConverse.{u,v,w} := by
  intro k G _ _ h V _ _ _ ρ
  have hc : ∀ S, Deviations.Stable (GroupRepresentation.deviation ρ) S → ∃ T, Deviations.Stable (GroupRepresentation.deviation ρ) T ∧ IsCompl S T := by
    intro S hS
    let P : Subrepresentation ρ := ⟨S, (GroupRepresentation.stable_iff ρ S).mp hS⟩
    have hq : ρ.IsIntertwiningMap P.quotient S.mkQ := ⟨fun _ _ ↦ rfl⟩
    obtain ⟨s, hs, hsplit⟩ := split_surjection h ρ P.quotient S.mkQ hq S.mkQ_surjective
    let T : Subrepresentation ρ := ⟨LinearMap.range s, fun a x hx ↦ by
      obtain ⟨y, rfl⟩ := hx
      exact ⟨P.quotient a y, hs.isIntertwining a y⟩⟩
    exact ⟨T.toSubmodule, (GroupRepresentation.stable_iff ρ _).mpr T.apply_mem_toSubmodule,
      compl_range_of_quotient_section S s hsplit⟩
  obtain ⟨n, S, hs, hi⟩ := decomposition_of_complements (GroupRepresentation.deviation ρ) hc
  let T (i : Fin n) : Subrepresentation ρ := ⟨S i, (GroupRepresentation.stable_iff ρ (S i)).mp (hs i).1⟩
  exact ⟨n, T, fun i ↦ (GroupRepresentation.simple_iff_atom ρ (T i)).mp (hs i), hi⟩

end GroupRepresentation

namespace RationalRepresentation

theorem exact_of_reductive : RationalExactOfReductive.{u} := by
  intro k _ H h U V W _ _ _ _ _ _ τ ρ σ _ _ _ f g hf hg hseq
  apply fixed_shortExact hseq
  · intro x hx
    apply (mem_rational_fixed τ x).mpr
    apply Module.Flat.rTensor_preserves_injective_linearMap f hseq.1
    have e : f.rTensor H (τ.coaction x) = ρ.coaction (f x) := DFunLike.congr_fun hf x
    rw [e, (mem_rational_fixed ρ _).mp hx, LinearMap.rTensor_tmul]
  · intro y
    obtain ⟨x, hx⟩ := hseq.2.2 y.val
    obtain ⟨P, hP, _⟩ := canonicalProjection h ρ
    obtain ⟨Q, hQ, _⟩ := canonicalProjection h σ
    refine ⟨P x, Subtype.ext ?_⟩
    change g (P x : V) = y.val
    rw [← canonicalProjection_natural h ρ σ P Q hP hQ g hg x]
    exact congrArg Subtype.val (show Q (g x) = y by rw [hx]; exact hQ.2.1 y)

section KernelsAndQuotients

variable {k V W : Type u} [Field k] {H : HopfAlgebraCategory k}
  [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]

open private RationalRepresentation.deviation RationalRepresentation.stable_iff
  RationalRepresentation.simple_iff RationalRepresentation.comoduleMap_iff_deviation
  RationalRepresentation.slice RationalRepresentation.slice_natural
  from MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.CanonicalProjection

private theorem kernel_stable {ρ : RightComodule k H V} {σ : RightComodule k H W}
    {f : V →ₗ[k] W} (hf : IsComoduleMap ρ σ f) : ρ.IsSubcomodule (LinearMap.ker f) := by
  apply (RationalRepresentation.stable_iff ρ _).mp
  intro l x hx
  change f (RationalRepresentation.deviation ρ l x) = 0
  rw [(RationalRepresentation.comoduleMap_iff_deviation f).mp hf, LinearMap.mem_ker.mp hx, map_zero]

private theorem range_stable {ρ : RightComodule k H V} {σ : RightComodule k H W}
    {f : V →ₗ[k] W} (hf : IsComoduleMap ρ σ f) : σ.IsSubcomodule (LinearMap.range f) := by
  apply (RationalRepresentation.stable_iff σ _).mp
  intro l y hy
  obtain ⟨x, rfl⟩ := hy
  exact ⟨_, (RationalRepresentation.comoduleMap_iff_deviation f).mp hf l x⟩

private theorem lift_fixed [FiniteDimensional k V] [FiniteDimensional k W]
    (h : RationalExact H (fun {V} _ _ _ ↦ FiniteDimensional k V))
    (ρ : RightComodule k H V) (σ : RightComodule k H W)
    (f : V →ₗ[k] W) (hf : IsComoduleMap ρ σ f) (hs : Function.Surjective f) :
    Function.Surjective (fixedMap _ _ f (rational_preserves_fixed hf)) := by
  obtain ⟨τ, hτ⟩ := (ρ.isSubcomodule_iff_exists_coaction (LinearMap.ker f)).mp (kernel_stable hf)
  exact (h τ ρ σ inferInstance inferInstance inferInstance (LinearMap.ker f).subtype f
    hτ hf ⟨(LinearMap.ker f).injective_subtype, f.exact_subtype_ker_map, hs⟩).2.2

private theorem quotient_coaction (ρ : RightComodule k H V) (S : Submodule k V)
    (hS : ρ.IsSubcomodule S) :
    ∃ σ : RightComodule k H (V ⧸ S), IsComoduleMap ρ σ S.mkQ := by
  let Q := V ⧸ S
  let q := S.mkQ
  let f := (q.rTensor H).comp ρ.coaction
  have hz : S ≤ LinearMap.ker f := by
    intro x hx
    obtain ⟨t, ht⟩ := hS ⟨x, hx⟩
    change q.rTensor H (ρ.coaction x) = 0
    change S.subtype.rTensor H t = ρ.coaction x at ht
    have hzero : q.comp S.subtype = 0 := by
      ext y
      exact (Submodule.Quotient.mk_eq_zero (p := S)).mpr y.property
    rw [← ht, ← LinearMap.rTensor_comp_apply, hzero]
    simp
  let δ := S.liftQ f hz
  have hδ (x : V) : δ (q x) = q.rTensor H (ρ.coaction x) := rfl
  have assoc_natural (t : (V ⊗[k] H) ⊗[k] H) :
      TensorProduct.assoc k Q H H ((q.rTensor H).rTensor H t) =
        q.rTensor (H ⊗[k] H) (TensorProduct.assoc k V H H t) := by
    simpa [LinearMap.rTensor] using
      (TensorProduct.map_map_assoc q (LinearMap.id : H →ₗ[k] H) LinearMap.id t).symm
  refine ⟨⟨δ, ?_, ?_⟩, LinearMap.ext fun x ↦ (hδ x).symm⟩
  · intro y
    obtain ⟨x, rfl⟩ := S.mkQ_surjective y
    change TensorProduct.assoc k Q H H (δ.rTensor H (δ (q x))) = _
    rw [hδ, ← LinearMap.rTensor_comp_apply,
      show δ.comp q = (q.rTensor H).comp ρ.coaction from LinearMap.ext hδ,
      LinearMap.rTensor_comp_apply, assoc_natural, ρ.coassoc]
    exact DFunLike.congr_fun
      ((LinearMap.rTensor_comp_lTensor V q (Coalgebra.comul (R := k))).trans
        (LinearMap.lTensor_comp_rTensor V q (Coalgebra.comul (R := k))).symm) _
  · intro y
    obtain ⟨x, rfl⟩ := S.mkQ_surjective y
    change RationalRepresentation.slice Coalgebra.counit (δ (q x)) = q x
    rw [hδ, ← RationalRepresentation.slice_natural]
    exact congrArg q (ρ.counit x)

end KernelsAndQuotients

section HomCoactions

open Matrix
open private RationalRepresentations.tensorCoordinate_tmul RationalRepresentations.tensor_eq_sum_basis
  RationalRepresentations.mul_antipode_matrix RationalRepresentations.antipode_mul_matrix
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Affine.RationalRepresentations

variable {k V W X ι ι' ι'' : Type u} [Field k] {H : HopfAlgebraCategory k}
  [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W] [AddCommGroup X] [Module k X]
  [Fintype ι] [DecidableEq ι] [Fintype ι'] [DecidableEq ι'] [Fintype ι''] [DecidableEq ι'']

private def scalarMatrix (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (f : V →ₗ[k] W) : Matrix ι' ι H :=
  (LinearMap.toMatrix b c f).map (algebraMap k H)

omit [DecidableEq ι'] in
private theorem scalarMatrix_apply (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (f : V →ₗ[k] W) (i : ι') (j : ι) :
    scalarMatrix (H := H) b c f i j = algebraMap k H (c.coord i (f (b j))) := by
  simp [scalarMatrix, LinearMap.toMatrix_apply', Module.Basis.coord_apply]

omit [DecidableEq ι''] in
private theorem scalarMatrix_comp (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (d : Module.Basis ι'' k X) (g : W →ₗ[k] X) (f : V →ₗ[k] W) :
    scalarMatrix (H := H) b d (g.comp f) =
      scalarMatrix (H := H) c d g * scalarMatrix (H := H) b c f := by
  unfold scalarMatrix
  rw [LinearMap.toMatrix_comp b c d]
  exact Matrix.map_mul

omit [DecidableEq ι] in
private theorem tensor_coordinates_injective (b : Module.Basis ι k V)
    {t s : V ⊗[k] H} (he : ∀ i, tensorCoordinate b i t = tensorCoordinate b i s) :
    t = s := by
  rw [← RationalRepresentations.tensor_eq_sum_basis b t,
    ← RationalRepresentations.tensor_eq_sum_basis b s]
  simp only [he]

omit [DecidableEq ι'] in
private theorem matrix_intertwining (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (ρ : RightComodule k H V) (σ : RightComodule k H W) (f : V →ₗ[k] W) :
    IsComoduleMap ρ σ f ↔
      scalarMatrix (H := H) b c f * coefficients H b ρ =
        coefficients H c σ * scalarMatrix (H := H) b c f := by
  have lhs (i j) :
      tensorCoordinate c i (f.rTensor H (ρ.coaction (b j))) =
        (scalarMatrix (H := H) b c f * coefficients H b ρ) i j := by
    rw [coaction_apply_basis, map_sum, map_sum, Matrix.mul_apply]
    simp [scalarMatrix, LinearMap.toMatrix_apply, Module.Basis.coord_apply, Algebra.smul_def,
      RationalRepresentations.tensorCoordinate_tmul]
  have rhs (i j) :
      tensorCoordinate c i (σ.coaction (f (b j))) =
        (coefficients H c σ * scalarMatrix (H := H) b c f) i j := by
    conv_lhs => rw [← c.sum_repr (f (b j))]
    simp only [map_sum, map_smul, coefficients, Matrix.mul_apply, scalarMatrix,
      Matrix.map_apply, LinearMap.toMatrix_apply, Algebra.smul_def]
    exact Finset.sum_congr rfl fun _ _ ↦ mul_comm _ _
  constructor
  · intro h
    ext i j
    rw [← lhs, ← rhs]
    exact congrArg _ (DFunLike.congr_fun h (b j))
  · intro h
    apply b.ext
    intro j
    apply tensor_coordinates_injective c
    intro i
    rw [LinearMap.comp_apply, LinearMap.comp_apply, lhs, rhs, h]

private def homCoordinates (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (t : (Module.Dual k V ⊗[k] W) ⊗[k] H) : Matrix ι' ι H :=
  fun i j ↦ tensorCoordinate (k := k) (V := Module.Dual k V ⊗[k] W) (b.dualBasis.tensorProduct c) (j, i) t

omit [DecidableEq ι'] in
private theorem homCoordinates_injective (b : Module.Basis ι k V) (c : Module.Basis ι' k W) :
    Function.Injective (homCoordinates (H := H) b c) := by
  intro t s h
  exact tensor_coordinates_injective (k := k) (V := Module.Dual k V ⊗[k] W) (b.dualBasis.tensorProduct c)
    (fun ⟨j, i⟩ ↦ congr_fun (congr_fun h i) j)

omit [Fintype ι'] [DecidableEq ι'] in
private theorem homCoordinates_tmul (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (t : Module.Dual k V ⊗[k] W) (a : H) (i : ι') (j : ι) :
    homCoordinates b c (t ⊗ₜ[k] a) i j =
      algebraMap k H (c.coord i (dualTensorHom k V W t (b j))) * a := by
  rw [homCoordinates, RationalRepresentations.tensorCoordinate_tmul, Algebra.smul_def]
  congr 2
  induction t using TensorProduct.inductionOn with
  | tmul φ x => simp [Module.Basis.coord_apply, Module.Basis.tensorProduct_repr_tmul_apply, mul_comm]
  | add x y hx hy => simp only [map_add, LinearMap.add_apply, hx, hy]

private theorem dualTensorHom_postcomp (f : W →ₗ[k] X) (t : Module.Dual k V ⊗[k] W) :
    dualTensorHom k V X (f.lTensor (Module.Dual k V) t) =
      f.comp (dualTensorHom k V W t) := by
  induction t using TensorProduct.inductionOn with
  | tmul φ x => ext y; simp
  | add x y hx hy => simp [hx, hy, LinearMap.comp_add]

private theorem homCoordinates_postcomp (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (d : Module.Basis ι'' k X) (f : W →ₗ[k] X)
    (s : (Module.Dual k V ⊗[k] W) ⊗[k] H) :
    homCoordinates b d ((f.lTensor (Module.Dual k V)).rTensor H s) =
      scalarMatrix (H := H) c d f * homCoordinates b c s := by
  induction s using TensorProduct.inductionOn with
  | tmul t a =>
    ext i j
    rw [LinearMap.rTensor_tmul, homCoordinates_tmul, dualTensorHom_postcomp]
    rw [← scalarMatrix_apply b d, scalarMatrix_comp b c d, Matrix.mul_apply, Finset.sum_mul,
      Matrix.mul_apply]
    simp only [homCoordinates_tmul, mul_assoc, scalarMatrix_apply]
  | add x y hx hy =>
    have hadd {Y η : Type u} [AddCommGroup Y] [Module k Y] [Fintype η] [DecidableEq η]
        (d' : Module.Basis η k Y) (t₁ t₂ : (Module.Dual k V ⊗[k] Y) ⊗[k] H) :
        homCoordinates b d' (t₁ + t₂) = homCoordinates b d' t₁ + homCoordinates b d' t₂ := by
      ext i j; exact map_add (tensorCoordinate (k := k) (V := Module.Dual k V ⊗[k] Y) (b.dualBasis.tensorProduct d') (j,i)) t₁ t₂
    rw [map_add, hadd, hadd, hx, hy, Matrix.mul_add]

private theorem hom_tensor_coactions (b : Module.Basis ι k V) (c : Module.Basis ι' k W)
    (d : Module.Basis ι'' k X)
    (ρ : RightComodule k H V) (σ : RightComodule k H W) (τ : RightComodule k H X)
    (f : W →ₗ[k] X) (hf : IsComoduleMap σ τ f) :
    ∃ (S : RightComodule k H (Module.Dual k V ⊗[k] W))
      (T : RightComodule k H (Module.Dual k V ⊗[k] X)),
      IsComoduleMap S T (f.lTensor (Module.Dual k V)) ∧
      (∀ s, s ∈ invariants H S ↔ IsComoduleMap ρ σ (dualTensorHom k V W s)) ∧
      (∀ t, t ∈ invariants H T ↔ IsComoduleMap ρ τ (dualTensorHom k V X t)) := by
  obtain ⟨D, hD⟩ := dualComparison H b ρ
  obtain ⟨S, hS⟩ := tensorProductComparison H b.dualBasis c D σ
  obtain ⟨T, hT⟩ := tensorProductComparison H b.dualBasis d D τ
  let B := coefficients H b ρ
  let B' := (HopfAlgebra.antipodeAlgHom k H).mapMatrix B
  have inv_right : B * B' = 1 := RationalRepresentations.mul_antipode_matrix H B
    (coefficients_isCoactionMatrix H b ρ)
  have inv_left : B' * B = 1 := RationalRepresentations.antipode_mul_matrix H B
    (coefficients_isCoactionMatrix H b ρ)
  have formula {Y η : Type u} [AddCommGroup Y] [Module k Y] [Fintype η] [DecidableEq η]
      (e : Module.Basis η k Y) (μ : RightComodule k H Y)
      (P : RightComodule k H (Module.Dual k V ⊗[k] Y))
      (hP : ∀ i j, coefficients H (b.dualBasis.tensorProduct e) P i j =
        coefficients H b.dualBasis D i.1 j.1 * coefficients H e μ i.2 j.2)
      (s : Module.Dual k V ⊗[k] Y) :
      homCoordinates b e (P.coaction s) =
        coefficients H e μ * homCoordinates b e (s ⊗ₜ[k] (1 : H)) * B' := by
    let E : Module.Basis (ι × η) k (Module.Dual k V ⊗[k] Y) := b.dualBasis.tensorProduct e
    ext i j
    change tensorCoordinate (V := Module.Dual k V ⊗[k] Y) E (j,i) (P.coaction s) = _
    conv_lhs => rw [← E.sum_repr s]
    simp only [map_sum, map_smul]
    change (∑ r, E.repr s r • coefficients H E P (j,i) r) = _
    simp only [Matrix.mul_apply, Finset.sum_mul, Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro l _
    apply Finset.sum_congr rfl
    intro m _
    dsimp only [E]
    rw [hP, hD]
    change E.repr s (l,m) •
        (HopfAlgebra.antipode k (B l j) * coefficients H e μ i m) =
      coefficients H e μ i m * homCoordinates b e (s ⊗ₜ[k] (1 : H)) m l * B' l j
    rw [homCoordinates, RationalRepresentations.tensorCoordinate_tmul, Algebra.smul_def,
      Algebra.smul_def, mul_one, Module.Basis.coord_apply]
    change _ = _ * HopfAlgebra.antipode k (B l j)
    ac_rfl
  have invariant_iff {Y η : Type u} [AddCommGroup Y] [Module k Y] [Fintype η] [DecidableEq η]
      (e : Module.Basis η k Y) (μ : RightComodule k H Y)
      (P : RightComodule k H (Module.Dual k V ⊗[k] Y))
      (hP : ∀ i j, coefficients H (b.dualBasis.tensorProduct e) P i j =
        coefficients H b.dualBasis D i.1 j.1 * coefficients H e μ i.2 j.2)
      (s : Module.Dual k V ⊗[k] Y) :
      s ∈ invariants H P ↔ IsComoduleMap ρ μ (dualTensorHom k V Y s) := by
    rw [mem_rational_fixed, ← (homCoordinates_injective b e).eq_iff, formula e μ P hP,
      matrix_intertwining b e]
    have hs : homCoordinates b e (s ⊗ₜ[k] (1 : H)) =
        scalarMatrix (H := H) b e (dualTensorHom k V Y s) := by
      ext i j
      simp [homCoordinates_tmul, scalarMatrix, LinearMap.toMatrix_apply']
    rw [hs]
    let F := scalarMatrix (H := H) b e (dualTensorHom k V Y s)
    change coefficients H e μ * F * B' = F ↔ F * B = coefficients H e μ * F
    constructor
    · intro h
      simpa [Matrix.mul_assoc, inv_left] using (congrArg (· * B) h).symm
    · intro h
      rw [← h, Matrix.mul_assoc, inv_right, Matrix.mul_one]
  refine ⟨S, T, ?_, invariant_iff c σ S hS, invariant_iff d τ T hT⟩
  apply LinearMap.ext
  intro s
  apply homCoordinates_injective b d
  simp only [LinearMap.comp_apply]
  rw [homCoordinates_postcomp b c d, formula c σ S hS, formula d τ T hT,
    ← LinearMap.rTensor_tmul, homCoordinates_postcomp b c d]
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, (matrix_intertwining c d σ τ f).mp hf]
  simp only [Matrix.mul_assoc]

private theorem split_surjection {k V W : Type u} [Field k] {H : HopfAlgebraCategory k}
    [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    [AddCommGroup W] [Module k W] [FiniteDimensional k W]
    (h : RationalExact H (fun {V} _ _ _ ↦ FiniteDimensional k V))
    (ρ : RightComodule k H V) (σ : RightComodule k H W)
    (f : V →ₗ[k] W) (hf : IsComoduleMap ρ σ f) (hs : Function.Surjective f) :
    ∃ s : W →ₗ[k] V, IsComoduleMap σ ρ s ∧ f.comp s = LinearMap.id := by
  classical
  let b := (Module.finBasis k W).reindex Equiv.ulift.{u}.symm
  let c := (Module.finBasis k V).reindex Equiv.ulift.{u}.symm
  obtain ⟨S, T, hp, hS, hT⟩ := hom_tensor_coactions b c b σ ρ σ f hf
  let p := f.lTensor (Module.Dual k W)
  let idTensor := (dualTensorHomEquiv k W W).symm LinearMap.id
  have hid : idTensor ∈ invariants H T := by
    apply (hT _).mpr
    simp [idTensor, IsComoduleMap, Specs.isComoduleMap]
  obtain ⟨s, he⟩ := lift_fixed h S T p hp (LinearMap.lTensor_surjective _ hs) ⟨_, hid⟩
  let s' := dualTensorHom k W V s.val
  refine ⟨s', (hS s.val).mp s.property, ?_⟩
  have hp' : p s.val = idTensor := congrArg Subtype.val he
  have he' := dualTensorHom_postcomp f s.val
  change dualTensorHom k W W (p s.val) = f.comp s' at he'
  rw [← he', hp']
  simp [idTensor]

open private RationalRepresentation.deviation RationalRepresentation.stable_iff
  RationalRepresentation.simple_iff from MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.CanonicalProjection

theorem finite_exact_converse : RationalFiniteExactConverse.{u} := by
  intro k _ H h V _ _ _ ρ
  have hc : ∀ S, Deviations.Stable (RationalRepresentation.deviation ρ) S →
      ∃ T, Deviations.Stable (RationalRepresentation.deviation ρ) T ∧ IsCompl S T := by
    intro S hS
    obtain ⟨σ, hσ⟩ := quotient_coaction ρ S ((RationalRepresentation.stable_iff ρ S).mp hS)
    obtain ⟨s, hs, hsplit⟩ := split_surjection h ρ σ S.mkQ hσ S.mkQ_surjective
    exact ⟨LinearMap.range s, (RationalRepresentation.stable_iff ρ _).mpr (range_stable hs),
      compl_range_of_quotient_section S s hsplit⟩
  obtain ⟨n, S, hs, hi⟩ := decomposition_of_complements (RationalRepresentation.deviation ρ) hc
  exact ⟨n, S, fun i ↦ (RationalRepresentation.simple_iff ρ (S i)).mp (hs i), hi⟩

end HomCoactions

end RationalRepresentation

section Geometry

open RationalActionComparison
open private GroupRepresentation.deviation GroupRepresentation.stable_iff
  GroupRepresentation.simple_iff_atom RationalRepresentation.deviation RationalRepresentation.stable_iff
  RationalRepresentation.simple_iff from MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Invariants.CanonicalProjection

variable {k : Type u} [Field k] [IsAlgClosed k] {G : GroupScheme k}
  [LocallyOfFiniteType G.X.hom] [QuasiCompact G.X.hom] [Smooth G.X.hom]
  {H : GlobalFunctions.Specs.GlobalHopf G}

private def PointComparison (G : GroupScheme k) (H : GlobalFunctions.Specs.GlobalHopf G) :=
  ∀ (V : Type u) [AddCommGroup V] [Module k V],
    {e : RightComodule k H.hopf V ≃ {r : Representation k (KPoints G) V // HasRegularOrbits r} //
      ∀ d, ActsBy H d (e d).val}

private def pointComparison (a : G ⟶ H.spectrum)
    (ha : a.hom.hom = GlobalFunctions.unit G.X) : PointComparison G H :=
  fun V _ _ ↦ ⟨(linearComparison (V := V) G H a ha).choose,
    (linearComparison (V := V) G H a ha).choose_spec⟩

omit [QuasiCompact G.X.hom] in
private theorem simple_comparison {V : Type u} [AddCommGroup V] [Module k V]
    {r : Representation k (KPoints G) V} {d : RightComodule k H.hopf V}
    (hd : ActsBy H d r) (S : Subrepresentation r) :
    IsAtom S ↔ Specs.rationalIsSimpleSubcomodule d S.toSubmodule := by
  change IsAtom S ↔ RationalRepresentation.IsSimpleSubcomodule d S.toSubmodule
  rw [← GroupRepresentation.simple_iff_atom, ← RationalRepresentation.simple_iff]
  have hs (T : Submodule k V) :
      Deviations.Stable (GroupRepresentation.deviation r) T ↔
        Deviations.Stable (RationalRepresentation.deviation d) T := by
    rw [GroupRepresentation.stable_iff, RationalRepresentation.stable_iff]
    simpa only [Subtype.forall] using stableSubspaces G H d r T hd
  simp only [Deviations.Simple, hs]

omit [QuasiCompact G.X.hom] in
private theorem reductive_comparison (cmp : PointComparison G H) :
    RegularLinearlyReductive G ↔ Specs.rationalLinearlyReductive H.hopf := by
  constructor
  · intro h V _ _ _ d
    let e := cmp V
    obtain ⟨n, S, hs, hi⟩ := h V (e.val d).val (e.val d).property
    exact ⟨n, fun i ↦ (S i).toSubmodule, fun i ↦ (simple_comparison (e.property d) (S i)).mp (hs i), hi⟩
  · intro h V _ _ _ r hr
    let e := cmp V
    let d := e.val.symm ⟨r, hr⟩
    have hd : ActsBy H d r := by
      simpa [d] using e.property d
    obtain ⟨n, S, hs, hi⟩ := h V d
    let T (i : Fin n) : Subrepresentation r :=
      (subrepresentationOrderIso H d r hd).symm ⟨S i, (hs i).1⟩
    exact ⟨n, T, fun i ↦ (simple_comparison hd (T i)).mpr (hs i), hi⟩

omit [IsAlgClosed k] in
private theorem fixed_exact_congr {U V W : Type u}
    [AddCommGroup U] [Module k U] [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
    {I I' : Submodule k U} {J J' : Submodule k V} {K K' : Submodule k W}
    (hI : I = I') (hJ : J = J') (hK : K = K')
    {f : U →ₗ[k] V} {g : V →ₗ[k] W} {hf : I ≤ J.comap f} {hg : J ≤ K.comap g}
    {hf' : I' ≤ J'.comap f} {hg' : J' ≤ K'.comap g} :
    ShortExact (fixedMap _ _ f hf) (fixedMap _ _ g hg) ↔
      ShortExact (fixedMap _ _ f hf') (fixedMap _ _ g hg') := by
  subst I' J' K'
  rfl

omit [QuasiCompact G.X.hom] in
private theorem exact_comparison (cmp : PointComparison G H)
    (F : ∀ (V : Type u) [AddCommGroup V] [Module k V], Prop) :
    GroupExact (k := k) (KPoints G) (fun {V} _ _ r ↦ F V ∧ HasRegularOrbits r) ↔
      RationalExact H.hopf (fun {V} _ _ _ ↦ F V) := by
  constructor
  · intro h U V W _ _ _ _ _ _ τ ρ σ hτ hρ hσ f g hf hg hseq
    let eU := cmp U
    let eV := cmp V
    let eW := cmp W
    have hf' := (equivariantMaps G H τ ρ (eU.val τ).val (eV.val ρ).val f
      (eU.property τ) (eV.property ρ)).mpr hf
    have hg' := (equivariantMaps G H ρ σ (eV.val ρ).val (eW.val σ).val g
      (eV.property ρ) (eW.property σ)).mpr hg
    exact (fixed_exact_congr (invariantSubspaces G H _ _ (eU.property τ))
      (invariantSubspaces G H _ _ (eV.property ρ))
      (invariantSubspaces G H _ _ (eW.property σ))).mp
        (h _ _ _ ⟨hτ, (eU.val τ).property⟩ ⟨hρ, (eV.val ρ).property⟩
          ⟨hσ, (eW.val σ).property⟩ f g hf' hg' hseq)
  · intro h U V W _ _ _ _ _ _ τ ρ σ hτ hρ hσ f g hf hg hseq
    let eU := cmp U
    let eV := cmp V
    let eW := cmp W
    let τ' := eU.val.symm ⟨τ, hτ.2⟩
    let ρ' := eV.val.symm ⟨ρ, hρ.2⟩
    let σ' := eW.val.symm ⟨σ, hσ.2⟩
    have hU : ActsBy H τ' τ := by simpa [τ'] using eU.property τ'
    have hV : ActsBy H ρ' ρ := by simpa [ρ'] using eV.property ρ'
    have hW : ActsBy H σ' σ := by simpa [σ'] using eW.property σ'
    have hf' := (equivariantMaps G H τ' ρ' τ ρ f hU hV).mp hf
    have hg' := (equivariantMaps G H ρ' σ' ρ σ g hV hW).mp hg
    exact (fixed_exact_congr (invariantSubspaces G H _ _ hU)
      (invariantSubspaces G H _ _ hV) (invariantSubspaces G H _ _ hW)).mpr
        (h _ _ _ hτ.1 hρ.1 hσ.1 f g hf' hg' hseq)

theorem regularComparison : RegularComparison.{u} := by
  intro k _ _ G _ _ _ H a ha
  let cmp := pointComparison a ha
  refine ⟨reductive_comparison cmp, ?_, exact_comparison cmp (fun V _ _ ↦ FiniteDimensional k V)⟩
  simpa only [RegularlyExact, GroupExact, true_and] using exact_comparison cmp (fun _ _ _ ↦ True)

theorem regularExactCharacterization : RegularExactCharacterization.{u} := by
  intro k _ _ G _ _ _
  obtain ⟨H, a, ha, _⟩ := GlobalFunctions.globalHopfExists G
  obtain ⟨hred, hexact, hfinite⟩ := regularComparison G H a ha
  exact ⟨fun h ↦ hexact.mpr (RationalRepresentation.exact_of_reductive H.hopf (hred.mp h)),
    fun h ↦ hred.mpr (RationalRepresentation.finite_exact_converse H.hopf (hfinite.mp h))⟩

omit [QuasiCompact G.X.hom] in
private theorem projection_behavior_comparison {V : Type u} [AddCommGroup V] [Module k V]
    {r : Representation k (KPoints G) V} {d : RightComodule k H.hopf V}
    (hd : ActsBy H d r) {P : V →ₗ[k] r.invariants}
    {Q : V →ₗ[k] invariants H.hopf d} (hPQ : ∀ x, (P x : V) = (Q x : V)) :
    Specs.HasGroupProjectionBehavior r P ↔ Specs.HasRationalProjectionBehavior d Q := by
  have hi := invariantSubspaces G H d r hd
  constructor
  · intro h
    refine ⟨fun x ↦ Subtype.ext ?_, ?_⟩
    · rw [← hPQ]
      exact congrArg Subtype.val (h.1 ⟨x.val, hi.symm ▸ x.property⟩)
    · intro S hs hnontrivial x
      let T := (subrepresentationOrderIso H d r hd).symm ⟨S, hs.1⟩
      have hT : IsAtom T := (simple_comparison hd T).mpr hs
      have hT' : ¬ T.toSubmodule ≤ r.invariants := by
        rw [hi]
        exact hnontrivial
      apply Subtype.ext
      rw [← hPQ]
      exact congrArg Subtype.val (h.2 T hT hT' x)
  · intro h
    refine ⟨fun x ↦ Subtype.ext ?_, ?_⟩
    · rw [hPQ]
      exact congrArg Subtype.val (h.1 ⟨x.val, hi ▸ x.property⟩)
    · intro S hs hnontrivial x
      have hS := (simple_comparison hd S).mp hs
      rw [hi] at hnontrivial
      apply Subtype.ext
      rw [hPQ]
      exact congrArg Subtype.val (h.2 _ hS hnontrivial x)

omit [QuasiCompact G.X.hom] in
private theorem projection_comparison {V : Type u} [AddCommGroup V] [Module k V]
    {r : Representation k (KPoints G) V} {d : RightComodule k H.hopf V}
    (hd : ActsBy H d r) {P : V →ₗ[k] r.invariants}
    {Q : V →ₗ[k] invariants H.hopf d} (hPQ : ∀ x, (P x : V) = (Q x : V)) :
    Specs.IsGroupProjection r P ↔ Specs.IsRationalProjection d Q := by
  have ht : ActsBy H (Specs.rationalTrivial (V := invariants H.hopf d) H.hopf)
      (Representation.trivial k (KPoints G) (invariants H.hopf d)) := by
    intro g x
    simp [contract, Specs.rationalTrivial]
  have he := equivariantMaps G H d _ r _ Q hd ht
  refine and_congr ?_ (projection_behavior_comparison hd hPQ)
  rw [← he]
  constructor
  · intro h
    constructor
    intro g x
    apply Subtype.ext
    simp only [Representation.trivial_apply, ← hPQ]
    exact congrArg Subtype.val (h.isIntertwining g x)
  · intro h
    constructor
    intro g x
    apply Subtype.ext
    simp only [Representation.trivial_apply, hPQ]
    exact congrArg Subtype.val (h.isIntertwining g x)

theorem regularProjection : RegularProjection.{u} := by
  intro k V _ _ _ _ G _ _ _ h r hr
  obtain ⟨H, a, ha, _⟩ := GlobalFunctions.globalHopfExists G
  let cmp := pointComparison a ha
  let e := cmp V
  let d := e.val.symm ⟨r, hr⟩
  have hd : ActsBy H d r := by simpa [d] using e.property d
  obtain ⟨Q, hQ, unique⟩ := RationalRepresentation.canonicalProjection
    ((reductive_comparison cmp).mp h) d
  have hi := invariantSubspaces G H d r hd
  let eqInv := LinearEquiv.ofEq r.invariants (invariants H.hopf d) hi
  let P := eqInv.symm.toLinearMap.comp Q
  have same (x : V) : (P x : V) = (Q x : V) := by
    change ((eqInv.symm (Q x)) : V) = _
    rw [show eqInv.symm = LinearEquiv.ofEq _ _ hi.symm from LinearEquiv.ofEq_symm hi]
    exact LinearEquiv.coe_ofEq_apply hi.symm (Q x)
  refine ⟨P, (projection_comparison hd same).mpr hQ, ?_⟩
  intro P' hP'
  let Q' := eqInv.toLinearMap.comp P'
  have same' (x : V) : (P' x : V) = (Q' x : V) := (LinearEquiv.coe_ofEq_apply hi (P' x)).symm
  have eq := unique Q' ((projection_behavior_comparison hd same').mp hP')
  ext x
  rw [same' x, same x, eq]

theorem regularProjection_natural : RegularProjectionNatural.{u} := by
  intro k V W _ _ _ _ _ _ G _ _ _ h r s hr hs P Q hP hQ f hf x
  obtain ⟨H, a, ha, _⟩ := GlobalFunctions.globalHopfExists G
  let cmp := pointComparison a ha
  let e := cmp V
  let e' := cmp W
  let d := e.val.symm ⟨r, hr⟩
  let d' := e'.val.symm ⟨s, hs⟩
  have hd : ActsBy H d r := by simpa [d] using e.property d
  have hd' : ActsBy H d' s := by simpa [d'] using e'.property d'
  have hi := invariantSubspaces G H d r hd
  have hi' := invariantSubspaces G H d' s hd'
  let P' := (LinearEquiv.ofEq _ _ hi).toLinearMap.comp P
  let Q' := (LinearEquiv.ofEq _ _ hi').toLinearMap.comp Q
  have hp (y : V) : (P y : V) = (P' y : V) := (LinearEquiv.coe_ofEq_apply hi (P y)).symm
  have hq (y : W) : (Q y : W) = (Q' y : W) := (LinearEquiv.coe_ofEq_apply hi' (Q y)).symm
  rw [hp, hq]
  exact RationalRepresentation.canonicalProjection_natural ((reductive_comparison cmp).mp h)
    d d' P' Q' ((projection_comparison hd hp).mp hP) ((projection_comparison hd' hq).mp hQ) f
    ((equivariantMaps G H d d' r s f hd hd').mp hf) x

theorem regularProjection_reynolds : RegularProjectionReynolds.{u} := by
  intro k A _ _ _ _ G _ _ _ h ρ hρ P hP
  refine ⟨hP.1, ?_, hP.2.1⟩
  intro a x
  let f : A →ₗ[k] A := Algebra.lmul k A (a : A)
  let σ := Specs.groupRepresentation ρ
  have hf : σ.IsIntertwiningMap σ f := by
    constructor
    intro g y
    change (a : A) * ρ g y = ρ g ((a : A) * y)
    rw [map_mul, show ρ g (a : A) = (a : A) from a.property g]
  apply Subtype.ext
  exact regularProjection_natural G h σ σ hρ hρ P P hP hP f hf x

end Geometry

namespace ExactInvariants

theorem abstractGroup : AbstractGroupProposition.{u,v,w,z} :=
  ⟨GroupRepresentation.canonicalProjection, GroupRepresentation.canonicalProjection_natural,
    GroupRepresentation.canonicalProjection_reynolds, GroupRepresentation.locallyFinite_exact,
    GroupRepresentation.finite_exact_converse⟩

theorem rational : RationalProposition.{u} :=
  ⟨RationalRepresentation.canonicalProjection, RationalRepresentation.canonicalProjection_natural,
    RationalRepresentation.canonicalProjection_reynolds, RationalRepresentation.exact_of_reductive,
    RationalRepresentation.finite_exact_converse⟩

theorem smoothAlgebraicGroup : SmoothGroupProposition.{u} :=
  ⟨regularProjection, regularProjection_natural, regularProjection_reynolds,
    regularExactCharacterization⟩

end ExactInvariants



end

