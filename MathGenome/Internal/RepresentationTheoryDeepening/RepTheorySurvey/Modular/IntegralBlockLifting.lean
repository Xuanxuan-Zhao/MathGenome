import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Modular.GroupAlgebraCenter
import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Modular.GroupAlgebraReduction
import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Modular.IdempotentLifting
import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Modular.ModularBlocks
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.IntegralBlockLifting

/-! Central reduction and integral block lifting for a splitting system. -/

namespace RepTheorySurvey.Modular

open Ideal.Quotient
open GroupAlgebraCenter (centerClassEquiv centerClassEquiv_apply_mk)

universe uO uG uK uI

local notation "Z[" R "," G "]" => Subalgebra.center R (MonoidAlgebra R G)

variable (O : Type uO) [CommRing O] (G : Type uG) [Group G]

/-- Coefficient reduction on the center. -/
noncomputable abbrev centerReduction [IsLocalRing O] :
    Z[O,G] →+* Z[IsLocalRing.ResidueField O,G] :=
  GroupAlgebraCenter.mapCenter (IsLocalRing.residue O)

/-- The ideal generated by the indicated scalar in the center. -/
noncomputable abbrev centerUniformizerIdeal (t : O) : Ideal Z[O,G] :=
  MR08IntegralSpec.centerUniformizerIdealValue O G t

@[simp] theorem centerReduction_val [IsLocalRing O] (z : Z[O,G]) :
    (centerReduction O G z).val = groupAlgebraReduction O G z.val := rfl

variable [Finite G]

/-- Every modular class coefficient can be lifted independently. -/
theorem centerReduction_surjective [IsLocalRing O] :
    Function.Surjective (centerReduction O G) := by
  let := Fintype.ofFinite G
  let k := IsLocalRing.ResidueField O
  intro z
  choose a ha using fun C : ConjClasses G => IsLocalRing.residue_surjective (centerClassEquiv k z C)
  refine ⟨(centerClassEquiv O).symm a, (centerClassEquiv k).injective ?_⟩
  funext C
  change centerClassEquiv k (GroupAlgebraCenter.mapCenter (IsLocalRing.residue O)
    ((centerClassEquiv O).symm a)) C = centerClassEquiv k z C
  rw [GroupAlgebraCenter.centerClassEquiv_mapCenter, LinearEquiv.apply_symm_apply, ha]

/-- The powers of the scalar principal ideal in the center are the restrictions
of the corresponding powers in the full group algebra. -/
theorem mem_centerUniformizerIdeal_pow (t : O) (n : ℕ) (z : Z[O,G]) :
    z ∈ centerUniformizerIdeal O G t ^ n ↔
      z.val ∈ groupAlgebraUniformizerIdeal O G t ^ n := by
  let := Fintype.ofFinite G
  let e := centerClassEquiv (G := G) O
  have hmul (a : Z[O,G]) (C : ConjClasses G) :
      e (a * algebraMap O Z[O,G] (t ^ n)) C = e a C * t ^ n := by
    rw [mul_comm a, ← Algebra.smul_def, e.map_smul]
    exact mul_comm _ _
  rw [mem_groupAlgebraUniformizerIdeal_pow]
  change z ∈ (Ideal.span {algebraMap O Z[O,G] t}) ^ n ↔ _
  rw [Ideal.span_singleton_pow, ← map_pow, Ideal.span_singleton_pow]
  simp only [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨a, rfl⟩ g
    refine ⟨e a (ConjClasses.mk g), ?_⟩
    exact (hmul a (ConjClasses.mk g)).symm.trans (centerClassEquiv_apply_mk _ g)
  · intro hz
    choose a ha using fun C : ConjClasses G => hz (Quotient.out C)
    refine ⟨e.symm a, e.injective (funext fun C => ?_)⟩
    rw [hmul, e.apply_symm_apply, ha]
    rfl

variable {p : ℕ} {K : Type uK} [Field K] [Algebra O K]
variable [IsDomain O] [IsDiscreteValuationRing O]
variable (S : SplittingSystem G p O K)

theorem centerReduction_kernel :
    RingHom.ker (centerReduction O G) = centerUniformizerIdeal O G S.uniformizer := by
  ext z
  have h := mem_centerUniformizerIdeal_pow O G S.uniformizer 1 z
  rw [Submodule.pow_one, Submodule.pow_one] at h
  rw [h, ← groupAlgebraReduction_kernel O G S, RingHom.mem_ker, RingHom.mem_ker]
  refine ⟨congrArg Subtype.val, fun hz => ?_⟩
  apply Subtype.ext
  exact hz

/-- A compatible family in the center has a unique common lift. Completeness
of the full group algebra supplies the lift, and separation of the same algebra
shows that the lift commutes with every element. -/
theorem centerUniformizerIdeal_completeSeparated :
    IsAdicCompleteSeparated (centerUniformizerIdeal O G S.uniformizer) := by
  let I := centerUniformizerIdeal O G S.uniformizer
  let J := groupAlgebraUniformizerIdeal O G S.uniformizer
  have hquot (a b : Z[O,G]) (n : ℕ) :
      mk (I ^ n) a = mk (I ^ n) b ↔ mk (J ^ n) a.val = mk (J ^ n) b.val := by
    rw [mk_eq_mk_iff_sub_mem, mk_eq_mk_iff_sub_mem]
    exact mem_centerUniformizerIdeal_pow O G S.uniformizer n (a - b)
  have hJ := groupAlgebraUniformizerIdeal_completeSeparated O G S
  constructor
  · intro a b hab
    apply Subtype.ext
    apply hJ.1
    apply Subtype.ext
    funext n
    exact (hquot a b (n + 1)).mp (congrArg (fun z : AdicLimit I => z.val n) hab)
  · intro z
    choose a ha using fun n => mk_surjective (z.val n)
    let y : AdicLimit J := ⟨fun n => mk (J ^ (n + 1)) (a n).val, by
      intro n m hnm
      change mk (J ^ (n + 1)) (a m).val = mk (J ^ (n + 1)) (a n).val
      apply (hquot (a m) (a n) (n + 1)).mp
      rw [ha n, ← z.property hnm, ← ha m]
      rfl⟩
    obtain ⟨b, hb⟩ := hJ.2 y
    have hres (n : ℕ) : mk (J ^ (n + 1)) b = mk (J ^ (n + 1)) (a n).val :=
      congrArg (fun w : AdicLimit J => w.val n) hb
    have hcentral : b ∈ Z[O,G] := by
      apply Subalgebra.mem_center_iff.mpr
      intro c
      apply hJ.1
      apply Subtype.ext
      funext n
      change mk (J ^ (n + 1)) (c * b) = mk (J ^ (n + 1)) (b * c)
      rw [map_mul, map_mul, hres n, ← map_mul, ← map_mul,
        Subalgebra.mem_center_iff.mp (a n).property c]
    refine ⟨⟨b, hcentral⟩, Subtype.ext (funext fun n => ?_)⟩
    change mk (I ^ (n + 1)) ⟨b, hcentral⟩ = z.val n
    rw [← ha n]
    exact (hquot ⟨b, hcentral⟩ (a n) (n + 1)).mpr (hres n)

/-- The center quotient realizes coefficient reduction. -/
noncomputable def centerReductionQuotientEquiv :
    (Z[O,G] ⧸ centerUniformizerIdeal O G S.uniformizer) ≃+*
      Z[IsLocalRing.ResidueField O,G] :=
  (Ideal.quotEquivOfEq (centerReduction_kernel O G S).symm).trans
    (RingHom.quotientKerEquivOfSurjective (centerReduction_surjective O G))

@[simp] theorem centerReductionQuotientEquiv_mk (z : Z[O,G]) :
    centerReductionQuotientEquiv O G S (mk (centerUniformizerIdeal O G S.uniformizer) z) =
      centerReduction O G z := rfl

theorem exists_centerReduction_quotientEquiv :
    ∃ e : (Z[O,G] ⧸ centerUniformizerIdeal O G S.uniformizer) ≃+*
        Z[IsLocalRing.ResidueField O,G],
      ∀ z, e (mk (centerUniformizerIdeal O G S.uniformizer) z) = centerReduction O G z :=
  ⟨centerReductionQuotientEquiv O G S, centerReductionQuotientEquiv_mk O G S⟩

include S

/-- Each central idempotent over the residue field has a unique central lift. -/
theorem existsUnique_centralIdempotent_lift
    (e : Z[IsLocalRing.ResidueField O,G]) (he : IsIdempotentElem e) :
    ∃! b : Z[O,G], IsIdempotentElem b ∧ centerReduction O G b = e := by
  let q := centerReductionQuotientEquiv O G S
  obtain ⟨b, ⟨hb, hred⟩, huniq⟩ := existsUnique_idempotent_lift
    (centerUniformizerIdeal O G S.uniformizer)
    (Or.inr (centerUniformizerIdeal_completeSeparated O G S)) (q.symm e) (he.map q.symm)
  have hquot (a : Z[O,G]) :
      mk (centerUniformizerIdeal O G S.uniformizer) a = q.symm e ↔ centerReduction O G a = e := by
    calc
      _ ↔ q (mk (centerUniformizerIdeal O G S.uniformizer) a) = q (q.symm e) :=
        q.injective.eq_iff.symm
      _ ↔ _ := by rw [q.apply_symm_apply]; rfl
  exact ⟨b, ⟨hb, (hquot b).mp hred⟩, fun a ha => huniq a ⟨ha.1, (hquot a).mpr ha.2⟩⟩

/-- Central idempotents are determined by their reductions. -/
theorem centerReduction_eq_iff_of_idempotent {a b : Z[O,G]}
    (ha : IsIdempotentElem a) (hb : IsIdempotentElem b) :
    centerReduction O G a = centerReduction O G b ↔ a = b := by
  refine ⟨fun hab => ?_, congrArg (centerReduction O G)⟩
  obtain ⟨c, _, hc⟩ :=
    existsUnique_centralIdempotent_lift O G S _ (hb.map (centerReduction O G))
  exact (hc a ⟨ha, hab⟩).trans (hc b ⟨hb, rfl⟩).symm

/-- Orthogonality is preserved and reflected by reduction of central idempotents. -/
theorem centerReduction_mul_eq_zero_iff {a b : Z[O,G]}
    (ha : IsIdempotentElem a) (hb : IsIdempotentElem b) :
    centerReduction O G a * centerReduction O G b = 0 ↔ a * b = 0 := by
  rw [← map_mul, ← map_zero (centerReduction O G)]
  exact centerReduction_eq_iff_of_idempotent O G S (ha.mul hb) IsIdempotentElem.zero

/-- A finite sum of orthogonal central idempotents is one if and only if the
sum of its reductions is one. Orthogonality can be checked in the residue field. -/
theorem centerReduction_sum_eq_one_iff {ι : Type uI} (b : ι → Z[O,G]) (s : Finset ι)
    (hb : ∀ i, IsIdempotentElem (b i))
    (ho : Pairwise (fun i j => centerReduction O G (b i) * centerReduction O G (b j) = 0)) :
    (∑ i ∈ s, centerReduction O G (b i)) = 1 ↔ (∑ i ∈ s, b i) = 1 := by
  have h : OrthogonalIdempotents b :=
    ⟨hb, fun i j hij => (centerReduction_mul_eq_zero_iff O G S (hb i) (hb j)).mp (ho hij)⟩
  rw [← map_sum, ← map_one (centerReduction O G)]
  exact centerReduction_eq_iff_of_idempotent O G S h.isIdempotentElem_sum IsIdempotentElem.one

private theorem primitiveIdempotent_centerReduction_iff {b : Z[O,G]} (hb : IsIdempotentElem b) :
    IsPrimitiveIdempotent (centerReduction O G b) ↔ IsPrimitiveIdempotent b := by
  let f := centerReduction O G
  have hzero {a : Z[O,G]} (ha : IsIdempotentElem a) : f a = 0 ↔ a = 0 := by
    rw [← map_zero f]
    exact centerReduction_eq_iff_of_idempotent O G S ha IsIdempotentElem.zero
  constructor
  · intro h
    refine ⟨hb, fun hz => h.2.1 ((hzero hb).mpr hz), fun x y hx hy hxy hsum => ?_⟩
    have hmul := (centerReduction_mul_eq_zero_iff O G S hx hy).mpr hxy
    have hadd : f x + f y = f b := by rw [← map_add, hsum]
    exact (h.2.2 _ _ (hx.map f) (hy.map f) hmul hadd).imp (hzero hx).mp (hzero hy).mp
  · intro h
    refine ⟨hb.map f, fun hz => h.2.1 ((hzero hb).mp hz), fun x y hx hy hxy hsum => ?_⟩
    obtain ⟨a, ⟨ha, hax⟩, _⟩ := existsUnique_centralIdempotent_lift O G S x hx
    obtain ⟨c, ⟨hc, hcy⟩, _⟩ := existsUnique_centralIdempotent_lift O G S y hy
    have hac : a * c = 0 := (centerReduction_mul_eq_zero_iff O G S ha hc).mp (by
      rw [hax, hcy, hxy])
    have hsum_idem : IsIdempotentElem (a + c) :=
      ha.add hc (by rw [mul_comm c a, hac, add_zero])
    have hacb : a + c = b := (centerReduction_eq_iff_of_idempotent O G S hsum_idem hb).mp (by
      change f (a + c) = f b
      rw [map_add, hax, hcy, hsum])
    refine (h.2.2 a c ha hc hac hacb).imp (fun hz => ?_) (fun hz => ?_)
    · exact hax.symm.trans ((hzero ha).mpr hz)
    · exact hcy.symm.trans ((hzero hc).mpr hz)

/-- Reduction gives a bijection on primitive central idempotents. -/
noncomputable def blockIdempotentReductionEquiv :
    BlockIdempotent O G ≃ BlockIdempotent (IsLocalRing.ResidueField O) G :=
  Equiv.ofBijective
    (fun b => ⟨centerReduction O G b.1,
      (primitiveIdempotent_centerReduction_iff O G S b.center_idempotent).mpr b.2⟩)
    ⟨fun a b hab => Subtype.ext ((centerReduction_eq_iff_of_idempotent O G S
        a.center_idempotent b.center_idempotent).mp (congrArg Subtype.val hab)),
      fun b => by
        obtain ⟨a, ⟨ha, hred⟩, _⟩ :=
          existsUnique_centralIdempotent_lift O G S b.1 b.center_idempotent
        have hap : IsPrimitiveIdempotent a :=
          (primitiveIdempotent_centerReduction_iff O G S ha).mp (hred.symm ▸ b.2)
        exact ⟨⟨a, hap⟩, Subtype.ext hred⟩⟩

@[simp] theorem blockIdempotentReductionEquiv_apply_val (b : BlockIdempotent O G) :
    (blockIdempotentReductionEquiv O G S b).1 = centerReduction O G b.1 := rfl

@[simp] theorem blockIdempotentReductionEquiv_symm_element
    (b : BlockIdempotent (IsLocalRing.ResidueField O) G) :
    groupAlgebraReduction O G ((blockIdempotentReductionEquiv O G S).symm b).element =
      b.element :=
  congrArg BlockIdempotent.element ((blockIdempotentReductionEquiv O G S).apply_symm_apply b)

theorem blockIdempotentReductionEquiv_spec :
    ∃ e : BlockIdempotent O G ≃ BlockIdempotent (IsLocalRing.ResidueField O) G,
      ∀ b, (e b).1 = centerReduction O G b.1 :=
  ⟨blockIdempotentReductionEquiv O G S, blockIdempotentReductionEquiv_apply_val O G S⟩

/-- The lifts of the modular blocks form a complete orthogonal family over `O`. -/
theorem integral_block_decomposition :
    ∃ s : Finset (BlockIdempotent O G), (∀ b, b ∈ s) ∧
      (∑ b ∈ s, b.element) = 1 ∧
      Pairwise (fun b c : BlockIdempotent O G => b.element * c.element = 0) := by
  let k := IsLocalRing.ResidueField O
  let e := blockIdempotentReductionEquiv O G S
  obtain ⟨s, hs, hsum, horth⟩ := block_decomposition k G
  have hred (b : BlockIdempotent k G) : centerReduction O G (e.symm b).1 = b.1 :=
    congrArg Subtype.val (e.apply_symm_apply b)
  have hred_orth : Pairwise (fun b c : BlockIdempotent k G =>
      centerReduction O G (e.symm b).1 * centerReduction O G (e.symm c).1 = 0) := by
    intro b c hbc
    rw [hred b, hred c]
    exact Subtype.ext (horth hbc)
  refine ⟨s.map e.symm.toEmbedding, fun b => Finset.mem_map.mpr ⟨e b, hs _, e.symm_apply_apply b⟩,
    ?_, ?_⟩
  · rw [Finset.sum_map]
    have hcent : (∑ b ∈ s, (e.symm b).1) = 1 := by
      apply (centerReduction_sum_eq_one_iff O G S (fun b => (e.symm b).1) s
        (fun b => (e.symm b).center_idempotent) hred_orth).mp
      simp only [hred]
      apply Subtype.ext
      let v := (Subalgebra.center k (MonoidAlgebra k G)).val
      change v (∑ b ∈ s, b.1) = v 1
      rw [map_sum, map_one]
      exact hsum
    have hval := congrArg (Subalgebra.center O (MonoidAlgebra O G)).val hcent
    rw [map_sum, map_one] at hval
    change (∑ b ∈ s, (e.symm b).element) = 1
    exact hval
  · intro b c hbc
    have hmod := hred_orth (e.injective.ne hbc)
    change centerReduction O G (e.symm (e b)).1 * centerReduction O G (e.symm (e c)).1 = 0 at hmod
    rw [e.symm_apply_apply, e.symm_apply_apply] at hmod
    exact congrArg Subtype.val
      ((centerReduction_mul_eq_zero_iff O G S b.center_idempotent c.center_idempotent).mp hmod)

end RepTheorySurvey.Modular
