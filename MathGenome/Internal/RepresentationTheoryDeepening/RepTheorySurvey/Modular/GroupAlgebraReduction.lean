import MathGenome.Internal.RepresentationTheoryDeepening.RepTheorySurvey.Modular.SplittingSystem
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.GroupAlgebraReduction

/-! Coefficient reduction and adic completeness of the integral group algebra. -/

namespace RepTheorySurvey.Modular

open Ideal.Quotient

universe uO uG uK

variable (O : Type uO) [CommRing O] (G : Type uG) [Group G]

/-- The two-sided ideal generated by a scalar in the group algebra. -/
noncomputable abbrev groupAlgebraUniformizerIdeal (t : O) : Ideal (MonoidAlgebra O G) :=
  MRGroupAlgebraReductionSpec.uniformizerIdealValue O G t

/-- A group algebra on a finite group has one coefficient coordinate for each group element. -/
noncomputable def groupAlgebraCoefficients [Finite G] :
    MonoidAlgebra O G ≃ₗ[O] (G → O) :=
  (MonoidAlgebra.coeffLinearEquiv O).trans (Finsupp.linearEquivFunOnFinite O O G)

theorem groupAlgebraReduction_surjective [IsLocalRing O] :
    Function.Surjective (groupAlgebraReduction O G) :=
  MonoidAlgebra.map_surjective _ IsLocalRing.residue_surjective

section Finite

variable [Finite G]

/-- Membership in an ideal power is divisibility of every coefficient by the scalar power. -/
theorem mem_groupAlgebraUniformizerIdeal_pow (t : O) (n : ℕ) (a : MonoidAlgebra O G) :
    a ∈ groupAlgebraUniformizerIdeal O G t ^ n ↔
      ∀ g, a.coeff g ∈ (Ideal.span {t} : Ideal O) ^ n := by
  let _ : (Ideal.span {algebraMap O (MonoidAlgebra O G) t}).IsTwoSided :=
    inferInstanceAs (groupAlgebraUniformizerIdeal O G t).IsTwoSided
  change a ∈ (Ideal.span {algebraMap O (MonoidAlgebra O G) t}) ^ n ↔ _
  rw [Ideal.span_singleton_pow, Ideal.span_singleton_pow, ← map_pow]
  simp only [Ideal.mem_span_singleton']
  constructor
  · rintro ⟨b, rfl⟩ g
    refine ⟨b.coeff g, ?_⟩
    rw [(Algebra.commutes (t ^ n) b).symm, ← Algebra.smul_def,
      MonoidAlgebra.coeff_smul_apply, smul_eq_mul, mul_comm]
  · intro h
    choose b hb using h
    let y := (groupAlgebraCoefficients O G).symm b
    have hy (g : G) : y.coeff g = b g :=
      congrFun ((groupAlgebraCoefficients O G).apply_symm_apply b) g
    refine ⟨y, MonoidAlgebra.ext (Finsupp.ext fun g => ?_)⟩
    rw [(Algebra.commutes (t ^ n) y).symm, ← Algebra.smul_def,
      MonoidAlgebra.coeff_smul_apply, smul_eq_mul, mul_comm, hy]
    exact hb g

variable {p : ℕ} {K : Type uK} [Field K] [Algebra O K]
variable [IsDomain O] [IsDiscreteValuationRing O]
variable (S : SplittingSystem G p O K)

theorem groupAlgebraReduction_kernel :
    RingHom.ker (groupAlgebraReduction O G) = groupAlgebraUniformizerIdeal O G S.uniformizer := by
  ext a
  have hmem : a ∈ groupAlgebraUniformizerIdeal O G S.uniformizer ↔
      ∀ g, a.coeff g ∈ Ideal.span {S.uniformizer} := by
    simpa only [Submodule.pow_one] using mem_groupAlgebraUniformizerIdeal_pow O G S.uniformizer 1 a
  rw [RingHom.mem_ker, hmem]
  unfold groupAlgebraReduction
  constructor
  · intro h g
    rw [← S.maximalIdeal_eq_span, ← IsLocalRing.residue_eq_zero_iff,
      ← MonoidAlgebra.coeff_mapRingHom, h, MonoidAlgebra.coeff_zero, Finsupp.zero_apply]
  · intro h
    apply MonoidAlgebra.ext
    apply Finsupp.ext
    intro g
    rw [MonoidAlgebra.coeff_mapRingHom, MonoidAlgebra.coeff_zero, Finsupp.zero_apply,
      IsLocalRing.residue_eq_zero_iff, S.maximalIdeal_eq_span]
    exact h g

/-- The integral group algebra is complete and separated for the uniformizer ideal. -/
theorem groupAlgebraUniformizerIdeal_completeSeparated :
    IsAdicCompleteSeparated (groupAlgebraUniformizerIdeal O G S.uniformizer) := by
  classical
  let I := groupAlgebraUniformizerIdeal O G S.uniformizer
  let J := IsLocalRing.maximalIdeal O
  have hmem (a b : MonoidAlgebra O G) (n : ℕ) :
      mk (I ^ n) a = mk (I ^ n) b ↔
        ∀ g, a.coeff g ≡ b.coeff g [SMOD (J ^ n • (⊤ : Submodule O O))] := by
    rw [mk_eq_mk_iff_sub_mem, mem_groupAlgebraUniformizerIdeal_pow]
    simp [J, S.maximalIdeal_eq_span, SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
  constructor
  · intro a b hab
    apply MonoidAlgebra.ext
    apply Finsupp.ext
    intro g
    rw [← sub_eq_zero]
    apply IsHausdorff.haus S.complete.toIsHausdorff
    intro n
    have hn := (hmem a b (n + 1)).mp
      (congrArg (fun z : AdicLimit I => z.val n) hab) g
    have hn' := SModEq.mono (Submodule.pow_smul_top_le J O (Nat.le_succ n)) hn
    simpa only [SModEq.sub_mem, sub_zero] using hn'
  · intro z
    choose a ha using fun n : ℕ => mk_surjective (z.val n)
    have hcompat (m n : ℕ) (hmn : m ≤ n) : mk (I ^ (m + 1)) (a m) = mk (I ^ (m + 1)) (a n) := by
      rw [ha m, ← z.property hmn, ← ha n]
      rfl
    have hlimit (g : G) :
        ∃ L : O, ∀ n, (a n).coeff g ≡ L [SMOD (J ^ (n + 1) • (⊤ : Submodule O O))] := by
      obtain ⟨L, hL⟩ := IsPrecomplete.prec S.complete.toIsPrecomplete
        (f := fun n => (a n).coeff g) (fun {m n} hmn =>
          SModEq.mono (Submodule.pow_smul_top_le J O (Nat.le_succ m))
            ((hmem (a m) (a n) (m + 1)).mp (hcompat m n hmn) g))
      -- At index n + 1 the limit agrees modulo the power required at index n.
      refine ⟨L, fun n => ?_⟩
      exact ((hmem (a n) (a (n + 1)) (n + 1)).mp
        (hcompat n (n + 1) (Nat.le_succ n)) g).trans (hL (n + 1))
    choose L hL using hlimit
    let b := (groupAlgebraCoefficients O G).symm L
    refine ⟨b, Subtype.ext (funext fun n => ?_)⟩
    change mk (I ^ (n + 1)) b = z.val n
    rw [← ha n]
    apply (hmem b (a n) (n + 1)).mpr
    intro g
    have hbg : b.coeff g = L g :=
      congrFun ((groupAlgebraCoefficients O G).apply_symm_apply L) g
    rw [hbg]
    exact (hL g n).symm

/-- The quotient by the uniformizer ideal realizes coefficient reduction as an algebra map. -/
theorem exists_groupAlgebraReduction_quotientEquiv :
    ∃ e : ((MonoidAlgebra O G) ⧸ groupAlgebraUniformizerIdeal O G S.uniformizer) ≃ₐ[O]
        MonoidAlgebra (IsLocalRing.ResidueField O) G,
      ∀ a, e (mk (groupAlgebraUniformizerIdeal O G S.uniformizer) a) =
        groupAlgebraReduction O G a := by
  let f := MonoidAlgebra.mapAlgHom G (Algebra.ofId O (IsLocalRing.ResidueField O))
  have hf_eq : (f : MonoidAlgebra O G →+* MonoidAlgebra (IsLocalRing.ResidueField O) G) =
      groupAlgebraReduction O G := rfl
  have hf : Function.Surjective f := by
    change Function.Surjective (f : MonoidAlgebra O G →+* MonoidAlgebra (IsLocalRing.ResidueField O) G)
    rw [hf_eq]
    exact groupAlgebraReduction_surjective O G
  have hKer : groupAlgebraUniformizerIdeal O G S.uniformizer = RingHom.ker f := by
    rw [AlgHom.ker_coe, hf_eq, groupAlgebraReduction_kernel O G S]
  refine ⟨(Ideal.quotientEquivAlgOfEq O hKer).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := f) hf), fun a => ?_⟩
  rw [AlgEquiv.trans_apply, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk]
  exact DFunLike.congr_fun hf_eq a

end Finite
end RepTheorySurvey.Modular
