namespace RepTheorySurvey.CategoryO.BorelInduction

/-- The submodule generated by the balancing relations. -/
abbrev balancedSubmodule := @balance

/-- Induction of a unital left module, using its underlying complex vector space. -/
abbrev Ind := @inducedFromModule

section Balanced

variable {A B : Type*} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
variable (i : B →ₐ[ℂ] A)
variable {E : Type*} [AddCommGroup E] [Module B E] [Module ℂ E]

theorem balance_tensor (a : A) (b : B) (e : E) :
    induceTensor i (a * i b) e = induceTensor i a (b • e) := by
  apply sub_eq_zero.mp
  rw [← map_sub]
  exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span ⟨a, b, e, rfl⟩)

theorem smul_tensor (c a : A) (e : E) :
    c • induceTensor i a e = induceTensor i (c * a) e := by
  rw [← map_smul]
  rfl

theorem tensorRelations : TensorRelations (E := E) i :=
  ⟨balance_tensor i, smul_tensor i⟩

private theorem quotientExt {R W : Type*} [Semiring R] [AddCommMonoid W] [Module R W]
    [Module R (Induced i E)] {f g : Induced i E →ₗ[R] W}
    (h : ∀ a e, f (induceTensor i a e) = g (induceTensor i a e)) : f = g := by
  ext x
  obtain ⟨z, rfl⟩ := (balance i E).mkQ_surjective x
  induction z using TensorProduct.inductionOn with
  | tmul a e => exact h a e
  | add z w hz hw => simp only [map_add, hz, hw]

/-- The map into the restriction of an induced module. -/
def unit : letI := restrictModule i (Induced i E); E →ₗ[B] Induced i E :=
  letI := restrictModule i (Induced i E)
  { toFun := induceTensor i 1
    map_add' := fun e e' => by simp [TensorProduct.tmul_add]
    map_smul' := fun b e => by
      change induceTensor i 1 (b • e) = (i b) • induceTensor i 1 e
      rw [smul_tensor, mul_one, ← balance_tensor, one_mul] }

@[simp] theorem unit_apply (e : E) : unit i e = induceTensor i 1 e := rfl

variable [IsScalarTower ℂ B E]
variable {V : Type*} [AddCommGroup V] [Module A V]

/-- Extend a map from the inducing module by the left action and descend
through the balancing relations. -/
def extend : letI := restrictModule i V; (E →ₗ[B] V) → (Induced i E →ₗ[A] V) :=
  letI := restrictModule i V
  fun f => by
    letI : Module ℂ V := Module.compHom V (algebraMap ℂ A)
    letI : IsScalarTower ℂ A V := IsScalarTower.of_algebraMap_smul (A := A) fun _ _ => rfl
    letI : IsScalarTower ℂ B V := IsScalarTower.of_algebraMap_smul (A := B) fun c v => by
      change i (algebraMap ℂ B c) • v = algebraMap ℂ A c • v
      rw [i.commutes]
    let F : A →ₗ[A] E →ₗ[ℂ] V :=
      { toFun := fun a => ((Algebra.lsmul ℂ ℂ V a : Module.End ℂ V)).comp (f.restrictScalars ℂ)
        map_add' := fun a a' => by ext e; exact add_smul a a' (f e)
        map_smul' := fun c a => by ext e; exact mul_smul c a (f e) }
    let F' := TensorProduct.AlgebraTensorModule.lift F
    refine (balance i E).liftQ F' (Submodule.span_le.mpr ?_)
    rintro _ ⟨a,b,e,rfl⟩
    change F' ((a * i b) ⊗ₜ[ℂ] e - a ⊗ₜ[ℂ] (b • e)) = 0
    rw [map_sub]
    apply sub_eq_zero.mpr
    change (a * i b) • f e = a • f (b • e)
    rw [mul_smul, map_smul]
    rfl

@[simp] theorem extend_tensor :
    letI := restrictModule i V
    ∀ (f : E →ₗ[B] V) a e, extend i f (induceTensor i a e) = a • f e := by
  intros
  rfl

/-- Restriction and balanced induction are adjoint. -/
def homEquiv : letI := restrictModule i V; (Induced i E →ₗ[A] V) ≃ (E →ₗ[B] V) :=
  letI := restrictModule i V
  { toFun := fun f =>
      { toFun := fun e => f (unit i e)
        map_add' := fun x y => by rw [map_add, map_add]
        map_smul' := fun b e => by
          let _ := restrictModule i (Induced i E)
          change f (unit i (b • e)) = (i b) • f (unit i e)
          rw [map_smul (unit i)]
          exact f.map_smul (i b) (unit i e) }
    invFun := extend i
    left_inv := fun f => quotientExt i fun a e => by
      change extend i _ (induceTensor i a e) = _
      rw [extend_tensor]
      change a • f (induceTensor i 1 e) = _
      rw [← map_smul, smul_tensor, mul_one]
    right_inv := fun f => LinearMap.ext fun e => by
      change extend i f (induceTensor i 1 e) = f e
      rw [extend_tensor, one_smul] }

@[simp] theorem homEquiv_apply (f : Induced i E →ₗ[A] V) (e : E) :
    homEquiv i f e = f (induceTensor i 1 e) := rfl

theorem universal (V : Type*) [AddCommGroup V] [Module A V] :
    Universal (E := E) i V :=
  ⟨homEquiv i, fun _ _ => rfl, extend_tensor i⟩

theorem scalarModule_tower (E : Type*) [AddCommGroup E] [Module B E] :
    letI := scalarModule (B := B) E
    IsScalarTower ℂ B E :=
  IsScalarTower.of_compHom ℂ B E

variable {E' E'' : Type*}
  [AddCommGroup E'] [Module B E'] [Module ℂ E']
  [AddCommGroup E''] [Module B E''] [Module ℂ E'']

/-- The map induced by a homomorphism of left modules. -/
def mapInduced (f : E →ₗ[B] E') : Induced i E →ₗ[A] Induced i E' :=
  letI := restrictModule i (Induced i E')
  extend i ((unit i).comp f)

@[simp] theorem mapInduced_tensor (f : E →ₗ[B] E') (a : A) (e : E) :
    mapInduced i f (induceTensor i a e) = induceTensor i a (f e) := by
  rw [mapInduced, extend_tensor, LinearMap.comp_apply, unit_apply, smul_tensor, mul_one]

theorem mapExists : MapExists (E := E) (E' := E') i := by
  intro f
  exact ⟨mapInduced i f, mapInduced_tensor i f, fun q hq =>
    quotientExt i fun a e => (hq a e).trans (mapInduced_tensor i f a e).symm⟩

omit [IsScalarTower ℂ B E] in
theorem mapComposition : MapComposition (E := E) (E' := E') (E'' := E'') i := by
  intro f g q r hq hr a e
  change r (q (induceTensor i a e)) = induceTensor i a (g (f e))
  rw [hq, hr]

omit [IsScalarTower ℂ B E] in
theorem mapIdentity : MapIdentity (E := E) i :=
  fun _ _ => rfl

omit [IsScalarTower ℂ B E] in
theorem universalNaturality (V W : Type*) [AddCommGroup V] [AddCommGroup W]
    [Module A V] [Module A W] : UniversalNaturality (E := E) (E' := E') i V W := by
  let _ : Module B V := restrictModule i V
  let _ : Module B W := restrictModule i W
  intro F F' hF hF' f q hq g k
  apply LinearMap.ext
  intro e
  rw [hF']
  change k (g (q (induceTensor i 1 e))) = k (F g (f e))
  rw [hF, hq]

end Balanced

section PBW

open Shared.Lie.PBW
open Specs.LieAlgebrasAndRepresentations.VermaModules (envelopingMap)
attribute [local instance 100] LieRing.ofAssociativeRing

open private leftLetter rightLetter joinWords joinWords_bijective from
  MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.VermaModules

variable {G : Type*} [LieRing G] [LieAlgebra ℂ G]
variable (N B : LieSubalgebra ℂ G)

@[simp] theorem inclusion_ι (C : LieSubalgebra ℂ G) (x : C) :
    inclusion C (ι ℂ x) = ι ℂ (x : G) :=
  UniversalEnvelopingAlgebra.lift_ι_apply _ _ _

@[simp] theorem multiply_tensor (a : U N) (b : U B) :
    multiply N B (a ⊗ₜ[ℂ] b) = inclusion N a * inclusion B b := by
  simp [multiply, Specs.LieAlgebrasAndRepresentations.VermaModules.multiply]

@[simp] theorem tensorRightMul_tensor (a : U N) (b c : U B) :
    tensorRightMul N B c (a ⊗ₜ[ℂ] b) = a ⊗ₜ[ℂ] (b * c) := by
  simp [tensorRightMul]

private theorem multiply_bijective (hc : IsCompl N.toSubmodule B.toSubmodule) :
    Bijective (multiply N B) := by
  classical
  let a := Module.Free.chooseBasis ℂ N
  let b := Module.Free.chooseBasis ℂ B
  let α := Module.Free.ChooseBasisIndex ℂ N
  let β := Module.Free.ChooseBasisIndex ℂ B
  let : LinearOrder α := WellOrderingRel.isWellOrder.linearOrder
  let : LinearOrder β := WellOrderingRel.isWellOrder.linearOrder
  let c : Module.Basis (α ⊕ₗ β) ℂ G :=
    ((a.prod b).map (Submodule.prodEquivOfIsCompl _ _ hc)).reindex toLex
  have hc₁ (j : α) : c (leftLetter j) = (a j : G) := by
    simp only [c, leftLetter, Module.Basis.reindex_apply, Module.Basis.map_apply,
      Module.Basis.prod_apply]
    change (a j : G) + 0 = (a j : G)
    exact add_zero _
  have hc₂ (j : β) : c (rightLetter j) = (b j : G) := by
    simp only [c, rightLetter, Module.Basis.reindex_apply, Module.Basis.map_apply,
      Module.Basis.prod_apply]
    change 0 + (b j : G) = (b j : G)
    exact zero_add _
  obtain ⟨Ba, ha, _, _⟩ := LieAlgebrasAndRepresentations.PBW.orderedBasis_spec ℂ N α a
  obtain ⟨Bb, hb, _, _⟩ := LieAlgebrasAndRepresentations.PBW.orderedBasis_spec ℂ B β b
  obtain ⟨Bc, hbc, _, _⟩ := LieAlgebrasAndRepresentations.PBW.orderedBasis_spec ℂ G (α ⊕ₗ β) c
  let e := Equiv.ofBijective joinWords (joinWords_bijective (α := α) (β := β))
  let source := Ba.tensorProduct Bb
  let target := Bc.reindex e.symm
  let F := source.equiv target (Equiv.refl _)
  have heq : F.toLinearMap = multiply N B := by
    apply source.ext
    rintro ⟨p, q⟩
    change F (source (p, q)) = multiply N B (source (p, q))
    rw [source.equiv_apply (p, q) target (Equiv.refl _)]
    simp only [target, source, Module.Basis.reindex_apply, Equiv.symm_symm,
      Module.Basis.tensorProduct_apply', ha, hb, hbc, multiply_tensor]
    change monomial c (p.val.map leftLetter ++ q.val.map rightLetter) =
      inclusion N (monomial a p.val) * inclusion B (monomial b q.val)
    simp only [monomial, Shared.Lie.word, List.map_append, List.prod_append,
      List.map_map, Function.comp_def, hc₁, hc₂, map_list_prod, Shared.Lie.inclusion, inclusion_ι]
    rfl
  rw [← heq]
  exact F.bijective

/-- PBW multiplication for complementary Lie subalgebras. -/
def pbwEquiv (hc : IsCompl N.toSubmodule B.toSubmodule) :
    U N ⊗[ℂ] U B ≃ₗ[ℂ] U G :=
  LinearEquiv.ofBijective _ (multiply_bijective N B hc)

@[simp] theorem pbwEquiv_tensor (hc : IsCompl N.toSubmodule B.toSubmodule)
    (a : U N) (b : U B) : pbwEquiv N B hc (a ⊗ₜ[ℂ] b) = inclusion N a * inclusion B b :=
  multiply_tensor N B a b

theorem pbwEquiv_rightMul (hc : IsCompl N.toSubmodule B.toSubmodule)
    (z : U N ⊗[ℂ] U B) (b : U B) :
    pbwEquiv N B hc (tensorRightMul N B b z) = pbwEquiv N B hc z * inclusion B b := by
  induction z using TensorProduct.inductionOn with
  | tmul a c => simp [mul_assoc]
  | add x y hx hy => simp [hx, hy, add_mul]

theorem pbw : PBW N B :=
  fun hc => ⟨pbwEquiv N B hc, rfl, pbwEquiv_tensor N B hc, pbwEquiv_rightMul N B hc⟩

theorem tensorRightModule_smul (b : (U B)ᵐᵒᵖ) (z : U N ⊗[ℂ] U B) :
    letI := tensorRightModule N B
    b • z = tensorRightMul N B b.unop z := by
  let _ : Module (U B)ᵐᵒᵖ (U N ⊗[ℂ] U B) := tensorRightModule N B
  induction z using TensorProduct.inductionOn with
  | tmul a c => rw [tensorRightMul_tensor]; rfl
  | add x y hx hy => rw [smul_add, map_add, hx, hy]

/-- PBW multiplication as a linear equivalence of right modules. -/
def rightPBWEquiv (hc : IsCompl N.toSubmodule B.toSubmodule) :
    letI := envelopingRightModule B
    letI := tensorRightModule N B
    U N ⊗[ℂ] U B ≃ₗ[(U B)ᵐᵒᵖ] U G :=
  letI := envelopingRightModule B
  letI := tensorRightModule N B
  { (pbwEquiv N B hc).toAddEquiv with
    map_smul' := fun b z => by
      change pbwEquiv N B hc (b • z) = pbwEquiv N B hc z * inclusion B b.unop
      rw [tensorRightModule_smul]
      exact pbwEquiv_rightMul N B hc z b.unop }

theorem rightPBW : RightPBW N B :=
  fun hc => ⟨rightPBWEquiv N B hc, fun _ => rfl⟩

end PBW

section InducedPBW

variable {G : Type*} [LieRing G] [LieAlgebra ℂ G]
variable (N B : LieSubalgebra ℂ G)
variable {E : Type*} [AddCommGroup E] [Module (U B) E] [Module ℂ E]

/-- The map induced by including the negative enveloping algebra. -/
def negativeTensorMap : U N ⊗[ℂ] E →ₗ[ℂ] Induced (inclusion B) E :=
  ((balance (inclusion B) E).mkQ.restrictScalars ℂ).comp
    (TensorProduct.map (inclusion N).toLinearMap LinearMap.id)

@[simp] theorem negativeTensorMap_tensor (a : U N) (e : E) :
    negativeTensorMap N B (a ⊗ₜ[ℂ] e) = induceTensor (inclusion B) (inclusion N a) e :=
  by simp [negativeTensorMap]

section
variable [IsScalarTower ℂ (U B) E]
variable (hc : IsCompl N.toSubmodule B.toSubmodule)

private def evaluateTensor : U G ⊗[ℂ] E →ₗ[ℂ] U N ⊗[ℂ] E :=
  (TensorProduct.map LinearMap.id (TensorProduct.lift
    (Algebra.lsmul ℂ ℂ E : U B →ₐ[ℂ] Module.End ℂ E).toLinearMap)).comp
    ((TensorProduct.assoc ℂ (U N) (U B) E).toLinearMap.comp
      (TensorProduct.map (pbwEquiv N B hc).symm.toLinearMap LinearMap.id))

private theorem evaluateTensor_product (a : U N) (b : U B) (e : E) :
    evaluateTensor N B hc ((inclusion N a * inclusion B b) ⊗ₜ[ℂ] e) =
      a ⊗ₜ[ℂ] (b • e) := by
  rw [← pbwEquiv_tensor N B hc a b]
  simp only [evaluateTensor, LinearMap.comp_apply, TensorProduct.map_tmul,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, LinearMap.id_apply,
    TensorProduct.assoc_tmul, TensorProduct.lift.tmul, AlgHom.toLinearMap_apply,
    Algebra.lsmul_apply]

private theorem evaluateTensor_balanced (u : U G) (b : U B) (e : E) :
    evaluateTensor N B hc ((u * inclusion B b) ⊗ₜ[ℂ] e) =
      evaluateTensor N B hc (u ⊗ₜ[ℂ] (b • e)) := by
  obtain ⟨z,rfl⟩ := (pbwEquiv N B hc).surjective u
  induction z using TensorProduct.inductionOn with
  | tmul a c =>
    rw [pbwEquiv_tensor, mul_assoc, ← map_mul, evaluateTensor_product,
      evaluateTensor_product, mul_smul]
  | add z w hz hw => simp only [map_add, add_mul, TensorProduct.add_tmul, hz, hw]

private theorem evaluateTensor_vanishes {z : U G ⊗[ℂ] E} (hz : z ∈ balance (inclusion B) E) :
    evaluateTensor N B hc z = 0 := by
  have h : ∀ c : U G, evaluateTensor N B hc (c • z) = 0 := by
    refine Submodule.span_induction (p := fun z _ =>
      ∀ c : U G, evaluateTensor N B hc (c • z) = 0) ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨a,b,e,rfl⟩ c
      rw [smul_sub, map_sub, sub_eq_zero]
      change evaluateTensor N B hc ((c * (a * inclusion B b)) ⊗ₜ[ℂ] e) =
        evaluateTensor N B hc ((c * a) ⊗ₜ[ℂ] (b • e))
      rw [← mul_assoc]
      exact evaluateTensor_balanced N B hc (c * a) b e
    · simp
    · intro x y _ _ hx hy c
      rw [smul_add, map_add, hx, hy, add_zero]
    · intro c x _ hx d
      rw [← mul_smul]
      exact hx (d * c)
  simpa only [one_smul] using h 1

private def evaluateQuotient : Induced (inclusion B) E →ₗ[ℂ] U N ⊗[ℂ] E :=
  (((balance (inclusion B) E).restrictScalars ℂ).liftQ (evaluateTensor N B hc)
    (fun _ hx => evaluateTensor_vanishes N B hc hx)).comp
      (Submodule.Quotient.restrictScalarsEquiv ℂ (balance (inclusion B) E)).symm.toLinearMap

private theorem evaluateQuotient_tensor (a : U G) (e : E) :
    evaluateQuotient N B hc (induceTensor (inclusion B) a e) =
      evaluateTensor N B hc (a ⊗ₜ[ℂ] e) := rfl

/-- PBW identifies induction with tensoring by the negative enveloping algebra. -/
def inducedPBWEquiv : U N ⊗[ℂ] E ≃ₗ[ℂ] Induced (inclusion B) E := by
  refine LinearEquiv.ofLinearMap (negativeTensorMap N B) (evaluateQuotient N B hc) ?_ ?_
  · apply quotientExt (inclusion B)
    intro u e
    obtain ⟨z,rfl⟩ := (pbwEquiv N B hc).surjective u
    induction z using TensorProduct.inductionOn with
    | tmul a b =>
      simp only [LinearMap.comp_apply, pbwEquiv_tensor, evaluateQuotient_tensor,
        evaluateTensor_product, negativeTensorMap_tensor, LinearMap.id_apply]
      exact (balance_tensor _ _ _ _).symm
    | add z w hz hw =>
      simp only [map_add, induceTensor, TensorProduct.add_tmul] at hz hw ⊢
      rw [hz, hw]
  · apply TensorProduct.ext'
    intro a e
    simp only [LinearMap.comp_apply, negativeTensorMap_tensor, evaluateQuotient_tensor,
      LinearMap.id_apply]
    simpa using evaluateTensor_product N B hc a 1 e

@[simp] theorem inducedPBWEquiv_tensor (a : U N) (e : E) :
    inducedPBWEquiv N B hc (a ⊗ₜ[ℂ] e) = induceTensor (inclusion B) (inclusion N a) e :=
  negativeTensorMap_tensor N B a e

theorem inducedPBW : InducedPBW N B E :=
  fun hc => ⟨inducedPBWEquiv N B hc, inducedPBWEquiv_tensor N B hc⟩

end
variable (E)
variable [hE : IsScalarTower ℂ (U B) E]
variable {E' E'' : Type*}
  [AddCommGroup E'] [Module (U B) E'] [Module ℂ E'] [hE' : IsScalarTower ℂ (U B) E']
  [AddCommGroup E''] [Module (U B) E''] [Module ℂ E''] [hE'' : IsScalarTower ℂ (U B) E'']

theorem pbwNaturality : PBWNaturality N B E (E' := E') := by
  intro f q hq F F' hF hF'
  apply TensorProduct.ext'
  intro a e
  change q (F (a ⊗ₜ[ℂ] e)) = F' (a ⊗ₜ[ℂ] f e)
  rw [hF, hF', hq]

include hE hE' hE'' in
theorem exactInduction : ExactInduction N B E (E' := E') (E'' := E'') := by
  intro hc f g q r hq hr hf hfg hg
  let F := inducedPBWEquiv N B (E := E) hc
  let F' := inducedPBWEquiv N B (E := E') hc
  let F'' := inducedPBWEquiv N B (E := E'') hc
  let ft := (f.restrictScalars ℂ).lTensor (U N)
  let gt := (g.restrictScalars ℂ).lTensor (U N)
  have hft : Injective ft := Module.Flat.lTensor_preserves_injective_linearMap
    (f.restrictScalars ℂ) hf
  have hgt : Surjective gt := LinearMap.lTensor_surjective (U N) (g := g.restrictScalars ℂ) hg
  have hftgt : Function.Exact ft gt :=
    lTensor_exact (U N) (f := f.restrictScalars ℂ) (g := g.restrictScalars ℂ) hfg hg
  have hq' (x) : q (F x) = F' (ft x) := LinearMap.congr_fun
    (pbwNaturality N B E f q hq F F' (inducedPBWEquiv_tensor N B hc)
      (inducedPBWEquiv_tensor N B hc)) x
  have hr' (x) : r (F' x) = F'' (gt x) := LinearMap.congr_fun
    (pbwNaturality N B E' g r hr F' F'' (inducedPBWEquiv_tensor N B hc)
      (inducedPBWEquiv_tensor N B hc)) x
  refine ⟨?_, ?_, ?_⟩
  · intro x y h
    obtain ⟨x,rfl⟩ := F.surjective x
    obtain ⟨y,rfl⟩ := F.surjective y
    rw [hq', hq'] at h
    exact congrArg F (hft (F'.injective h))
  · intro y
    obtain ⟨y,rfl⟩ := F'.surjective y
    rw [hr', F''.map_eq_zero_iff, hftgt y]
    constructor
    · rintro ⟨x,rfl⟩
      exact ⟨F x, hq' x⟩
    · rintro ⟨x,hx⟩
      obtain ⟨x,rfl⟩ := F.surjective x
      rw [hq'] at hx
      exact ⟨x,F'.injective hx⟩
  · intro z
    obtain ⟨y,rfl⟩ := (F''.surjective.comp hgt) z
    exact ⟨F' y,hr' y⟩

end InducedPBW

section Cartan

attribute [local instance 100] LieRing.ofAssociativeRing

variable {G : Type*} [LieRing G] [LieAlgebra ℂ G]
variable (N B : LieSubalgebra ℂ G)
theorem inclusion_injective (hc : IsCompl N.toSubmodule B.toSubmodule) : Injective (inclusion N) := by
  intro a a' haa'
  have ht : a ⊗ₜ[ℂ] (1 : U B) = a' ⊗ₜ[ℂ] (1 : U B) :=
    (pbwEquiv N B hc).injective (by simpa using haa')
  let p := (TensorProduct.rid ℂ (U N)).toLinearMap.comp
    (TensorProduct.map LinearMap.id (Shared.Lie.augmentation ℂ B).toLinearMap)
  have heq (z : U N) : p (z ⊗ₜ[ℂ] (1 : U B)) = z := by simp [p]
  exact (heq a).symm.trans ((congrArg p ht).trans (heq a'))

variable (hc : IsCompl N.toSubmodule B.toSubmodule)

private def commutator (h : B) : U N →ₗ[ℂ] U G :=
  ((LinearMap.mul ℂ (U G) (ι ℂ (h : G))) -
    (LinearMap.mul ℂ (U G)).flip (ι ℂ (h : G))).comp (inclusion N).toLinearMap

private theorem commutator_generator (h : B)
    (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) (x : N) :
    commutator N B h (ι ℂ x) = inclusion N (ι ℂ (⟨⁅(h : G), (x : G)⁆, hn x⟩ : N)) := by
  change ι ℂ (h : G) * inclusion N (ι ℂ x) - inclusion N (ι ℂ x) * ι ℂ (h : G) = _
  rw [inclusion_ι, inclusion_ι]
  exact ((ι ℂ).map_lie (h : G) (x : G)).symm

private theorem commutator_mul (h : B) (a b : U N) :
    commutator N B h (a * b) =
      commutator N B h a * inclusion N b + inclusion N a * commutator N B h b := by
  change ι ℂ (h : G) * inclusion N (a * b) - inclusion N (a * b) * ι ℂ (h : G) =
    (ι ℂ (h : G) * inclusion N a - inclusion N a * ι ℂ (h : G)) * inclusion N b +
    inclusion N a * (ι ℂ (h : G) * inclusion N b - inclusion N b * ι ℂ (h : G))
  rw [map_mul]
  noncomm_ring

private theorem commutator_mem (h : B)
    (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) (a : U N) :
    commutator N B h a ∈ LinearMap.range (inclusion N).toLinearMap := by
  obtain ⟨z,rfl⟩ := RingCon.mkₐ_surjective (α := ℂ)
    (UniversalEnvelopingAlgebra.ringCon ℂ N) a
  change commutator N B h (UniversalEnvelopingAlgebra.mkAlgHom ℂ N z) ∈ _
  induction z using TensorAlgebra.induction with
  | algebraMap c =>
    rw [(UniversalEnvelopingAlgebra.mkAlgHom ℂ N).commutes]
    convert (LinearMap.range (inclusion N).toLinearMap).zero_mem using 1
    change ι ℂ (h : G) * inclusion N (algebraMap ℂ (U N) c) -
      inclusion N (algebraMap ℂ (U N) c) * ι ℂ (h : G) = 0
    rw [(inclusion N).commutes, Algebra.commutes c (ι ℂ (h : G)), sub_self]
  | ι x =>
    change commutator N B h (ι ℂ x) ∈ _
    rw [commutator_generator N B h hn x]
    exact ⟨ι ℂ (⟨⁅(h : G), (x : G)⁆, hn x⟩ : N), rfl⟩
  | add x y hx hy =>
    rw [map_add, map_add]
    exact Submodule.add_mem _ hx hy
  | mul x y hx hy =>
    rw [map_mul, commutator_mul]
    obtain ⟨a, ha⟩ := hx
    obtain ⟨b, hb⟩ := hy
    refine ⟨a * UniversalEnvelopingAlgebra.mkAlgHom ℂ N y +
      UniversalEnvelopingAlgebra.mkAlgHom ℂ N x * b, ?_⟩
    change inclusion N _ = _
    rw [map_add, map_mul, map_mul]
    exact congrArg₂ (· + ·) (congrArg (· * _) ha) (congrArg (_ * ·) hb)

/-- The Cartan action on the negative enveloping algebra is the restriction
of the ambient commutator. -/
def cartanCommutator (h : B) (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) :
    U N →ₗ[ℂ] U N :=
  (LinearEquiv.ofInjective (inclusion N).toLinearMap (inclusion_injective N B hc)).symm.toLinearMap.comp
    ((commutator N B h).codRestrict _ (commutator_mem N B h hn))

@[simp] theorem inclusion_cartanCommutator (h : B)
    (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) (a : U N) :
    inclusion N (cartanCommutator N B hc h hn a) =
      ι ℂ (h : G) * inclusion N a - inclusion N a * ι ℂ (h : G) := by
  let F := LinearEquiv.ofInjective (inclusion N).toLinearMap (inclusion_injective N B hc)
  exact congrArg Subtype.val (F.apply_symm_apply
    ((commutator N B h).codRestrict _ (commutator_mem N B h hn) a))

@[simp] theorem cartanCommutator_generator (h : B)
    (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) (x : N) :
    cartanCommutator N B hc h hn (ι ℂ x) = ι ℂ (⟨⁅(h : G), (x : G)⁆, hn x⟩ : N) := by
  apply inclusion_injective N B hc
  exact (inclusion_cartanCommutator N B hc h hn (ι ℂ x)).trans
    (commutator_generator N B h hn x)

theorem cartanCommutator_mul (h : B)
    (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N) (a b : U N) :
    cartanCommutator N B hc h hn (a * b) =
      cartanCommutator N B hc h hn a * b + a * cartanCommutator N B hc h hn b := by
  apply inclusion_injective N B hc
  have hd (u : U N) : inclusion N (cartanCommutator N B hc h hn u) = commutator N B h u :=
    inclusion_cartanCommutator N B hc h hn u
  simpa only [map_add, map_mul, hd] using commutator_mul N B h a b

variable (E : Type*) [AddCommGroup E] [Module (U B) E] [Module ℂ E]

theorem cartan_tensor (h : B) (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N)
    (a : U N) (e : E) :
    (ι ℂ (h : G)) • induceTensor (inclusion B) (inclusion N a) e =
      induceTensor (inclusion B) (inclusion N (cartanCommutator N B hc h hn a)) e +
      induceTensor (inclusion B) (inclusion N a) (ι ℂ h • e) := by
  rw [smul_tensor, ← balance_tensor (inclusion B) (inclusion N a) (ι ℂ h), inclusion_ι,
    inclusion_cartanCommutator]
  simp only [induceTensor, ← map_add, ← TensorProduct.add_tmul, sub_add_cancel]

theorem cartan : Cartan N B E :=
  fun hc h hn => ⟨cartanCommutator N B hc h hn, inclusion_cartanCommutator N B hc h hn,
    cartanCommutator_generator N B hc h hn, cartanCommutator_mul N B hc h hn,
    cartan_tensor N B hc E h hn⟩

end Cartan

open Specs.LieAlgebrasAndRepresentations.VermaModules in
theorem finiteVerma {G : Type*} [LieRing G] [LieAlgebra ℂ G]
    (H : LieSubalgebra ℂ G) (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) :
    FiniteVerma H φ χ :=
  ⟨LinearEquiv.refl _ _, fun _ _ => rfl⟩

section FiniteVerma

open Specs.LieAlgebrasAndRepresentations.VermaModules

open private negative_borel_isCompl from
  MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.VermaModules

variable {G : Type*} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
variable (H : LieSubalgebra ℂ G) [H.IsCartanSubalgebra] (φ : Direction H)

theorem finiteBorelCompl : FiniteBorelCompl H φ := by
  intro hss hφ
  exact negative_borel_isCompl H φ hss
    (LieAlgebrasAndRepresentations.RealRootSpace.cartan_isMaximalToral hss H) hφ

theorem finiteVermaPresentation (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) :
    FiniteVermaPresentation H φ χ := by
  intro hss hφ μ hχ e he
  obtain ⟨F,hF⟩ := LieAlgebrasAndRepresentations.VermaModules.induced_presentation hss H φ hφ μ χ hχ e he
  obtain ⟨F',hF'⟩ := finiteVerma H φ χ
  refine ⟨F.trans F'.symm, fun a => F'.symm_apply_eq.mpr ?_⟩
  exact (hF a).trans (hF' a 1).symm

end FiniteVerma

