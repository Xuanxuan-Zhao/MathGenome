import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Quiver.Forms
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.Quivers.OneArrow
import Mathlib.Algebra.Module.ULift

/-! The finite-dimensional representations of the quiver with one arrow. -/

open CategoryTheory CategoryTheory.Limits
open scoped RM03.OneArrowSpec

namespace RepTheorySurvey.Quiver.SingleArrowObjectsSpec

set_option linter.checkUnivs false

universe w d

abbrev Vertex := RM03.OneArrowSpec.Vertex

abbrev Rep (k : Type w) [Field k] :=
  RM03.QuiverRepresentation.{0, 0, w, max w d} k Vertex

abbrev FiniteRep (k : Type w) [Field k] :=
  FormsSpec.FiniteRepresentation.{0, 0, w, max w d} k Vertex

/-- The labels of the three isomorphism classes. -/
inductive Kind
  | source
  | target
  | identity
  deriving DecidableEq

instance : Fintype Kind where
  elems := {.source, .target, .identity}
  complete j := by cases j <;> simp

noncomputable def S₁ (k : Type w) [Field k] : Rep.{w, d} k :=
  FormsSpec.vertexSimple.{0, 0, w, d} k false

noncomputable def S₂ (k : Type w) [Field k] : Rep.{w, d} k :=
  FormsSpec.vertexSimple.{0, 0, w, d} k true

def P₁ (k : Type w) [Field k] : Rep.{w, d} k :=
  RM03.OneArrowSpec.representation (LinearMap.id : ULift.{d} k →ₗ[k] ULift.{d} k)

noncomputable def representative (k : Type w) [Field k] : Kind → Rep.{w, d} k
  | .source => S₁ k
  | .target => S₂ k
  | .identity => P₁ k

abbrev ObjectType := ∀ (k : Type w) [Field k], Rep.{w, d} k

abbrev RepresentativeType := ∀ (k : Type w) [Field k], Kind → Rep.{w, d} k

abbrev FiniteRepresentatives : Prop :=
  ∀ (k : Type w) [Field k] (j : Kind),
    RM03.QuiverModuleEquivalenceSpec.finiteRepresentations (representative.{w, d} k j)

abbrev IndecomposableRepresentatives : Prop :=
  ∀ (k : Type w) [Field k] (j : Kind), Indecomposable (representative.{w, d} k j)

abbrev DistinctRepresentatives : Prop :=
  ∀ (k : Type w) [Field k] (i j : Kind),
    Nonempty (representative.{w, d} k i ≅ representative k j) → i = j

abbrev Classification : Prop :=
  ∀ (k : Type w) [Field k] (V : FiniteRep.{w, d} k),
    Indecomposable V.obj ↔ ∃! j : Kind, Nonempty (V.obj ≅ representative.{w, d} k j)

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

/-- Every finite-dimensional representation is a finite direct sum of the three models.
The multiplicity of each of the three summands may be zero. -/
abbrev Decomposition : Prop :=
  ∀ (k : Type w) [Field k] (V : FiniteRep.{w, d} k),
    ∃ n : Kind → ℕ,
      Nonempty (V.obj ≅ ⨁ fun j : Σ i : Kind, Fin (n i) => representative.{w, d} k j.1)

/-- Apply the pinned left-module-to-representation construction to the left ideal
generated by the vertex idempotent at the source. -/
abbrev ProjectiveAgreement : Prop :=
  ∀ (k : Type w) [Field k],
    Nonempty (RM03.ModuleVerticesSpec.representation
      (ModuleCat.of (RM03.PathAlgebra k Vertex)
        (ULift.{d} (FormsSpec.projectiveAt k (false : Vertex)))) ≅ P₁.{w, d} k)

end RepTheorySurvey.Quiver.SingleArrowObjectsSpec
