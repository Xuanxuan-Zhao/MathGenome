import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Quiver.Forms
import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Quivers.ModuleEquivalence
import Mathlib.Algebra.Category.ModuleCat.Projective
import Mathlib.CategoryTheory.Abelian.Projective.Resolution

/-! The two-term projective resolution of a quiver representation. -/

open CategoryTheory
open scoped DirectSum TensorProduct

universe u v w d

namespace RepTheorySurvey.Quiver.PathResolutionSpec

noncomputable section

open RM03
open scoped Classical

variable {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]

local notation "A" => PathAlgebra k Q

abbrev VertexProjective (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    (i : Q) := FormsSpec.projectiveAt k i

variable (V : QuiverRepresentation.{u, v, w, d} k Q)

abbrev DegreeZero := ⨁ i : Q, VertexProjective k i ⊗[k] V.vertex i

abbrev DegreeOne := ⨁ a : Arrow Q, VertexProjective k a.2.1 ⊗[k] V.vertex a.1

abbrev Target := (QuiverModuleEquivalence.inverse k Q).obj V

/-- The path (p), viewed in the left ideal generated by its source idempotent. -/
def pathVector {i j : Q} (p : Quiver.Path i j) : VertexProjective k i :=
  ⟨PathAlgebra.ofPath k (Path.ofPath p), Submodule.mem_span_singleton.mpr
    ⟨PathAlgebra.ofPath k (Path.ofPath p), by
      change PathAlgebra.ofPath k (Path.ofPath p) * PathAlgebra.vertex k i = _
      simp⟩⟩

/-- Right multiplication by the arrow in the corresponding left ideals. -/
def appendArrow {i j : Q} (a : i ⟶ j) : VertexProjective k j →ₗ[A] VertexProjective k i where
  toFun p := ⟨(p : A) * PathAlgebra.arrow k a, Submodule.mem_span_singleton.mpr
    ⟨(p : A) * PathAlgebra.arrow k a, by
      change ((p : A) * PathAlgebra.arrow k a) * PathAlgebra.vertex k i = _
      rw [mul_assoc, PathAlgebra.arrow_eq_ofPath]
      simp⟩⟩
  map_add' x y := Subtype.ext (add_mul (x : A) (y : A) _)
  map_smul' t x := Subtype.ext (mul_assoc t (x : A) _)

abbrev insertZero (i : Q) :=
  DirectSum.lof A Q (fun j => VertexProjective k j ⊗[k] V.vertex j) i

abbrev insertOne (a : Arrow Q) :=
  DirectSum.lof A (Arrow Q) (fun b => VertexProjective k b.2.1 ⊗[k] V.vertex b.1) a

/-- The specified maps on the tensor sums, with a length-one projective resolution
in the same module category as the inverse-equivalence object. -/
structure Resolution where
  boundary : DegreeOne V →ₗ[A] DegreeZero V
  augmentation : DegreeZero V →ₗ[A] Target V
  boundary_tmul : ∀ (a : Arrow Q) (p : VertexProjective k a.2.1) (x : V.vertex a.1),
    boundary (insertOne V a (p ⊗ₜ[k] x)) =
      insertZero V a.1 (appendArrow a.2.2 p ⊗ₜ[k] x) -
        insertZero V a.2.1 (p ⊗ₜ[k] V.arrow a.2.2 x)
  augmentation_path : ∀ {i j : Q} (p : Quiver.Path i j) (x : V.vertex i),
    QuiverModuleEquivalence.coordinates V
      (augmentation (insertZero V i (pathVector p ⊗ₜ[k] x))) =
      PathOperators.inclusion V j (V.mapPath p x)
  injective_boundary : Function.Injective boundary
  exact : Function.Exact boundary augmentation
  surjective_augmentation : Function.Surjective augmentation
  resolution : ProjectiveResolution (Target V)
  degreeZero : resolution.complex.X 0 ≃ₗ[A] DegreeZero V
  degreeOne : resolution.complex.X 1 ≃ₗ[A] DegreeOne V
  differential : ∀ x, degreeZero (resolution.complex.d 1 0 x) = boundary (degreeOne x)
  augment : ∀ x, (resolution.π.f 0 x : Target V) = augmentation (degreeZero x)
  higher : ∀ n : ℕ, Limits.IsZero (resolution.complex.X (n + 2))

abbrev VertexProjectiveIsProjective : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q] (i : Q),
    Module.Projective (PathAlgebra k Q) (VertexProjective k i)

abbrev TensorLeftAction : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    (V : QuiverRepresentation.{u, v, w, d} k Q) (i j : Q)
    (r : PathAlgebra k Q) (p : VertexProjective k i) (x : V.vertex j),
    r • (p ⊗ₜ[k] x) = (r • p) ⊗ₜ[k] x

abbrev DegreeZeroIsProjective : Prop :=
  ∀ {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    (V : QuiverRepresentation.{u, v, w, d} k Q),
    Module.Projective (PathAlgebra k Q) (DegreeZero V)

abbrev DegreeOneIsProjective : Prop :=
  ∀ {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    (V : QuiverRepresentation.{u, v, w, d} k Q),
    Module.Projective (PathAlgebra k Q) (DegreeOne V)

abbrev ResolutionExists : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    [Fintype (Arrow Q)], ¬ HasOrientedCycle Q →
      ∀ V : FormsSpec.FiniteRepresentation.{u, v, w, d} k Q, Nonempty (Resolution V.obj)

end

end RepTheorySurvey.Quiver.PathResolutionSpec
