import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Quiver.SimpleReflections
import Mathlib.LinearAlgebra.RootSystem.Base

/-! The graph roots in the dimension-vector lattice and their real root system. -/

open scoped Matrix

-- Vertices and arrows have independent universes.
set_option linter.checkUnivs false

universe u v

namespace RepTheorySurvey.Quiver.PositiveRootsSpec

open FormsSpec SimpleReflectionsSpec

abbrev WeylGroupType :=
  ∀ (Q : Type u) [Quiver.{v} Q] [Fintype Q],
    Subgroup (DimensionVector Q ≃ₗ[ℤ] DimensionVector Q)

/-- The subgroup generated by the vertex reflections on integral dimension vectors. -/
noncomputable def weylGroup : WeylGroupType.{u, v} :=
  fun Q [_] [_] => Subgroup.closure (Set.range (simpleReflection (Q := Q) ℤ))

abbrev RootSetType :=
  ∀ (Q : Type u) [Quiver.{v} Q] [Fintype Q], Set (DimensionVector Q)

/-- The union of the Weyl orbits of the vertex unit vectors. -/
noncomputable def roots : RootSetType.{u, v} :=
  fun Q [_] [_] =>
    {d | ∃ (i : Q) (w : weylGroup Q), (w : DimensionVector Q ≃ₗ[ℤ] DimensionVector Q)
      (unitVector i) = d}

/-- The roots with nonnegative coordinates in the vertex basis. -/
noncomputable def positiveRoots : RootSetType.{u, v} :=
  fun Q [_] [_] => {d ∈ roots Q | ∀ i, 0 ≤ d i}

abbrev RootsHaveTitsValueOne : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q →
    ∀ d ∈ roots Q, titsForm d = 1

abbrev FiniteRoots : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q → PositiveDefinite Q → (roots Q).Finite

/-- The roots and coroots are indexed by the integral orbit vectors. In the
identification of the two real spaces by the polarization, each coroot is
the same vector as its root. The base consists of the vertex unit vectors. -/
abbrev RootSystemRealisation : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q → PositiveDefinite Q →
    ∃ P : RootPairing ↥(roots Q) ℝ (Q → ℝ) (Q → ℝ),
      P.IsRootSystem ∧ P.IsReduced ∧ P.IsCrystallographic ∧
      (∀ x y, P.toLinearMap x y = x ⬝ᵥ (polarizationMatrix ℝ *ᵥ y)) ∧
      (∀ α, P.root α = (fun i => (α.val i : ℝ)) ∧
        P.coroot α = (fun i => (α.val i : ℝ))) ∧
      ∃ b : P.Base, P.root '' (b.support : Set ↥(roots Q)) = Set.range (vertexUnit ℝ)

abbrev PositiveRootsCharacterization : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q → PositiveDefinite Q →
    positiveRoots Q = {d | (∀ i, 0 ≤ d i) ∧ titsForm d = 1}

end RepTheorySurvey.Quiver.PositiveRootsSpec
