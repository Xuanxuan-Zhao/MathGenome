import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Quivers.PathAlgebra
import MathGenome.Internal.RingModuleAssociativeAlgebra.RM03.Quivers.Representations
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.Quivers.AcyclicFiniteness
import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.Quivers.ModuleEquivalence
import Mathlib.Algebra.Category.ModuleCat.Biproducts
import Mathlib.CategoryTheory.Simple
import Mathlib.CategoryTheory.Limits.FunctorCategory.BinaryBiproducts
import Mathlib.Data.Matrix.Mul
import Mathlib.Basic.Real.Basic
import Mathlib.LinearAlgebra.Span.Defs

/-! The Euler and Tits forms and their representation-theoretic objects. -/

open CategoryTheory
open scoped BigOperators Matrix

-- Signatures retain the independent universes of vertices, arrows, scalars, and modules.
set_option linter.checkUnivs false

universe u v w d r

namespace RepTheorySurvey.Quiver.FormsSpec

abbrev DimensionVectorType := Type u → Type u

abbrev DimensionVector : DimensionVectorType.{u} := fun Q => Q → ℤ

abbrev UnitVectorType := ∀ {Q : Type u}, Q → DimensionVector Q

/-- The dimension vector supported at a single vertex. -/
noncomputable def unitVector : UnitVectorType.{u} := fun {_} i j =>
  open Classical in if j = i then 1 else 0

section Representations

abbrev ProjectiveAtType :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q],
    Q → Submodule (RM03.PathAlgebra k Q) (RM03.PathAlgebra k Q)

/-- The left ideal generated by the vertex idempotent. -/
noncomputable def projectiveAt : ProjectiveAtType.{u, v, w} :=
  fun k {_} [_] [_] [_] i => Submodule.span _ {RM03.PathAlgebra.vertex k i}

abbrev FiniteRepresentationTypeSignature :=
  ∀ (k : Type w) (Q : Type u) [Field k] [Quiver.{v} Q], Type (max u v w (d + 1))

abbrev FiniteRepresentation : FiniteRepresentationTypeSignature.{u, v, w, d} :=
  fun k Q [_] [_] =>
    (RM03.QuiverModuleEquivalenceSpec.finiteRepresentations.{u, v, w, d}
      (k := k) (Q := Q)).FullSubcategory

abbrev DimensionVectorOfType :=
  ∀ {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q],
    FiniteRepresentation.{u, v, w, d} k Q → DimensionVector Q

noncomputable def dimensionVector : DimensionVectorOfType.{u, v, w, d} :=
  fun {k} {_} [_] [_] V i => (Module.finrank k (RM03.QuiverRepresentation.vertex V.obj i) : ℤ)

abbrev VertexSimpleType :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q],
    Q → RM03.QuiverRepresentation.{u, v, w, max w d} k Q

/-- The representation with a copy of the field at one vertex and zero arrow maps. -/
noncomputable def vertexSimple : VertexSimpleType.{u, v, w, d} :=
  fun k {_} [_] [_] i =>
    open Classical in
    RM03.QuiverRepresentation.ofArrows
      (fun j => if j = i then ModuleCat.of k (ULift.{d} k)
        else ModuleCat.of k PUnit.{max w d + 1})
      (fun _ => 0)

abbrev FiniteAtVertexSimple : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] (i : Q),
    RM03.QuiverModuleEquivalenceSpec.finiteRepresentations (vertexSimple.{u, v, w, d} k i)

abbrev VertexSimpleIsSimple : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] (i : Q),
    Simple (vertexSimple.{u, v, w, d} k i)

abbrev VertexSimpleDimension : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] (i : Q)
    (h : RM03.QuiverModuleEquivalenceSpec.finiteRepresentations (vertexSimple.{u, v, w, d} k i)),
    dimensionVector (⟨vertexSimple k i, h⟩ : FiniteRepresentation.{u, v, w, max w d} k Q) =
      unitVector i

abbrev FiniteRetract : Prop :=
  ∀ {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q]
    {V W : RM03.QuiverRepresentation.{u, v, w, d} k Q}
    (f : W ⟶ V) (g : V ⟶ W), f ≫ g = 𝟙 W →
    RM03.QuiverModuleEquivalenceSpec.finiteRepresentations V →
    RM03.QuiverModuleEquivalenceSpec.finiteRepresentations W

abbrev ProjectiveAtMembership : Prop :=
  ∀ (k : Type w) {Q : Type u} [Field k] [Quiver.{v} Q] [Fintype Q]
    (i : Q) (x : RM03.PathAlgebra k Q),
    x ∈ projectiveAt k i ↔ ∃ a : RM03.PathAlgebra k Q, a * RM03.PathAlgebra.vertex k i = x

/-- Pull back isomorphism in the representation category to a type of representatives. -/
abbrev isoSetoid {C : Type*} [Category C] {X : Type*} (obj : X → C) : Setoid X where
  r X Y := Nonempty (obj X ≅ obj Y)
  iseqv :=
    ⟨fun X => ⟨Iso.refl (obj X)⟩, fun ⟨f⟩ => ⟨f.symm⟩, fun ⟨f⟩ ⟨g⟩ => ⟨f.trans g⟩⟩

abbrev IndecomposableRepresentation : FiniteRepresentationTypeSignature.{u, v, w, d} :=
  fun k Q [_] [_] => {V : FiniteRepresentation.{u, v, w, d} k Q // Indecomposable V.obj}

abbrev RepresentationClass : FiniteRepresentationTypeSignature.{u, v, w, d} :=
  fun k Q [_] [_] => Quotient (isoSetoid (fun V : FiniteRepresentation.{u, v, w, d} k Q => V.obj))

abbrev IndecomposableClass : FiniteRepresentationTypeSignature.{u, v, w, d} :=
  fun k Q [_] [_] =>
    Quotient (isoSetoid (fun V : IndecomposableRepresentation.{u, v, w, d} k Q => V.val.obj))

abbrev IsFiniteRepresentationTypeSignature :=
  ∀ (k : Type w) (Q : Type u) [Field k] [Quiver.{v} Q], Prop

def FiniteRepresentationType : IsFiniteRepresentationTypeSignature.{u, v, w} :=
  fun k Q [_] [_] => Finite (IndecomposableClass.{u, v, w, d} k Q)

abbrev DimensionVectorIso : Prop :=
  ∀ {k : Type w} {Q : Type u} [Field k] [Quiver.{v} Q]
    {V W : FiniteRepresentation.{u, v, w, d} k Q},
    (V.obj ≅ W.obj) → dimensionVector V = dimensionVector W

-- The expected values refer to the canonical definitions above.
noncomputable def expectedProjectiveAt := @projectiveAt.{u, v, w}
def expectedFiniteRepresentation := @FiniteRepresentation.{u, v, w, d}
noncomputable def expectedDimensionVector := @dimensionVector.{u, v, w, d}
noncomputable def expectedVertexSimple := @vertexSimple.{u, v, w, d}
def expectedIndecomposableRepresentation := @IndecomposableRepresentation.{u, v, w, d}
def expectedRepresentationClass := @RepresentationClass.{u, v, w, d}
def expectedIndecomposableClass := @IndecomposableClass.{u, v, w, d}
def expectedFiniteRepresentationType := @FiniteRepresentationType.{u, v, w, d}

end Representations

section Forms

abbrev EulerFormType :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)]
    {R : Type r} [CommRing R], (Q → R) → (Q → R) → R

/-- The vertex contribution minus the arrow contribution, with source in the first argument. -/
def eulerForm : EulerFormType.{u, v, r} :=
  fun {Q} [_] [_] [_] {_} [_] x y =>
    (∑ i : Q, x i * y i) - ∑ a : RM03.Arrow Q, x a.1 * y a.2.1

abbrev TitsFormType :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)]
    {R : Type r} [CommRing R], (Q → R) → R

def titsForm : TitsFormType.{u, v, r} :=
  fun {_} [_] [_] [_] {_} [_] x => eulerForm x x

abbrev EdgeMultiplicityType := ∀ {Q : Type u} [Quiver.{v} Q], Q → Q → ℕ

/-- Count the arrows in both directions. Acyclic quivers have no loops. -/
noncomputable def edgeMultiplicity : EdgeMultiplicityType.{u, v} :=
  fun {_} [_] i j => Nat.card (i ⟶ j) + Nat.card (j ⟶ i)

abbrev PolarizationMatrixType :=
  ∀ {Q : Type u} [Quiver.{v} Q] (R : Type r) [CommRing R], Matrix Q Q R

noncomputable def polarizationMatrix : PolarizationMatrixType.{u, v, r} :=
  fun {_} [_] R [_] i j =>
    open Classical in if i = j then 2 else -(edgeMultiplicity i j : R)

abbrev PositiveDefiniteType :=
  ∀ (Q : Type u) [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)], Prop

def PositiveDefinite : PositiveDefiniteType.{u, v} :=
  fun Q [_] [_] [_] => ∀ x : Q → ℝ, x ≠ 0 → 0 < titsForm x

abbrev RealTitsFormOfInt : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)]
    (x : DimensionVector Q), titsForm (fun i => (x i : ℝ)) = (titsForm (R := ℤ) x : ℝ)

abbrev NoLoop : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q], ¬ RM03.HasOrientedCycle Q → ∀ i : Q, IsEmpty (i ⟶ i)

abbrev SymmetricPolarizationMatrix : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] (R : Type r) [CommRing R],
    (polarizationMatrix (Q := Q) R).transpose = polarizationMatrix R

abbrev IntegralPolarization : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q → ∀ x y : DimensionVector Q,
    titsForm (x + y) - titsForm x - titsForm y = x ⬝ᵥ (polarizationMatrix ℤ *ᵥ y)

abbrev RealQuadraticMatrix : Prop :=
  ∀ {Q : Type u} [Quiver.{v} Q] [Fintype Q] [Fintype (RM03.Arrow Q)],
    ¬ RM03.HasOrientedCycle Q → ∀ x : Q → ℝ, 2 * titsForm x = x ⬝ᵥ (polarizationMatrix ℝ *ᵥ x)

end Forms

end RepTheorySurvey.Quiver.FormsSpec
