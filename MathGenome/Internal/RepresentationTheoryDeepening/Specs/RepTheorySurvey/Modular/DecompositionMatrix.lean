import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.BrauerCharacterBasis
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.CharacterReduction
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.CompositionMultiplicities
import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.GroupTheory.QuotientGroup.Defs
import Batteries.Tactic.OpenPrivate

/-! Independent specifications for MR06, the decomposition matrix and homomorphism. -/

namespace RepTheorySurvey.Modular.MR06Spec

universe uG uO uK uF uV uW uI uJ

open IsLocalRing (ResidueField)
open scoped BigOperators

set_option linter.checkUnivs false
set_option backward.isDefEq.respectTransparency false

section GrothendieckGroup

variable (F : Type uF) [Field F] (G : Type uG) [Group G]

/-- Finite-dimensional native left group-algebra modules in the indicated carrier universe. -/
abbrev FiniteModule :=
  {V : ModuleCat.{uV} (MonoidAlgebra F G) // CompositionMultiplicity.GroundFinite F G V}

variable {F G}

def finiteModuleIsoSetoid : Setoid (FiniteModule.{uG, uF, uV} F G) where
  r V W := Nonempty ((V.val : Type uV) ≃ₗ[MonoidAlgebra F G] (W.val : Type uV))
  iseqv :=
    ⟨fun _ => ⟨LinearEquiv.refl _ _⟩, fun ⟨e⟩ => ⟨e.symm⟩,
      fun ⟨e⟩ ⟨f⟩ => ⟨e.trans f⟩⟩

variable (F G)

/-- The generators are isomorphism classes of finite-dimensional modules. -/
abbrev ModuleIsoClass :=
  Quotient (finiteModuleIsoSetoid (F := F) (G := G))

variable {F G}

def freeModuleClass (V : FiniteModule.{uG, uF, uV} F G) :
    FreeAbelianGroup (ModuleIsoClass.{uG, uF, uV} F G) :=
  FreeAbelianGroup.of (Quotient.mk _ V)

variable (F G)

/-- The relations of the presentation are generated by the short exact sequences. -/
def exactRelations : AddSubgroup (FreeAbelianGroup (ModuleIsoClass.{uG, uF, uV} F G)) :=
  AddSubgroup.closure {z | ∃ (U V W : FiniteModule.{uG, uF, uV} F G)
    (f : U.val →ₗ[MonoidAlgebra F G] V.val) (q : V.val →ₗ[MonoidAlgebra F G] W.val),
    Function.Injective f ∧ Function.Surjective q ∧ Function.Exact f q ∧
      z = freeModuleClass V - (freeModuleClass U + freeModuleClass W)}

def grothendieckGroupType :=
  (F : Type uF) → [Field F] → (G : Type uG) → [Group G] → Type (max uF uG (uV + 1))

/-- The abelian group generated by isomorphism classes with the exact-sequence relations. -/
abbrev grothendieckGroupValue : grothendieckGroupType.{uG, uF, uV} :=
  fun F _ G _ => FreeAbelianGroup (ModuleIsoClass.{uG, uF, uV} F G) ⧸
    exactRelations.{uG, uF, uV} F G

def moduleClassType :=
  {F : Type uF} → [Field F] → {G : Type uG} → [Group G] →
    (V : Type uV) → [AddCommGroup V] → [Module (MonoidAlgebra F G) V] →
    [CompositionMultiplicity.GroundFinite F G V] → grothendieckGroupValue.{uG, uF, uV} F G

/-- The class of a finite-dimensional left module in the presented group. -/
noncomputable def moduleClassValue : moduleClassType.{uG, uF, uV} :=
  fun V _ _ hV =>
    QuotientAddGroup.mk' (exactRelations _ _) (freeModuleClass ⟨ModuleCat.of _ V, hV⟩)

end GrothendieckGroup

section Decomposition

variable {G : Type uG} [Group G] [Finite G] {p : ℕ}
  {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  {K : Type uK} [Field K] [Algebra O K]

def decompositionMultiplicityType :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K],
    MR01Spec.SplittingSystemData G p O K →
      (V : Type uV) → [AddCommGroup V] → [Module (MonoidAlgebra K G) V] →
      (S : Type uW) → [AddCommGroup S] → [Module (MonoidAlgebra (ResidueField O) G) S] → ℕ

/-- The least multiplicity realized by a lattice reduction. The lattice theorem below
shows that for a finite-dimensional module every stable lattice realizes this value. -/
noncomputable def decompositionMultiplicityValue :
    decompositionMultiplicityType.{uG, uO, uK, uV, uW} :=
  @fun G _ _ _ O _ _ _ K _ _ _ V _ _ S _ _ =>
    sInf {n | ∃ L : MR04LatticeSpec.NativeLatticeData O K G V,
      CompositionMultiplicity.Spec.multiplicity (ResidueField O) G (MR04LatticeSpec.nativeReduction L) S = n}

def decompositionMatrixType :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K],
    MR01Spec.SplittingSystemData G p O K →
      {ι : Type uI} → (ι → ModuleCat.{uV} (MonoidAlgebra K G)) →
      {κ : Type uJ} → (κ → ModuleCat.{uW} (MonoidAlgebra (ResidueField O) G)) → Matrix ι κ ℕ

/-- With the given labels, the row is indexed by the ordinary module and the column by
the modular simple. -/
noncomputable def decompositionMatrixValue :
    decompositionMatrixType.{uG, uO, uK, uV, uW, uI, uJ} :=
  @fun _ _ _ _ _ _ _ _ _ _ _ system _ V _ S χ i =>
    decompositionMultiplicityValue system (V χ) (S i)

/-- Every stable lattice gives the canonical coefficient for a modular simple. -/
def decompositionMultiplicityEqLattice : Prop :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] (system : MR01Spec.SplittingSystemData G p O K)
    (V : Type uV) [AddCommGroup V] [Module (MonoidAlgebra K G) V] [CompositionMultiplicity.GroundFinite K G V]
    (S : Type uW) [AddCommGroup S] [Module (MonoidAlgebra (ResidueField O) G) S] [IsSimpleModule (MonoidAlgebra (ResidueField O) G) S]
    (L : MR04LatticeSpec.NativeLatticeData O K G V),
    decompositionMultiplicityValue system V S =
      CompositionMultiplicity.Spec.multiplicity (ResidueField O) G (MR04LatticeSpec.nativeReduction L) S

open private finiteRestrictedScalarsOfSimple from MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.BrauerCharacterBasis

/-- The ordinary character of every finite-dimensional module, restricted to regular classes,
is the sum of the lifted simple Brauer characters with the decomposition coefficients. -/
def decompositionCharacterFormula : Prop :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] (system : MR01Spec.SplittingSystemData G p O K)
    {κ : Type uJ} [Fintype κ] (S : κ → ModuleCat.{max uO uV} (MonoidAlgebra (ResidueField O) G))
    (hS : MR01Spec.SimpleRepresentativeFamily S)
    (V : Type (max uO uV)) [AddCommGroup V] [Module (MonoidAlgebra K G) V]
    [Module.Finite K (RestrictScalars K (MonoidAlgebra K G) V)],
    (fun c : MR03Spec.pRegularConjClassesValue G p => MR03Spec.ordinaryClassCharacterValue (K := K) V c.val) =
      ∑ i, (decompositionMultiplicityValue system V (S i) : K) •
        (fun c : MR03Spec.pRegularConjClassesValue G p =>
          letI := hS.simple i
          letI := finiteRestrictedScalarsOfSimple (F := ResidueField O) (A := MonoidAlgebra (ResidueField O) G) (M := S i)
          algebraMap O K (MR03Spec.brauerClassCharacterValue system (S i) c))

end Decomposition

section ReductionMap

variable {G : Type uG} [Group G] [Finite G] {p : ℕ}
  {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  {K : Type uK} [Field K] [Algebra O K]

/-- The defining action of the reduction homomorphism on all module classes. -/
def SendsLattices
    (d : grothendieckGroupValue.{uG, uK, uV} K G →+ grothendieckGroupValue.{uG, uO, uV} (ResidueField O) G) :
    Prop :=
  ∀ (V : Type uV) [AddCommGroup V] [Module (MonoidAlgebra K G) V]
    [CompositionMultiplicity.GroundFinite K G V] (L : MR04LatticeSpec.NativeLatticeData O K G V),
    letI : CompositionMultiplicity.GroundFinite (ResidueField O) G
        (MR04LatticeSpec.nativeReduction L) := MR04Spec.nativeReductionFinite V L
    d (moduleClassValue V) = moduleClassValue (MR04LatticeSpec.nativeReduction L)

def decompositionMapType :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K],
    MR01Spec.SplittingSystemData G p O K →
      grothendieckGroupValue.{uG, uK, max uO uV} K G →+
        grothendieckGroupValue.{uG, uO, max uO uV} (ResidueField O) G

/-- The homomorphism characterized by sending every module class to its lattice reduction. -/
noncomputable def decompositionMapValue : decompositionMapType.{uG, uO, uK, uV} :=
  @fun G _ _ _ O _ _ _ K _ _ _ => Classical.epsilon (SendsLattices (O := O) (K := K) (G := G))

/-- The canonical homomorphism has the required value for every lattice and is uniquely
determined by those values on module generators. -/
def decompositionMapOnClasses : Prop :=
  ∀ {G : Type uG} [Group G] [Finite G] {p : ℕ}
    {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] (system : MR01Spec.SplittingSystemData G p O K),
    let d := decompositionMapValue.{uG, uO, uK, uV} system
    SendsLattices d ∧ ∀ e, SendsLattices e → e = d

end ReductionMap

end RepTheorySurvey.Modular.MR06Spec
