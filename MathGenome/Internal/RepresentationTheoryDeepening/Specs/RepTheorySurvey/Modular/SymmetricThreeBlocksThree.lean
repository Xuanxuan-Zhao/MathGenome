import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.PrincipalBlockDefect
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.SymmetricThreeModules

namespace RepTheorySurvey.Modular.SymmetricThree.BlocksThreeSpec

universe u v

open IsLocalRing (ResidueField)

/-- In characteristic three there is one block. It is principal and its
unique defect group is the order-three Sylow subgroup generated by the three-cycle. -/
def principalAndDefect : Prop :=
  ∀ {O : Type u} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type v} [Field K] [Algebra O K],
    MR01Spec.SplittingSystemData Spec.GroupValue 3 O K →
    ∃ b : BlockIdempotent (ResidueField O) Spec.GroupValue,
      b.BelongsTo (Spec.trivialValue (ResidueField O)).asModule ∧
      (∀ b' : BlockIdempotent (ResidueField O) Spec.GroupValue, b' = b) ∧
      ∃ S : Sylow 3 Spec.GroupValue,
        (S : Subgroup Spec.GroupValue) = Subgroup.zpowers Spec.threeCycleValue ∧
        Nat.card S = 3 ∧
        ∀ P : Subgroup Spec.GroupValue,
          DefectGroupsSpec.isDefectGroup 3 b P ↔ P = (S : Subgroup Spec.GroupValue)

end RepTheorySurvey.Modular.SymmetricThree.BlocksThreeSpec
