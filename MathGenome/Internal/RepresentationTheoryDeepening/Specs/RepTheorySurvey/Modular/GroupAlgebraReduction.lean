import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.SplittingSystem
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.IdempotentLifting

/-! Independent specifications for coefficient reduction and adic completeness. -/

namespace RepTheorySurvey.Modular.MRGroupAlgebraReductionSpec

universe uO uG uK

-- These declarations describe types with independent coefficient and group universes.
set_option linter.checkUnivs false

def uniformizerIdealType :=
  (O : Type uO) → [CommRing O] → (G : Type uG) → [Group G] → O → Ideal (MonoidAlgebra O G)

/-- The ideal generated by the image of a coefficient in the group algebra. -/
noncomputable def uniformizerIdealValue : uniformizerIdealType.{uO, uG} :=
  fun O _ G _ t => Ideal.span {algebraMap O (MonoidAlgebra O G) t}

instance (O : Type uO) [CommRing O] (G : Type uG) [Group G] (t : O) :
    (uniformizerIdealValue O G t).IsTwoSided where
  mul_mem_of_left b ha := by
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    exact Ideal.mem_span_singleton'.mpr ⟨a * b,
      by rw [mul_assoc, (Algebra.commutes t b).symm, ← mul_assoc]⟩

def coefficientsType :=
  (O : Type uO) → [CommRing O] → (G : Type uG) → [Finite G] →
    MonoidAlgebra O G ≃ₗ[O] (G → O)

noncomputable def coefficientsValue : coefficientsType.{uO, uG} :=
  fun O _ G _ =>
    (MonoidAlgebra.coeffLinearEquiv O).trans (Finsupp.linearEquivFunOnFinite O O G)

def reductionSurjectiveType :=
  ∀ (O : Type uO) [CommRing O] (G : Type uG) [Group G] [IsLocalRing O],
    Function.Surjective (MR01Spec.reductionValue O G)

def memUniformizerIdealPowType :=
  ∀ (O : Type uO) [CommRing O] (G : Type uG) [Group G] [Finite G]
    (t : O) (n : ℕ) (a : MonoidAlgebra O G),
    a ∈ uniformizerIdealValue O G t ^ n ↔ ∀ g, a.coeff g ∈ (Ideal.span {t} : Ideal O) ^ n

def reductionKernelType :=
  ∀ (O : Type uO) [CommRing O] (G : Type uG) [Group G] [Finite G]
    {p : ℕ} {K : Type uK} [Field K] [Algebra O K] [IsDomain O] [IsDiscreteValuationRing O]
    (S : MR01Spec.SplittingSystemData G p O K),
    RingHom.ker (MR01Spec.reductionValue O G) = uniformizerIdealValue O G S.uniformizer

def completeSeparatedType :=
  ∀ (O : Type uO) [CommRing O] (G : Type uG) [Group G] [Finite G]
    {p : ℕ} {K : Type uK} [Field K] [Algebra O K] [IsDomain O] [IsDiscreteValuationRing O]
    (S : MR01Spec.SplittingSystemData G p O K),
    IsAdicCompleteSeparated (uniformizerIdealValue O G S.uniformizer)

def reductionQuotientType :=
  ∀ (O : Type uO) [CommRing O] (G : Type uG) [Group G] [Finite G]
    {p : ℕ} {K : Type uK} [Field K] [Algebra O K] [IsDomain O] [IsDiscreteValuationRing O]
    (S : MR01Spec.SplittingSystemData G p O K),
    ∃ e : ((MonoidAlgebra O G) ⧸ uniformizerIdealValue O G S.uniformizer) ≃ₐ[O]
        MonoidAlgebra (IsLocalRing.ResidueField O) G,
      ∀ a, e (Ideal.Quotient.mk (uniformizerIdealValue O G S.uniformizer) a) =
        MR01Spec.reductionValue O G a

end RepTheorySurvey.Modular.MRGroupAlgebraReductionSpec
