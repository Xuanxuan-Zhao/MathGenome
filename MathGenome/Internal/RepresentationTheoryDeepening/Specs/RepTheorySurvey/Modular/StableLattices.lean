import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Modular.SplittingSystem
import Mathlib.RingTheory.AdicCompletion.Functoriality
import Mathlib.RingTheory.IsTensorProduct

/-! The lattice and its quotient used in the reduction of modular representations. -/

namespace RepTheorySurvey.Modular

universe uO uK uG uV uM uN

open Module
open scoped Pointwise TensorProduct

set_option linter.checkUnivs false

namespace MR04LatticeSpec

section Lattice

/-- A finite free integral submodule spanning the ordinary space and stable under every group element. -/
structure LatticeData (O : Type uO) [CommRing O] {K : Type uK} [Field K] [Algebra O K]
    {G : Type uG} [Group G] {V : Type uV} [AddCommGroup V]
    [Module K V] [Module O V] [IsScalarTower O K V] (ρ : Representation K G V) where
  carrier : Submodule O V
  finite : Module.Finite O carrier
  free : Module.Free O carrier
  spans : Submodule.span K (carrier : Set V) = ⊤
  stable : ∀ (g : G) ⦃v : V⦄, v ∈ carrier → ρ g v ∈ carrier

def latticeType :=
  (O : Type uO) → [CommRing O] → {K : Type uK} → [Field K] → [Algebra O K] →
    {G : Type uG} → [Group G] → {V : Type uV} → [AddCommGroup V] →
    [Module K V] → [Module O V] → [IsScalarTower O K V] → Representation K G V → Type uV

abbrev latticeValue : latticeType.{uO, uK, uG, uV} :=
  fun O _ _ _ _ _ _ _ _ _ _ _ ρ => LatticeData O ρ

variable (O : Type uO) [CommRing O] {K : Type uK} [Field K] [Algebra O K]
  {G : Type uG} [Group G] {V : Type uV} [AddCommGroup V]
  [Module K V] [Module O V] [IsScalarTower O K V]

/-- The action restricted to the integral submodule. -/
def integralAction {ρ : Representation K G V} (L : LatticeData O ρ) :
    Representation O G L.carrier :=
  let ρO : Representation O G V :=
    { toFun := fun g => (ρ g).restrictScalars O
      map_one' := by ext v; simp
      map_mul' := by intro g h; ext v; simp }
  ρO.subrepresentation L.carrier fun g _ hv => L.stable g hv

end Lattice

section Residue

variable (O : Type uO) [CommRing O] [IsLocalRing O]

/-- Reduction of an integral module by the maximal ideal, which is generated by the uniformizer
in the splitting system. -/
abbrev ResidueQuotient (M : Type uM) [AddCommGroup M] [Module O M] :=
  M ⧸ (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M))

instance (M : Type uM) [AddCommGroup M] [Module O M] :
    Module (IsLocalRing.ResidueField O) (ResidueQuotient O M) :=
  inferInstanceAs (Module (O ⧸ IsLocalRing.maximalIdeal O)
    (M ⧸ (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M))))

instance (M : Type uM) [AddCommGroup M] [Module O M] :
    IsScalarTower O (IsLocalRing.ResidueField O) (ResidueQuotient O M) :=
  inferInstanceAs (IsScalarTower O (O ⧸ IsLocalRing.maximalIdeal O)
    (M ⧸ (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M))))

instance (M : Type uM) [AddCommGroup M] [Module O M] [Module.Finite O M] :
    Module.Finite (IsLocalRing.ResidueField O) (ResidueQuotient O M) :=
  inferInstanceAs (Module.Finite (O ⧸ IsLocalRing.maximalIdeal O)
    (M ⧸ (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M))))

variable {O} {M : Type uM} [AddCommGroup M] [Module O M]
  {N : Type uN} [AddCommGroup N] [Module O N]

/-- The quotient map before changing the coefficient ring. -/
def reduce : M →ₗ[O] ResidueQuotient O M :=
  (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M)).mkQ

/-- The map induced by an integral linear map on the residue quotients. -/
noncomputable def reduceMap (f : M →ₗ[O] N) :
    ResidueQuotient O M →ₗ[IsLocalRing.ResidueField O] ResidueQuotient O N :=
  f.reduceModIdeal (IsLocalRing.maximalIdeal O)

variable {G : Type uG} [Group G]

/-- The group acts on the residue quotient by the action on representatives. -/
noncomputable def residueAction (σ : Representation O G M) :
    Representation (IsLocalRing.ResidueField O) G (ResidueQuotient O M) where
  toFun g := reduceMap (σ g)
  map_one' := by
    apply LinearMap.ext
    intro q
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective
      (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M)) q
    rw [map_one]
    exact LinearMap.reduceModIdeal_apply _ LinearMap.id x
  map_mul' := by
    intro g h
    apply LinearMap.ext
    intro q
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective
      (IsLocalRing.maximalIdeal O • (⊤ : Submodule O M)) q
    rw [map_mul]
    rfl

/-- The residue representation as a native left group-algebra module. -/
noncomputable def residueModule (σ : Representation O G M) :
    ModuleCat.{uM} (MonoidAlgebra (IsLocalRing.ResidueField O) G) :=
  ModuleCat.of _ (residueAction σ).asModule

end Residue

section Native

variable (O : Type uO) [CommRing O] (K : Type uK) [Field K] [Algebra O K]
  (G : Type uG) [Group G] (M : Type uV) [AddCommGroup M] [Module (MonoidAlgebra K G) M]

/-- Stable lattices in a native group-algebra module with its canonical restrictions of scalars. -/
abbrev NativeLatticeData :=
  letI kModule : Module K (RestrictScalars K (MonoidAlgebra K G) M) :=
    RestrictScalars.module K (MonoidAlgebra K G) M
  letI oModule := Module.restrictScalars O K (RestrictScalars K (MonoidAlgebra K G) M)
  letI tower := IsScalarTower.restrictScalars O K (RestrictScalars K (MonoidAlgebra K G) M)
  @LatticeData O _ K _ _ G _ (RestrictScalars K (MonoidAlgebra K G) M) _
    kModule oModule tower (Representation.ofModule (k := K) (G := G) M)

variable {O K G M}

set_option backward.isDefEq.respectTransparency false in
/-- Reduction of a stable lattice in a native left `K[G]`-module. -/
noncomputable def nativeReduction [IsLocalRing O] (L : NativeLatticeData O K G M) :
    ModuleCat.{uV} (MonoidAlgebra (IsLocalRing.ResidueField O) G) :=
  let W := RestrictScalars K (MonoidAlgebra K G) M
  letI kModule : Module K W := RestrictScalars.module K (MonoidAlgebra K G) M
  let oModule := Module.restrictScalars O K W
  let tower := IsScalarTower.restrictScalars O K W
  @residueModule O _ _ _ _ _ G _ (@integralAction O _ K _ _ G _ W _ kModule oModule tower
    (Representation.ofModule (k := K) (G := G) M) L)

end Native

section FractionSpan

variable {O : Type uO} [CommRing O] {K : Type uK} [Field K] [Algebra O K]
  {V : Type uV} [AddCommGroup V] [Module O V] [Module K V] [IsScalarTower O K V]

/-- The inclusion of an integral submodule into its fraction-field span. -/
def toFractionSpan (L : Submodule O V) :
    L →ₗ[O] Submodule.span K (L : Set V) :=
  L.subtype.codRestrict ((Submodule.span K (L : Set V)).restrictScalars O)
    (fun x => Submodule.subset_span x.2)

end FractionSpan

def existsLattice :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] [IsFractionRing O K]
    {G : Type uG} [Group G] [Finite G] {V : Type uV} [AddCommGroup V]
    [Module K V] [Module O V] [IsScalarTower O K V] [Module.Finite K V]
    (ρ : Representation K G V), Nonempty (LatticeData O ρ)

def existsNativeLattice :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] {G : Type uG} [Group G] [Finite G] {p : ℕ},
    MR01Spec.SplittingSystemData G p O K →
    ∀ (V : Type uV) [AddCommGroup V] [Module (MonoidAlgebra K G) V]
      [Module.Finite K (RestrictScalars K (MonoidAlgebra K G) V)],
      Nonempty (NativeLatticeData O K G V)

def residueIsUniformizerQuotient :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    {K : Type uK} [Field K] [Algebra O K] {G : Type uG} [Group G] [Finite G] {p : ℕ}
    (S : MR01Spec.SplittingSystemData G p O K)
    (M : Type uM) [AddCommGroup M] [Module O M],
    IsLocalRing.maximalIdeal O • (⊤ : Submodule O M) = S.uniformizer • (⊤ : Submodule O M)

def residueActionOnClasses :=
  ∀ {O : Type uO} [CommRing O] [IsLocalRing O] {G : Type uG} [Group G]
    {M : Type uM} [AddCommGroup M] [Module O M] (σ : Representation O G M) (g : G) (x : M),
    residueAction σ g (reduce x) = reduce (O := O) (σ g x)

def residueBaseChange :=
  ∀ {O : Type uO} [CommRing O] [IsLocalRing O] (M : Type uM) [AddCommGroup M] [Module O M],
    IsBaseChange (IsLocalRing.ResidueField O) (reduce (O := O) (M := M))

def fractionSpanBaseChange :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] {K : Type uK} [Field K] [Algebra O K]
    [IsFractionRing O K] {V : Type uV} [AddCommGroup V] [Module O V] [Module K V]
    [IsScalarTower O K V] (L : Submodule O V), IsBaseChange K (toFractionSpan (K := K) L)

def finrankResidue :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] [IsLocalRing O]
    (M : Type uM) [AddCommGroup M] [Module O M] [Module.Free O M] [Module.Finite O M],
    Module.finrank (IsLocalRing.ResidueField O) (ResidueQuotient O M) = Module.finrank O M

def finrankFractionSpan :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] {K : Type uK} [Field K] [Algebra O K]
    [IsFractionRing O K] {V : Type uV} [AddCommGroup V] [Module O V] [Module K V]
    [IsScalarTower O K V] (L : Submodule O V),
    Module.finrank K (Submodule.span K (L : Set V)) = Module.finrank O L

def latticeBaseChange :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] {K : Type uK} [Field K] [Algebra O K]
    [IsFractionRing O K] {G : Type uG} [Group G] {V : Type uV} [AddCommGroup V]
    [Module K V] [Module O V] [IsScalarTower O K V] {ρ : Representation K G V}
    (L : LatticeData O ρ), IsBaseChange K L.carrier.subtype

def latticeFinrank :=
  ∀ {O : Type uO} [CommRing O] [IsDomain O] [IsLocalRing O]
    {K : Type uK} [Field K] [Algebra O K] [IsFractionRing O K]
    {G : Type uG} [Group G] {V : Type uV} [AddCommGroup V]
    [Module K V] [Module O V] [IsScalarTower O K V] {ρ : Representation K G V}
    (L : LatticeData O ρ), Module.finrank K V = Module.finrank O L.carrier ∧
      Module.finrank (IsLocalRing.ResidueField O) (ResidueQuotient O L.carrier) =
        Module.finrank O L.carrier

def reduceMapOnClasses :=
  ∀ {O : Type uO} [CommRing O] [IsLocalRing O] {M : Type uM} [AddCommGroup M] [Module O M]
    {N : Type uN} [AddCommGroup N] [Module O N] (f : M →ₗ[O] N) (x : M),
    reduceMap f (reduce (O := O) x) = reduce (O := O) (f x)

def residueActionOnAlgebra :=
  ∀ {O : Type uO} [CommRing O] [IsLocalRing O] {G : Type uG} [Group G]
    {M : Type uM} [AddCommGroup M] [Module O M] (σ : Representation O G M)
    (a : MonoidAlgebra O G) (x : M),
    (residueAction σ).asAlgebraHom (MR01Spec.reductionValue O G a) (reduce x) =
      reduce (O := O) (σ.asAlgebraHom a x)

def nativeLatticeType := type_of% (@NativeLatticeData)
def residueQuotientType := type_of% (@ResidueQuotient)
def integralActionType := type_of% (@integralAction)
def reduceType := type_of% (@reduce)
def reduceMapType := type_of% (@reduceMap)
def residueActionType := type_of% (@residueAction)
def residueModuleType := type_of% (@residueModule)
def nativeReductionType := type_of% (@nativeReduction)
def toFractionSpanType := type_of% (@toFractionSpan)

noncomputable abbrev residueActionValue : residueActionType := @residueAction
noncomputable abbrev residueModuleValue : residueModuleType := @residueModule
noncomputable abbrev nativeReductionValue : nativeReductionType := @nativeReduction

end MR04LatticeSpec
end RepTheorySurvey.Modular
