import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Invariants.Actions
import Mathlib.Algebra.CharP.Defs
import Mathlib.RingTheory.MvPolynomial.Homogeneous

noncomputable section

universe u v w

namespace RepTheorySurvey.Invariants.Specs

open MvPolynomial

variable {k : Type u} {G : Type v} {ι : Type w} [Field k] [Group G]

/-- The ideal generated by fixed homogeneous polynomials of degrees 1 through the bound. -/
def lowDegreeInvariantIdeal (ρ : GroupAlgebraAction k G (MvPolynomial ι k))
    (bound : ℕ) : Ideal (MvPolynomial ι k) :=
  Ideal.span {p | p ∈ groupFixedSubalgebra ρ ∧
    ∃ d : ℕ, 0 < d ∧ d ≤ bound ∧ p.IsHomogeneous d}

def LowDegreeInvariantIdealType :=
  ∀ {k : Type u} {G : Type v} {ι : Type w} [Field k] [Group G],
    GroupAlgebraAction k G (MvPolynomial ι k) → ℕ → Ideal (MvPolynomial ι k)

def NoetherBoundDegreeCardMonomial : Prop :=
  ∀ {k : Type u} {G : Type v} {ι : Type w} [Field k] [Group G] [Fintype G] [Fintype ι]
    (ρ : GroupAlgebraAction k G (MvPolynomial ι k)),
    (∀ g i, (ρ g (X i)).IsHomogeneous 1) →
    (ringChar k = 0 ∨ Fintype.card G < ringChar k) →
    ∀ a : ι →₀ ℕ, a.degree = Fintype.card G →
      monomial a (1 : k) ∈ lowDegreeInvariantIdeal ρ (Fintype.card G)

def NoetherBoundHomogeneous : Prop :=
  ∀ {k : Type u} {G : Type v} {ι : Type w} [Field k] [Group G] [Fintype G] [Fintype ι]
    (ρ : GroupAlgebraAction k G (MvPolynomial ι k)),
    (∀ g i, (ρ g (X i)).IsHomogeneous 1) →
    (ringChar k = 0 ∨ Fintype.card G < ringChar k) →
    ∀ d : ℕ, Fintype.card G ≤ d →
      ∀ p : MvPolynomial ι k, p.IsHomogeneous d →
        p ∈ lowDegreeInvariantIdeal ρ (Fintype.card G)

end RepTheorySurvey.Invariants.Specs
