import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.WeightBounds
import Mathlib.CategoryTheory.Preadditive.Projective.Basic
import Mathlib.LinearAlgebra.Dimension.Finrank

/-! The cutoff category and its projective representing a single Cartan weight. -/

noncomputable section

open CategoryTheory Module UniversalEnvelopingAlgebra
open scoped Classical ModuleCat.Algebra

namespace RepTheorySurvey.CategoryO.TruncatedProjectives

open Specs.RepTheorySurvey.CategoryO
open Specs.RepTheorySurvey.CategoryO.WeightBounds (support)
open BorelInduction (U inclusion Induced induceTensor)
open Specs.LieAlgebrasAndRepresentations.VermaModules (envelopingMap)

universe u v w

variable {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
variable (D : Setup g)

abbrev cartanInBorel : D.cartan →ₗ⁅ℂ⁆ D.borel :=
  LieSubalgebra.inclusion (show D.cartan ≤ D.borel from le_sup_left)

abbrev positiveInBorel : D.nPlus →ₗ⁅ℂ⁆ D.borel :=
  LieSubalgebra.inclusion (show D.nPlus ≤ D.borel from le_sup_right)

/-- Joint eigenspaces for the action of the Cartan inside the Borel. -/
def borelWeightSpace (V : Type v) [AddCommGroup V] [Module ℂ V] [Module (U D.borel) V]
    [IsScalarTower ℂ (U D.borel) V] (ν : D.Weight) : Submodule ℂ V :=
  ⨅ h : D.cartan, LinearMap.ker
    ((Algebra.lsmul ℂ ℂ V : U D.borel →ₐ[ℂ] Module.End ℂ V)
      (ι ℂ (cartanInBorel D h)) - ν h • LinearMap.id)

/-- The full cutoff subcategory uses the inherited enveloping-module morphisms. -/
def cutoffObjects (Λ : D.Weight) : ObjectProperty (ModuleCat.{v} (U g)) :=
  fun X => objects_value D X ∧ ∀ ν ∈ support D X, weightLE_value D ν Λ

abbrev Cutoff (Λ : D.Weight) := (cutoffObjects.{u, v} D Λ).FullSubcategory

/-- The Borel module freely generated by a vector on which the Cartan acts by μ. -/
def cartanRelations (μ : D.Weight) : Submodule (U D.borel) (U D.borel) :=
  Submodule.span (U D.borel) (Set.range fun h : D.cartan =>
    ι ℂ (cartanInBorel D h) - algebraMap ℂ (U D.borel) (μ h))

abbrev Raw (μ : D.Weight) := U D.borel ⧸ cartanRelations D μ

def rawGenerator (μ : D.Weight) : Raw D μ := (cartanRelations D μ).mkQ 1

/-- The cutoff quotient removes all the forbidden weight spaces.
Taking their enveloping span defines the quotient before stability is proved. -/
def discarded (μ Λ : D.Weight) : Submodule (U D.borel) (Raw D μ) :=
  Submodule.span (U D.borel)
    (↑(⨆ ν : {ν : D.Weight // ¬ weightLE_value D ν Λ},
      borelWeightSpace D (Raw D μ) ν.val) : Set (Raw D μ))

abbrev E (μ Λ : D.Weight) := Raw D μ ⧸ discarded D μ Λ

def generatorE (μ Λ : D.Weight) : E D μ Λ := (discarded D μ Λ).mkQ (rawGenerator D μ)

abbrev P (μ Λ : D.Weight) : ModuleCat.{u} (U g) :=
  ModuleCat.of (U g) (Induced (inclusion D.borel) (E D μ Λ))

def generatorP (μ Λ : D.Weight) : P D μ Λ := induceTensor (inclusion D.borel) 1 (generatorE D μ Λ)

/-- Span of an initial set of full weight spaces in the inducing module. -/
def initialSpace (μ Λ : D.Weight) (s : Finset D.Weight) : Submodule ℂ (E D μ Λ) :=
  ⨆ ν : (s : Set D.Weight), borelWeightSpace D (E D μ Λ) ν.val

/-- Image of induction on the initial weight spaces, expressed by their tensor generators. -/
def initialInduced (μ Λ : D.Weight) (s : Finset D.Weight) : Submodule (U g) (P D μ Λ) :=
  Submodule.span (U g) (induceTensor (inclusion D.borel) 1 '' (initialSpace D μ Λ s : Set _))

/-- The initial set consists of the weights at indices strictly below k. -/
def initialWeights {n : ℕ} (ν : Fin n → D.Weight) (k : Fin (n + 1)) : Finset D.Weight :=
  (Finset.univ.filter fun i => i.val < k.val).image ν

/-- Grouped filtration by full Borel weight spaces and their induced images.
The quotient uses the inclusion of consecutive submodules of the actual P. -/
structure GroupedFiltration (μ Λ : D.Weight) where
  length : ℕ
  weight : Fin length → D.Weight
  distinct : Function.Injective weight
  weights : ∀ ν, ν ∈ Set.range weight ↔ borelWeightSpace D (E D μ Λ) ν ≠ ⊥
  bounded : ∀ i, weightLE_value D μ (weight i) ∧ weightLE_value D (weight i) Λ
  higher_first : ∀ i j, weightLE_value D (weight i) (weight j) → i ≠ j → j < i
  borelTerm : Fin (length + 1) → Submodule (U D.borel) (E D μ Λ)
  borel_initial : ∀ k, (borelTerm k).restrictScalars ℂ =
    initialSpace D μ Λ (initialWeights D weight k)
  term : Fin (length + 1) → Submodule (U g) (P D μ Λ)
  induced_initial : ∀ k, term k = initialInduced D μ Λ (initialWeights D weight k)
  induced_inclusion : ∀ k, ∃ f : Induced (inclusion D.borel) (borelTerm k) →ₗ[U g] P D μ Λ,
    Function.Injective f ∧ LinearMap.range f = term k ∧
    ∀ a e, f (induceTensor (inclusion D.borel) a e) = induceTensor (inclusion D.borel) a e.val
  monotone : Monotone term
  first : term 0 = ⊥
  last : term (Fin.last length) = ⊤
  factors : ∀ i : Fin length,
    Nonempty (((term i.succ) ⧸ (term i.castSucc).comap (term i.succ).subtype) ≃ₗ[U g]
      (Fin (finrank ℂ (borelWeightSpace D (E D μ Λ) (weight i))) → verma_value D (weight i)))

private theorem mem_moduleWeightSpace (X : ModuleCat.{v} (U g)) (ν : D.Weight) (x : X) :
    x ∈ weightSpace_value D.cartan X ν ↔
      ∀ h : D.cartan, (ι ℂ (h : g)) • x = ν h • x := by
  let := restrictedLieRingModule X (g := g)
  let := restrictedLieModule X (g := g)
  change x ∈ LieModule.weightSpace X (ν : D.cartan → ℂ) ↔ _
  rw [LieModule.mem_weightSpace]
  simp only [LieSubalgebra.coe_bracket_of_module]
  rfl

/-- Weight evaluation on an enveloping-module map, of any carrier universe. -/
def weightMap {X : ModuleCat.{v} (U g)} {Y : ModuleCat.{w} (U g)}
    (f : X →ₗ[U g] Y) (ν : D.Weight) :
    weightSpace_value D.cartan X ν →ₗ[ℂ] weightSpace_value D.cartan Y ν :=
  ((f.restrictScalars ℂ).comp (weightSpace_value D.cartan X ν).subtype).codRestrict _
    (fun x => by
      apply (mem_moduleWeightSpace D Y ν (f x)).mpr
      intro h
      rw [← f.map_smul, (mem_moduleWeightSpace D X ν x).mp x.property h]
      exact (f.restrictScalars ℂ).map_smul (ν h) (x : X))

namespace Expected

/-- The canonical realization by the positively generated enveloping algebra.
The Cartan formula identifies all degree spaces with the shifted weight spaces. -/
def RawType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ : D.Weight),
    ∃ F : U D.nPlus ≃ₗ[ℂ] Raw D μ,
      (∀ a, F a = envelopingMap (positiveInBorel D) a • rawGenerator D μ) ∧
      (∀ (a : U D.nPlus) (ν : D.Weight),
        F a ∈ borelWeightSpace D (Raw D μ) ν ↔ ∀ h : D.cartan,
          ι ℂ (cartanInBorel D h) * envelopingMap (positiveInBorel D) a -
            envelopingMap (positiveInBorel D) a * ι ℂ (cartanInBorel D h) =
          (ν - μ) h • envelopingMap (positiveInBorel D) a) ∧
      DirectSum.IsInternal (borelWeightSpace D (Raw D μ)) ∧
      (∀ ν, FiniteDimensional ℂ (borelWeightSpace D (Raw D μ) ν)) ∧
      ∀ ν, borelWeightSpace D (Raw D μ) ν ≠ ⊥ → weightLE_value D μ ν

def TruncationType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    (discarded D μ Λ).restrictScalars ℂ =
      ⨆ ν : {ν : D.Weight // ¬ weightLE_value D ν Λ},
        borelWeightSpace D (Raw D μ) ν.val ∧
    FiniteDimensional ℂ (E D μ Λ) ∧
    DirectSum.IsInternal (borelWeightSpace D (E D μ Λ)) ∧
    (∀ ν, weightLE_value D ν Λ →
      (borelWeightSpace D (Raw D μ) ν).map ((discarded D μ Λ).mkQ.restrictScalars ℂ) =
        borelWeightSpace D (E D μ Λ) ν) ∧
    (∀ ν, borelWeightSpace D (E D μ Λ) ν ≠ ⊥ →
      weightLE_value D μ ν ∧ weightLE_value D ν Λ) ∧
    generatorE D μ Λ ∈ borelWeightSpace D (E D μ Λ) μ ∧
    Submodule.span (U D.borel) {generatorE D μ Λ} = ⊤

def InCutoffType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    cutoffObjects D Λ (P D μ Λ) ∧
    Submodule.span (U g) {generatorP D μ Λ} = ⊤ ∧
    generatorP D μ Λ ∈ weightSpace_value D.cartan (P D μ Λ) μ ∧
    ∀ ν, FiniteDimensional ℂ (weightSpace_value D.cartan (P D μ Λ) ν)

def RepresentsType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    ∀ X : Cutoff.{u, v} D Λ,
      ∃ F : (P D μ Λ →ₗ[U g] X.obj) ≃ₗ[ℂ] weightSpace_value D.cartan X.obj μ,
        ∀ f, (F f : X.obj) = f (generatorP D μ Λ)

def WeightExactType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight) {X Y Z : Cutoff.{u, v} D Λ}
    (f : X.obj →ₗ[U g] Y.obj) (q : Y.obj →ₗ[U g] Z.obj),
    Function.Injective f → Function.Exact f q → Function.Surjective q →
    Function.Injective (weightMap D f μ) ∧
    Function.Exact (weightMap D f μ) (weightMap D q μ) ∧
    Function.Surjective (weightMap D q μ)

def ProjectiveType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight) (_ : weightLE_value D μ Λ),
    ∃ hP : cutoffObjects D Λ (P D μ Λ),
      Projective (⟨P D μ Λ, hP⟩ : Cutoff D Λ)

def FiltrationType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    Nonempty (GroupedFiltration D μ Λ)

end Expected
end RepTheorySurvey.CategoryO.TruncatedProjectives
