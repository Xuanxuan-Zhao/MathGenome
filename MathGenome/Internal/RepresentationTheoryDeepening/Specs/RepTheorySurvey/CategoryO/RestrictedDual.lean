import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.WeightBounds
import Mathlib.Algebra.Algebra.Opposite
import Mathlib.Algebra.Exact.Basic
import Mathlib.LinearAlgebra.Dual.Defs
import Mathlib.RingTheory.FiniteLength

/-! The Chevalley anti-involution, restricted duality, and dual Verma modules. -/

noncomputable section

open CategoryTheory Opposite UniversalEnvelopingAlgebra MulOpposite
open scoped Classical DirectSum ModuleCat.Algebra
open Specs.LieAlgebrasAndRepresentations.VermaModules (U)

namespace Specs.RepTheorySurvey.CategoryO.RestrictedDual

universe u v

set_option linter.checkUnivs false

variable {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]

/-- The prescribed Chevalley generator images in the opposite enveloping algebra. -/
def ExchangesGenerators (D : Setup g) (t : U g →ₐ[ℂ] (U g)ᵐᵒᵖ) : Prop :=
  ∀ i : D.Simple,
    t (ι ℂ (D.h i : g)) = MulOpposite.op (ι ℂ (D.h i : g)) ∧
    t (ι ℂ (D.e i)) = MulOpposite.op (ι ℂ (D.f i)) ∧
    t (ι ℂ (D.f i)) = MulOpposite.op (ι ℂ (D.e i))

abbrev tau_type :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g],
    Setup g → (U g →ₐ[ℂ] (U g)ᵐᵒᵖ)

/-- The characterization of the chosen map is a separate proof obligation. -/
def tau_value : tau_type.{u} := fun {g} _ _ _ D =>
  letI : Nonempty (U g →ₐ[ℂ] (U g)ᵐᵒᵖ) :=
    ⟨(Algebra.ofId ℂ (U g)ᵐᵒᵖ).comp (_root_.Shared.Lie.augmentation ℂ g)⟩
  Classical.epsilon (ExchangesGenerators D)

def TauSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g] (D : Setup g),
    ExchangesGenerators D (tau_value D) ∧
    (∀ t, ExchangesGenerators D t → t = tau_value D) ∧
    (∀ h : D.cartan, tau_value D (ι ℂ (h : g)) = MulOpposite.op (ι ℂ (h : g))) ∧
    (∀ a : U g, (tau_value D (tau_value D a).unop).unop = a)

variable (D : Setup g)

/-- The full algebraic dual with the left action obtained by transposing along τ. -/
@[instance_reducible]
def twistedDualAction (X : ModuleCat.{v} (U g)) : Module (U g) (Module.Dual ℂ X) where
  smul a l := (Algebra.lsmul ℂ ℂ X (tau_value D a).unop).dualMap l
  one_smul l := by
    ext x
    change l ((tau_value D 1).unop • x) = l x
    rw [map_one, unop_one, one_smul]
  mul_smul a b l := by
    ext x
    change l ((tau_value D (a * b)).unop • x) =
      l ((tau_value D b).unop • ((tau_value D a).unop • x))
    rw [map_mul, unop_mul, mul_smul]
  smul_zero a := by
    ext x
    rfl
  smul_add a l m := by
    ext x
    rfl
  add_smul a b l := by
    ext x
    change l ((tau_value D (a + b)).unop • x) =
      l ((tau_value D a).unop • x) + l ((tau_value D b).unop • x)
    rw [map_add]
    change l (((tau_value D a).unop + (tau_value D b).unop) • x) = _
    rw [add_smul, map_add]
  zero_smul l := by
    ext x
    change l ((tau_value D 0).unop • x) = 0
    rw [map_zero, unop_zero, zero_smul, map_zero]

/-- Bundle the full dual with its twisted action. -/
def twistedDual (X : ModuleCat.{v} (U g)) : ModuleCat.{v} (U g) :=
  letI := twistedDualAction D X
  ModuleCat.of (U g) (Module.Dual ℂ X)

/-- The weights on whose weight spaces an algebraic functional is nonzero. -/
def functionalSupport (X : ModuleCat.{v} (U g)) (l : Module.Dual ℂ X) : Set D.Weight :=
  {μ | ∃ x : weightSpace_value D.cartan X μ, l x ≠ 0}

/-- The enveloping submodule generated by the single-weight functionals.
For weight modules, the characterization theorem identifies it with the
functionals of finite weight support. -/
def restrictedPart (X : ModuleCat.{v} (U g)) : Submodule (U g) (twistedDual D X) :=
  Submodule.span (U g) {l : twistedDual D X |
    ∃ μ : D.Weight, functionalSupport D X l ⊆ {μ}}

abbrev dualModule_type :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g],
    Setup g → ModuleCat.{v} (U g) → ModuleCat.{v} (U g)

def dualModule_value : dualModule_type.{u,v} := fun D X =>
  ModuleCat.of (U _) (restrictedPart D X)

/-- Evaluation of a restricted functional on an original vector. -/
def pair (X : ModuleCat.{v} (U g)) (l : dualModule_value D X) (x : X) : ℂ := by
  let q : Module.Dual ℂ X := l.val
  exact q x

theorem pair_smul (X : ModuleCat.{v} (U g)) (a : U g)
    (l : dualModule_value D X) (x : X) :
    pair D X (a • l) x = pair D X l ((tau_value D a).unop • x) := rfl

private theorem map_weight {X Y : ModuleCat.{v} (U g)} (f : X ⟶ Y)
    (μ : D.Weight) (x : weightSpace_value D.cartan X μ) :
    f x ∈ weightSpace_value D.cartan Y μ := by
  let := restrictedLieRingModule X (g := g)
  let := restrictedLieModule X (g := g)
  let := restrictedLieRingModule Y (g := g)
  let := restrictedLieModule Y (g := g)
  have hx := (LieModule.mem_weightSpace (μ : D.cartan → ℂ) (x : X)).mp x.property
  change f x ∈ LieModule.weightSpace Y (μ : D.cartan → ℂ)
  apply (LieModule.mem_weightSpace (μ : D.cartan → ℂ) (f x)).mpr
  intro h
  have eq : (ι ℂ (h : g)) • (x : X) = μ h • (x : X) := hx h
  change (ι ℂ (h : g)) • (f x : Y) = μ h • (f x : Y)
  rw [← f.hom.map_smul, eq]
  exact (f.hom.restrictScalars ℂ).map_smul (μ h) (x : X)

private def fullPullback {X Y : ModuleCat.{v} (U g)} (f : X ⟶ Y) :
    twistedDual D Y →ₗ[U g] twistedDual D X where
  toFun l := (f.hom.restrictScalars ℂ).dualMap l
  map_add' l m := (f.hom.restrictScalars ℂ).dualMap.map_add l m
  map_smul' a l := by
    apply LinearMap.ext
    intro x
    let q : Module.Dual ℂ Y := l
    change q ((tau_value D a).unop • (f x : Y)) =
      q (f ((tau_value D a).unop • x))
    rw [← f.hom.map_smul]

private theorem fullPullback_mem {X Y : ModuleCat.{v} (U g)} (f : X ⟶ Y)
    (l : twistedDual D Y) (hl : l ∈ restrictedPart D Y) :
    fullPullback D f l ∈ restrictedPart D X := by
  refine Submodule.span_induction (p := fun l _ => fullPullback D f l ∈ restrictedPart D X)
    ?_ (by simp) (fun a b _ _ ha hb => by simpa only [map_add] using (restrictedPart D X).add_mem ha hb)
    (fun a b _ hb => by simpa only [map_smul] using (restrictedPart D X).smul_mem a hb) hl
  rintro l ⟨μ, hμ⟩
  apply Submodule.subset_span
  refine ⟨μ, ?_⟩
  rintro ν ⟨x, hx⟩
  exact hμ ⟨⟨f x, map_weight D f ν x⟩, hx⟩

abbrev dualMap_type :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) {X Y : ModuleCat.{v} (U g)},
    (X ⟶ Y) → (dualModule_value D Y ⟶ dualModule_value D X)

/-- Pullback of functionals, in the direction opposite that of the input map. -/
def dualMap_value : dualMap_type.{u,v} := fun {_g} _ _ _ D {_ _} f =>
  ModuleCat.ofHom ((fullPullback D f).restrict (fullPullback_mem D f))

theorem pair_dualMap {X Y : ModuleCat.{v} (U g)} (f : X ⟶ Y)
    (l : dualModule_value D Y) (x : X) :
    pair D X (dualMap_value D f l) x = pair D Y l (f x) := rfl

/-- On all enveloping modules the construction is a contravariant functor.
The duality theorem restricts it to category O. -/
def ambientDualFunctor (D : Setup g) : (ModuleCat.{v} (U g))ᵒᵖ ⥤ ModuleCat.{v} (U g) where
  obj X := dualModule_value D X.unop
  map f := dualMap_value D f.unop
  map_id X := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro l
    apply Subtype.ext
    rfl
  map_comp f k := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro l
    apply Subtype.ext
    rfl

def PreservesO (D : Setup g) : Prop :=
  ∀ X : category_value.{u,v} D, objects_value D (dualModule_value D X.obj)

/-- The restriction as soon as closure under restricted duality is proved. -/
def categoryDualFunctor (D : Setup g) (hD : PreservesO.{u,v} D) :
    (category_value.{u,v} D)ᵒᵖ ⥤ category_value.{u,v} D :=
  (objects_value D).lift ((objects_value D).ι.op ⋙ ambientDualFunctor D)
    (fun X => hD X.unop)

abbrev costandard_type := verma_type.{u}

/-- The dual Verma module ∇(λ). -/
def costandard_value : costandard_type.{u} := fun D lam =>
  dualModule_value D (verma_value D lam)

/-- The twisted action preserves finite weight support. On a weight module
the restricted dual identifies with the direct sum of the individual duals,
by the original evaluation on each weight space. -/
def RestrictedDualSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (X : ModuleCat.{v} (U g)),
    DirectSum.IsInternal (weightSpace_value D.cartan X) →
    (∀ l : Module.Dual ℂ X, (l : twistedDual D X) ∈ restrictedPart D X ↔
      (functionalSupport D X l).Finite) ∧
    ∃ e : (⨁ μ : D.Weight, Module.Dual ℂ (weightSpace_value D.cartan X μ)) ≃ₗ[ℂ]
        dualModule_value D X,
      ∀ l μ (x : weightSpace_value D.cartan X μ), pair D X (e l) x = l μ x

/-- The weight-space identification, including the unchanged support. -/
def DualWeightsSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (X : ModuleCat.{v} (U g)),
    DirectSum.IsInternal (weightSpace_value D.cartan X) →
    DirectSum.IsInternal (weightSpace_value D.cartan (dualModule_value D X)) ∧
    WeightBounds.support D (dualModule_value D X) = WeightBounds.support D X ∧
    ∀ μ : D.Weight,
      ∃ e : weightSpace_value D.cartan (dualModule_value D X) μ ≃ₗ[ℂ]
          Module.Dual ℂ (weightSpace_value D.cartan X μ),
        ∀ l x, e l x = pair D X l x

/-- On category O the pullback sends every short exact sequence to the
reversed short exact sequence. The double application is naturally
isomorphic to the identity by evaluation. -/
def CategoryDualitySpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g] (D : Setup g),
    ∃ hD : PreservesO.{u,v} D,
      let F := categoryDualFunctor D hD
      (∃ E : 𝟭 (category_value.{u,v} D) ≅ F.rightOp ⋙ F,
        ∀ (X : category_value.{u,v} D) (x : X.obj) (l : dualModule_value D X.obj),
          pair D (dualModule_value D X.obj) ((E.hom.app X).hom x) l = pair D X.obj l x) ∧
      ∀ {X Y Z : category_value.{u,v} D} (f : X ⟶ Y) (k : Y ⟶ Z),
        Function.Injective f.hom → Function.Exact f.hom k.hom → Function.Surjective k.hom →
        Function.Injective (dualMap_value D k.hom) ∧
        Function.Exact (dualMap_value D k.hom) (dualMap_value D f.hom) ∧
        Function.Surjective (dualMap_value D f.hom)

def DualLengthSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (X : category_value.{u,v} D),
    IsFiniteLength (U g) (dualModule_value D X.obj)

def DualSimpleLabelsSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (lam : D.Weight),
    Nonempty (dualModule_value D (simpleQuotient_value D lam) ≃ₗ[U g]
      simpleQuotient_value D lam)

def CostandardInOSpec : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (lam : D.Weight), objects_value D (costandard_value D lam)

end Specs.RepTheorySurvey.CategoryO.RestrictedDual
