import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.VermaModules
import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Algebra.Exact.Basic
import Mathlib.Algebra.Module.Opposite
import Mathlib.Algebra.Module.TransferInstance

/-! Balanced induction for enveloping algebras of complex Lie algebras. -/

noncomputable section

open scoped TensorProduct

namespace RepTheorySurvey.CategoryO.BorelInduction

abbrev U (L : Type*) [LieRing L] [LieAlgebra ℂ L] := UniversalEnvelopingAlgebra ℂ L

abbrev inclusion {G : Type*} [LieRing G] [LieAlgebra ℂ G] (B : LieSubalgebra ℂ G) :
    U B →ₐ[ℂ] U G :=
  Specs.LieAlgebrasAndRepresentations.VermaModules.envelopingMap B.incl

section Balanced

variable {A B : Type*} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
variable (i : B →ₐ[ℂ] A)
variable (E : Type*) [AddCommGroup E] [Module B E]

/-- The scalar restriction available for every unital left module. -/
abbrev scalarModule : Module ℂ E := Module.compHom E (algebraMap ℂ B)

variable [Module ℂ E]

/-- The left submodule generated by the relations for balancing over `B`. -/
def balance : Submodule A (A ⊗[ℂ] E) :=
  Submodule.span A
    {z | ∃ (a : A) (b : B) (e : E), z = (a * i b) ⊗ₜ[ℂ] e - a ⊗ₜ[ℂ] (b • e)}

abbrev Induced := (A ⊗[ℂ] E) ⧸ balance i E

omit [Module ℂ E] in
/-- The induced left module with complex scalars obtained by restriction. -/
abbrev inducedFromModule :=
  letI := scalarModule (B := B) E
  Induced i E

variable {E} in
abbrev induceTensor (a : A) (e : E) : Induced i E := (balance i E).mkQ (a ⊗ₜ[ℂ] e)

variable {E}

/-- Restrict a left action along the algebra map used for induction. -/
abbrev restrictModule (V : Type*) [AddCommGroup V] [Module A V] : Module B V :=
  Module.compHom V i.toRingHom

/-- The left action on the quotient comes from multiplication in the first factor. -/
def TensorRelations : Prop :=
  (∀ (a : A) (b : B) (e : E),
    induceTensor i (a * i b) e = induceTensor i a (b • e)) ∧
  (∀ (c a : A) (e : E), c • induceTensor i a e = induceTensor i (c * a) e)

variable [IsScalarTower ℂ B E]

/-- The adjunction sends a map to its values at `1 ⊗ e`. Its inverse extends
a map using the left action on the target. -/
def Universal (V : Type*) [AddCommGroup V] [Module A V] : Prop :=
  letI := restrictModule i V
  ∃ F : (Induced i E →ₗ[A] V) ≃ (E →ₗ[B] V),
    (∀ f e, F f e = f (induceTensor i 1 e)) ∧
    ∀ f (a : A) (e : E), F.symm f (induceTensor i a e) = a • f e

/-- Restriction sends a linear map to the same function with the restricted actions. -/
def restrictMap {V W : Type*} [AddCommGroup V] [AddCommGroup W] [Module A V] [Module A W] :
    letI := restrictModule i V
    letI := restrictModule i W
    (V →ₗ[A] W) → (V →ₗ[B] W) :=
  letI := restrictModule i V
  letI := restrictModule i W
  fun f => ⟨f.toAddHom, fun b x => f.map_smul (i b) x⟩

variable {E' E'' : Type*} [AddCommGroup E'] [Module B E'] [Module ℂ E']
  [AddCommGroup E''] [Module B E''] [Module ℂ E'']

/-- Characterization of the morphism induced by a map of left modules. -/
def IsInducedMap (f : E →ₗ[B] E') (q : Induced i E →ₗ[A] Induced i E') : Prop :=
  ∀ a e, q (induceTensor i a e) = induceTensor i a (f e)

def MapExists : Prop :=
  ∀ f : E →ₗ[B] E', ∃! q : Induced i E →ₗ[A] Induced i E', IsInducedMap i f q

def MapComposition : Prop :=
  ∀ (f : E →ₗ[B] E') (g : E' →ₗ[B] E'')
    (q : Induced i E →ₗ[A] Induced i E') (r : Induced i E' →ₗ[A] Induced i E''),
    IsInducedMap i f q → IsInducedMap i g r → IsInducedMap i (g.comp f) (r.comp q)

def MapIdentity : Prop :=
  IsInducedMap i (LinearMap.id (R := B) (M := E)) LinearMap.id

/-- Precomposition by a map of inducing modules and postcomposition by a map
of ambient modules commute with the adjunction. -/
def UniversalNaturality (V W : Type*) [AddCommGroup V] [AddCommGroup W]
    [Module A V] [Module A W] : Prop :=
  letI := restrictModule i V
  letI := restrictModule i W
  ∀ (F : (Induced i E' →ₗ[A] V) ≃ (E' →ₗ[B] V))
    (F' : (Induced i E →ₗ[A] W) ≃ (E →ₗ[B] W)),
    (∀ f e, F f e = f (induceTensor i 1 e)) →
    (∀ f e, F' f e = f (induceTensor i 1 e)) →
    ∀ (f : E →ₗ[B] E') (q : Induced i E →ₗ[A] Induced i E'), IsInducedMap i f q →
    ∀ (g : Induced i E' →ₗ[A] V) (k : V →ₗ[A] W),
      F' ((k.comp g).comp q) = (restrictMap i k).comp ((F g).comp f)

end Balanced

section PBW

variable {G : Type*} [LieRing G] [LieAlgebra ℂ G]
variable (N B : LieSubalgebra ℂ G)

/-- Multiplication of the embedded enveloping algebras. -/
def multiply : U N ⊗[ℂ] U B →ₗ[ℂ] U G :=
  Specs.LieAlgebrasAndRepresentations.VermaModules.multiply N.incl B.incl

/-- Right multiplication by `b` acts on the second tensor factor. -/
def tensorRightMul (b : U B) : U N ⊗[ℂ] U B →ₗ[ℂ] U N ⊗[ℂ] U B :=
  (LinearMap.mul ℂ (U B)).flip b |>.lTensor (U N)

def PBW : Prop :=
  IsCompl N.toSubmodule B.toSubmodule →
  ∃ F : U N ⊗[ℂ] U B ≃ₗ[ℂ] U G,
    F.toLinearMap = multiply N B ∧
    (∀ (a : U N) (b : U B), F (a ⊗ₜ[ℂ] b) = inclusion N a * inclusion B b) ∧
    ∀ z b, F (tensorRightMul N B b z) = F z * inclusion B b

/-- Right multiplication on `U(g)`, restricted along `U(b) → U(g)`. -/
abbrev envelopingRightModule : Module (U B)ᵐᵒᵖ (U G) :=
  Module.compHom (U G) (inclusion B).toRingHom.op

/-- Right multiplication on the second factor, obtained by swapping the factors. -/
abbrev tensorRightModule : Module (U B)ᵐᵒᵖ (U N ⊗[ℂ] U B) :=
  (TensorProduct.comm ℂ (U N) (U B)).toAddEquiv.module (U B)ᵐᵒᵖ

def RightPBW : Prop :=
  letI := envelopingRightModule B
  letI := tensorRightModule N B
  IsCompl N.toSubmodule B.toSubmodule →
  ∃ F : U N ⊗[ℂ] U B ≃ₗ[(U B)ᵐᵒᵖ] U G, ∀ z, F z = multiply N B z

variable (E : Type*) [AddCommGroup E] [Module (U B) E] [Module ℂ E]
  [IsScalarTower ℂ (U B) E]

def InducedPBW : Prop :=
  IsCompl N.toSubmodule B.toSubmodule →
  ∃ F : U N ⊗[ℂ] E ≃ₗ[ℂ] Induced (inclusion B) E,
    ∀ (a : U N) (e : E), F (a ⊗ₜ[ℂ] e) = induceTensor (inclusion B) (inclusion N a) e

variable {E' E'' : Type*}
  [AddCommGroup E'] [Module (U B) E'] [Module ℂ E'] [IsScalarTower ℂ (U B) E']
  [AddCommGroup E''] [Module (U B) E''] [Module ℂ E''] [IsScalarTower ℂ (U B) E'']

/-- Naturality with respect to a map of inducing modules. -/
def PBWNaturality : Prop :=
  ∀ (f : E →ₗ[U B] E') (q : Induced (inclusion B) E →ₗ[U G] Induced (inclusion B) E'),
    IsInducedMap (inclusion B) f q →
    ∀ (F : U N ⊗[ℂ] E ≃ₗ[ℂ] Induced (inclusion B) E)
      (F' : U N ⊗[ℂ] E' ≃ₗ[ℂ] Induced (inclusion B) E'),
      (∀ a e, F (a ⊗ₜ[ℂ] e) = induceTensor (inclusion B) (inclusion N a) e) →
      (∀ a e, F' (a ⊗ₜ[ℂ] e) = induceTensor (inclusion B) (inclusion N a) e) →
      (q.restrictScalars ℂ).comp F.toLinearMap =
        F'.toLinearMap.comp ((f.restrictScalars ℂ).lTensor (U N))

/-- An induced short exact sequence is short exact as a sequence of left
modules over the ambient enveloping algebra. -/
def ExactInduction : Prop :=
  IsCompl N.toSubmodule B.toSubmodule →
  ∀ (f : E →ₗ[U B] E') (g : E' →ₗ[U B] E'')
    (q : Induced (inclusion B) E →ₗ[U G] Induced (inclusion B) E')
    (r : Induced (inclusion B) E' →ₗ[U G] Induced (inclusion B) E''),
    IsInducedMap (inclusion B) f q → IsInducedMap (inclusion B) g r →
    Function.Injective f → Function.Exact f g → Function.Surjective g →
    Function.Injective q ∧ Function.Exact q r ∧ Function.Surjective r

attribute [local instance 100] LieRing.ofAssociativeRing

open UniversalEnvelopingAlgebra (ι)

/-- The Cartan formula uses the actual commutator with the embedded generator
and the left action on the inducing module. -/
def Cartan : Prop :=
  IsCompl N.toSubmodule B.toSubmodule →
  ∀ (h : B) (hn : ∀ x : N, (⁅(h : G), (x : G)⁆ : G) ∈ N),
  ∃ D : U N →ₗ[ℂ] U N,
    (∀ a, inclusion N (D a) =
      ι ℂ (h : G) * inclusion N a - inclusion N a * ι ℂ (h : G)) ∧
    (∀ x : N, D (ι ℂ x) = ι ℂ (⟨⁅(h : G), (x : G)⁆, hn x⟩ : N)) ∧
    (∀ a b, D (a * b) = D a * b + a * D b) ∧
    ∀ (a : U N) (e : E), (ι ℂ (h : G)) •
      induceTensor (inclusion B) (inclusion N a) e =
        induceTensor (inclusion B) (inclusion N (D a)) e +
        induceTensor (inclusion B) (inclusion N a) (ι ℂ h • e)

end PBW

section Verma

open Specs.LieAlgebrasAndRepresentations.VermaModules
variable {G : Type*} [LieRing G] [LieAlgebra ℂ G]
variable (H : LieSubalgebra ℂ G) (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ)

def FiniteVerma : Prop :=
  letI := weightModule_value H φ χ
  ∃ F : Induced (inclusion (borel_value H φ)) ℂ ≃ₗ[U G] induced_value H φ χ,
    ∀ (a : U G) (c : ℂ), F (induceTensor (inclusion (borel_value H φ)) a c) =
      tensorClass H φ χ a c

open Specs.LieAlgebrasAndRepresentations.SolvableRadical (IsSemisimple_value)
open Specs.LieAlgebrasAndRepresentations.RootDecomposition (rootSpace_value)
open Specs.LieAlgebrasAndRepresentations.SerreRelations (simple)

def FiniteBorelCompl [FiniteDimensional ℂ G] [H.IsCartanSubalgebra] : Prop :=
  IsSemisimple_value ℂ G → Regular H φ →
  IsCompl (negative_value H φ).toSubmodule (borel_value H φ).toSubmodule

def FiniteVermaPresentation [FiniteDimensional ℂ G] [H.IsCartanSubalgebra] : Prop :=
  IsSemisimple_value ℂ G → Regular H φ →
  ∀ (μ : Module.Dual ℂ H), IsWeightCharacter H φ μ χ →
  ∀ (e : simple H φ → G), (∀ j, e j ∈ rootSpace_value H j.val ∧ e j ≠ 0) →
    letI := weightModule_value H φ χ
    ∃ F : (U G ⧸ definingIdeal_value H φ μ e) ≃ₗ[U G] Induced (inclusion (borel_value H φ)) ℂ,
      ∀ a : U G, F ((definingIdeal_value H φ μ e).mkQ a) =
        induceTensor (inclusion (borel_value H φ)) a 1

end Verma

namespace Expected

universe u v w x y z

def BalanceType :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B],
    (B →ₐ[ℂ] A) → ∀ (E : Type w) [AddCommGroup E] [Module B E] [Module ℂ E],
      Submodule A (A ⊗[ℂ] E)

def InductionType :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B],
    (B →ₐ[ℂ] A) → ∀ (E : Type w) [AddCommGroup E] [Module B E], Type (max u w)

def ScalarTowerType : Prop :=
  ∀ {B : Type u} [Ring B] [Algebra ℂ B] (E : Type v) [AddCommGroup E] [Module B E],
    letI := scalarModule (B := B) E
    IsScalarTower ℂ B E

def TensorRelationsType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E],
    TensorRelations (E := E) i

def UniversalType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E]
    [IsScalarTower ℂ B E] (V : Type x) [AddCommGroup V] [Module A V],
    Universal (E := E) i V

def MapExistsType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E]
    [IsScalarTower ℂ B E] {E' : Type x} [AddCommGroup E'] [Module B E'] [Module ℂ E'],
    MapExists (E := E) (E' := E') i

def MapCompositionType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E]
    {E' : Type x} {E'' : Type y} [AddCommGroup E'] [Module B E'] [Module ℂ E']
    [AddCommGroup E''] [Module B E''] [Module ℂ E''],
    MapComposition (E := E) (E' := E') (E'' := E'') i

def MapIdentityType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E],
    MapIdentity (E := E) i

def UniversalNaturalityType : Prop :=
  ∀ {A : Type u} {B : Type v} [Ring A] [Ring B] [Algebra ℂ A] [Algebra ℂ B]
    (i : B →ₐ[ℂ] A) {E : Type w} [AddCommGroup E] [Module B E] [Module ℂ E]
    {E' : Type x} [AddCommGroup E'] [Module B E'] [Module ℂ E'] (V : Type y) (W : Type z)
    [AddCommGroup V] [AddCommGroup W] [Module A V] [Module A W],
    UniversalNaturality (E := E) (E' := E') i V W

def PBWType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G), PBW N B

def RightPBWType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G), RightPBW N B

def InducedPBWType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G)
    {E : Type v} [AddCommGroup E] [Module (U B) E] [Module ℂ E] [IsScalarTower ℂ (U B) E],
    InducedPBW N B E

def PBWNaturalityType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G)
    (E : Type v) [AddCommGroup E] [Module (U B) E] [Module ℂ E] [IsScalarTower ℂ (U B) E]
    {E' : Type w} [AddCommGroup E'] [Module (U B) E'] [Module ℂ E'] [IsScalarTower ℂ (U B) E'],
    PBWNaturality N B E (E' := E')

def ExactInductionType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G)
    (E : Type v) [AddCommGroup E] [Module (U B) E] [Module ℂ E] [IsScalarTower ℂ (U B) E]
    {E' : Type w} {E'' : Type x}
    [AddCommGroup E'] [Module (U B) E'] [Module ℂ E'] [IsScalarTower ℂ (U B) E']
    [AddCommGroup E''] [Module (U B) E''] [Module ℂ E''] [IsScalarTower ℂ (U B) E''],
    ExactInduction N B E (E' := E') (E'' := E'')

def CartanType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (N B : LieSubalgebra ℂ G)
    (E : Type v) [AddCommGroup E] [Module (U B) E] [Module ℂ E],
    Cartan N B E

open Specs.LieAlgebrasAndRepresentations.VermaModules

def FiniteVermaType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] (H : LieSubalgebra ℂ G)
    (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ), FiniteVerma H φ χ

def FiniteBorelComplType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    (H : LieSubalgebra ℂ G) [H.IsCartanSubalgebra] (φ : Direction H), FiniteBorelCompl H φ

def FiniteVermaPresentationType : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    (H : LieSubalgebra ℂ G) [H.IsCartanSubalgebra] (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ), FiniteVermaPresentation H φ χ

end Expected

end RepTheorySurvey.CategoryO.BorelInduction
