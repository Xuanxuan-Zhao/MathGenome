import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.TruncatedProjectives
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.ComponentProjectors

/-! Transfer of the ordered Verma flag to joint components and their summands. -/

noncomputable section

open Module
open scoped Classical ModuleCat.Algebra

namespace RepTheorySurvey.CategoryO.ProjectiveFiltrations

open Specs.RepTheorySurvey.CategoryO
open Specs.RepTheorySurvey.CategoryO.ComponentProjectors
open TruncatedProjectives
open BorelInduction (U)

universe u

variable {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
variable (D : Setup g)

/-- The submodule generated by the full weight spaces at the indicated weights. -/
def weightGenerated (X : ModuleCat.{u} (U g)) (s : Finset D.Weight) : Submodule (U g) X :=
  Submodule.span (U g) {x | ∃ ν ∈ s, x ∈ weightSpace_value D.cartan X ν}

/-- The layer between two submodules, using the inclusion into the ambient module. -/
abbrev Layer {X : Type u} [AddCommGroup X] [Module (U g) X]
    (A B : Submodule (U g) X) := B ⧸ A.comap B.subtype

/-- A finite flag with one Verma module at each step, in the indicated order. -/
inductive VermaFlag {X : Type u} [AddCommGroup X] [Module (U g) X] :
    List D.Weight → Submodule (U g) X → Submodule (U g) X → Prop
  | nil (A) : VermaFlag [] A A
  | cons {ν l A B C} : A ≤ B → Nonempty (Layer A B ≃ₗ[U g] verma_value D ν) →
      VermaFlag l B C → VermaFlag (ν :: l) A C

/-- The actual image of each initial term under the projection to a joint component. -/
def componentTerm {μ Λ : D.Weight} (F : GroupedFiltration D μ Λ)
    (hP : DirectSum.IsInternal (component D (P D μ Λ))) (k : Index D)
    (i : Fin (F.length + 1)) : Submodule (U g) (component D (P D μ Λ) k) :=
  (F.term i).map (projection D hP k)

/-- The image flag on the range of an arbitrary idempotent of that joint component. -/
def summandTerm {μ Λ : D.Weight} (F : GroupedFiltration D μ Λ)
    (hP : DirectSum.IsInternal (component D (P D μ Λ))) (k : Index D)
    (e : component D (P D μ Λ) k →ₗ[U g] component D (P D μ Λ) k)
    (i : Fin (F.length + 1)) : Submodule (U g) (LinearMap.range e) :=
  (componentTerm D F hP k i).map e.rangeRestrict

namespace Expected

def GeneratedType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    ∀ (F : GroupedFiltration D μ Λ) (i : Fin (F.length + 1)),
      F.term i = weightGenerated D (P D μ Λ) (initialWeights D F.weight i) ∧
      ∀ ν ∈ initialWeights D F.weight i,
        weightSpace_value D.cartan (ModuleCat.of (U g) (P D μ Λ ⧸ F.term i)) ν = ⊥

def ComponentType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    ∀ (F : GroupedFiltration D μ Λ)
      (hP : DirectSum.IsInternal (component D (P D μ Λ))) (k : Index D)
      (i : Fin (F.length + 1)),
      componentTerm D F hP k i = weightGenerated D
        (ModuleCat.of (U g) (component D (P D μ Λ) k)) (initialWeights D F.weight i) ∧
      ∀ f : component D (P D μ Λ) k →ₗ[U g] component D (P D μ Λ) k,
        componentTerm D F hP k i ≤ (componentTerm D F hP k i).comap f

def SummandType : Prop :=
  ∀ {g : Type u} [LieRing g] [LieAlgebra ℂ g] [FiniteDimensional ℂ g]
    (D : Setup g) (μ Λ : D.Weight), weightLE_value D μ Λ →
    ∀ (F : GroupedFiltration D μ Λ)
      (hP : DirectSum.IsInternal (component D (P D μ Λ))) (k : Index D)
      (e : component D (P D μ Λ) k →ₗ[U g] component D (P D μ Λ) k), e.comp e = e →
      let S := summandTerm D F hP k e
      Monotone S ∧ S 0 = ⊥ ∧ S (Fin.last F.length) = ⊤ ∧
      ∃ r : Fin F.length → ℕ,
        (∀ i, Nonempty (Layer (S i.castSucc) (S i.succ) ≃ₗ[U g]
          (Fin (r i) → verma_value D (F.weight i)))) ∧
        (∀ i, r i = 0 ↔ S i.castSucc = S i.succ) ∧
        (∀ i, VermaFlag D (List.replicate (r i) (F.weight i)) (S i.castSucc) (S i.succ)) ∧
        VermaFlag D (X := LinearMap.range e) (List.ofFn (fun i => List.replicate (r i) (F.weight i))).flatten ⊥ ⊤

end Expected
end RepTheorySurvey.CategoryO.ProjectiveFiltrations
