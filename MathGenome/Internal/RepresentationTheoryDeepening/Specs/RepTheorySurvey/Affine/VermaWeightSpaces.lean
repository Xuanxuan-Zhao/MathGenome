import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.Affine.AffineSimpleTriples
import MathGenome.Internal.RepresentationTheoryDeepening.Specs.RepTheorySurvey.CategoryO.BorelInduction
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.HighestWeightData

/-! The affine Verma construction and its ordinary Cartan weight spaces. -/

noncomputable section

open scoped DirectSum
open UniversalEnvelopingAlgebra (ι)

universe u v

namespace Specs.RepTheorySurvey.Affine.VermaWeightSpaces

open _root_.RepTheorySurvey.Affine
open _root_.RepTheorySurvey.CategoryO.BorelInduction
open _root_.Specs.LieAlgebrasAndRepresentations.VermaModules (Direction Regular)
open _root_.Specs.LieAlgebrasAndRepresentations.HighestWeightData (positiveRootCone_value)
open LoopAlgebra (affineBracket_value)
open TriangularRootSpaces (affineCartan_value affinePositive_value affineNegative_value
  ClosedUnderBracket)

variable {G : Type u} [LieRing G] [LieAlgebra ℂ G]

/-- Lie laws for the fixed affine bracket on the fixed complex vector space. -/
structure BracketLaws (B : InvariantForm G) : Prop where
  add_left : ∀ x y z, affineBracket_value B (x + y) z =
    affineBracket_value B x z + affineBracket_value B y z
  add_right : ∀ x y z, affineBracket_value B x (y + z) =
    affineBracket_value B x y + affineBracket_value B x z
  alternating : ∀ x, affineBracket_value B x x = 0
  jacobi : ∀ x y z, affineBracket_value B x (affineBracket_value B y z) =
    affineBracket_value B (affineBracket_value B x y) z +
      affineBracket_value B y (affineBracket_value B x z)
  smul_right : ∀ (c : ℂ) x y, affineBracket_value B x (c • y) = c • affineBracket_value B x y

/-- The Lie laws and closure facts supplied by the upstream affine structure and
triangular summands. The carrier, bracket and all three summands are fixed. -/
structure Model (B : InvariantForm G) (H : LieSubalgebra ℂ G) (φ : Direction H) : Prop where
  laws : BracketLaws B
  cartan_closed : ClosedUnderBracket B (affineCartan_value B H)
  positive_closed : ClosedUnderBracket B (affinePositive_value B H φ)
  negative_closed : ClosedUnderBracket B (affineNegative_value B H φ)

def affineVermaModel_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H), Model B H φ

section Construction

variable {B : InvariantForm G} {H : LieSubalgebra ℂ G} {φ : Direction H}

/-- Use the fixed affine carrier with Lie laws supplied by the model. -/
def Carrier (_ : Model B H φ) := AffineAlgebra B

instance (D : Model B H φ) : LieRing (Carrier D) where
  toAddCommGroup := (inferInstance : AddCommGroup (AffineAlgebra B))
  bracket := affineBracket_value B
  add_lie := D.laws.add_left
  lie_add := D.laws.add_right
  lie_self := D.laws.alternating
  leibniz_lie := D.laws.jacobi

instance (D : Model B H φ) : LieAlgebra ℂ (Carrier D) where
  toModule := (inferInstance : Module ℂ (AffineAlgebra B))
  lie_smul := D.laws.smul_right

variable (D : Model B H φ)

def cartan (D : Model B H φ) : LieSubalgebra ℂ (Carrier D) :=
  { affineCartan_value B H with lie_mem' := fun hx hy => D.cartan_closed hx hy }

def positive (D : Model B H φ) : LieSubalgebra ℂ (Carrier D) :=
  { affinePositive_value B H φ with lie_mem' := fun hx hy => D.positive_closed hx hy }

def negative (D : Model B H φ) : LieSubalgebra ℂ (Carrier D) :=
  { affineNegative_value B H φ with lie_mem' := fun hx hy => D.negative_closed hx hy }

/-- The Borel Lie subalgebra generated by the affine Cartan and the positive side. -/
def affineBorel_value : LieSubalgebra ℂ (Carrier D) := cartan D ⊔ positive D

def affineBorel_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ), LieSubalgebra ℂ (Carrier D)

abbrev Weight (B : InvariantForm G) (H : LieSubalgebra ℂ G) :=
  Module.Dual ℂ (affineCartan_value B H)

def IsWeightCharacter (Λ : Weight B H) (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ) : Prop :=
  (∀ h : cartan D, χ (ι ℂ (LieSubalgebra.inclusion
    (show cartan D ≤ affineBorel_value D from le_sup_left) h)) = Λ ⟨h.1, h.2⟩) ∧
  ∀ x : positive D, χ (ι ℂ (LieSubalgebra.inclusion
    (show positive D ≤ affineBorel_value D from le_sup_right) x)) = 0

/-- Select the unique character at the given weight once its existence is proved. -/
def affineWeightCharacter_value (Λ : Weight B H)
    (hχ : ∃! χ, IsWeightCharacter D Λ χ) : U (affineBorel_value D) →ₐ[ℂ] ℂ :=
  Classical.choose hχ.exists

def affineWeightCharacter_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ) (Λ : Weight B H),
    (∃! χ, IsWeightCharacter D Λ χ) → (U (affineBorel_value D) →ₐ[ℂ] ℂ)

theorem affineWeightCharacter_spec (Λ : Weight B H) (hχ : ∃! χ, IsWeightCharacter D Λ χ) :
    IsWeightCharacter D Λ (affineWeightCharacter_value D Λ hχ) :=
  Classical.choose_spec hχ.exists

variable (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ)

/-- The one-dimensional inducing module with scalar action through the character. -/
abbrev characterModule : Module (U (affineBorel_value D)) ℂ :=
  Module.compHom ℂ χ.toRingHom

/-- The balanced tensor product over the enveloping algebra of the affine Borel. -/
abbrev affineVerma_value :=
  letI := characterModule D χ
  Induced (inclusion (affineBorel_value D)) ℂ

def affineVerma_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ),
    (U (affineBorel_value D) →ₐ[ℂ] ℂ) → Type u

/-- The canonical Verma module with highest weight Λ. -/
abbrev affineVermaAt_value (Λ : Weight B H) (hχ : ∃! χ, IsWeightCharacter D Λ χ) :=
  affineVerma_value D (affineWeightCharacter_value D Λ hχ)

def affineVermaAt_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ) (Λ : Weight B H),
    (∃! χ, IsWeightCharacter D Λ χ) → Type u

/-- The class of the tensor of the two units. -/
def affineVermaTop_value : affineVerma_value D χ :=
  letI := characterModule D χ
  induceTensor (inclusion (affineBorel_value D)) 1 1

def affineVermaTop_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ)
    (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ), affineVerma_value D χ

def IsHighestVector {V : Type v} [AddCommGroup V] [Module (U (Carrier D)) V]
    [Module ℂ V] (Λ : Weight B H) (w : V) : Prop :=
  (∀ h : cartan D, ι ℂ (h : Carrier D) • w = Λ ⟨h.1, h.2⟩ • w) ∧
    ∀ x : positive D, ι ℂ (x : Carrier D) • w = 0

/-- Simultaneous eigenspace for the affine Cartan action. -/
def affineVermaWeightSpace_value (μ : Weight B H) : Submodule ℂ (affineVerma_value D χ) :=
  ⨅ h : affineCartan_value B H, LinearMap.ker
    (Algebra.lsmul ℂ ℂ (affineVerma_value D χ) (ι ℂ (show Carrier D from h.1)) -
      μ h • LinearMap.id)

def affineVermaWeightSpace_type :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] {B : InvariantForm G}
    {H : LieSubalgebra ℂ G} {φ : Direction H} (D : Model B H φ)
    (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ), Weight B H → Submodule ℂ (affineVerma_value D χ)

end Construction

/-- In a triangular decomposition the affine Borel is the vector-space sum
of the affine Cartan and the positive side. -/
def affineBorelUnderlying_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), Regular H φ →
    (affineBorel_value D).toSubmodule = affineCartan_value B H ⊔ affinePositive_value B H φ

def affineVermaCharacter_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), B.IsNormalized H →
    Regular H φ → ∀ Λ : Weight B H, ∃! χ, IsWeightCharacter D Λ χ

/-- The prescribed free action of the negative enveloping algebra on the top. -/
def affineVermaPBW_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), B.IsNormalized H →
    Regular H φ → ∀ (Λ : Weight B H) (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ),
    IsWeightCharacter D Λ χ →
    ∃ F : U (negative D) ≃ₗ[ℂ] affineVerma_value D χ,
      ∀ a, F a = inclusion (negative D) a • affineVermaTop_value D χ

def affineVermaUniversal_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), B.IsNormalized H →
    Regular H φ → ∀ (Λ : Weight B H) (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ),
    IsWeightCharacter D Λ χ →
    IsHighestVector D Λ (affineVermaTop_value D χ) ∧
      ∀ (V : Type v) [AddCommGroup V] [Module (U (Carrier D)) V],
        letI := scalarModule (B := U (Carrier D)) V
        ∀ w : V, IsHighestVector D Λ w →
          ∃! f : affineVerma_value D χ →ₗ[U (Carrier D)] V, f (affineVermaTop_value D χ) = w

open scoped Classical in
def affineVermaWeights_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), B.IsNormalized H →
    Regular H φ → ∀ (Λ : Weight B H) (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ),
    IsWeightCharacter D Λ χ →
    let W := affineVermaWeightSpace_value D χ
    DirectSum.IsInternal W ∧ (∀ μ, FiniteDimensional ℂ (W μ)) ∧
      affineVermaTop_value D χ ≠ 0 ∧ W Λ = ℂ ∙ affineVermaTop_value D χ

def affineVermaWeightSupport_type : Prop :=
  ∀ {G : Type u} [LieRing G] [LieAlgebra ℂ G] [FiniteDimensional ℂ G]
    [LieAlgebra.IsSimple ℂ G] (B : InvariantForm G) (H : LieSubalgebra ℂ G)
    [H.IsCartanSubalgebra] (φ : Direction H) (D : Model B H φ), B.IsNormalized H →
    Regular H φ → ∀ (Λ : Weight B H) (χ : U (affineBorel_value D) →ₐ[ℂ] ℂ),
    IsWeightCharacter D Λ χ →
    ∀ θ : Module.Dual ℂ H, IsHighestFiniteRoot H φ θ →
      ∀ μ : Weight B H, affineVermaWeightSpace_value D χ μ ≠ ⊥ →
        Λ - μ ∈ positiveRootCone_value
          (fun i : AffineSimpleIndex H φ => affineSimpleRoot B H θ i)

end Specs.RepTheorySurvey.Affine.VermaWeightSpaces
