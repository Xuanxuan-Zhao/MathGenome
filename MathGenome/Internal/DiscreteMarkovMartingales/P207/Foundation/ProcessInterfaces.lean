import MathGenome.Internal.DiscreteMarkovMartingales.Specs.P207.Foundation.ProcessInterfaces

/-! Interfaces for the definitions in paper.tex §1.1.
The all-pairs martingale equivalence and examples are separate obligations. -/

open MeasureTheory
open scoped MeasureTheory

universe u v

namespace P207

variable {Ω : Type u} [m : MeasurableSpace Ω]

/- Candidate-owned aliases expose the shared canonical definitions for value
checking. All downstream statements use the original objects in `P207`. -/
namespace ProcessInterfaces

abbrev naturalFiltration : ProcessInterfacesSpec.naturalFiltrationType.{u, v} :=
  @P207.naturalFiltration.{u, v}

abbrev terminalSigma : ProcessInterfacesSpec.terminalSigmaType.{u} :=
  @P207.terminalSigma.{u}

abbrev IsMartingale : ProcessInterfacesSpec.realProcessPredicateType.{u} :=
  @P207.IsMartingale.{u}

abbrev IsSubmartingale : ProcessInterfacesSpec.realProcessPredicateType.{u} :=
  @P207.IsSubmartingale.{u}

end ProcessInterfaces

theorem filtration_mono (ℱ : Filtration ℕ m) {i j : ℕ} (hij : i ≤ j) :
    ℱ i ≤ ℱ j := ℱ.mono hij

theorem filtration_le (ℱ : Filtration ℕ m) (n : ℕ) : ℱ n ≤ m := ℱ.le n

/-- For real-valued processes the source's measurable adaptation is precisely
Mathlib's strong adaptation, without any completion or a.e. replacement. -/
theorem adapted_iff_stronglyAdapted (ℱ : Filtration ℕ m) (X : ℕ → Ω → ℝ) :
    Adapted ℱ X ↔ StronglyAdapted ℱ X :=
  ⟨fun h => h.stronglyAdapted, fun h => h.adapted⟩

theorem naturalFiltration_apply {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) (n : ℕ) :
    naturalFiltration X hX n = ⨆ k ≤ n, MeasurableSpace.comap (X k) inferInstance := rfl

theorem adapted_naturalFiltration {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) : Adapted (naturalFiltration X hX) X := by
  intro n
  apply measurable_iff_comap_le.mpr
  exact le_iSup₂_of_le n le_rfl le_rfl

/-- Minimality verifies that this is the sigma-algebra generated by all observations
through the current time, rather than just some filtration adapting the process. -/
theorem naturalFiltration_le {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) (ℱ : Filtration ℕ m) (h : Adapted ℱ X) (n : ℕ) :
    naturalFiltration X hX n ≤ ℱ n := by
  exact iSup₂_le fun k hkn => (h k).comap_le.trans (ℱ.mono hkn)

theorem naturalFiltration_eq_library (X : ℕ → Ω → ℝ)
    (hX : ∀ n, Measurable (X n)) :
    naturalFiltration X hX = Filtration.natural X (fun n => (hX n).stronglyMeasurable) := rfl

theorem terminalSigma_eq (ℱ : Filtration ℕ m) : terminalSigma ℱ = ⨆ n, ℱ n := rfl

theorem le_terminalSigma (ℱ : Filtration ℕ m) (n : ℕ) : ℱ n ≤ terminalSigma ℱ :=
  le_iSup (fun k => ℱ k) n

theorem terminalSigma_le (ℱ : Filtration ℕ m) : terminalSigma ℱ ≤ m :=
  iSup_le fun n => ℱ.le n

theorem isMartingale_iff (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω) :
    IsMartingale X ℱ μ ↔
      (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
        ∀ n, μ[X (n + 1) | ℱ n] =ᵐ[μ] X n := Iff.rfl

theorem isSubmartingale_iff (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω) :
    IsSubmartingale X ℱ μ ↔
      (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
        ∀ n, X n ≤ᵐ[μ] μ[X (n + 1) | ℱ n] := Iff.rfl

end P207
