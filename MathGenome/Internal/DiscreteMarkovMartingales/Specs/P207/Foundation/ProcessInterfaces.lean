import Mathlib.Probability.Process.Adapted

/-!
The canonical discrete-time objects for paper.tex §1.1 (p207:W01).
`Filtration ℕ m` and `Adapted` are Mathlib's increasing sub-sigma-algebras
and pointwise measurable adaptation. Time zero is included.
The definitions below make sense for any measure, hence in particular for
all probability spaces in the source. No completeness of the space is assumed.
-/

open MeasureTheory
open scoped MeasureTheory

universe u v

namespace P207

variable {Ω : Type u} [m : MeasurableSpace Ω]

/-- The sigma-algebra generated by the observations at times `0, …, n`.
Only ambient measurability is needed, so this also applies to discrete states. -/
def naturalFiltration {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) : Filtration ℕ m where
  seq n := ⨆ k ≤ n, MeasurableSpace.comap (X k) inferInstance
  mono' _ _ hij := biSup_mono fun _ => ge_trans hij
  le' _ := iSup₂_le fun k _ => (hX k).comap_le

/-- The terminal sigma-algebra, generated by the union of the finite-time ones. -/
@[instance_reducible] def terminalSigma (ℱ : Filtration ℕ m) : MeasurableSpace Ω := ⨆ n, ℱ n

/-- The source's real martingale predicate, with its explicit one-step condition. -/
def IsMartingale (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω) : Prop :=
  Adapted ℱ X ∧ (∀ n, Integrable (X n) μ) ∧
    ∀ n, μ[X (n + 1) | ℱ n] =ᵐ[μ] X n

/-- The source's real submartingale predicate, with its explicit one-step condition. -/
def IsSubmartingale (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω) : Prop :=
  Adapted ℱ X ∧ (∀ n, Integrable (X n) μ) ∧
    ∀ n, X n ≤ᵐ[μ] μ[X (n + 1) | ℱ n]

namespace ProcessInterfacesSpec

/- Independent expected types and values for the four canonical definitions. -/
def naturalFiltrationType :=
  {Ω : Type u} → [m : MeasurableSpace Ω] → {β : Type v} → [MeasurableSpace β] →
    (X : ℕ → Ω → β) → (∀ n, Measurable (X n)) → Filtration ℕ m

def naturalFiltrationValue : naturalFiltrationType.{u, v} :=
  fun {_} [_] {_} [_] X hX =>
    { seq := fun n => ⨆ k ≤ n, MeasurableSpace.comap (X k) inferInstance
      mono' := fun _ _ hij => biSup_mono fun _ => ge_trans hij
      le' := fun _ => iSup₂_le fun k _ => (hX k).comap_le }

def terminalSigmaType :=
  {Ω : Type u} → [m : MeasurableSpace Ω] → Filtration ℕ m → MeasurableSpace Ω

def terminalSigmaValue : terminalSigmaType.{u} := fun {_} [_] ℱ => ⨆ n, ℱ n

def realProcessPredicateType :=
  {Ω : Type u} → [m : MeasurableSpace Ω] →
    (ℕ → Ω → ℝ) → Filtration ℕ m → Measure Ω → Prop

def isMartingaleValue : realProcessPredicateType.{u} :=
  fun {_} [_] X ℱ μ =>
    (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
      ∀ n, μ[X (n + 1) | ℱ n] =ᵐ[μ] X n

def isSubmartingaleValue : realProcessPredicateType.{u} :=
  fun {_} [_] X ℱ μ =>
    (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
      ∀ n, X n ≤ᵐ[μ] μ[X (n + 1) | ℱ n]

/- Theorems are specified as their full proposition types, without certificates. -/
def filtration_mono : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (ℱ : Filtration ℕ m) {i j : ℕ}, i ≤ j → ℱ i ≤ ℱ j

def filtration_le : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω], ∀ (ℱ : Filtration ℕ m) n, ℱ n ≤ m

def adapted_iff_stronglyAdapted : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (ℱ : Filtration ℕ m) (X : ℕ → Ω → ℝ), Adapted ℱ X ↔ StronglyAdapted ℱ X

def naturalFiltration_apply : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) n,
    naturalFiltration X hX n = ⨆ k ≤ n, MeasurableSpace.comap (X k) inferInstance

def adapted_naturalFiltration : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)), Adapted (naturalFiltration X hX) X

def naturalFiltration_le : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ {β : Type v} [MeasurableSpace β] (X : ℕ → Ω → β)
    (hX : ∀ n, Measurable (X n)) (ℱ : Filtration ℕ m),
    Adapted ℱ X → ∀ n, naturalFiltration X hX n ≤ ℱ n

def naturalFiltration_eq_library : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (X : ℕ → Ω → ℝ) (hX : ∀ n, Measurable (X n)),
    naturalFiltration X hX = Filtration.natural X (fun n => (hX n).stronglyMeasurable)

def terminalSigma_eq : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (ℱ : Filtration ℕ m), terminalSigma ℱ = ⨆ n, ℱ n

def le_terminalSigma : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω], ∀ (ℱ : Filtration ℕ m) n, ℱ n ≤ terminalSigma ℱ

def terminalSigma_le : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω], ∀ (ℱ : Filtration ℕ m), terminalSigma ℱ ≤ m

def isMartingale_iff : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω),
    IsMartingale X ℱ μ ↔
      (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
        ∀ n, μ[X (n + 1) | ℱ n] =ᵐ[μ] X n

def isSubmartingale_iff : Prop :=
  ∀ {Ω : Type u} [m : MeasurableSpace Ω],
  ∀ (X : ℕ → Ω → ℝ) (ℱ : Filtration ℕ m) (μ : Measure Ω),
    IsSubmartingale X ℱ μ ↔
      (∀ n, Measurable[ℱ n] (X n)) ∧ (∀ n, Integrable (X n) μ) ∧
        ∀ n, X n ≤ᵐ[μ] μ[X (n + 1) | ℱ n]

end ProcessInterfacesSpec
end P207
