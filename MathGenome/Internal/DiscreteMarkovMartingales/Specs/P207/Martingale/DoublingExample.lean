import MathGenome.Internal.DiscreteMarkovMartingales.Specs.P207.Foundation.ProcessInterfaces
import MathGenome.Internal.DiscreteMarkovMartingales.Specs.P207.Martingale.UniformIntegrability
import Mathlib.Probability.Distributions.Bernoulli
import Mathlib.Probability.Independence.InfinitePi

/-! The independent fair-coin model of paper.tex W30. Toss `k` below is the
source's toss numbered `k+1`; time zero reveals no tosses. These canonical
objects are shared with the later first-tail stopping example. -/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal Topology MeasureTheory

noncomputable section
namespace P207.Doubling

abbrev Ω := ℕ → Bool

def coinMeasure : Measure Bool :=
  bernoulliMeasure true false ⟨1 / 2, by constructor <;> norm_num⟩

instance : IsProbabilityMeasure coinMeasure := by
  unfold coinMeasure
  infer_instance

def μ : Measure Ω := Measure.infinitePi (fun _ : ℕ => coinMeasure)

/-- Toss `k` is the `(k+1)`st toss, with `true` meaning heads. -/
def toss (k : ℕ) (ω : Ω) : Bool := ω k

/-- Exactly the sigma-algebra generated by the first `n` tosses. -/
def filtration : Filtration ℕ (inferInstance : MeasurableSpace Ω) where
  seq n := ⨆ k < n, MeasurableSpace.comap (toss k) inferInstance
  mono' _ _ h := iSup₂_le fun k hk => le_iSup₂_of_le k (hk.trans_le h) le_rfl
  le' _ := iSup₂_le fun k _ => (measurable_pi_apply k).comap_le

def allHeads (n : ℕ) : Set Ω := {ω | ∀ k < n, toss k ω = true}

def M (n : ℕ) : Ω → ℝ := (allHeads n).indicator (fun _ => (2 : ℝ) ^ n)

end P207.Doubling

namespace P207.DoublingSpec
open P207.Doubling

def probability : Prop := IsProbabilityMeasure μ

def toss_law : Prop := ∀ k, Measure.map (toss k) μ = coinMeasure

def independent_tosses : Prop := ProbabilityTheory.iIndepFun toss μ

def fair_coin : Prop := coinMeasure {true} = (2 : ℝ≥0∞)⁻¹ ∧
  coinMeasure {false} = (2 : ℝ≥0∞)⁻¹

def filtration_eq : Prop := ∀ n, filtration n =
  ⨆ k < n, MeasurableSpace.comap (toss k) inferInstance

def allHeads_zero : Prop := allHeads 0 = Set.univ

def allHeads_measure : Prop := ∀ n, μ (allHeads n) = ((2 : ℝ≥0∞)⁻¹) ^ n

def M_zero : Prop := ∀ ω, M 0 ω = 1

def M_nonneg : Prop := ∀ n ω, 0 ≤ M n ω

def martingale : Prop := P207.IsMartingale M filtration μ

def abs_expectation : Prop := ∀ n, (∫ ω, |M n ω| ∂μ) = 1

def ae_tendsto_zero : Prop := ∀ᵐ ω ∂μ, Tendsto (fun n => M n ω) atTop (𝓝 0)

def tail_expectation : Prop := ∀ R : ℝ, ∃ n : ℕ, R < (2 : ℝ) ^ n ∧
  (∫ ω, {ω | R < M n ω}.indicator (M n) ω ∂μ) = 1

def not_uniformIntegrable : Prop :=
  ¬ Specs.P207.Martingale.UniformIntegrability.SourceUniformIntegrableValue μ M

/-- Each candidate limit is integrable, so these real integrals are genuine
L¹ distances rather than the default value of a nonintegrable integral. -/
def not_tendsto_L1 : Prop := ∀ Y : Ω → ℝ, Integrable Y μ →
  ¬ Tendsto (fun n => ∫ ω, |M n ω - Y ω| ∂μ) atTop (𝓝 0)

end P207.DoublingSpec
