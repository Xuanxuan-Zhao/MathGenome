import MathGenome.Internal.ExtremalOptimization.Specs.P205.Probability.FiniteModels
import MathGenome.Internal.ExtremalOptimization.Specs.P205.Probability.DependencyGraph
import Mathlib.MeasureTheory.MeasurableSpace.Instances
import Mathlib.Tactic.NormNum

/-! The fair-bit counterexample following Definition 6.1, paper.tex 1308–1319.
The outcomes are assignments of two bits, with the canonical product weights.
All expected statements below are propositions, not assumed certificates. -/

open MeasureTheory ProbabilityTheory
open scoped BigOperators Classical

noncomputable section

namespace P205.Probability.PairwiseCounterexample

-- Match the classical finite-function enumeration in `FiniteModel.pi`.
local instance : DecidableEq (Fin 2) := Classical.decEq _

abbrev Bit := Fin 2
abbrev Outcome := Fin 2 → Bit

noncomputable def fairBit : FiniteModel Bit where
  weight _ := 1 / 2
  weight_nonneg _ := by norm_num
  weight_sum := by norm_num [Fin.sum_univ_two]

noncomputable def experiment : FiniteModel Outcome := FiniteModel.pi (fun _ : Fin 2 => fairBit)
noncomputable def μ : Measure Outcome := experiment.measure

instance : IsProbabilityMeasure μ :=
  inferInstanceAs (IsProbabilityMeasure experiment.pmf.toMeasure)

def U (ω : Outcome) : Bit := ω 0
def V (ω : Outcome) : Bit := ω 1

def A : Set Outcome := {ω | U ω = 0}
def B : Set Outcome := {ω | V ω = 0}
def C : Set Outcome := {ω | U ω = V ω}

def events (i : Fin 3) : Set Outcome := ![A, B, C] i

end P205.Probability.PairwiseCounterexample

namespace P205.Probability.PairwiseCounterexampleSpec
open PairwiseCounterexample

/-- The underlying coordinates are independent uniform bits. -/
def fairIndependentBits : Prop :=
  (∀ b : Bit, μ {ω | U ω = b} = ENNReal.ofReal (1 / 2 : ℝ) ∧
    μ {ω | V ω = b} = ENNReal.ofReal (1 / 2 : ℝ)) ∧
  IndepFun U V μ

/-- All three individual probabilities and all six ordered distinct pairs. -/
def probabilities : Prop :=
  (∀ i : Fin 3, μ (events i) = ENNReal.ofReal (1 / 2 : ℝ)) ∧
  (∀ i j : Fin 3, i ≠ j → μ (events i ∩ events j) = ENNReal.ofReal (1 / 4 : ℝ))

def pairwiseIndependent : Prop :=
  Pairwise (fun i j : Fin 3 => IndepSet (events i) (events j) μ)

/-- The witness is in the sigma-algebra jointly generated by A and B. -/
def intersectionGenerated : Prop :=
  MeasurableSet[MeasurableSpace.generateFrom {A, B}] (A ∩ B)

/-- The two numerical values and the failure of independence of C from A ∩ B. -/
def obstruction : Prop :=
  μ (C ∩ (A ∩ B)) = ENNReal.ofReal (1 / 4 : ℝ) ∧
  μ C * μ (A ∩ B) = ENNReal.ofReal (1 / 8 : ℝ) ∧
  μ (C ∩ (A ∩ B)) ≠ μ C * μ (A ∩ B)

/-- The empty graph fails the full dependency-graph definition. -/
def notDependencyGraph : Prop :=
  ¬ Specs.P205.Probability.IsDependencyGraphValue μ events (⊥ : SimpleGraph (Fin 3))

end P205.Probability.PairwiseCounterexampleSpec

end
