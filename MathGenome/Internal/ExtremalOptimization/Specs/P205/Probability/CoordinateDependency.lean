import MathGenome.Internal.ExtremalOptimization.Specs.P205.Probability.FiniteModels
import MathGenome.Internal.ExtremalOptimization.Specs.P205.Probability.DependencyGraph

/-! Coordinate dependency graphs, the product-space example after Definition 6.1,
paper.tex 1291–1306. All coordinate spaces are finite and discrete. Agreement
on a block determines event membership, even at outcomes of weight zero. -/

open MeasureTheory ProbabilityTheory
open scoped Classical

namespace P205.Probability.CoordinateDependency

variable {K I : Type*} {X : K → Type*}

/-- Event membership is determined by the coordinates in `S`. -/
def DependsOn (S : Set K) (A : Set (∀ k, X k)) : Prop :=
  ∀ x y, (∀ k ∈ S, x k = y k) → (x ∈ A ↔ y ∈ A)

/-- The sigma-algebra of the restriction to the coordinate block. -/
def blockSpace [∀ k, MeasurableSpace (X k)] (S : Set K) :
    MeasurableSpace (∀ k, X k) :=
  MeasurableSpace.comap (fun x (k : S) => x k) inferInstance

/-- Distinct vertices are adjacent exactly when their coordinate blocks overlap. -/
def overlapGraph (S : I → Set K) : SimpleGraph I where
  Adj i j := i ≠ j ∧ (S i ∩ S j).Nonempty
  symm := ⟨by
    rintro i j ⟨h, k, hi, hj⟩
    exact ⟨h.symm, k, hj, hi⟩⟩
  loopless := ⟨by intro i h; exact h.1 rfl⟩

/-- The union of the blocks used by all distinct nonneighbors of `i`. -/
def nonneighborBlock (S : I → Set K) (i : I) : Set K :=
  ⋃ j ∈ {j | j ≠ i ∧ ¬ (overlapGraph S).Adj i j}, S j

end P205.Probability.CoordinateDependency

namespace Specs.P205.Probability.CoordinateDependency

open _root_.P205.Probability
open _root_.P205.Probability.CoordinateDependency

/-- Both cylinder measurability on its block and ambient measurability. -/
def cylinderMeasurable : Prop :=
  ∀ {K : Type*} {X : K → Type*} [Fintype K] [∀ k, Fintype (X k)]
    [∀ k, MeasurableSpace (X k)] [∀ k, MeasurableSingletonClass (X k)]
    (S : Set K) (A : Set (∀ k, X k)), DependsOn S A →
    MeasurableSet[blockSpace (X := X) S] A ∧ MeasurableSet A

/-- The complete sigma-algebra generated by nonneighbors is contained in that
of their union block; this is stronger than containment of its generators. -/
def nonneighborContainment : Prop :=
  ∀ {K I : Type*} {X : K → Type*} [Fintype K]
    [∀ k, Fintype (X k)] [∀ k, MeasurableSpace (X k)]
    [∀ k, MeasurableSingletonClass (X k)] [Finite I]
    (S : I → Set K) (A : I → Set (∀ k, X k)),
    (∀ i, DependsOn (S i) (A i)) → ∀ i,
    MeasurableSpace.generateFrom
      (A '' {j | j ≠ i ∧ ¬ (overlapGraph S).Adj i j}) ≤
      blockSpace (X := X) (nonneighborBlock S i)

def disjointBlocks : Prop := ∀ {K I : Type*} (S : I → Set K) (i : I),
  Disjoint (S i) (nonneighborBlock S i)

/-- Independence of entire disjoint block sigma-algebras, including empty blocks. -/
def independentBlocks : Prop :=
  ∀ {K : Type*} {X : K → Type*} [Fintype K] [∀ k, Fintype (X k)]
    [∀ k, MeasurableSpace (X k)] [∀ k, MeasurableSingletonClass (X k)]
    (M : ∀ k, FiniteModel (X k)) (S T : Set K), Disjoint S T →
    Indep (blockSpace (X := X) S) (blockSpace (X := X) T) (FiniteModel.pi M).measure

/-- The overlap graph satisfies the canonical full dependency-graph definition. -/
def dependencyGraph : Prop :=
  ∀ {K I : Type*} {X : K → Type*} [Fintype K]
    [∀ k, Fintype (X k)] [∀ k, MeasurableSpace (X k)]
    [∀ k, MeasurableSingletonClass (X k)] [Finite I]
    (M : ∀ k, FiniteModel (X k)) (S : I → Set K) (A : I → Set (∀ k, X k)),
    (∀ i, DependsOn (S i) (A i)) →
    @IsDependencyGraphValue I _ (∀ k, X k) _ (FiniteModel.pi M).measure
      (inferInstanceAs (IsProbabilityMeasure (FiniteModel.pi M).pmf.toMeasure))
      A (overlapGraph S)

end Specs.P205.Probability.CoordinateDependency
