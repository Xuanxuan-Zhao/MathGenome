import Mathlib.Combinatorics.SimpleGraph.Basic
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability

/-!
# Dependency graphs for finite families of events

Definition 6.1 (p205:W27). Each event is independent of every event in the
sigma-algebra jointly generated by all events at distinct nonadjacent vertices.
-/

open MeasureTheory

universe u v

namespace P205.Probability

/-- A simple graph is a dependency graph for a finite family of measurable events
if each event is independent of the sigma-algebra generated by its nonneighbors.
Measurability is with respect to the ambient space; the independence condition
uses the full generated sigma-algebra. Empty finite families are allowed. -/
def IsDependencyGraph {I : Type u} [Finite I] {Ω : Type v} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (A : I → Set Ω) (D : SimpleGraph I) : Prop :=
  (∀ i, MeasurableSet (A i)) ∧
  ∀ (i : I) (B : Set Ω),
    MeasurableSet[MeasurableSpace.generateFrom
      (A '' {j : I | j ≠ i ∧ ¬ D.Adj i j})] B →
    μ (A i ∩ B) = μ (A i) * μ B

end P205.Probability
