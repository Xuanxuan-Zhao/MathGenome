import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.Foundations
import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.KrullTopology.FiniteStabilizers

universe u v
noncomputable section
open scoped Pointwise Topology
open TopologicalSpace

namespace AdvancedFieldTheory.KrullTopology

variable (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]

/-- The subgroup G(S), for arbitrary sets, specialized below to finite sets. -/
abbrev finiteStabilizer (S : Set L) : Subgroup (L ≃ₐ[K] L) :=
  Specs.AdvancedFieldTheory.KrullTopology.stabilizer K S

/-- The left cosets σG(S) with S finite. -/
def finiteCosetBasis : Set (Set (L ≃ₐ[K] L)) :=
  Specs.AdvancedFieldTheory.KrullTopology.cosets K (L := L)

/-- The topology generated by finite-stabilizer cosets. -/
@[instance_reducible]
def finiteStabilizerTopology : TopologicalSpace (L ≃ₐ[K] L) :=
  TopologicalSpace.generateFrom (finiteCosetBasis K L)

variable {K L}

theorem mem_finiteStabilizer (S : Set L) (σ : L ≃ₐ[K] L) :
    σ ∈ finiteStabilizer K L S ↔ ∀ x ∈ S, σ x = x := Iff.rfl

theorem finiteStabilizer_eq_fixingSubgroup (S : Set L) :
    finiteStabilizer K L S = (IntermediateField.adjoin K S).fixingSubgroup := by
  ext σ
  exact (IntermediateField.mem_fixingSubgroup_iff _ _).trans
    (IntermediateField.forall_mem_adjoin_smul_eq_self_iff K σ) |>.symm

theorem finiteStabilizer_empty (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] : finiteStabilizer K L (∅ : Set L) = ⊤ := by
  ext σ
  simp [mem_finiteStabilizer]

theorem finiteStabilizer_union (S T : Set L) :
    finiteStabilizer K L S ⊓ finiteStabilizer K L T = finiteStabilizer K L (S ∪ T) := by
  ext σ
  simp only [Subgroup.mem_inf, mem_finiteStabilizer, Set.forall_mem_union]

theorem finiteStabilizer_conjugate (σ : L ≃ₐ[K] L) (S : Set L) :
    (fun τ => σ * τ * σ⁻¹) '' (finiteStabilizer K L S : Set (L ≃ₐ[K] L)) =
      (finiteStabilizer K L (σ '' S) : Set (L ≃ₐ[K] L)) := by
  ext τ
  constructor
  · rintro ⟨h, hh, rfl⟩ x ⟨y, hy, rfl⟩
    change σ (h (σ.symm (σ y))) = σ y
    rw [σ.symm_apply_apply, hh y hy]
  · intro hτ
    refine ⟨σ⁻¹ * τ * σ, ?_, ?_⟩
    · intro x hx
      change σ.symm (τ (σ x)) = x
      rw [hτ (σ x) ⟨x, hx, rfl⟩, σ.symm_apply_apply]
    · simp [mul_assoc]

variable [IsGalois K L]

/-- Finite extensions are finitely generated; finite sets generate finite extensions.
Thus the two bases agree exactly, rather than merely being cofinal. -/
theorem galBasis_eq_finiteStabilizers (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    (galBasis K L).sets =
      {U | ∃ S : Set L, S.Finite ∧ U = (finiteStabilizer K L S : Set (L ≃ₐ[K] L))} := by
  ext U
  constructor
  · rintro ⟨_, ⟨E, hE, rfl⟩, rfl⟩
    have : FiniteDimensional K E := hE
    have hfg : E.FG := IntermediateField.essFiniteType_iff.mp inferInstance
    obtain ⟨S, hS⟩ := hfg
    refine ⟨S, S.finite_toSet, ?_⟩
    rw [finiteStabilizer_eq_fixingSubgroup, hS]
    rfl
  · rintro ⟨S, hS, rfl⟩
    let : Finite S := hS.to_subtype
    rw [finiteStabilizer_eq_fixingSubgroup]
    exact ⟨_, ⟨IntermediateField.adjoin K S,
      (show FiniteDimensional K (IntermediateField.adjoin K S) from inferInstance), rfl⟩, rfl⟩

theorem finiteStabilizer_isOpen (S : Set L) (hS : S.Finite) :
    IsOpen (finiteStabilizer K L S : Set (L ≃ₐ[K] L)) := by
  let : Finite S := hS.to_subtype
  rw [finiteStabilizer_eq_fixingSubgroup]
  exact IntermediateField.fixingSubgroup_isOpen _

theorem finiteStabilizers_nhds_one (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    (𝓝 (1 : L ≃ₐ[K] L)).HasBasis (fun S : Set L => S.Finite)
      (fun S => (finiteStabilizer K L S : Set (L ≃ₐ[K] L))) := by
  have h := (galGroupBasis K L).nhds_one_hasBasis
  constructor
  intro U
  rw [h.mem_iff]
  constructor
  · rintro ⟨V, hV, hVU⟩
    change V ∈ (galBasis K L).sets at hV
    rw [galBasis_eq_finiteStabilizers K L] at hV
    obtain ⟨S, hS, rfl⟩ := hV
    exact ⟨S, hS, hVU⟩
  · rintro ⟨S, hS, hSU⟩
    refine ⟨(finiteStabilizer K L S : Set (L ≃ₐ[K] L)), ?_, hSU⟩
    change (finiteStabilizer K L S : Set (L ≃ₐ[K] L)) ∈ (galBasis K L).sets
    rw [galBasis_eq_finiteStabilizers K L]
    exact ⟨S, hS, rfl⟩

theorem finiteCosetBasis_isTopologicalBasis (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    IsTopologicalBasis (finiteCosetBasis K L) := by
  apply isTopologicalBasis_of_isOpen_of_nhds
  · rintro U ⟨σ, S, hS, rfl⟩
    exact (finiteStabilizer_isOpen S hS).leftCoset σ
  · intro σ U hσ hU
    obtain ⟨V, hV, hVU⟩ := ((galGroupBasis K L).nhds_hasBasis σ).mem_iff.mp
      (hU.mem_nhds hσ)
    change V ∈ (galBasis K L).sets at hV
    rw [galBasis_eq_finiteStabilizers K L] at hV
    obtain ⟨S, hS, rfl⟩ := hV
    refine ⟨σ • (finiteStabilizer K L S : Set (L ≃ₐ[K] L)), ⟨σ, S, hS, rfl⟩, ?_, hVU⟩
    exact ⟨1, (finiteStabilizer K L S).one_mem, mul_one σ⟩

theorem finiteStabilizerTopology_eq_krull (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    finiteStabilizerTopology K L = krullTopology K L := by
  exact (finiteCosetBasis_isTopologicalBasis K L).eq_generateFrom.symm

theorem finiteCosetBasis_unique (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    ∃! t : TopologicalSpace (L ≃ₐ[K] L),
      @IsTopologicalBasis _ t (finiteCosetBasis K L) := by
  refine ⟨krullTopology K L, finiteCosetBasis_isTopologicalBasis K L, ?_⟩
  intro t ht
  exact ht.eq_generateFrom.trans (finiteStabilizerTopology_eq_krull K L)

theorem finiteStabilizerTopology_isTopologicalGroup (K : Type u) (L : Type v)
    [Field K] [Field L] [Algebra K L] [IsGalois K L] :
    @IsTopologicalGroup (L ≃ₐ[K] L) (finiteStabilizerTopology K L) _ := by
  rw [finiteStabilizerTopology_eq_krull K L]
  infer_instance

end AdvancedFieldTheory.KrullTopology
