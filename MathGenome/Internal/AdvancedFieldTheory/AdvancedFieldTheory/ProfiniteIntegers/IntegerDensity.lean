import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.ProfiniteIntegers.IntegerDensity
import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.ProfiniteIntegers.ResidueModel
import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.FiniteFields.AbsoluteGaloisGroup
import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.FiniteFields.GlobalFrobenius
import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.FiniteFields.RootFields
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

noncomputable section
universe u v
namespace AdvancedFieldTheory
namespace ProfiniteIntegers

/-- One coordinate at a common multiple realizes any finite prescription. -/
theorem finite_coordinate_matching : Specs.AdvancedFieldTheory.IntegerDensity.FiniteCoordinateMatching := by
  classical
  intro a s
  have hcommon : ∃ N : ℕ+, ∀ n ∈ s, (n : ℕ) ∣ (N : ℕ) := by
    induction s using Finset.induction_on with
    | empty => exact ⟨1, by simp⟩
    | @insert n s hn ih =>
      obtain ⟨N, hN⟩ := ih
      refine ⟨n * N, ?_⟩
      intro m hm
      rcases Finset.mem_insert.mp hm with rfl | hm
      · exact dvd_mul_right _ _
      · exact dvd_trans (hN m hm) (dvd_mul_left _ _)
  obtain ⟨N, hN⟩ := hcommon
  refine ⟨ZMod.cast (π N a), ?_⟩
  intro n hn
  have h := coordinate_compatibility a n N (hN n hn)
  change reduce n N (hN n hn) (π N a) = π n a at h
  rw [← ZMod.intCast_zmod_cast (π N a)] at h
  change (ZMod.castHom (hN n hn) (ZMod (n : ℕ)))
    ((ZMod.cast (π N a) : ℤ) : ZMod (N : ℕ)) = π n a at h
  rw [map_intCast] at h
  exact h

/-- The integer residue homomorphism has dense image in the product subspace. -/
theorem integer_dense : Specs.AdvancedFieldTheory.IntegerDensity.IntegerDense := by
  apply dense_iff_inter_open.mpr
  intro U hU hne
  obtain ⟨V, hV, hVU⟩ := isOpen_induced_iff.mp hU
  obtain ⟨a, ha⟩ := hne
  have haV : a.val ∈ V := by rw [← hVU] at ha; exact ha
  obtain ⟨s, W, hW, hWV⟩ := isOpen_pi_iff.mp hV a.val haV
  obtain ⟨z, hz⟩ := finite_coordinate_matching a s
  refine ⟨ι z, ?_, ⟨z, rfl⟩⟩
  rw [← hVU]
  apply hWV
  intro n hn
  have he : (ι z).val n = a.val n := hz n hn
  rw [he]
  exact (hW n hn).2

end ProfiniteIntegers

/-- Transport of all integer powers by any isomorphism sending Frobenius to 1. -/
theorem frobenius_zpow_residues
    (k : Type u) (Ω : Type v) [Field k] [Fintype k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω]
    (e : GaloisGroup k Ω ≃ₜ* Multiplicative ProfiniteIntegers.Zhat)
    (he : e (globalFrobenius k Ω) = Multiplicative.ofAdd (ProfiniteIntegers.ι 1))
    (z : ℤ) :
    e (globalFrobenius k Ω ^ z) = Multiplicative.ofAdd (ProfiniteIntegers.ι z) := by
  rw [map_zpow, he, ← ofAdd_zsmul, ← map_zsmul]
  simp

/-- The ordinary cyclic subgroup generated by Frobenius is dense. -/
theorem frobenius_cyclic_dense :
    Specs.AdvancedFieldTheory.IntegerDensity.FrobeniusCyclicDense.{u, v} := by
  intro k Ω _ _ _ _ _
  obtain ⟨coords, hc, e, he, hu⟩ := AbsoluteGalois.absoluteGaloisGroup k Ω
  have hi : DenseRange (fun z : ℤ =>
      Multiplicative.ofAdd (ProfiniteIntegers.ι z)) := ProfiniteIntegers.integer_dense
  have hd := e.symm.surjective.denseRange.comp hi e.symm.continuous
  have hfun : (fun z : ℤ => e.symm (Multiplicative.ofAdd (ProfiniteIntegers.ι z))) =
      (fun z : ℤ => globalFrobenius k Ω ^ z) := by
    funext z
    apply e.injective
    rw [e.apply_symm_apply, frobenius_zpow_residues k Ω e he.2]
  change DenseRange (fun z : ℤ => e.symm (Multiplicative.ofAdd (ProfiniteIntegers.ι z))) at hd
  rw [hfun] at hd
  exact hd.mono (by rintro _ ⟨z, rfl⟩; exact Subgroup.zpow_mem_zpowers _ z)

/-- Fixed by all integer powers iff fixed by Frobenius, hence in the base field. -/
theorem frobenius_cyclic_fixedField :
    Specs.AdvancedFieldTheory.IntegerDensity.FrobeniusCyclicFixedField.{u, v} := by
  intro k Ω _ _ _ _ _
  apply le_antisymm ?_ bot_le
  intro x hx
  have hfix : globalFrobenius k Ω x = x :=
    (IntermediateField.mem_fixedField_iff _ _).mp hx _ (Subgroup.mem_zpowers _)
  have hx1 : x ∈ finiteRootField k Ω 1 := by
    rw [mem_finiteRootField, pow_one]
    exact hfix
  rwa [finiteRootField_one k Ω] at hx1

end AdvancedFieldTheory
