import MathGenome.Internal.AdvancedFieldTheory.AdvancedFieldTheory.Correspondence.InfiniteGalois
import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.Correspondence.LatticeOperations

/-! # Lattice operations in the infinite Galois correspondence

The lattice assertions of FT-C05. No nonemptiness assumption is imposed on
the family. Supremum and infimum are the actual complete-lattice operations,
so the empty cases use the base field and the whole extension respectively.
-/

universe u v w

namespace AdvancedFieldTheory

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]

/-- The fixing subgroup of a compositum is the intersection of the fixing
subgroups of all its constituent fields, including for an empty family. -/
theorem fixingSubgroup_iSup [IsGalois K L] {I : Type w}
    (M : I → IntermediateField K L) :
    fixingSubgroup (⨆ i, M i) = ⨅ i, fixingSubgroup (M i) := by
  apply le_antisymm
  · exact le_iInf fun i => IntermediateField.fixingSubgroup_le (le_iSup M i)
  · apply (IntermediateField.le_iff_le _ _).mp
    apply iSup_le
    intro i
    apply (IntermediateField.le_iff_le _ _).mpr
    exact iInf_le (fun i => fixingSubgroup (M i)) i

/-- The fixing subgroup of an intersection is the Krull closure of the subgroup
generated by the union of the fixing subgroups, including for an empty family. -/
theorem fixingSubgroup_iInf [IsGalois K L] {I : Type w}
    (M : I → IntermediateField K L) :
    fixingSubgroup (⨅ i, M i) =
      (Subgroup.closure (⋃ i, (fixingSubgroup (M i) : Set (GaloisGroup K L)))).topologicalClosure := by
  have hfixed : fixedField (⨆ i, fixingSubgroup (M i)) = ⨅ i, M i := by
    apply le_antisymm
    · apply le_iInf
      intro i
      calc
        fixedField (⨆ j, fixingSubgroup (M j)) ≤ fixedField (fixingSubgroup (M i)) :=
          IntermediateField.fixedField_le (le_iSup (fun j => fixingSubgroup (M j)) i)
        _ = M i := fixedField_fixingSubgroup K L (M i)
    · apply (IntermediateField.le_iff_le _ _).mpr
      apply iSup_le
      intro i
      exact IntermediateField.fixingSubgroup_le (iInf_le M i)
  rw [← hfixed, fixingSubgroup_fixedField_eq_topologicalClosure,
    Subgroup.iSup_eq_closure]

end AdvancedFieldTheory
