import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.Foundations

/-!
Independent statements for FT-F01B.
Source: notes/003/advanced-field-theory.tex, Proposition F01 (lines 134–140),
with the literal intermediate-field convention of lines 122–132.
A splitting extension is expressed by `Splits` in the ambient field; it is
not required to be generated by the roots. The intermediate field in the
conclusion is generated by all roots in that ambient field.
-/

universe u v

namespace Specs.AdvancedFieldTheory

/-- The roots of a separable polynomial generate a finite, normal, separable,
and hence Galois extension in any extension in which the polynomial splits. -/
def separable_rootField_finite_galois_type : Prop :=
  ∀ (K : Type u) (T : Type v) [Field K] [Field T] [Algebra K T]
    (f : Polynomial K), f.Separable → (f.map (algebraMap K T)).Splits →
    let E := IntermediateField.adjoin K (f.rootSet T)
    FiniteDimensional K E ∧ Normal K E ∧ Algebra.IsSeparable K E ∧ IsGalois K E

/-- The field generated by roots of any degree-zero polynomial is the given
copy of the base field. This also covers the zero polynomial. -/
def rootField_eq_bot_of_natDegree_eq_zero_type : Prop :=
  ∀ (K : Type u) (T : Type v) [Field K] [Field T] [Algebra K T]
    (f : Polynomial K), f.natDegree = 0 →
    IntermediateField.adjoin K (f.rootSet T) = ⊥

end Specs.AdvancedFieldTheory
