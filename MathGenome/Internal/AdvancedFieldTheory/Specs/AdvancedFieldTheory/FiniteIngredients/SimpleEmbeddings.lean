import Mathlib.FieldTheory.PrimitiveElement
import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.Foundations

/-!
The evaluation parametrization in FT-F01 (lines 134–139), and the finite
separable embedding count recalled at lines 160–164 of the adopted source.
`K⟮a⟯` is the literal intermediate field generated by `a` in `L`;
`AdjoinSimple.gen K a` is `a` viewed as an element of that field.
-/

universe u v w

noncomputable section

open IntermediateField Polynomial

namespace Specs.AdvancedFieldTheory

/-- No separability, normality, or splitting hypothesis is imposed here. -/
def simpleEmbeddingsEquiv_type :=
  ∀ (K : Type u) (L : Type v) (T : Type w)
    [Field K] [Field L] [Field T] [Algebra K L] [Algebra K T]
    (a : L) (_ha : IsAlgebraic K a),
    (K⟮a⟯ →ₐ[K] T) ≃ {b : T // aeval b (minpoly K a) = 0}

/-- The canonical root parametrization evaluates a homomorphism at the generator. -/
def simpleEmbeddingsEquiv_value : simpleEmbeddingsEquiv_type :=
  fun K _L T _ _ _ _ _ _a ha =>
    (adjoin.powerBasis ha.isIntegral).liftEquiv.trans
      ((Equiv.refl T).subtypeEquiv fun b => by
        simp only [Equiv.refl_apply, adjoin.powerBasis_gen, minpoly_gen])

def simpleEmbeddingsEquiv_apply_type : Prop :=
  ∀ (K : Type u) (L : Type v) (T : Type w)
    [Field K] [Field L] [Field T] [Algebra K L] [Algebra K T]
    (a : L) (ha : IsAlgebraic K a) (f : K⟮a⟯ →ₐ[K] T),
    (simpleEmbeddingsEquiv_value K L T a ha f).val = f (AdjoinSimple.gen K a)

def simpleEmbeddingsEquiv_symm_apply_gen_type : Prop :=
  ∀ (K : Type u) (L : Type v) (T : Type w)
    [Field K] [Field L] [Field T] [Algebra K L] [Algebra K T]
    (a : L) (ha : IsAlgebraic K a)
    (b : {b : T // aeval b (minpoly K a) = 0}),
    (simpleEmbeddingsEquiv_value K L T a ha).symm b (AdjoinSimple.gen K a) = b.val

def existsUnique_embedding_of_root_type : Prop :=
  ∀ (K : Type u) (L : Type v) (T : Type w)
    [Field K] [Field L] [Field T] [Algebra K L] [Algebra K T]
    (a : L) (_ha : IsAlgebraic K a) (b : T)
    (_hb : aeval b (minpoly K a) = 0),
    ∃! f : K⟮a⟯ →ₐ[K] T, f (AdjoinSimple.gen K a) = b

/-- The target contains all conjugates, expressed by splitting of each minpoly.
The finite separable domain need not be normal over the base. -/
def card_embeddings_of_splits_type : Prop :=
  ∀ (K : Type u) (M : Type v) (T : Type w)
    [Field K] [Field M] [Field T] [Algebra K M] [Algebra K T]
    [FiniteDimensional K M] [Algebra.IsSeparable K M]
    (_hT : ∀ x : M, ((minpoly K x).map (algebraMap K T)).Splits),
    Nat.card (M →ₐ[K] T) = Module.finrank K M

end Specs.AdvancedFieldTheory
