import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.Correspondence.InfiniteGalois

/-!
Independent statements for the lattice assertions of FT-C05,
`notes/003/advanced-field-theory.tex:741–753, 761–768`.

All fields are literal intermediate fields in the specified Galois extension.
The supremum is their compositum and the infimum is their intersection.
The index type is unrestricted, so these statements also cover the empty
family: its field supremum is the base field and its field infimum is the
whole extension. `Subgroup.closure` means subgroup generation, whereas
`Subgroup.topologicalClosure` uses the canonical Krull topology.
-/

universe u v w

namespace Specs.AdvancedFieldTheory

/-- Fixing a compositum is equivalent to fixing each field in the family. -/
def fixingSubgroup_iSup_type : Prop :=
  ∀ {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
    [IsGalois K L] {I : Type w} (M : I → IntermediateField K L),
    (⨆ i, M i).fixingSubgroup = ⨅ i, (M i).fixingSubgroup

/-- The subgroup fixing an intersection is the Krull closure of the subgroup
 generated by the union of the individual fixing subgroups. -/
def fixingSubgroup_iInf_type : Prop :=
  ∀ {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
    [IsGalois K L] {I : Type w} (M : I → IntermediateField K L),
    (⨅ i, M i).fixingSubgroup =
      (Subgroup.closure (⋃ i, ((M i).fixingSubgroup : Set (L ≃ₐ[K] L)))).topologicalClosure

end Specs.AdvancedFieldTheory
