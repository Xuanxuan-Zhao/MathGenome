import MathGenome.Internal.AdvancedFieldTheory.Specs.AdvancedFieldTheory.Foundations

/-!
Independent statements for FT-F04A: the forward direction of Theorem F04,
`notes/003/advanced-field-theory.tex`, lines 215–240. Intermediate fields are
subfields of the specified ambient extension, with their canonical inclusions.
The supremum is the literal compositum: `IntermediateField.sup_def` identifies
it with the field generated by the union of the two fields.
-/

universe u v

namespace Specs.AdvancedFieldTheory

def finite_galois_bot_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L],
    FiniteDimensional K (⊥ : IntermediateField K L) ∧
      IsGalois K (⊥ : IntermediateField K L)

def finite_galois_intermediateFields_nonempty_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L],
    {E : IntermediateField K L | FiniteDimensional K E ∧ IsGalois K E}.Nonempty

def finite_galois_compositum_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L] (E₁ E₂ : IntermediateField K L),
    FiniteDimensional K E₁ ∧ IsGalois K E₁ →
    FiniteDimensional K E₂ ∧ IsGalois K E₂ →
    FiniteDimensional K (E₁ ⊔ E₂ : IntermediateField K L) ∧
      IsGalois K (E₁ ⊔ E₂ : IntermediateField K L)

def finite_galois_intermediateFields_directed_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L],
    DirectedOn (· ≤ ·)
      {E : IntermediateField K L | FiniteDimensional K E ∧ IsGalois K E}

def exists_finite_galois_containing_element_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L] (x : L),
    ∃ E : IntermediateField K L,
      FiniteDimensional K E ∧ IsGalois K E ∧ x ∈ E

def finite_galois_intermediateFields_union_type : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    [IsGalois K L],
    (⋃ (E : IntermediateField K L) (_ : FiniteDimensional K E ∧ IsGalois K E),
      (E : Set L)) = Set.univ

end Specs.AdvancedFieldTheory
