import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.LieTheorem
import Mathlib.Algebra.Lie.Quotient
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.Dimension.RankNullity
import Lean.Elab.Tactic.Omega

universe u v w
namespace LieAlgebrasAndRepresentations

variable {k : Type u} [Field k] [IsAlgClosed k] [CharZero k]
variable {G : Type v} [LieRing G] [LieAlgebra k G] [Module.Finite k G]
  [LieAlgebra.IsSolvable G]
variable {V : Type w} [AddCommGroup V] [Module k V]
  [LieRingModule G V] [LieModule k G V] [Module.Finite k V]

/-- Lie's theorem includes zero action and the zero acting algebra. -/
theorem common_eigenvector [Nontrivial V] :
    ∃ (χ : Module.Dual k G) (v : V), v ≠ 0 ∧ ∀ x : G, ⁅x, v⁆ = χ x • v := by
  obtain ⟨χ, hχ⟩ := LieModule.exists_nontrivial_weightSpace_of_isSolvable k G V
  obtain ⟨v, hv⟩ := @exists_ne _ hχ 0
  refine ⟨χ, v, ?_, ?_⟩
  · intro h
    exact hv (Subtype.ext h)
  · exact (LieModule.mem_weightSpace χ v.val).mp v.property

/-- The invariant line generated by a common eigenvector. -/
def eigenline (χ : Module.Dual k G) (v : V)
    (he : ∀ x : G, ⁅x, v⁆ = χ x • v) : LieSubmodule k G V where
  toSubmodule := k ∙ v
  lie_mem {x y} hy := by
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hy
    rw [lie_smul, he]
    exact Submodule.smul_mem _ _ (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v))

/-- Lift a triangular basis from the quotient by a common eigenline.
The line is placed first; all quotient basis vectors are lifted afterward. -/
theorem triangular_basis_exists (V : Type w) [AddCommGroup V] [Module k V]
    [LieRingModule G V] [LieModule k G V] [Module.Finite k V] :
    ∃ (n : ℕ) (e : Module.Basis (Fin n) k V),
      ∀ (x : G) (i j : Fin n), j < i → e.repr ⁅x, e j⁆ i = 0 := by
  classical
  obtain hV | hV := subsingleton_or_nontrivial V
  · exact ⟨0, Module.Basis.empty V, fun _ i => Fin.elim0 i⟩
  obtain ⟨χ, v, hv, he⟩ := common_eigenvector (k := k) (G := G) (V := V)
  let E := eigenline χ v he
  obtain ⟨n, eQ, hQ⟩ := triangular_basis_exists (V ⧸ E)
  let eE : Module.Basis (Fin 1) k E :=
    (Module.Basis.singleton (Fin 1) k).map (LinearEquiv.toSpanNonzeroSingleton k V v hv)
  let e := eE.sumQuot eQ
  refine ⟨1 + n, e.reindex finSumFinEquiv, ?_⟩
  intro x i j hij
  obtain ⟨i, rfl⟩ := finSumFinEquiv.surjective i
  obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective j
  simp only [Module.Basis.reindex_apply, Module.Basis.repr_reindex,
    Finsupp.equivMapDomain_apply, Equiv.symm_apply_apply]
  cases i with
  | inl i =>
    cases j with
    | inl j =>
      exfalso
      change j.val < i.val at hij
      omega
    | inr j =>
      exfalso
      change 1 + j.val < i.val at hij
      omega
  | inr i =>
    cases j with
    | inl j =>
      change (eE.sumQuot eQ).repr ⁅x, (eE.sumQuot eQ) (Sum.inl j)⁆ (Sum.inr i) = 0
      rw [Module.Basis.sumQuot_inl]
      exact Module.Basis.sumQuot_repr_inr_of_mem eE eQ _ (E.lie_mem (eE j).property) i
    | inr j =>
      change (eE.sumQuot eQ).repr ⁅x, (eE.sumQuot eQ) (Sum.inr j)⁆ (Sum.inr i) = 0
      rw [Module.Basis.sumQuot_repr_inr]
      change eQ.repr ((LieSubmodule.Quotient.mk' E) ⁅x, (eE.sumQuot eQ) (Sum.inr j)⁆) i = 0
      rw [LieModuleHom.map_lie]
      change eQ.repr ⁅x, Submodule.Quotient.mk ((eE.sumQuot eQ) (Sum.inr j))⁆ i = 0
      rw [Module.Basis.sumQuot_inr]
      apply hQ x i j
      simpa [finSumFinEquiv] using hij
termination_by Module.finrank k V
decreasing_by
  have hdim := E.toSubmodule.finrank_quotient_add_finrank
  have hline : Module.finrank k E = 1 := finrank_span_singleton hv
  change Module.finrank k (V ⧸ E.toSubmodule) < Module.finrank k V
  change Module.finrank k E.toSubmodule = 1 at hline
  omega

/-- A single basis triangularizes every element of the solvable algebra. -/
theorem common_upper_triangular_basis :
    ∃ (n : ℕ) (e : Module.Basis (Fin n) k V),
      ∀ (x : G) (i j : Fin n), j < i → e.repr ⁅x, e j⁆ i = 0 :=
  triangular_basis_exists V

/-- Irreducibility forces the invariant eigenline to be the whole module. -/
theorem irreducible_finrank_one [Nontrivial V] [LieModule.IsIrreducible k G V] :
    Module.finrank k V = 1 := by
  obtain ⟨χ, v, hv, he⟩ := common_eigenvector (k := k) (G := G) (V := V)
  let E := eigenline χ v he
  have hE : E ≠ ⊥ := by
    intro h
    have hm : v ∈ E := Submodule.mem_span_singleton_self v
    rw [h] at hm
    exact hv hm
  have htop : E = ⊤ := (IsSimpleOrder.eq_bot_or_eq_top E).resolve_left hE
  have hspan : k ∙ v = (⊤ : Submodule k V) := congrArg LieSubmodule.toSubmodule htop
  rw [← finrank_top k V, ← hspan]
  exact finrank_span_singleton hv

end LieAlgebrasAndRepresentations
