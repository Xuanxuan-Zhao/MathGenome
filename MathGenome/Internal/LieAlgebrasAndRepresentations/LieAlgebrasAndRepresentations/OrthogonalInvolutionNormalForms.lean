import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.OrthogonalInvolutionNormalForms
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.Analysis.Matrix.Spectrum
import Mathlib.Tactic.FinCases

/-! Real orthogonal matrix normal forms for LA-J07. -/

open Matrix LieAlgebra Module
open scoped InnerProductSpace

namespace LieAlgebrasAndRepresentations.OrthogonalInvolutionNormalForms

open Specs.LieAlgebrasAndRepresentations.OrthogonalInvolutionNormalForms (squareOneType squareNegOneType)

theorem squareOne : squareOneType := by
  classical
  intro ι _ _ A horth hsquare
  have hsymm : Aᵀ = A := calc
    Aᵀ = Aᵀ * (A * A) := by rw [hsquare, mul_one]
    _ = A := by rw [← mul_assoc, horth, one_mul]
  have hHerm : A.IsHermitian := by
    change Aᴴ = A
    rw [conjTranspose_eq_transpose_of_trivial, hsymm]
  let U := hHerm.eigenvectorUnitary
  let Q : Matrix ι ι ℝ := U
  let eigenvalue := hHerm.eigenvalues
  let F := Unitary.conjStarAlgAut ℝ (Matrix ι ι ℝ) (star U)
  have hdiag : F A = diagonal eigenvalue := by
    change Unitary.conjStarAlgAut ℝ (Matrix ι ι ℝ) (star U) A =
      diagonal (id ∘ hHerm.eigenvalues)
    rw [← RCLike.ofReal_real_eq_id]
    exact hHerm.conjStarAlgAut_star_eigenvectorUnitary
  have hentries : ∀ i, eigenvalue i = 1 ∨ eigenvalue i = -1 := by
    have hh : diagonal eigenvalue * diagonal eigenvalue = 1 := by
      rw [← hdiag, ← map_mul, hsquare, map_one]
    rw [diagonal_mul_diagonal, ← diagonal_one] at hh
    intro i
    have hi := congrFun (diagonal_injective hh) i
    exact (mul_self_eq_one_iff).mp hi
  let pos := {i // eigenvalue i = 1}
  let neg := {i // eigenvalue i ≠ 1}
  let p := Fintype.card pos
  let q := Fintype.card neg
  let epos := (Fintype.equivFin pos).symm
  let eneg := (Fintype.equivFin neg).symm
  let e := (Equiv.sumCongr epos eneg).trans (Equiv.sumCompl fun i => eigenvalue i = 1)
  refine ⟨p, q, e, Q, ?_, ?_⟩
  · simpa only [Q, star_eq_conjTranspose, conjTranspose_eq_transpose_of_trivial] using
      Unitary.coe_star_mul_self U
  · have hQdiag : Qᵀ * A * Q = diagonal eigenvalue := by
      simpa only [F, Q, Unitary.conjStarAlgAut_star_apply, star_eq_conjTranspose,
        conjTranspose_eq_transpose_of_trivial] using hdiag
    rw [hQdiag]
    change diagonal eigenvalue = (diagonal _).submatrix e.symm e.symm
    rw [submatrix_diagonal_equiv]
    congr 1
    funext i
    obtain ⟨j, rfl⟩ := e.surjective i
    simp only [Function.comp_apply, Equiv.symm_apply_apply]
    cases j with
    | inl j => exact (epos j).property
    | inr j => exact (hentries (eneg j : ι)).resolve_left (eneg j).property

private theorem pairedOrthonormalFamily (d : ℕ) {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (hd : finrank ℝ E = d)
    (T : E →ₗ[ℝ] E) (hsquare : ∀ x, T (T x) = -x)
    (hskew : ∀ x y, ⟪x, T y⟫_ℝ = -⟪T x, y⟫_ℝ) :
    ∃ (n : ℕ) (v w : Fin n → E), n + n = d ∧
      Orthonormal ℝ (Sum.elim v w) ∧
      (∀ i, T (v i) = -w i) ∧ (∀ i, T (w i) = v i) := by
  classical
  induction d using Nat.strong_induction_on generalizing E with
  | h d ih =>
    by_cases hzero : d = 0
    · exact ⟨0, Fin.elim0, Fin.elim0, hzero.symm, by
        rw [orthonormal_iff_ite]
        rintro (i | i) <;> exact i.elim0, fun i => i.elim0, fun i => i.elim0⟩
    -- Split off the plane generated by a unit vector and its image under T.
    have : Nontrivial E := nontrivial_of_finrank_pos (by omega : 0 < finrank ℝ E)
    obtain ⟨a, ha⟩ := exists_norm_eq E (zero_le_one : (0 : ℝ) ≤ 1)
    let b := -T a
    have hTab : T a = -b := by simp [b]
    have hTba : T b = a := by simp [b, hsquare]
    have hab : ⟪a, b⟫_ℝ = 0 := by
      have h := hskew a a
      rw [real_inner_comm a (T a)] at h
      simp only [b, inner_neg_right]
      linarith
    have hba : ⟪b, a⟫_ℝ = 0 := by rwa [real_inner_comm a b]
    have haa : ⟪a, a⟫_ℝ = 1 := by rw [real_inner_self_eq_norm_sq, ha, one_pow]
    have hbb : ⟪b, b⟫_ℝ = 1 := by
      have h := hskew a b
      rw [hTab, hTba, inner_neg_left, neg_neg, haa] at h
      exact h.symm
    have hb : ‖b‖ = 1 := by
      have hs := real_inner_self_eq_norm_sq b
      nlinarith [norm_nonneg b]
    let pair : Fin 2 → E := ![a, b]
    have hpair : Orthonormal ℝ pair := by
      simp only [pair, orthonormal_vecCons_iff]
      exact ⟨ha, fun i => by fin_cases i; exact hab, hb, fun i => i.elim0,
        ⟨fun i => i.elim0, fun i => i.elim0⟩⟩
    let P := Submodule.span ℝ (Set.range pair)
    let W := Pᗮ
    have hPa : a ∈ P := Submodule.subset_span ⟨0, rfl⟩
    have hPb : b ∈ P := Submodule.subset_span ⟨1, rfl⟩
    have hP : P ≤ P.comap T := by
      apply Submodule.span_le.mpr
      rintro x ⟨i, rfl⟩
      change T (pair i) ∈ P
      fin_cases i
      · change T a ∈ P
        rw [hTab]
        exact P.neg_mem hPb
      · change T b ∈ P
        rwa [hTba]
    have hW : ∀ x ∈ W, T x ∈ W := by
      intro x hx
      apply (P.mem_orthogonal _).mpr
      intro y hy
      rw [hskew, (P.mem_orthogonal x).mp hx _ (hP hy), neg_zero]
    -- The skew identity makes the orthogonal complement invariant.
    let S : W →ₗ[ℝ] W := T.restrict hW
    have hSsquare (x : W) : S (S x) = -x := Subtype.ext (hsquare (x : E))
    have hSskew (x y : W) : ⟪x, S y⟫_ℝ = -⟪S x, y⟫_ℝ := hskew (x : E) (y : E)
    have hdimP : finrank ℝ P = 2 := by
      simpa [P] using finrank_span_eq_card hpair.linearIndependent
    have hdimW : 2 + finrank ℝ W = d := by
      simpa only [hdimP, hd] using P.finrank_add_finrank_orthogonal
    obtain ⟨n, v, w, hn, hon, hv, hw⟩ :=
      ih (finrank ℝ W) (by omega) rfl S hSsquare hSskew
    let v' : Fin n → E := fun i => v i
    let w' : Fin n → E := fun i => w i
    have hon' : Orthonormal ℝ (Sum.elim v' w') := by
      convert hon.comp_linearIsometry W.subtypeₗᵢ using 1
      funext i
      cases i <;> rfl
    have hleft (x : W) : ⟪a, (x : E)⟫_ℝ = 0 :=
      (P.mem_orthogonal _).mp x.property _ hPa
    have hright (x : W) : ⟪b, (x : E)⟫_ℝ = 0 :=
      (P.mem_orthogonal _).mp x.property _ hPb
    have hleft' (x : W) : ⟪(x : E), a⟫_ℝ = 0 := by
      rw [real_inner_comm, hleft x]
    have hright' (x : W) : ⟪(x : E), b⟫_ℝ = 0 := by
      rw [real_inner_comm, hright x]
    refine ⟨n + 1, Fin.cons a v', Fin.cons b w', by omega, ?_, ?_, ?_⟩
    · rw [orthonormal_iff_ite] at hon' ⊢
      rintro (i | i) (j | j) <;>
        refine Fin.cases ?_ (fun i => ?_) i <;>
        refine Fin.cases ?_ (fun j => ?_) j <;>
        simp [v', w', ha, hb, hab, hba, hleft, hright, hleft', hright',
          Ne.symm (Fin.succ_ne_zero _)]
      · simpa [v', w'] using hon' (Sum.inl i) (Sum.inl j)
      · simpa [v', w'] using hon' (Sum.inl i) (Sum.inr j)
      · simpa [v', w'] using hon' (Sum.inr i) (Sum.inl j)
      · simpa [v', w'] using hon' (Sum.inr i) (Sum.inr j)
    · intro i
      refine Fin.cases hTab (fun i => ?_) i
      exact congrArg Subtype.val (hv i)
    · intro i
      refine Fin.cases hTba (fun i => ?_) i
      exact congrArg Subtype.val (hw i)

private theorem detStandardComplexStructure (n : ℕ) : (-Matrix.J (Fin n) ℝ).det = 1 := by
  let U : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℝ := fromBlocks 1 1 0 1
  let L : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℝ := fromBlocks 1 0 (-1) 1
  have hfactor : -Matrix.J (Fin n) ℝ = U * L * U := by
    simp [Matrix.J, fromBlocks_neg, U, L, fromBlocks_multiply]
  rw [hfactor, det_mul, det_mul]
  simp [U, L]

theorem squareNegOne : squareNegOneType := by
  classical
  intro ι _ _ A horth hsquare
  have htranspose : Aᵀ = -A := calc
    Aᵀ = -(Aᵀ * (A * A)) := by rw [hsquare, mul_neg, mul_one, neg_neg]
    _ = -A := by rw [← mul_assoc, horth, one_mul]
  let b₀ := EuclideanSpace.basisFun ι ℝ
  let T := A.toEuclideanLin
  have hT : T = Matrix.toLin b₀.toBasis b₀.toBasis A := by
    rw [show T = A.toEuclideanLin from rfl, Matrix.toEuclideanLin_eq_toLin_orthonormal]
  have hT2 : T.comp T = -LinearMap.id := by
    rw [hT, ← Matrix.toLin_mul, hsquare, map_neg, Matrix.toLin_one]
  have hTadj : T.adjoint = -T := by
    rw [show T = A.toEuclideanLin from rfl, ← Matrix.toEuclideanLin_conjTranspose_eq_adjoint,
      conjTranspose_eq_transpose_of_trivial, htranspose, map_neg]
  obtain ⟨n, v, w, hn, hon, hv, hw⟩ := pairedOrthonormalFamily (Fintype.card ι)
    finrank_euclideanSpace T (fun x => congrArg (fun f : _ →ₗ[ℝ] _ => f x) hT2)
    (fun x y => by
      simpa only [hTadj, LinearMap.neg_apply, inner_neg_left] using T.adjoint_inner_left y x |>.symm)
  have hcard : Fintype.card (Fin n ⊕ Fin n) = Fintype.card ι := by
    simpa only [Fintype.card_sum, Fintype.card_fin] using hn
  let e : Fin n ⊕ Fin n ≃ ι := Fintype.equivOfCardEq hcard
  have hspan : ⊤ ≤ Submodule.span ℝ (Set.range (Sum.elim v w)) := by
    apply le_of_eq
    symm
    apply Submodule.eq_top_of_finrank_eq
    rw [finrank_span_eq_card hon.linearIndependent, finrank_euclideanSpace, hcard]
  let b := OrthonormalBasis.mk hon hspan
  have hb : (b : Fin n ⊕ Fin n → EuclideanSpace ℝ ι) = Sum.elim v w :=
    OrthonormalBasis.coe_mk hon hspan
  have hv' (i : Fin n) : T (b (.inl i)) = -b (.inr i) := by
    simpa only [hb, Sum.elim_inl, Sum.elim_inr] using hv i
  have hw' (i : Fin n) : T (b (.inr i)) = b (.inl i) := by
    simpa only [hb, Sum.elim_inl, Sum.elim_inr] using hw i
  have hmatrix : LinearMap.toMatrixOrthonormal b T = -Matrix.J (Fin n) ℝ := by
    ext i j
    rw [LinearMap.toMatrixOrthonormal_apply_apply]
    rcases i with i | i <;> rcases j with j | j <;>
      simp [hv', hw', b.inner_eq_ite, Matrix.J, Matrix.one_apply]
  let b' := b.reindex e
  let Q : Matrix ι ι ℝ := b₀.toBasis.toMatrix b'.toBasis
  have hQ : Qᵀ * Q = 1 := by
    simpa only [Q, OrthonormalBasis.coe_toBasis, conjTranspose_eq_transpose_of_trivial] using
      b₀.toMatrix_orthonormalBasis_conjTranspose_mul_self b'
  have hB : T.toMatrix b'.toBasis b'.toBasis = Matrix.reindex e e (-Matrix.J (Fin n) ℝ) := by
    change LinearMap.toMatrixOrthonormal (b.reindex e) T = _
    rw [LinearMap.toMatrixOrthonormal_reindex, hmatrix]
  have hchange : A * Q = Q * T.toMatrix b'.toBasis b'.toBasis := by
    change A * b₀.toBasis.toMatrix b'.toBasis =
      b₀.toBasis.toMatrix b'.toBasis * T.toMatrix b'.toBasis b'.toBasis
    have hA : T.toMatrix b₀.toBasis b₀.toBasis = A := by
      rw [hT]
      exact (Matrix.toLin b₀.toBasis b₀.toBasis).left_inv A
    rw [← hA, linearMap_toMatrix_mul_basis_toMatrix, basis_toMatrix_mul_linearMap_toMatrix]
  have hnormal : Qᵀ * A * Q = Matrix.reindex e e (-Matrix.J (Fin n) ℝ) := by
    rw [mul_assoc, hchange, ← mul_assoc, hQ, one_mul, hB]
  have hdetQ : Q.det * Q.det = 1 := by
    simpa only [det_mul, det_transpose, det_one] using congrArg Matrix.det hQ
  refine ⟨?_, n, e, Q, hQ, hnormal⟩
  have hdet := congrArg Matrix.det hnormal
  rw [det_mul, det_mul, det_transpose, det_reindex_self, detStandardComplexStructure] at hdet
  rwa [mul_comm Q.det A.det, mul_assoc, hdetQ, mul_one] at hdet

end LieAlgebrasAndRepresentations.OrthogonalInvolutionNormalForms
