attribute [local instance 100] LieRing.ofAssociativeRing in
/-- The even-root calculation identifies the actual fixed algebra and the
intrinsic Killing signature of the associated real form. -/
theorem fixed_row_of_inner_datum : fixedRowType.{u} := by
  intro D r hr L _ _ _ hss H hH φ hφ s hA ω hc hwH e f hN hw a hcomm hinv haH ha
  classical
  obtain ⟨hdim, hsig, hcen⟩ := row_dimensions D r hr
  have hrow : rowRootCheck D r (roots D) := ⟨hdim, hsig, hcen, rowBase D r, row_base D r hr⟩
  have hact := innerRootAction D hss ω H hH hwH φ hφ e f hN hw a haH
    s (colorAt D r.mask) ha
  obtain ⟨⟨hType⟩, hCenter⟩ := fixed_type_of_rowRootCheck D (roots D) r hr hrow hss
    H hH φ hφ s hA (root_mem D) ω hc a hcomm haH hact
  obtain ⟨hinj, hsys, _, hRank⟩ := coordinateRoot_system D hss H hH φ hφ s hA
  let coord : roots D → rootSet_value H := fun c =>
    ⟨coordinateRoot s c, (hsys _).mpr ⟨c, (root_mem D c).mp c.property, rfl⟩⟩
  have hb : Function.Bijective coord := by
    constructor
    · intro c d h
      exact Subtype.ext (hinj (congrArg Subtype.val h))
    · intro α
      obtain ⟨c, hgen, h⟩ := (hsys α.val).mp α.property
      exact ⟨⟨c, (root_mem D c).mpr hgen⟩, Subtype.ext h⟩
  let eqv := Equiv.ofBijective coord hb
  let zLin := (Module.finBasisOfFinrankEq ℂ _ hCenter).equivFun
  let z : LieAlgebra.center ℂ (complexFixed a) ≃ₗ⁅ℂ⁆ (Fin r.center → ℂ) :=
    { zLin with
      map_lie' := by
        intro x y
        change zLin ⁅x, y⁆ = ⁅zLin x, zLin y⁆
        rw [trivial_lie_zero, map_zero]
        funext i
        change (0 : ℂ) = _ * _ - _ * _
        simp [mul_comm] }
  let m := (LieHom.id : Serre.Algebra r.matrix →ₗ⁅ℂ⁆ Serre.Algebra r.matrix).prodMap z.symm.toLieHom
  let eCenter := LieEquiv.ofBijective m (Function.bijective_id.prodMap z.symm.bijective)
  exact ⟨⟨eCenter.trans hType⟩,
    fixed_row_dimension_and_signature D (roots D) r hrow hss H hH hRank
      φ s eqv (fun _ => rfl) ω hc a hcomm hinv haH hact⟩

