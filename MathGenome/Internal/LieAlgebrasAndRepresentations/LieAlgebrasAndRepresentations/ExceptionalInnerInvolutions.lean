private def colorNodeAt (D : Diagram) (mask n : ℕ) : ColorNode D :=
  (colorNodes D mask).getD n default

private def maskList (D : Diagram) (mask : ℕ) : List ℕ := (colorNodes D mask).toList.map (·.mask)

private def orbitMasks (D : Diagram) (mask : ℕ) : Finset ℕ := (maskList D mask).toFinset

private theorem mem_orbitMasks (D : Diagram) (mask m : ℕ) :
    m ∈ orbitMasks D mask ↔ ∃ n : ℕ, n < (colorNodes D mask).size ∧
      (colorNodeAt D mask n).mask = m := by
  simp only [orbitMasks, List.mem_toFinset, maskList, List.mem_iff_getElem,
    List.length_map, List.getElem_map, Array.length_toList, Array.getElem_toList]
  constructor
  · rintro ⟨n, hn, rfl⟩
    exact ⟨n, hn, by simp [colorNodeAt, Array.getD, hn]⟩
  · rintro ⟨n, hn, rfl⟩
    exact ⟨n, hn, by simp [colorNodeAt, Array.getD, hn]⟩

private def orbit (D : Diagram) (mask : ℕ) : Finset (Color D) :=
  (orbitMasks D mask).image (colorAt D)

private def checkColorNode (D : Diagram) (mask : ℕ) (n : Fin (colorNodes D mask).size) : Prop :=
  let x := colorNodeAt D mask n
  match x.predecessor with
  | none => x.mask = mask
  | some (m, i) => m < (n : ℕ) ∧
      colorStep D i (colorAt D (colorNodeAt D mask m).mask) = colorAt D x.mask

private instance (D : Diagram) (mask : ℕ) (n : Fin (colorNodes D mask).size) :
    Decidable (checkColorNode D mask n) := by
  unfold checkColorNode
  dsimp only
  split <;> infer_instance

private theorem color_nodes_checked (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    ∀ n, checkColorNode D r.mask n := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals rcases hr with rfl | rfl | rfl | rfl <;> decide +kernel

private theorem colorAt_reachable (D : Diagram) (r : Row) (hr : r ∈ rows D) (n : ℕ)
    (hn : n < (colorNodes D r.mask).size) :
    ColorOrbit D (colorAt D r.mask) (colorAt D (colorNodeAt D r.mask n).mask) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    have h := color_nodes_checked D r hr ⟨n, hn⟩
    unfold checkColorNode at h
    dsimp only at h
    cases he : (colorNodeAt D r.mask n).predecessor with
    | none =>
      simp only [he] at h
      rw [h]
      exact .initial
    | some p =>
      rcases p with ⟨m, i⟩
      simp only [he] at h
      obtain ⟨hm, hh⟩ := h
      rw [← hh]
      exact .reflection i (ih m hm (hm.trans hn))

private theorem orbit_sound (D : Diagram) (r : Row) (hr : r ∈ rows D) {b : Color D}
    (hb : b ∈ orbit D r.mask) : ColorOrbit D (colorAt D r.mask) b := by
  obtain ⟨m, h, rfl⟩ := Finset.mem_image.mp hb
  obtain ⟨n, hn, rfl⟩ := (mem_orbitMasks D r.mask m).mp h
  exact colorAt_reachable D r hr n hn

private theorem diagonal (D : Diagram) (i : Vertex D) : cartan D i i = 2 := by
  cases D <;> simp [cartan, eDiagram]

private theorem reflect_apply (D : Diagram) (i : Vertex D) (c : Root D) (j : Vertex D) :
    reflect D i c j = c j - (if i = j then ∑ k, cartan D i k * c k else 0) := by
  by_cases h : i = j <;> simp [reflect, h]

private theorem reflect_involutive (D : Diagram) (i : Vertex D) :
    Function.Involutive (reflect D i) := by
  intro c
  have h : ∑ j, cartan D i j * reflect D i c j = -(∑ j, cartan D i j * c j) := by
    simp only [reflect_apply, mul_sub, Finset.sum_sub_distrib, mul_ite, mul_zero]
    rw [Finset.sum_eq_single i (fun j _ hj => ite_eq_right (Ne.symm hj)) (by simp)]
    rw [ite_eq_left rfl, diagonal]
    ring
  funext j
  rw [reflect_apply, h, reflect_apply]
  split_ifs <;> ring

private theorem parity_reflect (D : Diagram) (i : Vertex D) (b : Color D) (c : Root D) :
    parity D (colorStep D i b) c = parity D b (reflect D i c) := by
  simp only [parity, colorStep, reflectedColors, mul_sub, reflect_apply, Int.cast_sub,
    Int.cast_ite, Int.cast_zero, sub_mul, Finset.sum_sub_distrib]
  congr 1
  calc
    _ = ∑ j, (((cartan D i j : ℤ) : ZMod 2) * (c j : ZMod 2)) * b i := by
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = _ := by
      rw [← Finset.sum_mul]
      simp only [Int.cast_sum, Int.cast_mul, ite_mul, zero_mul]
      rw [Finset.sum_eq_single i (fun j _ hj => ite_eq_right (Ne.symm hj)) (by simp), ite_eq_left rfl]

private theorem inverse_diagram {D : Diagram} {p : Equiv.Perm (Vertex D)} (hp : IsDiagramPerm p) :
    IsDiagramPerm p.symm := by
  intro i j
  simpa using (hp (p.symm i) (p.symm j)).symm

private theorem perm_reflect {D : Diagram} (p : Equiv.Perm (Vertex D)) (hp : IsDiagramPerm p)
    (i : Vertex D) (c : Root D) :
    reflect D (p.symm i) (c ∘ p) = reflect D i c ∘ p := by
  have h : ∑ j, cartan D (p.symm i) j * (c ∘ p) j = ∑ j, cartan D i j * c j := by
    calc
      _ = ∑ j, cartan D i (p j) * c (p j) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [← hp (p.symm i) j, p.apply_symm_apply]
        rfl
      _ = _ := Equiv.sum_comp p (fun j => cartan D i j * c j)
  funext j
  have he : p.symm i = j ↔ i = p j := Equiv.symm_apply_eq p
  change (if p.symm i = j then (c ∘ p) j - ∑ k, cartan D (p.symm i) k * (c ∘ p) k
    else (c ∘ p) j) = (if i = p j then c (p j) - ∑ k, cartan D i k * c k else c (p j))
  rw [h, if_congr he rfl rfl]
  rfl

private theorem perm_root_mem {D : Diagram} (p : Equiv.Perm (Vertex D)) (hp : IsDiagramPerm p)
    {c : Root D} (hc : c ∈ roots D) : c ∘ p ∈ roots D := by
  rw [root_mem] at hc ⊢
  induction hc with
  | initial h =>
    obtain ⟨i, rfl⟩ := h
    apply Generated.initial
    refine ⟨p.symm i, ?_⟩
    funext j
    have he : p.symm i = j ↔ i = p j := Equiv.symm_apply_eq p
    simp [unit, he]
  | next i _ ih =>
    rw [← perm_reflect p hp]
    exact Generated.next _ ih

private theorem perm_parity {D : Diagram} (p : Equiv.Perm (Vertex D))
    (b : Color D) (c : Root D) :
    parity D (b ∘ p) (c ∘ p) = parity D b c :=
  Equiv.sum_comp p (fun j => (c j : ZMod 2) * b j)

private def evenCount (D : Diagram) (b : Color D) : ℕ :=
  ((roots D).filter (fun c => parity D b c = 0)).card

private theorem evenCount_reflect (D : Diagram) (i : Vertex D) (b : Color D) :
    evenCount D (colorStep D i b) = evenCount D b := by
  apply (Finset.card_nbij' (reflect D i) (reflect D i) ?_ ?_ ?_ ?_ :
    ((roots D).filter (fun c => parity D (colorStep D i b) c = 0)).card =
      ((roots D).filter (fun c => parity D b c = 0)).card)
  · intro x hx
    obtain ⟨hx, h⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_filter.mpr
      ⟨(root_mem D _).2 (Generated.next i ((root_mem D _).1 hx)), (parity_reflect D i b x).symm.trans h⟩
  · intro x hx
    obtain ⟨hx, h⟩ := Finset.mem_filter.mp hx
    refine Finset.mem_filter.mpr ⟨(root_mem D _).2 (Generated.next i ((root_mem D _).1 hx)), ?_⟩
    rw [parity_reflect, reflect_involutive D i]
    exact h
  · exact fun _ _ => reflect_involutive D i _
  · exact fun _ _ => reflect_involutive D i _

private theorem evenCount_perm {D : Diagram} (p : Equiv.Perm (Vertex D)) (hp : IsDiagramPerm p)
    (b : Color D) : evenCount D (b ∘ p) = evenCount D b := by
  apply (Finset.card_nbij' (fun c => c ∘ p.symm) (fun c => c ∘ p) ?_ ?_ ?_ ?_ :
    ((roots D).filter (fun c => parity D (b ∘ p) c = 0)).card =
      ((roots D).filter (fun c => parity D b c = 0)).card)
  · intro x hx
    obtain ⟨hx, h⟩ := Finset.mem_filter.mp hx
    refine Finset.mem_filter.mpr ⟨perm_root_mem p.symm (inverse_diagram hp) hx, ?_⟩
    have hb : (b ∘ p) ∘ p.symm = b := by funext j; simp
    rwa [← hb, perm_parity p.symm]
  · intro x hx
    obtain ⟨hx, h⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_filter.mpr ⟨perm_root_mem p hp hx, (perm_parity p b x).trans h⟩
  · intro _ _
    funext _
    simp
  · intro _ _
    funext _
    simp

private theorem evenCount_orbit {D : Diagram} {b c : Color D}
    (h : ColorOrbit D b c) : evenCount D c = evenCount D b := by
  induction h with
  | initial => rfl
  | reflection i _ ih => exact (evenCount_reflect D i _).trans ih
  | diagram p hp _ ih => exact (evenCount_perm p hp _).trans ih

/-- Binary encoding is exhaustive, with one mask per coloring. -/
private theorem colorAt_bijective (D : Diagram) :
    Function.Bijective (fun m : Fin (2 ^ D.rank) => colorAt D m) := by
  apply (Fintype.bijective_iff_injective_and_card _).2
  refine ⟨?_, by rw [Fintype.card_fin, Fintype.card_pi]; simp [ZMod.card]⟩
  intro m n h
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < D.rank
  · have he := congrFun h (⟨i, hi⟩ : Vertex D)
    change (if m.val.testBit i then (1 : ZMod 2) else 0) =
      (if n.val.testBit i then 1 else 0) at he
    cases hm : m.val.testBit i <;> cases hn : n.val.testBit i <;> simp_all
  · have hpow : 2 ^ D.rank ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (Nat.le_of_not_gt hi)
    rw [Nat.testBit_lt_two_pow (m.isLt.trans_le hpow),
      Nat.testBit_lt_two_pow (n.isLt.trans_le hpow)]

private theorem masks_cover (D : Diagram) (m : Fin (2 ^ D.rank)) :
    (rows D).any (fun r => (colorNodes D r.mask).any (fun n => n.mask == m.val)) = true := by
  revert m
  cases D <;> decide +kernel

private theorem colors_cover (D : Diagram) (b : Color D) :
    ∃ r ∈ rows D, b ∈ orbit D r.mask := by
  obtain ⟨m, rfl⟩ := (colorAt_bijective D).surjective b
  obtain ⟨r, hr, h⟩ := List.any_eq_true.mp (masks_cover D m)
  obtain ⟨i, hi, hm⟩ := Array.any_eq_true.mp (show _ = true from h)
  have he : (colorNodeAt D r.mask i).mask = m.val := by
    simpa [colorNodeAt, Array.getD, hi] using hm
  exact ⟨r, hr, Finset.mem_image.mpr ⟨m, (mem_orbitMasks D r.mask m).mpr ⟨i, hi, he⟩, rfl⟩⟩

private theorem maskList_checked (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    (maskList D r.mask).Nodup ∧ (maskList D r.mask).length = r.size ∧
    ∀ m ∈ maskList D r.mask, m < 2 ^ D.rank := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals rcases hr with rfl | rfl | rfl | rfl <;> decide +kernel

private theorem orbit_size (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    (orbit D r.mask).card = r.size := by
  obtain ⟨hn, hl, hlt⟩ := maskList_checked D r hr
  have bound {m : ℕ} (hm : m ∈ orbitMasks D r.mask) : m < 2 ^ D.rank :=
    hlt m (List.mem_toFinset.mp hm)
  have hi : Set.InjOn (colorAt D) (orbitMasks D r.mask : Set ℕ) := by
    intro m hm n hnm h
    exact congrArg Fin.val ((colorAt_bijective D).injective
      (a₁ := ⟨m, bound hm⟩) (a₂ := ⟨n, bound hnm⟩) h)
  rw [orbit, Finset.card_image_of_injOn hi, orbitMasks,
    List.toFinset_card_of_nodup hn, hl]

/-- Indices of the indecomposable even roots in the order of each row matrix. -/
private def baseIndices (D : Diagram) (mask : ℕ) : Array ℕ :=
  match D, mask with
  | .G2, 1 => #[1, 7]
  | .F4, 1 => #[16, 3, 2, 1]
  | .F4, 4 => #[1, 0, 25, 3]
  | .E6, 1 => #[4, 3, 2, 1, 5]
  | .E6, 2 => #[5, 2, 3, 4, 56, 0]
  | .E7, 1 => #[5, 4, 3, 2, 1, 6, 124]
  | .E7, 8 => #[4, 5, 76, 0, 1, 2, 6]
  | .E7, 10 => #[2, 6, 23, 4, 5, 0]
  | .E8, 1 => #[195, 6, 5, 4, 3, 2, 1, 7]
  | .E8, 2 => #[6, 5, 4, 3, 2, 7, 85, 0]
  | _, _ => Array.range D.rank

private def rowBase (D : Diagram) (r : Row) (i : Fin r.fixedRank) : Root D :=
  (rootAt D ((baseIndices D r.mask).getD i 0)).coords

private theorem row_dimensions (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    r.dimension = D.rank + evenCount D (colorAt D r.mask) ∧
    r.signature = (D.rank + (roots D).card : ℤ) - 2 * r.dimension ∧
    D.rank = r.fixedRank + r.center := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals rcases hr with rfl | rfl | rfl | rfl <;> decide +kernel

/-- An integral height that takes value one on the displayed even simple roots. -/
private def heightWeights (D : Diagram) (mask : ℕ) : Vertex D → ℤ :=
  match D, mask with
  | .G2, 1 => ![0,1]
  | .F4, 1 => ![-1,1,1,1]
  | .F4, 4 => ![1,1,-1,1]
  | .E6, 1 => ![0,1,1,1,1,1]
  | .E6, 2 => ![1,-2,1,1,1,1]
  | .E7, 1 => ![-7,1,1,1,1,1,1]
  | .E7, 8 => ![1,1,1,-2,1,1,1]
  | .E7, 10 => ![1,0,1,0,1,1,1]
  | .E8, 1 => ![-7,1,1,1,1,1,1,1]
  | .E8, 2 => ![1,-2,1,1,1,1,1,1]
  | _, _ => fun _ => 1

private def height (D : Diagram) (mask : ℕ) (c : Root D) : ℤ :=
  ∑ i, heightWeights D mask i * c i

private theorem height_add (D : Diagram) (m : ℕ) (x y : Root D) :
    height D m (x + y) = height D m x + height D m y := by
  simp only [height, Pi.add_apply, mul_add, Finset.sum_add_distrib]

