section Gram

open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations
open SerreRelations (simple)
open VermaModules (Direction)
open RootForm (coroot_value rootForm_value)
open scoped BigOperators


private theorem lengthFactor_ne_zero (D : Diagram) :
    ∀ i : Vertex D, lengthFactor D i ≠ 0 := by
  cases D <;> decide

private theorem diagram_rank_pos (D : Diagram) : 0 < D.rank := by
  cases D <;> decide

private def earlierVertex (D : Diagram) : Vertex D → Vertex D :=
  match D with
  | .G2 => ![0, 0]
  | .F4 => ![0, 0, 1, 2]
  | .E6 => ![0, 0, 1, 2, 3, 2]
  | .E7 => ![0, 0, 1, 2, 3, 4, 2]
  | .E8 => ![0, 0, 1, 2, 3, 4, 5, 2]

private theorem earlier_neighbor (D : Diagram) :
    ∀ i : Vertex D, 0 < i.val →
      (earlierVertex D i).val < i.val ∧ cartan D i (earlierVertex D i) ≠ 0 := by
  cases D <;> decide

private theorem symmetricCartanGram (D : Diagram) : ∀ i j : Vertex D,
    lengthFactor D i * cartan D i j = lengthFactor D j * cartan D j i := by
  cases D <;> decide

/-- The Killing root form, in the source's simple coordinates, is a nonzero
common multiple of the integer Gram matrix used in the finite checks. -/
theorem coordinateRoot_gram (D : Diagram) {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ)) :
    ∃ q : ℂ, q ≠ 0 ∧ ∀ c e : Root D,
      rootForm_value H (coordinateRoot s c) (coordinateRoot s e) = q * (gram D c e : ℂ) := by
  let B := rootForm_value H
  let a (i : Vertex D) := (s i).val
  have hB_symm (x y) : B x y = B y x := by
    change killingForm ℂ L (tAlpha H x : L) (tAlpha H y : L) =
      killingForm ℂ L (tAlpha H y : L) (tAlpha H x : L)
    exact LieModule.traceForm_comm ℂ L L _ _
  have hlen (i : Vertex D) : (lengthFactor D i : ℂ) ≠ 0 :=
    Int.cast_ne_zero.mpr (lengthFactor_ne_zero D i)
  have hdiag (i : Vertex D) : B (a i) (a i) ≠ 0 :=
    rootForm_self_ne_zero hss H hH _ (s i).property.1.1
  let t (i : Vertex D) : ℂ := B (a i) (a i) / (2 * (lengthFactor D i : ℂ))
  have hform (i j : Vertex D) : B (a i) (a j) =
      t i * (lengthFactor D i : ℂ) * (cartan D i j : ℂ) := by
    have h := killingCoroot_pairing hss H hH (a i) (a j)
    change (a j) (coroot_value H (a i)) = 2 * B (a j) (a i) / B (a i) (a i) at h
    rw [hA i j, hB_symm (a j) (a i)] at h
    have he := (div_eq_iff (hdiag i)).mp h.symm
    unfold t
    field_simp [hlen i]
    linear_combination he
  have hstep (i j : Vertex D) (hij : cartan D i j ≠ 0) : t i = t j := by
    have h := hB_symm (a i) (a j)
    rw [hform, hform, mul_assoc, mul_assoc] at h
    have hsym :
        (lengthFactor D i : ℂ) * (cartan D i j : ℂ) =
          (lengthFactor D j : ℂ) * (cartan D j i : ℂ) := by
      exact_mod_cast symmetricCartanGram D i j
    rw [← hsym] at h
    exact mul_right_cancel₀ (mul_ne_zero (hlen i) (Int.cast_ne_zero.mpr hij)) h
  let k : Vertex D := ⟨0, diagram_rank_pos D⟩
  have ht_nat (n : ℕ) (i : Vertex D) (hi : i.val = n) : t i = t k := by
    induction n using Nat.strong_induction_on generalizing i with
    | h n ih =>
      by_cases hz : n = 0
      · have h : i = k := Fin.ext (hi.trans hz)
        rw [h]
      · let j := earlierVertex D i
        obtain ⟨hj, hij⟩ := earlier_neighbor D i (hi.symm ▸ Nat.pos_of_ne_zero hz)
        have hj' : j.val < n := hi ▸ hj
        exact (hstep i j hij).trans (ih j.val hj' j rfl)
  have ht (i : Vertex D) : t i = t k := ht_nat i.val i rfl
  refine ⟨t k, div_ne_zero (hdiag k) (mul_ne_zero two_ne_zero (hlen k)), ?_⟩
  intro c e
  change B (∑ i, c i • a i) (∑ j, e j • a j) =
    t k * (↑(∑ i, ∑ j, (c i * lengthFactor D i * cartan D i j) * e j : ℤ) : ℂ)
  simp only [← Int.cast_smul_eq_zsmul ℂ, map_sum, LinearMap.sum_apply,
    map_smul, LinearMap.smul_apply, smul_eq_mul, hform, ht, Int.cast_sum,
    Int.cast_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- A Cartan entry certified by the integer Gram calculation is the actual
coroot pairing for the corresponding roots. -/
theorem coordinateRoot_cartan_entry (D : Diagram) {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (c e : Root D) (n : ℤ) (hc : gram D c c ≠ 0)
    (hce : 2 * gram D c e = gram D c c * n) :
    coordinateRoot s e (coroot_value H (coordinateRoot s c)) = (n : ℂ) := by
  obtain ⟨q, hq, hGram⟩ := coordinateRoot_gram D hss H hH φ s hA
  rw [killingCoroot_pairing hss H hH]
  have hB_symm : rootForm_value H (coordinateRoot s e) (coordinateRoot s c) =
      rootForm_value H (coordinateRoot s c) (coordinateRoot s e) :=
    LieModule.traceForm_comm ℂ L L _ _
  rw [hB_symm, hGram, hGram]
  apply (div_eq_iff (mul_ne_zero hq (Int.cast_ne_zero.mpr hc))).mpr
  have hnum : (2 : ℂ) * (gram D c e : ℂ) = (gram D c c : ℂ) * (n : ℂ) := by
    exact_mod_cast hce
  linear_combination q * hnum

end Gram

section FixedTypeTransport

open Module
open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed)
open private self_centralizing_maximal from MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.MaximalTori
open private maximalToral_isCartan rootSpace_eq_generalized rootWeight rootWeight_nonzero
  coroot_rootWeight from MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.RootTriples


variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
variable (a : L ≃ₗ⁅ℂ⁆ L) (H : LieSubalgebra ℂ L)
variable (hfix : H ≤ complexFixed a)

private abbrev fixedCenter (a : L ≃ₗ⁅ℂ⁆ L) := LieAlgebra.center ℂ (complexFixed a)

private abbrev semisimpleCartan (hfix : H ≤ complexFixed a) (S : LieIdeal ℂ (complexFixed a)) :
    LieSubalgebra ℂ S := (LieSubalgebra.ofLe hfix).comap S.incl

private abbrev semisimpleIncl (a : L ≃ₗ⁅ℂ⁆ L) (S : LieIdeal ℂ (complexFixed a)) : S →ₗ⁅ℂ⁆ L :=
  (complexFixed a).incl.comp S.incl

private theorem center_le_fixed_cartan (hss : IsSemisimple ℂ L) (hH : IsMaximalToral H) :
    ((fixedCenter a) : LieSubalgebra ℂ (complexFixed a)) ≤ (LieSubalgebra.ofLe hfix) := by
  intro z hz
  apply (LieSubalgebra.mem_ofLe hfix z).mpr
  rw [← maximal_toral_centralizer hss H hH]
  intro h
  exact congrArg Subtype.val (hz (LieSubalgebra.inclusion hfix h))

section Complement

variable (S : LieIdeal ℂ (complexFixed a))
variable (p : (S × (fixedCenter a)) ≃ₗ⁅ℂ⁆ (complexFixed a))
variable (hp : ∀ (x : S) (z : (fixedCenter a)), p (x, z) = (x : (complexFixed a)) + (z : (complexFixed a)))


private theorem semisimple_cartan_projection_mem
    (hp : ∀ (x : S) (z : (fixedCenter a)), p (x, z) = (x : (complexFixed a)) + (z : (complexFixed a)))
    (hss : IsSemisimple ℂ L) (hH : IsMaximalToral H) (h : H) :
    (p.symm (LieSubalgebra.inclusion hfix h)).1 ∈ (semisimpleCartan a H hfix S) := by
  let x := p.symm (LieSubalgebra.inclusion hfix h)
  have hx : (x.1 : (complexFixed a)) + (x.2 : (complexFixed a)) = LieSubalgebra.inclusion hfix h :=
    (hp x.1 x.2).symm.trans (p.apply_symm_apply _)
  have hz : (x.2 : (complexFixed a)) ∈ (LieSubalgebra.ofLe hfix) := center_le_fixed_cartan a H hfix hss hH x.2.property
  have hh : LieSubalgebra.inclusion hfix h ∈ (LieSubalgebra.ofLe hfix) := ⟨h, rfl⟩
  have hs : (x.1 : (complexFixed a)) ∈ (LieSubalgebra.ofLe hfix) := by
    have he : (x.1 : (complexFixed a)) = LieSubalgebra.inclusion hfix h - (x.2 : (complexFixed a)) := eq_sub_of_add_eq hx
    rw [he]
    exact (LieSubalgebra.ofLe hfix).sub_mem hh hz
  exact hs

private theorem semisimple_fixed_cartan_isMaximalToral
    (hp : ∀ (x : S) (z : (fixedCenter a)), p (x, z) = (x : (complexFixed a)) + (z : (complexFixed a)))
    (hss : IsSemisimple ℂ L) (hH : IsMaximalToral H) : IsMaximalToral (semisimpleCartan a H hfix S) := by
  have hj : Function.Injective ((semisimpleIncl a S) : S → L) := Subtype.val_injective.comp Subtype.val_injective
  have hh (x : (semisimpleCartan a H hfix S)) : (semisimpleIncl a S) x.val ∈ H := (LieSubalgebra.mem_ofLe hfix (S.incl x.val)).1 x.property
  have halg (x y : (semisimpleCartan a H hfix S)) : ⁅(semisimpleIncl a S) x.val, (semisimpleIncl a S) y.val⁆ = 0 := by
    let : IsLieAbelian H := hH.1.1
    exact congrArg Subtype.val
      (trivial_lie_zero H H ⟨(semisimpleIncl a S) x.val, hh x⟩ ⟨(semisimpleIncl a S) y.val, hh y⟩)
  apply self_centralizing_maximal (semisimpleCartan a H hfix S)
  · constructor
    · refine ⟨fun x y => Subtype.ext (hj ?_)⟩
      change (semisimpleIncl a S) ⁅x.val, y.val⁆ = (semisimpleIncl a S) 0
      simpa only [map_zero, LieHom.map_lie] using halg x y
    · intro x
      let adL := LieAlgebra.ad ℂ L ((semisimpleIncl a S) x.val)
      let adS := LieAlgebra.ad ℂ S (x.val)
      let V := (semisimpleIncl a S).range.toSubmodule
      have hV : V ∈ adL.invtSubmodule := by
        rw [Module.End.mem_invtSubmodule]
        rintro _ ⟨y, rfl⟩
        exact ⟨⁅x.val, y⁆, (semisimpleIncl a S).map_lie _ _⟩
      have hVr : ∀ y ∈ V, adL y ∈ V := by
        rw [Module.End.mem_invtSubmodule] at hV
        exact fun _ hy => hV hy
      let e := ((semisimpleIncl a S).equivRangeOfInjective hj).toLinearEquiv
      have he : e.toLinearMap ∘ₗ adS = adL.restrict hVr ∘ₗ e.toLinearMap := by
        ext y
        exact (semisimpleIncl a S).map_lie _ _
      exact (e.isSemisimple_iff adS (adL.restrict hVr) he).mpr
        ((hH.1.2 ⟨(semisimpleIncl a S) x.val, hh x⟩).restrict hV)
  · refine le_antisymm ?_ ?_
    · intro x hx
      have hw : (semisimpleIncl a S) x ∈ toralCentralizer H := by
        intro h
        let y := p.symm (LieSubalgebra.inclusion hfix h)
        have hy : y.1 ∈ (semisimpleCartan a H hfix S) := semisimple_cartan_projection_mem a H hfix S p hp hss hH h
        have hbr : ⁅y.1, x⁆ = 0 := hx ⟨y.1, hy⟩
        have hz : ⁅(y.2 : (complexFixed a)), (x : (complexFixed a))⁆ = 0 := by
          rw [← lie_skew, y.2.property, neg_zero]
        have hsum : ((y.1 : (complexFixed a)) : L) + ((y.2 : (complexFixed a)) : L) = (h : L) :=
          congrArg Subtype.val ((hp y.1 y.2).symm.trans (p.apply_symm_apply _))
        rw [← hsum, add_lie]
        have hbr' : ⁅((y.1 : (complexFixed a)) : L), (semisimpleIncl a S) x⁆ = 0 := congrArg (semisimpleIncl a S) hbr
        have hz' : ⁅((y.2 : (complexFixed a)) : L), (semisimpleIncl a S) x⁆ = 0 := congrArg Subtype.val hz
        rw [hbr', hz', add_zero]
      rw [maximal_toral_centralizer hss H hH] at hw
      exact (LieSubalgebra.mem_ofLe hfix (S.incl x)).mpr hw
    · intro x hx y
      apply hj
      rw [LieHom.map_lie, map_zero]
      exact halg y ⟨x, hx⟩

private def project_fixed_cartan
    (hp : ∀ (x : S) (z : (fixedCenter a)), p (x, z) = (x : (complexFixed a)) + (z : (complexFixed a)))
    (hss : IsSemisimple ℂ L) (hH : IsMaximalToral H) : H →ₗ[ℂ] (semisimpleCartan a H hfix S) :=
  ((LinearMap.fst ℂ S (fixedCenter a)).comp
    (p.symm.toLinearEquiv.toLinearMap.comp (LieSubalgebra.inclusion hfix).toLinearMap)).codRestrict
      (semisimpleCartan a H hfix S).toSubmodule (semisimple_cartan_projection_mem a H hfix S p hp hss hH)

private def include_fixed_cartan : (semisimpleCartan a H hfix S) →ₗ[ℂ] H :=
  ((semisimpleIncl a S).toLinearMap.comp (semisimpleCartan a H hfix S).incl.toLinearMap).codRestrict H.toSubmodule (fun x =>
    (LieSubalgebra.mem_ofLe hfix (S.incl x.val)).1 x.property)

variable (hss : IsSemisimple ℂ L) (hH : IsMaximalToral H)


private theorem project_fixed_cartan_leftInverse : Function.LeftInverse (project_fixed_cartan a H hfix S p hp hss hH) (include_fixed_cartan a H hfix S) := by
  intro x
  apply Subtype.ext
  change (p.symm (LieSubalgebra.inclusion hfix ((include_fixed_cartan a H hfix S) x))).1 = x.val
  have he : LieSubalgebra.inclusion hfix ((include_fixed_cartan a H hfix S) x) = p (x.val, 0) := by
    rw [hp, ZeroMemClass.coe_zero, add_zero]
    rfl
  rw [he, p.symm_apply_apply]

private def fixed_cartan_split :
    H ≃ₗ[ℂ] (semisimpleCartan a H hfix S × fixedCenter a) := by
  let U := semisimpleCartan a H hfix S
  let Zh : fixedCenter a →ₗ[ℂ] H :=
    ((complexFixed a).incl.toLinearMap.comp (fixedCenter a).incl.toLinearMap).codRestrict
      H.toSubmodule (fun z => (LieSubalgebra.mem_ofLe hfix (z : complexFixed a)).mp
        (center_le_fixed_cartan a H hfix hss hH z.property))
  let F : U × fixedCenter a →ₗ[ℂ] H :=
    (include_fixed_cartan a H hfix S).coprod Zh
  have hF (x : U × fixedCenter a) :
      LieSubalgebra.inclusion hfix (F x) = p (x.1.val, x.2) := by
    rw [hp]
    rfl
  refine (LinearEquiv.ofBijective F ⟨?_, ?_⟩).symm
  · intro x y he
    have hy : (x.1.val, x.2) = (y.1.val, y.2) :=
      p.injective (by
        change p (x.1.val, x.2) = p (y.1.val, y.2)
        rw [← hF, ← hF, he])
    exact Prod.ext
      (Subtype.ext (congrArg (fun v : S × fixedCenter a => v.1) hy))
      (congrArg (fun v : S × fixedCenter a => v.2) hy)
  · intro h
    let x := p.symm (LieSubalgebra.inclusion hfix h)
    have hx : x.1 ∈ U := semisimple_cartan_projection_mem a H hfix S p hp hss hH h
    refine ⟨(⟨x.1, hx⟩, x.2), (LieSubalgebra.inclusion_injective hfix) ?_⟩
    rw [hF]
    exact p.apply_symm_apply _

private theorem semisimple_fixed_cartan_lie (h : H) (x : S) :
    (semisimpleIncl a S) ⁅((project_fixed_cartan a H hfix S p hp hss hH) h).val, x⁆ = ⁅(h : L), (semisimpleIncl a S) x⁆ := by
  let z := (p.symm (LieSubalgebra.inclusion hfix h)).2
  have hc : (h : L) = ((include_fixed_cartan a H hfix S) ((project_fixed_cartan a H hfix S p hp hss hH) h) : L) + ((z : (complexFixed a)) : L) := by
    change (h : L) = (semisimpleIncl a S) (p.symm (LieSubalgebra.inclusion hfix h)).1 + ((z : (complexFixed a)) : L)
    exact congrArg Subtype.val ((p.apply_symm_apply (LieSubalgebra.inclusion hfix h)).symm.trans
      (hp (p.symm (LieSubalgebra.inclusion hfix h)).1 z))
  have hz : ⁅(z : (complexFixed a)), (x : (complexFixed a))⁆ = 0 := by rw [← lie_skew, z.property, neg_zero]
  have hz' : ⁅((z : (complexFixed a)) : L), (semisimpleIncl a S) x⁆ = 0 := congrArg Subtype.val hz
  rw [hc, add_lie, hz', add_zero, (semisimpleIncl a S).map_lie]
  rfl

private theorem semisimple_fixed_rootSpace
    (β : Dual ℂ (semisimpleCartan a H hfix S)) (x : S) :
    x ∈ rootSpace (semisimpleCartan a H hfix S) β ↔ (semisimpleIncl a S) x ∈ rootSpace H (β.comp (project_fixed_cartan a H hfix S p hp hss hH)) := by
  have hj : Function.Injective ((semisimpleIncl a S) : S → L) := Subtype.val_injective.comp Subtype.val_injective
  rw [mem_rootSpace, mem_rootSpace]
  constructor
  · intro hx h
    rw [← semisimple_fixed_cartan_lie a H hfix S p hp hss hH h x, hx, map_smul]
    rfl
  · intro hx h
    apply hj
    have hpi := project_fixed_cartan_leftInverse a H hfix S p hp hss hH h
    have hb := semisimple_fixed_cartan_lie a H hfix S p hp hss hH
      ((include_fixed_cartan a H hfix S) h) x
    rw [hpi] at hb
    rw [hb, hx, map_smul, LinearMap.comp_apply, hpi]

private theorem semisimple_fixed_root_mem
    (β : Dual ℂ (semisimpleCartan a H hfix S)) (hβ : β ∈ rootSet (semisimpleCartan a H hfix S)) : β.comp (project_fixed_cartan a H hfix S p hp hss hH) ∈ rootSet H := by
  have hproject := (project_fixed_cartan_leftInverse a H hfix S p hp hss hH).surjective
  refine ⟨?_, ?_⟩
  · intro h
    apply hβ.1
    ext z
    obtain ⟨z, rfl⟩ := hproject z
    exact LinearMap.congr_fun h z
  · intro hn
    obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hβ.2
    have he := (semisimple_fixed_rootSpace a H hfix S p hp hss hH β x).1 hx
    change rootSpace H (β.comp (project_fixed_cartan a H hfix S p hp hss hH)) = ⊥ at hn
    rw [hn, Submodule.mem_bot] at he
    have hj : Function.Injective ((semisimpleIncl a S) : S → L) := Subtype.val_injective.comp Subtype.val_injective
    exact hx0 (hj (he.trans (map_zero (semisimpleIncl a S)).symm))

omit [FiniteDimensional ℂ L] in
private theorem fixed_root_vector_mem_semisimple
    (hfix : H ≤ (complexFixed a)) (hp : ∀ (x : S) (z : (fixedCenter a)), p (x, z) = (x : (complexFixed a)) + (z : (complexFixed a)))
    (α : Dual ℂ H) (hα : α ≠ 0) (x : (complexFixed a)) (hx : (x : L) ∈ rootSpace H α) :
    ∃ y : S, (y : (complexFixed a)) = x := by
  let t : (complexFixed a) →ₗ⁅ℂ⁆ (fixedCenter a) := (LieHom.snd ℂ S (fixedCenter a)).comp p.symm.toLieHom
  have ht0 : t x = 0 := by
    obtain ⟨h, hh⟩ : ∃ h : H, α h ≠ 0 := by
      by_contra! hn
      exact hα (LinearMap.ext hn)
    have hbr : ⁅LieSubalgebra.inclusion hfix h,x⁆ = α h • x :=
      Subtype.ext ((mem_rootSpace H α (x : L)).mp hx h)
    have heq : t ⁅LieSubalgebra.inclusion hfix h,x⁆ = 0 := by
      rw [t.map_lie]
      apply Subtype.ext
      exact (t x).property (t (LieSubalgebra.inclusion hfix h))
    rw [hbr, map_smul] at heq
    exact (smul_eq_zero.mp heq).resolve_left hh
  refine ⟨(p.symm x).1, ?_⟩
  have hxsum := (hp (p.symm x).1 (p.symm x).2).symm.trans (p.apply_symm_apply x)
  change (p.symm x).2 = 0 at ht0
  simpa only [ht0, ZeroMemClass.coe_zero, add_zero] using hxsum

private theorem fixed_root_annihilates_center
    (α : Dual ℂ H) (x : (complexFixed a)) (hx : (x : L) ∈ rootSpace H α) (hx0 : x ≠ 0)
    (z : (fixedCenter a)) :
    α ⟨((z : (complexFixed a)) : L), (LieSubalgebra.mem_ofLe hfix (z : (complexFixed a))).mp
      (center_le_fixed_cartan a H hfix hss hH z.property)⟩ = 0 := by
  let zz : H := ⟨((z : (complexFixed a)) : L), (LieSubalgebra.mem_ofLe hfix (z : (complexFixed a))).mp
      (center_le_fixed_cartan a H hfix hss hH z.property)⟩
  have hbr : ⁅(z : (complexFixed a)),x⁆ = 0 := by rw [← lie_skew, z.property, neg_zero]
  have hz := (mem_rootSpace H α (x : L)).mp hx zz
  change α zz = 0
  rw [show ⁅(zz : L), (x : L)⁆ = 0 from congrArg Subtype.val hbr] at hz
  exact (smul_eq_zero.mp hz.symm).resolve_right
    (fun hx => hx0 (Subtype.ext hx))

private theorem fixed_root_eq_project
    (α : Dual ℂ H) (x : (complexFixed a)) (hx : (x : L) ∈ rootSpace H α) (hx0 : x ≠ 0) :
    (α.comp (include_fixed_cartan a H hfix S)).comp (project_fixed_cartan a H hfix S p hp hss hH) = α := by
  ext h
  let z := (p.symm (LieSubalgebra.inclusion hfix h)).2
  let zz : H := ⟨((z : (complexFixed a)) : L), (LieSubalgebra.mem_ofLe hfix (z : (complexFixed a))).mp
      (center_le_fixed_cartan a H hfix hss hH z.property)⟩
  have hsum : h = (include_fixed_cartan a H hfix S) ((project_fixed_cartan a H hfix S p hp hss hH) h) + zz := by
    apply Subtype.ext
    exact congrArg (fun v : complexFixed a => (v : L))
      ((p.apply_symm_apply (LieSubalgebra.inclusion hfix h)).symm.trans
        (hp (p.symm (LieSubalgebra.inclusion hfix h)).1 z))
  change α ((include_fixed_cartan a H hfix S) ((project_fixed_cartan a H hfix S p hp hss hH) h)) = α h
  have hz : α zz = 0 := fixed_root_annihilates_center a H hfix hss hH α x hx hx0 z
  nth_rw 2 [hsum]
  rw [map_add, hz, add_zero]

private theorem ambient_fixed_root_mem
    (α : Dual ℂ H) (hα : α ∈ rootSet H)
    (hfixed : ∀ x ∈ rootSpace H α, a x = x) :
    ∃ β : rootSet (semisimpleCartan a H hfix S), β.val.comp (project_fixed_cartan a H hfix S p hp hss hH) = α := by
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hα.2
  let xK : (complexFixed a) := ⟨x, hfixed x hx⟩
  have hxK0 : xK ≠ 0 := fun hz => hx0 (congrArg Subtype.val hz)
  obtain ⟨y, hy⟩ := fixed_root_vector_mem_semisimple a H S p hfix hp α hα.1 xK hx
  let β : Dual ℂ (semisimpleCartan a H hfix S) := α.comp (include_fixed_cartan a H hfix S)
  have hβeq : β.comp (project_fixed_cartan a H hfix S p hp hss hH) = α := fixed_root_eq_project a H hfix S p hp hss hH α xK hx hxK0
  have hβ0 : β ≠ 0 := by
    intro hz
    apply hα.1
    rw [← hβeq, hz, LinearMap.zero_comp]
  refine ⟨⟨β, hβ0, ?_⟩, hβeq⟩
  intro hz
  have hyx : (semisimpleIncl a S) y = x := congrArg Subtype.val hy
  have hyβ : y ∈ rootSpace (semisimpleCartan a H hfix S) β :=
    (semisimple_fixed_rootSpace a H hfix S p hp hss hH β y).mpr (by rwa [hβeq, hyx])
  change rootSpace (semisimpleCartan a H hfix S) β = ⊥ at hz
  rw [hz, Submodule.mem_bot] at hyβ
  exact hx0 (by rw [← hyx, hyβ, map_zero])

private theorem semisimple_root_iff_fixed
    (α : Dual ℂ H) :
    (∃ β : rootSet (semisimpleCartan a H hfix S),
      β.val.comp (project_fixed_cartan a H hfix S p hp hss hH) = α) ↔
    α ∈ rootSet H ∧ (∀ x ∈ rootSpace H α, a x = x) := by
  constructor
  · rintro ⟨β, rfl⟩
    have hα := semisimple_fixed_root_mem a H hfix S p hp hss hH β.val β.property
    refine ⟨hα, ?_⟩
    obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot β.property.2
    let j := semisimpleIncl a S
    have hx' := (semisimple_fixed_rootSpace a H hfix S p hp hss hH β.val x).mp hx
    have hj : Function.Injective (j : S → L) := Subtype.val_injective.comp Subtype.val_injective
    have hx0' : j x ≠ 0 := fun hz => hx0 (hj (hz.trans (map_zero j).symm))
    have hr := eq_span_singleton_of_mem_of_finrank_eq_one
      (finrank_rootSpace_eq_one hss H hH _ hα) hx' hx0'
    intro y hy
    rw [hr] at hy
    obtain ⟨d, rfl⟩ := Submodule.mem_span_singleton.mp hy
    have hfix_x : a (j x) = j x := (x.val).property
    rw [map_smul, hfix_x]
  · rintro ⟨hα, hf⟩
    exact ambient_fixed_root_mem a H hfix S p hp hss hH α hα hf

private theorem fixed_coroot_eq
    (hS : IsSemisimple ℂ S) (β : Dual ℂ (semisimpleCartan a H hfix S))
    (hβ : β ∈ rootSet (semisimpleCartan a H hfix S)) :
    include_fixed_cartan a H hfix S (killingCoroot (semisimpleCartan a H hfix S) β) =
      killingCoroot H (β.comp (project_fixed_cartan a H hfix S p hp hss hH)) := by
  let U := semisimpleCartan a H hfix S
  let j := semisimpleIncl a S
  let α := β.comp (project_fixed_cartan a H hfix S p hp hss hH)
  have hU : IsMaximalToral U := semisimple_fixed_cartan_isMaximalToral a H hfix S p hp hss hH
  have hα : α ∈ rootSet H := semisimple_fixed_root_mem a H hfix S p hp hss hH β hβ
  obtain ⟨e, f, he, hf, he0, _, hef, hhe, hhf⟩ := exists_root_triple hS U hU β hβ
  have hje : j e ∈ rootSpace H α :=
    (semisimple_fixed_rootSpace a H hfix S p hp hss hH β e).1 he
  have hjf : j f ∈ rootSpace H (-α) := by
    change j f ∈ rootSpace H (-(β.comp _))
    rw [← LinearMap.neg_comp]
    exact (semisimple_fixed_rootSpace a H hfix S p hp hss hH (-β) f).1 hf
  let hv : L := j (killingCoroot U β)
  have hE : ⁅hv, j e⁆ = (2 : ℂ) • j e := by
    change ⁅j (killingCoroot U β), j e⁆ = _
    rw [← j.map_lie, hhe, map_smul]
  have hF : ⁅hv, j f⁆ = (-2 : ℂ) • j f := by
    change ⁅j (killingCoroot U β), j f⁆ = _
    rw [← j.map_lie, hhf, map_smul]
  have hj : Function.Injective (j : S → L) := Subtype.val_injective.comp Subtype.val_injective
  have hje0 : j e ≠ 0 := fun hz => he0 (hj (hz.trans (map_zero j).symm))
  have ht : IsSl2Triple hv (j e) (j f) := by
    constructor
    · intro hz
      rw [hz, zero_lie] at hE
      exact hje0 ((smul_eq_zero.mp hE.symm).resolve_left (by norm_num))
    · exact (j.map_lie e f).symm.trans (congrArg j hef)
    · simpa only [two_smul] using hE
    · simpa only [neg_smul, two_smul] using hF
  let : LieAlgebra.HasTrivialRadical ℂ L := ⟨hss⟩
  let : H.IsCartanSubalgebra := maximalToral_isCartan hss H hH
  have hgenE : j e ∈ LieModule.genWeightSpace L ((rootWeight H hH α hα) : H → ℂ) := by
    change j e ∈ (LieModule.genWeightSpace L (α : H → ℂ)).toSubmodule
    rw [rootSpace_eq_generalized H hH]
    exact hje
  have hgenF : j f ∈ LieModule.genWeightSpace L (-(rootWeight H hH α hα) : LieModule.Weight ℂ H L) := by
    change j f ∈ (LieModule.genWeightSpace L ((-α : Dual ℂ H) : H → ℂ)).toSubmodule
    rw [rootSpace_eq_generalized H hH]
    exact hjf
  apply Subtype.ext
  have hc := ht.h_eq_coroot (rootWeight_nonzero H hH α hα) hgenE hgenF
  rw [coroot_rootWeight hss H hH α hα] at hc
  exact hc

end Complement

open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations.SerreRelations (simple positive)
open Specs.LieAlgebrasAndRepresentations.VermaModules (Direction Regular)

omit [FiniteDimensional ℂ L] in
private theorem simple_even_coordinates {D : Diagram} {M : Type u}
    [LieRing M] [LieAlgebra ℂ M]
    (U : LieSubalgebra ℂ M) (ψ : Direction U) (φ : Direction H)
    (b : Color D) (R : Finset (Root D))
    (F : Root D →+ Dual ℂ H) (G : Dual ℂ U →+ Dual ℂ H)
    (hF : Function.Injective F) (hG : Function.Injective G)
    (hR : ∀ α : Dual ℂ H,
      (∃ β ∈ rootSet U, G β = α) ↔ (∃ c ∈ R, parity D b c = 0 ∧ F c = α))
    (hP : ∀ c ∈ R, 0 < φ (F c) ↔ ∀ i, 0 ≤ c i)
    (hψ : ∀ β, ψ β = φ (G β))
    (β : Dual ℂ U) :
    β ∈ simple U ψ ↔ ∃ c ∈ simpleEven D b R, F c = G β := by
  have hpos (β : Dual ℂ U) :
      β ∈ positive U ψ ↔ ∃ c ∈ positiveEven D b R, F c = G β := by
    constructor
    · rintro ⟨hβ, hβp⟩
      obtain ⟨c, hc, he, hEc⟩ := (hR (G β)).mp ⟨β, hβ, rfl⟩
      exact ⟨c, Finset.mem_filter.mpr
        ⟨hc, he, (hP c hc).mp (hEc.symm ▸ (hψ β ▸ hβp))⟩, hEc⟩
    · rintro ⟨c, hc, hEq⟩
      obtain ⟨hc, he, hcp⟩ := Finset.mem_filter.mp hc
      obtain ⟨γ, hγ, hγeq⟩ := (hR (G β)).mpr ⟨c, hc, he, hEq⟩
      refine ⟨(hG hγeq) ▸ hγ, ?_⟩
      rw [hψ β, ← hEq]
      exact (hP c hc).mpr hcp
  constructor
  · rintro ⟨hp, hd⟩
    obtain ⟨c, hc, hEq⟩ := (hpos β).mp hp
    refine ⟨c, Finset.mem_filter.mpr ⟨hc, ?_⟩, hEq⟩
    intro x hx hy
    obtain ⟨γ, hγ, hγeq⟩ := (hR (F x)).mpr
      ⟨x, (Finset.mem_filter.mp hx).1, (Finset.mem_filter.mp hx).2.1, rfl⟩
    obtain ⟨δ, hδ, hδeq⟩ := (hR (F (c - x))).mpr
      ⟨c - x, (Finset.mem_filter.mp hy).1, (Finset.mem_filter.mp hy).2.1, rfl⟩
    have hγp := (hpos γ).mpr ⟨x, hx, hγeq.symm⟩
    have hδp := (hpos δ).mpr ⟨c - x, hy, hδeq.symm⟩
    apply hd γ hγp δ hδp
    apply hG
    rw [map_add, hγeq, hδeq, ← map_add, show x + (c - x) = c by abel, hEq]
  · rintro ⟨c, hc, hEq⟩
    obtain ⟨hc, hi⟩ := Finset.mem_filter.mp hc
    refine ⟨(hpos β).mpr ⟨c, hc, hEq⟩, ?_⟩
    intro γ hγ δ hδ hSum
    obtain ⟨x, hx, hxEq⟩ := (hpos γ).mp hγ
    obtain ⟨y, hy, hyEq⟩ := (hpos δ).mp hδ
    have hxy : c = x + y := hF (by rw [map_add, hxEq, hyEq, hEq, hSum, map_add])
    exact hi x hx (by simpa only [hxy, add_sub_cancel_left] using hy)

end FixedTypeTransport

section FixedType

open Specs.LieAlgebrasAndRepresentations.RootDecomposition (rootSpace_value rootSet_value)
open _root_.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed complex_fixed_reductive)
open Serre (Algebra RelationsHold)


private theorem relations_reindex {I' : Type u} {J' : Type v} [DecidableEq I'] [DecidableEq J']
    (A' : Matrix I' I' ℤ) (B' : Matrix J' J' ℤ) (p : I' ≃ J')
    (hp : ∀ i j, B' (p i) (p j) = A' i j)
    (hB' : ∀ i j, i ≠ j → B' i j ≤ 0) :
    RelationsHold A' (Serre.e B' ∘ p) (Serre.f B' ∘ p) (Serre.h B' ∘ p) := by
  obtain ⟨hh, he, hf, hef, hE, hF⟩ := Serre.relations_spec B' hB'
  refine ⟨fun i j => hh (p i) (p j), ?_, ?_, ?_, ?_, ?_⟩
  · intro i j
    simpa only [Function.comp_apply, hp] using he (p i) (p j)
  · intro i j
    simpa only [Function.comp_apply, hp] using hf (p i) (p j)
  · intro i j
    simpa only [Function.comp_apply, p.injective.eq_iff] using hef (p i) (p j)
  · intro i j hij
    simpa only [Function.comp_apply, hp] using hE (p i) (p j) (p.injective.ne hij)
  · intro i j hij
    simpa only [Function.comp_apply, hp] using hF (p i) (p j) (p.injective.ne hij)

/-- Relabeling the vertices of a Cartan matrix relabels its Serre generators. -/
private def serre_reindex {I : Type u} {J : Type v}
    [DecidableEq I] [DecidableEq J] (A : Matrix I I ℤ) (B : Matrix J J ℤ)
    (e : I ≃ J) (hAB : ∀ i j, B (e i) (e j) = A i j)
    (hA : ∀ i j, i ≠ j → A i j ≤ 0) :
    Algebra A ≃ₗ⁅ℂ⁆ Algebra B := by
  have hBA (i j) : A (e.symm i) (e.symm j) = B i j := by rw [← hAB]; simp
  have hB (i j) (hij : i ≠ j) : B i j ≤ 0 := by
    rw [← hBA]; exact hA _ _ (e.symm.injective.ne hij)
  let f := Serre.lift A hA _ _ _ (relations_reindex A B e hAB hB)
  let g := Serre.lift B hB _ _ _ (relations_reindex B A e.symm hBA hA)
  have hfg : g.comp f = LieHom.id := by
    apply Serre.hom_ext A
    all_goals intro i; simp [f, g]
  have hgf : f.comp g = LieHom.id := by
    apply Serre.hom_ext B
    all_goals intro i; simp [f, g]
  have hl : Function.LeftInverse g f := fun x => LieHom.congr_fun hfg x
  have hr : Function.RightInverse g f := fun x => LieHom.congr_fun hgf x
  exact LieEquiv.ofBijective f ⟨hl.injective, hr.surjective⟩

