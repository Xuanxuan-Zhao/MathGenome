private def IsPositiveEven (D : Diagram) (m : ℕ) (c : Root D) : Prop :=
  parity D (colorAt D m) c = 0 ∧ ∀ i, 0 ≤ c i

private instance (D : Diagram) (m : ℕ) (c : Root D) :
    Decidable (IsPositiveEven D m c) := by
  unfold IsPositiveEven
  infer_instance

private theorem mem_positive (D : Diagram) (m : ℕ) (c : Root D) :
    c ∈ positiveEven D (colorAt D m) (roots D) ↔ c ∈ roots D ∧ IsPositiveEven D m c :=
  Finset.mem_filter

private def checkBase (D : Diagram) (r : Row) : Prop :=
  Function.Injective (rowBase D r) ∧
  (∀ i : Fin r.fixedRank, ((baseIndices D r.mask).getD i 0) < (rootNodes D).size ∧
    IsPositiveEven D r.mask (rowBase D r i) ∧ height D r.mask (rowBase D r i) = 1) ∧
  (∀ i, gram D (rowBase D r i) (rowBase D r i) ≠ 0) ∧
  ∀ i j, 2 * gram D (rowBase D r i) (rowBase D r j) =
    gram D (rowBase D r i) (rowBase D r i) * r.matrix i j

private instance (D : Diagram) (r : Row) : Decidable (checkBase D r) := by
  unfold checkBase
  infer_instance

private theorem base_checked (D : Diagram) (r : Row) (hr : r ∈ rows D) : checkBase D r := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals rcases hr with rfl | rfl | rfl | rfl <;> decide +kernel

private def checkPositiveNode (D : Diagram) (r : Row) (n : Fin (rootNodes D).size) : Prop :=
  let c := (rootAt D n).coords
  let (i, j) := (summands D r.mask).getD n (0, 0)
  IsPositiveEven D r.mask c →
    1 ≤ height D r.mask c ∧
    ((∃ k : Fin r.fixedRank, (baseIndices D r.mask).getD k 0 = n.val) ∨
      (i < (rootNodes D).size ∧ j < (rootNodes D).size ∧
        IsPositiveEven D r.mask (rootAt D i).coords ∧
        IsPositiveEven D r.mask (rootAt D j).coords ∧
        c = (rootAt D i).coords + (rootAt D j).coords))

private instance (D : Diagram) (r : Row) (n : Fin (rootNodes D).size) :
    Decidable (checkPositiveNode D r n) := by
  unfold checkPositiveNode
  dsimp only
  infer_instance

private theorem positive_nodes_checked (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    ∀ n, checkPositiveNode D r n := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
  all_goals rcases hr with rfl | rfl | rfl | rfl <;> decide +kernel

private theorem height_positive (D : Diagram) (r : Row) (hr : r ∈ rows D)
    {c : Root D} (hc : c ∈ positiveEven D (colorAt D r.mask) (roots D)) :
    1 ≤ height D r.mask c := by
  obtain ⟨hroot, hpos⟩ := (mem_positive D r.mask c).mp hc
  obtain ⟨n, hn, rfl⟩ := (rootAt_mem_iff D c).mp hroot
  exact (positive_nodes_checked D r hr ⟨n, hn⟩ hpos).1

private theorem image_base_eq (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    Finset.univ.image (rowBase D r) = simpleEven D (colorAt D r.mask) (roots D) := by
  ext c
  unfold simpleEven
  rw [Finset.mem_filter]
  constructor
  · intro h
    obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp h
    have ⟨hb, hp, hh⟩ := (base_checked D r hr).2.1 k
    refine ⟨(mem_positive D r.mask _).mpr
      ⟨(rootAt_mem_iff D _).mpr ⟨_, hb, rfl⟩, hp⟩, ?_⟩
    intro x hx hy
    have hxH := height_positive D r hr hx
    have hyH := height_positive D r hr hy
    have hsum := height_add D r.mask x (rowBase D r k - x)
    rw [add_comm x, sub_add_cancel, hh] at hsum
    omega
  · rintro ⟨hp, hno⟩
    obtain ⟨hroot, hpos⟩ := (mem_positive D r.mask c).mp hp
    obtain ⟨n, hn, rfl⟩ := (rootAt_mem_iff D c).mp hroot
    have hc := (positive_nodes_checked D r hr ⟨n, hn⟩ hpos).2
    dsimp only at hc
    rcases hc with ⟨k, hk⟩ | ⟨hi, hj, hpi, hpj, hadd⟩
    · exact Finset.mem_image.mpr ⟨k, Finset.mem_univ _, by rw [rowBase, hk]⟩
    · let i := ((summands D r.mask).getD n (0, 0)).1
      let j := ((summands D r.mask).getD n (0, 0)).2
      have hmem (k : ℕ) (hk : k < (rootNodes D).size)
          (hk' : IsPositiveEven D r.mask (rootAt D k).coords) :
          (rootAt D k).coords ∈ positiveEven D (colorAt D r.mask) (roots D) :=
        (mem_positive D r.mask _).mpr ⟨(rootAt_mem_iff D _).mpr ⟨k, hk, rfl⟩, hk'⟩
      have hsub : (rootAt D n).coords - (rootAt D i).coords = (rootAt D j).coords := by
        rw [show (rootAt D n).coords = (rootAt D i).coords + (rootAt D j).coords from hadd,
          add_sub_cancel_left]
      exact (hno _ (hmem i hi hpi) (hsub.symm ▸ hmem j hj hpj)).elim

private theorem row_base (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    Function.Injective (rowBase D r) ∧
    Finset.univ.image (rowBase D r) = simpleEven D (colorAt D r.mask) (roots D) ∧
    (∀ i, gram D (rowBase D r i) (rowBase D r i) ≠ 0) ∧
    ∀ i j, 2 * gram D (rowBase D r i) (rowBase D r j) =
      gram D (rowBase D r i) (rowBase D r i) * r.matrix i j := by
  obtain ⟨hi, -, hn, h⟩ := base_checked D r hr
  exact ⟨hi, image_base_eq D r hr, hn, h⟩

private theorem distinct_dimensions (D : Diagram) (r : Row) (hr : r ∈ rows D)
    (s : Row) (hs : s ∈ rows D) (h : r.mask ≠ s.mask) : r.dimension ≠ s.dimension := by
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr hs
  all_goals
    rcases hr with rfl | rfl | rfl | rfl <;>
      rcases hs with rfl | rfl | rfl | rfl <;> first | exact (h rfl).elim | decide

private theorem distinct_orbits (D : Diagram) (r : Row) (hr : r ∈ rows D)
    (s : Row) (hs : s ∈ rows D) (h : r.mask ≠ s.mask) :
    ¬ ColorOrbit D (colorAt D r.mask) (colorAt D s.mask) := by
  intro horbit
  apply distinct_dimensions D r hr s hs h
  rw [(row_dimensions D r hr).1, (row_dimensions D s hs).1, evenCount_orbit horbit]

private theorem orbit_complete (D : Diagram) (r : Row) (hr : r ∈ rows D) {b : Color D}
    (hb : ColorOrbit D (colorAt D r.mask) b) : b ∈ orbit D r.mask := by
  obtain ⟨s, hs, hm⟩ := colors_cover D b
  have e := (evenCount_orbit hb).symm.trans (evenCount_orbit (orbit_sound D s hs hm))
  have he : r.dimension = s.dimension := by
    rw [(row_dimensions D r hr).1, (row_dimensions D s hs).1, e]
  have h : r.mask = s.mask := by
    by_contra hn
    exact distinct_dimensions D r hr s hs hn he
  rwa [h]

universe u

theorem finiteTables : finiteTablesType := by
  intro D
  refine ⟨roots D, root_mem D, ?_, ?_, distinct_orbits D⟩
  · intro b
    obtain ⟨r, hr, hb⟩ := colors_cover D b
    exact ⟨r, hr, orbit_sound D r hr hb⟩
  · intro r hr
    obtain ⟨hd, hs, hc⟩ := row_dimensions D r hr
    exact ⟨orbit D r.mask, fun _ => ⟨orbit_sound D r hr, orbit_complete D r hr⟩,
      orbit_size D r hr, hd, hs, hc, rowBase D r, row_base D r hr⟩

section RootAction

open Specs.LieAlgebrasAndRepresentations
open RootDecomposition


open _root_.LieAlgebrasAndRepresentations.VoganEquivalence (torusCoordinates)
open private exponential_on_root from MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.VoganEquivalence

private def signUnit (b : ZMod 2) : ℂˣ := if b = 0 then 1 else -1

private theorem val_signUnit (b : ZMod 2) :
    (signUnit b : ℂ) = colorSign b := by
  by_cases h : b = 0 <;> simp [signUnit, colorSign, h]

private theorem color_cases : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide

private def colorSignHom : Multiplicative (ZMod 2) →* ℂˣ where
  toFun b := signUnit b.toAdd
  map_one' := by simp [signUnit]
  map_mul' a b := by
    change signUnit (a.toAdd + b.toAdd) = signUnit a.toAdd * signUnit b.toAdd
    have ht : (1 : ZMod 2) + 1 = 0 := by decide
    rcases color_cases a.toAdd with ha | ha <;>
      rcases color_cases b.toAdd with hb | hb <;>
      simp [ha, hb, signUnit, ht, show (1 : ZMod 2) ≠ 0 by decide]

private theorem colorSign_inv (b : ZMod 2) : (colorSign b)⁻¹ = colorSign b := by
  by_cases h : b = 0 <;> simp [colorSign, h]

private theorem colorSign_sum_zsmul {ι : Type*} [Fintype ι]
    (b : ι → ZMod 2) (c : ι → ℤ) :
    colorSign (∑ i, (c i : ZMod 2) * b i) = ∏ i, colorSign (b i) ^ c i := by
  rw [← val_signUnit]
  change (colorSignHom (Multiplicative.ofAdd (∑ i, (c i : ZMod 2) * b i)) : ℂ) = _
  rw [ofAdd_sum, map_prod, Units.coe_prod]
  apply Finset.prod_congr rfl
  intro i _
  rw [← zsmul_eq_mul, ofAdd_zsmul, map_zpow, Units.val_zpow_eq_zpow_val,
    ← val_signUnit]
  rfl


open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation)
open SerreRelations (simple)
open VermaModules (Direction Regular)
open RootForm (coroot_value)
open IntegrableHighestWeightQuotient (Normalized)

private theorem inner_root_action_of_generation
    {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (H : LieSubalgebra ℂ L)
    (hH : MaximalTori.IsMaximalToral_value H) (hwH : ∀ h ∈ H, ω.map h ∈ H)
    (φ : Direction H) (hφ : Regular H φ)
    (e f : simple H φ → L) (hN : Normalized H φ e f)
    (hw : ∀ i, ω.map (e i) = -f i)
    (hgen : LieSubalgebra.lieSpan ℂ L
      (Set.range e ∪ Set.range f ∪ Set.range (fun i : simple H φ =>
        (coroot_value H i.val : L))) = ⊤)
    (a : L ≃ₗ⁅ℂ⁆ L) (haH : ∀ h : H, a (h : L) = (h : L))
    (b : simple H φ → ZMod 2)
    (ha : ∀ i, a (e i) = colorSign (b i) • e i ∧ a (f i) = colorSign (b i) • f i) :
    ∀ {ι : Type} [Fintype ι] (s : ι ≃ simple H φ) (c : ι → ℤ)
      (x : L), x ∈ rootSpace_value H (∑ i, c i • (s i).val) →
        a x = colorSign (∑ i, (c i : ZMod 2) * b (s i)) • x := by
  let z (i : simple H φ) : Circle := if b i = 0 then 1 else -1
  have hz (i : simple H φ) : (z i : ℂ) = colorSign (b i) := by
    by_cases h : b i = 0 <;> simp [z, colorSign, h]
  obtain ⟨h, -, t, -, ht, htH, htef⟩ := torusCoordinates hss ω H hH hwH φ hφ e f hN hw z
  have hta : ∀ x, a x = t x := by
    let K : LieSubalgebra ℂ L :=
      { carrier := {x | a x = t x}
        add_mem' := fun hx hy => by simp only [Set.mem_ofPred_eq, map_add] at *; rw [hx, hy]
        zero_mem' := by simp
        smul_mem' := fun r x hx => by simp only [Set.mem_ofPred_eq, map_smul] at *; rw [hx]
        lie_mem' := fun hx hy => by
          simp only [Set.mem_ofPred_eq, LieEquiv.map_lie] at *
          rw [hx, hy] }
    suffices htop : (⊤ : LieSubalgebra ℂ L) ≤ K from fun x => htop (by simp)
    rw [← hgen, LieSubalgebra.lieSpan_le]
    intro x hx
    change a x = t x
    rcases hx with (⟨i, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩
    · rw [(ha i).1, (htef i).1, hz]
    · rw [(ha i).2, (htef i).2, hz, colorSign_inv]
    · rw [haH (coroot_value H i.val), htH (coroot_value H i.val)]
  have h_exp (i : simple H φ) : Complex.exp (i.val h) = colorSign (b i) := by
    apply smul_left_injective ℂ (hN i).2.2.1
    change Complex.exp (i.val h) • e i = colorSign (b i) • e i
    rw [← exponential_on_root H h t ht i.val (e i) (hN i).1]
    exact (htef i).1.trans (congrArg (· • e i) (hz i))
  intro ι _ s c x hx
  rw [hta x, exponential_on_root H h t ht _ x hx]
  congr 1
  rw [LinearMap.sum_apply, colorSign_sum_zsmul]
  simp only [LinearMap.smul_apply, zsmul_eq_mul, Complex.exp_sum, Complex.exp_int_mul, h_exp]

theorem innerRootAction : innerRootActionType.{u} := by
  intro D L _ _ _ hss ω H hH hwH φ hφ e f hN hw a haH s b ha c x hx
  obtain ⟨A, _, _, _, hgen⟩ :=
    _root_.LieAlgebrasAndRepresentations.serre_relations hss H hH φ hφ e f hN
  have has (j : simple H φ) :
      a (e j) = colorSign (b (s.symm j)) • e j ∧
      a (f j) = colorSign (b (s.symm j)) • f j := by
    simpa only [Equiv.apply_symm_apply] using ha (s.symm j)
  simpa only [Function.comp_apply, Equiv.symm_apply_apply, parity] using
    inner_root_action_of_generation hss ω H hH hwH φ hφ e f hN hw hgen a haH
      (b ∘ s.symm) has s c x hx

end RootAction

section RootCoordinates

open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.RealRootSpace
open SerreRelations (simple positive)
open VermaModules (Direction Regular)
open RootForm (coroot_value)
open RootDecomposition (rootSet_value)
open scoped BigOperators TensorProduct

/-- Evaluate integral coordinates on the source-numbered simple roots. -/
def coordinateRoot {D : Diagram} {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    {H : LieSubalgebra ℂ L} {φ : Direction H}
    (s : Vertex D ≃ simple H φ) (c : Root D) : Module.Dual ℂ H :=
  ∑ i, c i • (s i).val

private theorem coordinateRoot_reflect {D : Diagram} {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    {H : LieSubalgebra ℂ L} {φ : Direction H}
    (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (i : Vertex D) (c : Root D) :
    coordinateRoot s (reflect D i c) =
      RootStrings.reflection_value H (s i).val (coordinateRoot s c) := by
  let z := ∑ j, cartan D i j * c j
  have hsum : coordinateRoot s c (coroot_value H (s i).val) = (z : ℂ) := by
    simp only [coordinateRoot, LinearMap.sum_apply, LinearMap.smul_apply, hA, zsmul_eq_mul,
      Int.cast_sum, Int.cast_mul, mul_comm, z]
  have h : ∀ j, reflect D i c j = c j - if i = j then z else 0 := by
    intro j
    by_cases hij : i = j <;> simp [reflect, hij, z]
  rw [RootStrings.reflection_value, hsum, coordinateRoot, coordinateRoot]
  simp only [h, sub_eq_add_neg, add_zsmul, neg_zsmul, Finset.sum_add_distrib,
    Finset.sum_neg_distrib, ite_smul, zero_zsmul, Finset.sum_ite_eq, Finset.mem_univ,
    ite_true, Int.cast_smul_eq_zsmul]

private theorem coordinateRoot_unit {D : Diagram} {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] {H : LieSubalgebra ℂ L} {φ : Direction H}
    (s : Vertex D ≃ simple H φ) (i : Vertex D) :
    coordinateRoot s (unit D i) = (s i).val := by
  simp [coordinateRoot, unit, ite_smul]

/-- The abstract Lie roots have exactly the generated integer coordinates.
The maps also preserve the positivity of a root and the independent coordinates. -/
theorem coordinateRoot_system (D : Diagram) {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (hφ : Regular H φ)
    (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ)) :
    Function.Injective (coordinateRoot s) ∧
    (∀ α : Module.Dual ℂ H, α ∈ rootSet_value H ↔
      ∃ c, Generated (reflect D) (Set.range (unit D)) c ∧ coordinateRoot s c = α) ∧
    (∀ c : Root D, coordinateRoot s c ∈ rootSet_value H →
      (0 < φ (coordinateRoot s c) ↔ ∀ i, 0 ≤ c i)) ∧
    Module.finrank ℂ H = D.rank := by
  classical
  let d := LieAlgebrasAndRepresentations.RealRootSpace.realization_of_maximalToral hss H hH
  let := d.normedAddCommGroup
  let := d.innerProductSpace
  let : FiniteDimensional ℝ H := FiniteDimensional.trans ℝ ℂ H
  let E' := E H
  let R' := realRoots H
  have hR' : IsRootSystem R' := d.root_system
  let p : E' →ₗ[ℝ] ℝ := φ.comp d.j
  let z : E' := (InnerProductSpace.toDual ℝ E').symm p.toContinuousLinearMap
  have hz (x : E') : inner ℝ z x = φ (d.j x) :=
    InnerProductSpace.toDual_symm_apply
  have hJ : Function.Injective d.j := by
    intro x y hxy
    ext v
    have he := congrArg (fun α : Module.Dual ℂ H => α (v : H)) hxy
    have eval (t : E') : d.j t (v : H) = (t v : ℂ) := by
      simpa using d.extension_formula t v 0
    rw [eval, eval] at he
    exact Complex.ofReal_injective he
  have hroot (x : E') : x ∈ R' ↔ d.j x ∈ rootSet_value H := by
    constructor
    · rintro ⟨α, hα, rfl⟩
      simpa only [d.extension_root α hα] using hα
    · intro h
      exact ⟨d.j x, h, hJ (d.extension_root _ h)⟩
  have hz' : RootRegular R' z := fun x hx => (hz x) ▸ hφ _ ((hroot x).mp hx)
  have hpos (x : E') : x ∈ positiveRoots R' z ↔ d.j x ∈ positive H φ := by
    change (x ∈ R' ∧ 0 < inner ℝ z x) ↔ (d.j x ∈ rootSet_value H ∧ 0 < φ (d.j x))
    rw [hroot x, hz]
  have hsimple (x : E') : x ∈ simpleRoots R' z ↔ d.j x ∈ simple H φ := by
    constructor
    · rintro ⟨hx, h⟩
      refine ⟨(hpos x).mp hx, ?_⟩
      intro a ha b hb hab
      let a' := rootRestriction H a
      let b' := rootRestriction H b
      have ha' : d.j a' = a := d.extension_root a ha.1
      have hb' : d.j b' = b := d.extension_root b hb.1
      apply h a' ((hpos a').mpr (ha'.symm ▸ ha)) b' ((hpos b').mpr (hb'.symm ▸ hb))
      apply hJ
      rwa [map_add, ha', hb']
    · rintro ⟨hx, h⟩
      refine ⟨(hpos x).mpr hx, ?_⟩
      intro a ha b hb hab
      exact h _ ((hpos a).mp ha) _ ((hpos b).mp hb) (by rw [hab, map_add])
  let ξ : Vertex D ≃ simpleRoots R' z :=
    { toFun := fun i => ⟨rootRestriction H (s i).val, (hsimple _).2 (by
        rw [d.extension_root _ (s i).property.1.1]
        exact (s i).property)⟩
      invFun := fun x => s.symm ⟨d.j x.val, (hsimple x.val).1 x.property⟩
      left_inv := by
        intro i
        apply s.injective
        rw [Equiv.apply_symm_apply]
        exact Subtype.ext (d.extension_root _ (s i).property.1.1)
      right_inv := by
        intro x
        apply Subtype.ext
        change rootRestriction H (s (s.symm ⟨d.j x.val, (hsimple x.val).1 x.property⟩)).val = _
        rw [Equiv.apply_symm_apply]
        exact hJ (d.extension_root _ ((hroot _).mp x.property.1.1)) }
  let : Finite (simpleRoots R' z) := Finite.of_equiv (Vertex D) ξ
  obtain ⟨b₀, hb₀⟩ := simpleRoots_basis R' hR' z hz'
  let b := b₀.reindex ξ.symm
  have hb (i : Vertex D) : b i = (ξ i).val := by
    rw [Module.Basis.reindex_apply, hb₀]
    rfl
  have hbj (i : Vertex D) : d.j (b i) = (s i).val := by
    rw [hb]
    exact d.extension_root _ (s i).property.1.1
  let coord (c : Root D) : E' := b.equivFun.symm (fun i => (c i : ℝ))
  have coord_sum (c : Root D) : coord c = ∑ i, c i • b i := by
    unfold coord
    rw [Module.Basis.equivFun_symm_apply]
    exact Finset.sum_congr rfl (fun i _ => Int.cast_smul_eq_zsmul ℝ (c i) (b i))
  have coord_apply (c : Root D) : d.j (coord c) = coordinateRoot s c := by
    simp only [coord_sum, map_sum, map_zsmul, hbj, coordinateRoot]
  have coord_inj : Function.Injective coord := by
    intro c e h
    have heq := b.equivFun.symm.injective h
    exact funext (fun i => Int.cast_injective (α := ℝ) (congrFun heq i))
  have coord_unit (i : Vertex D) : coord (unit D i) = b i := by
    rw [coord_sum]
    simp [unit, ite_smul]
  have coord_reflect (i : Vertex D) (c : Root D) :
      coord (reflect D i c) = rootReflection (b i) (coord c) := by
    apply hJ
    rw [coord_apply, coordinateRoot_reflect s hA, RootStrings.reflection_value]
    rw [← coord_apply, ← hbj]
    rw [rootReflection, map_sub, map_smul]
    congr 1
    rw [← algebraMap_smul ℂ]
    congr 1
    change d.j (coord c) (coroot_value H (d.j (b i))) =
      ((2 * inner ℝ (coord c) (b i) / inner ℝ (b i) (b i) : ℝ) : ℂ)
    rw [hb, show (ξ i).val = rootRestriction H (s i).val from rfl,
      d.extension_root _ (s i).property.1.1,
      d.coroot_evaluation (coord c) _ (s i).property.1.1]
    congr 1
    rw [coroot, real_inner_smul_right]
    ring
  let C : Set E' := {x | ∃ c, Generated (reflect D) (Set.range (unit D)) c ∧ coord c = x}
  have hC (i : Vertex D) {x : E'} (hx : x ∈ C) : rootReflection (b i) x ∈ C := by
    obtain ⟨c, hc, rfl⟩ := hx
    exact ⟨reflect D i c, .next i hc, coord_reflect i c⟩
  have hcover {x : E'} (hx : x ∈ R') : x ∈ C := by
    obtain ⟨w, a, ha, rfl⟩ := root_simple_orbit hR' hz' hx
    have hstable : ∀ g ∈ simpleWeylGroup R' z, ∀ y, g y ∈ C ↔ y ∈ C := by
      intro g hg
      refine Subgroup.closure_induction (p := fun g _ => ∀ y, g y ∈ C ↔ y ∈ C)
        ?_ ?_ ?_ ?_ hg
      · rintro _ ⟨a, ha, rfl⟩ y
        let i := ξ.symm ⟨a, ha⟩
        have he : b i = a := by simpa [i] using hb i
        rw [rootReflectionEquiv_apply, ← he]
        exact ⟨fun h => reflection_involutive (b i) y ▸ hC i h, hC i⟩
      · intro y
        rfl
      · intro g₁ g₂ _ _ h₁ h₂ y
        exact (h₁ (g₂ y)).trans (h₂ y)
      · intro g _ hg y
        simpa using (hg (g⁻¹ y)).symm
    apply (hstable w.val w.property a).2
    let i := ξ.symm ⟨a, ha⟩
    have he : b i = a := by simpa [i] using hb i
    exact ⟨unit D i, .initial (Set.mem_range_self i), (coord_unit i).trans he⟩
  have hs : ∀ c, Generated (reflect D) (Set.range (unit D)) c →
      coordinateRoot s c ∈ rootSet_value H := by
    intro c hc
    induction hc with
    | initial h =>
      obtain ⟨i, rfl⟩ := h
      rw [coordinateRoot_unit]
      exact (s i).property.1.1
    | next i x hx =>
      rw [coordinateRoot_reflect s hA]
      exact RootStrings.reflection_mem_rootSet hss H hH _ _ (s i).property.1.1 hx
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro c e h
    apply coord_inj
    exact hJ (by rwa [coord_apply, coord_apply])
  · intro α
    constructor
    · intro hα
      let α' := rootRestriction H α
      obtain ⟨c, hc, he⟩ := hcover (x := α') ⟨α, hα, rfl⟩
      exact ⟨c, hc, (coord_apply c).symm.trans ((congrArg d.j he).trans (d.extension_root α hα))⟩
    · rintro ⟨c, hc, rfl⟩
      exact hs c hc
  · intro c hc
    constructor
    · intro hp
      have hx : coord c ∈ positiveRoots R' z :=
        (hpos (coord c)).mpr (by rw [coord_apply]; exact ⟨hc, hp⟩)
      have hn := positive_basis_coords_nonneg hR'.toRootAxioms b₀ hb₀ hx
      intro i
      have he : (c i : ℝ) = b₀.repr (coord c) (ξ i) := by
        have h : b.equivFun (coord c) i = (c i : ℝ) :=
          congrFun (b.equivFun.apply_symm_apply _) i
        rw [Module.Basis.equivFun_apply] at h
        exact h.symm.trans (Module.Basis.repr_reindex_apply b₀ _ ξ.symm i)
      have hci : 0 ≤ (c i : ℝ) := he.symm ▸ hn (ξ i)
      exact_mod_cast hci
    · intro hp
      have hn : ∀ i, 0 ≤ φ (c i • (s i).val) := by
        intro i
        rw [map_zsmul, zsmul_eq_mul]
        have hci : 0 ≤ (c i : ℝ) := by exact_mod_cast hp i
        exact mul_nonneg hci (s i).property.1.2.le
      have hsum : 0 ≤ φ (coordinateRoot s c) := by
        rw [coordinateRoot, map_sum]
        exact Finset.sum_nonneg (fun i _ => hn i)
      exact lt_of_le_of_ne hsum (Ne.symm (hφ _ hc))
  · calc
      Module.finrank ℂ H = Module.finrank ℂ (Module.Dual ℂ H) :=
        Subspace.dual_finrank_eq.symm
      _ = Module.finrank ℂ (ℂ ⊗[ℝ] E') := d.complexification.finrank_eq.symm
      _ = Module.finrank ℝ E' := Module.finrank_baseChange
      _ = D.rank := by rw [Module.finrank_eq_card_basis b]; exact Fintype.card_fin _

theorem generated_iff_root (D : Diagram) {L : Type u}
    [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (hφ : Regular H φ)
    (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (c : Root D) :
    Generated (reflect D) (Set.range (unit D)) c ↔ coordinateRoot s c ∈ rootSet_value H := by
  obtain ⟨hinj, hroot, _, _⟩ := coordinateRoot_system D hss H hH φ hφ s hA
  rw [hroot]
  exact ⟨fun h => ⟨c, h, rfl⟩, fun ⟨c', h, he⟩ => hinj he ▸ h⟩

end RootCoordinates

noncomputable section FixedDimensions

open scoped DirectSum

open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature

section Dimension

universe v

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
variable {ι : Type v} [Fintype ι] [DecidableEq ι]

private theorem finrank_of_internal (A : ι → Submodule ℂ L)
    (hA : DirectSum.IsInternal A) :
    Module.finrank ℂ L = ∑ i, Module.finrank ℂ (A i) := by
  let e := LinearEquiv.ofBijective (DirectSum.coeLinearMap A) hA
  exact e.symm.finrank_eq.trans (Module.finrank_directSum ℂ (fun i => A i))

omit [FiniteDimensional ℂ L] [Fintype ι] in
/-- For an involution which acts by a sign on each summand, the complex fixed
submodule is the sum of the summands with sign one. -/
private theorem fixed_eq_iSup_of_signs (a : L ≃ₗ⁅ℂ⁆ L)
    (A : ι → Submodule ℂ L) (hA : DirectSum.IsInternal A) (ε : ι → ℂ)
    (hε : ∀ i, ε i = 1 ∨ ε i = -1)
    (ha : ∀ i x, x ∈ A i → a x = ε i • x) :
    (complexFixed a).toSubmodule = ⨆ i, ⨆ _ : ε i = 1, A i := by
  let T : Submodule ℂ L := ⨆ i, ⨆ _ : ε i = 1, A i
  change (complexFixed a).toSubmodule = T
  apply le_antisymm
  · let P : L →ₗ[ℂ] L := (2 : ℂ)⁻¹ • (LinearMap.id + a.toLinearMap)
    have hP (x : L) : P x = (2 : ℂ)⁻¹ • (x + a x) := rfl
    have htwo : (2 : ℂ) ≠ 0 := by norm_num
    have hle : (⊤ : Submodule ℂ L) ≤ T.comap P := by
      rw [← hA.submodule_iSup_eq_top]
      apply iSup_le
      intro i x hx
      change P x ∈ T
      rw [hP, ha i x hx]
      rcases hε i with hi | hi
      · rw [hi, one_smul, ← two_smul ℂ x, smul_smul, inv_mul_cancel₀ htwo, one_smul]
        exact (le_iSup₂ (f := fun j _ => A j) i hi : A i ≤ T) hx
      · rw [hi, neg_one_smul, add_neg_cancel, smul_zero]
        exact T.zero_mem
    intro x hx
    have hx' : a x = x := hx
    have hp : P x = x := by
      rw [hP, hx', ← two_smul ℂ x, smul_smul, inv_mul_cancel₀ htwo, one_smul]
    have hmem : P x ∈ T := hle Submodule.mem_top
    rwa [hp] at hmem
  · refine iSup_le fun i => iSup_le fun hi x hx => ?_
    change a x = x
    rw [ha i x hx, hi, one_smul]

private theorem finrank_fixed_of_signs (a : L ≃ₗ⁅ℂ⁆ L)
    (A : ι → Submodule ℂ L) (hA : DirectSum.IsInternal A) (ε : ι → ℂ)
    (hε : ∀ i, ε i = 1 ∨ ε i = -1)
    (ha : ∀ i x, x ∈ A i → a x = ε i • x) :
    Module.finrank ℂ (complexFixed a) =
      ∑ i : {i // ε i = 1}, Module.finrank ℂ (A i) := by
  classical
  let S : Set ι := {i | ε i = 1}
  let T : Submodule ℂ L := ⨆ i ∈ S, A i
  have hT : (complexFixed a).toSubmodule = T := fixed_eq_iSup_of_signs a A hA ε hε ha
  change Module.finrank ℂ ((complexFixed a).toSubmodule) = _
  rw [hT]
  have hi : iSupIndep (fun i : S => A i) := hA.submodule_iSupIndep.comp Subtype.val_injective
  have hd : DirectSum.IsInternal (fun i : S => (A i).comap T.subtype) :=
    DirectSum.isInternal_biSup_submodule_of_iSupIndep S hi
  let e := LinearEquiv.ofBijective (DirectSum.coeLinearMap _) hd
  rw [e.symm.finrank_eq, Module.finrank_directSum]
  apply Finset.sum_congr rfl
  intro i _
  exact ((A i).comapSubtypeEquivOfLe (le_iSup₂ (f := fun j _ => A j) i.val i.property : A i ≤ T)).finrank_eq

end Dimension

section RootDimensions


open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.RootDecomposition
open Specs.LieAlgebrasAndRepresentations.VermaModules (Direction)
open Specs.LieAlgebrasAndRepresentations.SerreRelations (simple)
open Specs.LieAlgebrasAndRepresentations.VoganEquivalence (colorSign)
open Specs.LieAlgebrasAndRepresentations.PolarRealStructures (IsCompact involutionConjugation)
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation Intertwines)

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]

/-- The root coordinate correspondence and the signs on the root spaces give
the fixed summands and both complex dimensions. -/
theorem fixed_root_summands_and_dimensions (D : Diagram) (R : Finset (Root D))
    (b : Color D) (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (s : Vertex D ≃ simple H φ)
    (e : R ≃ rootSet_value H)
    (he : ∀ c : R, (e c).val = ∑ i, c.val i • (s i).val)
    (a : L ≃ₗ⁅ℂ⁆ L) (haH : ∀ h : H, a (h : L) = (h : L))
    (ha : ∀ (c : Root D) (x : L), x ∈ rootSpace_value H (∑ i, c i • (s i).val) →
      a x = colorSign (parity D b c) • x) :
    (complexFixed a).toSubmodule =
        H.toSubmodule ⊔ ⨆ (c : R) (_ : parity D b c.val = 0), rootSpace_value H (e c).val ∧
      Module.finrank ℂ L = Module.finrank ℂ H + R.card ∧
      Module.finrank ℂ (complexFixed a) =
        Module.finrank ℂ H + (R.filter (fun c => parity D b c = 0)).card := by
  classical
  let E := R.filter (fun c => parity D b c = 0)
  let : Fintype (rootSet_value H) := (rootSet_finite H hH.1).fintype
  let : DecidableEq (Option (rootSet_value H)) := Classical.decEq _
  let A := rootSummand_value H
  let ε : Option (rootSet_value H) → ℂ := fun i =>
    i.elim 1 fun α => colorSign (parity D b (e.symm α).val)
  have hA : DirectSum.IsInternal A := root_decomposition hss H hH
  have hε (i : Option (rootSet_value H)) : ε i = 1 ∨ ε i = -1 := by
    cases i with
    | none => exact Or.inl rfl
    | some α =>
      change colorSign (parity D b (e.symm α).val) = 1 ∨
        colorSign (parity D b (e.symm α).val) = -1
      unfold colorSign
      split <;> simp
  have hsign (i) (x : L) (hx : x ∈ A i) : a x = ε i • x := by
    cases i with
    | none => simpa [ε] using haH ⟨x, hx⟩
    | some α =>
      have hc := he (e.symm α)
      rw [e.apply_symm_apply] at hc
      exact ha (e.symm α).val x (hc ▸ hx)
  have h1 (α : rootSet_value H) :
      ε (some α) = 1 ↔ parity D b (e.symm α).val = 0 := by
    by_cases h : parity D b (e.symm α).val = 0 <;> norm_num [ε, colorSign, h]
  have hd := finrank_of_internal A hA
  rw [Fintype.sum_option] at hd
  have hroot (α : rootSet_value H) : Module.finrank ℂ (A (some α)) = 1 :=
    finrank_rootSpace_eq_one hss H hH α.val α.property
  have hcard : Fintype.card (rootSet_value H) = R.card :=
    (Fintype.card_congr e).symm.trans (Fintype.card_coe R)
  refine ⟨?_, ?_, ?_⟩
  · rw [fixed_eq_iSup_of_signs a A hA ε hε hsign, iSup_option]
    have heven :
        (⨆ (α : rootSet_value H) (_ : ε (some α) = 1), A (some α)) =
          ⨆ (c : R) (_ : parity D b c.val = 0), rootSpace_value H (e c).val := by
      rw [← e.iSup_comp (g := fun α => ⨆ (_ : ε (some α) = 1), A (some α))]
      congr 1
      funext c
      change (⨆ _ : ε (some (e c)) = 1, rootSpace_value H (e c).val) = _
      rw [h1, e.symm_apply_apply]
    rw [heven, show (⨆ _ : ε none = 1, A none) = H.toSubmodule from by
      simp [A, ε, rootSummand_value]]
  · change Module.finrank ℂ L = Module.finrank ℂ H + _ at hd
    simpa only [hroot, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, hcard, Nat.cast_id] using hd
  · let good := {i : Option (rootSet_value H) // ε i = 1}
    let toGood : Option E → good := fun i => match i with
      | none => ⟨none, rfl⟩
      | some c =>
        have hc := Finset.mem_filter.mp c.property
        ⟨some (e ⟨c.val, hc.1⟩), (h1 _).2 (by simpa using hc.2)⟩
    have hb : Function.Bijective toGood := by
      constructor
      · intro i j hh
        have h' := congrArg Subtype.val hh
        cases i with
        | none =>
          cases j with
          | none => rfl
          | some j => exact False.elim (Option.some_ne_none _ h'.symm)
        | some i =>
          cases j with
          | none => exact False.elim (Option.some_ne_none _ h')
          | some j =>
            apply congrArg some
            apply Subtype.ext
            exact congrArg (fun c : R => c.val) (e.injective (Option.some.inj h'))
      · rintro ⟨i, hi⟩
        cases i with
        | none => exact ⟨none, rfl⟩
        | some α =>
          let c : E := ⟨(e.symm α).val, Finset.mem_filter.mpr ⟨(e.symm α).property, (h1 α).mp hi⟩⟩
          refine ⟨some c, Subtype.ext ?_⟩
          change some (e (e.symm α)) = some α
          rw [e.apply_symm_apply]
    let eg : Option E ≃ good := Equiv.ofBijective toGood hb
    have hf := finrank_fixed_of_signs a A hA ε hε hsign
    change Module.finrank ℂ (complexFixed a) = ∑ i : good, Module.finrank ℂ (A i.val) at hf
    rw [hf, ← eg.sum_comp (fun i : good => Module.finrank ℂ (A i.val)), Fintype.sum_option]
    have hs (c : E) : Module.finrank ℂ (A (eg (some c)).val) = 1 := hroot _
    simp only [hs, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, Fintype.card_coe]
    rfl

/-- The numerical row is the dimension of the complex fixed Lie algebra
and the Killing signature of the associated real form. -/
theorem fixed_row_dimension_and_signature (D : Diagram) (R : Finset (Root D)) (r : Row)
    (hrow : rowRootCheck D r R)
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (hRank : Module.finrank ℂ H = D.rank)
    (φ : Direction H) (s : Vertex D ≃ simple H φ)
    (e : R ≃ rootSet_value H)
    (he : ∀ c : R, (e c).val = ∑ i, c.val i • (s i).val)
    (ω : Conjugation L) (hcompact : IsCompact ω)
    (a : L ≃ₗ⁅ℂ⁆ L) (hcomm : Intertwines ω ω a) (hinv : Function.Involutive a)
    (haH : ∀ h : H, a (h : L) = (h : L))
    (ha : ∀ (c : Root D) (x : L), x ∈ rootSpace_value H (∑ i, c i • (s i).val) →
      a x = colorSign (parity D (colorAt D r.mask) c) • x) :
    Module.finrank ℂ (complexFixed a) = r.dimension ∧
      killingSignature (involutionConjugation ω a hcomm hinv).fixed = r.signature := by
  obtain ⟨_, hL, hK⟩ :=
    fixed_root_summands_and_dimensions D R (colorAt D r.mask) hss H hH φ s e he a haH ha
  have hd := hK.trans ((congrArg (· + _) hRank).trans hrow.1.symm)
  refine ⟨hd, ?_⟩
  have hsig : killingSignature (involutionConjugation ω a hcomm hinv).fixed =
      (Module.finrank ℂ L : ℤ) - 2 * (Module.finrank ℂ (complexFixed a) : ℤ) :=
    _root_.LieAlgebrasAndRepresentations.CartanDecompositionSignature.killing_signature
      ω a hcomm hinv hcompact
  rw [hsig, hd, hL, hRank]
  simpa only [Nat.cast_add] using hrow.2.1.symm

end RootDimensions

end FixedDimensions

noncomputable section FixedIdentification

