variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]

/-- The complex fixed algebra has the indicated semisimple Serre algebra
and its actual center, with the center dimension specified by the row. -/
private theorem fixed_type_of_rowRootCheck (D : Diagram) (R : Finset (Root D)) (r : Row)
    (hr : r ∈ rows D) (hrow : rowRootCheck D r R)
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (hφ : Regular H φ) (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (hR : ∀ c, c ∈ R ↔ Generated (reflect D) (Set.range (unit D)) c)
    (ω : Conjugation L) (hc : IsCompact ω)
    (a : L ≃ₗ⁅ℂ⁆ L) (hcomm : Intertwines ω ω a)
    (haH : ∀ h : H, a (h : L) = (h : L))
    (ha : ∀ (c : Root D) (x : L), x ∈ rootSpace_value H (coordinateRoot s c) →
      a x = colorSign (parity D (colorAt D r.mask) c) • x) :
    Nonempty ((Serre.Algebra r.matrix × LieAlgebra.center ℂ (complexFixed a))
        ≃ₗ⁅ℂ⁆ complexFixed a) ∧
      Module.finrank ℂ (LieAlgebra.center ℂ (complexFixed a)) = r.center := by
  classical
  obtain ⟨hinj, hsys, hpos, hRank⟩ := coordinateRoot_system D hss H hH φ hφ s hA
  have hmem (c : Root D) : coordinateRoot s c ∈ rootSet_value H ↔ c ∈ R := by
    rw [hR, hsys]
    exact ⟨fun ⟨z, hz, he⟩ => hinj he ▸ hz, fun hc => ⟨c, hc, rfl⟩⟩
  have hfix : H ≤ complexFixed a := fun x hx => haH ⟨x, hx⟩
  obtain ⟨S, hS, hCompl⟩ :=
    (ReductiveDecomposition.reductive_iff ℂ (complexFixed a)).mp
      (complex_fixed_reductive ω a hcomm hc)
  obtain ⟨p, hp⟩ := ReductiveDecomposition.center_direct_sum ℂ (complexFixed a) S hCompl
  let U := semisimpleCartan a H hfix S
  let π := project_fixed_cartan a H hfix S p hp hss hH
  let t := include_fixed_cartan a H hfix S
  have hπ : Function.LeftInverse π t :=
    project_fixed_cartan_leftInverse a H hfix S p hp hss hH
  have hU : MaximalTori.IsMaximalToral_value U :=
    semisimple_fixed_cartan_isMaximalToral a H hfix S p hp hss hH
  let F : Root D →+ Module.Dual ℂ H :=
    { toFun := coordinateRoot s
      map_zero' := by simp [coordinateRoot]
      map_add' := fun x y => by simp [coordinateRoot, add_zsmul, Finset.sum_add_distrib] }
  let G' : Module.Dual ℂ U →ₗ[ℂ] Module.Dual ℂ H := LinearMap.lcomp ℂ ℂ π
  let G := G'.toAddMonoidHom
  have hG : Function.Injective G := by
    intro β γ hβγ
    ext x
    have he := congrArg (fun a : Module.Dual ℂ H => a (t x)) hβγ
    change β (π (t x)) = γ (π (t x)) at he
    simpa only [hπ x] using he
  let ψ : Direction U := φ.comp (G'.restrictScalars ℝ)
  have hψ (β : Module.Dual ℂ U) : ψ β = φ (G β) := rfl
  have hroots (α : Module.Dual ℂ H) :
      (∃ β ∈ rootSet U, G β = α) ↔
        (∃ c ∈ R, parity D (colorAt D r.mask) c = 0 ∧ F c = α) := by
    have hrt := semisimple_root_iff_fixed a H hfix S p hp hss hH α
    change (∃ β : rootSet U, G β.val = α) ↔ _ at hrt
    constructor
    · rintro ⟨β, hβ, hβα⟩
      obtain ⟨hα, hαa⟩ := hrt.mp ⟨⟨β, hβ⟩, hβα⟩
      obtain ⟨c, hgen, rfl⟩ := (hsys α).mp hα
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hα.2
      have hsgn : colorSign (parity D (colorAt D r.mask) c) = 1 := by
        apply smul_left_injective ℂ hx0
        change colorSign (parity D (colorAt D r.mask) c) • x = (1 : ℂ) • x
        exact (ha c x hx).symm.trans ((hαa x hx).trans (one_smul ℂ x).symm)
      have hce : parity D (colorAt D r.mask) c = 0 := by
        by_contra hn
        norm_num [colorSign, hn] at hsgn
      exact ⟨c, (hR c).2 hgen, hce, rfl⟩
    · rintro ⟨c, hc, hce, hFc⟩
      change coordinateRoot s c = α at hFc
      subst α
      have hfixed (x : L) (hx : x ∈ rootSpace_value H (coordinateRoot s c)) : a x = x := by
        simp [ha c x hx, hce, colorSign]
      obtain ⟨β, hβ⟩ := hrt.mpr ⟨(hmem c).2 hc, hfixed⟩
      exact ⟨β.val, β.property, hβ⟩
  have hψreg : Regular U ψ := by
    intro β hβ
    have hβ' := semisimple_fixed_root_mem a H hfix S p hp hss hH β hβ
    exact hφ (G β) hβ'
  have hsimp (β : Module.Dual ℂ U) :
      β ∈ simple U ψ ↔ ∃ c ∈ simpleEven D (colorAt D r.mask) R, F c = G β :=
    simple_even_coordinates H U ψ φ (colorAt D r.mask) R F G hinj hG hroots
      (fun c hc => hpos c ((hmem c).2 hc)) hψ β
  obtain ⟨base, hbase, hbaseIm, hnorm, hgram⟩ := hrow.2.2.2
  have hBaseMem (i : Fin r.fixedRank) : base i ∈ simpleEven D (colorAt D r.mask) R := by
    rw [← hbaseIm]
    exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  have hRootMem (i : Fin r.fixedRank) :
      base i ∈ R ∧ parity D (colorAt D r.mask) (base i) = 0 := by
    have hp := (Finset.mem_filter.mp (hBaseMem i)).1
    exact ⟨(Finset.mem_filter.mp hp).1, (Finset.mem_filter.mp hp).2.1⟩
  have heb (i : Fin r.fixedRank) : ∃ β : simple U ψ, G β.val = F (base i) := by
    obtain ⟨β, hβ, he⟩ := (hroots (F (base i))).mpr
      ⟨base i, (hRootMem i).1, (hRootMem i).2, rfl⟩
    exact ⟨⟨β, (hsimp β).mpr ⟨base i, hBaseMem i, he.symm⟩⟩, he⟩
  choose bs hbs using heb
  have hBij : Function.Bijective bs := by
    constructor
    · intro i j hij
      apply hbase
      apply hinj
      change F (base i) = F (base j)
      rw [← hbs i, ← hbs j, hij]
    · intro β
      obtain ⟨c, hc, he⟩ := (hsimp β.val).mp β.property
      rw [← hbaseIm] at hc
      obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hc
      exact ⟨i, Subtype.ext (hG ((hbs i).trans he))⟩
  let e := Equiv.ofBijective bs hBij
  have hbPair (i j : Fin r.fixedRank) :
      (e j).val (coroot_value U (e i).val) = (r.matrix i j : ℂ) := by
    have hbi := hbs i
    have hbj := hbs j
    change G (e i).val = coordinateRoot s (base i) at hbi
    change G (e j).val = coordinateRoot s (base j) at hbj
    have hco := fixed_coroot_eq a H hfix S p hp hss hH hS (e i).val (e i).property.1.1
    change t (coroot_value U (e i).val) = coroot_value H (G (e i).val) at hco
    have heval : (e j).val (coroot_value U (e i).val) =
        G (e j).val (t (coroot_value U (e i).val)) := by
      change _ = (e j).val (π (t _))
      rw [hπ]
    rw [heval, hco, hbi, hbj]
    exact coordinateRoot_cartan_entry D hss H hH φ s hA
      (base i) (base j) (r.matrix i j) (hnorm i) (hgram i j)
  obtain ⟨⟨g⟩, hUrank⟩ := serre_type_of_simple_cartan D r hr hS U hU ψ hψreg e hbPair
  have hsplit := (fixed_cartan_split a H hfix S p hp hss hH).finrank_eq
  have hZ : Module.finrank ℂ (fixedCenter a) = r.center := by
    change Module.finrank ℂ H = Module.finrank ℂ (U × fixedCenter a) at hsplit
    rw [Module.finrank_prod, hRank, hUrank] at hsplit
    have hcenter := hrow.2.2.1
    omega
  let product : (Serre.Algebra r.matrix × fixedCenter a) →ₗ⁅ℂ⁆ (S × fixedCenter a) :=
    g.toLieHom.prodMap LieHom.id
  let productEquiv := LieEquiv.ofBijective product
    (show Function.Bijective (Prod.map g (id : fixedCenter a → fixedCenter a)) from
      g.bijective.prodMap Function.bijective_id)
  exact ⟨⟨productEquiv.trans p⟩, hZ⟩


