private theorem row_cartan_conditions (D : Diagram) (r : Row) (hr : r ∈ rows D) :
    CartanConditions r.matrix := by
  have h :
      (∀ i, r.matrix i i = 2) ∧
      (∀ p : Fin r.fixedRank × Fin r.fixedRank, p.1 ≠ p.2 → r.matrix p.1 p.2 ≤ 0) ∧
      (∀ p : Fin r.fixedRank × Fin r.fixedRank, r.matrix p.1 p.2 = 0 ↔ r.matrix p.2 p.1 = 0) := by
    cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr
    all_goals
      rcases hr with rfl | rfl | rfl | rfl <;>
        exact ⟨by decide, by decide, by decide⟩
  exact ⟨h.1, fun i j => h.2.1 (i, j), fun i j => h.2.2 (i, j)⟩

private theorem serre_type_of_simple_cartan {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] (D : Diagram) (r : Row) (hr : r ∈ rows D)
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (U : LieSubalgebra ℂ L) (hU : MaximalTori.IsMaximalToral_value U)
    (ψ : Direction U) (hψ : Regular U ψ)
    (p : Fin r.fixedRank ≃ simple U ψ)
    (hp : ∀ i j, (p j).val (coroot_value U (p i).val) = (r.matrix i j : ℂ)) :
    Nonempty (Serre.Algebra r.matrix ≃ₗ⁅ℂ⁆ L) ∧ Module.finrank ℂ U = r.fixedRank := by
  classical
  let : Fintype (simple U ψ) := Fintype.ofEquiv (Fin r.fixedRank) p
  have hn (j : simple U ψ) :=
    exists_root_triple hss U hU j.val j.property.1.1
  choose E F hEF using hn
  have hN : Specs.LieAlgebrasAndRepresentations.Reconstruction.NormalizedSimpleVectors U ψ E F :=
    fun i => ⟨(hEF i).1, (hEF i).2.1, (hEF i).2.2.1, (hEF i).2.2.2.1,
      (hEF i).2.2.2.2.1⟩
  obtain ⟨A, g, hA, _, hmap⟩ := serre_reconstruction hss U hU ψ hψ E F hN
  have hrel (i j) : A (p i) (p j) = r.matrix i j := by
    exact Int.cast_injective (α := ℂ) ((hA _ _).symm.trans (hp i j))
  have hrow := row_cartan_conditions D r hr
  have hcond : CartanConditions A := by
    refine ⟨?_, ?_, ?_⟩
    · intro i
      obtain ⟨i, rfl⟩ := p.surjective i
      rw [hrel, hrow.1]
    · intro i j hij
      obtain ⟨i, rfl⟩ := p.surjective i
      obtain ⟨j, rfl⟩ := p.surjective j
      rw [hrel]
      exact hrow.2.1 i j (fun h => hij (congrArg p h))
    · intro i j
      obtain ⟨i, rfl⟩ := p.surjective i
      obtain ⟨j, rfl⟩ := p.surjective j
      rw [hrel, hrel]
      exact hrow.2.2 i j
  refine ⟨⟨(serre_reindex r.matrix A p hrel hrow.2.1).trans g⟩, ?_⟩
  have hdim := g.toLinearEquiv.finrank_map_eq (Serre.cartan A)
  rw [hmap, Serre.cartan_finrank A hcond] at hdim
  exact hdim.trans ((Fintype.card_congr p).symm.trans (Fintype.card_fin _))

