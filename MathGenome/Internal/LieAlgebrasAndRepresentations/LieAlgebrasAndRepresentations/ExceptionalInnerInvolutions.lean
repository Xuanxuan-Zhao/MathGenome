/-- A breadth-first search certificate for the simple-root reflection closure.
The predecessor precedes its node in the array. The outgoing indices are in
source vertex order. Both fields are checked against the reflection formula. -/
private structure RootNode (D : Diagram) where
  coords : Root D
  predecessor : Option (ℕ × Vertex D)
  outgoing : Vertex D → ℕ

private instance (D : Diagram) : Inhabited (RootNode D) := ⟨⟨0, none, fun _ => 0⟩⟩

