private def rootAt (D : Diagram) (n : ℕ) : RootNode D := (rootNodes D).getD n default

private def rootList (D : Diagram) : List (Root D) := (rootNodes D).toList.map (·.coords)

private theorem rootList_nodup (D : Diagram) : (rootList D).Nodup := by
  cases D <;> decide +kernel

private def roots (D : Diagram) : Finset (Root D) :=
  ⟨↑(rootList D), rootList_nodup D⟩

private theorem rootAt_mem_iff (D : Diagram) (c : Root D) :
    c ∈ roots D ↔ ∃ n : ℕ, n < (rootNodes D).size ∧ (rootAt D n).coords = c := by
  change c ∈ rootList D ↔ _
  simp only [rootList, List.mem_iff_getElem, List.length_map, List.getElem_map,
    Array.length_toList, Array.getElem_toList]
  constructor
  · rintro ⟨n, hn, rfl⟩
    exact ⟨n, hn, by simp [rootAt, Array.getD, hn]⟩
  · rintro ⟨n, hn, rfl⟩
    exact ⟨n, hn, by simp [rootAt, Array.getD, hn]⟩

private theorem seed_checked (D : Diagram) :
    ∀ i : Vertex D, (i : ℕ) < (rootNodes D).size ∧ (rootAt D i).coords = unit D i := by
  cases D <;> decide +kernel

private def checkRootNode (D : Diagram) (n : Fin (rootNodes D).size) : Prop :=
  let x := rootAt D n
  (match x.predecessor with
    | none => ∃ i : Vertex D, x.coords = unit D i
    | some (m, i) => m < (n : ℕ) ∧ reflect D i (rootAt D m).coords = x.coords) ∧
  (∀ i : Vertex D, x.outgoing i < (rootNodes D).size ∧
    reflect D i x.coords = (rootAt D (x.outgoing i)).coords)

private instance (D : Diagram) (n : Fin (rootNodes D).size) :
    Decidable (checkRootNode D n) := by
  unfold checkRootNode
  dsimp only
  split <;> infer_instance

private theorem nodes_checked (D : Diagram) : ∀ n, checkRootNode D n := by
  cases D <;> decide +kernel

private theorem rootAt_generated (D : Diagram) (n : ℕ) (hn : n < (rootNodes D).size) :
    Generated (reflect D) (Set.range (unit D)) (rootAt D n).coords := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    have h := (nodes_checked D ⟨n, hn⟩).1
    dsimp only at h
    cases he : (rootAt D n).predecessor with
    | none =>
      simp only [he] at h
      obtain ⟨i, hi⟩ := h
      exact Generated.initial ⟨i, hi.symm⟩
    | some p =>
      rcases p with ⟨m, i⟩
      simp only [he] at h
      obtain ⟨hm, hh⟩ := h
      rw [← hh]
      exact Generated.next i (ih m hm (hm.trans hn))

private theorem root_mem (D : Diagram) (c : Root D) :
    c ∈ roots D ↔ Generated (reflect D) (Set.range (unit D)) c := by
  refine ⟨?_, fun h => ?_⟩
  · intro h
    obtain ⟨i, hi, rfl⟩ := (rootAt_mem_iff D c).mp h
    exact rootAt_generated D i hi
  · induction h with
    | initial h =>
      obtain ⟨i, rfl⟩ := h
      exact (rootAt_mem_iff D _).mpr ⟨i, (seed_checked D i).1, (seed_checked D i).2⟩
    | next i _ ih =>
      obtain ⟨n, hn, rfl⟩ := (rootAt_mem_iff D _).mp ih
      have h := (nodes_checked D ⟨n, hn⟩).2 i
      exact (rootAt_mem_iff D _).mpr ⟨_, h.1, h.2.symm⟩

