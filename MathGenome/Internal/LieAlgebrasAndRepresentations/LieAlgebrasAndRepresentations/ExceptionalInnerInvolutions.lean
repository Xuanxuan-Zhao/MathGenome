/-- The computed moves act on the actual sign characters of the root lattice.
The inverse diagram permutation accounts for the pullback convention on signs. -/
theorem exists_rootTransport_of_colorOrbit
    (D : Diagram) {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (hφ : Regular H φ)
    (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (χ ψ : SignCharacter H) (b c : Color D)
    (hχ : ∀ i, χ (latticeSimple (s i)) = b i)
    (hψ : ∀ i, ψ (latticeSimple (s i)) = c i)
    (horb : ColorOrbit D b c) :
    ∃ r : RootIsom H H, transportCharacter r χ = ψ := by
  obtain ⟨lift, hlift⟩ := positiveRootStabilizerIsDynkin hss H hH φ hφ
  have hMove : ∃ g : rootAutomorphisms H,
      ∀ i, (g • χ) (latticeSimple (s i)) = c i := by
    clear hψ ψ
    induction horb with
    | initial => exact ⟨1, by simpa using hχ⟩
    | reflection i _ ih =>
      obtain ⟨g, hg⟩ := ih
      let A : Matrix (simple H φ) (simple H φ) ℤ := fun j k => cartan D (s.symm j) (s.symm k)
      have hA' (j : simple H φ) : j.val (coroot_value H (s i).val) = (A (s i) j : ℂ) := by
        simpa [A] using hA i (s.symm j)
      obtain ⟨r, _, hr⟩ := innerReflection hss H hH φ A (s i) hA'
      let k : rootAutomorphisms H := ⟨r.linear, r.roots, r.pairing⟩
      refine ⟨k * g, fun j => ?_⟩
      rw [mul_smul]
      change transportCharacter r (g • χ) (latticeSimple (s j)) = _
      rw [hr]
      simp only [reflectedColors, A, Equiv.symm_apply_apply, hg]
    | diagram p hp _ ih =>
      obtain ⟨g, hg⟩ := ih
      have hps (i j : Vertex D) :
          cartan D (p.symm i) (p.symm j) = cartan D i j := by
        simpa using (hp (p.symm i) (p.symm j)).symm
      let q : Equiv.Perm (simple H φ) := s.symm.trans (p.symm.trans s)
      have hq : q ∈ diagramAutomorphisms H φ := by
        intro i j
        obtain ⟨i, rfl⟩ := s.surjective i
        obtain ⟨j, rfl⟩ := s.surjective j
        simp only [q, Equiv.trans_apply, Equiv.symm_apply_apply, hA, hps]
      let k := lift.symm ⟨q, hq⟩
      have hforward (i : Vertex D) : k.val.val (s (p i)).val = (s i).val := by
        have h := hlift k (s (p i))
        have he : lift k = ⟨q, hq⟩ := lift.apply_symm_apply _
        rw [he] at h
        simpa [q] using h.symm
      have hback (i : Vertex D) :
          (latticeTransport (asRootIsom H k.val)).symm (latticeSimple (s i)) =
            latticeSimple (s (p i)) := by
        apply Subtype.ext
        change k.val.val.symm (s i).val = (s (p i)).val
        rw [← hforward i, k.val.val.symm_apply_apply]
      refine ⟨k.val * g, fun i => ?_⟩
      rw [mul_smul]
      change (g • χ) ((latticeTransport (asRootIsom H k.val)).symm
        (latticeSimple (s i))) = _
      rw [hback, hg]
      rfl
  obtain ⟨g, hg⟩ := hMove
  obtain ⟨e, he⟩ := signCharacterCoordinates hss H hH φ hφ
  refine ⟨asRootIsom H g, e.injective ?_⟩
  funext j
  obtain ⟨i, rfl⟩ := s.surjective j
  rw [he, he]
  exact (hg i).trans (hψ i).symm

private theorem colorSign_injective : Function.Injective colorSign := by
  have hc : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
  intro b c h
  rcases hc b with rfl | rfl <;> rcases hc c with rfl | rfl <;> norm_num [colorSign] at *

/-- For normalized compact data on the same Cartan, the finite orbit
relation implies isomorphism of the actual associated real forms. -/
theorem innerForms_isomorphic_of_colorOrbit
    (D : Diagram) {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (hω : IsCompact ω)
    (a a' : L ≃ₗ⁅ℂ⁆ L)
    (ha : Function.Involutive a) (ha' : Function.Involutive a')
    (hwa : Intertwines ω ω a) (hwa' : Intertwines ω ω a')
    (H : LieSubalgebra ℂ L) (hH : StableCartan ω a H) (hH' : StableCartan ω a' H)
    (haH : ∀ h : H, a (h : L) = (h : L))
    (haH' : ∀ h : H, a' (h : L) = (h : L))
    (φ : Direction H) (hφ : Regular H φ)
    (e f : simple H φ → L) (hN : Normalized H φ e f) (hw : ∀ i, ω.map (e i) = -f i)
    (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (b c : Color D)
    (hb : ∀ i, a (e (s i)) = colorSign (b i) • e (s i))
    (hc : ∀ i, a' (e (s i)) = colorSign (c i) • e (s i))
    (horb : ColorOrbit D b c) :
    Nonempty ((involutionConjugation ω a hwa ha).fixed ≃ₗ⁅ℝ⁆
      (involutionConjugation ω a' hwa' ha').fixed) := by
  have hChar := (innerCharacters hss ω H hH.toral hH.compact_stable φ hφ e f hN hw).1
  obtain ⟨χ, hχ, _⟩ := hChar a hwa ha haH
  obtain ⟨ψ, hψ, _⟩ := hChar a' hwa' ha' haH'
  have hsign (g : L ≃ₗ⁅ℂ⁆ L) (η : SignCharacter H) (hη : RealizesCharacter H g η)
      (m : Color D) (hm : ∀ i, g (e (s i)) = colorSign (m i) • e (s i))
      (i : Vertex D) : η (latticeSimple (s i)) = m i := by
    apply colorSign_injective
    apply smul_left_injective ℂ (hN (s i)).2.2.1
    exact (hη ⟨(s i).val, (s i).property.1.1⟩ (e (s i)) (hN (s i)).1).symm.trans (hm i)
  apply (innerCharacterOrbit hss ω hω a a' ha ha' hwa hwa' H H hH hH' haH haH' φ hφ χ ψ hχ hψ).2
  exact exists_rootTransport_of_colorOrbit D hss H hH.toral
    φ hφ s hA χ ψ b c (hsign a χ hχ b hb) (hsign a' ψ hψ c hc) horb

end ColorTransport

section ColorRealization

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation Intertwines)
open IntegrableHighestWeightQuotient (Normalized)
open RootDecomposition (rootSet_value)
open SerreRelations (simple)
open VermaModules (Direction Regular)


/-- For each binary coloring the compact pinning has a sign involution
fixing the Cartan, acting with the specified sign on both root generators. -/
theorem exists_innerInvolution_of_color
    (D : Diagram) {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (H : LieSubalgebra ℂ L)
    (hH : MaximalTori.IsMaximalToral_value H) (hwH : ∀ x ∈ H, ω.map x ∈ H)
    (φ : Direction H) (hφ : Regular H φ)
    (e f : simple H φ → L) (hN : Normalized H φ e f) (hw : ∀ i, ω.map (e i) = -f i)
    (s : Vertex D ≃ simple H φ) (b : Color D) :
    ∃ a : L ≃ₗ⁅ℂ⁆ L, Intertwines ω ω a ∧ Function.Involutive a ∧
      (∀ h : H, a (h : L) = (h : L)) ∧
      ∀ i, a (e (s i)) = colorSign (b i) • e (s i) ∧
        a (f (s i)) = colorSign (b i) • f (s i) := by
  obtain ⟨v, hv⟩ := signCharacterCoordinates hss H hH φ hφ
  let χ : SignCharacter H := v.symm (b ∘ s.symm)
  have hχ (i : Vertex D) : χ (latticeSimple (s i)) = b i := by
    rw [← hv]
    change v (v.symm (b ∘ s.symm)) (s i) = b i
    rw [v.apply_symm_apply]
    simp only [Function.comp_apply, Equiv.symm_apply_apply]
  obtain ⟨a, ⟨ha, hainv, haH, hact⟩, _⟩ := (innerCharacters hss ω H hH hwH φ hφ e f hN hw).2 χ
  refine ⟨a, ha, hainv, haH, fun i => ?_⟩
  let r : rootSet_value H := ⟨(s i).val, (s i).property.1.1⟩
  have hneg : -r.val ∈ rootSet_value H := by
    refine ⟨neg_ne_zero.mpr r.property.1, ?_⟩
    intro hc
    exact (hN (s i)).2.2.2.1 ((Submodule.mem_bot ℂ).1 (hc ▸ (hN (s i)).2.1))
  let r' : rootSet_value H := ⟨-r.val, hneg⟩
  have hrel : latticeRoot r' = -latticeSimple (s i) := Subtype.ext rfl
  have hχ' : χ (latticeRoot r') = b i := by
    rw [hrel, map_neg, ZMod.neg_eq_self_mod_two, hχ]
  constructor
  · have he := hact r (e (s i)) (hN (s i)).1
    change a (e (s i)) = colorSign (χ (latticeSimple (s i))) • e (s i) at he
    rwa [hχ] at he
  · simpa only [hχ'] using hact r' (f (s i)) (hN (s i)).2.1

end ColorRealization

section StableCartan

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.StableCartanVoganData
open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed)
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation)
open private maximalToral_isCartan from MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.RootTriples


/-- A compact-stable maximal torus fixed pointwise by the automorphism is a
stable Cartan with all roots nonvanishing on its fixed part. -/
theorem stableCartan_of_fixes_torus {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (a : L ≃ₗ⁅ℂ⁆ L) (H : LieSubalgebra ℂ L)
    (hH : MaximalTori.IsMaximalToral_value H) (hwH : ∀ x ∈ H, ω.map x ∈ H)
    (haH : ∀ h : H, a (h : L) = (h : L)) : StableCartan ω a H := by
  have hcart := maximalToral_isCartan hss H hH
  have hfixed : (fixedCartan a H).IsCartanSubalgebra := by
    let K := fixedCartan a H
    let : IsLieAbelian H := hH.1.1
    let : IsLieAbelian K := ⟨fun x y => Subtype.ext (Subtype.ext
      (congrArg (fun t : H => (t : L)) (trivial_lie_zero H H
        ⟨((x : complexFixed a) : L), x.property⟩
        ⟨((y : complexFixed a) : L), y.property⟩)))⟩
    refine ⟨inferInstance, le_antisymm ?_ K.le_normalizer⟩
    intro x hx
    change (x : L) ∈ H
    rw [← hcart.self_normalizing]
    refine (H.mem_normalizer_iff _).2 fun y hy => ?_
    let y' : complexFixed a := ⟨y, haH ⟨y, hy⟩⟩
    exact (K.mem_normalizer_iff _).1 hx y' hy
  have hE (r : ℂ) (x : H) :
      x ∈ cartanEigenspace a H r ↔ a (x : L) = r • (x : L) := by
    change a (x : L) - r • (x : L) = 0 ↔ _
    exact sub_eq_zero
  have hplus : cartanEigenspace a H 1 = ⊤ := by
    apply top_unique
    intro x _
    exact (hE _ x).2 (by simpa using haH x)
  have hminus : cartanEigenspace a H (-1) = ⊥ := by
    apply le_antisymm _ bot_le
    intro x hx
    have h := (haH x).symm.trans ((hE _ x).1 hx)
    rw [neg_smul, one_smul] at h
    have htwo : (2 : ℂ) • (x : L) = 0 := by
      rw [two_smul]
      exact add_eq_zero_iff_eq_neg.2 h
    exact (Submodule.mem_bot ℂ).2 (Subtype.ext ((smul_eq_zero.mp htwo).resolve_left two_ne_zero))
  refine ⟨hH, hcart, fun x hx => haH ⟨x, hx⟩ ▸ hx, hwH, hfixed, ?_, ?_⟩
  · rw [hplus, hminus]
    exact isCompl_top_bot
  · intro α hα
    have hn : ∃ h : H, α h ≠ 0 := by
      by_contra! h
      exact hα.1 (LinearMap.ext h)
    obtain ⟨h, hn⟩ := hn
    exact ⟨h, haH h, hn⟩

end StableCartan

section InnerMembership

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open Specs.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation Intertwines)
open IntegrableHighestWeightQuotient (Normalized)
open RootDecomposition (rootSet_value)
open SerreRelations (simple)
open VermaModules (Direction Regular)


/-- Pointwise Cartan fixation for compact pinning is realized by an
adjoint exponential, so the resulting complex automorphism is inner. -/
theorem inner_of_fixes_torus
    {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (H : LieSubalgebra ℂ L)
    (hH : MaximalTori.IsMaximalToral_value H) (hwH : ∀ x ∈ H, ω.map x ∈ H)
    (φ : Direction H) (hφ : Regular H φ)
    (e f : simple H φ → L) (hN : Normalized H φ e f) (hw : ∀ i, ω.map (e i) = -f i)
    (a : L ≃ₗ⁅ℂ⁆ L) (haω : Intertwines ω ω a)
    (haH : ∀ h : H, a (h : L) = (h : L)) :
    a.toLinearEquiv ∈ CartanConjugacy.innerAutomorphisms_value L := by
  obtain ⟨h, _, ha⟩ := (torusKernel hss ω H hH hwH φ hφ e f hN hw a).mp ⟨haω, haH⟩
  exact Subgroup.subset_closure ⟨(h : L), ha⟩

end InnerMembership

section FixedSeparation

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed)
open Specs.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.VoganEquivalence
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation Intertwines)
open PolarRealStructures (IsCompact involutionConjugation)
open StableCartanVoganData (StableCartan)


/-- An ambient intertwiner restricts to a Lie equivalence of the fixed algebras. -/
def complexFixedEquivOfConjugation {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    (a b g : L ≃ₗ⁅ℂ⁆ L) (hg : ∀ x, b (g x) = g (a x)) :
    complexFixed a ≃ₗ⁅ℂ⁆ complexFixed b := by
  have hmap : (complexFixed a).map g.toLieHom = complexFixed b := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change a y = y at hy
      change b (g y) = g y
      rw [hg, hy]
    · intro hx
      change b x = x at hx
      refine ⟨g.symm x, ?_, g.apply_symm_apply x⟩
      change a (g.symm x) = g.symm x
      apply g.injective
      change g (a (g.symm x)) = g (g.symm x)
      rw [← hg, g.apply_symm_apply, hx]
  exact g.ofSubalgebras (complexFixed a) (complexFixed b) hmap

theorem finrank_complexFixed_eq_of_conjugation {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    (a b g : L ≃ₗ⁅ℂ⁆ L) (hg : ∀ x, b (g x) = g (a x)) :
    Module.finrank ℂ (complexFixed a) = Module.finrank ℂ (complexFixed b) :=
  (complexFixedEquivOfConjugation a b g hg).toLinearEquiv.finrank_eq

/-- Distinct fixed dimensions separate the corresponding real forms. -/
theorem not_realForm_equiv_of_fixed_dimension_ne
    {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (hω : IsCompact ω)
    (a b : L ≃ₗ⁅ℂ⁆ L) (ha : Function.Involutive a) (hb : Function.Involutive b)
    (hwa : Intertwines ω ω a) (hwb : Intertwines ω ω b)
    (H K : LieSubalgebra ℂ L) (hH : StableCartan ω a H) (hK : StableCartan ω b K)
    (hDim : Module.finrank ℂ (complexFixed a) ≠ Module.finrank ℂ (complexFixed b)) :
    ¬ Nonempty ((involutionConjugation ω a hwa ha).fixed ≃ₗ⁅ℝ⁆
      (involutionConjugation ω b hwb hb).fixed) := by
  intro hi
  obtain ⟨g, _, hg, _⟩ := (realFormsIffCartanConjugates hss ω hω a b ha hb hwa hwb H K hH hK).1 hi
  exact hDim (finrank_complexFixed_eq_of_conjugation a b g hg)

end FixedSeparation

section RowRepresentatives

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed)
open Specs.LieAlgebrasAndRepresentations.PolarRealStructures (IsCompact involutionConjugation)
open _root_.LieAlgebrasAndRepresentations.RealForms (Conjugation Intertwines)
open IntegrableHighestWeightQuotient (Normalized)
open RootForm (coroot_value)
open SerreRelations (simple)
open VermaModules (Direction Regular)

/-- Every normalized inner datum on the numbered Cartan is represented
by a sign involution from the table, with the asserted type and signature. -/
theorem inner_datum_has_representative
    (D : Diagram) {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (H : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (φ : Direction H) (hφ : Regular H φ) (s : Vertex D ≃ simple H φ)
    (hA : ∀ i j, (s j).val (coroot_value H (s i).val) = (cartan D i j : ℂ))
    (ω : Conjugation L) (hω : IsCompact ω) (hwH : ∀ h ∈ H, ω.map h ∈ H)
    (e f : simple H φ → L) (hN : Normalized H φ e f)
    (hw : ∀ i, ω.map (e i) = -f i)
    (a : L ≃ₗ⁅ℂ⁆ L) (hcomm : Intertwines ω ω a) (hinv : Function.Involutive a)
    (haH : ∀ h : H, a (h : L) = (h : L))
    (b : Color D) (ha : ∀ i, a (e (s i)) = colorSign (b i) • e (s i)) :
    ∃ r ∈ rows D, ColorOrbit D (colorAt D r.mask) b ∧
      ∃ (g : L ≃ₗ⁅ℂ⁆ L) (hg : Intertwines ω ω g) (hgi : Function.Involutive g),
        g.toLinearEquiv ∈ CartanConjugacy.innerAutomorphisms_value L ∧
        Nonempty ((involutionConjugation ω g hg hgi).fixed ≃ₗ⁅ℝ⁆
          (involutionConjugation ω a hcomm hinv).fixed) ∧
        FixedRow r ω g hg hgi := by
  obtain ⟨r, hr, hb⟩ := colors_cover D b
  have horb := orbit_sound D r hr hb
  obtain ⟨g, hg, hgi, hgH, hsign⟩ := exists_innerInvolution_of_color D hss ω H hH hwH φ hφ e f hN hw s (colorAt D r.mask)
  refine ⟨r, hr, horb, g, hg, hgi, ?_, ?_, ?_⟩
  · exact inner_of_fixes_torus hss ω H hH hwH φ hφ e f hN hw g hg hgH
  · exact innerForms_isomorphic_of_colorOrbit D hss ω hω g a hgi hinv hg hcomm H
      (stableCartan_of_fixes_torus hss ω g H hH hwH hgH)
      (stableCartan_of_fixes_torus hss ω a H hH hwH haH)
      hgH haH φ hφ e f hN hw s hA (colorAt D r.mask) b (fun i => (hsign i).1) ha horb
  · exact fixed_row_of_inner_datum D r hr hss H hH φ hφ s hA ω hω hwH
      e f hN hw g hg hgi hgH hsign

/-- The real forms attached to distinct rows of one exceptional type are
nonisomorphic. The fixed dimensions are invariants of the actual conjugacy. -/
theorem distinct_fixed_rows_nonisomorphic
    (D : Diagram) (r r' : Row) (hr : r ∈ rows D) (hr' : r' ∈ rows D)
    (hrow : r.mask ≠ r'.mask)
    {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (hss : SolvableRadical.IsSemisimple_value ℂ L)
    (ω : Conjugation L) (hω : IsCompact ω)
    (a a' : L ≃ₗ⁅ℂ⁆ L)
    (ha : Function.Involutive a) (ha' : Function.Involutive a')
    (hwa : Intertwines ω ω a) (hwa' : Intertwines ω ω a')
    (H K : LieSubalgebra ℂ L)
    (hH : StableCartanVoganData.StableCartan ω a H)
    (hK : StableCartanVoganData.StableCartan ω a' K)
    (hDim : Module.finrank ℂ (complexFixed a) = r.dimension)
    (hDim' : Module.finrank ℂ (complexFixed a') = r'.dimension) :
    ¬ Nonempty ((involutionConjugation ω a hwa ha).fixed ≃ₗ⁅ℝ⁆
      (involutionConjugation ω a' hwa' ha').fixed) := by
  apply not_realForm_equiv_of_fixed_dimension_ne hss ω hω
    a a' ha ha' hwa hwa' H K hH hK
  rw [hDim, hDim']
  exact distinct_dimensions D r hr r' hr' hrow

end RowRepresentatives

section InnerClassification

open Specs.LieAlgebrasAndRepresentations
open Specs.LieAlgebrasAndRepresentations.CartanDecompositionSignature (complexFixed killingSignature)
open Specs.LieAlgebrasAndRepresentations.PolarRealStructures (IsCompact involutionConjugation)
open Specs.LieAlgebrasAndRepresentations.RootDecomposition (rootSpace_value)
open Specs.LieAlgebrasAndRepresentations.StableCartanVoganData (StableCartan)
open Specs.LieAlgebrasAndRepresentations.VoganEquivalence (latticeSimple colorSign)
open RealForms (Conjugation Intertwines)
open _root_.LieAlgebrasAndRepresentations.VoganEquivalence
open private compact_pinning pullbackDirection pullback_regular liftSimpleEquiv
  liftSimpleEquiv_apply compact_symm from MathGenome.Internal.LieAlgebrasAndRepresentations.LieAlgebrasAndRepresentations.VoganEquivalence

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]

private theorem numbered_compact_cartan {D : Diagram}
    (hss : SolvableRadical.IsSemisimple_value ℂ L) (q : NumberedCartan D L)
    (ω : Conjugation L) (hω : IsCompact ω) :
    ∃ t : NumberedCartan D L, ∀ x ∈ t.subalgebra, ω.map x ∈ t.subalgebra := by
  let a : L ≃ₗ⁅ℂ⁆ L := LieEquiv.refl
  obtain ⟨K, hK, _, _⟩ := StableCartanVoganData.stable_order hss ω hω a (fun _ => rfl) (fun _ => rfl)
  have hKC := (isCartan_iff_maximal_toral hss K).mpr hK.toral
  have hqC := (isCartan_iff_maximal_toral hss q.subalgebra).mpr q.maximalToral
  obtain ⟨g, _, hg⟩ := cartan_conjugacy L hss K q.subalgebra hKC hqC
  let r := rootIsomOfTransport hss hK.toral q.maximalToral g hg
  let e := liftSimpleEquiv r q.direction
  let s := q.number.trans e.symm
  have hs (i : Vertex D) : r.linear (s i).val = (q.number i).val :=
    (liftSimpleEquiv_apply r q.direction (s i)).symm.trans
      (congrArg Subtype.val (e.apply_symm_apply (q.number i)))
  refine ⟨⟨K, hK.toral, pullbackDirection r q.direction, pullback_regular r q.regular, s, ?_⟩,
    hK.compact_stable⟩
  intro i j
  rw [← q.entries i j, ← hs i, ← hs j]
  exact (r.pairing _ (s i).property.1.1 _ (s j).property.1.1).symm

private theorem inner_involution_fixes_compact_cartan
    (hss : SolvableRadical.IsSemisimple_value ℂ L) (ω : Conjugation L) (hω : IsCompact ω)
    (b : L ≃ₗ⁅ℂ⁆ L) (hb : CompactInnerInvolution ω b) :
    ∃ K : LieSubalgebra ℂ L, StableCartan ω b K ∧ ∀ x : K, b (x : L) = (x : L) := by
  obtain ⟨K, hK, z, hz, A, d, e, f, _, _, hA, _, hN, hw, hd⟩ :=
    StableCartanVoganData.encode hss ω hω b hb.commutes hb.involutive
  exact ⟨K, hK, (normalizedInnerIffFixesCartan hss ω K hK.toral hK.compact_stable
    _ hz.regular e f hN (fun i => (hw i).1) A d b hA hd).1.mp hb.inner⟩

private theorem compact_cartan_transport
    (hss : SolvableRadical.IsSemisimple_value ℂ L) (ω : Conjugation L) (hω : IsCompact ω)
    (H K : LieSubalgebra ℂ L) (hH : MaximalTori.IsMaximalToral_value H)
    (hK : MaximalTori.IsMaximalToral_value K)
    (hwH : ∀ x ∈ H, ω.map x ∈ H) (hwK : ∀ x ∈ K, ω.map x ∈ K) :
    ∃ g : L ≃ₗ⁅ℂ⁆ L, Intertwines ω ω g ∧ K.map g.toLieHom = H := by
  let a : L ≃ₗ⁅ℂ⁆ L := LieEquiv.refl
  have hinv : Function.Involutive a := fun _ => rfl
  have hcomm : Intertwines ω ω a := fun _ => rfl
  obtain ⟨g, _, hgw, _, hmap⟩ := cartanAdjustment hss ω hω a a hinv hinv hcomm hcomm K H
    (stableCartan_of_fixes_torus hss ω a K hK hwK (fun _ => rfl))
    (stableCartan_of_fixes_torus hss ω a H hH hwH (fun _ => rfl)) a hcomm (fun _ => rfl)
  exact ⟨g, hgw, hmap⟩

attribute [local instance 100] LieRing.ofAssociativeRing in
private theorem fixedRow_of_compactConjugate (r : Row) (ω : Conjugation L) (hω : IsCompact ω)
    {a b : L ≃ₗ⁅ℂ⁆ L} (ha : CompactInnerInvolution ω a) (hb : CompactInnerInvolution ω b)
    (h : CompactConjugate ω a b) (hr : FixedRow r ω a ha.commutes ha.involutive) :
    FixedRow r ω b hb.commutes hb.involutive := by
  obtain ⟨g, _, hg⟩ := h
  obtain ⟨⟨e⟩, hdim, hsig⟩ := hr
  let f := complexFixedEquivOfConjugation a b g hg
  have heq := f.toLinearEquiv.finrank_eq
  refine ⟨⟨e.trans f⟩, heq.symm.trans hdim, ?_⟩
  have hs (t : L ≃ₗ⁅ℂ⁆ L) (ht : CompactInnerInvolution ω t) :
      killingSignature (involutionConjugation ω t ht.commutes ht.involutive).fixed =
        (Module.finrank ℂ L : ℤ) - 2 * (Module.finrank ℂ (complexFixed t) : ℤ) :=
    CartanDecompositionSignature.killing_signature ω t ht.commutes ht.involutive hω
  rw [hs b hb, ← heq, ← hs a ha, hsig]

private theorem row_eq_of_dimension_eq {D : Diagram} (r s : TableRow D)
    (h : r.val.dimension = s.val.dimension) : r = s := by
  rcases r with ⟨r, hr⟩
  rcases s with ⟨s, hs⟩
  cases D <;> simp only [rows, List.mem_cons, List.not_mem_nil, or_false] at hr hs
  all_goals
    rcases hr with rfl | rfl | rfl | rfl <;>
      rcases hs with rfl | rfl | rfl | rfl <;>
      first | rfl | (dsimp at h; exact (absurd h (by decide)))

/-- Classification of the actual inner compact involutions in the source table. -/
theorem innerInvolutionClasses : innerInvolutionClassesType.{u} := by
  classical
  intro D L _ _ _ hss q ω hω
  obtain ⟨⟨H, hH, φ, hφ, s, hA⟩, hwH⟩ := numbered_compact_cartan hss q ω hω
  obtain ⟨e, f, hN, hw⟩ := compact_pinning hss ω hω H hH hwH φ
  have realize (r : TableRow D) : ∃ a : L ≃ₗ⁅ℂ⁆ L,
      ∃ ha : CompactInnerInvolution ω a,
        (∀ x : H, a (x : L) = (x : L)) ∧
        (∀ i, a (e (s i)) = colorSign (colorAt D r.val.mask i) • e (s i)) ∧
        (∀ (c : Root D) (x : L), x ∈ rootSpace_value H (∑ i, c i • (s i).val) →
          a x = colorSign (parity D (colorAt D r.val.mask) c) • x) ∧
        FixedRow r.val ω a ha.commutes ha.involutive := by
    obtain ⟨a, haw, hai, haH, hsign⟩ := exists_innerInvolution_of_color D hss ω H hH hwH
      φ hφ e f hN hw s (colorAt D r.val.mask)
    refine ⟨a, ⟨inner_of_fixes_torus hss ω H hH hwH φ hφ e f hN hw a haw haH, haw, hai⟩,
      haH, fun i => (hsign i).1,
      innerRootAction D hss ω H hH hwH φ hφ e f hN hw a haH s (colorAt D r.val.mask) hsign, ?_⟩
    exact fixed_row_of_inner_datum D r.val r.property hss H hH φ hφ s hA ω hω hwH
      e f hN hw a haw hai haH hsign
  choose a ha haH has hact hrows using realize
  have hrow (b : L ≃ₗ⁅ℂ⁆ L) (hb : CompactInnerInvolution ω b) (r : TableRow D)
      (h : CompactConjugate ω (a r) b) : FixedRow r.val ω b hb.commutes hb.involutive :=
    fixedRow_of_compactConjugate r.val ω hω (ha r) hb h (hrows r)
  refine ⟨⟨H, hH, φ, hφ, s, hA⟩, a, ha, hwH, haH, hact, hrows, ?_, hrow⟩
  intro b hb
  obtain ⟨K, hK, hbK⟩ := inner_involution_fixes_compact_cartan hss ω hω b hb
  obtain ⟨g, hgw, hg⟩ := compact_cartan_transport hss ω hω H K hH hK.toral hwH hK.compact_stable
  let c := (g.symm.trans b).trans g
  have hci : Function.Involutive c := by
    intro x
    change g (b (g.symm (g (b (g.symm x))))) = x
    rw [g.symm_apply_apply, hb.involutive, g.apply_symm_apply]
  have hcw : Intertwines ω ω c := by
    intro x
    change ω.map (g (b (g.symm x))) = g (b (g.symm (ω.map x)))
    rw [hgw, hb.commutes, compact_symm ω g hgw]
  have hcH (x : H) : c (x : L) = (x : L) := by
    have hx : (x : L) ∈ K.map g.toLieHom := hg.symm ▸ x.property
    obtain ⟨y, hy, hey⟩ := (LieSubalgebra.mem_map _ _ _).mp hx
    change g y = (x : L) at hey
    change g (b (g.symm (x : L))) = (x : L)
    rw [← hey, g.symm_apply_apply, hbK ⟨y, hy⟩]
  obtain ⟨χ, hχ, _⟩ := (innerCharacters hss ω H hH hwH φ hφ e f hN hw).1 c hcw hci hcH
  let colors : Color D := fun i => χ (latticeSimple (s i))
  have hsign (i : Vertex D) : c (e (s i)) = colorSign (colors i) • e (s i) :=
    hχ ⟨(s i).val, (s i).property.1.1⟩ (e (s i)) (hN (s i)).1
  obtain ⟨r, hr, hov⟩ := colors_cover D colors
  let row : TableRow D := ⟨r, hr⟩
  have hStableA := stableCartan_of_fixes_torus hss ω (a row) H hH hwH (haH row)
  have hStableC := stableCartan_of_fixes_torus hss ω c H hH hwH hcH
  have he := innerForms_isomorphic_of_colorOrbit D hss ω hω (a row) c (ha row).involutive hci
    (ha row).commutes hcw H hStableA hStableC (haH row) hcH φ hφ e f hN hw s hA
    (colorAt D r.mask) colors (has row) hsign (orbit_sound D r hr hov)
  obtain ⟨k, hkw, hk, _⟩ := (realFormsIffCartanConjugates hss ω hω (a row) c
    (ha row).involutive hci (ha row).commutes hcw H H hStableA hStableC).mp he
  have hconj : CompactConjugate ω (a row) b := by
    refine ⟨k.trans g.symm, fun x => ?_, fun x => ?_⟩
    · change ω.map (g.symm (k x)) = g.symm (k (ω.map x))
      rw [compact_symm ω g hgw, hkw]
    · simpa only [c, LieEquiv.trans_apply, g.symm_apply_apply] using congrArg g.symm (hk x)
  exact ⟨row, hconj, fun row' hr' => row_eq_of_dimension_eq row' row
    ((hrow b hb row' hr').2.1.symm.trans (hrow b hb row hconj).2.1)⟩

end InnerClassification

section SerreBlock

open Serre
open Specs.LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
open scoped BigOperators
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false

noncomputable section

private def leftIndex {m n : ℕ} (i : Fin m) : Fin (m + n) :=
  finSumFinEquiv (Sum.inl i)

private def rightIndex {m n : ℕ} (i : Fin n) : Fin (m + n) :=
  finSumFinEquiv (Sum.inr i)

private theorem leftIndex_injective {m n : ℕ} :
    Function.Injective (leftIndex (m := m) (n := n)) :=
  fun _ _ h => Sum.inl.inj (finSumFinEquiv.injective h)

private theorem rightIndex_injective {m n : ℕ} :
    Function.Injective (rightIndex (m := m) (n := n)) :=
  fun _ _ h => Sum.inr.inj (finSumFinEquiv.injective h)

@[simp] private theorem leftIndex_eq {m n : ℕ} {i j : Fin m} :
    leftIndex (n := n) i = leftIndex j ↔ i = j :=
  leftIndex_injective.eq_iff

@[simp] private theorem rightIndex_eq {m n : ℕ} {i j : Fin n} :
    rightIndex (m := m) i = rightIndex j ↔ i = j :=
  rightIndex_injective.eq_iff

@[simp] private theorem leftIndex_ne_rightIndex {m n : ℕ} (i : Fin m) (j : Fin n) :
    leftIndex i ≠ rightIndex j := fun h => Sum.inl_ne_inr (finSumFinEquiv.injective h)

@[simp] private theorem rightIndex_ne_leftIndex {m n : ℕ} (i : Fin n) (j : Fin m) :
    rightIndex i ≠ leftIndex j := (leftIndex_ne_rightIndex j i).symm

private theorem casesBlockIndex {m n : ℕ} (i : Fin (m + n)) :
    (∃ j : Fin m, i = leftIndex j) ∨ (∃ j : Fin n, i = rightIndex j) := by
  obtain ⟨j, rfl⟩ := finSumFinEquiv.surjective i
  cases j
  · exact Or.inl ⟨_, rfl⟩
  · exact Or.inr ⟨_, rfl⟩

section
variable {m n : ℕ} (A : Matrix (Fin m) (Fin m) ℤ) (B : Matrix (Fin n) (Fin n) ℤ)

@[simp] private theorem block_left_left (i j : Fin m) :
    block A B (leftIndex i) (leftIndex j) = A i j := by simp [block, leftIndex, rightIndex]

@[simp] private theorem block_left_right (i : Fin m) (j : Fin n) :
    block A B (leftIndex i) (rightIndex j) = 0 := by simp [block, leftIndex, rightIndex]

@[simp] private theorem block_right_left (i : Fin n) (j : Fin m) :
    block A B (rightIndex i) (leftIndex j) = 0 := by simp [block, leftIndex, rightIndex]

@[simp] private theorem block_right_right (i j : Fin n) :
    block A B (rightIndex i) (rightIndex j) = B i j := by simp [block, leftIndex, rightIndex]

variable (hA : ∀ i j, i ≠ j → A i j ≤ 0) (hB : ∀ i j, i ≠ j → B i j ≤ 0)

include hA hB in
private theorem block_nonpos :
    ∀ i j, i ≠ j → block A B i j ≤ 0 := by
  intro i j hij
  rcases casesBlockIndex i with ⟨i, rfl⟩ | ⟨i, rfl⟩ <;>
    rcases casesBlockIndex j with ⟨j, rfl⟩ | ⟨j, rfl⟩ <;> simp_all

include hA hB in
private theorem block_left_relations :
    RelationsHold A (e (block A B) ∘ leftIndex) (f (block A B) ∘ leftIndex)
      (h (block A B) ∘ leftIndex) := by
  obtain ⟨hh, he, hf, ef, pe, pf⟩ := relations_spec (block A B) (block_nonpos A B hA hB)
  exact ⟨fun i j => hh _ _, fun i j => by simpa using he (leftIndex i) (leftIndex j),
    fun i j => by simpa using hf (leftIndex i) (leftIndex j),
    fun i j => by simpa using ef (leftIndex i) (leftIndex j),
    fun i j h => by simpa using pe (leftIndex i) (leftIndex j) (mt leftIndex_eq.mp h),
    fun i j h => by simpa using pf (leftIndex i) (leftIndex j) (mt leftIndex_eq.mp h)⟩

include hA hB in
private theorem block_right_relations :
    RelationsHold B (e (block A B) ∘ rightIndex) (f (block A B) ∘ rightIndex)
      (h (block A B) ∘ rightIndex) := by
  obtain ⟨hh, he, hf, ef, pe, pf⟩ := relations_spec (block A B) (block_nonpos A B hA hB)
  exact ⟨fun i j => hh _ _, fun i j => by simpa using he (rightIndex i) (rightIndex j),
    fun i j => by simpa using hf (rightIndex i) (rightIndex j),
    fun i j => by simpa using ef (rightIndex i) (rightIndex j),
    fun i j h => by simpa using pe (rightIndex i) (rightIndex j) (mt rightIndex_eq.mp h),
    fun i j h => by simpa using pf (rightIndex i) (rightIndex j) (mt rightIndex_eq.mp h)⟩

private def blockInl : Algebra A →ₗ⁅ℂ⁆ Algebra (block A B) :=
  lift A hA _ _ _ (block_left_relations A B hA hB)

private def blockInr : Algebra B →ₗ⁅ℂ⁆ Algebra (block A B) :=
  lift B hB _ _ _ (block_right_relations A B hA hB)

private def blockGenerators (x : Fin m → Algebra A) (y : Fin n → Algebra B)
    (i : Fin (m + n)) : Algebra A × Algebra B :=
  (finSumFinEquiv.symm i).elim (fun j => (x j, 0)) (fun j => (0, y j))

@[simp] private theorem blockGenerators_left (x : Fin m → Algebra A) (y : Fin n → Algebra B)
    (i : Fin m) : blockGenerators A B x y (leftIndex i) = (x i, 0) := by
  simp [blockGenerators, leftIndex, rightIndex]

@[simp] private theorem blockGenerators_right (x : Fin m → Algebra A) (y : Fin n → Algebra B)
    (j : Fin n) : blockGenerators A B x y (rightIndex j) = (0, y j) := by
  simp [blockGenerators, leftIndex, rightIndex]

private theorem iterBracket_prod {L M : Type*} [LieRing L] [LieRing M]
    (x y : L × M) (k : ℕ) :
    iterBracket x k y = (iterBracket x.1 k y.1, iterBracket x.2 k y.2) := by
  induction k with
  | zero => rfl
  | succ k ih => simp only [iterBracket, ih, LieAlgebra.Prod.bracket_apply]

include hA hB in
private theorem block_product_relations :
    RelationsHold (block A B) (blockGenerators A B (e A) (e B))
      (blockGenerators A B (f A) (f B)) (blockGenerators A B (h A) (h B)) := by
  obtain ⟨hhA, heA, hfA, efA, peA, pfA⟩ := relations_spec A hA
  obtain ⟨hhB, heB, hfB, efB, peB, pfB⟩ := relations_spec B hB
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals
    intro i j
    rcases casesBlockIndex i with ⟨i, rfl⟩ | ⟨i, rfl⟩ <;>
      rcases casesBlockIndex j with ⟨j, rfl⟩ | ⟨j, rfl⟩
  all_goals
    simp [hhA, heA, hfA, efA, peA, pfA, hhB, heB, hfB, efB, peB, pfB,
      iterBracket_prod, iterBracket, Prod.zero_eq_mk]
  all_goals
    first
    | exact peA i j
    | exact peB i j
    | exact pfA i j
    | exact pfB i j
    | split <;> simp_all

private def blockToProduct :
    Algebra (block A B) →ₗ⁅ℂ⁆ (Algebra A × Algebra B) :=
  lift (block A B) (block_nonpos A B hA hB) _ _ _ (block_product_relations A B hA hB)


include hA hB in
private theorem block_mixed_e (i : Fin m) (j : Fin n) :
    ⁅e (block A B) (leftIndex i), e (block A B) (rightIndex j)⁆ = 0 := by
  simpa [iterBracket] using
    (relations_spec (block A B) (block_nonpos A B hA hB)).2.2.2.2.1
      (leftIndex i) (rightIndex j) (leftIndex_ne_rightIndex i j)

include hA hB in
private theorem block_mixed_f (i : Fin m) (j : Fin n) :
    ⁅f (block A B) (leftIndex i), f (block A B) (rightIndex j)⁆ = 0 := by
  simpa [iterBracket] using
    (relations_spec (block A B) (block_nonpos A B hA hB)).2.2.2.2.2
      (leftIndex i) (rightIndex j) (leftIndex_ne_rightIndex i j)

private def centralizerElement {L : Type*} [LieRing L] [LieAlgebra ℂ L] (z : L) :
    LieSubalgebra ℂ L where
  carrier := {x | ⁅z, x⁆ = 0}
  zero_mem' := lie_zero z
  add_mem' {x y} hx hy := by
    change ⁅z, x⁆ = 0 at hx
    change ⁅z, y⁆ = 0 at hy
    change ⁅z, x + y⁆ = 0
    simp [lie_add, hx, hy]
  smul_mem' k x hx := by
    change ⁅z, x⁆ = 0 at hx
    change ⁅z, k • x⁆ = 0
    simp [lie_smul, hx]
  lie_mem' {x y} hx hy := by
    change ⁅z, x⁆ = 0 at hx
    change ⁅z, y⁆ = 0 at hy
    change ⁅z, ⁅x, y⁆⁆ = 0
    simp [leibniz_lie, hx, hy]

private theorem centralizes_quotient_image {ι L : Type*} [DecidableEq ι]
    [LieRing L] [LieAlgebra ℂ L] {M : Matrix ι ι ℤ}
    (φ : Algebra M →ₗ⁅ℂ⁆ L) (z : L)
    (he : ∀ i, ⁅z, φ (e M i)⁆ = 0) (hf : ∀ i, ⁅z, φ (f M i)⁆ = 0)
    (hh : ∀ i, ⁅z, φ (h M i)⁆ = 0) (x : Algebra M) : ⁅z, φ x⁆ = 0 := by
  let C := (centralizerElement z).comap φ
  have htop : C = ⊤ := generators_generate M C he hf hh
  have hx : x ∈ C := by rw [htop]; exact LieSubalgebra.mem_top x
  exact hx

include hA hB in
private theorem block_images_commute (x : Algebra A) (y : Algebra B) :
    ⁅blockInl A B hA hB x, blockInr A B hA hB y⁆ = 0 := by
  have hEe (i : Fin m) (j : Fin n) :
      ⁅e (block A B) (leftIndex i), e (block A B) (rightIndex j)⁆ = 0 :=
    block_mixed_e A B hA hB i j
  have hFf (i : Fin m) (j : Fin n) :
      ⁅f (block A B) (leftIndex i), f (block A B) (rightIndex j)⁆ = 0 :=
    block_mixed_f A B hA hB i j
  have hEf (i : Fin m) (j : Fin n) :
      ⁅e (block A B) (leftIndex i), f (block A B) (rightIndex j)⁆ = 0 := by
    simp [Serre.ef]
  have hFe (i : Fin m) (j : Fin n) :
      ⁅f (block A B) (leftIndex i), e (block A B) (rightIndex j)⁆ = 0 := by
    rw [← lie_skew]; simp [Serre.ef]
  have hEh (i : Fin m) (j : Fin n) :
      ⁅e (block A B) (leftIndex i), h (block A B) (rightIndex j)⁆ = 0 := by
    rw [← lie_skew]; simp [Serre.he]
  have hFh (i : Fin m) (j : Fin n) :
      ⁅f (block A B) (leftIndex i), h (block A B) (rightIndex j)⁆ = 0 := by
    rw [← lie_skew]; simp [Serre.hf]
  have hyE (i : Fin m) : ⁅e (block A B) (leftIndex i), blockInr A B hA hB y⁆ = 0 := by
    apply centralizes_quotient_image
    · intro j; simpa [blockInr] using hEe i j
    · intro j; simpa [blockInr] using hEf i j
    · intro j; simpa [blockInr] using hEh i j
  have hyF (i : Fin m) : ⁅f (block A B) (leftIndex i), blockInr A B hA hB y⁆ = 0 := by
    apply centralizes_quotient_image
    · intro j; simpa [blockInr] using hFe i j
    · intro j; simpa [blockInr] using hFf i j
    · intro j; simpa [blockInr] using hFh i j
  have hyH (i : Fin m) : ⁅h (block A B) (leftIndex i), blockInr A B hA hB y⁆ = 0 := by
    apply centralizes_quotient_image <;> intro j <;> simp [blockInr, Serre.he, Serre.hf, Serre.hh]
  rw [← lie_skew]
  suffices h : ⁅blockInr A B hA hB y, blockInl A B hA hB x⁆ = 0 by simp [h]
  apply centralizes_quotient_image <;> intro i <;> rw [← lie_skew] <;>
    simp [blockInl, hyE, hyF, hyH]

private def blockFromProduct :
    (Algebra A × Algebra B) →ₗ⁅ℂ⁆ Algebra (block A B) where
  toLinearMap := (blockInl A B hA hB).toLinearMap.coprod (blockInr A B hA hB).toLinearMap
  map_lie' := by
    intro x y
    change blockInl A B hA hB ⁅x.1, y.1⁆ + blockInr A B hA hB ⁅x.2, y.2⁆ =
      ⁅blockInl A B hA hB x.1 + blockInr A B hA hB x.2,
        blockInl A B hA hB y.1 + blockInr A B hA hB y.2⁆
    have hr : ⁅blockInr A B hA hB x.2, blockInl A B hA hB y.1⁆ = 0 := by
      rw [← lie_skew, block_images_commute, neg_zero]
    simp [LieHom.map_lie, add_lie, lie_add, block_images_commute, hr]

include hA hB in
@[simp] private theorem blockFromProduct_apply (x : Algebra A × Algebra B) :
    blockFromProduct A B hA hB x = blockInl A B hA hB x.1 + blockInr A B hA hB x.2 :=
  rfl

include hA hB in
private theorem block_from_to :
    (blockFromProduct A B hA hB).comp (blockToProduct A B hA hB) =
      LieHom.id := by
  apply hom_ext (block A B) <;> intro i <;>
    rcases casesBlockIndex i with ⟨i, rfl⟩ | ⟨i, rfl⟩ <;>
    simp [blockToProduct, blockInl, blockInr, LieHom.comp_apply]

include hA hB in
private theorem block_to_from :
    (blockToProduct A B hA hB).comp (blockFromProduct A B hA hB) =
      LieHom.id := by
  apply LieHom.prod_ext
  · apply hom_ext A <;> intro i <;>
      simp [blockToProduct, blockInl, blockInr, LieHom.comp_apply]
  · apply hom_ext B <;> intro i <;>
      simp [blockToProduct, blockInl, blockInr, LieHom.comp_apply]

/-- The Serre quotient of a block diagonal matrix splits as the product of the
Serre quotients of the two diagonal blocks. -/
def serreBlockEquiv : Algebra (block A B) ≃ₗ⁅ℂ⁆ Algebra A × Algebra B :=
  LieEquiv.ofBijective (blockToProduct A B hA hB)
    ⟨(show Function.LeftInverse (blockFromProduct A B hA hB) (blockToProduct A B hA hB) from
        fun x => LieHom.congr_fun (block_from_to A B hA hB) x).injective,
     (show Function.RightInverse (blockFromProduct A B hA hB) (blockToProduct A B hA hB) from
        fun x => LieHom.congr_fun (block_to_from A B hA hB) x).surjective⟩

end

end

end SerreBlock

theorem serreBlockAlgebras : serreBlockAlgebrasType := by
  intro m n A B hA hB
  exact ⟨serreBlockEquiv A B hA hB⟩

end LieAlgebrasAndRepresentations.ExceptionalInnerInvolutions
