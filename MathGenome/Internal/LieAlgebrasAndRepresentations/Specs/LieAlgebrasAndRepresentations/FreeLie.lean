import Mathlib.Algebra.Lie.Free
import Mathlib.LinearAlgebra.Basis.VectorSpace
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.Enveloping
import Mathlib.Algebra.Lie.Subalgebra

/-! LA A07, notes/005, theorem res:A07. No restriction on characteristic or dimension.
A chosen vector-space basis bridges the set-free construction to linear freeness. -/
/-! Independent LA A07 contract. All maps are fixed on the original vector space,
and the enveloping algebra is the shared tensor quotient from LA A04.
The basis is only a construction choice; targets quantify over every vector space
and every Lie algebra over the field, with unrestricted dimension/characteristic.
-/
noncomputable section
namespace LieAlgebrasAndRepresentations.FreeLie
universe u v w
variable (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V]

abbrev BasisIndex := Module.Free.ChooseBasisIndex k V
abbrev vectorBasis := Module.Free.chooseBasis k V
abbrev Free := FreeLieAlgebra k (BasisIndex k V)

def generator : V →ₗ[k] Free k V :=
  (vectorBasis k V).constr k (FreeLieAlgebra.of k)

def extend {g : Type w} [LieRing g] [LieAlgebra k g] (f : V →ₗ[k] g) :
    Free k V →ₗ⁅k⁆ g :=
  FreeLieAlgebra.lift k (fun i => f (vectorBasis k V i))

attribute [local instance 100] LieRing.ofAssociativeRing

def tensorLieMap : Free k V →ₗ⁅k⁆ TensorAlgebra k V :=
  extend k V (TensorAlgebra.ι k)

def tensorMap : Shared.Lie.U k (Free k V) →ₐ[k] TensorAlgebra k V :=
  UniversalEnvelopingAlgebra.lift k (tensorLieMap k V)

def tensorInverse : TensorAlgebra k V →ₐ[k] Shared.Lie.U k (Free k V) :=
  TensorAlgebra.lift k ((Shared.Lie.inclusion k (Free k V)).toLinearMap.comp (generator k V))

end LieAlgebrasAndRepresentations.FreeLie

namespace Specs.LieAlgebrasAndRepresentations.FreeLie
open _root_.LieAlgebrasAndRepresentations.FreeLie
universe u v w
attribute [local instance 100] LieRing.ofAssociativeRing

def algebraExpectedType := ∀ (k : Type u) (V : Type v) [Field k]
  [AddCommGroup V] [Module k V], Type (max u v)
def algebraExpectedValue (k : Type u) (V : Type v) [Field k]
    [AddCommGroup V] [Module k V] : Type (max u v) := Free k V

def generatorExpectedType := ∀ (k : Type u) (V : Type v) [Field k]
  [AddCommGroup V] [Module k V], V →ₗ[k] Free k V
def generatorExpectedValue (k : Type u) (V : Type v) [Field k]
    [AddCommGroup V] [Module k V] := generator k V

/-- Linear freeness for arbitrary target Lie algebras, including uniqueness. -/
def universalExpected : Prop :=
  ∀ (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V],
    Function.Injective (generator k V) ∧
    ∀ (g : Type w) [LieRing g] [LieAlgebra k g] (f : V →ₗ[k] g),
      ∃! F : Free k V →ₗ⁅k⁆ g, F.toLinearMap.comp (generator k V) = f

/-- The algebra isomorphism is the one induced by the generators, with its inverse fixed. -/
def tensorExpected : Prop :=
  ∀ (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V],
    ∃ e : Shared.Lie.U k (Free k V) ≃ₐ[k] TensorAlgebra k V,
      e.toAlgHom = tensorMap k V ∧ e.symm.toAlgHom = tensorInverse k V ∧
      ∀ v, e (Shared.Lie.inclusion k (Free k V) (generator k V v)) = TensorAlgebra.ι k v

/-- The resulting inclusion has precisely the Lie subalgebra generated by the degree-one copy. -/
def imageExpected : Prop :=
  ∀ (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V],
    tensorLieMap k V = (tensorMap k V : Shared.Lie.U k (Free k V) →ₗ⁅k⁆ TensorAlgebra k V).comp
      (Shared.Lie.inclusion k (Free k V)) ∧
    Function.Injective (tensorLieMap k V) ∧
    (tensorLieMap k V).range =
      LieSubalgebra.lieSpan k (TensorAlgebra k V) (Set.range (TensorAlgebra.ι k : V →ₗ[k] _))

end Specs.LieAlgebrasAndRepresentations.FreeLie
