import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.CompactConjugation
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.CartanConjugacy
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.ClosedMatrixGroups
import Mathlib.Analysis.InnerProductSpace.Defs
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Analysis.Normed.Operator.Bilinear

/-! The inner orbit assertion in notes/005, supp:compact-form-flag.
The Grassmannian uses the quotient topology of complex frames. Its points
are the subspaces themselves. All endomorphism groups have the ordinary
finite-dimensional operator topology, using the norm from the compact form. -/

noncomputable section

universe u

namespace Specs.LieAlgebrasAndRepresentations.CompactFlagOrbit

open CompactConjugation RootDecomposition
open _root_.LieAlgebrasAndRepresentations.ClosedMatrixGroups
open scoped ComplexConjugate

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L]

attribute [local instance] realLieAlgebra

/-- The complex subspace `h ⊕ n⁺`, for the positive roots selected by `φ`. -/
def borel (H : LieSubalgebra ℂ L) (φ : Module.Dual ℂ H →ₗ[ℝ] ℝ) : Submodule ℂ L :=
  H.toSubmodule ⊔ ⨆ α : PositiveRoot H φ, rootSpace_value H α.val

def HermitianSymmetric (τ : ConjugateMap L) : Prop :=
  ∀ v w, hermitian τ v w = conj (hermitian τ w v)

def HermitianPositive (τ : ConjugateMap L) : Prop :=
  ∀ v : L, v ≠ 0 → 0 < (hermitian τ v v).re

/-- Mathlib takes the inner product conjugate-linear in its first argument. -/
@[instance_reducible] def hermitianCore (τ : ConjugateMap L) (hs : HermitianSymmetric τ)
    (hp : HermitianPositive τ) : InnerProductSpace.Core ℂ L where
  inner v w := hermitian τ w v
  conj_inner_symm v w := (hs w v).symm
  re_inner_nonneg v := by
    by_cases hv : v = 0
    · subst v
      simp
    · exact (hp v hv).le
  add_left v w z := map_add (hermitian τ z) v w
  smul_left v w r := map_smulₛₗ (hermitian τ w) r v
  definite v hv := by
    by_contra hn
    simpa only [hv, Complex.zero_re, lt_self_iff_false] using hp v hn

section Normed

variable {V : Type u} [NormedAddCommGroup V] [NormedSpace ℂ V]

abbrev End (V : Type u) [NormedAddCommGroup V] [NormedSpace ℂ V] := V →L[ℂ] V

/-- The matrix realization of the complex Lie automorphism group,
with the original Lie bracket passed as its binary operation. -/
def automorphisms (bracket : V → V → V) : Subgroup (End V)ˣ where
  carrier := {g | ∀ v w, g.val (bracket v w) = bracket (g.val v) (g.val w)}
  one_mem' := fun _ _ => rfl
  mul_mem' := by
    intro a b ha hb v w
    change a.val (b.val (bracket v w)) = _
    rw [hb, ha]
    rfl
  inv_mem' := by
    intro a ha v w
    have h (x : V) : a.val (a.inv x) = x :=
      congrArg (fun f : End V => f x) a.val_inv
    have h' (x : V) : a.inv (a.val x) = x :=
      congrArg (fun f : End V => f x) a.inv_val
    change a.inv (bracket v w) = bracket (a.inv v) (a.inv w)
    calc
      a.inv (bracket v w) = a.inv (bracket (a.val (a.inv v)) (a.val (a.inv w))) := by rw [h, h]
      _ = bracket (a.inv v) (a.inv w) := by rw [← ha, h']

/-- The automorphisms that preserve the given Hermitian form. -/
def hermitianAutomorphisms (bracket : V → V → V) (form : V → V → ℂ) :
    Subgroup (End V)ˣ where
  carrier := {g | g ∈ automorphisms bracket ∧ ∀ v w, form (g.val v) (g.val w) = form v w}
  one_mem' := ⟨(automorphisms bracket).one_mem, fun _ _ => rfl⟩
  mul_mem' := by
    intro a b ha hb
    refine ⟨(automorphisms bracket).mul_mem ha.1 hb.1, fun v w => ?_⟩
    exact (ha.2 (b.val v) (b.val w)).trans (hb.2 v w)
  inv_mem' := by
    intro a ha
    refine ⟨(automorphisms bracket).inv_mem ha.1, fun v w => ?_⟩
    have h (x : V) : a.val (a.inv x) = x :=
      congrArg (fun f : End V => f x) a.val_inv
    change form (a.inv v) (a.inv w) = form v w
    simpa only [h] using (ha.2 (a.inv v) (a.inv w)).symm

end Normed

/-- The component is formed in the subgroup topology and included in GL. -/
def identityComponent {A : Type*} [Monoid A] [TopologicalSpace A]
    [ContinuousMul A] (M : Subgroup Aˣ) : Subgroup Aˣ :=
  (Subgroup.connectedComponentOfOne M).map M.subtype

section CompactNorm

variable [c : InnerProductSpace.Core ℂ L]
attribute [local instance] InnerProductSpace.Core.toNormedAddCommGroup
  InnerProductSpace.Core.toNormedSpace

variable [FiniteDimensional ℂ L]

def adjointEnd (z : L) : End L :=
  LinearMap.toContinuousLinearMap ((LieAlgebra.ad ℂ L) z)

local instance : NormedAlgebra ℝ (End L) := NormedAlgebra.restrictScalars ℝ ℂ _

/-- Inner automorphisms are generated by exponentials of the original adjoint maps. -/
def innerGroup : Subgroup (End L)ˣ :=
  Subgroup.closure (Set.range fun z : L => expUnit (adjointEnd z))

/-- The compact group's Lie algebra, as endomorphisms, is the image of
the real Lie algebra fixed by the compact conjugation. -/
def compactLieAlgebra (τ : ConjugateMap L) (hτ : PreservesBracket τ) : Set (End L) :=
  Set.range fun z : fixed τ hτ => adjointEnd (z : L)

end CompactNorm

section Grassmannian

variable {V : Type u} [AddCommGroup V] [Module ℂ V]

/-- Complex subspaces of a prescribed dimension. -/
@[ext] structure Grassmannian (V : Type u) [AddCommGroup V] [Module ℂ V] (d : ℕ) where
  subspace : Submodule ℂ V
  finrank_eq : Module.finrank ℂ subspace = d

variable (V) in
abbrev Frame (d : ℕ) := {v : Fin d → V // LinearIndependent ℂ v}

def frameSpan {d : ℕ} (v : Frame V d) : Grassmannian V d :=
  ⟨Submodule.span ℂ (Set.range v.val), by simpa using finrank_span_eq_card v.property⟩

instance [TopologicalSpace V] {d : ℕ} : TopologicalSpace (Grassmannian V d) :=
  TopologicalSpace.coinduced frameSpan inferInstance

/-- The topology is the quotient of the usual topology on the space of frames. -/
theorem frameSpan_isQuotientMap [TopologicalSpace V] [FiniteDimensional ℂ V] {d : ℕ} :
    Topology.IsQuotientMap (frameSpan : Frame V d → Grassmannian V d) := by
  refine ⟨⟨rfl⟩, ?_⟩
  intro P
  let b := Module.finBasisOfFinrankEq ℂ P.subspace P.finrank_eq
  refine ⟨⟨fun i => P.subspace.subtype (b i),
    b.linearIndependent.map' _ (LinearMap.ker_eq_bot.mpr Subtype.val_injective)⟩, ?_⟩
  apply Grassmannian.ext
  change Submodule.span ℂ (Set.range fun i => P.subspace.subtype (b i)) = P.subspace
  rw [Set.range_comp' (P.subspace.subtype : P.subspace → V), ← Submodule.map_span, b.span_eq]
  simp

variable {W : Type u} [NormedAddCommGroup W] [NormedSpace ℂ W]

/-- A unit in the continuous endomorphism algebra acts by a complex
linear equivalence. -/
def unitEquiv (g : (End W)ˣ) : W ≃ₗ[ℂ] W where
  toLinearMap := g.val.toLinearMap
  invFun := g.inv
  left_inv x := congrArg (fun f : End W => f x) g.inv_val
  right_inv x := congrArg (fun f : End W => f x) g.val_inv

/-- Forget the continuous-operator presentation of the general linear group. -/
def unitEquivHom : (End W)ˣ →* (W ≃ₗ[ℂ] W) where
  toFun := unitEquiv
  map_one' := by ext; rfl
  map_mul' _ _ := by ext; rfl

def flagMap (B : Submodule ℂ W) (g : (End W)ˣ) : Grassmannian W (Module.finrank ℂ B) :=
  ⟨B.map g.val.toLinearMap, (B.equivMapOfInjective (unitEquiv g).toLinearMap
    (unitEquiv g).injective).symm.finrank_eq⟩

def flagOrbit (B : Submodule ℂ W) (M : Subgroup (End W)ˣ) :
    Set (Grassmannian W (Module.finrank ℂ B)) :=
  flagMap B '' (M : Set (End W)ˣ)

end Grassmannian

/-- The adjoint exponentials, and the subgroup they generate, agree with the
Chapter 4 model after forgetting the Hermitian norm. -/
def canonicalInnerGroupType : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (τ : ConjugateMap L) (hs : HermitianSymmetric τ) (hp : HermitianPositive τ),
    letI c := hermitianCore τ hs hp
    letI := c.toNormedAddCommGroup
    letI := InnerProductSpace.Core.toNormedSpace (𝕜 := ℂ) (F := L)
    letI : NormedAlgebra ℝ (End L) := NormedAlgebra.restrictScalars ℝ ℂ _
    (∀ z : L, (unitEquiv (expUnit (adjointEnd z))).toLinearMap =
      CartanConjugacy.exponentialOperator z) ∧
    (innerGroup (L := L)).map unitEquivHom = CartanConjugacy.innerAutomorphisms_value L

/-- The group assertions for a compact conjugation and an arbitrary
compatible positive system. -/
def orbitComparisonType : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    SolvableRadical.IsSemisimple_value ℂ L →
    ∀ (τ : ConjugateMap L) (hτ : PreservesBracket τ),
      Function.Involutive τ →
      ∀ (hs : HermitianSymmetric τ) (hp : HermitianPositive τ),
        letI c := hermitianCore τ hs hp
        letI := c.toNormedAddCommGroup
        letI := InnerProductSpace.Core.toNormedSpace (𝕜 := ℂ) (F := L)
        letI : NormedAlgebra ℝ (End L) := NormedAlgebra.restrictScalars ℝ ℂ _
        let G := identityComponent (automorphisms (fun v w : L => ⁅v, w⁆))
        let K := identityComponent (hermitianAutomorphisms (fun v w : L => ⁅v, w⁆) (fun v w => hermitian τ v w))
        G = innerGroup ∧
        IsCompact (K : Set (End L)ˣ) ∧
        velocities K = compactLieAlgebra τ hτ ∧
        ∀ (H : LieSubalgebra ℂ L), MaximalTori.IsMaximalToral_value H →
          ∀ (φ : Module.Dual ℂ H →ₗ[ℝ] ℝ), (∀ α ∈ rootSet_value H, φ α ≠ 0) →
            (fixed τ hτ).toSubmodule ⊔ borelReal H φ = ⊤ →
            flagOrbit (borel H φ) K = flagOrbit (borel H φ) innerGroup ∧
            IsCompact (flagOrbit (borel H φ) innerGroup)

/-- Full compactness assertion for every Cartan and every positive system,
with the compact conjugation supplied by the compact-form construction. -/
def compactFlagOrbitType : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    SolvableRadical.IsSemisimple_value ℂ L →
    ∀ (H : LieSubalgebra ℂ L), MaximalTori.IsMaximalToral_value H →
      ∃ (τ : ConjugateMap L) (hτ : PreservesBracket τ),
        Function.Involutive τ ∧
        (∀ v : fixed τ hτ, v ≠ 0 →
          TraceCriterion.killingForm_value ℝ (fixed τ hτ) v v < 0) ∧
        ∃ (hs : HermitianSymmetric τ) (hp : HermitianPositive τ),
          letI c := hermitianCore τ hs hp
          letI := c.toNormedAddCommGroup
          letI := InnerProductSpace.Core.toNormedSpace (𝕜 := ℂ) (F := L)
          letI : NormedAlgebra ℝ (End L) := NormedAlgebra.restrictScalars ℝ ℂ _
          let G := identityComponent (automorphisms (fun v w : L => ⁅v, w⁆))
          let K := identityComponent (hermitianAutomorphisms (fun v w : L => ⁅v, w⁆) (fun v w => hermitian τ v w))
          G = innerGroup ∧
          IsCompact (K : Set (End L)ˣ) ∧
          velocities K = compactLieAlgebra τ hτ ∧
          ∀ (φ : Module.Dual ℂ H →ₗ[ℝ] ℝ), (∀ α ∈ rootSet_value H, φ α ≠ 0) →
            (fixed τ hτ).toSubmodule ⊔ borelReal H φ = ⊤ ∧
            flagOrbit (borel H φ) K = flagOrbit (borel H φ) innerGroup ∧
            IsCompact (flagOrbit (borel H φ) innerGroup)

end Specs.LieAlgebrasAndRepresentations.CompactFlagOrbit
