import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.SimpleHighestWeightQuotient

/-! LA-G04, source lines 3247–3260, with the conventions at lines 3107–3121.
The simple coroots are the Killing-normalized coroots of LA-U07.
The exponents are natural numbers determined by evaluation on these coroots. -/

noncomputable section

namespace Specs.LieAlgebrasAndRepresentations.DominanceNecessary

open VermaModules SimpleHighestWeightQuotient
open SerreRelations (simple)
open RootDecomposition (rootSpace_value)
open RootForm (coroot_value)
open HighestWeightData (dominantWeights_value)
open SolvableRadical (IsSemisimple_value)

universe u v

/-- Every finite-dimensional module generated by a nonzero highest vector
has dominant integral highest weight and the specified vanishing lowering powers. -/
def highest_weight_dominant_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ →
    ∀ (e f : simple H φ → L),
      (∀ i, e i ∈ rootSpace_value H i.val ∧ f i ∈ rootSpace_value H (-i.val) ∧
        e i ≠ 0 ∧ f i ≠ 0 ∧ ⁅e i, f i⁆ = (coroot_value H i.val : L)) →
    ∀ (V : Type v) [AddCommGroup V] [Module ℂ V] [LieRingModule L V] [LieModule ℂ L V]
      [FiniteDimensional ℂ V] (lam : Module.Dual ℂ H) (x : V),
      (x ≠ 0 ∧ (∀ h : H, ⁅(h : L), x⁆ = lam h • x) ∧
        (∀ z : positive_value H φ, ⁅(z : L), x⁆ = 0) ∧
        LieSubmodule.lieSpan ℂ L ({x} : Set V) = ⊤) →
      lam ∈ dominantWeights_value (fun i : simple H φ => coroot_value H i.val) ∧
      ∀ i : simple H φ, ∃ n : ℕ, lam (coroot_value H i.val) = (n : ℂ) ∧
        (LieModule.toEnd ℂ L V (f i) ^ (n + 1)) x = 0

/-- Finite dimensionality of the actual simple quotient of the Verma
module implies dominance and integrality of its inducing weight. -/
def finite_simple_quotient_dominant_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ →
    ∀ (lam : Module.Dual ℂ H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ),
      IsWeightCharacter H φ lam χ → FiniteDimensional ℂ (simpleQuotient_value H φ χ) →
      lam ∈ dominantWeights_value (fun i : simple H φ => coroot_value H i.val)

end Specs.LieAlgebrasAndRepresentations.DominanceNecessary
