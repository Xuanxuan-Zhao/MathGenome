import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.RootSystems
import Mathlib.LinearAlgebra.Reflection
import Mathlib.LinearAlgebra.Basis.Defs
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.Algebra.Group.Subgroup.Basic

/-! LA-E02: the positive system is specified by the given regular vector,
not by an existential choice of a base. All definitions include the empty case. -/
noncomputable section
namespace LieAlgebrasAndRepresentations
open Set Module
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The given vector avoids every root hyperplane. -/
def RootRegular (R : Set E) (v : E) : Prop := ∀ a ∈ R, inner ℝ v a ≠ 0

/-- The positive roots for the specified vector. -/
def positiveRoots (R : Set E) (v : E) : Set E := {a | a ∈ R ∧ 0 < inner ℝ v a}

/-- Positive roots which cannot be split into two positive roots. -/
def simpleRoots (R : Set E) (v : E) : Set E :=
  {a | a ∈ positiveRoots R v ∧
    ∀ b ∈ positiveRoots R v, ∀ c ∈ positiveRoots R v, a ≠ b + c}

/-- The orthogonal root reflection, as an invertible linear transformation.
At zero it is the identity (zero is never a root). -/
def rootReflectionEquiv (a : E) : E ≃ₗ[ℝ] E := by
  classical
  exact if h : a = 0 then LinearEquiv.refl ℝ E
  else Module.reflection (x := a) (f := (2 / inner ℝ a a) • innerₗ E a)
    (by
      change (2 / inner ℝ a a) * inner ℝ a a = 2
      exact div_mul_cancel₀ 2 (_root_.inner_self_ne_zero.mpr h))

/-- The Weyl group generated by all root reflections, acting on the ambient space. -/
def rootWeylGroup (R : Set E) : Subgroup (E ≃ₗ[ℝ] E) :=
  Subgroup.closure (rootReflectionEquiv '' R)

/-- The subgroup generated by the specified simple reflections. -/
def simpleWeylGroup (R : Set E) (v : E) : Subgroup (E ≃ₗ[ℝ] E) :=
  Subgroup.closure (rootReflectionEquiv '' simpleRoots R v)

namespace SimpleRootSpecs
universe u

def basisType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v →
    ∃ b : Basis (simpleRoots R v) ℝ E, ∀ a, b a = (a : E)

def coefficientsType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v → ∀ a ∈ R,
    ∃ c : simpleRoots R v →₀ ℤ,
      Finsupp.linearCombination ℤ (fun b : simpleRoots R v => (b : E)) c = a ∧
      ((∀ b, 0 ≤ c b) ∨ (∀ b, c b ≤ 0))

def generationType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v →
    simpleWeylGroup R v = rootWeylGroup R

def orbitType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v →
    R = {a | ∃ w : rootWeylGroup R, ∃ b ∈ simpleRoots R v, w.val b = a}

def loweringType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v →
    ∀ b ∈ positiveRoots R v, b ∉ simpleRoots R v →
      ∃ a ∈ simpleRoots R v, b - a ∈ positiveRoots R v

end SimpleRootSpecs
end LieAlgebrasAndRepresentations
