import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.InvariantRestrictionInjection
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.SimpleHighestWeightQuotient
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.IntegrableHighestWeightQuotient
import Mathlib.LinearAlgebra.Trace
import Mathlib.RingTheory.Derivation.Lie

/-! LA-H07, source lines 3813–3889. Use the symmetric algebras and the
infinitesimal and Weyl invariants from LA-H07-Injective. The trace polynomials
are characterized by evaluation on the actual simple highest-weight quotients. -/

noncomputable section

universe u v

namespace Specs.LieAlgebrasAndRepresentations.ChevalleyRestriction

open InvariantRestrictionInjection VermaModules IntegrableHighestWeightQuotient
open SimpleHighestWeightQuotient SolvableRadical VermaWeightsUniversal

attribute [local instance 100] LieRing.ofAssociativeRing

local instance {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    {H : LieSubalgebra ℂ L} {φ : Direction H} {χ : U (borel_value H φ) →ₐ[ℂ] ℂ} :
    LieRingModule L (induced_value H φ χ) := inducedLieRingModule H φ χ

local instance {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    {H : LieSubalgebra ℂ L} {φ : Direction H} {χ : U (borel_value H φ) →ₐ[ℂ] ℂ} :
    LieModule ℂ L (induced_value H φ χ) := inducedLieModule H φ χ

/-- Evaluation identifies the symmetric algebra of the dual with the
subalgebra of functions generated by the linear functions. -/
def polynomial_functions_type : Prop :=
  ∀ (E : Type u) [AddCommGroup E] [Module ℂ E] [FiniteDimensional ℂ E],
    ∃ e : PolynomialFunctions E ≃ₐ[ℂ]
      Algebra.adjoin ℂ (Set.range fun l : Module.Dual ℂ E => (l : E → ℂ)),
      ∀ p, (e p : E → ℂ) = polynomialEvaluation E p

/-- The algebra homomorphism induced by a linear map of generators. -/
def symmetricMap {E F : Type u} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F] (f : E →ₗ[ℂ] F) :
    SymmetricAlgebra ℂ E →ₐ[ℂ] SymmetricAlgebra ℂ F :=
  SymmetricAlgebra.lift ((SymmetricAlgebra.ι ℂ F).comp f)

/-- The identifications given by the Chapter 8 form, with the contragredient
adjoint action on polynomial functions and the Weyl action on the Cartan.
The linear projection fixes the Cartan and kills every nonzero root space,
so its symmetric map is the restriction used on triangular PBW symbols. -/
def form_identification_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
      (B : LinearMap.BilinForm ℂ L), B.lieInvariant L → B.Nondegenerate →
    (B.restrict H.toSubmodule).Nondegenerate ∧
    ∃ (eL : SymmetricAlgebra ℂ L ≃ₐ[ℂ] PolynomialFunctions L)
      (eH : SymmetricAlgebra ℂ H ≃ₐ[ℂ] PolynomialFunctions H)
      (p : L →ₗ[ℂ] H)
      (adS : L →ₗ⁅ℂ⁆ Derivation ℂ (SymmetricAlgebra ℂ L) (SymmetricAlgebra ℂ L)),
      (∀ x : L, eL (SymmetricAlgebra.ι ℂ L x) = SymmetricAlgebra.ι ℂ (Module.Dual ℂ L) (B x)) ∧
      (∀ h : H, eH (SymmetricAlgebra.ι ℂ H h) =
        SymmetricAlgebra.ι ℂ (Module.Dual ℂ H) (B.restrict H.toSubmodule h)) ∧
      (∀ h : H, p (h : L) = h) ∧
      (∀ α ∈ RootDecomposition.rootSet_value H, ∀ x ∈ RootDecomposition.rootSpace_value H α,
        p x = 0) ∧
      (restriction L H).comp eL.toAlgHom = eH.toAlgHom.comp (symmetricMap p) ∧
      (∀ x y : L, adS x (SymmetricAlgebra.ι ℂ L y) = SymmetricAlgebra.ι ℂ L ⁅x, y⁆) ∧
      (∀ (x y : L) (a : SymmetricAlgebra ℂ L),
        HasDerivAt (fun t : ℂ => eval (eL a) (y - t • ⁅x, y⁆))
          (eval (eL (adS x a)) y) 0) ∧
      ∀ w ∈ weylGroup L H, eH.toAlgHom.comp (symmetricMap w.toLinearMap) =
        (polynomialPullback w.symm.toLinearMap).comp eH.toAlgHom

/-- A trace of a positive power of a representation is an invariant polynomial. -/
def trace_exists_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
    {V : Type v} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]
    (ρ : L →ₗ⁅ℂ⁆ Module.End ℂ V) (m : ℕ), 0 < m →
    ∃ p : infinitesimalInvariants L, ∀ x : L,
      eval p.val x = LinearMap.trace ℂ V (ρ x ^ m)

/-- The generators are the trace polynomials of the simple quotients of
dominant integral highest weight, with a positive exponent. -/
def highestWeightTraces {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (H : LieSubalgebra ℂ L) (φ : Direction H) : Set (infinitesimalInvariants L) :=
  {p | ∃ (lam : Module.Dual ℂ H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) (m : ℕ),
    IsDominant H φ lam ∧ IsWeightCharacter H φ lam χ ∧ 0 < m ∧
    ∀ x : L, eval p.val x =
      LinearMap.trace ℂ (simpleQuotient_value H φ χ)
        (LieModule.toEnd ℂ L (simpleQuotient_value H φ χ) x ^ m)}

/-- The canonical restriction is an algebra isomorphism for every Cartan
of a finite-dimensional complex semisimple Lie algebra. -/
def chevalley_restriction_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra],
    ∃ e : infinitesimalInvariants L ≃ₐ[ℂ] weylInvariants L H,
      ∀ p, (e p : PolynomialFunctions H) = restriction L H p.val

/-- Constants and the highest-weight traces generate the invariant algebra
for every choice of positive roots. The empty root system is allowed. -/
def trace_generation_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ →
    Algebra.adjoin ℂ (highestWeightTraces H φ) = ⊤

end Specs.LieAlgebrasAndRepresentations.ChevalleyRestriction
