import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.CartanEqualsToral
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.RegularSemisimple
import Mathlib.Algebra.Group.Subgroup.Lattice

/-! LA-D07, conjugacy assertion, source lines 1914–1926, with the chapter
conventions at 1559–1565. Inner automorphisms belong to the subgroup generated
by all ordinary convergent exponentials of adjoint operators. The coordinate
norm is the same finite-dimensional norm as in the local conjugation interface.
No nonzero hypothesis is imposed. -/
universe u
namespace Specs.LieAlgebrasAndRepresentations.CartanConjugacy
variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]

noncomputable def exponentialOperator (x : L) : Module.End ℂ L :=
  letI : NormedAddCommGroup L := RegularSemisimple.algebraNorm
  letI : NormedSpace ℂ L := NormedSpace.induced ℂ L
    (Fin (Module.finrank ℂ L) → ℂ) (Module.finBasis ℂ L).equivFun
  (NormedSpace.exp (LinearMap.toContinuousLinearMap (LieAlgebra.ad ℂ L x))).toLinearMap

/-- The subgroup of linear automorphisms generated by the adjoint exponentials.
Bracket preservation is established by the implementation, not assumed here. -/
noncomputable def innerAutomorphisms_value (L : Type u) [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] : Subgroup (L ≃ₗ[ℂ] L) :=
  Subgroup.closure {e | ∃ x : L, e.toLinearMap = exponentialOperator x}

def innerAutomorphisms_type :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    Subgroup (L ≃ₗ[ℂ] L)

def cartan_conjugacy_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    SolvableRadical.IsSemisimple_value ℂ L →
    ∀ H K : LieSubalgebra ℂ L,
      CartanEqualsToral.IsCartan_value H → CartanEqualsToral.IsCartan_value K →
      ∃ e : L ≃ₗ⁅ℂ⁆ L,
        e.toLinearEquiv ∈ innerAutomorphisms_value L ∧ H.map e.toLieHom = K

end Specs.LieAlgebrasAndRepresentations.CartanConjugacy
