import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.VermaWeightsUniversal
import Mathlib.Algebra.Lie.Quotient
import Mathlib.Algebra.Lie.Sl2

/-! The quotient by the simple lowering-power relations in Lemma 7.6
(`supp:local-integrability`). The rank-one assertion uses restriction to the
embedded subalgebra generated by the corresponding normalized triple. -/

noncomputable section

namespace Specs.LieAlgebrasAndRepresentations.IntegrableHighestWeightQuotient

open VermaModules VermaWeightsUniversal HighestWeightData SerreRelations RootDecomposition RootForm
open SolvableRadical (IsSemisimple_value)
open UniversalEnvelopingAlgebra (ι)
open scoped Classical

universe u

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
variable (H : LieSubalgebra ℂ L) (φ : Direction H)
variable (χ : U (borel_value H φ) →ₐ[ℂ] ℂ)

abbrev coroots (i : simple H φ) : H := coroot_value H i.val

abbrev IsDominant (lam : Module.Dual ℂ H) : Prop :=
  lam ∈ dominantWeights_value (coroots H φ)

/-- The chosen simple root vectors are normalized using the Killing coroots. -/
def Normalized (e f : simple H φ → L) : Prop :=
  ∀ i, e i ∈ rootSpace_value H i.val ∧ f i ∈ rootSpace_value H (-i.val) ∧
    e i ≠ 0 ∧ f i ≠ 0 ∧ ⁅e i, f i⁆ = (coroots H φ i : L)

/-- The natural number `λ(hᵢ)`, well-defined for dominant integral `λ`. -/
def simpleCoordinate {lam : Module.Dual ℂ H} (hd : IsDominant H φ lam)
    (i : simple H φ) : ℕ :=
  Classical.choose (show ∃ n : ℕ, lam (coroots H φ i) = (n : ℂ) from hd i)

local instance : LieRingModule L (induced_value H φ χ) := inducedLieRingModule H φ χ
local instance : LieModule ℂ L (induced_value H φ χ) := inducedLieModule H φ χ

/-- The left enveloping submodule generated by the simple lowering powers,
viewed as a Lie submodule of the Verma module. -/
def relationSubmodule_value {lam : Module.Dual ℂ H} (hd : IsDominant H φ lam)
    (f : simple H φ → L) : LieSubmodule ℂ L (induced_value H φ χ) where
  __ := (Submodule.span (U L) (Set.range fun i =>
    (ι ℂ (f i)) ^ (simpleCoordinate H φ hd i + 1) • highestVector_value H φ χ)).restrictScalars ℂ
  lie_mem {x m} hm := by
    change (ι ℂ x) • m ∈ Submodule.span (U L) _
    exact Submodule.smul_mem _ _ hm

abbrev quotient_value {lam : Module.Dual ℂ H} (hd : IsDominant H φ lam)
    (f : simple H φ → L) :=
  induced_value H φ χ ⧸ relationSubmodule_value H φ χ hd f

abbrev highestClass (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) {lam : Module.Dual ℂ H}
    (hd : IsDominant H φ lam) (f : simple H φ → L) : quotient_value H φ χ hd f :=
  LieSubmodule.Quotient.mk' (relationSubmodule_value H φ χ hd f) (highestVector_value H φ χ)

def rankOne_value (e f : simple H φ → L) (i : simple H φ) : LieSubalgebra ℂ L :=
  LieSubalgebra.lieSpan ℂ L {e i, f i, (coroots H φ i : L)}

def relationSubmodule_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (H : LieSubalgebra ℂ L) (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ)
    {lam : Module.Dual ℂ H}, IsDominant H φ lam →
    (simple H φ → L) → LieSubmodule ℂ L (induced_value H φ χ)

def quotient_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (H : LieSubalgebra ℂ L) (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ)
    {lam : Module.Dual ℂ H}, IsDominant H φ lam → (simple H φ → L) → Type u

def rankOne_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (H : LieSubalgebra ℂ L) (φ : Direction H),
    (simple H φ → L) → (simple H φ → L) → simple H φ → LieSubalgebra ℂ L

def quotient_integrable_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ → ∀ (lam : Module.Dual ℂ H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ), IsWeightCharacter H φ lam χ →
    ∀ (hd : IsDominant H φ lam) (e f : simple H φ → L), Normalized H φ e f →
    let Q := quotient_value H φ χ hd f
    let v := highestClass H φ χ hd f
    let W := weightSpace_value Q H
    v ≠ 0 ∧ W lam = ℂ ∙ v ∧ DirectSum.IsInternal W ∧
    (∀ i (x : Q), ∃ a b : ℕ,
      (LieModule.toEnd ℂ L Q (e i) ^ a) x = 0 ∧
      (LieModule.toEnd ℂ L Q (f i) ^ b) x = 0) ∧
    ∀ i (x : Q), ∃ S : LieSubmodule ℂ (rankOne_value H φ e f i) Q,
      x ∈ S ∧ FiniteDimensional ℂ S

end Specs.LieAlgebrasAndRepresentations.IntegrableHighestWeightQuotient
