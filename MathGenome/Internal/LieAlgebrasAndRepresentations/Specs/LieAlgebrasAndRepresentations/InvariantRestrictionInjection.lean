import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.CartanConjugacy
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.RootStrings
import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
import Mathlib.Analysis.Calculus.Deriv.Mul

/-!
LA-H07-Injective: the first paragraph of the proof of Chevalley restriction,
source lines 3824–3856. Polynomial functions are the actual symmetric algebra
of the linear dual, not arbitrary functions. Infinitesimal invariance is the
vanishing directional derivative in every adjoint direction (the sign in the
contragredient action does not affect its kernel). The Weyl group on H is the
subgroup generated by the primal root reflections. No nonzero-rank assumption
is made. The surjectivity and generation paragraph belongs to later goals.
-/
universe u
namespace Specs.LieAlgebrasAndRepresentations.InvariantRestrictionInjection

abbrev PolynomialFunctions (E : Type u) [AddCommGroup E] [Module ℂ E] :=
  SymmetricAlgebra ℂ (Module.Dual ℂ E)

/-- Evaluation of a symmetric tensor as a polynomial function. -/
def polynomialEvaluation (E : Type u) [AddCommGroup E] [Module ℂ E] :
    PolynomialFunctions E →ₐ[ℂ] (E → ℂ) :=
  SymmetricAlgebra.lift
    { toFun := fun l => (l : E → ℂ)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }

abbrev eval {E : Type u} [AddCommGroup E] [Module ℂ E]
    (p : PolynomialFunctions E) (x : E) : ℂ := polynomialEvaluation E p x

/-- Pullback of polynomial functions along a linear map. -/
def polynomialPullback {E F : Type u} [AddCommGroup E] [Module ℂ E]
    [AddCommGroup F] [Module ℂ F] (a : E →ₗ[ℂ] F) :
    PolynomialFunctions F →ₐ[ℂ] PolynomialFunctions E :=
  SymmetricAlgebra.lift ((SymmetricAlgebra.ι ℂ (Module.Dual ℂ E)).comp a.dualMap)

variable (L : Type u) [LieRing L] [LieAlgebra ℂ L]

def InfinitesimalInvariant (p : PolynomialFunctions L) : Prop :=
  ∀ x y : L, HasDerivAt (fun t : ℂ => eval p (y + t • ⁅x, y⁆)) 0 0

/-- The source S(L*)^L, using the derivative definition of the adjoint action. -/
def infinitesimalInvariants : Subalgebra ℂ (PolynomialFunctions L) where
  carrier := {p | InfinitesimalInvariant L p}
  zero_mem' := by intro x y; simpa [eval] using (hasDerivAt_const (0 : ℂ) (0 : ℂ))
  one_mem' := by intro x y; simpa [eval] using (hasDerivAt_const (0 : ℂ) (1 : ℂ))
  add_mem' := by
    intro p q hp hq x y
    convert (hp x y).add (hq x y) using 1 <;> simp [eval] <;> rfl
  mul_mem' := by
    intro p q hp hq x y
    convert (hp x y).mul (hq x y) using 1 <;> simp [eval] <;> rfl
  algebraMap_mem' := by
    intro c x y
    simpa [eval] using (hasDerivAt_const (0 : ℂ) c)

variable [FiniteDimensional ℂ L]

def ExponentialInvariant (p : PolynomialFunctions L) : Prop :=
  ∀ x y : L, eval p (CartanConjugacy.exponentialOperator x y) = eval p y

def InnerInvariant (p : PolynomialFunctions L) : Prop :=
  ∀ e ∈ CartanConjugacy.innerAutomorphisms_value L, ∀ y : L, eval p (e y) = eval p y

/-- Primal reflections generate the Weyl group; their action on the dual is
β ↦ β - β(h_α)α, as in RootStrings.reflection_value. -/
def weylGroup (H : LieSubalgebra ℂ L) : Subgroup (H ≃ₗ[ℂ] H) :=
  Subgroup.closure {s | ∃ α ∈ RootDecomposition.rootSet_value H,
    ∀ h : H, s h = h - α h • RootForm.coroot_value H α}

def weylInvariants (H : LieSubalgebra ℂ L) : Subalgebra ℂ (PolynomialFunctions H) where
  carrier := {p | ∀ s ∈ weylGroup L H, ∀ h : H, eval p (s h) = eval p h}
  zero_mem' := by intro s hs h; simp [eval]
  one_mem' := by intro s hs h; simp [eval]
  add_mem' := by intro p q hp hq s hs h; simpa [eval] using congrArg₂ (· + ·) (hp s hs h) (hq s hs h)
  mul_mem' := by intro p q hp hq s hs h; simpa [eval] using congrArg₂ (· * ·) (hp s hs h) (hq s hs h)
  algebraMap_mem' := by intro c s hs h; simp [eval]

/-- The canonical restriction on the entire symmetric algebra. -/
def restriction (H : LieSubalgebra ℂ L) :
    PolynomialFunctions L →ₐ[ℂ] PolynomialFunctions H :=
  polynomialPullback H.toSubmodule.subtype

def infinitesimal_iff_exponentials_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (p : PolynomialFunctions L), InfinitesimalInvariant L p ↔ ExponentialInvariant L p

def infinitesimal_iff_inner_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L]
    (p : PolynomialFunctions L), InfinitesimalInvariant L p ↔ InnerInvariant L p

def restriction_weyl_invariant_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    SolvableRadical.IsSemisimple_value ℂ L →
    ∀ H : LieSubalgebra ℂ L, MaximalTori.IsMaximalToral_value H →
    ∀ p : PolynomialFunctions L, InfinitesimalInvariant L p →
      restriction L H p ∈ weylInvariants L H

/-- Construct the actual canonical algebra map, with its value specified on
every invariant polynomial, and prove injectivity. Existence is stated with a
witness because this conditional draft must not define a closed original map. -/
def invariant_restriction_injective_type : Prop :=
  ∀ (L : Type u) [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    SolvableRadical.IsSemisimple_value ℂ L →
    ∀ H : LieSubalgebra ℂ L, MaximalTori.IsMaximalToral_value H →
    ∃ r : infinitesimalInvariants L →ₐ[ℂ] weylInvariants L H,
      (∀ p, (r p : PolynomialFunctions H) = restriction L H p.val) ∧
      Function.Injective r

end Specs.LieAlgebrasAndRepresentations.InvariantRestrictionInjection
