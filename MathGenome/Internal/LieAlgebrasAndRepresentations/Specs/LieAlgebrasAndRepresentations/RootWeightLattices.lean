import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.DominantFundamentalDomain
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.ExceptionalCoordinateE
import Mathlib.LinearAlgebra.BilinearForm.DualLattice
import Mathlib.LinearAlgebra.Basis.SMul
import Mathlib.LinearAlgebra.Basis.Submodule
import Mathlib.LinearAlgebra.FreeModule.Finite.CardQuotient

/-! res:E07, source lines 2375–2407. Lattices are actual integer submodules
of the given real Euclidean space; duality uses its given inner product.
All finite index types, including the empty type, are allowed. -/
noncomputable section
namespace LieAlgebrasAndRepresentations
open Set Module
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable {ι : Type*}

lemma euclideanPairing_nondegenerate : (innerₗ E).Nondegenerate := by
  constructor
  · intro x hx
    exact inner_self_eq_zero.mp (hx x)
  · intro x hx
    exact inner_self_eq_zero.mp (hx x)

/-- The simple coroot basis, with the source's normalization. -/
def simpleCorootBasis (b : Basis ι ℝ E) : Basis ι ℝ E :=
  b.isUnitSMul (w := fun i => 2 / inner ℝ (b i) (b i)) (fun i => isUnit_iff_ne_zero.mpr
    (div_ne_zero (by norm_num) (inner_self_ne_zero.mpr (b.ne_zero i))))

@[simp] lemma simpleCorootBasis_apply (b : Basis ι ℝ E) (i : ι) :
    simpleCorootBasis b i = coroot (b i) := by
  rw [simpleCorootBasis, Basis.isUnitSMul_apply]
  rfl

/-- Q, generated by the simple roots. -/
def rootLattice (b : Basis ι ℝ E) : Submodule ℤ E := Submodule.span ℤ (Set.range b)
/-- Q∨, generated by the simple coroots. -/
def corootLattice (b : Basis ι ℝ E) : Submodule ℤ E :=
  Submodule.span ℤ (Set.range (simpleCorootBasis b))
/-- P = (Q∨)*. -/
def weightLattice (b : Basis ι ℝ E) : Submodule ℤ E :=
  LinearMap.BilinForm.dualSubmodule (innerₗ E) (corootLattice b)
/-- P∨ = Q*. -/
def coweightLattice (b : Basis ι ℝ E) : Submodule ℤ E :=
  LinearMap.BilinForm.dualSubmodule (innerₗ E) (rootLattice b)

/-- The inner-product dual basis to the simple coroots. -/
def fundamentalWeights [Finite ι] [DecidableEq ι] (b : Basis ι ℝ E) : Basis ι ℝ E :=
  LinearMap.BilinForm.dualBasis (innerₗ E) euclideanPairing_nondegenerate (simpleCorootBasis b)

namespace RootWeightLatticeSpecs
universe u w

def inclusionsType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} (R : Set E), IsRootSystem R → ∀ v, RootRegular R v →
  ∀ b : Basis ι ℝ E, IsSimpleBasis R v b →
    rootLattice b ≤ weightLattice b ∧ corootLattice b ≤ coweightLattice b

def fundamentalPairingType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} [Finite ι] [DecidableEq ι] (b : Basis ι ℝ E),
    (∀ i j, inner ℝ (fundamentalWeights b i) (coroot (b j)) = if i = j then 1 else 0) ∧
    ∀ i x, (∀ j, inner ℝ x (coroot (b j)) = if i = j then 1 else 0) →
      x = fundamentalWeights b i

def weightBasisType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} [Finite ι] [DecidableEq ι] (b : Basis ι ℝ E),
    ∃ bP : Basis ι ℤ (weightLattice b), ∀ i, (bP i : E) = fundamentalWeights b i

def dominantType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} [Fintype ι] [DecidableEq ι] (R : Set E),
  IsRootSystem R → ∀ v, RootRegular R v → ∀ b : Basis ι ℝ E,
  IsSimpleBasis R v b → ∀ x : E,
    (x ∈ weightLattice b ∧ x ∈ closedSimpleChamber R v) ↔
      ∃ n : ι → ℕ, x = ∑ i, (n i : ℝ) • fundamentalWeights b i

def orbitType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ (R : Set E), IsRootSystem R → ∀ v, RootRegular R v → ∀ x : E,
    ∃! y : E, y ∈ closedSimpleChamber R v ∧ ∃ w : rootWeylGroup R, w.val x = y

def indexType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} [Fintype ι] [DecidableEq ι] (R : Set E),
  IsRootSystem R → ∀ v, RootRegular R v → ∀ b : Basis ι ℝ E,
  IsSimpleBasis R v b →
    (((rootLattice b).toAddSubgroup.relIndex (weightLattice b).toAddSubgroup : ℕ) : ℝ) =
      (cartanMatrix b).det

/-- The rank-zero determinant, independently of an inhabited ambient space. -/
def rankZeroType : Prop :=
  ∀ {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E],
  ∀ {ι : Type w} [Fintype ι] [DecidableEq ι] [IsEmpty ι] (b : Basis ι ℝ E),
    (cartanMatrix b).det = 1

def classicalDeterminantsType : Prop :=
  (∀ n : ℕ, 1 ≤ n → (cartanMatrix (ClassicalCoordinates.simpleA n)).det = (n + 1 : ℝ)) ∧
  (∀ n : ℕ, 2 ≤ n → (cartanMatrix (ClassicalCoordinates.simpleB n)).det = 2) ∧
  (∀ n : ℕ, 2 ≤ n → (cartanMatrix (ClassicalCoordinates.simpleC n)).det = 2) ∧
  (∀ n : ℕ, 4 ≤ n → (cartanMatrix (ClassicalCoordinates.simpleD n)).det = 4)

def exceptionalDeterminantsType : Prop :=
  (cartanMatrix ExceptionalE.e6Simple).det = 3 ∧
  (cartanMatrix ExceptionalE.e7Simple).det = 2 ∧
  (cartanMatrix ExceptionalE.e8Simple).det = 1 ∧
  (cartanMatrix ExceptionalGF.f4Simple).det = 1 ∧
  (cartanMatrix ExceptionalGF.g2Simple).det = 1

end RootWeightLatticeSpecs
end LieAlgebrasAndRepresentations
