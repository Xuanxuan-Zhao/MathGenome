import Mathlib.Analysis.Normed.Algebra.Exponential
import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.Geometry.Manifold.Instances.UnitsOfNormedAlgebra
import Mathlib.Geometry.Manifold.MFDeriv.Basic
import Mathlib.Geometry.Manifold.GroupLieAlgebra
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Topology.Algebra.Group.Subgroup
import Mathlib.Topology.Algebra.Group.Units

/-!
LA-closed-matrix-groups: notes/005/lie-algebras-and-representations.tex,
lemma `supp:closed-matrix-groups`, lines 2857–2892.

We use units of the continuous endomorphism algebra for GL(V). In finite
dimension every linear map is continuous; `Module.End.toContinuousLinearMap`
is the algebra equivalence with the algebraic endomorphism algebra. The
operator norm gives the ordinary finite-dimensional matrix topology.
No nonzero dimension, connectedness or compactness assumption is made.

The supporting definitions work for a real Banach algebra. The final
statement specializes them to the endomorphisms of every finite-dimensional
real normed vector space. Every finite-dimensional real vector space can
be normed, and any such norm gives the same finite-dimensional topology.
-/

noncomputable section

open scoped Manifold ContDiff

namespace LieAlgebrasAndRepresentations.ClosedMatrixGroups

variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The matrix exponential as a unit, with inverse exp(-X). -/
def expUnit (X : A) : Aˣ :=
  letI : NormedAlgebra ℚ A := NormedAlgebra.restrictScalars ℚ ℝ A
  @unitOfInvertible A _ (NormedSpace.exp X) (NormedSpace.invertibleExp X)

/-- All infinitesimal generators whose entire real one-parameter subgroup
lies in H. The quantifier includes negative and zero times. -/
def velocities (H : Subgroup Aˣ) : Set A :=
  {X | ∀ t : ℝ, expUnit (t • X) ∈ H}

/-- The exponential of a velocity, regarded as an element of H. -/
def expIn (H : Subgroup Aˣ) (X : velocities H) : H :=
  ⟨expUnit X.val, by simpa using X.property (1 : ℝ)⟩

/-- The subgroup generated by all exponentials, inside H with its subspace
topology. This is algebraic subgroup generation, without taking closure. -/
def exponentialSubgroup (H : Subgroup Aˣ) : Subgroup H :=
  Subgroup.closure (Set.range (expIn H))

/-- A smooth embedded matrix Lie group modeled on the claimed Lie algebra.
The topology on H remains its subtype topology. The differential of the
inclusion at the identity has exactly S as its range, identifying the
tangent Lie algebra with the commutator subalgebra S of A. -/
structure EmbeddedLieGroup (H : Subgroup Aˣ) (S : LieSubalgebra ℝ A) where
  charts : ChartedSpace S H
  manifold : @IsManifold ℝ _ S _ _ S _ (𝓘(ℝ, S)) (∞) H _ charts
  group_smooth : @LieGroup ℝ _ S _ S _ _ (𝓘(ℝ, S)) (∞) H _ _ charts
  inclusion_smooth :
    letI := charts
    ContMDiff (𝓘(ℝ, S)) (𝓘(ℝ, A)) ∞ (fun h : H => ((h : Aˣ) : A))
  tangent_inclusion :
    letI := charts
    mfderiv (𝓘(ℝ, S)) (𝓘(ℝ, A)) (fun h : H => ((h : Aˣ) : A)) 1
      = S.toSubmodule.subtypeL
  /-- The canonical bracket from left invariant vector fields is the
  commutator bracket under the differential of the inclusion. -/
  tangent_bracket :
    letI := charts
    letI := group_smooth
    ∀ X Y : GroupLieAlgebra (𝓘(ℝ, S)) H,
      (mfderiv (𝓘(ℝ, S)) (𝓘(ℝ, A)) (fun h : H => ((h : Aˣ) : A)) 1
        (VectorField.mlieBracket (𝓘(ℝ, S))
          (mulInvariantVectorField X) (mulInvariantVectorField Y) 1) : A) =
      (fun a b : A => a * b - b * a)
        (mfderiv (𝓘(ℝ, S)) (𝓘(ℝ, A)) (fun h : H => ((h : Aˣ) : A)) 1 X)
        (mfderiv (𝓘(ℝ, S)) (𝓘(ℝ, A)) (fun h : H => ((h : Aˣ) : A)) 1 Y)
  tangent_range :
    letI := charts
    LinearMap.range
      (mfderiv (𝓘(ℝ, S)) (𝓘(ℝ, A)) (fun h : H => ((h : Aˣ) : A)) 1).toLinearMap
        = S.toSubmodule

end LieAlgebrasAndRepresentations.ClosedMatrixGroups

namespace Specs.LieAlgebrasAndRepresentations.ClosedMatrixGroups

open _root_.LieAlgebrasAndRepresentations.ClosedMatrixGroups

attribute [local instance 100] LieRing.ofAssociativeRing

def velocities_closed_type : Prop :=
  ∀ {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]
    (H : Subgroup Aˣ), IsClosed (H : Set Aˣ) → IsClosed (velocities H)

/-- The infinitesimal generators form the asserted closed real Lie subalgebra. -/
def velocities_lieSubalgebra_type : Prop :=
  ∀ {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]
    (H : Subgroup Aˣ), IsClosed (H : Set Aˣ) →
    ∃ S : LieSubalgebra ℝ A, (S : Set A) = velocities H ∧ IsClosed (S : Set A)

/-- The generation assertion in the original subgroup topology. -/
def exponentialSubgroup_eq_identityComponent_type : Prop :=
  ∀ {A : Type*} [NormedRing A] [NormedAlgebra ℝ A] [CompleteSpace A]
    [FiniteDimensional ℝ A] (H : Subgroup Aˣ), IsClosed (H : Set Aˣ) →
    exponentialSubgroup H = Subgroup.connectedComponentOfOne H

/-- The complete source conclusion. The finite-dimensional model is the
actual closed commutator Lie subalgebra, and the last equality is the
identity component in H, not the ambient GL(V). -/
def closed_matrix_group_type : Prop :=
  ∀ {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
    (H : Subgroup (V →L[ℝ] V)ˣ), IsClosed (H : Set (V →L[ℝ] V)ˣ) →
    ∃ S : LieSubalgebra ℝ (V →L[ℝ] V),
      (S : Set (V →L[ℝ] V)) = velocities H ∧
      IsClosed (S : Set (V →L[ℝ] V)) ∧
      FiniteDimensional ℝ S ∧
      Nonempty (EmbeddedLieGroup H S) ∧
      exponentialSubgroup H = Subgroup.connectedComponentOfOne H

end Specs.LieAlgebrasAndRepresentations.ClosedMatrixGroups
