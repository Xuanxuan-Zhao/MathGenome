import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.Sl2Model
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.VermaModules
import MathGenome.Internal.FourVolumeAlgebra.Specs.Shared.Lie.UniversalEnveloping
import Mathlib.Algebra.DirectSum.Module
import Mathlib.Algebra.Lie.Abelian
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-! LA-J09, the infinite-dimensional example at lines 5378–5387.
The weight-zero Verma module uses the left-ideal presentation of LA-G01. -/

noncomputable section

open scoped Classical

namespace Specs.LieAlgebrasAndRepresentations.InfiniteDimensionalBoundary

open Sl2Model UniversalEnvelopingAlgebra
open _root_.Shared.Lie
attribute [local instance 100] LieRing.ofAssociativeRing

universe u

variable (k : Type u) [Field k]

abbrev Env := _root_.Shared.Lie.U k (Model k)

/-- At highest weight zero the defining left ideal is generated by `h` and `e`. -/
def definingIdeal : Submodule (Env k) (Env k) :=
  Submodule.span (Env k) ({ι k (H k), ι k (E k)} : Set (Env k))

abbrev VermaZero := Env k ⧸ definingIdeal k

def vermaZeroType := ∀ (k : Type u) [Field k], Type u

abbrev representation : Representation k (Model k) (VermaZero k) :=
  ((Algebra.lsmul k k (VermaZero k) : Env k →ₐ[k] Module.End k (VermaZero k)) :
    Env k →ₗ⁅k⁆ Module.End k (VermaZero k)).comp (ι k)

instance : LieRingModule (Model k) (VermaZero k) :=
  representationLieRingModule k (Model k) _ (representation k)

instance : LieModule k (Model k) (VermaZero k) :=
  representationLieModule k (Model k) _ (representation k)

def highest : VermaZero k := (definingIdeal k).mkQ 1

def highestType := ∀ (k : Type u) [Field k], VermaZero k

def loweringStringType := ∀ (k : Type u) [Field k], ℕ → VermaZero k

def loweringString (j : ℕ) : VermaZero k := (ι k (F k)) ^ j • highest k

abbrev TrivialLine := TrivialLieModule k (Model k) k

def negativeStringBasisType : Prop :=
  ∀ (k : Type u) [Field k], ∃ b : Module.Basis ℕ k (VermaZero k),
    ∀ j, b j = loweringString k j

def infiniteDimensionType : Prop :=
  ∀ (k : Type u) [Field k], LinearIndependent k (loweringString k) ∧
    ¬ FiniteDimensional k (VermaZero k)

def zeroWeightType : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k],
    (∀ m : VermaZero k, ⁅H k, m⁆ = 0 ↔ ∃ a : k, m = a • highest k) ∧
    ⁅F k, highest k⁆ ≠ 0

def nonsplitQuotientType : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k],
    ∃ q : VermaZero k →ₗ⁅k, Model k⁆ TrivialLine k,
      Function.Surjective q ∧
      q (highest k) = (show TrivialLine k from (1 : k)) ∧
      (∀ j : ℕ, q (loweringString k (j + 1)) = 0) ∧
      LieModule.IsIrreducible k (Model k) (TrivialLine k) ∧
      ¬ ∃ s : TrivialLine k →ₗ⁅k, Model k⁆ VermaZero k, Function.RightInverse s q

def noInvariantComplementType : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k],
    FiniteDimensional k (Model k) ∧ SolvableRadical.IsSemisimple_value k (Model k) ∧
    ∃ W : LieSubmodule k (Model k) (VermaZero k),
      ¬ ∃ C : LieSubmodule k (Model k) (VermaZero k), IsCompl W C

def noSimpleDecompositionType : Prop :=
  ∀ (k : Type u) [Field k] [CharZero k],
    ∀ S : Set (LieSubmodule k (Model k) (VermaZero k)),
      (∀ W ∈ S, LieModule.IsIrreducible k (Model k) W) →
      ¬ DirectSum.IsInternal (fun W : S => W.val.toSubmodule)

section ComplexComparison

open VermaModules

/-- The diagonal Cartan line in the standard complex matrix model. -/
def diagonalCartan : LieSubalgebra ℂ (Model ℂ) :=
  { (ℂ ∙ H ℂ : Submodule ℂ (Model ℂ)) with
    lie_mem' := by
      intro x y hx hy
      obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
      obtain ⟨b, rfl⟩ := Submodule.mem_span_singleton.mp hy
      simp }

abbrev diagonalGenerator : diagonalCartan :=
  ⟨H ℂ, Submodule.mem_span_singleton_self _⟩

/-- The positive direction is evaluation at `h`, followed by real part. -/
def standardDirection : Direction diagonalCartan :=
  Complex.reLm.comp ((Module.Dual.eval ℂ diagonalCartan diagonalGenerator).restrictScalars ℝ)

abbrev trivialCharacter : U (borel_value diagonalCartan standardDirection) →ₐ[ℂ] ℂ :=
  augmentation ℂ _

def complexInducedType : Prop :=
  diagonalCartan.IsCartanSubalgebra ∧ Regular diagonalCartan standardDirection ∧
    IsWeightCharacter diagonalCartan standardDirection 0 trivialCharacter ∧
    ∃ T : VermaZero ℂ ≃ₗ[Env ℂ]
        induced_value diagonalCartan standardDirection trivialCharacter,
      ∀ a : Env ℂ, T ((definingIdeal ℂ).mkQ a) =
        tensorClass diagonalCartan standardDirection trivialCharacter a 1

end ComplexComparison

end Specs.LieAlgebrasAndRepresentations.InfiniteDimensionalBoundary
