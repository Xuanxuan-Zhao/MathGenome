import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.SerreRelations
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.RealRootSpace
import Mathlib.Algebra.Lie.UniversalEnveloping
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.LinearAlgebra.TensorProduct.Tower
import Mathlib.LinearAlgebra.Quotient.Basic

/-! The triangular multiplication and induced highest-weight module of LA-G01. -/

noncomputable section

open scoped TensorProduct

namespace Specs.LieAlgebrasAndRepresentations.VermaModules

open RootDecomposition SerreRelations
open MaximalTori SolvableRadical
open UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

universe u

variable {L : Type u} [LieRing L] [LieAlgebra ℂ L]

abbrev U (K : Type u) [LieRing K] [LieAlgebra ℂ K] := UniversalEnvelopingAlgebra ℂ K

abbrev Direction (H : LieSubalgebra ℂ L) := Module.Dual ℂ H →ₗ[ℝ] ℝ

def Regular (H : LieSubalgebra ℂ L) (φ : Direction H) : Prop :=
  ∀ α ∈ rootSet_value H, φ α ≠ 0

/-- Lie subalgebra generated by the weight spaces whose value under `φ` lies in `s`. -/
def rootPart (H : LieSubalgebra ℂ L) (φ : Direction H) (s : Set ℝ) :
    LieSubalgebra ℂ L :=
  LieSubalgebra.lieSpan ℂ L {x | ∃ α : Module.Dual ℂ H, φ α ∈ s ∧ x ∈ rootSpace_value H α}

def negative_value (H : LieSubalgebra ℂ L) (φ : Direction H) : LieSubalgebra ℂ L :=
  rootPart H φ (Set.Iio 0)

def positive_value (H : LieSubalgebra ℂ L) (φ : Direction H) : LieSubalgebra ℂ L :=
  rootPart H φ (Set.Ioi 0)

def borel_value (H : LieSubalgebra ℂ L) (φ : Direction H) : LieSubalgebra ℂ L :=
  H ⊔ positive_value H φ

def negative_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (_φ : Direction H), LieSubalgebra ℂ L

def positive_type := negative_type.{u}
def borel_type := negative_type.{u}

def envelopingMap {K G : Type u} [LieRing K] [LieAlgebra ℂ K]
    [LieRing G] [LieAlgebra ℂ G] (f : K →ₗ⁅ℂ⁆ G) : U K →ₐ[ℂ] U G :=
  lift ℂ ((ι ℂ).comp f)

def multiply {P Q G : Type u} [LieRing P] [LieAlgebra ℂ P] [LieRing Q] [LieAlgebra ℂ Q]
    [LieRing G] [LieAlgebra ℂ G] (f : P →ₗ⁅ℂ⁆ G) (g : Q →ₗ⁅ℂ⁆ G) :
    U P ⊗[ℂ] U Q →ₗ[ℂ] U G :=
  (LinearMap.mul' ℂ (U G)).comp
    (TensorProduct.map (envelopingMap f).toLinearMap (envelopingMap g).toLinearMap)

def triangular_value (H : LieSubalgebra ℂ L) (φ : Direction H) :
    U (negative_value H φ) ⊗[ℂ] (U H ⊗[ℂ] U (positive_value H φ)) →ₗ[ℂ] U L :=
  (multiply (negative_value H φ).incl (borel_value H φ).incl).comp
    (TensorProduct.map LinearMap.id (multiply
      (LieSubalgebra.inclusion (show H ≤ borel_value H φ from le_sup_left))
      (LieSubalgebra.inclusion (show positive_value H φ ≤ borel_value H φ from le_sup_right))))

def triangular_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (φ : Direction H),
    U (negative_value H φ) ⊗[ℂ] (U H ⊗[ℂ] U (positive_value H φ)) →ₗ[ℂ] U L

/-- The specified one-dimensional representation, as its enveloping-algebra character. -/
def IsWeightCharacter (H : LieSubalgebra ℂ L) (φ : Direction H) (μ : Module.Dual ℂ H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) : Prop :=
  (∀ h : H, χ (ι ℂ (LieSubalgebra.inclusion
    (show H ≤ borel_value H φ from le_sup_left) h)) = μ h) ∧
  (∀ x : positive_value H φ, χ (ι ℂ (LieSubalgebra.inclusion
    (show positive_value H φ ≤ borel_value H φ from le_sup_right) x)) = 0)

/-- The left `U(b)`-action on the one-dimensional complex vector space. -/
@[instance_reducible]
def weightModule_value (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) : Module (U (borel_value H φ)) ℂ :=
  Module.compHom ℂ χ.toRingHom

def weightModule_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (φ : Direction H), (U (borel_value H φ) →ₐ[ℂ] ℂ) →
    Module (U (borel_value H φ)) ℂ

/-- Start with the scalar tensor product. Its left action is on the first factor.
The relations impose balancing for right multiplication by `U(b)` and the
left action on `ℂ_λ` given by the character. -/
def balance (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) : Submodule (U L) (U L ⊗[ℂ] ℂ) :=
  Submodule.span (U L)
    {z | ∃ (a : U L) (b : U (borel_value H φ)) (c : ℂ),
      z = (a * envelopingMap (borel_value H φ).incl b) ⊗ₜ[ℂ] c -
        a ⊗ₜ[ℂ] (χ b * c)}

abbrev induced_value (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) :=
  (U L ⊗[ℂ] ℂ) ⧸ balance H φ χ

def induced_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (φ : Direction H), (U (borel_value H φ) →ₐ[ℂ] ℂ) → Type u

abbrev tensorClass (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) (a : U L) (c : ℂ) : induced_value H φ χ :=
  (balance H φ χ).mkQ (a ⊗ₜ[ℂ] c)

def highestVector_value (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) : induced_value H φ χ :=
  tensorClass H φ χ 1 1

def highestVector_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (φ : Direction H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ),
    induced_value H φ χ

/-- The sum of the indicated principal left ideals in `U(g)`. -/
def definingIdeal_value (H : LieSubalgebra ℂ L) (φ : Direction H) (μ : Module.Dual ℂ H)
    (e : simple H φ → L) : Submodule (U L) (U L) :=
  Submodule.span (U L)
    (Set.range (fun h : H => ι ℂ (h : L) - algebraMap ℂ (U L) (μ h)) ∪
      Set.range (fun i => ι ℂ (e i)))

def definingIdeal_type := ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L]
  (H : LieSubalgebra ℂ L) (φ : Direction H) (_μ : Module.Dual ℂ H),
    (simple H φ → L) → Submodule (U L) (U L)

/-- In particular the functional of a regular vector in the Killing-induced real
root space gives a direction of the type used here and in the Serre relations. -/
def direction_from_real_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L] (H : LieSubalgebra ℂ L)
    (ℓ : RealRootSpace.E H →ₗ[ℝ] ℝ),
    (∀ x ∈ RealRootSpace.realRoots H, ℓ x ≠ 0) →
    ∃ φ : Direction H, Regular H φ ∧
      ∀ α : Module.Dual ℂ H, φ α = ℓ (RealRootSpace.rootRestriction H α)

def triangular_apply_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] (H : LieSubalgebra ℂ L) (φ : Direction H)
    (a : U (negative_value H φ)) (h : U H) (b : U (positive_value H φ)),
    triangular_value H φ (a ⊗ₜ[ℂ] (h ⊗ₜ[ℂ] b)) =
      envelopingMap (negative_value H φ).incl a * envelopingMap H.incl h *
        envelopingMap (positive_value H φ).incl b

def weight_action_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] (H : LieSubalgebra ℂ L) (φ : Direction H)
    (μ : Module.Dual ℂ H) (χ : U (borel_value H φ) →ₐ[ℂ] ℂ), IsWeightCharacter H φ μ χ →
    letI := weightModule_value H φ χ
    (∀ h : H, ∀ c : ℂ, (ι ℂ (LieSubalgebra.inclusion
      (show H ≤ borel_value H φ from le_sup_left) h)) • c = μ h * c) ∧
    (∀ x : positive_value H φ, ∀ c : ℂ, (ι ℂ (LieSubalgebra.inclusion
      (show positive_value H φ ≤ borel_value H φ from le_sup_right) x)) • c = 0)

def tensor_balanced_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] (H : LieSubalgebra ℂ L) (φ : Direction H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ) (a : U L) (b : U (borel_value H φ)) (c : ℂ),
    tensorClass H φ χ (a * envelopingMap (borel_value H φ).incl b) c =
      tensorClass H φ χ a (χ b * c)

def triangular_bijective_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ → Function.Bijective (triangular_value H φ)

def character_existsUnique_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ → ∀ μ : Module.Dual ℂ H,
    ∃! χ, IsWeightCharacter H φ μ χ

def induced_presentation_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ → ∀ (μ : Module.Dual ℂ H)
    (χ : U (borel_value H φ) →ₐ[ℂ] ℂ), IsWeightCharacter H φ μ χ →
    ∀ (e : simple H φ → L), (∀ i, e i ∈ rootSpace_value H i.val ∧ e i ≠ 0) →
    ∃ E : (U L ⧸ definingIdeal_value H φ μ e) ≃ₗ[U L] induced_value H φ χ,
      ∀ a : U L, E ((definingIdeal_value H φ μ e).mkQ a) = tensorClass H φ χ a 1

def induced_free_type : Prop :=
  ∀ {L : Type u} [LieRing L] [LieAlgebra ℂ L] [FiniteDimensional ℂ L],
    IsSemisimple_value ℂ L → ∀ (H : LieSubalgebra ℂ L) [H.IsCartanSubalgebra]
    (φ : Direction H), Regular H φ → ∀ (χ : U (borel_value H φ) →ₐ[ℂ] ℂ),
    ∃ E : U (negative_value H φ) ≃ₗ[ℂ] induced_value H φ χ,
      (∀ a, E a = envelopingMap (negative_value H φ).incl a • highestVector_value H φ χ) ∧
      highestVector_value H φ χ ≠ 0

end Specs.LieAlgebrasAndRepresentations.VermaModules
