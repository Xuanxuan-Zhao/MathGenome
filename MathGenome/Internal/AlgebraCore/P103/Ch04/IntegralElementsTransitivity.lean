import MathGenome.Internal.AlgebraCore.Specs.P103.Ch04.IntegralElementsTransitivity
import Mathlib.RingTheory.IntegralClosure.IsIntegralClosure.Basic

/-! Integral elements and transitivity, Theorem 4.6 (first two assertions). -/

namespace P103.Ch04.IntegralElementsTransitivity

/-- The library's integral closure has precisely the integral elements as
its carrier, without injectivity or nontriviality assumptions. -/
theorem integral_elements_form_subalgebra :
    Specs.integral_elements_form_subalgebra := by
  intro R A _ _ _
  exact ⟨integralClosure R A, fun _ => mem_integralClosure_iff R A⟩

/-- Transitivity reduces to the finite algebra generated by the coefficients
of a monic equation, as in the source proof. -/
theorem integral_transitivity : Specs.integral_transitivity := by
  intro R B C _ _ _ _ _ _ _ hB c hc
  let : Algebra.IsIntegral R B := ⟨hB⟩
  exact isIntegral_trans c hc

theorem integral_ringHom_comp : Specs.integral_ringHom_comp := by
  intro R B C _ _ _ f g hf hg
  exact RingHom.IsIntegral.trans f g hf hg

end P103.Ch04.IntegralElementsTransitivity
