import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Algebra.Module.RingHom
import Mathlib.Algebra.DirectSum.Module

/-! The right module is a left module over `Rᵐᵒᵖ`.  No nonzero or commutativity
hypothesis is imposed on the ring or either module. -/
namespace P103.BalancedTensor

universe u v w

variable (R : Type u) [Ring R]
variable (A : Type v) (B : Type w) [AddCommGroup A] [AddCommGroup B]
variable [Module Rᵐᵒᵖ A] [Module R B]

/-- The subgroup of the integer tensor generated by the balance relations. -/
def relations : Submodule ℤ (TensorProduct ℤ A B) :=
  Submodule.span ℤ { x | ∃ (r : R) (a : A) (b : B),
    x = TensorProduct.tmul ℤ (MulOpposite.op r • a) b -
      TensorProduct.tmul ℤ a (r • b) }

/-- The common noncommutative right-left tensor product. -/
abbrev Tensor : Type (max v w) := TensorProduct ℤ A B ⧸ relations R A B

variable {A B}

/-- The canonical elementary tensor. -/
def tmul (a : A) (b : B) : Tensor R A B :=
  (relations R A B).mkQ (TensorProduct.tmul ℤ a b)

/-- A balanced biadditive pairing with values in an arbitrary abelian group. -/
structure Pairing (C : Type*) [AddCommGroup C] where
  toBiadditive : A →+ B →+ C
  balance : ∀ (r : R) (a : A) (b : B),
    toBiadditive (MulOpposite.op r • a) b = toBiadditive a (r • b)

/-- Turn the left action of a commutative ring into the canonical right action. -/
abbrev commRightModule (K : Type*) [CommRing K] (M : Type*) [AddCommGroup M]
    [Module K M] : Module Kᵐᵒᵖ M :=
  Module.compHom M ((RingHom.id K).fromOpposite (fun _ _ => Commute.all _ _))

namespace Specification
set_option linter.unusedVariables false
open DirectSum

def PairLaws : Prop :=
  (∀ (a a' : A) (b : B), tmul R (a + a') b = tmul R a b + tmul R a' b) ∧
  (∀ (a : A) (b b' : B), tmul R a (b + b') = tmul R a b + tmul R a b') ∧
  (∀ b : B, tmul R (0 : A) b = 0) ∧
  (∀ a : A, tmul R a (0 : B) = 0) ∧
  (∀ (r : R) (a : A) (b : B),
    tmul R (MulOpposite.op r • a) b = tmul R a (r • b))

def Universal (C : Type*) [AddCommGroup C] : Prop :=
  ∀ f : Pairing R (A := A) (B := B) C,
    ∃! g : Tensor R A B →+ C, ∀ a b, g (tmul R a b) = f.toBiadditive a b

def Generation : Prop :=
  ∀ (P : Tensor R A B → Prop), P 0 →
    (∀ a b, P (tmul R a b)) →
    (∀ x y, P x → P y → P (x + y)) → ∀ x, P x


/- The following closed propositions are the independent expected theorem types.
They state existence of the canonical maps by their values on elementary tensors;
the implementation also exposes the maps themselves and their naturality laws. -/

def ExpectedPairLaws : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w)
    [AddCommGroup A] [AddCommGroup B] [Module Rᵐᵒᵖ A] [Module R B],
    PairLaws R (A := A) (B := B)

def ExpectedUniversal : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w) (C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B], Universal R (A := A) (B := B) C

def ExpectedGeneration : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w)
    [AddCommGroup A] [AddCommGroup B] [Module Rᵐᵒᵖ A] [Module R B],
    Generation R (A := A) (B := B)

def ExpectedMaps : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w) (A' B' : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup A'] [AddCommGroup B']
    [Module Rᵐᵒᵖ A] [Module R B] [Module Rᵐᵒᵖ A'] [Module R B']
    (f : A →ₗ[Rᵐᵒᵖ] A') (g : B →ₗ[R] B'),
    ∃! F : Tensor R A B →+ Tensor R A' B',
      ∀ a b, F (tmul R a b) = tmul R (f a) (g b)

def ExpectedRightUnit : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) [AddCommGroup A] [Module Rᵐᵒᵖ A],
    ∃ e : Tensor R A R ≃+ A,
      (∀ a r, e (tmul R a r) = MulOpposite.op r • a) ∧
      (∀ a, e.symm a = tmul R a 1)

def ExpectedLeftUnit : Prop :=
  ∀ (R : Type u) [Ring R] (B : Type w) [AddCommGroup B] [Module R B],
    ∃ e : Tensor R R B ≃+ B,
      (∀ r b, e (tmul R r b) = r • b) ∧
      (∀ b, e.symm b = tmul R 1 b)

def ExpectedLeftScalars : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w)
    [AddCommGroup A] [AddCommGroup B] [Module Rᵐᵒᵖ A] [Module R B]
    (S : Type*) [Ring S] [Module S A] [SMulCommClass S Rᵐᵒᵖ A],
    ∃ m : Module S (Tensor R A B),
      letI := m
      ∀ (s : S) (a : A) (b : B), s • tmul R a b = tmul R (s • a) b

def ExpectedRightScalars : Prop :=
  ∀ (R : Type u) [Ring R] (A : Type v) (B : Type w)
    [AddCommGroup A] [AddCommGroup B] [Module Rᵐᵒᵖ A] [Module R B]
    (S : Type*) [Ring S] [Module S B] [SMulCommClass S R B],
    ∃ m : Module S (Tensor R A B),
      letI := m
      ∀ (s : S) (a : A) (b : B), s • tmul R a b = tmul R a (s • b)

def ExpectedAssociativity : Prop :=
  ∀ (R : Type u) [Ring R] (S : Type*) [Ring S]
    (A : Type v) (B : Type w) (C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B] [Module Sᵐᵒᵖ B] [Module S C]
    [SMulCommClass Sᵐᵒᵖ R B],
    ∃ (mS : Module Sᵐᵒᵖ (Tensor R A B)) (mR : Module R (Tensor S B C)),
      letI := mS
      letI := mR
      (∀ (s : S) (a : A) (b : B), MulOpposite.op s • tmul R a b = tmul R a (MulOpposite.op s • b)) ∧
      (∀ (r : R) (b : B) (c : C), r • tmul S b c = tmul S (r • b) c) ∧
      ∃ e : Tensor S (Tensor R A B) C ≃+ Tensor R A (Tensor S B C),
        (∀ a b c, e (tmul S (tmul R a b) c) = tmul R a (tmul S b c)) ∧
        (∀ a b c, e.symm (tmul R a (tmul S b c)) = tmul S (tmul R a b) c)

noncomputable def ExpectedDirectSumLeft : Prop := by
  classical
  exact ∀ (R : Type u) [Ring R] (ι : Type*) (M : ι → Type v) (B : Type w)
    [∀ i, AddCommGroup (M i)] [AddCommGroup B]
    [∀ i, Module Rᵐᵒᵖ (M i)] [Module R B],
    ∃ e : Tensor R (⨁ i, M i) B ≃+ ⨁ i, Tensor R (M i) B,
      (∀ i a b, e (tmul R (DirectSum.of M i a) b) =
        DirectSum.of (fun i => Tensor R (M i) B) i (tmul R a b)) ∧
      (∀ i a b, e.symm (DirectSum.of (fun i => Tensor R (M i) B) i (tmul R a b)) =
        tmul R (DirectSum.of M i a) b)

noncomputable def ExpectedDirectSumRight : Prop := by
  classical
  exact ∀ (R : Type u) [Ring R] (ι : Type*) (A : Type v) (N : ι → Type w)
    [AddCommGroup A] [∀ i, AddCommGroup (N i)]
    [Module Rᵐᵒᵖ A] [∀ i, Module R (N i)],
    ∃ e : Tensor R A (⨁ i, N i) ≃+ ⨁ i, Tensor R A (N i),
      (∀ i a b, e (tmul R a (DirectSum.of N i b)) =
        DirectSum.of (fun i => Tensor R A (N i)) i (tmul R a b)) ∧
      (∀ i a b, e.symm (DirectSum.of (fun i => Tensor R A (N i)) i (tmul R a b)) =
        tmul R a (DirectSum.of N i b))

def ExpectedCommutativeComparison : Prop :=
  ∀ (K : Type u) [CommRing K] (A : Type v) (B : Type w)
    [AddCommGroup A] [AddCommGroup B] [Module K A] [Module K B],
    letI := commRightModule K A
    ∃ m : Module K (Tensor K A B),
      letI := m
      (∀ (r : K) (a : A) (b : B), r • tmul K a b = tmul K a (r • b)) ∧
      (∀ (r : K) (a : A) (b : B), r • tmul K a b = tmul K (r • a) b) ∧
      ∃ e : Tensor K A B ≃ₗ[K] TensorProduct K A B,
        (∀ a b, e (tmul K a b) = TensorProduct.tmul K a b) ∧
        (∀ a b, e.symm (TensorProduct.tmul K a b) = tmul K a b)

/-- The two unused actions commute on the tensor. -/
def ExpectedBimoduleActions : Prop :=
  ∀ (R : Type*) [Ring R] (A B : Type*) [AddCommGroup A] [AddCommGroup B]
    [Module Rᵐᵒᵖ A] [Module R B] (S T : Type*) [Ring S] [Ring T]
    [Module S A] [Module T B] [SMulCommClass S Rᵐᵒᵖ A] [SMulCommClass T R B],
    ∃ (mS : Module S (Tensor R A B)) (mT : Module T (Tensor R A B)),
      letI := mS
      letI := mT
      SMulCommClass S T (Tensor R A B) ∧
      (∀ (s : S) (a : A) (b : B), s • tmul R a b = tmul R (s • a) b) ∧
      (∀ (t : T) (a : A) (b : B), t • tmul R a b = tmul R a (t • b))

/-- Universally induced maps preserve any specified first outer action. -/
def ExpectedLeftLinearity : Prop :=
  ∀ (R S : Type*) [Ring R] [Ring S] (A B C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B] [Module S A] [Module S C]
    [Module S (Tensor R A B)]
    (hT : ∀ (s : S) (a : A) (b : B), s • tmul R a b = tmul R (s • a) b)
    (f : Pairing R (A := A) (B := B) C)
    (hf : ∀ (s : S) (a : A) (b : B), f.toBiadditive (s • a) b = s • f.toBiadditive a b)
    (g : Tensor R A B →+ C) (hg : ∀ a b, g (tmul R a b) = f.toBiadditive a b),
    ∀ (s : S) z, g (s • z) = s • g z

/-- Universally induced maps preserve any specified second outer action. -/
def ExpectedRightLinearity : Prop :=
  ∀ (R S : Type*) [Ring R] [Ring S] (A B C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B] [Module S B] [Module S C]
    [Module S (Tensor R A B)]
    (hT : ∀ (s : S) (a : A) (b : B), s • tmul R a b = tmul R a (s • b))
    (f : Pairing R (A := A) (B := B) C)
    (hf : ∀ (s : S) (a : A) (b : B), f.toBiadditive a (s • b) = s • f.toBiadditive a b)
    (g : Tensor R A B →+ C) (hg : ∀ a b, g (tmul R a b) = f.toBiadditive a b),
    ∀ (s : S) z, g (s • z) = s • g z

/-- Naturality is independent of any choice of representatives or construction
of the comparison maps: their elementary-tensor formulas determine the diagram. -/
def ExpectedRightUnitNaturality : Prop :=
  ∀ (R : Type*) [Ring R] (A A' : Type*) [AddCommGroup A] [AddCommGroup A']
    [Module Rᵐᵒᵖ A] [Module Rᵐᵒᵖ A'] (f : A →ₗ[Rᵐᵒᵖ] A')
    (F : Tensor R A R →+ Tensor R A' R)
    (hF : ∀ a r, F (tmul R a r) = tmul R (f a) r)
    (e : Tensor R A R →+ A) (he : ∀ a r, e (tmul R a r) = MulOpposite.op r • a)
    (e' : Tensor R A' R →+ A') (he' : ∀ a r, e' (tmul R a r) = MulOpposite.op r • a),
    ∀ z, e' (F z) = f (e z)

def ExpectedLeftUnitNaturality : Prop :=
  ∀ (R : Type*) [Ring R] (B B' : Type*) [AddCommGroup B] [AddCommGroup B']
    [Module R B] [Module R B'] (g : B →ₗ[R] B')
    (F : Tensor R R B →+ Tensor R R B')
    (hF : ∀ r b, F (tmul R r b) = tmul R r (g b))
    (e : Tensor R R B →+ B) (he : ∀ r b, e (tmul R r b) = r • b)
    (e' : Tensor R R B' →+ B') (he' : ∀ r b, e' (tmul R r b) = r • b),
    ∀ z, e' (F z) = g (e z)

def ExpectedAssociativityNaturality : Prop :=
  ∀ (R S : Type*) [Ring R] [Ring S] (A B C A' B' C' : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [AddCommGroup A'] [AddCommGroup B'] [AddCommGroup C']
    [Module Rᵐᵒᵖ A] [Module R B] [Module Sᵐᵒᵖ B] [Module S C]
    [Module Rᵐᵒᵖ A'] [Module R B'] [Module Sᵐᵒᵖ B'] [Module S C']
    [Module Sᵐᵒᵖ (Tensor R A B)] [Module R (Tensor S B C)]
    [Module Sᵐᵒᵖ (Tensor R A' B')] [Module R (Tensor S B' C')]
    (f : A →ₗ[Rᵐᵒᵖ] A') (g : B →+ B') (h : C →ₗ[S] C')
    (e : Tensor S (Tensor R A B) C →+ Tensor R A (Tensor S B C))
    (he : ∀ a b c, e (tmul S (tmul R a b) c) = tmul R a (tmul S b c))
    (e' : Tensor S (Tensor R A' B') C' →+ Tensor R A' (Tensor S B' C'))
    (he' : ∀ a b c, e' (tmul S (tmul R a b) c) = tmul R a (tmul S b c))
    (H : Tensor S (Tensor R A B) C →+ Tensor S (Tensor R A' B') C')
    (hH : ∀ a b c, H (tmul S (tmul R a b) c) = tmul S (tmul R (f a) (g b)) (h c))
    (K : Tensor R A (Tensor S B C) →+ Tensor R A' (Tensor S B' C'))
    (hK : ∀ a b c, K (tmul R a (tmul S b c)) = tmul R (f a) (tmul S (g b) (h c))),
    ∀ z, e' (H z) = K (e z)

noncomputable def ExpectedDirectSumLeftNaturality : Prop := by
  classical
  exact ∀ (R : Type*) [Ring R] (ι : Type*) (M M' : ι → Type*) (B B' : Type*)
    [∀ i, AddCommGroup (M i)] [∀ i, AddCommGroup (M' i)] [AddCommGroup B] [AddCommGroup B']
    [∀ i, Module Rᵐᵒᵖ (M i)] [∀ i, Module Rᵐᵒᵖ (M' i)] [Module R B] [Module R B']
    (f : ∀ i, M i →ₗ[Rᵐᵒᵖ] M' i) (g : B →ₗ[R] B')
    (e : Tensor R (⨁ i, M i) B →+ ⨁ i, Tensor R (M i) B)
    (he : ∀ i a b, e (tmul R (DirectSum.of M i a) b) = DirectSum.of _ i (tmul R a b))
    (e' : Tensor R (⨁ i, M' i) B' →+ ⨁ i, Tensor R (M' i) B')
    (he' : ∀ i a b, e' (tmul R (DirectSum.of M' i a) b) = DirectSum.of _ i (tmul R a b))
    (H : Tensor R (⨁ i, M i) B →+ Tensor R (⨁ i, M' i) B')
    (hH : ∀ i a b, H (tmul R (DirectSum.of M i a) b) =
      tmul R (DirectSum.of M' i (f i a)) (g b))
    (D : (⨁ i, Tensor R (M i) B) →+ ⨁ i, Tensor R (M' i) B')
    (hD : ∀ i a b, D (DirectSum.of _ i (tmul R a b)) =
      DirectSum.of _ i (tmul R (f i a) (g b))),
    ∀ z, e' (H z) = D (e z)

noncomputable def ExpectedDirectSumRightNaturality : Prop := by
  classical
  exact ∀ (R : Type*) [Ring R] (ι : Type*) (A A' : Type*) (N N' : ι → Type*)
    [AddCommGroup A] [AddCommGroup A'] [∀ i, AddCommGroup (N i)] [∀ i, AddCommGroup (N' i)]
    [Module Rᵐᵒᵖ A] [Module Rᵐᵒᵖ A'] [∀ i, Module R (N i)] [∀ i, Module R (N' i)]
    (f : A →ₗ[Rᵐᵒᵖ] A') (g : ∀ i, N i →ₗ[R] N' i)
    (e : Tensor R A (⨁ i, N i) →+ ⨁ i, Tensor R A (N i))
    (he : ∀ i a b, e (tmul R a (DirectSum.of N i b)) = DirectSum.of _ i (tmul R a b))
    (e' : Tensor R A' (⨁ i, N' i) →+ ⨁ i, Tensor R A' (N' i))
    (he' : ∀ i a b, e' (tmul R a (DirectSum.of N' i b)) = DirectSum.of _ i (tmul R a b))
    (H : Tensor R A (⨁ i, N i) →+ Tensor R A' (⨁ i, N' i))
    (hH : ∀ i a b, H (tmul R a (DirectSum.of N i b)) =
      tmul R (f a) (DirectSum.of N' i (g i b)))
    (D : (⨁ i, Tensor R A (N i)) →+ ⨁ i, Tensor R A' (N' i))
    (hD : ∀ i a b, D (DirectSum.of _ i (tmul R a b)) =
      DirectSum.of _ i (tmul R (f a) (g i b))),
    ∀ z, e' (H z) = D (e z)

/-- The first-variable direct-sum comparison preserves the action from its
first factors, for any actions with the prescribed elementary formulas. -/
noncomputable def ExpectedDirectSumLeftFirstLinearity : Prop := by
  classical
  exact ∀ (R T : Type*) [Ring R] [Ring T] (ι : Type*) (M : ι → Type*) (B : Type*)
    [∀ i, AddCommGroup (M i)] [AddCommGroup B]
    [∀ i, Module Rᵐᵒᵖ (M i)] [Module R B] [∀ i, Module T (M i)]
    [Module T (Tensor R (⨁ i, M i) B)] [Module T (⨁ i, Tensor R (M i) B)]
    (hSource : ∀ (t : T) (i : ι) (a : M i) (b : B), t • tmul R (DirectSum.of M i a) b =
      tmul R (DirectSum.of M i (t • a)) b)
    (hTarget : ∀ (t : T) (i : ι) (a : M i) (b : B),
      t • DirectSum.of (fun i => Tensor R (M i) B) i (tmul R a b) =
      DirectSum.of _ i (tmul R (t • a) b))
    (e : Tensor R (⨁ i, M i) B →+ ⨁ i, Tensor R (M i) B)
    (he : ∀ (i : ι) (a : M i) (b : B), e (tmul R (DirectSum.of M i a) b) = DirectSum.of _ i (tmul R a b)),
    ∀ (t : T) z, e (t • z) = t • e z

/-- The first-variable direct-sum comparison preserves the action from the
second factor. -/
noncomputable def ExpectedDirectSumLeftSecondLinearity : Prop := by
  classical
  exact ∀ (R T : Type*) [Ring R] [Ring T] (ι : Type*) (M : ι → Type*) (B : Type*)
    [∀ i, AddCommGroup (M i)] [AddCommGroup B]
    [∀ i, Module Rᵐᵒᵖ (M i)] [Module R B] [Module T B]
    [Module T (Tensor R (⨁ i, M i) B)] [Module T (⨁ i, Tensor R (M i) B)]
    (hSource : ∀ (t : T) (i : ι) (a : M i) (b : B), t • tmul R (DirectSum.of M i a) b =
      tmul R (DirectSum.of M i a) (t • b))
    (hTarget : ∀ (t : T) (i : ι) (a : M i) (b : B),
      t • DirectSum.of (fun i => Tensor R (M i) B) i (tmul R a b) =
      DirectSum.of _ i (tmul R a (t • b)))
    (e : Tensor R (⨁ i, M i) B →+ ⨁ i, Tensor R (M i) B)
    (he : ∀ (i : ι) (a : M i) (b : B), e (tmul R (DirectSum.of M i a) b) = DirectSum.of _ i (tmul R a b)),
    ∀ (t : T) z, e (t • z) = t • e z

/-- The second-variable direct-sum comparison preserves the action from the
first factor. -/
noncomputable def ExpectedDirectSumRightFirstLinearity : Prop := by
  classical
  exact ∀ (R T : Type*) [Ring R] [Ring T] (ι : Type*) (A : Type*) (N : ι → Type*)
    [AddCommGroup A] [∀ i, AddCommGroup (N i)]
    [Module Rᵐᵒᵖ A] [∀ i, Module R (N i)] [Module T A]
    [Module T (Tensor R A (⨁ i, N i))] [Module T (⨁ i, Tensor R A (N i))]
    (hSource : ∀ (t : T) (i : ι) (a : A) (b : N i), t • tmul R a (DirectSum.of N i b) =
      tmul R (t • a) (DirectSum.of N i b))
    (hTarget : ∀ (t : T) (i : ι) (a : A) (b : N i),
