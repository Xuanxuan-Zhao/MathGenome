    (he : ∀ (i : ι) (a : A) (b : N i), e (tmul R a (DirectSum.of N i b)) = DirectSum.of _ i (tmul R a b)),
    ∀ (t : T) z, e (t • z) = t • e z

/-- Evaluation against the right regular module respects a commuting first action. -/
def ExpectedRightUnitLeftLinearity : Prop :=
  ∀ (R S : Type*) [Ring R] [Ring S] (A : Type*) [AddCommGroup A]
    [Module Rᵐᵒᵖ A] [Module S A] [SMulCommClass S Rᵐᵒᵖ A]
    [Module S (Tensor R A R)]
    (hT : ∀ (s : S) (a : A) (r : R), s • tmul R a r = tmul R (s • a) r)
    (e : Tensor R A R →+ A)
    (he : ∀ (a : A) (r : R), e (tmul R a r) = MulOpposite.op r • a),
    ∀ (s : S) z, e (s • z) = s • e z

/-- Evaluation against the right regular module respects its unused right action. -/
def ExpectedRightUnitRightLinearity : Prop :=
  ∀ (R : Type*) [Ring R] (A : Type*) [AddCommGroup A] [Module Rᵐᵒᵖ A]
    [Module Rᵐᵒᵖ (Tensor R A R)]
    (hT : ∀ (s : Rᵐᵒᵖ) (a : A) (r : R), s • tmul R a r = tmul R a (s • r))
    (e : Tensor R A R →+ A)
    (he : ∀ (a : A) (r : R), e (tmul R a r) = MulOpposite.op r • a),
    ∀ (s : Rᵐᵒᵖ) z, e (s • z) = s • e z

/-- Evaluation against the left regular module respects its unused left action. -/
def ExpectedLeftUnitLeftLinearity : Prop :=
  ∀ (R : Type*) [Ring R] (B : Type*) [AddCommGroup B] [Module R B]
    [Module R (Tensor R R B)]
    (hT : ∀ (r s : R) (b : B), r • tmul R s b = tmul R (r • s) b)
    (e : Tensor R R B →+ B)
    (he : ∀ (r : R) (b : B), e (tmul R r b) = r • b),
    ∀ (r : R) z, e (r • z) = r • e z

/-- Evaluation against the left regular module respects a commuting second action. -/
def ExpectedLeftUnitRightLinearity : Prop :=
  ∀ (R S : Type*) [Ring R] [Ring S] (B : Type*) [AddCommGroup B]
    [Module R B] [Module S B] [SMulCommClass S R B]
    [Module S (Tensor R R B)]
    (hT : ∀ (s : S) (r : R) (b : B), s • tmul R r b = tmul R r (s • b))
    (e : Tensor R R B →+ B)
    (he : ∀ (r : R) (b : B), e (tmul R r b) = r • b),
    ∀ (s : S) z, e (s • z) = s • e z

/-- Associativity preserves any specified first outer action.  The actions on
the two triple tensors are characterized by their elementary-tensor formulas. -/
def ExpectedAssociativityLeftEquivariance : Prop :=
  ∀ (R S T : Type*) [Ring R] [Ring S] [Ring T] (A B C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B] [Module Sᵐᵒᵖ B] [Module S C]
    [Module Sᵐᵒᵖ (Tensor R A B)] [Module R (Tensor S B C)]
    [Module T A]
    [Module T (Tensor S (Tensor R A B) C)] [Module T (Tensor R A (Tensor S B C))]
    (hSource : ∀ (t : T) (a : A) (b : B) (c : C),
      t • tmul S (tmul R a b) c = tmul S (tmul R (t • a) b) c)
    (hTarget : ∀ (t : T) (a : A) (b : B) (c : C),
      t • tmul R a (tmul S b c) = tmul R (t • a) (tmul S b c))
    (e : Tensor S (Tensor R A B) C →+ Tensor R A (Tensor S B C))
    (he : ∀ a b c, e (tmul S (tmul R a b) c) = tmul R a (tmul S b c)),
    ∀ (t : T) z, e (t • z) = t • e z

/-- Associativity preserves any specified last outer action. -/
def ExpectedAssociativityRightEquivariance : Prop :=
  ∀ (R S T : Type*) [Ring R] [Ring S] [Ring T] (A B C : Type*)
    [AddCommGroup A] [AddCommGroup B] [AddCommGroup C]
    [Module Rᵐᵒᵖ A] [Module R B] [Module Sᵐᵒᵖ B] [Module S C]
    [Module Sᵐᵒᵖ (Tensor R A B)] [Module R (Tensor S B C)]
    [Module T C]
    [Module T (Tensor S (Tensor R A B) C)] [Module T (Tensor R A (Tensor S B C))]
    (hSource : ∀ (t : T) (a : A) (b : B) (c : C),
      t • tmul S (tmul R a b) c = tmul S (tmul R a b) (t • c))
    (hTarget : ∀ (t : T) (a : A) (b : B) (c : C),
      t • tmul R a (tmul S b c) = tmul R a (tmul S b (t • c)))
    (e : Tensor S (Tensor R A B) C →+ Tensor R A (Tensor S B C))
    (he : ∀ a b c, e (tmul S (tmul R a b) c) = tmul R a (tmul S b c)),
    ∀ (t : T) z, e (t • z) = t • e z

end Specification
