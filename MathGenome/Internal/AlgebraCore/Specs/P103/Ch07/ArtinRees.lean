import Mathlib.RingTheory.Filtration

/-!
Theorem 7.2 of paper.tex (1188–1195), with the hypotheses from the
preceding paragraph (1181). Rings are commutative and unital; the zero
ring is allowed. Finiteness means finite generation, not freeness.
-/

universe u v

namespace P103.Specs.Ch07.ArtinRees

/-- `I ^ n • ⊤` is the submodule `IⁿM`; ideal scalar multiplication is
the submodule generated by the scalar products. Infimum is intersection
inside M. The natural number c encodes the required nonnegative bound.
No restrictions exclude zero or whole ideals or submodules. -/
def artin_reesType : Prop :=
  ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] (N : Submodule R M),
    ∃ c : ℕ, ∀ n : ℕ, c ≤ n →
      (I ^ n • (⊤ : Submodule R M)) ⊓ N =
        I ^ (n - c) • ((I ^ c • (⊤ : Submodule R M)) ⊓ N)

end P103.Specs.Ch07.ArtinRees
