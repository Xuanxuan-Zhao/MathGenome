import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.GradedAlgebra.Basic
import MathGenome.Internal.AlgebraCore.Specs.P103.Ch06.GradedInterfaces
import Mathlib.GroupTheory.QuotientGroup.Basic

/-! Canonical objects for paper.tex 1181–1186. No freeness or nonzero hypotheses
are imposed. The associated graded objects below are defined as quotients;
their grading and identification with the direct sum of successive quotients
are further obligations, not part of these definitions. -/
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

namespace P103.Rees
noncomputable section

variable {R : Type*} [CommRing R] (I : Ideal R)

abbrev ReesAlgebra := reesAlgebra I

/-- The polynomials in M[t] whose coefficient in degree n is in I^n M. -/
noncomputable abbrev ReesModule (M : Type*) [AddCommGroup M] [_root_.Module R M] :=
  (I.stableFiltration (⊤ : Submodule R M)).submodule

/-- The ideal generated by I in degree zero, not the positive-degree ideal. -/
def quotientIdeal : Ideal (ReesAlgebra I) := I.map (algebraMap R (ReesAlgebra I))

abbrev AssociatedRing := ReesAlgebra I ⧸ quotientIdeal I

instance associatedBase : Algebra (R ⧸ I) (AssociatedRing I) :=
  Ideal.Quotient.algebraQuotientOfLEComap
    (fun _ hr => Ideal.mem_map_of_mem _ hr)

instance associatedBaseTower : IsScalarTower R (R ⧸ I) (AssociatedRing I) :=
  IsScalarTower.of_algebraMap_eq (fun _ => rfl)

variable (M : Type*) [AddCommGroup M] [_root_.Module R M]

/-- The submodule generated by the degree-zero action of I. -/
noncomputable def quotientSubmodule : Submodule (ReesAlgebra I) (ReesModule I M) :=
  quotientIdeal I • ⊤

abbrev AssociatedModule :=
  @HasQuotient.Quotient (ReesModule I M)
    (Submodule (ReesAlgebra I) (ReesModule I M))
    (@Submodule.hasQuotient (ReesAlgebra I) (ReesModule I M)
      inferInstance inferInstance inferInstance) (quotientSubmodule I M)

instance associatedModuleAction : _root_.Module (AssociatedRing I) (AssociatedModule I M) :=
  _root_.Module.IsTorsionBySet.module
    (_root_.Module.isTorsionBySet_quotient_ideal_smul (ReesModule I M) (quotientIdeal I))

instance associatedModuleTower :
    IsScalarTower (ReesAlgebra I) (AssociatedRing I) (AssociatedModule I M) :=
  _root_.Module.IsTorsionBySet.isScalarTower
    (_root_.Module.isTorsionBySet_quotient_ideal_smul (ReesModule I M) (quotientIdeal I))

/-- The monomial m t^n in the Rees module. -/
def term (n : ℕ) (m : (I ^ n • (⊤ : Submodule R M) : Submodule R M)) : ReesModule I M :=
  ⟨PolynomialModule.single R n m.1, by
    intro k
    change (Finsupp.single n m.1) k ∈ I ^ k • (⊤ : Submodule R M)
    by_cases h : n = k
    · subst k; simp
    · simp [h]⟩

/-- A generator of the Rees module placed in degree zero. -/
noncomputable def constant (m : M) : ReesModule I M :=
  ⟨PolynomialModule.single R 0 m, by
    intro n
    change (Finsupp.single 0 m) n ∈ I ^ n • (⊤ : Submodule R M)
    by_cases h : n = 0
    · subst n; simp
    · simp [Ne.symm h]⟩


/-- A homogeneous monomial in the Rees algebra. -/
def ringTerm (n : ℕ) : (I ^ n : Ideal R) →+ ReesAlgebra I where
  toFun a := ⟨Polynomial.monomial n a.1, reesAlgebra.monomial_mem.mpr a.2⟩
  map_zero' := Subtype.ext (map_zero _)
  map_add' a b := Subtype.ext (map_add _ _ _)

/-- The homogeneous class in the quotient ring. -/
def ringClass (n : ℕ) : (I ^ n : Ideal R) →+ AssociatedRing I :=
  (Ideal.Quotient.mk (quotientIdeal I)).toAddMonoidHom.comp (ringTerm I n)

/-- The homogeneous class in the quotient module. -/
def moduleClass (n : ℕ) : (I ^ n • (⊤ : Submodule R M) : Submodule R M) →+
    AssociatedModule I M where
  toFun m := Submodule.Quotient.mk (term I M n m)
  map_zero' := by
    have h : term I M n 0 = 0 := Subtype.ext (by simp [term])
    simp only [h, Submodule.Quotient.mk_zero]
  map_add' a b := by
    have h : term I M n (a + b) = term I M n a + term I M n b :=
      Subtype.ext (PolynomialModule.single_add _ _ _)
    simp only [h, Submodule.Quotient.mk_add]

/-- The actual internal degree-n pieces. -/
def ringPiece (n : ℕ) : AddSubgroup (AssociatedRing I) := (ringClass I n).range

def modulePiece (n : ℕ) : AddSubgroup (AssociatedModule I M) := (moduleClass I M n).range

/-- I^(n+1) as a subgroup of I^n, so no ill-typed quotient of ambient ideals is used. -/
def ringSuccessor (n : ℕ) : AddSubgroup (I ^ n : Ideal R) :=
  (I ^ (n + 1)).toAddSubgroup.comap (I ^ n).toAddSubgroup.subtype

def moduleSuccessor (n : ℕ) :
    AddSubgroup (I ^ n • (⊤ : Submodule R M) : Submodule R M) :=
  (I ^ (n + 1) • (⊤ : Submodule R M) : Submodule R M).toAddSubgroup.comap
    (I ^ n • (⊤ : Submodule R M) : Submodule R M).toAddSubgroup.subtype

abbrev RingComponent (n : ℕ) := (I ^ n : Ideal R) ⧸ ringSuccessor I n
abbrev ModuleComponent (n : ℕ) :=
  (I ^ n • (⊤ : Submodule R M) : Submodule R M) ⧸ moduleSuccessor I M n

def mulCoefficient (n k : ℕ) (a : (I ^ n : Ideal R)) (b : (I ^ k : Ideal R)) : (I ^ (n + k) : Ideal R) :=
  ⟨a.1 * b.1, by rw [pow_add]; exact Ideal.mul_mem_mul a.2 b.2⟩

def smulCoefficient (n k : ℕ) (a : (I ^ n : Ideal R))
    (m : (I ^ k • (⊤ : Submodule R M) : Submodule R M)) :
    (I ^ (n + k) • (⊤ : Submodule R M) : Submodule R M) :=
  ⟨a.1 • m.1, by
    rw [pow_add, Submodule.mul_smul]
    exact Submodule.smul_mem_smul a.2 m.2⟩

end
end P103.Rees

namespace Specs.P103.Rees
noncomputable section
open _root_.P103.Rees Polynomial

variable {R : Type*} [CommRing R] (I : Ideal R)
variable (M : Type*) [AddCommGroup M] [_root_.Module R M]

def algebraMembershipType : Prop :=
  ∀ f : Polynomial R, f ∈ ReesAlgebra I ↔ ∀ n, f.coeff n ∈ I ^ n

def moduleMembershipType : Prop :=
  ∀ f : PolynomialModule R M, f ∈ ReesModule I M ↔
    ∀ n, f.coeff n ∈ I ^ n • (⊤ : Submodule R M)

def algebraGeneratorsType : Prop :=
  ∀ (s : Finset R), Ideal.span (s : Set R) = I →
    Algebra.adjoin R (Polynomial.monomial 1 '' (s : Set R)) = reesAlgebra I

def algebraNoetherianType : Prop :=
  IsNoetherianRing R → IsNoetherianRing (ReesAlgebra I)

def moduleGeneratorsType : Prop :=
  ∀ s : Finset M, Submodule.span R (s : Set M) = ⊤ →
    Submodule.span (ReesAlgebra I) (constant I M '' (s : Set M)) = ⊤

def moduleFiniteType : Prop :=
  _root_.Module.Finite R M → _root_.Module.Finite (ReesAlgebra I) (ReesModule I M)

def quotientIdealMembershipType : Prop :=
  ∀ f : ReesAlgebra I, f ∈ quotientIdeal I ↔ ∀ n, f.1.coeff n ∈ I ^ (n + 1)

def quotientSubmoduleMembershipType : Prop :=
  ∀ f : ReesModule I M, f ∈ quotientSubmodule I M ↔
    ∀ n, f.1.coeff n ∈ I ^ (n + 1) • (⊤ : Submodule R M)

def gradedAlgebraNoetherianType : Prop :=
  IsNoetherianRing R → IsNoetherianRing (AssociatedRing I)

/-- Finiteness over the associated graded ring, with the quotient action. -/
def quotientFiniteType : Prop :=
  _root_.Module.Finite R M → _root_.Module.Finite (AssociatedRing I) (AssociatedModule I M)

def boundaryAlgebraType : Prop :=
  ReesAlgebra (⊥ : Ideal R) = ⊥ ∧ ReesAlgebra (⊤ : Ideal R) = ⊤ ∧
    quotientIdeal (⊥ : Ideal R) = ⊥ ∧ quotientIdeal (⊤ : Ideal R) = ⊤

def boundaryModuleType : Prop :=
  ReesModule (⊤ : Ideal R) M = ⊤ ∧
    (∀ f : PolynomialModule R M, f ∈ ReesModule (⊥ : Ideal R) M ↔
      ∀ n : ℕ, n ≠ 0 → f.coeff n = 0) ∧
    quotientSubmodule (⊥ : Ideal R) M = ⊥ ∧
    quotientSubmodule (⊤ : Ideal R) M = ⊤

def zeroModuleType : Prop :=
  Subsingleton M → Subsingleton (ReesModule I M) ∧ Subsingleton (AssociatedModule I M)

/-- The primary algebra construction has an independently fixed value. -/
def algebraConstructionType :=
  ∀ {R : Type*} [CommRing R], Ideal R → Subalgebra R (Polynomial R)

noncomputable def algebraConstructionValue : algebraConstructionType :=
  fun I => reesAlgebra I

/-- The module construction uses the canonical polynomial-module action. -/
def moduleConstructionType :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    Submodule (reesAlgebra I) (PolynomialModule R M)

noncomputable def moduleConstructionValue : moduleConstructionType :=
  fun {R} _ I M _ _ => (I.stableFiltration (⊤ : Submodule R M)).submodule

/-! Closed theorem types for declaration comparison. -/

def algebra_membershipTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    algebraMembershipType I

def module_membershipTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    moduleMembershipType I M

def algebra_generatorsTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    algebraGeneratorsType I

def algebra_noetherianTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    algebraNoetherianType I

def module_generatorsTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    moduleGeneratorsType I M

def module_finiteTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    moduleFiniteType I M

def quotient_ideal_membershipTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    quotientIdealMembershipType I

def quotient_submodule_membershipTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    quotientSubmoduleMembershipType I M

def graded_algebra_noetherianTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    gradedAlgebraNoetherianType I

def quotient_finiteTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    quotientFiniteType I M

def boundary_algebraTheorem : Prop :=
  ∀ {R : Type*} [CommRing R],
    boundaryAlgebraType (R := R)

def boundary_moduleTheorem : Prop :=
  ∀ {R : Type*} [CommRing R]
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    boundaryModuleType (R := R) M

def zero_moduleTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    zeroModuleType I M


/-- These pieces decompose the quotient, with its original multiplication and action. -/
def graded_structureTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    Nonempty (GradedRing (ringPiece I)) ∧
    Nonempty (DirectSum.Decomposition (modulePiece I M)) ∧
    SetLike.GradedSMul (ringPiece I) (modulePiece I M)

/-- The piece identifications are the monomial maps on representatives. -/
def component_identificationsTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    (∀ n, ∃ e : RingComponent I n ≃+ ringPiece I n,
      ∀ a : (I ^ n : Ideal R), (e (QuotientAddGroup.mk a) : AssociatedRing I) = ringClass I n a) ∧
    (∀ n, ∃ e : ModuleComponent I M n ≃+ modulePiece I M n,
      ∀ m : (I ^ n • (⊤ : Submodule R M) : Submodule R M),
        (e (QuotientAddGroup.mk m) : AssociatedModule I M) = moduleClass I M n m)

/-- Multiplication and action on the successive quotients have the usual formulas. -/
def homogeneous_operationsTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    (∀ n k (a : (I ^ n : Ideal R)) (b : (I ^ k : Ideal R)),
      ringClass I n a * ringClass I k b = ringClass I (n + k) (mulCoefficient I n k a b)) ∧
    (∀ n k (a : (I ^ n : Ideal R)) (m : (I ^ k • (⊤ : Submodule R M) : Submodule R M)),
      (@SMul.smul (AssociatedRing I) (AssociatedModule I M)
        (associatedModuleAction I M).toSMul (ringClass I n a) (moduleClass I M k m)) =
        moduleClass I M (n + k) (smulCoefficient I M n k a m))

/-- The base ring embeds and its image is exactly degree zero. -/
def degree_zeroTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R),
    Function.Injective (algebraMap (R ⧸ I) (AssociatedRing I)) ∧
    Set.range (algebraMap (R ⧸ I) (AssociatedRing I)) = (ringPiece I 0 : Set (AssociatedRing I))

def standard_gradedTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R), IsNoetherianRing R →
    ∃ s : Finset (AssociatedRing I), (∀ a ∈ s, a ∈ ringPiece I 1) ∧
      Algebra.adjoin (R ⧸ I) (s : Set (AssociatedRing I)) = ⊤

/-- The nonnegative gradings extend by zero to the shared integer convention,
and the ring is standard over its actual degree-zero piece. -/
def integer_gradingTheorem : Prop :=
  ∀ {R : Type*} [CommRing R] (I : Ideal R)
    (M : Type*) [AddCommGroup M] [_root_.Module R M],
    ∃ G : _root_.P103.Graded.NonnegativeGrading (AssociatedRing I),
      (∀ n : ℕ, G.piece n = ringPiece I n) ∧
      (∃ U : _root_.P103.Graded.ModuleGrading G (AssociatedModule I M),
        ∀ n : ℕ, U.piece n = modulePiece I M n) ∧
      (IsNoetherianRing R → Specs.P103.Graded.standardValue G)

end
end Specs.P103.Rees
