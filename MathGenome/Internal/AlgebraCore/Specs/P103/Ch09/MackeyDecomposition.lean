import MathGenome.Internal.AlgebraCore.Specs.P103.Ch09.InductionModels
import Mathlib.GroupTheory.DoubleCoset

/-! Independent statement of the Mackey decomposition, with left cosets and
left representations. All index sets and vector spaces may be infinite. -/
noncomputable section
universe u v w x
namespace P103.Ch09.Mackey
open scoped MonoidAlgebra DirectSum
variable {k : Type u} {G : Type v} [Field k] [Group G]
variable (H K : Subgroup G)

/-- Conjugation from K into G, in the direction required by the twisted action. -/
def conjugation (s : G) : K →* G where
  toFun a := s⁻¹ * (a : G) * s
  map_one' := by simp
  map_mul' a b := by simp [mul_assoc]

/-- The subgroup K ∩ sHs⁻¹, regarded as a subgroup of K. -/
def intersection (s : G) : Subgroup K := H.comap (conjugation K s)

/-- The homomorphism ℓ ↦ s⁻¹ℓs, with codomain H. -/
def intoSubgroup (s : G) : intersection H K s →* H where
  toFun a := ⟨conjugation K s a.1, a.2⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' a b := Subtype.ext (map_mul _ _ _)

variable {V : Type w} [AddCommGroup V] [Module k V]

/-- The twist uses exactly the original underlying vector space. -/
def twist (ρ : Representation k H V) (s : G) :
    Representation k (intersection H K s) V := ρ.comp (intoSubgroup H K s)

/-- A section of the double-coset quotient, without finiteness assumptions. -/
structure Representatives where
  representative : DoubleCoset.Quotient (K : Set G) H → G
  represents : ∀ q, DoubleCoset.mk K H (representative q) = q

attribute [local instance] rightSubgroupModule

/-- The actual right k[H]-submodule of k[G] generated by the group basis in KsH.
The expected support characterization below identifies it with k[KsH]. -/
def blockSpace (s : G) : Submodule k[H]ᵐᵒᵖ k[G] :=
  Submodule.span k[H]ᵐᵒᵖ {a | ∃ g ∈ DoubleCoset.doubleCoset s K H,
    a = MonoidAlgebra.single g 1}

def blockBasis (s g : G) (hg : g ∈ DoubleCoset.doubleCoset s K H) : blockSpace (k := k) H K s :=
  ⟨MonoidAlgebra.single g 1, Submodule.subset_span ⟨g, hg, rfl⟩⟩

abbrev BlockTensor (ρ : Representation k H V) (s : G) :=
  BalancedTensor.Tensor k[H] (blockSpace (k := k) H K s) ρ.asModule

def blockTensor (ρ : Representation k H V) (s : G)
    (a : blockSpace (k := k) H K s) (z : V) : BlockTensor H K ρ s :=
  BalancedTensor.tmul k[H] a (ρ.asModuleEquiv.symm z)

/-- Chosen scalar and K-actions on the actual block tensor, prescribed on
group-basis tensors. -/
structure BlockAction (ρ : Representation k H V) (s : G) where
  module : Module k (BlockTensor H K ρ s)
  representation : @Representation k K (BlockTensor H K ρ s) _ _ _ module
  scalar_basis : ∀ (c : k) (g : G) (hg : g ∈ DoubleCoset.doubleCoset s K H) (z : V),
    (letI := module; c • blockTensor H K ρ s (blockBasis H K s g hg) z) =
      blockTensor H K ρ s (blockBasis H K s g hg) (c • z)
  action_basis : ∀ (a : K) (g : G) (hg : g ∈ DoubleCoset.doubleCoset s K H) (z : V),
    ∃ hag : (a : G) * g ∈ DoubleCoset.doubleCoset s K H,
      representation a (blockTensor H K ρ s (blockBasis H K s g hg) z) =
        blockTensor H K ρ s (blockBasis H K s ((a : G) * g) hag) z

/-- Tensor identification of each block, including its inverse and its actual
embedding in restricted induction. No isomorphism is supplied as a hypothesis. -/
structure BlockEquivalence (ρ : Representation k H V) (s : G)
    (D : InductionData H ρ)
    (Ds : InductionData (intersection H K s) (twist H K ρ s))
    (B : BlockAction H K ρ s) where
  equivalence : letI := Ds.module; letI := B.module
    Induced (intersection H K s) (twist H K ρ s) ≃ₗ[k] BlockTensor H K ρ s
  inclusion : letI := B.module; letI := D.module
    BlockTensor H K ρ s →ₗ[k] Induced H ρ
  inclusion_injective : Function.Injective inclusion
  inclusion_tensor : ∀ (a : blockSpace (k := k) H K s) (z : V),
    inclusion (blockTensor H K ρ s a z) = tensor H ρ a.1 z
  forward : ∀ (a : K) (z : V),
    ∃ hg : (a : G) * s ∈ DoubleCoset.doubleCoset s K H,
      equivalence (tensor (intersection H K s) (twist H K ρ s)
        (MonoidAlgebra.single a 1) z) =
      blockTensor H K ρ s (blockBasis H K s ((a : G) * s) hg) z
  inverse : ∀ (a : K) (h : H) (z : V),
    ∃ hg : (a : G) * s * h ∈ DoubleCoset.doubleCoset s K H,
      equivalence.symm (blockTensor H K ρ s
        (blockBasis H K s ((a : G) * s * h) hg) z) =
      tensor (intersection H K s) (twist H K ρ s)
        (MonoidAlgebra.single a 1) (ρ h z)
  equivariant : ∀ (a : K) z,
    equivalence (Ds.representation a z) = B.representation a (equivalence z)

/-- A full decomposition for every section of K\G/H. The summands are a
DFinsupp direct sum, never an unrestricted product. -/
structure Decomposition (ρ : Representation k H V) (R : Representatives H K) where
  globalAction : InductionData H ρ
  summandAction : ∀ s : G, InductionData (intersection H K s) (twist H K ρ s)
  blockAction : ∀ s : G, BlockAction H K ρ s
  blockEquivalence : ∀ s : G,
    BlockEquivalence H K ρ s globalAction (summandAction s) (blockAction s)
  equivalence : letI := globalAction.module
    letI := fun q => (summandAction (R.representative q)).module
    Induced H ρ ≃ₗ[k] ⨁ q : DoubleCoset.Quotient (K : Set G) H,
      Induced (intersection H K (R.representative q)) (twist H K ρ (R.representative q))
  summand_formula : ∀ q (a : K) (z : V),
    letI := globalAction.module
    letI := fun q => (summandAction (R.representative q)).module
    letI := Classical.decEq (DoubleCoset.Quotient (K : Set G) H)
    equivalence.symm (DirectSum.lof k _ _ q
      (tensor (intersection H K (R.representative q)) (twist H K ρ (R.representative q))
        (MonoidAlgebra.single a 1) z)) =
      tensor H ρ (MonoidAlgebra.single ((a : G) * R.representative q) 1) z
  equivariant : ∀ (a : K) z,
    letI := globalAction.module
    letI := fun q => (summandAction (R.representative q)).module
    equivalence (globalAction.representation a z) =
      DirectSum.lmap (fun q => (summandAction (R.representative q)).representation a)
        (equivalence z)

namespace Specs

def blockSupportType : Prop :=
  ∀ {k : Type u} {G : Type v} [Field k] [Group G] (H K : Subgroup G)
    (s : G) (a : k[G]),
    a ∈ blockSpace H K s ↔ ∀ g ∈ a.coeff.support, g ∈ DoubleCoset.doubleCoset s K H

def decompositionType : Prop :=
  ∀ {k : Type u} {G : Type v} [Field k] [Group G] (H K : Subgroup G)
    {V : Type w} [AddCommGroup V] [Module k V]
    (ρ : Representation k H V) (R : Representatives H K), Nonempty (Decomposition H K ρ R)

/-- Representative independence includes subgroup conjugacy and the comparison
of tensor coordinates, compatible with their common image in induction. -/
def representativeIndependenceType : Prop :=
  ∀ {k : Type u} {G : Type v} [Field k] [Group G] (H K : Subgroup G)
    {V : Type w} [AddCommGroup V] [Module k V] (ρ : Representation k H V)
    (s : G) (a₀ : K) (h₀ : H)
    (Ds : InductionData (intersection H K s) (twist H K ρ s))
    (Ds' : InductionData (intersection H K ((a₀ : G) * s * h₀))
      (twist H K ρ ((a₀ : G) * s * h₀))),
    (∀ a : K, a ∈ intersection H K ((a₀ : G) * s * h₀) ↔
      a₀⁻¹ * a * a₀ ∈ intersection H K s) ∧
    (letI := Ds.module; letI := Ds'.module
      ∃ C : Induced (intersection H K ((a₀ : G) * s * h₀))
          (twist H K ρ ((a₀ : G) * s * h₀)) ≃ₗ[k]
        Induced (intersection H K s) (twist H K ρ s),
        (∀ (a : K) z, C
          (tensor (intersection H K ((a₀ : G) * s * h₀))
            (twist H K ρ ((a₀ : G) * s * h₀)) (MonoidAlgebra.single a 1) z) =
          tensor (intersection H K s) (twist H K ρ s)
            (MonoidAlgebra.single (a * a₀) 1) (ρ h₀ z)) ∧
        (∀ (a : K) z, C (Ds'.representation a z) = Ds.representation a (C z)) ∧
        (∀ (a : K) z, tensor H ρ
          (MonoidAlgebra.single ((a : G) * ((a₀ : G) * s * h₀)) 1) z =
          tensor H ρ (MonoidAlgebra.single (((a * a₀ : K) : G) * s) 1) (ρ h₀ z)))

/-- Naturality for arbitrary H-intertwiners on the original vector spaces. -/
def naturalityType : Prop :=
  ∀ {k : Type u} {G : Type v} [Field k] [Group G] (H K : Subgroup G)
    {V : Type w} [AddCommGroup V] [Module k V]
    {W : Type x} [AddCommGroup W] [Module k W]
    (ρ : Representation k H V) (σ : Representation k H W)
    (R : Representatives H K) (A : Decomposition H K ρ R) (B : Decomposition H K σ R)
    (f : ρ.IntertwiningMap σ),
    letI := A.globalAction.module; letI := B.globalAction.module
    letI := fun q => (A.summandAction (R.representative q)).module
    letI := fun q => (B.summandAction (R.representative q)).module
    ∃ (F : A.globalAction.representation.IntertwiningMap B.globalAction.representation)
      (Fs : ∀ q, (A.summandAction (R.representative q)).representation.IntertwiningMap
        (B.summandAction (R.representative q)).representation),
      (∀ (a : k[G]) z, F (tensor H ρ a z) = tensor H σ a (f z)) ∧
      (∀ q (a : k[K]) z, Fs q
        (tensor (intersection H K (R.representative q)) (twist H K ρ (R.representative q)) a z) =
        tensor (intersection H K (R.representative q)) (twist H K σ (R.representative q)) a (f z)) ∧
      (∀ z, B.equivalence (F z) =
        DirectSum.lmap (fun q => (Fs q).toLinearMap) (A.equivalence z))

end Specs
end P103.Ch09.Mackey
