import MathGenome.Internal.AlgebraCore.Specs.P103.Ch06.DimensionConventions

/-!
Independent statements of Krull's height theorem, paper.tex:1041–1053.
The ring is commutative, unital and Noetherian; no domain or local hypothesis
is imposed. `I.minimalPrimes` consists of primes containing I that are minimal
under inclusion. A `PrimeSpectrum` point is a proper prime.

The specified family `Fin r → R` may contain repetitions or zero elements,
and may be empty. Heights use the shared Chapter 6 convention, in the ring R
being quantified over. In particular, R may itself be any Noetherian quotient
ring; the height is then computed in that quotient.
-/
namespace P103.Specs.Ch06.KrullHeight

universe u
open P103.Specs.Ch06.DimensionConventions

/-- A prime minimal over an ideal generated by r specified elements has height ≤ r. -/
def height_boundType : Prop :=
  ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
    (r : ℕ) (x : Fin r → R) (I : Ideal R),
    I = Ideal.span (Set.range x) → I ≠ ⊤ →
    ∀ p : PrimeSpectrum R, p.asIdeal ∈ I.minimalPrimes →
      primeHeightValue R p ≤ (r : ℕ∞)

/-- The principal ideal case, allowing any generator, including zero. -/
def principal_height_boundType : Prop :=
  ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
    (x : R), Ideal.span ({x} : Set R) ≠ ⊤ →
    ∀ p : PrimeSpectrum R,
      p.asIdeal ∈ (Ideal.span ({x} : Set R)).minimalPrimes →
      primeHeightValue R p ≤ 1

/-- The empty generating family generates zero; its minimal primes have height zero. -/
def minimal_prime_height_zeroType : Prop :=
  ∀ (R : Type u) [CommRing R] [IsNoetherianRing R]
    (p : PrimeSpectrum R), p.asIdeal ∈ (⊥ : Ideal R).minimalPrimes →
      primeHeightValue R p = 0

end P103.Specs.Ch06.KrullHeight
