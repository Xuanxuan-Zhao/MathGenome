import Mathlib.MeasureTheory.Measure.Typeclasses.Finite
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.Analysis.Complex.Basic

/-!
Independent statements of the determining-class lemma, paper.tex:206–232.
The finite-subfamily hypothesis includes intersections that happen to be empty,
but imposes no condition on the intersection of the empty subfamily. In particular,
neither membership of the whole space nor nonemptiness of the class is assumed.
The ambient measurable space is precisely the sigma-algebra generated by the class.
-/

open Set MeasureTheory
open scoped ENNReal

universe u

namespace ProbabilityFoundations.Ch01.Specs

/-- Uniqueness for finite measures with a common total mass. -/
def MeasureEquality : Prop :=
  ∀ (S : Type u) [m : MeasurableSpace S] (C : Set (Set S)),
    m = MeasurableSpace.generateFrom C →
    (∀ F : Set (Set S), F.Finite → F.Nonempty → F ⊆ C → ⋂₀ F ∈ C) →
    ∀ (μ ν : Measure S) [IsFiniteMeasure μ] [IsFiniteMeasure ν],
      μ univ = ν univ → (∀ A ∈ C, μ A = ν A) → μ = ν

/-- Nonnegative measurable functions may take the value infinity. -/
def NonnegativeIntegralEquality : Prop :=
  ∀ (S : Type u) [m : MeasurableSpace S] (C : Set (Set S)),
    m = MeasurableSpace.generateFrom C →
    (∀ F : Set (Set S), F.Finite → F.Nonempty → F ⊆ C → ⋂₀ F ∈ C) →
    ∀ (μ ν : Measure S) [IsFiniteMeasure μ] [IsFiniteMeasure ν],
      μ univ = ν univ → (∀ A ∈ C, μ A = ν A) →
      ∀ f : S → ℝ≥0∞, Measurable f → (∫⁻ x, f x ∂μ) = ∫⁻ x, f x ∂ν

/-- Equality of integrals for real functions integrable under either measure. -/
def RealIntegralEquality : Prop :=
  ∀ (S : Type u) [m : MeasurableSpace S] (C : Set (Set S)),
    m = MeasurableSpace.generateFrom C →
    (∀ F : Set (Set S), F.Finite → F.Nonempty → F ⊆ C → ⋂₀ F ∈ C) →
    ∀ (μ ν : Measure S) [IsFiniteMeasure μ] [IsFiniteMeasure ν],
      μ univ = ν univ → (∀ A ∈ C, μ A = ν A) →
      ∀ f : S → ℝ, (Integrable f μ ∨ Integrable f ν) →
        (∫ x, f x ∂μ) = ∫ x, f x ∂ν

/-- Equality of integrals for complex functions integrable under either measure. -/
def ComplexIntegralEquality : Prop :=
  ∀ (S : Type u) [m : MeasurableSpace S] (C : Set (Set S)),
    m = MeasurableSpace.generateFrom C →
    (∀ F : Set (Set S), F.Finite → F.Nonempty → F ⊆ C → ⋂₀ F ∈ C) →
    ∀ (μ ν : Measure S) [IsFiniteMeasure μ] [IsFiniteMeasure ν],
      μ univ = ν univ → (∀ A ∈ C, μ A = ν A) →
      ∀ f : S → ℂ, (Integrable f μ ∨ Integrable f ν) →
        (∫ x, f x ∂μ) = ∫ x, f x ∂ν

end ProbabilityFoundations.Ch01.Specs
