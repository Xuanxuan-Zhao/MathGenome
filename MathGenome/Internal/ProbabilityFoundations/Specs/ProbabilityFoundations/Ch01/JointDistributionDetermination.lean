import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Analysis.Normed.Lp.MeasurableSpace
import Mathlib.MeasureTheory.Constructions.BorelSpace.Order
import Mathlib.MeasureTheory.MeasurableSpace.Pi
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability

/-!
Independent statements for the joint part of `thm:prob-cdf`, paper.tex:241–242,
265–270, with the dimension-zero convention at paper.tex:91.
The Pi space carries its usual product measurable structure; the Euclidean
space carries the transported structure, which is proved to be its Borel structure.
-/

open Set MeasureTheory

namespace ProbabilityFoundations.Ch01

/-- The closed lower orthant with finite real endpoint in every coordinate. -/
def lowerOrthant (d : ℕ) (x : Fin d → ℝ) : Set (Fin d → ℝ) :=
  {y | ∀ j, y j ≤ x j}

/-- The same coordinate inequalities in the Euclidean norm representation. -/
def euclideanLowerOrthant (d : ℕ) (x : Fin d → ℝ) :
    Set (EuclideanSpace ℝ (Fin d)) := {y | ∀ j, y j ≤ x j}

namespace Specs

/-- Lower orthants are a pi-system in every finite dimension. -/
def LowerOrthantsPiSystem : Prop :=
  ∀ d : ℕ, IsPiSystem (range (lowerOrthant d))

/-- The Borel sigma-algebra is generated by the lower orthants. -/
def LowerOrthantsGenerateBorel : Prop :=
  ∀ d : ℕ, borel (Fin d → ℝ) = MeasurableSpace.generateFrom (range (lowerOrthant d))

/-- Both representations carry their Borel structures, and the coordinate
identification transports one to the other. -/
def EuclideanBorelBridge : Prop :=
  ∀ d : ℕ,
    (inferInstance : MeasurableSpace (Fin d → ℝ)) = borel (Fin d → ℝ) ∧
    (inferInstance : MeasurableSpace (EuclideanSpace ℝ (Fin d))) =
      borel (EuclideanSpace ℝ (Fin d)) ∧
    borel (EuclideanSpace ℝ (Fin d)) =
      MeasurableSpace.comap (WithLp.ofLp : EuclideanSpace ℝ (Fin d) → Fin d → ℝ)
        (borel (Fin d → ℝ))

/-- Agreement on all lower orthants determines a probability law on the finite Pi space.
No positive-dimension restriction is needed. -/
def JointLawEquality : Prop :=
  ∀ (d : ℕ) (μ ν : Measure (Fin d → ℝ)) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν],
    (∀ x : Fin d → ℝ, μ (lowerOrthant d x) = ν (lowerOrthant d x)) → μ = ν

/-- The corresponding assertion for Borel probability laws on Euclidean space. -/
def EuclideanJointLawEquality : Prop :=
  ∀ (d : ℕ) (μ ν : Measure (EuclideanSpace ℝ (Fin d)))
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν],
    (∀ x : Fin d → ℝ, μ (euclideanLowerOrthant d x) = ν (euclideanLowerOrthant d x)) →
      μ = ν

/-- Dimension zero has exactly the one-point probability law. -/
def ZeroDimensionalLaw : Prop :=
  ∀ (μ : Measure (EuclideanSpace ℝ (Fin 0))) [IsProbabilityMeasure μ], μ = Measure.dirac 0

end Specs
end ProbabilityFoundations.Ch01
