import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch02.IndependenceInterfaces
import Mathlib.Data.PNat.Defs
import Mathlib.Order.LiminfLimsup

/-! Independent specification of the Kolmogorov tail law,
paper.tex:728–747 (Theorem 2.9). Positive natural numbers implement the
source's indices n ≥ 1. Suprema of measurable spaces are sigma-algebras
generated by their unions, so the formula below retains the strict n > m
cutoffs in the source. The ambient space is not assumed complete. -/

open MeasureTheory

namespace Specs.ProbabilityFoundations.Ch02.KolmogorovZeroOne

universe u

/-- The type of the source's tail sigma-algebra construction. -/
def tailSigmaType := ∀ {Ω : Type u},
  (ℕ+ → MeasurableSpace Ω) → MeasurableSpace Ω

/-- Intersection, over positive cutoffs, of the sigma-algebras generated
by all strictly later members of the sequence. -/
def tailSigmaValue {Ω : Type u} (F : ℕ+ → MeasurableSpace Ω) : MeasurableSpace Ω :=
  ⨅ m : ℕ+, ⨆ n : ℕ+, ⨆ (_ : m < n), F n

/-- Explicit bridge from the displayed source formula to Mathlib's tail algebra. -/
def tailSigmaEqLimsupType : Prop :=
  ∀ {Ω : Type u} (F : ℕ+ → MeasurableSpace Ω),
    tailSigmaValue F = Filter.limsup F Filter.atTop

/-- The full zero–one assertion on the specified, possibly incomplete,
probability space, for every independent sequence of sub-sigma-algebras. -/
def kolmogorovZeroOneType : Prop :=
  ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (F : ℕ+ → MeasurableSpace Ω),
    (∀ n, F n ≤ mΩ) →
    IndependenceInterfaces.MutuallyIndependentValue P F →
    ∀ A : Set Ω, MeasurableSet[tailSigmaValue F] A → P A = 0 ∨ P A = 1

end Specs.ProbabilityFoundations.Ch02.KolmogorovZeroOne
