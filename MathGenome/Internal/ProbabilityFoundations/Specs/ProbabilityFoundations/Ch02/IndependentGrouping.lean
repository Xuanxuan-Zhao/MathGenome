import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch02.IndependenceInterfaces

/-! Independent specification of the grouping assertion of Theorem 2.4,
paper.tex:563–585. Suprema are taken in the lattice of measurable spaces:
they are exactly the sigma-algebras generated by the union of the groups.
Neither index type nor any group is assumed finite or countable. The
ambient probability space is not assumed complete; empty groups are allowed. -/

open MeasureTheory

namespace Specs.ProbabilityFoundations.Ch02.IndependentGrouping

universe u v w

def independentGroupingType : Prop :=
  ∀ {Ω : Type u} {I : Type v} {A : Type w} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (F : I → MeasurableSpace Ω) (J : A → Set I),
    (∀ i, F i ≤ mΩ) →
    IndependenceInterfaces.MutuallyIndependentValue P F →
    Pairwise (fun a b => Disjoint (J a) (J b)) →
    IndependenceInterfaces.MutuallyIndependentValue P (fun a => ⨆ i ∈ J a, F i)

end Specs.ProbabilityFoundations.Ch02.IndependentGrouping
