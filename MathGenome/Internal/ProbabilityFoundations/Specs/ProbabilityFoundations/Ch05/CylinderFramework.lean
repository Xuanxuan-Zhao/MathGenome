import Mathlib.MeasureTheory.Measure.Map
import Mathlib.MeasureTheory.Measure.Typeclasses.Probability
import Mathlib.MeasureTheory.MeasurableSpace.Constructions
import Mathlib.Data.Finset.Range
import Mathlib.Data.PNat.Equiv

/-!
The shared spaces in paper.tex §§5.1–5.2. All measurable structures below are
Mathlib's specified dependent-product structures; no completion or topology is used.
The definitions are shared here so that extension Specs can use exactly these spaces.
-/

open MeasureTheory

namespace ProbabilityFoundations.Ch05.CylinderFramework

universe u v

abbrev ProductSpace {I : Type u} (S : I → Type v) := (i : I) → S i

abbrev FiniteProduct {I : Type u} (S : I → Type v) (F : Finset I) :=
  (i : F) → S i

/-- The projection from the full product onto a finite set of coordinates. -/
def finiteProjection {I : Type u} (S : I → Type v) (F : Finset I) :
    ProductSpace S → FiniteProduct S F := F.restrict

/-- Restriction from `F` to `E`, for `E ⊆ F`. -/
def finiteRestriction {I : Type u} (S : I → Type v) {E F : Finset I} (h : E ⊆ F) :
    FiniteProduct S F → FiniteProduct S E := Finset.restrict₂ h

variable {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)]

/-- Measurable finite-coordinate cylinders, including the empty support. -/
def finiteCylinders : Set (Set (ProductSpace S)) :=
  {A | ∃ (F : Finset I) (B : Set (FiniteProduct S F)),
    MeasurableSet B ∧ finiteProjection S F ⁻¹' B = A}

/-- The cylinder sigma-algebra in §5.2. -/
def cylinderSigma : MeasurableSpace (ProductSpace S) :=
  MeasurableSpace.generateFrom (finiteCylinders S)

abbrev FiniteLaws := (F : Finset I) → Measure (FiniteProduct S F)

/-- A law is specified for every finite support, including the empty support. -/
def IsProbabilityFamily (μ : FiniteLaws S) : Prop :=
  ∀ F, IsProbabilityMeasure (μ F)

/-- Consistency is precisely the pushforward restriction identity of §5.2. -/
def Consistent (μ : FiniteLaws S) : Prop :=
  ∀ (E F : Finset I) (h : E ⊆ F), Measure.map (finiteRestriction S h) (μ F) = μ E

structure ProbabilityFamily where
  law : FiniteLaws S
  probability : IsProbabilityFamily S law

structure ConsistentProbabilityFamily extends ProbabilityFamily S where
  consistent : Consistent S law

/-- Lean coordinate `k : ℕ` represents the paper's positive coordinate `k+1`. -/
def positiveIndex : ℕ ≃ ℕ+ := Equiv.pnatEquivNat.symm

/-- Explicit translation of a positively indexed family to Lean natural indexing. -/
abbrev ShiftedSequence (T : ℕ+ → Type v) (k : ℕ) := T (positiveIndex k)

/-- The first `n` paper coordinates are Lean coordinates `0,...,n-1`. -/
abbrev PrefixSpace (S : ℕ → Type v) (n : ℕ) := FiniteProduct S (Finset.range n)

def prefixProjection (S : ℕ → Type v) (n : ℕ) :
    ProductSpace S → PrefixSpace S n := finiteProjection S (Finset.range n)

def prefixRestriction (S : ℕ → Type v) {m n : ℕ} (h : m ≤ n) :
    PrefixSpace S n → PrefixSpace S m :=
  finiteRestriction S (Finset.range_mono h)

variable (T : ℕ → Type v) [∀ k, MeasurableSpace (T k)]

def prefixCylinders : Set (Set (ProductSpace T)) :=
  {A | ∃ (n : ℕ) (B : Set (PrefixSpace T n)),
    MeasurableSet B ∧ prefixProjection T n ⁻¹' B = A}

def prefixSigma : MeasurableSpace (ProductSpace T) :=
  MeasurableSpace.generateFrom (prefixCylinders T)

def PrefixConsistent (μ : (n : ℕ) → Measure (PrefixSpace T n)) : Prop :=
  ∀ (m n : ℕ) (h : m ≤ n), Measure.map (prefixRestriction T h) (μ n) = μ m

end ProbabilityFoundations.Ch05.CylinderFramework

namespace Specs.ProbabilityFoundations.Ch05.CylinderFramework

open _root_.ProbabilityFoundations.Ch05.CylinderFramework

universe u v

/-- The type of the common product sigma-algebra constructor. -/
def ProductSigmaType :=
  ∀ {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)],
    MeasurableSpace (ProductSpace S)

/-- Independently specified value: sigma-algebra generated by finite cylinders. -/
def ProductSigmaValue : ProductSigmaType.{u,v} := fun S _ => cylinderSigma S

/-- Finite projections and all nested finite restrictions are measurable. -/
def FiniteMapsMeasurable : Prop :=
  ∀ {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)],
    (∀ F, Measurable (finiteProjection S F)) ∧
    (∀ (E F : Finset I) (h : E ⊆ F), Measurable (finiteRestriction S h))

/-- Restriction identities fix the direction and composition of the interfaces. -/
def RestrictionIdentities : Prop :=
  ∀ {I : Type u} (S : I → Type v),
    (∀ (F : Finset I), finiteRestriction S (show F ⊆ F from fun _ h => h) = id) ∧
    (∀ (D E F : Finset I) (hDE : D ⊆ E) (hEF : E ⊆ F),
      finiteRestriction S hDE ∘ finiteRestriction S hEF =
        finiteRestriction S (Finset.Subset.trans hDE hEF)) ∧
    (∀ (E F : Finset I) (h : E ⊆ F),
      finiteRestriction S h ∘ finiteProjection S F = finiteProjection S E)

/-- Empty products and zero-length prefixes are singletons, even for empty factors. -/
def EmptyProducts : Prop :=
  (∀ {I : Type u} (S : I → Type v), Nonempty (FiniteProduct S ∅) ∧
    Subsingleton (FiniteProduct S ∅)) ∧
  (∀ (S : ℕ → Type v), Nonempty (PrefixSpace S 0) ∧ Subsingleton (PrefixSpace S 0))

/-- The cylinder sigma-algebra is exactly the standard Pi measurable structure. -/
def CylinderSigmaEqPi : Prop :=
  ∀ {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)],
    cylinderSigma S = (inferInstance : MeasurableSpace (ProductSpace S))

/-- This tests all nested finite supports and assumes no missing consistency condition. -/
def ConsistencyIff : Prop :=
  ∀ {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)] (μ : FiniteLaws S),
    Consistent S μ ↔
      ∀ (E F : Finset I) (h : E ⊆ F), Measure.map (finiteRestriction S h) (μ F) = μ E

def PositiveIndexShift : Prop := ∀ k : ℕ, (positiveIndex k : ℕ) = k + 1

/-- Sequence prefix cylinders generate the same product measurable structure. -/
def PrefixSigmaEqPi : Prop :=
  ∀ (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)],
    prefixSigma S = (inferInstance : MeasurableSpace (ProductSpace S))

/-- Restricting a consistent finite family to prefixes preserves consistency. -/
def FiniteConsistencyToPrefixes : Prop :=
  ∀ (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)] (μ : FiniteLaws S),
    Consistent S μ → PrefixConsistent S (fun n => μ (Finset.range n))

end Specs.ProbabilityFoundations.Ch05.CylinderFramework
