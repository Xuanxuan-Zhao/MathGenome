import MathGenome.Internal.ProbabilityFoundations.ProbabilityFoundations.Ch05.ContinuousPathGeometry
import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch05.DenseEvaluationBorel
import Mathlib.MeasureTheory.Constructions.BorelSpace.Metrizable
import Mathlib.Topology.Sequences

/-! Borel sets of continuous paths are generated by evaluation at any countable
 dense set of times. We first recover every time evaluation as a pointwise
 sequential limit of evaluations in the given dense family. Mathlib's
 compact-open Borel theorem then supplies the reverse inclusion; it uses
 second countability of the continuous-map topology. No completeness is used. -/

open Filter TopologicalSpace
open scoped Topology

namespace ProbabilityFoundations.Ch05

theorem pathEvaluation_continuous : Specs.PathEvaluationContinuous := by
  intro S _ _ _ T _ t
  exact continuous_eval_const t

theorem pathEvaluation_measurable : Specs.PathEvaluationMeasurable := by
  intro S _ _ _ T hT t
  exact (pathEvaluation_continuous S T hT t).borel_measurable

/-- A dense set of times already makes every evaluation measurable.
This helper is valid even when that dense set is uncountable. -/
theorem measurable_eval_of_dense
    {X S : Type*} [TopologicalSpace X] [FirstCountableTopology X]
    [TopologicalSpace S] [PseudoMetrizableSpace S]
    {D : Set X} (hD : Dense D) (x : X) :
    @Measurable C(X, S) S
      (⨆ t : D, (borel S).comap (fun f : C(X, S) => f t.1))
      (borel S) (fun f => f x) := by
  borelize S
  let : MeasurableSpace C(X, S) :=
    ⨆ t : D, (borel S).comap (fun f : C(X, S) => f t.1)
  obtain ⟨u, hu, hx⟩ := mem_closure_iff_seq_limit.mp (hD x)
  have hm (n : ℕ) : Measurable (fun f : C(X, S) => f (u n)) := by
    apply (measurable_iff_comap_le).mpr
    exact le_iSup (fun t : D =>
      (borel S).comap (fun f : C(X, S) => f t.1)) ⟨u n, hu n⟩
  apply measurable_of_tendsto_metrizable hm
  exact tendsto_pi_nhds.mpr (fun f => f.continuous.continuousAt.tendsto.comp hx)

theorem denseEvaluation_borel : Specs.DenseEvaluationBorel := by
  intro S _ _ _ T _ D _ hD
  refine le_antisymm ?_ ?_
  · rw [ContinuousMap.borel_eq_iSup_comap_eval]
    exact iSup_le (fun t => (measurable_iff_comap_le).mp (measurable_eval_of_dense hD t))
  · refine iSup_le (fun t => ?_)
    exact (pathEvaluation_measurable S T ‹0 < T› t.1).comap_le

end ProbabilityFoundations.Ch05
