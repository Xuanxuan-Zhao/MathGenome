import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch05.CylinderFramework

open MeasureTheory

namespace ProbabilityFoundations.Ch05.CylinderFramework

universe u v

/-- The named product sigma-algebra is the one generated by finite-coordinate cylinders.
`cylinderSigma_eq_pi` below identifies it with Mathlib's canonical Pi structure. -/
@[instance_reducible]
def productSigma {I : Type u} (S : I → Type v) [∀ i, MeasurableSpace (S i)] :
    MeasurableSpace (ProductSpace S) := cylinderSigma S

/-- Each component of a probability family can be used with Mathlib's probability API. -/
instance {I : Type u} {S : I → Type v} [∀ i, MeasurableSpace (S i)]
    (μ : ProbabilityFamily S) (F : Finset I) : IsProbabilityMeasure (μ.law F) :=
  μ.probability F

@[fun_prop]
theorem measurable_finiteProjection {I : Type u} (S : I → Type v)
    [∀ i, MeasurableSpace (S i)] (F : Finset I) : Measurable (finiteProjection S F) :=
  F.measurable_restrict

@[fun_prop]
theorem measurable_finiteRestriction {I : Type u} (S : I → Type v)
    [∀ i, MeasurableSpace (S i)] {E F : Finset I} (h : E ⊆ F) :
    Measurable (finiteRestriction S h) := Finset.measurable_restrict₂ h

theorem finiteMapsMeasurable :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.FiniteMapsMeasurable.{u,v} := by
  intro I S inst
  exact ⟨measurable_finiteProjection S, fun _ _ h => measurable_finiteRestriction S h⟩

theorem restrictionIdentities :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.RestrictionIdentities.{u,v} := by
  intro I S
  exact ⟨fun _ => rfl, fun _ _ _ _ _ => rfl, fun _ _ _ => rfl⟩

theorem emptyProducts :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.EmptyProducts.{u,v} := by
  constructor
  · intro I S
    exact ⟨inferInstance, inferInstance⟩
  · intro S
    change Nonempty (FiniteProduct S ∅) ∧ Subsingleton (FiniteProduct S ∅)
    exact ⟨inferInstance, inferInstance⟩

theorem cylinderSigma_eq_pi {I : Type u} (S : I → Type v)
    [∀ i, MeasurableSpace (S i)] :
    cylinderSigma S = (inferInstance : MeasurableSpace (ProductSpace S)) := by
  apply le_antisymm
  · apply MeasurableSpace.generateFrom_le
    rintro A ⟨F, B, hB, rfl⟩
    exact (measurable_finiteProjection S F) hB
  · change (⨆ i, MeasurableSpace.comap (fun x : ProductSpace S => x i) inferInstance) ≤ _
    apply iSup_le
    intro i
    rintro A ⟨B, hB, rfl⟩
    apply MeasurableSpace.measurableSet_generateFrom
    classical
    refine ⟨{i}, (fun x : FiniteProduct S {i} => x ⟨i, by simp⟩) ⁻¹' B, ?_, rfl⟩
    exact (measurable_pi_apply _) hB

theorem cylinderSigmaEqPi :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.CylinderSigmaEqPi.{u,v} :=
  fun S _ => cylinderSigma_eq_pi S

theorem consistencyIff :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.ConsistencyIff.{u,v} := by
  intro I S inst μ
  rfl

theorem positiveIndexShift :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.PositiveIndexShift := fun _ => rfl

@[fun_prop]
theorem measurable_prefixProjection (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)]
    (n : ℕ) : Measurable (prefixProjection S n) :=
  measurable_finiteProjection S (Finset.range n)

@[fun_prop]
theorem measurable_prefixRestriction (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)]
    {m n : ℕ} (h : m ≤ n) : Measurable (prefixRestriction S h) :=
  measurable_finiteRestriction S (Finset.range_mono h)

theorem prefixSigma_eq_pi (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)] :
    prefixSigma S = (inferInstance : MeasurableSpace (ProductSpace S)) := by
  apply le_antisymm
  · apply MeasurableSpace.generateFrom_le
    rintro A ⟨n, B, hB, rfl⟩
    exact (measurable_prefixProjection S n) hB
  · change (⨆ i, MeasurableSpace.comap (fun x : ProductSpace S => x i) inferInstance) ≤ _
    apply iSup_le
    intro i
    rintro A ⟨B, hB, rfl⟩
    apply MeasurableSpace.measurableSet_generateFrom
    refine ⟨i + 1, (fun x : PrefixSpace S (i + 1) =>
      x ⟨i, Finset.self_mem_range_succ i⟩) ⁻¹' B, ?_, rfl⟩
    exact (measurable_pi_apply _) hB

theorem prefixSigmaEqPi :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.PrefixSigmaEqPi.{v} :=
  fun S _ => prefixSigma_eq_pi S

theorem prefixSigma_eq_cylinderSigma (S : ℕ → Type v) [∀ k, MeasurableSpace (S k)] :
    prefixSigma S = cylinderSigma S :=
  (prefixSigma_eq_pi S).trans (cylinderSigma_eq_pi S).symm

theorem finiteConsistencyToPrefixes :
    Specs.ProbabilityFoundations.Ch05.CylinderFramework.FiniteConsistencyToPrefixes.{v} := by
  intro S inst μ hμ m n hmn
  exact hμ (Finset.range m) (Finset.range n) (Finset.range_mono hmn)

end ProbabilityFoundations.Ch05.CylinderFramework
