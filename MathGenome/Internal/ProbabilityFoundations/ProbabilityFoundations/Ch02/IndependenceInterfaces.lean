import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch02.IndependenceInterfaces

/-! Definition 2.1, paper.tex:493–505. All spaces and measures are canonical
Mathlib objects. The ambient probability space is allowed to be incomplete.
Measurability and the sub-sigma-algebra condition are separate domain data,
just as for Mathlib's independence predicates. No completion is used. -/

open MeasureTheory
open scoped ENNReal

namespace ProbabilityFoundations.Ch02

universe u v w

/-- Independence of every finite set of distinct indices. A `Finset` has no
repeated indices, and the empty set is included. For the source's family of
sub-sigma-algebras, use this with `∀ i, F i ≤ mΩ`. The predicate also extends
canonically to arbitrary sigma-algebras, as does Mathlib's `iIndep`. -/
def MutuallyIndependent {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) : Prop :=
  ∀ (s : Finset I) (A : I → Set Ω),
    (∀ i ∈ s, MeasurableSet[F i] (A i)) →
      P (⋂ i ∈ s, A i) = ∏ i ∈ s, P (A i)

/-- Independence of the sigma-algebras generated by the individual maps.
For random elements the separate domain condition is `∀ i, Measurable (X i)`;
`randomElements_sigma_le` verifies that their sigma-algebras are subalgebras. -/
def IndependentRandomElements {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] {S : I → Type w} [mS : ∀ i, MeasurableSpace (S i)] (X : ∀ i, Ω → S i) : Prop :=
  MutuallyIndependent P (fun i => (mS i).comap (X i))

/-- Independence of the sigma-algebras generated by the individual events.
For an event family use this with `∀ i, MeasurableSet (A i)`. -/
def IndependentEvents {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) : Prop :=
  MutuallyIndependent P (fun i => MeasurableSpace.generateFrom {A i})

/-- The two-distinct-indices condition, with no condition on larger subfamilies. -/
def PairwiseIndependent {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) : Prop :=
  ∀ i j, i ≠ j → ∀ B C : Set Ω,
    MeasurableSet[F i] B → MeasurableSet[F j] C → P (B ∩ C) = P B * P C

/-- Pairwise independence of the generated sigma-algebras of random elements. -/
def PairwiseIndependentRandomElements {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] {S : I → Type w} [mS : ∀ i, MeasurableSpace (S i)] (X : ∀ i, Ω → S i) : Prop :=
  PairwiseIndependent P (fun i => (mS i).comap (X i))

/-- Pairwise independence of the sigma-algebras generated by individual events. -/
def PairwiseIndependentEvents {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) : Prop :=
  PairwiseIndependent P (fun i => MeasurableSpace.generateFrom {A i})

theorem mutuallyIndependent_iff_iIndep {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) :
    MutuallyIndependent P F ↔ ProbabilityTheory.iIndep F P := by
  simpa only [MutuallyIndependent] using (ProbabilityTheory.iIndep_iff F P).symm

theorem independentRandomElements_iff_iIndepFun {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] {S : I → Type w} [mS : ∀ i, MeasurableSpace (S i)] (X : ∀ i, Ω → S i) :
    IndependentRandomElements P X ↔ ProbabilityTheory.iIndepFun X P := by
  rw [IndependentRandomElements, mutuallyIndependent_iff_iIndep]
  exact (ProbabilityTheory.iIndepFun_iff_iIndep mS X P).symm

theorem independentEvents_iff_iIndepSet {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) :
    IndependentEvents P A ↔ ProbabilityTheory.iIndepSet A P := by
  rw [IndependentEvents, mutuallyIndependent_iff_iIndep]
  exact (ProbabilityTheory.iIndepSet_iff_iIndep A P).symm

theorem pairwiseIndependent_iff {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) :
    PairwiseIndependent P F ↔
    Pairwise (fun i j => ProbabilityTheory.Indep (F i) (F j) P) := by
  constructor
  · intro h i j hij
    exact (ProbabilityTheory.Indep_iff (F i) (F j) P).mpr (h i j hij)
  · intro h i j hij
    exact (ProbabilityTheory.Indep_iff (F i) (F j) P).mp (h hij)

theorem pairwiseIndependentRandomElements_iff {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] {S : I → Type w} [mS : ∀ i, MeasurableSpace (S i)] (X : ∀ i, Ω → S i) :
    PairwiseIndependentRandomElements P X ↔
    Pairwise (fun i j => ProbabilityTheory.IndepFun (X i) (X j) P) := by
  rw [PairwiseIndependentRandomElements, pairwiseIndependent_iff]
  constructor
  · intro h i j hij
    exact (ProbabilityTheory.IndepFun_iff_Indep (X i) (X j) P).mpr (h hij)
  · intro h i j hij
    exact (ProbabilityTheory.IndepFun_iff_Indep (X i) (X j) P).mp (h hij)

theorem pairwiseIndependentEvents_iff {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) :
    PairwiseIndependentEvents P A ↔
    Pairwise (fun i j => ProbabilityTheory.IndepSet (A i) (A j) P) := by
  rw [PairwiseIndependentEvents, pairwiseIndependent_iff]
  constructor
  · intro h i j hij
    exact (ProbabilityTheory.IndepSet_iff_Indep (A i) (A j) P).mpr (h hij)
  · intro h i j hij
    exact (ProbabilityTheory.IndepSet_iff_Indep (A i) (A j) P).mp (h hij)

/-- Mutual independence implies the distinct, weaker pairwise condition. -/
theorem mutuallyIndependent_pairwise {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) :
    MutuallyIndependent P F → PairwiseIndependent P F := by
  intro h
  apply (pairwiseIndependent_iff P F).mpr
  intro i j hij
  exact ((mutuallyIndependent_iff_iIndep P F).mp h).indep hij

/-- The generated sigma-algebras of random elements belong to the original
ambient space; no completion is involved. -/
theorem randomElements_sigma_le {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] {S : I → Type w} [mS : ∀ i, MeasurableSpace (S i)] (X : ∀ i, Ω → S i) (hX : ∀ i, Measurable (X i)) :
    ∀ i, (mS i).comap (X i) ≤ mΩ := by
  intro i
  exact (hX i).comap_le

theorem events_sigma_le {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) (hA : ∀ i, MeasurableSet (A i)) :
    ∀ i, MeasurableSpace.generateFrom {A i} ≤ mΩ := by
  intro i
  apply MeasurableSpace.generateFrom_le
  intro B hB
  rcases Set.mem_singleton_iff.mp hB with rfl
  exact hA i

/-- The finite-family convention includes zero indices: its equality is P Ω = 1. -/
theorem mutuallyIndependent_empty {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (F : I → MeasurableSpace Ω) (h : MutuallyIndependent P F) :
    P (⋂ i ∈ (∅ : Finset I), (Set.univ : Set Ω)) =
    ∏ i ∈ (∅ : Finset I), P (Set.univ : Set Ω) := by
  exact h ∅ (fun _ => Set.univ) (by simp)

theorem independentEvents_iff_finite_intersections {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) (hA : ∀ i, MeasurableSet (A i)) :
    IndependentEvents P A ↔
    ∀ s : Finset I, P (⋂ i ∈ s, A i) = ∏ i ∈ s, P (A i) := by
  rw [independentEvents_iff_iIndepSet]
  exact ProbabilityTheory.iIndepSet_iff_meas_biInter hA

theorem pairwiseIndependentEvents_iff_intersections {Ω : Type u} {I : Type v} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (A : I → Set Ω) (hA : ∀ i, MeasurableSet (A i)) :
    PairwiseIndependentEvents P A ↔
    ∀ i j, i ≠ j → P (A i ∩ A j) = P (A i) * P (A j) := by
  rw [pairwiseIndependentEvents_iff]
  constructor
  · intro h i j hij
    have hijA : ProbabilityTheory.IndepSet (A i) (A j) P := h hij
    exact hijA.measure_inter_eq_mul
  · intro h i j hij
    exact (ProbabilityTheory.indepSet_iff_measure_inter_eq_mul (hA i) (hA j) P).mpr
      (h i j hij)

end ProbabilityFoundations.Ch02
