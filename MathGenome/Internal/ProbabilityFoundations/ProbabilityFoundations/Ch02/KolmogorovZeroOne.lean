import MathGenome.Internal.ProbabilityFoundations.ProbabilityFoundations.Ch02.IndependentGrouping
import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch02.KolmogorovZeroOne
import Mathlib.Probability.Independence.ZeroOne

/-! Theorem 2.9, paper.tex:728–747. The positive-index, strict-cutoff
tail sigma-algebra agrees with the lattice limsup at atTop. Mathlib's
Kolmogorov theorem then applies through the established independence
interface, without completion or assumptions on the individual subalgebras. -/

open MeasureTheory

namespace ProbabilityFoundations.Ch02

universe u

-- Every positive index has a strictly later positive index.
private instance : NoMaxOrder ℕ+ where
  exists_gt n := ⟨⟨(n : ℕ) + 1, Nat.zero_lt_succ _⟩, Nat.lt_succ_self _⟩

/-- The source's tail sigma-algebra: intersection over m ≥ 1 of the
sigma-algebra generated by the union of F n for n > m. -/
def tailSigma {Ω : Type u} (F : ℕ+ → MeasurableSpace Ω) : MeasurableSpace Ω :=
  ⨅ m : ℕ+, ⨆ n : ℕ+, ⨆ (_ : m < n), F n

/-- Strict positive cutoffs give precisely Mathlib's tail algebra. -/
theorem tailSigma_eq_limsup {Ω : Type u} (F : ℕ+ → MeasurableSpace Ω) :
    tailSigma F = Filter.limsup F Filter.atTop := by
  symm
  simpa only [tailSigma, Set.mem_Ioi, iInf_true] using
    (Filter.atTop_basis_Ioi.limsup_eq_iInf_iSup (u := F))

/-- Kolmogorov's zero–one law for the source's positive-index tail
sigma-algebra on the original probability space. -/
theorem kolmogorov_zero_one
    {Ω : Type u} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (F : ℕ+ → MeasurableSpace Ω)
    (hF : ∀ n, F n ≤ mΩ)
    (h : MutuallyIndependent P F)
    (A : Set Ω) (hA : MeasurableSet[tailSigma F] A) :
    P A = 0 ∨ P A = 1 := by
  rw [tailSigma_eq_limsup] at hA
  exact ProbabilityTheory.measure_zero_or_one_of_measurableSet_limsup_atTop
    hF ((mutuallyIndependent_iff_iIndep P F).mp h) hA

end ProbabilityFoundations.Ch02
