import MathGenome.Internal.ProbabilityFoundations.ProbabilityFoundations.Ch02.IndependenceGenerators
import MathGenome.Internal.ProbabilityFoundations.Specs.ProbabilityFoundations.Ch02.IndependentGrouping

/-! The grouping assertion of Theorem 2.4 (paper.tex:563–585).
For a group `J a`, `⨆ i ∈ J a, F i` is the sigma-algebra generated by
the union of the sigma-algebras in that group. The proof uses independence
of the sigma-algebras generated by two disjoint sets of original indices,
then inducts over each finite family of groups. -/

open MeasureTheory

namespace ProbabilityFoundations.Ch02

universe u v w

/-- Arbitrary pairwise disjoint groups of mutually independent
sub-sigma-algebras are mutually independent, including empty groups. -/
theorem mutuallyIndependent_grouping
    {Ω : Type u} {I : Type v} {A : Type w} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (F : I → MeasurableSpace Ω) (J : A → Set I)
    (hF : ∀ i, F i ≤ mΩ)
    (h : MutuallyIndependent P F)
    (hJ : Pairwise (fun a b => Disjoint (J a) (J b))) :
    MutuallyIndependent P (fun a => ⨆ i ∈ J a, F i) := by
  classical
  have hind := (mutuallyIndependent_iff_iIndep P F).mp h
  intro s
  induction s using Finset.induction_on with
  | empty =>
      intro E hE
      simp
  | @insert a s has ih =>
      intro E hE
      have hs := ih E (fun b hb => hE b (Finset.mem_insert_of_mem hb))
      let T : Set I := ⋃ b ∈ (s : Set A), J b
      have hdisj : Disjoint (J a) T := by
        apply Set.disjoint_left.mpr
        intro i hi hit
        obtain ⟨b, hb, hib⟩ := Set.mem_iUnion₂.mp hit
        have hab : a ≠ b := by
          intro hab
          subst b
          exact has hb
        exact Set.disjoint_left.mp (hJ hab) hi hib
      have htwo := ProbabilityTheory.indep_iSup_of_disjoint hF hind hdisj
      have hle (b : A) (hb : b ∈ s) :
          (⨆ i ∈ J b, F i) ≤ ⨆ i ∈ T, F i := by
        refine iSup₂_le fun i hi => le_iSup_of_le i (le_iSup_of_le ?_ le_rfl)
        exact Set.mem_iUnion₂.mpr ⟨b, hb, hi⟩
      have hmeas : MeasurableSet[⨆ i ∈ T, F i] (⋂ b ∈ s, E b) :=
        s.measurableSet_biInter fun b hb =>
          hle b hb _ (hE b (Finset.mem_insert_of_mem hb))
      have heq := (ProbabilityTheory.Indep_iff _ _ P).mp htwo
        (E a) (⋂ b ∈ s, E b) (hE a (Finset.mem_insert_self a s)) hmeas
      calc
        P (⋂ b ∈ insert a s, E b) = P (E a) * P (⋂ b ∈ s, E b) := by
          simpa only [Finset.set_biInter_insert] using heq
        _ = ∏ b ∈ insert a s, P (E b) := by
          rw [hs, Finset.prod_insert has]

end ProbabilityFoundations.Ch02
