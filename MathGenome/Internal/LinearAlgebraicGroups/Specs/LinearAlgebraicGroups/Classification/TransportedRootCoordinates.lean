noncomputable section

variable {k : Type u} [Field k] {A : AdditiveLine k}

/-- Membership in the saturation of the subgroup generated by the two characters.
Clearing denominators identifies this with membership in their rational span. -/
def InSaturatedSpan {T : GroupScheme k} (a b χ : Character T) : Prop :=
  ∃ m i j : ℤ, m ≠ 0 ∧ χ ^ m = a ^ i * b ^ j

/-- The common kernel subtorus is largest among subtori on which both characters
are trivial. Its defining lattice is the saturation, even in positive characteristic. -/
structure KernelSubtorus {T : GroupScheme k} (a b : Character T) where
  subgroup : ClosedSubgroup T
  split : IsSplitTorus subgroup.group
  torus : IsTorus subgroup.group
  left_trivial : subgroup.inclusion ≫ a = 1
  right_trivial : subgroup.inclusion ≫ b = 1
  largest : ∀ S : ClosedSubgroup T, IsTorus S.group →
    S.inclusion ≫ a = 1 → S.inclusion ≫ b = 1 → IsSubgroupOf S subgroup
  annihilator : ∀ χ : Character T, subgroup.inclusion ≫ χ = 1 ↔ InSaturatedSpan a b χ

/-- A comparison of the two scheme normalizers with the specified torus map
and the linked simple Weyl representatives. -/
structure Normalizers (P Q : PinnedGroup A) (D : AttachedDatum P.pair)
    (E : AttachedDatum Q.pair) (d : Root P.pair.T ≃ Root Q.pair.T)
    (τ : P.pair.T.group ⟶ Q.pair.T.group) where
  source : ClosedSubgroup P.pair.G.val
  target : ClosedSubgroup Q.pair.G.val
  sourceTorus : P.pair.T.group ⟶ source.group
  targetTorus : Q.pair.T.group ⟶ target.group
  hom : source.group ⟶ target.group
  representsSource : RepresentsSubgroup source (fun _ g => Normalizes P.pair.T.inclusion g)
  representsTarget : RepresentsSubgroup target (fun _ g => Normalizes Q.pair.T.inclusion g)
  sourceTorus_eq : sourceTorus ≫ source.inclusion = P.pair.T.inclusion
  targetTorus_eq : targetTorus ≫ target.inclusion = Q.pair.T.inclusion
  torus_comm : sourceTorus ≫ hom = τ ≫ targetTorus
  sourceSimple : ∀ i : SimpleRoot P.pair, SimpleRepresentative P D i
  targetSimple : ∀ i : SimpleRoot Q.pair, SimpleRepresentative Q E i
  simple_comm : ∀ (i : SimpleRoot P.pair) (j : SimpleRoot Q.pair), d i.val = j.val →
    ∃ x : 𝟙_ (SchemeOver k) ⟶ source.group.X,
      x ≫ source.inclusion.hom.hom = (sourceSimple i).reflection.representative ∧
      x ≫ hom.hom.hom ≫ target.inclusion.hom.hom = (targetSimple j).reflection.representative

/-- The left action of a rational representative on characters is pullback by
inverse conjugation on the full torus. -/
def MovesCharacter {G : GroupScheme k} (T : ClosedSubgroup G)
    (n : 𝟙_ (SchemeOver k) ⟶ G.X) (a b : Character T.group) : Prop :=
  ∃ e : T.group ≅ T.group,
    (e.hom ≫ T.inclusion).hom.hom =
      (toUnit T.group.X ≫ n) * T.inclusion.hom.hom * (toUnit T.group.X ≫ n)⁻¹ ∧
    e.inv ≫ a = b

/-- Conjugation transports an additive coordinate as a morphism of schemes.
The identity is tested over every commutative test algebra. -/
def TransportsCoordinate {G : GroupScheme k} (n : 𝟙_ (SchemeOver k) ⟶ G.X)
    (x y : A.group ⟶ G) : Prop :=
  ∀ (R : TestAlgebra k) (a : R),
    let g : GroupPoints G R := toUnit _ ≫ n
    g * rootPoint x R a * g⁻¹ = rootPoint y R a

/-- A family of isomorphisms between the indicated actual root subgroups. -/
abbrev RootIsomorphisms (P Q : PinnedGroup A)
    (d : Root P.pair.T ≃ Root Q.pair.T) :=
  ∀ α, (P.roots α).val.group ≅ (Q.roots (d α)).val.group

variable {P Q : PinnedGroup A} {D : AttachedDatum P.pair} {E : AttachedDatum Q.pair}
    {d : Root P.pair.T ≃ Root Q.pair.T} {τ : P.pair.T.group ⟶ Q.pair.T.group}

/-- The comparison intertwines normalizer conjugation on the root subgroup
schemes, including over nonreduced bases. A family with a locally constant Weyl
label acts by these diagrams on the open and closed pieces of its base. -/
def Intertwines (N : Normalizers P Q D E d τ) (e : RootIsomorphisms P Q d) : Prop :=
  ∀ (Z : SchemeOver k) (z : Z ⟶ N.source.group.X) (a b : Root P.pair.T)
    (c : (P.roots a).val.group.X ⊗ Z ⟶ (P.roots b).val.group.X),
    c ≫ (P.roots b).val.inclusion.hom.hom =
      conjugateFamily (P.roots a).val.inclusion (z ≫ N.source.inclusion.hom.hom) →
    ∃ c' : (Q.roots (d a)).val.group.X ⊗ Z ⟶ (Q.roots (d b)).val.group.X,
      c' ≫ (Q.roots (d b)).val.inclusion.hom.hom =
        conjugateFamily (Q.roots (d a)).val.inclusion
          (z ≫ N.hom.hom.hom ≫ N.target.inclusion.hom.hom) ∧
      ((e a).hom.hom.hom ▷ Z) ≫ c' = c ≫ (e b).hom.hom.hom

/-- The same root-group isomorphism results from every chamber and every
rational representative that moves a simple positive root to the given root. -/
def MatchesTransports (N : Normalizers P Q D E d τ) (e : RootIsomorphisms P Q d) : Prop :=
  (∀ a : Root P.pair.T, ∃ (i : SimpleRoot P.pair)
    (z : 𝟙_ (SchemeOver k) ⟶ N.source.group.X),
      MovesCharacter P.pair.T (z ≫ N.source.inclusion.hom.hom) i.val.val a.val) ∧
  ∀ (a : Root P.pair.T) (i : SimpleRoot P.pair) (j : SimpleRoot Q.pair),
    d i.val = j.val →
    ∀ z : 𝟙_ (SchemeOver k) ⟶ N.source.group.X,
      MovesCharacter P.pair.T (z ≫ N.source.inclusion.hom.hom) i.val.val a.val →
      ∃ x : A.group ≅ (P.roots a).val.group,
        TransportsCoordinate (z ≫ N.source.inclusion.hom.hom)
          ((P.pin i).val.hom ≫ (P.roots i.val).val.inclusion)
          (x.hom ≫ (P.roots a).val.inclusion) ∧
        TransportsCoordinate (z ≫ N.hom.hom.hom ≫ N.target.inclusion.hom.hom)
          ((Q.pin j).val.hom ≫ (Q.roots j.val).val.inclusion)
          ((x ≪≫ e a).hom ≫ (Q.roots (d a)).val.inclusion)

/-- Linked pairs transport to linked pairs with the corresponding coroot.
Their Weyl representatives agree under the normalizer comparison. -/
def MatchesLinkedPairs (N : Normalizers P Q D E d τ) (e : RootIsomorphisms P Q d) : Prop :=
  letI := D.comm
  letI := E.comm
  ∀ (a b : Root P.pair.T), b.val = a.val⁻¹ →
    ∀ (x : Pinning.RootCoordinate A P.pair.T (P.roots a).val a.val)
      (y : Pinning.RootCoordinate A P.pair.T (P.roots b).val b.val)
      (r : CorootReflection P.pair.T a.val
        (x.val.hom ≫ (P.roots a).val.inclusion) (y.val.hom ≫ (P.roots b).val.inclusion)),
      r.coroot = Additive.toMul (D.datum.rootDatum.coroot a) →
      (d b).val = (d a).val⁻¹ ∧
      ∃ s : CorootReflection Q.pair.T (d a).val
          ((x.val ≪≫ e a).hom ≫ (Q.roots (d a)).val.inclusion)
          ((y.val ≪≫ e b).hom ≫ (Q.roots (d b)).val.inclusion),
        s.coroot = Additive.toMul (E.datum.rootDatum.coroot (d a)) ∧
        ∃ z : 𝟙_ (SchemeOver k) ⟶ N.source.group.X,
          z ≫ N.source.inclusion.hom.hom = r.representative ∧
          z ≫ N.hom.hom.hom ≫ N.target.inclusion.hom.hom = s.representative

/-- The rank-two centralizer for a signed independent pair, with full maximal
torus and the inherited root and coroot characters. -/
structure Subsystem (P : PinnedGroup A) (D : AttachedDatum P.pair)
    (a b : Root P.pair.T) where
  kernel : KernelSubtorus a.val b.val
  localGroup : PinnedGroup A
  closed : ClosedSubgroup P.pair.G.val
  groupIso : localGroup.pair.G.val ≅ closed.group
  centralizes : IsCentralizer (subgroupOfSubgroup P.pair.T kernel.subgroup) closed
  torus : P.pair.T.group ≅ localGroup.pair.T.group
  torus_comm : torus.hom ≫ localGroup.pair.T.inclusion ≫ groupIso.hom ≫ closed.inclusion =
    P.pair.T.inclusion
  datum : AttachedDatum localGroup.pair
  rank : letI := datum.comm; datum.base.support.card = 2
  roots : Root localGroup.pair.T ↪ Root P.pair.T
  root_eq : ∀ r, torus.hom ≫ r.val = (roots r).val
  root_range : Set.range roots = {r | InSaturatedSpan a.val b.val r.val}
  coroot_eq : letI := D.comm; letI := datum.comm; ∀ r,
    Additive.toMul (D.datum.rootDatum.coroot (roots r)) ≫ torus.hom =
      Additive.toMul (datum.datum.rootDatum.coroot r)
  positive : letI := datum.comm; ∀ r,
    datum.base.IsPos r ↔ r ∈ subgroupRoots localGroup.pair.T localGroup.pair.B
  rootIso : ∀ r, (localGroup.roots r).val.group ≅ (P.roots (roots r)).val.group
  root_comm : ∀ r, (localGroup.roots r).val.inclusion ≫ groupIso.hom ≫ closed.inclusion =
    (rootIso r).hom ≫ (P.roots (roots r)).val.inclusion

/-- Local positive systems, pinnings and the rank-two lift can be chosen
compatibly with the global comparisons on every root of the subsystem. -/
def MatchesRankTwo (e : RootIsomorphisms P Q d) : Prop :=
  ∀ (a b : Root P.pair.T), ¬ Proportional a.val b.val →
    ∃ (S : Subsystem P D a b) (T : Subsystem Q E (d a) (d b))
      (δ : Root S.localGroup.pair.T ≃ Root T.localGroup.pair.T),
      let τ' := S.torus.inv ≫ τ ≫ T.torus.hom
      Compatible S.localGroup T.localGroup S.datum T.datum δ τ' ∧
      (∀ r, d (S.roots r) = T.roots (δ r)) ∧
        ∃ f : S.localGroup.pair.G.val ⟶ T.localGroup.pair.G.val,
          MatchesPinning δ τ' f ∧
          IsFinite f.hom.hom.left ∧ Flat f.hom.hom.left ∧ Surjective f.hom.hom.left ∧
          HasCentralTorusKernel τ' f ∧
          (Function.Surjective (pullbackCharacters τ) → IsIso f) ∧
          ∀ r : Root S.localGroup.pair.T,
            (S.localGroup.roots r).val.inclusion ≫ f ≫ T.groupIso.hom ≫ T.closed.inclusion =
              (S.rootIso r).hom ≫ (e (S.roots r)).hom ≫
                (Q.roots (d (S.roots r))).val.inclusion

/-- Choose linked ambient coordinates realizing the canonical root subgroup
comparisons, in a form that passes the signed relations to the open-cell theorem. -/
def MatchesCellCoordinates (e : RootIsomorphisms P Q d) : Prop :=
  letI := D.comm
  letI := E.comm
  ∃ (X : Coordinates D.datum A) (Y : Coordinates E.datum A),
    (∀ a, ∃ x : A.group ≅ (P.roots a).val.group,
      X.root a = x.hom ≫ (P.roots a).val.inclusion ∧
      Y.root (d a) = (x ≪≫ e a).hom ≫ (Q.roots (d a)).val.inclusion) ∧
    (∀ i : SimpleRoot P.pair, X.root i.val =
      (P.pin i).val.hom ≫ (P.roots i.val).val.inclusion) ∧
    (∀ j : SimpleRoot Q.pair, Y.root j.val =
      (Q.pin j).val.hom ≫ (Q.roots j.val).val.inclusion) ∧
    SameSignedCommutators X Y d

/-- The largest common-kernel subtorus and its full annihilator, over the
ground field. -/
def CommonKernelSubtorus : Prop :=
  ∀ {k : Type u} [Field k] {T : GroupScheme k}, IsSplitTorus T →
    ∀ a b : Character T, Nonempty (KernelSubtorus a b)

/-- Transport of simple pins under the compared normalizers determines the
root maps. These respect the linked coordinates and agree with the lifts of
the rank-two centralizers for every signed independent pair. -/
def Statement : Prop :=
  ∀ {k : Type u} [Field k] {A : AdditiveLine k} (P Q : PinnedGroup A)
    (D : AttachedDatum P.pair) (E : AttachedDatum Q.pair)
    (d : Root P.pair.T ≃ Root Q.pair.T) (τ : P.pair.T.group ⟶ Q.pair.T.group),
    Compatible P Q D E d τ →
    ∃ N : Normalizers P Q D E d τ,
      ∃ e : RootIsomorphisms P Q d,
        MatchesTransports N e ∧
        (∀ e' : RootIsomorphisms P Q d, MatchesTransports N e' → e' = e) ∧
        Intertwines N e ∧ MatchesLinkedPairs N e ∧
        MatchesRankTwo (D := D) (E := E) (τ := τ) e ∧
        MatchesCellCoordinates (D := D) (E := E) e

end

end LinearAlgebraicGroups.Specs.TransportedRootCoordinates
