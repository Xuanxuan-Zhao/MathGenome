open AlgebraicGeometry CategoryTheory
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj TensorProduct

universe u

namespace LinearAlgebraicGroups.Specs.TransportedRootCoordinates

open AbstractPairing (Root)
open AdjointRepresentation (GroupPoints)
open BorelsAndChambers (subgroupRoots)
open CellHomomorphism (Coordinates SameSignedCommutators)
open CharacterDescent (Character)
open GeometricBorelConjugacy (subgroupOfSubgroup)
open GeometricRadicals (IsSplitTorus IsTorus)
