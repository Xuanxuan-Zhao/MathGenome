import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.Pinning
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.CentralIsogenies
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Unipotent.ExactOperations

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.SimplyConnectedLattice

open GeometricRadicals (IsSemisimple GeometricGroup)
open CentralIsogenies (IsCentralIsogeny IsTorusRestriction)
open Pinning (AttachedDatum SplitBorelPair)
open CharacterDescent (Character Cocharacter)
open CharacterPairing (absoluteRoots pairing)
open CentralIsogenies (characterPullback)
open RankOneFlag (IsGeometricallyMaximal)
open GeometricRadicals (IsSplitTorus)
open AbstractPairing (Datum IsAttachedCoroot)
open SchemeCentre (rootLattice)
open SchemeDerivedGroup (RepresentsQuotient)

noncomputable section

variable {k : Type u} [Field k]

/-- Geometric simple connectedness tests all semisimple sources over an
algebraic closure and allows arbitrary finite central scheme kernels. -/
def GeometricallySimplyConnected (G : AffineAlgebraicGroup k) : Prop :=
  ∀ (H : AffineAlgebraicGroup (AlgebraicClosure k)), IsSemisimple H →
    ∀ f : H.val ⟶ (GeometricGroup G).val, IsCentralIsogeny f → IsIso f

/-- The integral subgroup generated by the attached coroots. -/
def corootLatticeOf {G : AffineAlgebraicGroup k} {T : ClosedSubgroup G.val}
    [IsCommMonObj T.group.X] (D : Datum T) : Submodule ℤ (Additive (Cocharacter T.group)) :=
  Submodule.span ℤ (Set.range D.rootDatum.coroot)

/-- The coroot lattice of a split Borel pair uses its attached root datum. -/
abbrev corootLattice {P : SplitBorelPair k} (D : AttachedDatum P) :
    letI := D.comm
    Submodule ℤ (Additive (Cocharacter P.T.group)) :=
  letI := D.comm
  corootLatticeOf D.datum

/-- The lattice criterion on the actual cocharacter lattice of any split
maximal torus. -/
def LatticeCriterion : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsSemisimple G →
    ∀ (T : ClosedSubgroup G.val), IsSplitTorus T.group → IsGeometricallyMaximal T →
      ∀ [IsCommMonObj T.group.X] (D : Datum T),
        GeometricallySimplyConnected G ↔ corootLatticeOf D = ⊤

/-- The split simply connected cover, with the specified map onto the full
coroot lattice inside the target cocharacter lattice. -/
def SplitCover : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsSemisimple G →
    ∀ (T : ClosedSubgroup G.val), IsSplitTorus T.group → IsGeometricallyMaximal T →
      ∀ [IsCommMonObj T.group.X] (D : Datum T),
        ∃ (S : SplitBorelPair k) (E : AttachedDatum S)
          (f : S.G.val ⟶ G.val) (τ : S.T.group ⟶ T.group),
          IsSemisimple S.G ∧ GeometricallySimplyConnected S.G ∧
          IsCentralIsogeny f ∧ IsTorusRestriction f τ ∧ corootLattice E = ⊤ ∧
          letI := E.comm
          ∃ e : Additive (Cocharacter S.T.group) ≃ₗ[ℤ] corootLatticeOf D,
            ∀ c : Cocharacter S.T.group,
              (e (Additive.ofMul c)).val = Additive.ofMul (c ≫ τ)

/-- The adjoint datum through the full scheme-centre quotient. The root
lattice is identified by character pullback and the corresponding coroots
are carried by the dual cocharacter pushforward. -/
def AdjointForm : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsSemisimple G →
    ∀ (T : ClosedSubgroup G.val), IsSplitTorus T.group → IsGeometricallyMaximal T →
    ∃ (Z : ClosedSubgroup G.val) (Q : AffineAlgebraicGroup k) (q : G.val ⟶ Q.val),
      RepresentsSubgroup Z (fun _ z => Centralizes (𝟙 G.val) z) ∧
      RepresentsQuotient Z q ∧ IsCentralIsogeny q ∧ IsSemisimple Q ∧
      ∃ (Tad : ClosedSubgroup Q.val) (qT : T.group ⟶ Tad.group),
        IsSplitTorus Tad.group ∧ IsGeometricallyMaximal Tad ∧
        IsTorusRestriction q qT ∧ Function.Injective (characterPullback qT) ∧
        (characterPullback qT).range = rootLattice T ∧ rootLattice Tad = ⊤ ∧
        Set.BijOn (characterPullback qT) (absoluteRoots Tad) (absoluteRoots T) ∧
        (∀ (χ : Character Tad.group) (c : Cocharacter T.group),
          pairing Tad.group χ (c ≫ qT) = pairing T.group (characterPullback qT χ) c) ∧
        ∀ (β : Character Tad.group) (hβ : β ∈ absoluteRoots Tad)
          (hα : characterPullback qT β ∈ absoluteRoots T)
          (c : Cocharacter T.group) (cad : Cocharacter Tad.group),
          IsAttachedCoroot T ⟨characterPullback qT β, hα⟩ c →
          IsAttachedCoroot Tad ⟨β, hβ⟩ cad →
          c ≫ qT = cad

