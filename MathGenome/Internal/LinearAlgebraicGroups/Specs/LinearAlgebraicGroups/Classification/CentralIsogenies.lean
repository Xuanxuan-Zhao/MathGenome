import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.AbstractPairing
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.SchemeCentre
import Mathlib.AlgebraicGeometry.Morphisms.Finite

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.CentralIsogenies

open AbstractPairing (IsAttachedCoroot)
open CharacterDescent (Character Cocharacter)
open CharacterPairing (absoluteRoots)
open GeometricRadicals (IsReductive IsSemisimple IsSplitTorus)
open RankOneFlag (IsGeometricallyMaximal)
open RootGroups (IsRootSubgroup)
open SchemeCentre (rootLattice)
open SchemeDerivedGroup (RepresentsQuotient)

noncomputable section

variable {k : Type u} [Field k] {G H : GroupScheme k}

/-- A finite faithfully flat homomorphism whose scheme kernel is central. -/
def IsCentralIsogeny (f : G ⟶ H) : Prop :=
  IsFinite f.hom.hom.left ∧ Flat f.hom.hom.left ∧ Surjective f.hom.hom.left ∧
    ∃ N : ClosedSubgroup G, IsSchemeKernel f N ∧
      Centralizes (𝟙 G) N.inclusion.hom.hom

/-- The restriction to the specified closed tori carries the source torus
faithfully flatly onto the target torus. -/
def IsTorusRestriction (f : G ⟶ H) {T : ClosedSubgroup G} {S : ClosedSubgroup H}
    (fT : T.group ⟶ S.group) : Prop :=
  fT ≫ S.inclusion = T.inclusion ≫ f ∧
    Flat fT.hom.hom.left ∧ Surjective fT.hom.hom.left

/-- The pullback on the actual character groups is precomposition. -/
def characterPullback (fT : G ⟶ H) : Character H →* Character G where
  toFun χ := fT ≫ χ
  map_one' := Grp.hom_ext _ _ (MonObj.comp_one fT.hom.hom)
  map_mul' χ ψ := Grp.hom_ext _ _ (MonObj.comp_mul fT.hom.hom χ.hom.hom ψ.hom.hom)

/-- Finite faithfully flat central isogenies identify the roots, root
subgroup schemes and attached coroots of the two split pairs. -/
def CentralIsogenyComparison : Prop :=
  ∀ {k : Type u} [Field k] (G₁ G₂ : AffineAlgebraicGroup k),
    IsReductive G₁ → IsReductive G₂ →
    ∀ (T₁ : ClosedSubgroup G₁.val) (T₂ : ClosedSubgroup G₂.val),
      IsSplitTorus T₁.group → IsGeometricallyMaximal T₁ →
      IsSplitTorus T₂.group → IsGeometricallyMaximal T₂ →
      ∀ (f : G₁.val ⟶ G₂.val) (fT : T₁.group ⟶ T₂.group),
        IsCentralIsogeny f →
        fT ≫ T₂.inclusion = T₁.inclusion ≫ f →
        Surjective fT.hom.hom.left →
        Function.Injective (characterPullback fT) ∧
        Finite (Character T₁.group ⧸ (characterPullback fT).range) ∧
        Set.BijOn (characterPullback fT) (absoluteRoots T₂) (absoluteRoots T₁) ∧
        ∀ (β : Character T₂.group) (hβ : β ∈ absoluteRoots T₂)
          (hα : characterPullback fT β ∈ absoluteRoots T₁),
          (∀ (U₁ : ClosedSubgroup G₁.val) (U₂ : ClosedSubgroup G₂.val),
            IsRootSubgroup T₁ U₁ (characterPullback fT β) → IsRootSubgroup T₂ U₂ β →
            ∃ e : U₁.group ≅ U₂.group, e.hom ≫ U₂.inclusion = U₁.inclusion ≫ f) ∧
          (∀ (c₁ : Cocharacter T₁.group) (c₂ : Cocharacter T₂.group),
            IsAttachedCoroot T₁ ⟨characterPullback fT β, hα⟩ c₁ →
            IsAttachedCoroot T₂ ⟨β, hβ⟩ c₂ →
            c₁ ≫ fT = c₂)

/-- For the fppf quotient by the full scheme centre of a split semisimple
group, pullback from the image maximal torus identifies its character
lattice with the subgroup generated by the original roots. -/
def AdjointCharacterLattice : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsSemisimple G →
    ∀ T : ClosedSubgroup G.val, IsSplitTorus T.group → IsGeometricallyMaximal T →
      ∃ (Z : ClosedSubgroup G.val) (Gad : AffineAlgebraicGroup k) (q : G.val ⟶ Gad.val),
        RepresentsSubgroup Z (fun _ z ↦ Centralizes (𝟙 G.val) z) ∧
        RepresentsQuotient Z q ∧
        ∃ (Tad : ClosedSubgroup Gad.val) (qT : T.group ⟶ Tad.group),
          IsSplitTorus Tad.group ∧ IsGeometricallyMaximal Tad ∧
          IsTorusRestriction q qT ∧
          Function.Injective (characterPullback qT) ∧
          (characterPullback qT).range = rootLattice T

end

end LinearAlgebraicGroups.Specs.CentralIsogenies
