import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Representation.EquivariantCoherentSubobjectExtension

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open CategoryTheory.CartesianMonoidalCategory

universe u

namespace LinearAlgebraicGroups.Specs.EquivariantCoherentOpenExtension

open EquivariantAffineModules

noncomputable section

variable {k : Type u} [Field k] {T : GroupScheme k} {X Y : SchemeOver k}
variable {a : ModObj T.X X} {b : ModObj T.X Y}

/-- The ambient hypotheses for coherent subobject extension. -/
abbrev IsExtensionSetting (a : ModObj T.X X) (b : ModObj T.X Y) (j : Y ⟶ X) : Prop :=
  EquivariantCoherentSubobjectExtension.IsExtensionSetting a b j

/-- The prescribed equivariant identification with the actual inverse image. -/
abbrev PullbackLinearizationComparison (j : Y ⟶ X) {M : X.left.Modules} {N : Y.left.Modules}
    (L : Linearization a M) (K : Linearization b N) (e : Pull j M ≅ N) : Prop :=
  EquivariantCoherentSubobjectExtension.PullbackLinearizationComparison j L K e

def CoherentExtension : Prop :=
  ∀ {k : Type u} [Field k] {T : GroupScheme k} {X Y : SchemeOver k}
    {a : ModObj T.X X} {b : ModObj T.X Y} (j : Y ⟶ X) [IsOpenImmersion j.left],
    IsExtensionSetting a b j →
    ∀ H : EquivariantCoherent b, ∃ (F : EquivariantCoherent a) (e : Pull j F.sheaf ≅ H.sheaf),
      IsEquivariantPullback j F H e

/-- Extension inside the specified ambient equivariant quasi-coherent sheaf. -/
abbrev SubobjectExtension : Prop :=
  EquivariantCoherentSubobjectExtension.SubobjectExtension.{u}

def ShortExactExtension : Prop :=
  ∀ {k : Type u} [Field k] {T : GroupScheme k} {X Y : SchemeOver k}
    {a : ModObj T.X X} {b : ModObj T.X Y} (j : Y ⟶ X) [IsOpenImmersion j.left],
    IsExtensionSetting a b j →
    ∀ (H₁ H₂ H₃ : EquivariantCoherent b) (f : H₁.sheaf ⟶ H₂.sheaf)
      (g : H₂.sheaf ⟶ H₃.sheaf) (w : f ≫ g = 0), EquivariantHom f → EquivariantHom g →
      (ShortComplex.mk f g w).ShortExact →
      ∃ (F₁ F₂ F₃ : EquivariantCoherent a) (i : F₁.sheaf ⟶ F₂.sheaf)
        (p : F₂.sheaf ⟶ F₃.sheaf) (z : i ≫ p = 0)
        (e₁ : Pull j F₁.sheaf ≅ H₁.sheaf) (e₂ : Pull j F₂.sheaf ≅ H₂.sheaf)
        (e₃ : Pull j F₃.sheaf ≅ H₃.sheaf),
        EquivariantHom i ∧ EquivariantHom p ∧ (ShortComplex.mk i p z).ShortExact ∧
        IsEquivariantPullback j F₁ H₁ e₁ ∧ IsEquivariantPullback j F₂ H₂ e₂ ∧
        IsEquivariantPullback j F₃ H₃ e₃ ∧
        (Scheme.Modules.pullback j.left).map i ≫ e₂.hom = e₁.hom ≫ f ∧
        (Scheme.Modules.pullback j.left).map p ≫ e₃.hom = e₂.hom ≫ g

/-- Classes generated by coherent equivariant sheaves with zero open pullback. -/
def supportedClasses (a : ModObj T.X X) (j : Y ⟶ X) :
    Submodule (CharacterRing T) (GZero a) :=
  Submodule.span _ {x | ∃ F : EquivariantCoherent a, IsZero (Pull j F.sheaf) ∧ x = classOf F}

/-- The actual kernel and cokernel of an equivariant morphism, as equivariant
coherent sheaves whose open pullbacks vanish. -/
def HasSupportedKernelCokernel (j : Y ⟶ X) {F G : EquivariantCoherent a}
    (f : F.sheaf ⟶ G.sheaf) : Prop :=
  ∃ (K Q : EquivariantCoherent a)
    (i : K.sheaf ⟶ F.sheaf) (p : G.sheaf ⟶ Q.sheaf)
    (hi : i ≫ f = 0) (hp : f ≫ p = 0),
    EquivariantHom i ∧ EquivariantHom p ∧
    Nonempty (IsLimit (KernelFork.ofι i hi)) ∧ Nonempty (IsColimit (CokernelCofork.ofπ p hp)) ∧
    IsZero (Pull j K.sheaf) ∧ IsZero (Pull j Q.sheaf)

/-- Extend the graph in the actual binary direct sum. The two projection
identities specify its prescribed open restriction. -/
def GraphComparison : Prop :=
  ∀ {k : Type u} [Field k] {T : GroupScheme k} {X Y : SchemeOver k}
    {a : ModObj T.X X} {b : ModObj T.X Y} (j : Y ⟶ X) [IsOpenImmersion j.left],
    IsExtensionSetting a b j →
    ∀ (F G : EquivariantCoherent a) (H K : EquivariantCoherent b)
      (eF : Pull j F.sheaf ≅ H.sheaf) (eG : Pull j G.sheaf ≅ K.sheaf) (d : H.sheaf ≅ K.sheaf),
      IsEquivariantPullback j F H eF → IsEquivariantPullback j G K eG → EquivariantHom d.hom →
      ∃ (L : Linearization a (F.sheaf ⊞ G.sheaf)) (D : EquivariantCoherent a)
        (m : D.sheaf ⟶ F.sheaf ⊞ G.sheaf) (eD : Pull j D.sheaf ≅ H.sheaf),
        IsLinearizedMap L F.lin biprod.fst ∧ IsLinearizedMap L G.lin biprod.snd ∧
        Mono m ∧ IsLinearizedMap D.lin L m ∧ IsEquivariantPullback j D H eD ∧
        (Scheme.Modules.pullback j.left).map (m ≫ biprod.fst) ≫ eF.hom = eD.hom ∧
        (Scheme.Modules.pullback j.left).map (m ≫ biprod.snd) ≫ eG.hom = eD.hom ≫ d.hom ∧
        HasSupportedKernelCokernel j (F := D) (G := F) (m ≫ biprod.fst) ∧
        HasSupportedKernelCokernel j (F := D) (G := G) (m ≫ biprod.snd) ∧
        (supportedClasses a j).mkQ (classOf F) = (supportedClasses a j).mkQ (classOf G)

end

end LinearAlgebraicGroups.Specs.EquivariantCoherentOpenExtension
