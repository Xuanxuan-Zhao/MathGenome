import Mathlib.LinearAlgebra.RootSystem.Base
import Mathlib.LinearAlgebra.TensorProduct.Basis
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.CartanMatrix

/-! The real root span and the rational cocharacter complement of a based root datum. -/

noncomputable section

open scoped TensorProduct
open Set Module LieAlgebrasAndRepresentations

namespace LinearAlgebraicGroups.RootData

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]

/-- Extension of an integer-valued lattice functional to a scalar extension. -/
def extendFunctional {L : Type*} [AddCommGroup L]
    (K : Type*) [CommRing K] (f : L →ₗ[ℤ] ℤ) : K ⊗[ℤ] L →ₗ[K] K :=
  (TensorProduct.AlgebraTensorModule.rid ℤ K K).toLinearMap.comp (f.baseChange K)

@[simp]
theorem extendFunctional_one_tmul {L : Type*} [AddCommGroup L]
    (K : Type*) [CommRing K] (f : L →ₗ[ℤ] ℤ) (x : L) :
    extendFunctional K f (1 ⊗ₜ[ℤ] x) = (f x : K) := by
  simp [extendFunctional, zsmul_eq_mul]

variable (P : RootDatum (ι := ι) X Y)

/-- The root span inside the scalar extension of the character lattice. -/
def realRootSpan : Submodule ℝ (ℝ ⊗[ℤ] X) :=
  Submodule.span ℝ (range fun i => (1 : ℝ) ⊗ₜ[ℤ] P.root i)

/-- The root in its real span. -/
def realRoot (i : ι) : realRootSpan P :=
  ⟨1 ⊗ₜ[ℤ] P.root i, Submodule.subset_span (mem_range_self i)⟩

/-- The scalar-extended coroot functional, restricted to the root span. -/
def realCoroot (i : ι) : realRootSpan P →ₗ[ℝ] ℝ :=
  (extendFunctional ℝ (P.coroot' i)).comp (realRootSpan P).subtype

@[simp]
theorem realCoroot_apply_root (i j : ι) :
    realCoroot P i (realRoot P j) = (P.pairing j i : ℝ) :=
  extendFunctional_one_tmul ℝ (P.coroot' i) (P.root j)

/-- The extension of the lattice reflection to the real root span. -/
def realReflection (i : ι) : realRootSpan P ≃ₗ[ℝ] realRootSpan P :=
  Module.reflection (x := realRoot P i) (f := realCoroot P i) (by simp)

/-- The group generated by these reflections on the root span. -/
def realWeylGroup : Subgroup (realRootSpan P ≃ₗ[ℝ] realRootSpan P) :=
  Subgroup.closure (range (realReflection P))

/-- The integral Cartan matrix with rows indexed by simple coroots. -/
def integralCartan (b : P.Base) : Matrix b.support b.support ℤ :=
  fun i j => P.pairing j i

/-- The span of the simple coroots in the rational cocharacter space. -/
def rationalSimpleCorootSpan (b : P.Base) : Submodule ℚ (ℚ ⊗[ℤ] Y) :=
  Submodule.span ℚ (range fun i : b.support => (1 : ℚ) ⊗ₜ[ℤ] P.coroot i)

/-- The common annihilator of all roots in the rational cocharacter space. -/
def rationalRootAnnihilator : Submodule ℚ (ℚ ⊗[ℤ] Y) :=
  ⨅ i : ι, (extendFunctional ℚ (P.root' i)).ker

namespace EuclideanComparisonSpecs

def comparisonType.{u,v,w} : Prop :=
  ∀ {ι : Type u} {X : Type v} {Y : Type w}
    [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    [Module.Free ℤ X] [Module.Free ℤ Y] [Module.Finite ℤ X] [Module.Finite ℤ Y]
    (P : RootDatum (ι := ι) X Y) [P.IsReduced] (B : P.Base),
    let E := realRootSpan P
    let R := range (realRoot P)
    Function.Injective (realRoot P) ∧
    (∀ (i : ι) (x : E), (E.subtype (realReflection P i x)) =
      LinearEquiv.baseChange ℤ ℝ X X (P.reflection i) (E.subtype x)) ∧
    Finite (realWeylGroup P) ∧
    (∀ g : realWeylGroup P, g.val '' R = R) ∧
    (∀ g h : realWeylGroup P, (∀ x ∈ R, g.val x = h.val x) → g = h) ∧
    ∃ metric : InnerProductSpace.Core ℝ E,
      letI : NormedAddCommGroup E := metric.toNormedAddCommGroup
      letI : InnerProductSpace ℝ E := InnerProductSpace.ofCore metric.toCore
      (∀ (g : realWeylGroup P) (x y : E), inner ℝ (g.val x) (g.val y) = inner ℝ x y) ∧
      (∀ (i : ι) (x : E), realCoroot P i x =
        2 * inner ℝ x (realRoot P i) / inner ℝ (realRoot P i) (realRoot P i)) ∧
      (∀ (i : ι) (x : E), realReflection P i x = rootReflection (realRoot P i) x) ∧
      IsRootSystem R ∧
      ∃ (z : E) (b : Basis B.support ℝ E),
        RootRegular R z ∧
        (∀ i, inner ℝ z (realRoot P i) = (B.height i : ℝ)) ∧
        positiveRoots R z = realRoot P '' {i | B.IsPos i} ∧
        (∀ i, b i = realRoot P i) ∧
        IsSimpleBasis R z b ∧
        cartanMatrix b = (integralCartan P B).map (fun n : ℤ => (n : ℝ)) ∧
        (∀ (i : B.support) (j : ι),
          inner ℝ (realRoot P j) (coroot (b i)) = (P.pairing j i : ℝ)) ∧
        (Matrix.gram ℝ b).PosDef

def rationalComplementType.{u,v,w} : Prop :=
  ∀ {ι : Type u} {X : Type v} {Y : Type w}
    [Finite ι] [AddCommGroup X] [AddCommGroup Y]
    [Module.Free ℤ X] [Module.Free ℤ Y] [Module.Finite ℤ X] [Module.Finite ℤ Y]
    (P : RootDatum (ι := ι) X Y) [P.IsReduced] (B : P.Base),
    ∀ [DecidableEq B.support],
    IsUnit ((Int.castRingHom ℚ).mapMatrix (integralCartan P B)).det ∧
      IsCompl (rationalSimpleCorootSpan P B) (rationalRootAnnihilator P)

end EuclideanComparisonSpecs
end LinearAlgebraicGroups.RootData
