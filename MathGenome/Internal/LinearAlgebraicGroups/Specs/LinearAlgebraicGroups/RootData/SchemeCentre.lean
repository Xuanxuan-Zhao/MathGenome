import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.RankOneFlag

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj

universe u
noncomputable section

namespace LinearAlgebraicGroups.Specs.SchemeCentre

open CharacterDescent (Character)
open CharacterPairing (absoluteRoots)
open DiagonalizableGroups (groupAlgebra groupAlgebraMap diagonalClosedInclusion)
open GeometricRadicals (IsReductive IsSplitTorus)
open RankOneFlag (IsGeometricallyMaximal)

variable {k : Type u} [Field k]

/-- The subgroup of the character lattice integrally generated by the absolute roots. -/
def rootLattice {G : GroupScheme k} (T : ClosedSubgroup G) :
    Subgroup (Character T.group) :=
  Subgroup.closure (absoluteRoots T)

/-- The centre in a split connected reductive pair, with its inclusion through the
split maximal torus. The quotient is the full character quotient, including torsion. -/
def CentreFormula : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsReductive G →
    ∀ T : ClosedSubgroup G.val, IsSplitTorus T.group → IsGeometricallyMaximal T →
    ∃ _ : Group.FG (Character T.group),
    ∃ e : specGroup (groupAlgebra k (Character T.group)) ≅ T.group,
      (∀ α : Character T.group, e.hom ≫ α =
        specGroupMap (groupAlgebraMap k
          ((zpowersHom (Character T.group) α).comp MulEquiv.ulift.toMonoidHom))) ∧
      ∃ h : IsClosedImmersion
          (diagonalClosedInclusion k (rootLattice T) ≫ e.hom ≫ T.inclusion).hom.hom.left,
        let Z : ClosedSubgroup G.val :=
          ⟨specGroup (groupAlgebra k (Character T.group ⧸ rootLattice T)),
            diagonalClosedInclusion k (rootLattice T) ≫ e.hom ≫ T.inclusion, h⟩
        RepresentsSubgroup Z (fun _ z ↦ Centralizes (𝟙 G.val) z) ∧
          ∀ (R : TestAlgebra k) (t : Points T.group.X R),
            Centralizes (𝟙 G.val) (t ≫ T.inclusion.hom.hom) ↔
              ∀ α ∈ absoluteRoots T, t ≫ α.hom.hom = 1

end LinearAlgebraicGroups.Specs.SchemeCentre
