namespace LinearAlgebraicGroups.DiagonalizableFixedLocus

open WeightDecomposition

noncomputable section

variable {k M A : Type u} [Field k] [CommGroup M] [CommRing A] [Algebra k A]

/-- A right coaction on a coordinate algebra, preserving its algebra structure. -/
structure CoordinateCoaction where
  hom : A →ₐ[k] A ⊗[k] MonoidAlgebra k M
  toRightComodule : RightComodule k (MonoidAlgebra k M) A
  coaction_eq : toRightComodule.coaction = hom.toLinearMap

/-- The ideal generated by all functions in nontrivial character spaces. -/
def fixedIdeal (ρ : CoordinateCoaction (k := k) (M := M) (A := A)) : Ideal A :=
  Ideal.span {a | ∃ m : M, m ≠ 1 ∧ a ∈ weightSpace ρ.toRightComodule m}

/-- Derivations into the residue field, whose multiplication by coordinate
functions is through the point. -/
def coordinateTangent {K : Type u} [Field K] [Algebra k K] (x : A →ₐ[k] K) :
    Submodule K (A →ₗ[k] K) where
  carrier := {d | ∀ a b, d (a * b) = x a * d b + d a * x b}
  zero_mem' := by simp
  add_mem' := by
    intro f g hf hg a b
    change f (a * b) + g (a * b) = x a * (f b + g b) + (f a + g a) * x b
    rw [hf a b, hg a b]
    ring
  smul_mem' := by
    intro c f hf a b
    change c * f (a * b) = x a * (c * f b) + (c * f a) * x b
    rw [hf a b]
    ring

/-- Trivial-weight derivations, characterized by vanishing on functions of
nontrivial weight. -/
def invariantCoordinateTangent {K : Type u} [Field K] [Algebra k K]
    (ρ : CoordinateCoaction (k := k) (M := M) (A := A)) (x : A →ₐ[k] K) :
    Submodule K (A →ₗ[k] K) :=
  coordinateTangent x ⊓
    { carrier := {d | ∀ m ≠ 1, ∀ a ∈ weightSpace ρ.toRightComodule m, d a = 0}
      zero_mem' := by simp
      add_mem' := by
        intro f g hf hg m hm a ha
        change f a + g a = 0
        rw [hf m hm a ha, hg m hm a ha, add_zero]
      smul_mem' := by
        intro c f hf m hm a ha
        change c * f a = 0
        rw [hf m hm a ha, mul_zero] }

/-- Tangent directions at a field-valued point, presented as maps from dual
numbers over its field, with prescribed reduction. -/
def TangentDirections {k K : Type u} [Field k] [Field K] [Algebra k K]
    (X : SchemeOver k) (x : Points X (CommAlgCat.of k K)) :=
  {v : Points X (CommAlgCat.of k (DualNumber K)) //
    mapPoints (CommAlgCat.ofHom (TrivSqZeroExt.fstHom k K K)) v = x}

/-- The pullback of the action map, with the coordinate algebra of the group
in the right tensor factor. -/
def affineActionCoactionHom [Group.FG M]
    (a : ModObj (Specs.DiagonalizableGroups.diagonalGroup k M).val.X
      ((testSpec k).obj (op (CommAlgCat.of k A)))) : A →ₐ[k] A ⊗[k] MonoidAlgebra k M :=
  let G := op (CommAlgCat.of k (MonoidAlgebra k M))
  let X := op (CommAlgCat.of k A)
  (Algebra.TensorProduct.comm k (MonoidAlgebra k M) A).toAlgHom.comp
    ((algSpec.fullyFaithful (R := CommRingCat.of k)).preimage
      (prodComparison (testSpec k) G X ≫ a.smul)).unop.hom

section ProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (k ι : Type u) [Field k]

/-- The projective scheme of lines in the coordinate space `ι → k`. -/
def projectiveSpace : SchemeOver k :=
  Over.mk (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule ι k) ≫
    Spec.map (CommRingCat.ofHom (algebraMap k ↥(MvPolynomial.homogeneousSubmodule ι k 0))))

/-- The open on which the `j`-th homogeneous coordinate is nonzero. -/
def projectiveChart (j : ι) : (projectiveSpace k ι).left.Opens :=
  Proj.basicOpen (MvPolynomial.homogeneousSubmodule ι k) (MvPolynomial.X j)

/-- The degree-zero part of the polynomial algebra with `X j` inverted. -/
abbrev projectiveChartRing (j : ι) :=
  HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule ι k) (MvPolynomial.X j)

theorem projectiveVariable_mem (j : ι) :
    MvPolynomial.X j ∈ MvPolynomial.homogeneousSubmodule ι k 1 :=
  (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k j)

/-- The standard chart map `Spec (k[X][1 / X j]₀) ⟶ Proj k[X]`. -/
def projectiveChartInclusion (j : ι) : Spec (CommRingCat.of (projectiveChartRing k ι j)) ⟶
    (projectiveSpace k ι).left :=
  Proj.awayι (MvPolynomial.homogeneousSubmodule ι k) (MvPolynomial.X j)
    (projectiveVariable_mem k ι j) Nat.one_pos

/-- The regular function `X i / X j` on the `j`-th chart. -/
def projectiveRatio (j i : ι) : projectiveChartRing k ι j :=
  HomogeneousLocalization.Away.isLocalizationElem (𝒜 := MvPolynomial.homogeneousSubmodule ι k)
    (projectiveVariable_mem k ι j) (projectiveVariable_mem k ι i)

variable {k ι} in
/-- The tuple `v` gives homogeneous coordinates for `x` if on a chart with
`v j ≠ 0` the regular functions `X i / X j` take the values `v i / v j`. -/
def HasProjectiveCoordinates {K : Type u} [Field K] [Algebra k K]
    (x : Points (projectiveSpace k ι) (CommAlgCat.of k K)) (v : ι → K) : Prop :=
  ∃ (j : ι) (f : projectiveChartRing k ι j →+* K),
    Spec.map (CommRingCat.ofHom f) ≫ projectiveChartInclusion k ι j = x.left ∧ v j ≠ 0 ∧
      ∀ i, f (projectiveRatio k ι j i) = v i / v j

/-- Projective transport in a basis on which the characters are `w`.
The formula on field-valued points suffices for checking preservation of opens. -/
def IsDiagonalProjectiveAction {k M ι : Type u} [Field k] [CommGroup M] [Group.FG M]
    (w : ι → M) (a : ModObj (Specs.DiagonalizableGroups.diagonalGroup k M).val.X
      (projectiveSpace k ι)) : Prop :=
  ∀ (K : Type u) [Field K] [Algebra k K]
    (g : MonoidAlgebra k M →ₐ[k] K) (x : Points (projectiveSpace k ι) (CommAlgCat.of k K))
    (v : ι → K), HasProjectiveCoordinates x v →
      HasProjectiveCoordinates (lift ((testSpec k).map (CommAlgCat.ofHom g).op) x ≫ a.smul)
        (fun j ↦ g (MonoidAlgebra.of k M (w j)) * v j)

variable {k ι} in
/-- The linear action after extension of scalars and evaluation at a group point. -/
def linearActionAt {M V K : Type u} [CommGroup M] [AddCommGroup V] [Module k V]
    [CommRing K] [Algebra k K] (ρ : RightComodule k (MonoidAlgebra k M) V)
    (g : MonoidAlgebra k M →ₐ[k] K) : K ⊗[k] V →ₗ[K] K ⊗[k] V :=
  ((TensorProduct.comm k V K).toLinearMap.comp
    ((g.toLinearMap.lTensor V).comp ρ.coaction)).liftBaseChange K

variable {k ι} in
/-- The projectivization of a linear action sends the line through a vector to
the line through its image. Here `c` identifies the given projective space with
the lines in `V`. The formula uses field-valued points, which detect whether
an open subscheme is preserved. -/
def IsProjectivizedLinearAction {M V : Type u} [CommGroup M] [Group.FG M]
    [AddCommGroup V] [Module k V] [Fintype ι] (c : Module.Basis ι k V)
    (ρ : RightComodule k (MonoidAlgebra k M) V)
    (a : ModObj (Specs.DiagonalizableGroups.diagonalGroup k M).val.X
      (projectiveSpace k ι)) : Prop :=
  ∀ (K : Type u) [Field K] [Algebra k K]
    (g : MonoidAlgebra k M →ₐ[k] K) (x : Points (projectiveSpace k ι) (CommAlgCat.of k K))
    (v : ι → K), HasProjectiveCoordinates x v →
      HasProjectiveCoordinates (lift ((testSpec k).map (CommAlgCat.ofHom g).op) x ≫ a.smul)
        (fun j ↦ (c.baseChange K).repr
          (linearActionAt ρ g (∑ i, v i • (c.baseChange K) i)) j)

end ProjectiveSpace

end
end LinearAlgebraicGroups.DiagonalizableFixedLocus

namespace LinearAlgebraicGroups.Specs.DiagonalizableFixedLocus

open LinearAlgebraicGroups.DiagonalizableFixedLocus
open DiagonalizableGroups (diagonalGroup)

def FixedAlgebraSmooth : Prop :=
  ∀ {k M A : Type u} [Field k] [CommGroup M] [CommRing A] [Algebra k A] [Algebra.Smooth k A]
    (ρ : CoordinateCoaction (k := k) (M := M) (A := A)), Algebra.Smooth k (A ⧸ fixedIdeal ρ)

def FixedAlgebraPoints : Prop :=
  ∀ {k M A R : Type u} [Field k] [CommGroup M] [CommRing A] [Algebra k A]
    [CommRing R] [Algebra k R] (ρ : CoordinateCoaction (k := k) (M := M) (A := A))
    (x : A →ₐ[k] R),
    (∀ a, x.toLinearMap.rTensor (MonoidAlgebra k M) (ρ.hom a) = x a ⊗ₜ[k] (1 : MonoidAlgebra k M))
      ↔ fixedIdeal ρ ≤ RingHom.ker x

/-- The invariant tangent directions are the dual-number families fixed by the
acting group scheme. This tests the action after every scalar extension of the
dual-number algebra. -/
def FixedTangentDirections : Prop :=
  ∀ {k K : Type u} [Field k] [Field K] [Algebra k K] {H X Z : SchemeOver k}
    (a : H ⊗ X ⟶ X) (i : Z ⟶ X), IsClosedImmersion i.left → RepresentsFixedPoints a i →
    ∀ (z : Points Z (CommAlgCat.of k K)),
      ∃ e : TangentDirections Z z ≃
          {v : TangentDirections X (z ≫ i) // IsFixedBy a v.val},
        ∀ v, (e v).val.val = v.val ≫ i

/-- Affine scheme version, including the cases in which the diagonalizable group is nonreduced. -/
def AffineFixedLocusSmooth : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M]
    (X : SchemeOver k) [IsAffine X.left] [Smooth X.hom]
    (a : ModObj (diagonalGroup k M).val.X X) (Z : SchemeOver k) (i : Z ⟶ X),
    IsClosedImmersion i.left → RepresentsFixedPoints a.smul i → Smooth Z.hom

/-- Smoothness is local on an invariant affine open cover of the fixed locus
in the ambient scheme. The cover need only meet every point of the fixed scheme. -/
def FixedLocusSmoothOnInvariantCharts : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M]
    (X : SchemeOver k) [Smooth X.hom]
    (a : ModObj (diagonalGroup k M).val.X X) (Z : SchemeOver k) (i : Z ⟶ X),
    IsClosedImmersion i.left → RepresentsFixedPoints a.smul i →
    (∀ z : Z.left, ∃ (U : SchemeOver k) (j : U ⟶ X),
      IsAffine U.left ∧ IsOpenImmersion j.left ∧ i.left z ∈ Set.range j.left ∧
        ∃ b : ModObj (diagonalGroup k M).val.X U,
          b.smul ≫ j = ((diagonalGroup k M).val.X ◁ j) ≫ a.smul) →
    Smooth Z.hom

/-- Every finite-dimensional representation admits a basis of character vectors. -/
def ExistsWeightBasis : Prop :=
  ∀ {k M V : Type u} [Field k] [CommGroup M] [AddCommGroup V] [Module k V]
    [FiniteDimensional k V]
    (ρ : RightComodule k (MonoidAlgebra k M) V),
    ∃ (ι : Type u) (_ : Finite ι) (b : Module.Basis ι k V) (w : ι → M),
      ∀ j, b j ∈ WeightDecomposition.weightSpace ρ (w j)

/-- For a smooth closed subscheme equivariantly embedded in projective space,
the standard affine charts in a weight basis yield smoothness of its fixed locus. -/
def ProjectivelyEmbeddedFixedLocusSmooth : Prop :=
  ∀ {k M ι : Type u} [Field k] [CommGroup M] [Group.FG M] [Finite ι]
    (X Z : SchemeOver k) [Smooth X.hom] (w : ι → M)
    (b : ModObj (diagonalGroup k M).val.X (projectiveSpace k ι))
    (a : ModObj (diagonalGroup k M).val.X X),
    IsDiagonalProjectiveAction w b →
    ∀ (e : X ⟶ projectiveSpace k ι), IsClosedImmersion e.left →
      a.smul ≫ e = ((diagonalGroup k M).val.X ◁ e) ≫ b.smul →
      ∀ (i : Z ⟶ X), IsClosedImmersion i.left → RepresentsFixedPoints a.smul i →
        Smooth Z.hom

/-- The smooth closed scheme of fixed points of a smooth equivariantly
embedded projective variety. -/
def ExistsProjectivelyEmbeddedFixedLocus : Prop :=
  ∀ {k M ι : Type u} [Field k] [CommGroup M] [Group.FG M] [Finite ι]
    (X : SchemeOver k) [Smooth X.hom] (w : ι → M)
    (b : ModObj (diagonalGroup k M).val.X (projectiveSpace k ι))
    (a : ModObj (diagonalGroup k M).val.X X),
    IsDiagonalProjectiveAction w b →
    ∀ (e : X ⟶ projectiveSpace k ι), IsClosedImmersion e.left →
      a.smul ≫ e = ((diagonalGroup k M).val.X ◁ e) ≫ b.smul →
      ∃ (Z : SchemeOver k) (i : Z ⟶ X),
        IsClosedImmersion i.left ∧ RepresentsFixedPoints a.smul i ∧ Smooth Z.hom

/-- Every point on a fixed family has an invariant affine open neighborhood
in a locally closed equivariant projective embedding. The basis used to
present the projective space is arbitrary. -/
def LinearProjectiveInvariantAffineNeighborhoods : Prop :=
  ∀ {k M ι V : Type u} [Field k] [CommGroup M] [Group.FG M] [Fintype ι]
    [AddCommGroup V] [Module k V] (c : Module.Basis ι k V)
    (ρ : RightComodule k (MonoidAlgebra k M) V) (X T : SchemeOver k)
    (b : ModObj (diagonalGroup k M).val.X (projectiveSpace k ι))
    (a : ModObj (diagonalGroup k M).val.X X),
    IsProjectivizedLinearAction c ρ b →
    ∀ (e : X ⟶ projectiveSpace k ι), IsImmersion e.left →
      a.smul ≫ e = ((diagonalGroup k M).val.X ◁ e) ≫ b.smul →
      ∀ (x : T ⟶ X), IsFixedBy a.smul x →
        ∀ t : T.left, ∃ (U : SchemeOver k) (j : U ⟶ X),
          IsAffine U.left ∧ IsOpenImmersion j.left ∧ x.left t ∈ Set.range j.left ∧
            ∃ aU : ModObj (diagonalGroup k M).val.X U,
              aU.smul ≫ j = ((diagonalGroup k M).val.X ◁ j) ≫ a.smul

/-- Smoothness of the fixed locus for a locally closed equivariant embedding
in the projectivization of a finite-dimensional linear action. -/
def LinearProjectivelyEmbeddedFixedLocusSmooth : Prop :=
  ∀ {k M ι V : Type u} [Field k] [CommGroup M] [Group.FG M] [Fintype ι]
    [AddCommGroup V] [Module k V] (c : Module.Basis ι k V)
    (ρ : RightComodule k (MonoidAlgebra k M) V) (X Z : SchemeOver k) [Smooth X.hom]
    (b : ModObj (diagonalGroup k M).val.X (projectiveSpace k ι))
    (a : ModObj (diagonalGroup k M).val.X X),
    IsProjectivizedLinearAction c ρ b →
    ∀ (e : X ⟶ projectiveSpace k ι), IsImmersion e.left →
      a.smul ≫ e = ((diagonalGroup k M).val.X ◁ e) ≫ b.smul →
      ∀ (i : Z ⟶ X), IsClosedImmersion i.left → RepresentsFixedPoints a.smul i →
        Smooth Z.hom

/-- The smooth closed scheme representing fixed points of a smooth variety
with a locally closed equivariant projective embedding. -/
def ExistsLinearProjectivelyEmbeddedFixedLocus : Prop :=
  ∀ {k M ι V : Type u} [Field k] [CommGroup M] [Group.FG M] [Fintype ι]
    [AddCommGroup V] [Module k V] (c : Module.Basis ι k V)
    (ρ : RightComodule k (MonoidAlgebra k M) V) (X : SchemeOver k) [Smooth X.hom]
    (b : ModObj (diagonalGroup k M).val.X (projectiveSpace k ι))
    (a : ModObj (diagonalGroup k M).val.X X),
    IsProjectivizedLinearAction c ρ b →
    ∀ (e : X ⟶ projectiveSpace k ι), IsImmersion e.left →
      a.smul ≫ e = ((diagonalGroup k M).val.X ◁ e) ≫ b.smul →
      ∃ (Z : SchemeOver k) (i : Z ⟶ X),
        IsClosedImmersion i.left ∧ RepresentsFixedPoints a.smul i ∧ Smooth Z.hom

/-- The locally closed projective result for a group scheme presented by
its split character group. The comodule is for that presentation of the
given linear action. -/
def SplitLinearProjectivelyEmbeddedFixedLocus : Prop :=
  ∀ {k M ι V : Type u} [Field k] [CommGroup M] [Group.FG M] [Fintype ι]
    [AddCommGroup V] [Module k V] (H : GroupScheme k) (d : (diagonalGroup k M).val ≅ H)
    (c : Module.Basis ι k V) (ρ : RightComodule k (MonoidAlgebra k M) V)
    (X : SchemeOver k) [Smooth X.hom]
    (b : ModObj H.X (projectiveSpace k ι)) (a : ModObj H.X X),
    (letI := b;
      IsProjectivizedLinearAction c ρ (Mod.scalarRestriction d.hom.hom.hom (projectiveSpace k ι))) →
    ∀ (e : X ⟶ projectiveSpace k ι), IsImmersion e.left →
      a.smul ≫ e = (H.X ◁ e) ≫ b.smul →
      (∀ (Z : SchemeOver k) (i : Z ⟶ X),
        IsClosedImmersion i.left → RepresentsFixedPoints a.smul i → Smooth Z.hom) ∧
      ∃ (Z : SchemeOver k) (i : Z ⟶ X),
        IsClosedImmersion i.left ∧ RepresentsFixedPoints a.smul i ∧ Smooth Z.hom

/-- The affine result, transported to any group scheme presented by a split
character group. In particular quotients of the exponent lattice are allowed. -/
def SplitDiagonalizableFixedLocusSmooth : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M] (H : GroupScheme k),
    ∀ (_ : (diagonalGroup k M).val ≅ H),
    ∀ (X : SchemeOver k) [IsAffine X.left] [Smooth X.hom]
      (a : ModObj H.X X) (Z : SchemeOver k) (i : Z ⟶ X),
      IsClosedImmersion i.left → RepresentsFixedPoints a.smul i → Smooth Z.hom

/-- The specialization to split tori, expressed using the standard products of
the multiplicative group. -/
def SplitTorusFixedLocusSmooth : Prop :=
  ∀ {k ι : Type u} [Field k] [Fintype ι] (H : GroupScheme k),
    ∀ (_ : (StandardGroups.multiplicativePowerGroup k ι).val ≅ H),
    ∀ (X : SchemeOver k) [IsAffine X.left] [Smooth X.hom]
      (a : ModObj H.X X) (Z : SchemeOver k) (i : Z ⟶ X),
      IsClosedImmersion i.left → RepresentsFixedPoints a.smul i → Smooth Z.hom

/-- Affine smoothness for actions of a closed subgroup scheme of a split
diagonalizable group, with the full subgroup scheme as the acting object. -/
def ClosedDiagonalizableFixedLocusSmooth : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M] (D : GroupScheme k)
    (d : D ⟶ (diagonalGroup k M).val), IsClosedImmersion d.hom.hom.left →
    ∀ (X : SchemeOver k) [IsAffine X.left] [Smooth X.hom]
      (a : ModObj D.X X) (Z : SchemeOver k) (i : Z ⟶ X),
      IsClosedImmersion i.left → RepresentsFixedPoints a.smul i → Smooth Z.hom

/-- The smooth scheme representing all fixed families on a smooth affine scheme. -/
def ExistsAffineFixedLocus : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M]
    (X : SchemeOver k) [IsAffine X.left] [Smooth X.hom]
    (a : ModObj (diagonalGroup k M).val.X X),
    ∃ (Z : SchemeOver k) (i : Z ⟶ X),
      IsClosedImmersion i.left ∧ RepresentsFixedPoints a.smul i ∧ Smooth Z.hom

/-- The centralizer of a full closed subgroup scheme of a split diagonalizable
group acting by conjugation on an ambient smooth affine group. -/
def DiagonalizableCentralizerSmooth : Prop :=
  ∀ {k M : Type u} [Field k] [CommGroup M] [Group.FG M]
    (G : AffineAlgebraicGroup k) [Smooth G.val.X.hom] (D : ClosedSubgroup G.val)
    (d : D.group ⟶ (diagonalGroup k M).val), IsClosedImmersion d.hom.hom.left →
    ∃ C : ClosedSubgroup G.val,
      RepresentsSubgroup C (fun _ g ↦ Centralizes D.inclusion g) ∧ Smooth C.group.X.hom

/-- The inclusion of the fixed locus identifies its affine tangent space with
the invariant subspace by the canonical field-linear map. -/
def AffineFixedTangentLinear : Prop :=
  ∀ {k M A K : Type u} [Field k] [CommGroup M] [CommRing A] [Algebra k A]
    [Field K] [Algebra k K] (ρ : CoordinateCoaction (k := k) (M := M) (A := A))
    (z : (A ⧸ fixedIdeal ρ) →ₐ[k] K),
    let q := Ideal.Quotient.mkₐ k (fixedIdeal ρ)
    let x := z.comp q
    (∀ d : coordinateTangent x,
      d.val ∈ invariantCoordinateTangent ρ x ↔
        ∀ a, d.val.rTensor (MonoidAlgebra k M) (ρ.hom a) =
          d.val a ⊗ₜ[k] (1 : MonoidAlgebra k M)) ∧
    ∃ e : coordinateTangent z ≃ₗ[K] invariantCoordinateTangent ρ x,
      ∀ d a, (e d).val a = d.val (q a)

/-- The derivation model agrees with the dual-number model of the same tangent
space. The derivation is the coefficient of the square-zero element. -/
def CoordinateTangentDualNumbers : Prop :=
  ∀ {k A K : Type u} [Field k] [CommRing A] [Algebra k A] [Field K] [Algebra k K]
    (x : A →ₐ[k] K),
    ∃ e : coordinateTangent x ≃
        {f : A →ₐ[k] DualNumber K // (TrivSqZeroExt.fstHom k K K).comp f = x},
      ∀ d a, TrivSqZeroExt.snd ((e d).val a) = d.val a

/-- At a fixed point of an affine scheme action, the derivation lies in the
trivial character space exactly when the corresponding dual-number point is
fixed by the whole group scheme. -/
def AffineActionTangentInvariants : Prop :=
  ∀ {k M A K : Type u} [Field k] [CommGroup M] [Group.FG M] [CommRing A] [Algebra k A]
    [Field K] [Algebra k K]
    (a : ModObj (diagonalGroup k M).val.X ((testSpec k).obj (op (CommAlgCat.of k A)))),
    ∃ ρ : CoordinateCoaction (k := k) (M := M) (A := A),
      ρ.hom = affineActionCoactionHom a ∧
      ∀ (x : A →ₐ[k] K), IsFixedBy a.smul ((testSpec k).map (CommAlgCat.ofHom x).op) →
        ∃ e : coordinateTangent x ≃
            {f : A →ₐ[k] DualNumber K // (TrivSqZeroExt.fstHom k K K).comp f = x},
          (∀ d b, TrivSqZeroExt.snd ((e d).val b) = d.val b) ∧
          ∀ d, d.val ∈ invariantCoordinateTangent ρ x ↔
            IsFixedBy a.smul ((testSpec k).map (CommAlgCat.ofHom (e d).val).op)

end LinearAlgebraicGroups.Specs.DiagonalizableFixedLocus
