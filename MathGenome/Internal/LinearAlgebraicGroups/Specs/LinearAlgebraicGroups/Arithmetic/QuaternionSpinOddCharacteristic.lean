section PerpendicularSpace

/-- A norm-one change on a nonsingular line, acting identically on its
orthogonal complement. The module over the opposite ring is the right
quaternion module. -/
def IsLineRotation {F B V : Type u} [Field F] [DivisionRing B] [Algebra F B]
    [AddCommGroup V] [Module Bᵐᵒᵖ V] {σ : Involution F B}
    (h : SkewHermitianPairing (V := V) σ) (g : V ≃ₗ[Bᵐᵒᵖ] V) : Prop :=
  ∃ (w : V) (r : Bˣ), h.value w w ≠ 0 ∧
    Commute (r : B) (h.value w w) ∧ antiValue σ.anti ↑r * (r : B) = 1 ∧
    ∀ x, g x = x + MulOpposite.op (((r : B) - 1) * (h.value w w)⁻¹ * h.value w x) • w

/-- A nonzero regular skew-Hermitian quaternion space contains a nonsingular
line. Its isometries are generated by rotations on such lines. -/
def PerpendicularRotationGeneration : Prop :=
  ∀ {F B V : Type u} [Field F] [DivisionRing B] [Algebra F B]
    [AddCommGroup V] [Module Bᵐᵒᵖ V] [Module.Finite Bᵐᵒᵖ V],
    (2 : F) ≠ 0 → ∀ (hB : isCentralSimple F B), degree F B = 2 →
    ∀ (σ : Involution F B), (∀ a, antiValue σ.anti a = quaternionConjugate hB a) →
    ∀ (h : SkewHermitianPairing (V := V) σ),
      ((∃ v : V, v ≠ 0) → ∃ w, h.value w w ≠ 0) ∧
      ∀ g : V ≃ₗ[Bᵐᵒᵖ] V,
        (∀ x y, h.value (g x) (g y) = h.value x y) ↔
          g ∈ Subgroup.closure {g | IsLineRotation h g}

/-- The quadratic field is generated by the pure norm of the fixed line.
The normalized affine line represents every nonscalar unit class. -/
def FixedLineParameters : Prop :=
  ∀ {F B : Type u} [Field F] [DivisionRing B] [Algebra F B],
    (2 : F) ≠ 0 → ∀ (hB : isCentralSimple F B), degree F B = 2 →
    ∀ (σ : Involution F B), (∀ a, antiValue σ.anti a = quaternionConjugate hB a) →
    ∀ (q : Bˣ), antiValue σ.anti ↑q = -(q : B) →
    ∃ (E : Type u) (_ : Field E) (_ : Algebra F E) (_ : Algebra.IsSeparable F E)
      (j : E →ₐ[F] B) (qE : Eˣ), j ↑qE = (q : B) ∧ Module.finrank F E = 2 ∧
      (∀ x : B, Commute x (q : B) ↔ x ∈ Set.range j) ∧
      (∀ z : E, ∃ x y : F, z = algebraMap F E x + algebraMap F E y * ↑qE) ∧
      (∀ x : E, antiValue σ.anti (j x) * j x = algebraMap F B (Algebra.norm F x)) ∧
      (∀ r : Eˣ, Algebra.norm F (r : E) = 1 → r ≠ 1 →
        ∃ b : Eˣ, (b : E) = ((r : E) - 1)⁻¹ * ↑qE⁻¹ ∧
          j ↑b - antiValue σ.anti (j ↑b) = -((q : B)⁻¹) ∧
          1 + (q : B)⁻¹ * (j (b : E))⁻¹ = j ↑r) ∧
      ∀ d : Eˣ, (d : E) ∉ Set.range (algebraMap F E) →
        ∃ c : Fˣ, let b := j (algebraMap F E (c : F) * ↑d)
          b - antiValue σ.anti b = -((q : B)⁻¹)

end PerpendicularSpace

section HyperbolicPresentation

variable {F K I B : Type u} [Field F] [Field K] [Algebra F K]
  [Fintype I] [DecidableEq I] [DivisionRing B] [Algebra F B]
  {ρ : AlgebraAction F K (Matrix (I ⊕ I) (I ⊕ I) K)}
  {G : AffineAlgebraicGroup F} {D : DescendedQuadraticPair ρ}
  {hB : isCentralSimple F B} {d : ℕ}

/-- A noncentral split cocharacter in the spin model with quaternion
division factor yields a hyperbolic basis with nonzero complement. -/
def QuaternionPresentationAtIsotropy : Prop :=
  ∀ {F K I B : Type u} [Field F] [Field K] [Algebra F K]
    [FiniteDimensional F K] [IsGalois F K] [Fintype I] [DecidableEq I]
    [DivisionRing B] [Algebra F B]
    {ρ : AlgebraAction F K (Matrix (I ⊕ I) (I ⊕ I) K)}
    {G : AffineAlgebraicGroup F} {D : DescendedQuadraticPair ρ},
    (P : SpinModel G D) → 4 ≤ Fintype.card I → (2 : F) ≠ 0 →
    ∀ (hB : isCentralSimple F B), degree F B = 2 →
    (∃ r : ℕ, Nonempty (ρ.fixedSubalgebra ≃ₐ[F] Matrix (Fin r) (Fin r) B)) →
    (∃ c : Cocharacter G.val, IsNoncentral c) →
    ∃ d : ℕ, 0 < d ∧ Nonempty (QuaternionHyperbolicPresentation D hB d)

variable (Q : QuaternionHyperbolicPresentation D hB d)

noncomputable abbrev coefficientConjugation (R : TestAlgebra F) := extendAnti Q.conjugation.anti R

noncomputable def complementGram (R : TestAlgebra F) :
    Matrix (Fin d) (Fin d) (R ⊗[F] B) :=
  Q.complement.val.map (fun b => 1 ⊗ₜ[F] b)

/-- The admissibility equation on a nonsingular line over a coefficient algebra. -/
noncomputable def ShearAdmissible (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F)
    (a b : R ⊗[F] B) : Prop :=
  hermitianValue Q.conjugation.anti Q.complement.val w w = (q : B) ∧
    b - antiValue (coefficientConjugation Q R) b =
      -(a * (1 ⊗ₜ[F] (↑q⁻¹ : B)) * antiValue (coefficientConjugation Q R) a)

/-- The upper and lower shears in the original basis, acting identically on the
perpendicular complement of the displayed line in the complementary space. -/
noncomputable def shearMatrix (upper : Bool) (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F)
    (a b : R ⊗[F] B) : Matrix (QuaternionPairIndex d) (QuaternionPairIndex d) (R ⊗[F] B) :=
  let C := R ⊗[F] B
  let W : Fin d → C := fun j => 1 ⊗ₜ[F] w j
  let p : C := 1 ⊗ₜ[F] (↑q⁻¹ : B)
  let row : Fin d → C := fun j =>
    a * p * ∑ i, antiValue (coefficientConjugation Q R) (W i) * complementGram Q R i j
  let col : Fin d → C := fun i => -(W i * p * antiValue (coefficientConjugation Q R) a)
  if upper then Matrix.fromBlocks !![1, b; 0, 1]
    (Matrix.of fun i j => if i = 0 then row j else 0)
    (Matrix.of fun i j => if j = 1 then col i else 0) 1
  else Matrix.fromBlocks !![1, 0; -b, 1]
    (Matrix.of fun i j => if i = 1 then -row j else 0)
    (Matrix.of fun i j => if j = 0 then col i else 0) 1

variable (P : SpinModel G D)

noncomputable def vectorMatrix (R : TestAlgebra F) (g : Points G.val.X R) :
    Matrix (QuaternionPairIndex d) (QuaternionPairIndex d) (R ⊗[F] B) :=
  Q.matrixAt R ((spinVectorProjection P R) g).val

/-- The two lifts are points of the specified spin radicals and commute with
change of coefficient algebra. -/
structure ShearLifts (c : Cocharacter G.val) where
  lift : ∀ (_upper : Bool) (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F)
    (a b : R ⊗[F] B), ShearAdmissible Q w q R a b → Points G.val.X R
  formula : ∀ upper w q R a b h,
    vectorMatrix Q P R (lift upper w q R a b h) = shearMatrix Q upper w q R a b
  contracting : ∀ upper w q R a b h,
    HasLimit (if upper then c else oppositeCocharacter c) (lift upper w q R a b h) 1
  natural : ∀ upper w q (R S : TestAlgebra F) (f : R ⟶ S) a b h h',
    mapPoints f (lift upper w q R a b h) =
      lift upper w q S (tensorMap B f.hom a) (tensorMap B f.hom b) h'

/-- The spin three-shear word, with the admissibility of the input matrices. -/
noncomputable def liftedInterchange {c : Cocharacter G.val}
    (L : ShearLifts Q P c) (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F)
    (a : R ⊗[F] B) (b : (R ⊗[F] B)ˣ)
    (h : ShearAdmissible Q w q R a ↑b)
    (h₁ : ShearAdmissible Q w q R
      (-(antiValue (coefficientConjugation Q R) ↑b⁻¹ * a))
      (antiValue (coefficientConjugation Q R) ↑b⁻¹))
    (h₂ : ShearAdmissible Q w q R (↑b⁻¹ * a) (antiValue (coefficientConjugation Q R) ↑b⁻¹)) :
    Points G.val.X R :=
  L.lift false w q R _ _ h₁ * L.lift true w q R a ↑b h * L.lift false w q R _ _ h₂

/-- The interchange acts by the stated multiplier on the line and fixes
its perpendicular complement in the Levi block. -/
noncomputable def interchangeMatrix (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F)
    (a : R ⊗[F] B) (b : (R ⊗[F] B)ˣ) :
    Matrix (QuaternionPairIndex d) (QuaternionPairIndex d) (R ⊗[F] B) :=
  let C := R ⊗[F] B
  let W : Fin d → C := fun j => 1 ⊗ₜ[F] w j
  let p : C := 1 ⊗ₜ[F] (↑q⁻¹ : B)
  let σ := coefficientConjugation Q R
  let δ := p * antiValue σ a * ↑b⁻¹ * a
  let act : Matrix (Fin d) (Fin d) C := Matrix.of fun i j =>
    W i * δ * p * ∑ k, antiValue σ (W k) * complementGram Q R k j
  Matrix.fromBlocks !![0, ↑b; -antiValue σ ↑b⁻¹, 0] 0 0 (1 + act)

def LiftedInterchangeFormula {c : Cocharacter G.val} (L : ShearLifts Q P c) : Prop :=
  ∀ (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F) (a : R ⊗[F] B) (b : (R ⊗[F] B)ˣ)
    (h : ShearAdmissible Q w q R a ↑b),
    ∃ h₁ h₂, vectorMatrix Q P R (liftedInterchange Q P L w q R a b h h₁ h₂) =
      interchangeMatrix Q w q R a b

/-- The scalar group acts by the two-by-two scalar matrix on the quaternion
pair. Its diagonal supplies the cocharacter for the two radicals. -/
def ScalarHyperbolicSL2 (c : Cocharacter G.val) : Prop :=
  ∃ (S : AffineAlgebraicGroup F)
    (e : (groupPointsFunctor F).obj S.val ≅ StandardGroups.specialLinearPoints F (ULift.{u} (Fin 2)))
    (j : S.val ⟶ G.val),
    let matrix (R : TestAlgebra F) (g : Points S.val.X R) : Matrix (Fin 2) (Fin 2) R :=
      Matrix.of fun i j => (e.hom.app R g).val (ULift.up i) (ULift.up j)
    IsClosedImmersion j.hom.hom.left ∧
    (∀ (R : TestAlgebra F) (g : Points S.val.X R),
      vectorMatrix Q P R (g ≫ j.hom.hom) =
        Matrix.fromBlocks ((matrix R g).map (algebraMap R (R ⊗[F] B))) 0 0 1) ∧
    (∀ (R : TestAlgebra F) (t : Rˣ),
      spinVectorProjection P R (cocharacterPoint c R t) =
        quaternionScale Q R (Units.map (algebraMap R (R ⊗[F] B)).toMonoidHom t) ∧
      ∃ g : Points S.val.X R,
        matrix R g = !![↑t, 0; 0, ↑t⁻¹] ∧ g ≫ j.hom.hom = cocharacterPoint c R t) ∧
    ∀ (R : TestAlgebra F) (x : R), ∃ upper lower : Points S.val.X R,
      matrix R upper = !![1, x; 0, 1] ∧ HasLimit c (upper ≫ j.hom.hom) 1 ∧
      matrix R lower = !![1, 0; x, 1] ∧ HasLimit (oppositeCocharacter c) (lower ≫ j.hom.hom) 1

/-- In the common scale preimage, a scalar ratio has second coordinate equal
to its parameter. Correcting a conjugated-parameter ratio by the inverse norm
scalar word gives the commutator with second coordinate one. -/
def NormalizedLiftedScaleWords {c : Cocharacter G.val}
    (L : ShearLifts Q P c)
    (N : ∀ R : TestAlgebra F, (R ⊗[F] B)ˣ →* Rˣ)
    (e : ∀ R : TestAlgebra F, spinScalePreimage P Q R ≃* scalePairs (N R)) : Prop :=
  ∃ scalarWord : ∀ (_w : Fin d → B) (_q : Bˣ)
      (R : TestAlgebra F) (_t : Rˣ), spinScalePreimage P Q R,
    (∀ (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F) (t : Rˣ),
      hermitianValue Q.conjugation.anti Q.complement.val w w = (q : B) →
      let s := Units.map (algebraMap R (R ⊗[F] B)).toMonoidHom t
      (e R (scalarWord w q R t)).val = (s, t) ∧
      ∃ hs hs₁ hs₂ h1 h1₁ h1₂,
        (scalarWord w q R t).val.1 =
          liftedInterchange Q P L w q R 0 s hs hs₁ hs₂ *
            (liftedInterchange Q P L w q R 0 1 h1 h1₁ h1₂)⁻¹) ∧
    ∀ (w : Fin d → B) (q : Bˣ) (R : TestAlgebra F) (a b : (R ⊗[F] B)ˣ),
      ShearAdmissible Q w q R 1 ↑b →
      let aBar := (Units.opEquiv (Units.map (coefficientConjugation Q R).toMonoidHom a)).unop
      let b' := a * b * aBar
      ∃ z : spinScalePreimage P Q R,
        (e R z).val = (a * b * a⁻¹ * b⁻¹, 1) ∧
        ∃ hb hb₁ hb₂ hb' hb'₁ hb'₂,
          z.val.1 =
            liftedInterchange Q P L w q R ↑a b' hb' hb'₁ hb'₂ *
              (liftedInterchange Q P L w q R 1 b hb hb₁ hb₂)⁻¹ *
                (scalarWord w q R (N R a)⁻¹).val.1

/-- The two opposite radicals generate a dense subgroup in the topology of
any closed matrix realization. Their words remove the perpendicular action
of the Levi and their closure contains the whole spin scale preimage. -/
def LocalQuaternionGeneration [TopologicalSpace F] : Prop :=
  ∃ (c : Cocharacter G.val) (L : ShearLifts Q P c),
    IsNoncentral c ∧ ScalarHyperbolicSL2 Q P c ∧ LiftedInterchangeFormula Q P L ∧
    (∃ (N : ∀ R : TestAlgebra F, (R ⊗[F] B)ˣ →* Rˣ)
      (e : ∀ R : TestAlgebra F, spinScalePreimage P Q R ≃* scalePairs (N R)),
      (∃ (J : Type u) (_ : Fintype J) (b : Module.Basis J F B),
        ∀ (R : TestAlgebra F) (t : (R ⊗[F] B)ˣ), (N R t : R) = normAt hB b t.val) ∧
      (∀ R x, (e R x).val.1 = x.val.2) ∧
      (∀ (R S : TestAlgebra F) (f : R ⟶ S) (x : spinScalePreimage P Q R)
        (y : spinScalePreimage P Q S), y.val.1 = mapPoints f x.val.1 →
        y.val.2 = Units.map (tensorMap B f.hom).toMonoidHom x.val.2 →
        (e S y).val.2 = Units.map f.hom.toMonoidHom (e R x).val.2) ∧
      (∀ (R : TestAlgebra F) (z : Points P.kernel.group.X R),
        ∃ x : spinScalePreimage P Q R, x.val = (z ≫ P.kernel.inclusion.hom.hom, 1) ∧
          (e R x).val = (1, (P.kernelPoints R z).val)) ∧
      (∀ (t : (CommAlgCat.of F F ⊗[F] B)ˣ),
        ((N (CommAlgCat.of F F) t : F)) =
          reducedNorm hB (Algebra.TensorProduct.lid F B t.val)) ∧
      (∀ (t : (CommAlgCat.of F F ⊗[F] B)ˣ),
        (∃ g : Points G.val.X (CommAlgCat.of F F),
          spinVectorProjection P (CommAlgCat.of F F) g = quaternionScale Q (CommAlgCat.of F F) t) ↔
        ∃ s : Fˣ, reducedNorm hB (Algebra.TensorProduct.lid F B t.val) = (s : F) ^ 2) ∧
      NormalizedLiftedScaleWords Q P L N e) ∧
    (Nonempty (LimitDecomposition c) ∧ Nonempty (LimitDecomposition (oppositeCocharacter c))) ∧
    ∀ (U : LimitDecomposition c) (V : LimitDecomposition (oppositeCocharacter c))
      (i : IntegralModels.MatrixRealization G),
      let R := CommAlgCat.of F F
      let H := SubgroupSections U.contracting ((testSpec F).obj (Opposite.op R)) ⊔
        SubgroupSections V.contracting ((testSpec F).obj (Opposite.op R))
      (∀ g : Points G.val.X R, Centralizes c g →
        ∃ h ∈ H, ∃ t : (R ⊗[F] B)ˣ,
          spinVectorProjection P R (h⁻¹ * g) = quaternionScale Q R t) ∧
      (∀ x : spinScalePreimage P Q R,
        (show PointsIn i F from x.val.1) ∈
          closure {g : PointsIn i F | (show Points G.val.X R from g) ∈ H}) ∧
      Dense {g : PointsIn i F | (show Points G.val.X R from g) ∈ H}

/-- Local generation for both kinds of completion that can have a quaternion
division factor. The rank restriction is on the actual split type D model. -/
def LocalGeneration : Prop :=
  (∀ {F K I B : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [Field K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K]
    [Fintype I] [DecidableEq I] [DivisionRing B] [Algebra F B]
    {ρ : AlgebraAction F K (Matrix (I ⊕ I) (I ⊕ I) K)}
    {G : AffineAlgebraicGroup F} {D : DescendedQuadraticPair ρ} (P : SpinModel G D),
    RelativeRootIrreducibility.IsAbsolutelyAlmostSimple G →
    4 ≤ Fintype.card I → (2 : F) ≠ 0 → ∀ (hB : isCentralSimple F B), degree F B = 2 →
    ∀ d : ℕ, 0 < d → ∀ Q : QuaternionHyperbolicPresentation D hB d,
      LocalQuaternionGeneration Q P) ∧
  (∀ {F K I B : Type u} [Field F] [TopologicalSpace F]
    (realModel : F ≃+* ℝ), IsHomeomorph realModel →
    ∀ [Field K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K]
    [Fintype I] [DecidableEq I] [DivisionRing B] [Algebra F B]
    {ρ : AlgebraAction F K (Matrix (I ⊕ I) (I ⊕ I) K)}
    {G : AffineAlgebraicGroup F} {D : DescendedQuadraticPair ρ} (P : SpinModel G D),
    RelativeRootIrreducibility.IsAbsolutelyAlmostSimple G →
    4 ≤ Fintype.card I → ∀ (hB : isCentralSimple F B), degree F B = 2 →
    ∀ d : ℕ, 0 < d → ∀ Q : QuaternionHyperbolicPresentation D hB d,
      LocalQuaternionGeneration Q P)

end HyperbolicPresentation

end LinearAlgebraicGroups.Specs.Arithmetic.QuaternionSpinOddCharacteristic
