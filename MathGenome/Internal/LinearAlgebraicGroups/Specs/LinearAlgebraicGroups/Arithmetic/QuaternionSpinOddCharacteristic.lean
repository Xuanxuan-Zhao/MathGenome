section BlockWords

variable {F B : Type u} [CommRing F] [Ring B] [Algebra F B]

/-- The three displayed coordinates are the first hyperbolic line, the
nonisotropic quaternion line, and the second hyperbolic line. -/
def lineGram (q : B) : Matrix (Fin 3) (Fin 3) B :=
  !![0, 0, 1; 0, q, 0; -1, 0, 0]

def upperShear (σ : B ≃ₐ[F] Bᵐᵒᵖ) (q : Bˣ) (a b : B) :
    Matrix (Fin 3) (Fin 3) B :=
  !![1, a, b; 0, 1, -(↑q⁻¹ * antiValue σ a); 0, 0, 1]

def lowerShear (σ : B ≃ₐ[F] Bᵐᵒᵖ) (q : Bˣ) (a b : B) :
    Matrix (Fin 3) (Fin 3) B :=
  !![1, 0, 0; -(↑q⁻¹ * antiValue σ a), 1, 0; -b, -a, 1]

def interchange (b : Bˣ) (r : B) (σ : B ≃ₐ[F] Bᵐᵒᵖ) :
    Matrix (Fin 3) (Fin 3) B :=
  !![0, 0, ↑b; 0, r, 0; -antiValue σ (↑b⁻¹), 0, 0]

/-- Both lower factors are admissible. Multiplication is in the displayed
order, acting on column vectors by left matrix multiplication. -/
def OppositeShearWord : Prop :=
  ∀ {F B : Type u} [CommRing F] [Ring B] [Algebra F B]
    (σ : B ≃ₐ[F] Bᵐᵒᵖ), Function.Involutive (antiValue σ) →
    ∀ (q : Bˣ), antiValue σ (q : B) = -(q : B) →
    ∀ (a : B) (b : Bˣ), (b : B) - antiValue σ ↑b = -(a * ↑q⁻¹ * antiValue σ a) →
      let c := antiValue σ (↑b⁻¹)
      let a₁ := -(c * a)
      let a₂ := (↑b⁻¹ : B) * a
      (c - antiValue σ c = -(a₁ * ↑q⁻¹ * antiValue σ a₁)) ∧
      (c - antiValue σ c = -(a₂ * ↑q⁻¹ * antiValue σ a₂)) ∧
      lowerShear σ q a₁ c * upperShear σ q a ↑b * lowerShear σ q a₂ c =
        interchange b (1 + ↑q⁻¹ * antiValue σ a * ↑b⁻¹ * a) σ

/-- Each admissible shear is an isometry of the displayed skew-Hermitian
block. The statement also holds after passing to a coefficient algebra. -/
def ShearIsometries : Prop :=
  ∀ {F B : Type u} [CommRing F] [Ring B] [Algebra F B]
    (σ : B ≃ₐ[F] Bᵐᵒᵖ), Function.Involutive (antiValue σ) →
    ∀ (q : Bˣ), antiValue σ (q : B) = -(q : B) →
    ∀ (a b : B), b - antiValue σ b = -(a * ↑q⁻¹ * antiValue σ a) →
      let U := upperShear σ q a b
      let L := lowerShear σ q a b
      let H := lineGram (q : B)
      dagger σ U * H * U = H ∧ dagger σ L * H * L = H

end BlockWords

