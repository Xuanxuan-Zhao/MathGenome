import Mathlib.RingTheory.LaurentSeries
import Mathlib.FieldTheory.RatFunc.Valuation
import Mathlib.Data.Fin.Tuple.Sort
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.MeasureTheory.Group.FundamentalDomain
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic

open scoped LaurentSeries PowerSeries Polynomial RatFunc
open WithZero

namespace LinearAlgebraicGroups.Arithmetic.LaurentLattice

noncomputable section

/-- The monomial `t^n`, with the Laurent-series variable equal to `t⁻¹`. -/
def polePower (F : Type*) [Field F] (n : ℤ) : F⸨X⸩ := HahnSeries.single (-n) 1

/-- The polynomial ring in the pole variable. -/
def polynomialEmbedding (F : Type*) [Field F] : F[X] →+* F⸨X⸩ :=
  Polynomial.eval₂RingHom HahnSeries.C (polePower F 1)

abbrev baseValuation (F : Type*) [Field F] : Valuation F⸨X⸩ ℤᵐ⁰ := Valued.v

/-- The normalized infinity absolute value, taking `t` to the residue cardinality. -/
def absoluteValue (F : Type*) [Field F] [Finite F] (x : F⸨X⸩) : ℝ :=
  if baseValuation F x = 0 then 0 else
    (Nat.card F : ℝ) ^ (log (baseValuation F x) : ℤ)

/-- Maximum of the normalized coordinate absolute values, with zero in rank zero. -/
def length (F : Type*) [Field F] [Finite F] {d : ℕ} (x : Fin d → F⸨X⸩) : ℝ :=
  (insert 0 (Finset.univ.image (fun i => absoluteValue F (x i)))).sup'
    (Finset.insert_nonempty _ _) id

abbrev SquareGL (d : ℕ) (A : Type*) [CommRing A] := Matrix.GeneralLinearGroup (Fin d) A

def basisMatrix {F : Type*} [Field F] {d : ℕ} (g : SquareGL d F⸨X⸩) (b : SquareGL d F[X]) :
    SquareGL d F⸨X⸩ :=
  g * Matrix.GeneralLinearGroup.map (polynomialEmbedding F) b

/-- The matrix equation expressing reduction of the polynomial lattice. -/
def Reduced {F : Type*} [Field F] {d : ℕ} (g : SquareGL d F⸨X⸩) (b : SquareGL d F[X])
    (k : SquareGL d F⟦X⟧) (n : Fin d → ℤ) : Prop :=
  Monotone n ∧ (basisMatrix g b).val =
    k.val.map (HahnSeries.ofPowerSeries ℤ F) * Matrix.diagonal (polePower F ∘ n)

open Classical in
/-- The infinity completion, with its usual topology and the prescribed rational embedding. -/
def completionIdentification : Prop :=
  ∀ (F : Type*) [Field F],
    ∃ e : RatFunc.CompletionAtInfty F ≃+* F⸨X⸩,
      ∃ h : RatFunc.CompletionAtInfty F ≃ₜ F⸨X⸩,
        (⇑e = ⇑h) ∧
        (∀ p : F[X], e (algebraMap (RatFunc F) (RatFunc.CompletionAtInfty F)
          (algebraMap F[X] (RatFunc F) p)) = polynomialEmbedding F p) ∧
        (∀ x, baseValuation F (e x) = Valued.v x)

/-- The unit ball of the infinity completion in Laurent coordinates. -/
def integralIdentification : Prop :=
  ∀ (F : Type*) [Field F] (x : F⸨X⸩),
    baseValuation F x ≤ 1 ↔ ∃ p : F⟦X⟧, HahnSeries.ofPowerSeries ℤ F p = x

/-- The series with vanishing polynomial part. -/
def positivePart (F : Type*) [Field F] : Set F⸨X⸩ :=
  {x | baseValuation F x < 1}

/-- Additive fundamental domain for the standard polynomial lattice. -/
def standardDomain (F : Type*) [Field F] (d : ℕ) : Set (Fin d → F⸨X⸩) :=
  {x | ∀ i, x i ∈ positivePart F}

/-- Each vector has a unique polynomial translate in the standard fundamental domain. -/
def polynomialPartDecomposition : Prop :=
  ∀ (F : Type*) [Field F] (d : ℕ) (x : Fin d → F⸨X⸩),
    ∃! a : Fin d → F[X], x - (polynomialEmbedding F ∘ a) ∈ standardDomain F d

/-- The full additive polynomial lattice generated by the columns of the matrix. -/
def latticeVector {F : Type*} [Field F] {d : ℕ} (g : SquareGL d F⸨X⸩) :
    (Fin d → F[X]) →+ (Fin d → F⸨X⸩) where
  toFun a := g.val.mulVec (polynomialEmbedding F ∘ a)
  map_zero' := by
    rw [show polynomialEmbedding F ∘ (0 : Fin d → F[X]) = 0 from funext (fun _ => map_zero _)]
    exact Matrix.mulVec_zero _
  map_add' a b := by
    rw [show polynomialEmbedding F ∘ (a + b) =
      (polynomialEmbedding F ∘ a) + (polynomialEmbedding F ∘ b) from
      funext (fun i => map_add _ (a i) (b i)), Matrix.mulVec_add]

/-- The Haar measure is normalized by the standard polynomial lattice. Every full polynomial
lattice has a compact open fundamental domain and covolume equal to the absolute determinant. -/
def haarCovolume : Prop :=
  ∀ (F : Type*) [Field F] [Finite F] (d : ℕ),
    letI : MeasurableSpace F⸨X⸩ := borel _
    ∃ μ : MeasureTheory.Measure (Fin d → F⸨X⸩),
      μ.IsAddHaarMeasure ∧ μ (standardDomain F d) = 1 ∧
      ∀ g : SquareGL d F⸨X⸩,
        (∃ S, IsCompact S ∧ IsOpen S ∧
          MeasureTheory.IsAddFundamentalDomain (latticeVector g).range S μ) ∧
        MeasureTheory.addCovolume (latticeVector g).range (Fin d → F⸨X⸩) μ =
          ENNReal.ofReal (absoluteValue F g.val.det)

/-- Full lattices in the infinity completion have ordered valuation bases. -/
def orderedReduction : Prop :=
  ∀ {F : Type*} [Field F] {d : ℕ} (g : SquareGL d F⸨X⸩),
    ∃ (b : SquareGL d F[X]) (k : SquareGL d F⟦X⟧) (n : Fin d → ℤ), Reduced g b k n

/-- The determinant pole degree is the sum of the ordered exponents. -/
def exponentSum : Prop :=
  ∀ {F : Type*} [Field F] {d : ℕ} {g : SquareGL d F⸨X⸩} {b : SquareGL d F[X]}
    {k : SquareGL d F⟦X⟧} {n : Fin d → ℤ}, Reduced g b k n →
    baseValuation F (g.val.det) = exp (∑ i, n i)

/-- The sum vanishes for determinant norm one, independently of the vector lengths. -/
def exponentSumZero : Prop :=
  ∀ {F : Type*} [Field F] [Finite F] {d : ℕ} {g : SquareGL d F⸨X⸩}
    {b : SquareGL d F[X]} {k : SquareGL d F⟦X⟧} {n : Fin d → ℤ},
    Reduced g b k n → (absoluteValue F g.val.det = 1 ↔ (∑ i, n i) = 0)

/-- The underlying additive subgroup of a full polynomial lattice is discrete. -/
def discreteLattice : Prop :=
  ∀ {F : Type*} [Field F] {d : ℕ} (g : SquareGL d F⸨X⸩),
    DiscreteTopology (latticeVector g).range

/-- Closed balls of the normalized absolute value are compact at integral powers of `q`. -/
def compactEntryBounds : Prop :=
  ∀ (F : Type*) [Field F] [Finite F] (N : ℕ),
    IsCompact {x : F⸨X⸩ | absoluteValue F x ≤ (Nat.card F : ℝ) ^ N}

/-- The ordered basis also gives bounds on the exponents and both basis matrices. -/
def boundedReduction : Prop :=
  ∀ {F : Type*} [Field F] [Finite F] (d : ℕ) (ε : ℝ), 0 < ε →
    ∃ N : ℕ, ∀ (g : SquareGL d F⸨X⸩), absoluteValue F g.val.det = 1 →
      (∀ a : Fin d → F[X], a ≠ 0 →
        ε ≤ length F (g.val.mulVec (polynomialEmbedding F ∘ a))) →
      ∃ (b : SquareGL d F[X]) (k : SquareGL d F⟦X⟧) (n : Fin d → ℤ),
        Reduced g b k n ∧ (∑ i, n i) = 0 ∧
        (∀ i, |n i| ≤ (N : ℤ)) ∧
        ∀ i j, absoluteValue F ((basisMatrix g b).val i j) ≤ (Nat.card F : ℝ) ^ N ∧
          absoluteValue F (((basisMatrix g b)⁻¹).val i j) ≤ (Nat.card F : ℝ) ^ N

/-- Constant rescaling corrects the determinant and preserves the ordered exponents. -/
def determinantCorrection : Prop :=
  ∀ {F : Type*} [Field F] {d : ℕ} {g : SquareGL d F⸨X⸩} {b : SquareGL d F[X]}
    {k : SquareGL d F⟦X⟧} {n : Fin d → ℤ}, Reduced g b k n →
    ∀ u : Fˣ, g.val.det = HahnSeries.C (u : F) →
      ∃ (c : SquareGL d F) (k' : SquareGL d F⟦X⟧),
        let b' := b * Matrix.GeneralLinearGroup.map Polynomial.C c
        Reduced g b' k' n ∧ (basisMatrix g b').val.det = 1 ∧ k'.val.det = 1

end

end LinearAlgebraicGroups.Arithmetic.LaurentLattice
