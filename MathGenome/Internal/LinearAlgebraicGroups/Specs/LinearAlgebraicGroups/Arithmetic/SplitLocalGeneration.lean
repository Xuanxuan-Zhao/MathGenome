import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.SimplyConnectedLattice

open CategoryTheory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.SplitLocalGeneration

open AdjointRepresentation (GroupPoints)
open CharacterPairing (absoluteRoots)
open GeometricRadicals (IsSemisimple IsSplitTorus)
open RankOneFlag (IsGeometricallyMaximal)
open RootGroups (IsRootSubgroup)
open SimplyConnectedLattice (GeometricallySimplyConnected)

/-- The points of a split simply connected semisimple group over its ground field
are generated by the points of its root subgroups for a split maximal torus. -/
def Statement : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsSemisimple G →
    GeometricallySimplyConnected G →
    ∀ (T : ClosedSubgroup G.val), IsSplitTorus T.group → IsGeometricallyMaximal T →
      Subgroup.closure
        {g : GroupPoints G.val (CommAlgCat.of k k) |
          ∃ α ∈ absoluteRoots T, ∃ U : ClosedSubgroup G.val, IsRootSubgroup T U α ∧
            ∃ p : GroupPoints U.group (CommAlgCat.of k k), p ≫ U.inclusion.hom.hom = g} = ⊤

end LinearAlgebraicGroups.Specs.SplitLocalGeneration
