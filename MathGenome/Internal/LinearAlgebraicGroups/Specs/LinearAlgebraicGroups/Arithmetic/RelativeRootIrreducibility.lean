noncomputable section

/-- The roots of a finite crystallographic reflection system can include doubles.
The spanning condition refers to the given real space. -/
structure IsPossiblyNonreducedRootSystem {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (R : Set E) : Prop where
  finite : R.Finite
  nonzero : ∀ a ∈ R, a ≠ 0
  reflection_mem : ∀ a ∈ R, ∀ b ∈ R,
    LieAlgebrasAndRepresentations.rootReflection a b ∈ R
  integral : ∀ a ∈ R, ∀ b ∈ R, ∃ n : ℤ,
    2 * inner ℝ b a / inner ℝ a a = (n : ℝ)
  span_eq_top : Submodule.span ℝ R = ⊤

/-- A root is indivisible when its half is absent. -/
def indivisibleRoots {E : Type*} [AddCommGroup E] [Module ℝ E] (R : Set E) : Set E :=
  {a ∈ R | (1 / 2 : ℝ) • a ∉ R}

def simpleDiagramConnected {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (R : Set E) (v : E) : Prop :=
  ∀ a ∈ simpleRoots R v, ∀ b ∈ simpleRoots R v,
    Relation.EqvGen (fun x y ↦ x ∈ simpleRoots R v ∧ y ∈ simpleRoots R v ∧
      x ≠ y ∧ inner ℝ x y ≠ 0) a b

/-- Absolute almost simplicity in terms of geometric smooth connected normal subgroups. -/
def IsAbsolutelyAlmostSimple {k : Type u} [Field k] (G : AffineAlgebraicGroup k) : Prop :=
  IsSemisimple G ∧
    ¬ Nonempty ((GeometricGroup G).val ≅ Grp.trivial (SchemeOver (AlgebraicClosure k))) ∧
    ∀ N : ClosedSubgroup (GeometricGroup G).val,
      IsSmoothConnectedNormal N → IsTrivialSubgroup N ∨ IsIso N.inclusion

variable {k : Type u} [Field k] {G : AffineAlgebraicGroup k}

/-- The space of real characters generated by the actual relative weights. -/
abbrev RealCharacters (S : ClosedSubgroup G.val) := ℝ ⊗[ℤ] Additive (Character S.group)

def realCharacter (S : ClosedSubgroup G.val) (a : Character S.group) : RealCharacters S :=
  (1 : ℝ) ⊗ₜ[ℤ] Additive.ofMul a

abbrev RealRootSpan (S : ClosedSubgroup G.val) :=
  Submodule.span ℝ (realCharacter S '' relativeRoots S)

def realRoots (S : ClosedSubgroup G.val) : Set (RealRootSpan S) :=
  {a | (a : RealCharacters S) ∈ realCharacter S '' relativeRoots S}

/-- The vector of a relative weight in the span of the roots. -/
def realRoot {S : ClosedSubgroup G.val} (a : relativeRoots S) : RealRootSpan S :=
  ⟨realCharacter S a.val, Submodule.subset_span ⟨a.val, a.property, rfl⟩⟩

/-- Isotropy inside S is witnessed by a cocharacter that fails to centralize the group. -/
def HasNoncentralCocharacter (S : ClosedSubgroup G.val) : Prop :=
  ∃ c : Cocharacter S.group, ∃ (X : SchemeOver k) (g : X ⟶ G.val.X),
    ¬ Centralizes (c ≫ S.inclusion) g

/-- The Euclidean root system and simple diagram for the given split torus. -/
def RootConclusion (S : ClosedSubgroup G.val) : Prop :=
    ∃ form : InnerProductSpace.Core ℝ (RealRootSpan S),
    letI := @InnerProductSpace.Core.toNormedAddCommGroup ℝ (RealRootSpan S) _ _ _ form;
    letI := InnerProductSpace.ofCore form.toCore;
      IsPossiblyNonreducedRootSystem (realRoots S) ∧
      LieAlgebrasAndRepresentations.IsIrreducible (realRoots S) ∧
      IsRootSystem (indivisibleRoots (realRoots S)) ∧
      Function.Injective (realCharacter S) ∧
      (∀ a ∈ realRoots S, ∀ t : ℝ, 0 < t → t • a ∈ realRoots S →
        t = 1 ∨ t = 2 ∨ t = 1 / 2) ∧
      (∀ a ∈ realRoots S, a ∈ indivisibleRoots (realRoots S) ∨
        (1 / 2 : ℝ) • a ∈ indivisibleRoots (realRoots S)) ∧
      (∃ (D : QuotientData S) (comm : IsCommMonObj S.group.X),
        letI := comm;
        ∃ (d : Datum D) (action : D.splitImage.labels →* Module.End ℝ (RealRootSpan S)),
          (∀ w (a : relativeRoots S), action w (realRoot a) = realRoot (d.normalizerPerm w a)) ∧
          (∀ w x y, inner ℝ (action w x) (action w y) = inner ℝ x y) ∧
          (∀ a b : relativeRoots S,
            2 * inner ℝ (realRoot b) (realRoot a) / inner ℝ (realRoot a) (realRoot a) =
              (pairing S.group b.val (d.reflection a).coroot : ℝ))) ∧
      (∀ A, IsChamber S A →
        ∃ v : RealRootSpan S, RootRegular (realRoots S) v ∧
          (∀ a : relativeRoots S, a ∈ A ↔ 0 < inner ℝ v (realRoot a)) ∧
          (∃ b : Module.Basis (simpleRoots (indivisibleRoots (realRoots S)) v) ℝ (RealRootSpan S),
            ∀ a, b a = (a : RealRootSpan S)) ∧
          (∀ a ∈ indivisibleRoots (realRoots S),
            ∃ c : simpleRoots (indivisibleRoots (realRoots S)) v →₀ ℤ,
              Finsupp.linearCombination ℤ (fun b : simpleRoots
                (indivisibleRoots (realRoots S)) v => (b : RealRootSpan S)) c = a ∧
              ((∀ b, 0 ≤ c b) ∨ (∀ b, c b ≤ 0))) ∧
          (∀ a ∈ indivisibleRoots (realRoots S),
            ∃ w : simpleWeylGroup (indivisibleRoots (realRoots S)) v,
              ∃ b ∈ simpleRoots (indivisibleRoots (realRoots S)) v, w.val b = a) ∧
          simpleDiagramConnected (indivisibleRoots (realRoots S)) v)

/-- The root and chamber conclusions on the actual weights and their real span.
The theorem is formulated over arbitrary fields, including completions of global fields. -/
def Statement : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsAbsolutelyAlmostSimple G →
    ∀ S : ClosedSubgroup G.val, IsMaximalSplitTorus S → HasNoncentralCocharacter S →
      RootConclusion S

end
end LinearAlgebraicGroups.Specs.Arithmetic.RelativeRootIrreducibility
