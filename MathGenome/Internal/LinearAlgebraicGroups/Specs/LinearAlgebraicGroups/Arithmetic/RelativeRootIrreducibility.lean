import Mathlib.LinearAlgebra.TensorProduct.Tower

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj TensorProduct

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.RelativeRootIrreducibility

open CharacterDescent (Character Cocharacter)
open CharacterPairing (pairing)
open GeometricRadicals (GeometricGroup IsSemisimple IsSmoothConnectedNormal IsTrivialSubgroup)
open Relative.MaximalSplitTori (IsMaximalSplitTorus)
open Relative.RelativeChambers (IsChamber relativeRoots)
open Relative.RelativeReflections (Datum)
open Relative.RelativeWeylScheme (QuotientData)
