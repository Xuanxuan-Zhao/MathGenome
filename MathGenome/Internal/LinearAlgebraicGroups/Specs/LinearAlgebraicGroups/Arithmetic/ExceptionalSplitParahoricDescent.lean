/-- The spectrum of the field as a test algebra is the terminal scheme over the field. -/
def fieldPointIso (k : Type u) [Field k] :
    𝟙_ (SchemeOver k) ≅ (testSpec k).obj (.op (CommAlgCat.of k k)) :=
  Over.isoMk (Iso.refl (Spec (CommRingCat.of k))) (by
    change (𝟙 (Spec (CommRingCat.of k))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap k k)) = 𝟙 _
    rw [Category.id_comp]
    exact Spec.map_id _)

/-- The scaling extension is generated by a root of the base-field uniformizer. -/
def uniformizerPolynomial {F K : Type u} [Field F] [Field K] [Algebra F K]
    (d : ℕ) (π : Fˣ) : K[X] :=
  Polynomial.X ^ d - Polynomial.C (algebraMap F K (π : F))

section FaceResidue

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]
  {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
  {c : MarkedCentralCover M M'} {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
  {e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)}
  {Y : SplitLevel K c p p' e} (B : SplitBuildingLevel Y)

local notation "A" => ApartmentRoots.split E.datum ℚ
local notation "P(" T ")" => parahoric Y.ad T

/-- Chambers of the given adjoint building whose closure contains the marked point. -/
def IncidentChambers (z : B.ad.realization.Point) : Set (FieldPoints M' K ⧸ Y.ad.I) :=
  {q | ∃ (g : Y.ad.G₀) (t : Weights (ApartmentRoots.SimpleWall A p')),
    q = QuotientGroup.mk (g : FieldPoints M' K) ∧ B.ad.realization.place g t = z}

/-- Reduction of the actual parahoric after scaling in the integral split model. -/
structure FaceReduction
    (t : Weights (ApartmentRoots.SimpleWall A p')) (x : ℚ ⊗[ℤ] E.Y)
    (d : ℕ) (y : E.Y) (π : Kˣ)
    (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension K L]
    (ξ : Lˣ) extends ExceptionalScaledParahoricAction.FaceReduction B t x d y ξ where
  parameter : (ξ : L) ^ d = algebraMap K L (π : K)
  same_residue : Function.Bijective (residueMap K L)
  reduction_surjective : Function.Surjective reduction
  preimage_borel (g : P(cotype t)) :
    (∃ b : GroupPoints borel.group (CommAlgCat.of (residue L) (residue L)),
      b ≫ borel.inclusion.hom.hom = reduction g) ↔ (g : FieldPoints M' K) ∈ Y.ad.I
  flags : QuotientEmbedding.Presentation borel
  incident : IncidentChambers B (B.ad.realization.place 1 t) ≃
    Points flags.scheme (CommAlgCat.of (residue L) (residue L))
  incident_eq (g : P(cotype t)) (q : IncidentChambers B (B.ad.realization.place 1 t))
      (hq : q.val = QuotientGroup.mk (g : FieldPoints M' K)) :
    incident q = reduction g ≫ flags.projection

end FaceResidue

section ResidueDescent

variable {F K L : Type u} [Field F] [Field K] [Field L]
  [Algebra F K] [Algebra K L] [Algebra F L] [IsScalarTower F K L]
  [FiniteDimensional F K] [IsGalois F K] [FiniteDimensional K L]
  [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
  [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension F K]
  [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
  [ValuativeExtension K L] [ValuativeExtension F L]
  {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
  {c : MarkedCentralCover M M'} {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
  {e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)}
  {Y : SplitLevel K c p p' e} {B : SplitBuildingLevel Y}

/-- The residual action is induced by conjugation on the scaled integral model. -/
structure MarkedResidueAction
    {t : Weights ((ApartmentRoots.split E.datum ℚ).SimpleWall p')}
    {x : ℚ ⊗[ℤ] E.Y} {d : ℕ} {y : E.Y} {π : Kˣ} {ξ : Lˣ}
    (R : FaceReduction B t x d y π L ξ)
    (ρ : Gal(K/F) →* MulAut (FieldPoints M' K))
    (h : Gal(K/F) → (ℚ ⊗[ℤ] E.Y) ≃ᵃ[ℚ] (ℚ ⊗[ℤ] E.Y))
    (a : Gal(K/F) → FieldPoints M' K)
    (residueAction : letI := (residueMap F L).toAlgebra
      Gal(K/F) →* Gal(residue L / residue F)) where
  pinned : PinnedOperators ρ h
  parahoricFactor : Gal(K/F) → parahoric Y.ad (cotype t)
  factorization (σ : Gal(K/F)) :
    a σ = (parahoricFactor σ : FieldPoints M' K) *
      (typeLift (Y := Y) a σ : FieldPoints M' K)
  corrector : Gal(K/F) → IntegralPoints M'.group (localIntegers L)
  corrector_eq (σ : Gal(K/F)) :
    let s := markedCocharacter M'.toIntegralMarking (integralRing L) y ξ
    changeRingHom M'.group (localIntegersInclusion L) (corrector σ) =
      s * scalarPoints M' (algebraMap K L) (a σ) *
        (integralPointHom (pinned.pinned σ).asIso.hom (integralRing L) s)⁻¹
  hopf : letI := (residueMap F L).toAlgebra
    HopfDescentDatum (residue F) (coordinateHopf R.toFaceReduction.group)
  ambient (σ : Gal(K/F)) (T : TestAlgebra (residue L))
      (f : CommAlgCat.of (residue L) (coordinateHopf R.toFaceReduction.group) ⟶ T) :
    letI := (residueMap F L).toAlgebra
    let galois := residueAction σ
    let T' := transportAlgebra galois T
    let j := R.identityComponent.inclusion.hom.hom ≫ R.centralizer.inclusion.hom.hom
    let q := changeRingHom M'.group (integralRingMap (algebraMap (residue L) T'))
      (changeRingHom M'.group (residueHom (localIntegers L)) (corrector σ))
    let g := coordinatePoint R.toFaceReduction.group T f
    let g' := coordinatePoint R.toFaceReduction.group T' (transportPoint hopf galois f)
    let z := forgetFibrePoint M'.group T (g ≫ j)
    let z' : IntegralPoints M'.group (integralRing T') :=
      integralPointHom (pinned.pinned σ).asIso.hom (integralRing T) z
    forgetFibrePoint M'.group T' (g' ≫ j) = q * z' * q⁻¹
  moves_borel (σ : Gal(K/F)) :
    letI := (residueMap F L).toAlgebra
    MovesBorel hopf R.borel (residueAction σ)
      ((fieldPointIso (residue L)).hom ≫ R.reduction (parahoricFactor σ))

/-- The residual Galois action comes from the actual coefficient action and
descent of the root subsystem and its flag variety. -/
structure DescendedFaceResidue
    {t : Weights ((ApartmentRoots.split E.datum ℚ).SimpleWall p')}
    {x : ℚ ⊗[ℤ] E.Y} {d : ℕ} {y : E.Y} {π : Kˣ} {ξ : Lˣ}
    (R : FaceReduction B t x d y π L ξ)
    {ρ : Gal(K/F) →* MulAut (FieldPoints M' K)}
    {h : Gal(K/F) → (ℚ ⊗[ℤ] E.Y) ≃ᵃ[ℚ] (ℚ ⊗[ℤ] E.Y)}
    (coef : CoefficientAction B.ad ρ h) (a : Gal(K/F) → FieldPoints M' K) where
  liftCoefficient : Gal(K/F) →* Gal(L/F)
  lift_restrict (σ : Gal(K/F)) (z : K) :
    liftCoefficient σ (algebraMap K L z) = algebraMap K L (σ z)
  lift_uniformizer (σ : Gal(K/F)) : liftCoefficient σ (ξ : L) = ξ
  lift_valuation (σ : Gal(K/F)) (z : L) :
    normalizedValuation L (liftCoefficient σ z) = normalizedValuation L z
  residueAction : letI := (residueMap F L).toAlgebra
    Gal(K/F) →* Gal(residue L / residue F)
  residueAction_bijective : Function.Bijective residueAction
  residue_action_eq (σ : Gal(K/F)) (z z' : localIntegers L)
      (hz : (z' : L) = liftCoefficient σ (z : L)) :
    letI := (residueMap F L).toAlgebra
    residueAction σ ((residueHom (localIntegers L)).hom z) =
      (residueHom (localIntegers L)).hom z'
  markedAction : MarkedResidueAction R ρ h a residueAction
  descended : AffineAlgebraicGroup (residue F)
  reductive : IsReductive descended
  groupComparison : letI := (residueMap F L).toAlgebra
    (groupBaseChange (residue F) (residue L)).obj descended.val ≅ R.identityComponent.group
  group_scheme_action (σ : Gal(K/F)) :
    letI := (residueMap F L).toAlgebra
    let galois := residueAction σ
    groupComparison.hom.hom.hom.left ≫
        schemeOperator R.toFaceReduction.group markedAction.hopf galois =
      coefficientMap galois descended.val.X ≫ groupComparison.hom.hom.hom.left
  borel : ClosedSubgroup descended.val
  borel_eq : IsKBorel borel
  flags : QuotientEmbedding.Presentation borel
  flagComparison : letI := (residueMap F L).toAlgebra
    (baseChange (residue F) (residue L)).obj flags.scheme ≅ R.flags.scheme
  flagBasepoint : 𝟙_ (SchemeOver (residue L)) ⟶ R.identityComponent.group.X
  flag_projection_eq :
    letI := (residueMap F L).toAlgebra
    let k := residue F
    let k' := residue L
    ∀ (S : SchemeOver k') (g : S ⟶ ((groupBaseChange k k').obj descended.val).X),
      g ≫ (baseChange k k').map flags.projection ≫ flagComparison.hom =
        ((g ≫ groupComparison.hom.hom.hom) * (toUnit S ≫ flagBasepoint)) ≫ R.flags.projection
  flag_scheme_action (σ : Gal(K/F)) :
    letI := (residueMap F L).toAlgebra
    let galois := residueAction σ
    let u := (fieldPointIso (residue L)).hom ≫ R.reduction (markedAction.parahoricFactor σ)
    R.flags.projection.left ≫ flagComparison.inv.left ≫
        coefficientMap galois flags.scheme ≫ flagComparison.hom.left =
      schemeOperator R.toFaceReduction.group markedAction.hopf galois ≫
        (rightTranslate (𝟙 R.identityComponent.group.X) u).left ≫ R.flags.projection.left
  parahoricInvariant (σ : Gal(K/F)) (g : parahoric Y.ad (cotype t)) :
    a σ * ρ σ g * (a σ)⁻¹ ∈ parahoric Y.ad (cotype t)
  semilinear_group (σ : Gal(K/F)) (g : parahoric Y.ad (cotype t)) :
    letI := (residueMap F L).toAlgebra
    let k := residue F
    let k' := residue L
    let point (z : GroupPoints R.identityComponent.group (CommAlgCat.of k' k')) :=
      baseChangePoint k k' descended.val.X (CommAlgCat.of k' k') (z ≫ groupComparison.inv.hom.hom)
    point (R.reduction ⟨_, parahoricInvariant σ g⟩) =
      pointAction k k' descended.val.X (residueAction σ) (point (R.reduction g))
  semilinear_flags (σ : Gal(K/F))
      (q q' : IncidentChambers B (B.ad.realization.place 1 t))
      (g g' : Y.ad.G₀) (hq : q.val = QuotientGroup.mk (g : FieldPoints M' K))
      (hq' : q'.val = QuotientGroup.mk (g' : FieldPoints M' K))
      (himage : B.adjoint.action (a σ) '' (coef.action σ
        '' B.ad.realization.closedFace g ∅) = B.ad.realization.closedFace g' ∅) :
    letI := (residueMap F L).toAlgebra
    let point (z : Points R.flags.scheme (CommAlgCat.of (residue L) (residue L))) :=
      baseChangePoint (residue F) (residue L) flags.scheme (CommAlgCat.of (residue L) (residue L))
        (z ≫ flagComparison.inv)
    point (R.incident q') =
      mapPoints (CommAlgCat.ofHom (residueAction σ).toAlgHom) (point (R.incident q))

end ResidueDescent

/-- The fibre comparison with the chosen split realization. -/
def pinnedFibreMarking {F : Type u} [Field F]
    {E : BasedRootDatum.{u}} {M' : Model E} (C : MarkedFibre M' F) :
    IntegralPinnedAutomorphisms.FibreMarking M'.toIntegralMarking F where
  line := C.line
  realization := C.realization
  groupIso := C.groupIso
  torusIso := C.torusIso
  root := C.coordinate
  torus_comm := C.torus_comm
  simple_root := fun a => Subtype.ext (C.simple_eq a)
  torus_points := C.torus_eval
  root_points := C.root_eval

/-- Coefficient operators in the split marking, either pure scalar
operators or the scalar operators followed by the given pinned diagram. -/
def MarkedCoefficientAction
    {F K : Type u} [Field F] [Field K] [Algebra F K]
    {E : BasedRootDatum.{u}} {M' : Model E} (C : MarkedFibre M' F)
    (l : Aut C.realization.attached.toBased ≃* Aut C.realization.pinned)
    (ω : Gal(K/F) →* Aut C.realization.attached.toBased)
    (ρ : Gal(K/F) →* MulAut (FieldPoints M' K))
    (h : Gal(K/F) → (ℚ ⊗[ℤ] E.Y) ≃ᵃ[ℚ] (ℚ ⊗[ℤ] E.Y)) : Prop :=
  (∀ σ v, ρ σ (markedFibrePoint C (CommAlgCat.of F K) v) =
    pinnedCoefficientPoint C (l (ω σ)) σ v) ∧
  (∀ σ, h σ = (ExceptionalAffineRootSystems.diagramCocharacters
    (ExceptionalValuedTorusNormalizer.markedDiagramEquiv C.realization (ω σ)).asIso.hom.val).toAffineEquiv) ∧
  ∀ σ, IntegralPinnedAutomorphisms.Induces (pinnedFibreMarking C)
    (ExceptionalValuedTorusNormalizer.markedDiagramEquiv C.realization (ω σ)).asIso.hom
    (l (ω σ)).asIso.hom

/-- Scalar extension of a rational flag, compared to the actual incident chamber. -/
def IsLiftOfFlag
    {F K L : Type u} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra K L] [Algebra F L] [IsScalarTower F K L]
    [FiniteDimensional F K] [IsGalois F K] [FiniteDimensional K L]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension F K]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
    [ValuativeExtension K L] [ValuativeExtension F L]
    {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
    {c : MarkedCentralCover M M'} {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
    {e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)}
    {Y : SplitLevel K c p p' e} {B : SplitBuildingLevel Y}
    {t : Weights ((ApartmentRoots.split E.datum ℚ).SimpleWall p')}
    {x : ℚ ⊗[ℤ] E.Y} {d : ℕ} {y : E.Y} {π : Kˣ} {ξ : Lˣ}
    {R : FaceReduction B t x d y π L ξ}
    {ρ : Gal(K/F) →* MulAut (FieldPoints M' K)}
    {h : Gal(K/F) → (ℚ ⊗[ℤ] E.Y) ≃ᵃ[ℚ] (ℚ ⊗[ℤ] E.Y)}
    {coef : CoefficientAction B.ad ρ h} {a : Gal(K/F) → FieldPoints M' K}
    (S : DescendedFaceResidue R coef a)
    (f : Points S.flags.scheme (CommAlgCat.of (residue F) (residue F)))
    (q : IncidentChambers B (B.ad.realization.place 1 t)) : Prop :=
  letI := (residueMap F L).toAlgebra
  baseChangePoint (residue F) (residue L) S.flags.scheme
    (CommAlgCat.of (residue L) (residue L)) (R.incident q ≫ S.flagComparison.inv) =
      mapPoints (CommAlgCat.ofHom (Algebra.ofId (residue F) (residue L))) f

/-- Residue descent for a fixed standard face of the actual adjoint complex.
The integral lift and the identification of its residue flag points are inputs. -/
def SplitParahoricResidueDescent : Prop :=
  ∀ {F K L : Type u} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra K L] [Algebra F L] [IsScalarTower F K L]
    [FiniteDimensional F K] [IsGalois F K] [FiniteDimensional K L]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension F K]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L]
    [ValuativeExtension K L] [ValuativeExtension F L],
    IsUnramifiedLocalExtension F K →
    ∀ {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
    {c : MarkedCentralCover M M'} {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
    {e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)}
    {Y : SplitLevel K c p p' e} (B : SplitBuildingLevel Y)
    (ρ : Gal(K/F) →* MulAut (FieldPoints M' K))
    (h : Gal(K/F) → (ℚ ⊗[ℤ] E.Y) ≃ᵃ[ℚ] (ℚ ⊗[ℤ] E.Y))
    (C : MarkedFibre M' F)
    (l : Aut C.realization.attached.toBased ≃* Aut C.realization.pinned)
    (ω : Gal(K/F) →* Aut C.realization.attached.toBased),
    MarkedCoefficientAction C l ω ρ h →
    (∀ σ, AutomorphismComparison Y.ad (ρ σ) (h σ)) →
    ∀ (coef : CoefficientAction B.ad ρ h),
    (∀ σ g z, coef.action σ (B.adjoint.action g z) =
      B.adjoint.action (ρ σ g) (coef.action σ z)) →
    ∀ (a : Gal(K/F) → FieldPoints M' K),
    (∀ σ τ, a (σ * τ) = a σ * ρ σ (a τ)) →
    ∀ (t : Weights ((ApartmentRoots.split E.datum ℚ).SimpleWall p'))
      (x : ℚ ⊗[ℤ] E.Y) (d : ℕ) (y : E.Y) (π : Fˣ) (ξ : Lˣ),
    IsBarycenter (cotype t) t →
    0 < d → (d : ℚ) • x = (1 : ℚ) ⊗ₜ[ℤ] y →
    normalizedValuation F (π : F) = WithZero.exp (-1 : ℤ) →
    ExceptionalAffineBuilding.rationalPoint B.ad.realization.coordinates x =
      simplexPoint B.ad.realization.coordinates B.ad.realization.vertex t →
    (∀ σ, B.adjoint.action (a σ) (coef.action σ (B.ad.realization.place 1 t)) =
      B.ad.realization.place 1 t) →
    ∀ (r : AdjoinRoot (uniformizerPolynomial (K := K) d π) ≃ₐ[K] L),
    r (AdjoinRoot.root (uniformizerPolynomial (K := K) d π)) = ξ →
    ∀ (R : FaceReduction B t x d y (Units.map (algebraMap F K).toMonoidHom π) L ξ),
    ∃ S : DescendedFaceResidue R coef a,
      Nonempty (Points S.flags.scheme (CommAlgCat.of (residue F) (residue F))) ∧
      ∀ f : Points S.flags.scheme (CommAlgCat.of (residue F) (residue F)),
        ∃ (q : IncidentChambers B (B.ad.realization.place 1 t)) (g : Y.ad.G₀),
          IsLiftOfFlag S f q ∧ q.val = QuotientGroup.mk (g : FieldPoints M' K) ∧
          ∀ σ, B.adjoint.action (a σ) '' (coef.action σ '' B.ad.realization.closedFace g ∅) =
            B.ad.realization.closedFace g ∅

end

end LinearAlgebraicGroups.Specs.ExceptionalSplitParahoricDescent
