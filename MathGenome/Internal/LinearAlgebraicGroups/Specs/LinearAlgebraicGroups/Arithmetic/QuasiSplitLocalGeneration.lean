import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.QuasiSplitPinnedPairModel
import Mathlib.Basic.Complex.Basic
import Mathlib.NumberTheory.LocalField.Basic

universe u

namespace LinearAlgebraicGroups.Specs.QuasiSplitLocalGeneration

open GeometricRadicals (IsSemisimple)
open QuasiSplitPinnedPairModel (BorelPair)
open SimplyConnectedLattice (GeometricallySimplyConnected)

/-- The local field hypothesis for the algebraic statement about rational points.
In the archimedean cases only the underlying field enters the statement. -/
def IsLocalField (F : Type u) [Field F] : Prop :=
  (∃ (v : ValuativeRel F) (t : TopologicalSpace F),
    @IsNonarchimedeanLocalField F ‹Field F› v t) ∨
  Nonempty (F ≃+* ℝ) ∨ Nonempty (F ≃+* ℂ)

/-- The subgroup generated by the images of the two specified radicals on
ground-field points, using their actual inclusions into the group. -/
noncomputable def generatedByBorelRadicals {F : Type u} [Field F]
    {G : AffineAlgebraicGroup F} (M : BorelPair G) :
    Subgroup (AdjointRepresentation.GroupPoints G.val (CommAlgCat.of F F)) :=
  let R := CommAlgCat.of F F
  (((groupPointsFunctor F).map (M.subgroup .positiveRadical).inclusion).app R).hom.range ⊔
    (((groupPointsFunctor F).map (M.subgroup .negativeRadical).inclusion).app R).hom.range

/-- Over every local field, the rational points of a geometrically simply
connected semisimple group with a specified opposite rational Borel pair
are generated by the rational points of its two unipotent radicals. -/
def Statement : Prop :=
  ∀ {F : Type u} [Field F], IsLocalField F →
    ∀ (G : AffineAlgebraicGroup F), IsSemisimple G →
      GeometricallySimplyConnected G → ∀ M : BorelPair G,
        generatedByBorelRadicals M = ⊤

end LinearAlgebraicGroups.Specs.QuasiSplitLocalGeneration
