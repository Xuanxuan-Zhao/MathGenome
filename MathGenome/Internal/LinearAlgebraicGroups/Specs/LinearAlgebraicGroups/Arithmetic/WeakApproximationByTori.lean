import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ArithmeticLatticeProjection
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Descent.RelativeRank
import Mathlib.GroupTheory.Index

open AlgebraicGeometry CategoryTheory Set

universe u v

namespace LinearAlgebraicGroups.Arithmetic.WeakApproximationByTori

open AdelicGroups ArithmeticLatticeProjection
open LinearAlgebraicGroups.Specs (AffineAlgebraicGroup ClosedSubgroup)
open LinearAlgebraicGroups.Specs.IntegralModels (MatrixRealization RationalPoints)
open LinearAlgebraicGroups.Specs.Unipotent (baseChangedAlgebraicGroup closedSubgroupAlgebraicGroup)
open LinearAlgebraicGroups.Specs.GeometricRadicals (IsUnipotentRadical)
open LinearAlgebraicGroups.Specs.RelativeRank (relativeRank)
open LinearAlgebraicGroups.Specs.BorelProper (IsParabolic)

noncomputable section

abbrev numberData (K : Type u) [Field K] [NumberField K] : GlobalFieldData.{u, v} K :=
  .number inferInstance

variable {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
variable (D : GlobalFieldData.{u, v} K) (i : MatrixRealization G) (T : Finset D.Place)

/-- The closure in the finite product of the image of the rational points. -/
def diagonalClosure : Set (FinitePoints D i T) :=
  closure (Set.range (rationalProjection D i T))

/-- Embed a local group as the given factor of the finite product. -/
def factor (w : (↑T : Set D.Place)) : LocalPoints D i w.1 →* FinitePoints D i T := by
  classical
  exact MonoidHom.mulSingle (fun z : (↑T : Set D.Place) => LocalPoints D i z.1) w

/-- Local points in a parabolic radical, included in the original group via
the parabolic inclusion and the base-change identification. -/
def radicalPoint (w : D.Place)
    {P : ClosedSubgroup (baseChangedAlgebraicGroup (D.Completion w) G).val}
    (U : ClosedSubgroup P.group) :
    ((groupPointsFunctor (D.Completion w)).obj U.group).obj
      (CommAlgCat.of (D.Completion w) (D.Completion w)) → LocalPoints D i w :=
  fun x => baseChangePoint K (D.Completion w) G.val.X
    (CommAlgCat.of (D.Completion w) (D.Completion w))
    (((groupPointsFunctor (D.Completion w)).map (U.inclusion ≫ P.inclusion)).app
      (CommAlgCat.of (D.Completion w) (D.Completion w)) x)

/-- The subgroup generated by the local points of the unipotent radicals
of all local parabolics. -/
def localPlus (w : D.FinitePlace) : Subgroup (LocalPoints D i (.inl w)) :=
  Subgroup.closure {g | ∃
    (P : ClosedSubgroup (baseChangedAlgebraicGroup (D.Completion (.inl w)) G).val)
    (U : ClosedSubgroup P.group),
    IsParabolic _ P ∧ IsUnipotentRadical (closedSubgroupAlgebraicGroup P) U ∧
      g ∈ Set.range (radicalPoint D i (.inl w) U)}

end

end LinearAlgebraicGroups.Arithmetic.WeakApproximationByTori

namespace LinearAlgebraicGroups.Specs.WeakApproximationByTori

open Arithmetic Arithmetic.AdelicGroups Arithmetic.ArithmeticLatticeProjection
open Arithmetic.WeakApproximationByTori
open IntegralModels (MatrixRealization)
open GeometricRadicals (IsSemisimple)
open RelativeRank (relativeRank)

variable {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K)

def IdentityNeighborhoodFor : Prop :=
  ∀ (G : AffineAlgebraicGroup K), IsSemisimple G →
    ∀ (i : MatrixRealization G) (T : Finset D.Place), IsOpen (diagonalClosure D i T)

def ArchimedeanComponentsFor : Prop :=
  ∀ (G : AffineAlgebraicGroup K), IsSemisimple G →
    ∀ (i : MatrixRealization G) (T : Finset D.Place)
      (w : D.InfinitePlace) (hw : Sum.inr w ∈ T),
      ∀ x ∈ connectedComponent (1 : LocalPoints D i (.inr w)),
        factor D i T ⟨.inr w, hw⟩ x ∈ diagonalClosure D i T

def FiniteIndexFor : Prop :=
  ∀ (G : AffineAlgebraicGroup K), IsSemisimple G → relativeRank G = 0 →
    ∀ (i : MatrixRealization G) (T : Finset D.Place),
      CompactSpace (Adeles D i ∅ ⧸ diagonalSubgroup D i) →
      ∃ H : Subgroup (FinitePoints D i T), (H : Set _) = diagonalClosure D i T ∧ H.FiniteIndex

def FinitePlaceRadicalsFor : Prop :=
  ∀ (G : AffineAlgebraicGroup K), IsSemisimple G → relativeRank G = 0 →
    ∀ (i : MatrixRealization G) (T : Finset D.Place),
      CompactSpace (Adeles D i ∅ ⧸ diagonalSubgroup D i) →
      ∀ (w : D.FinitePlace) (hw : Sum.inl w ∈ T),
        0 < relativeRank (Unipotent.baseChangedAlgebraicGroup (D.Completion (.inl w)) G) →
        (↑((localPlus D i w).map (factor D i T ⟨.inl w, hw⟩)) : Set _) ⊆ diagonalClosure D i T

def IdentityNeighborhood : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K], IdentityNeighborhoodFor (numberData.{u, v} K)

def ArchimedeanComponents : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K], ArchimedeanComponentsFor (numberData.{u, v} K)

def FiniteIndex : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K], FiniteIndexFor (numberData.{u, v} K)

def FinitePlaceRadicals : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K], FinitePlaceRadicalsFor (numberData.{u, v} K)

end LinearAlgebraicGroups.Specs.WeakApproximationByTori
