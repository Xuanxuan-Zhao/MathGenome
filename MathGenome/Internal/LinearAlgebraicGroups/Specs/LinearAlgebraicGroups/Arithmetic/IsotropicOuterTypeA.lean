import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.HermitianMatrixGeneration
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OuterTypeALocalModels
import Mathlib.RingTheory.TensorProduct.Maps

universe u v w

namespace LinearAlgebraicGroups.Arithmetic.IsotropicOuterTypeA.Spec

open LinearAlgebraicGroups.Specs.UnitaryRankOne (quadraticConjugation)

open LinearAlgebraicGroups.Specs.HermitianMatrixGeneration (HermitianForm)

/-- The unitary group of a finite-dimensional nondegenerate Hermitian space
is generated by reflections over every infinite base field, including
characteristic two. -/
def HermitianReflectionGeneration : Prop :=
  ∀ {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E] [Infinite F]
    {V : Type w} [AddCommGroup V] [Module E V] [FiniteDimensional E V]
    (h : HermitianForm (W := V) (quadraticConjugation F E)),
    h.Nondegenerate → Subgroup.closure h.reflections = h.unitaryGroup

section HyperbolicPlane

open scoped TensorProduct Matrix

variable {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
variable {R : Type w} [CommRing R] [Algebra F R]

/-- Scalar extension of the quadratic conjugation. -/
def conjugationAt (σ : E ≃ₐ[F] E) : R ⊗[F] E →ₐ[R] R ⊗[F] E :=
  Algebra.TensorProduct.map (AlgHom.id R R) σ.toAlgHom

/-- The base ring is precisely the fixed algebra after any scalar extension. -/
def QuadraticFixedAlgebra : Prop :=
  ∀ {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E]
    (R : Type w) [CommRing R] [Algebra F R],
    Function.Injective (algebraMap R (R ⊗[F] E)) ∧
    ∀ x : R ⊗[F] E, conjugationAt (quadraticConjugation F E) x = x ↔
      ∃ r : R, algebraMap R (R ⊗[F] E) r = x

/-- The Gram matrix in a hyperbolic basis. -/
def hyperbolicMatrix (B : Type*) [CommRing B] : Matrix (Fin 2) (Fin 2) B :=
  !![0, 1; 1, 0]

/-- Conjugation by the diagonal basis change with entries `α,1`, for a
trace-zero unit `α`. The input has coefficients in the base ring. -/
def hyperbolicComparison (α : Eˣ) (B : Matrix (Fin 2) (Fin 2) R) :
    Matrix (Fin 2) (Fin 2) (R ⊗[F] E) :=
  let s : R ⊗[F] E := Algebra.TensorProduct.includeRight (R := F) (A := R) (α : E)
  let t : R ⊗[F] E := Algebra.TensorProduct.includeRight (R := F) (A := R) (↑α⁻¹ : E)
  Matrix.diagonal ![s, 1] * B.map (algebraMap R (R ⊗[F] E)) * Matrix.diagonal ![t, 1]

/-- The hyperbolic special unitary group of degree two is split `SL₂`.
The explicit comparison is over every test algebra, respects multiplication
and coefficient maps, and identifies both unitriangular subgroups. -/
def HyperbolicSpecialUnitary : Prop :=
  ∀ {F : Type u} {E : Type v} [Field F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E],
    ∃ α : Eˣ, quadraticConjugation F E (α : E) = -(α : E) ∧
      (∀ (R : Type w) [CommRing R] [Algebra F R],
        let C := R ⊗[F] E
        let J := hyperbolicMatrix C
        let σR : C →ₐ[R] C := conjugationAt (quadraticConjugation F E)
        let f := hyperbolicComparison (F := F) (R := R) α
        Function.Injective f ∧ f 1 = 1 ∧ (∀ B D, f (B * D) = f B * f D) ∧
        (∀ X : Matrix (Fin 2) (Fin 2) C,
          X.det = 1 ∧ (X.map σR).transpose * J * X = J ↔
            ∃ B : Matrix (Fin 2) (Fin 2) R, B.det = 1 ∧ f B = X) ∧
        (∀ (B : Matrix (Fin 2) (Fin 2) R) i j, f B i j = 0 ↔ B i j = 0) ∧
        (∀ (B : Matrix (Fin 2) (Fin 2) R) i, f B i i = 1 ↔ B i i = 1)) ∧
      (∀ {R S : Type w} [CommRing R] [Algebra F R] [CommRing S] [Algebra F S]
        (f : R →ₐ[F] S) (B : Matrix (Fin 2) (Fin 2) R),
          (hyperbolicComparison (F := F) α B).map
            (Algebra.TensorProduct.map f (AlgHom.id F E)) =
              hyperbolicComparison (F := F) α (B.map f))

end HyperbolicPlane

section GroupSchemes

open CategoryTheory
open scoped CategoryTheory.MonoidalCategory TensorProduct
open LinearAlgebraicGroups.Specs
open LinearAlgebraicGroups.Specs.Arithmetic.OppositeRadicals (IsNoncentral localPlus)
open LinearAlgebraicGroups.Specs.Arithmetic.RelativeRayGeneration (unipotentGenerated)
open LinearAlgebraicGroups.Specs.Arithmetic.RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open LinearAlgebraicGroups.Specs.Arithmetic.OuterTypeALocalModels (RepresentsHermitian)
open LinearAlgebraicGroups.Specs.CharacterDescent (Cocharacter)
open LinearAlgebraicGroups.Specs.IntegralModels (MatrixRealization)
open LinearAlgebraicGroups.Specs.OuterTypeAModels
open LinearAlgebraicGroups.Specs.GeneralLinearStructure (SpecialMatrixPoints)

variable {F : Type u} [Field F]

/-- At a nonsplit completion the isotropic special unitary group over the
quadratic field is generated by the rational parabolic radicals. The
formulation also applies over arbitrary infinite ground fields. -/
def HermitianLocalGeneration : Prop :=
  ∀ {F E : Type u} [Field F] [Field E] [Algebra F E]
    [Algebra.IsQuadraticExtension F E] [Algebra.IsSeparable F E] [Infinite F]
    {n : ℕ} (H : (Matrix (Fin n) (Fin n) E)ˣ),
    let σ := quadraticConjugation F E
    (H.val.map σ).transpose = H.val →
    (∃ x : Fin n → E, x ≠ 0 ∧ dotProduct (σ ∘ x) (Matrix.mulVec H.val x) = 0) →
    ∀ (G : AffineAlgebraicGroup F), RepresentsHermitian σ H.val G →
      unipotentGenerated G = ⊤

/-- Absolute simply connected type A and nontrivial diagram action, expressed
in a finite Galois splitting and its matrix trivialization. -/
def IsSimplyConnectedOuterTypeA (G : AffineAlgebraicGroup F) : Prop :=
  ∃ r : ℕ, 2 ≤ r ∧ HasAbsoluteSimplyConnectedTypeA r G ∧
    ∃ (H : AffineAlgebraicGroup F) (s : SpecialMatrixPoints H (r + 1))
      (L : Type u) (_ : Field L) (_ : Algebra F L) (_ : FiniteDimensional F L) (_ : IsGalois F L)
      (e : (groupBaseChange F L).obj H.val ≅ (groupBaseChange F L).obj G.val)
      (χ : DiagramCharacter F L) (g : Gal(L/F) → GL (Unipotent.Index.{u} (r + 1)) L),
      Function.Surjective χ ∧ HasMatrixTransport s e χ g

/-- At all completions of a globally isotropic simply connected outer A group
the parabolic radicals are dense in the local point group. -/
def OuterTypeALocalDensity : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u,v} K)
    (G : AffineAlgebraicGroup K), IsAbsolutelyAlmostSimple G → IsSimplyConnectedOuterTypeA G →
    (∃ c : Cocharacter G.val, IsNoncentral c) →
    ∀ (i : MatrixRealization G) (w : D.Place), Dense (localPlus D i w)

/-- Strong approximation for the globally isotropic simply connected outer A forms. -/
def OuterTypeAStrongApproximation : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u,v} K)
    (G : AffineAlgebraicGroup K), IsAbsolutelyAlmostSimple G → IsSimplyConnectedOuterTypeA G →
    (∃ c : Cocharacter G.val, IsNoncentral c) →
    ∀ (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
      AdelicGroups.StrongApproximation D i S

/-- The local density criterion specialized to these outer forms. -/
def StrongApproximationOfLocalDensity : Prop :=
  OuterTypeALocalDensity.{u,v} → OuterTypeAStrongApproximation.{u,v}

end GroupSchemes

end LinearAlgebraicGroups.Arithmetic.IsotropicOuterTypeA.Spec
