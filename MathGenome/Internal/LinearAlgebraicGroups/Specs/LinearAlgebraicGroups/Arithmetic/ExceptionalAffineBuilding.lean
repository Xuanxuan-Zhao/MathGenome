section LocalBuilding

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]
  {D : BasedRootDatum.{u}} {M : Model D} {G Wf : Type u} [Group G] [Group Wf]
  {j : G →* FieldPoints M K}
  {V : Type u} {J : Type v} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V}

abbrev parahoric (C : LocalComparison (j := j) (Wf := Wf) A p)
    (T : Set (A.SimpleWall p)) : Subgroup G :=
  faceSubgroup C.coxeter.coxeter C.I (fun w => (C.lift w : G)) T

/-- The realization uses the actual normalizer comparison at the given level. -/
structure Building (C : LocalComparison (j := j) (Wf := Wf) A p) where
  realization : Realization C.coxeter.coxeter C.I C.G₀ (fun w => (C.lift w : G))
  iwahori_inter_normalizer : C.I ⊓ C.N = C.T₀
  face_normalizer (T : Set (A.SimpleWall p)) :
    ((parahoric C T).comap C.N.subtype).map C.affine =
      (standardWallSubgroup C.coxeter.coxeter T).map A.affineWeylGroup.subtype
  lift_difference (w v : A.affineWeylGroup) :
    (C.lift (w⁻¹ * v) : G)⁻¹ * ((C.lift w : G)⁻¹ * (C.lift v : G)) ∈ C.T₀
  normalizer_action (n : C.N) (hn : (n : G) ∈ C.G₀) (x : EuclideanApartment V) :
    realization.translate ⟨n, hn⟩ (realization.chart 1 x) =
      realization.chart 1 (realAffine realization.coordinates realization.coordinates (C.affine n) x)
  stabilizer (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p))
      (ht : cotype t = T) (g : C.G₀) :
    realization.translate g (realization.place 1 t) = realization.place 1 t ↔
      (g : G) ∈ parahoric C T

variable {C : LocalComparison (j := j) (Wf := Wf) A p}

/-- The inverse image in the actual relative normalizer of the length-zero group. -/
abbrev lengthZeroNormalizer (C : LocalComparison (j := j) (Wf := Wf) A p) : Subgroup G :=
  ExceptionalBuildingActions.lengthZeroNormalizer C

abbrev typeChange (Q : C.TypeQuotient) : G →* alcoveStabilizer A (A.alcove p) :=
  ExceptionalBuildingActions.typeChange C Q


/-- The adjoint action extends left translation and uses the actual length-zero
representatives for its changes of type. -/
structure AdjointAction (X : Building C) (Q : C.TypeQuotient) where
  action : G →* (X.realization.Point ≃ᵢ X.realization.Point)
  type_preserving : (Q.wallPerm.comp (typeChange Q)).ker = C.G₀
  restrict (g : C.G₀) : action (g : G) = X.realization.translate g
  chart_normalizer (n : C.N) (x : EuclideanApartment V) :
    action (n : G) (X.realization.chart 1 x) =
      X.realization.chart 1
        (realAffine X.realization.coordinates X.realization.coordinates (C.affine n) x)
  place_action (g : G) (h : C.G₀) (t : Weights (A.SimpleWall p)) :
    ∃ (h' : C.G₀) (s : Weights (A.SimpleWall p)),
      action g (X.realization.place h t) = X.realization.place h' s ∧
        ∀ i, s.val (Q.wallPerm (typeChange Q g) i) = t.val i
  conjugates_face (ω : alcoveStabilizer A (A.alcove p)) (T : Set (A.SimpleWall p)) :
    (parahoric C T).map (MulAut.conj ((Q.lift ω : C.N) : G)).toMonoidHom =
      parahoric C (Q.wallPerm ω '' T)
  chamber_stabilizer (g : G) :
    action g '' X.realization.closedFace 1 ∅ = X.realization.closedFace 1 ∅ ↔
      g ∈ C.I ⊔ lengthZeroNormalizer C
  chamber_stabilizer_product :
    ((C.I ⊔ lengthZeroNormalizer C : Subgroup G) : Set G) =
      (C.I : Set G) * (lengthZeroNormalizer C : Set G)
  chamber_cosets : Chamber C.I C.G₀ ≃ (G ⧸ (C.I ⊔ lengthZeroNormalizer C))
  chamber_cosets_eq (g : Chamber C.I C.G₀) (h : C.G₀) :
    g.val = QuotientGroup.mk (h : G) → chamber_cosets g = QuotientGroup.mk (h : G)
  face_stabilizer (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p))
      (ht : cotype t = T) (hb : IsBarycenter T t) (g : G) :
    action g (X.realization.place 1 t) = X.realization.place 1 t ↔
      ∃ (a : parahoric C T) (ω : alcoveStabilizer A (A.alcove p)),
        g = (a : G) * (Q.lift ω : G) ∧
        realAffine X.realization.coordinates X.realization.coordinates ω.val.val
          (simplexPoint X.realization.coordinates X.realization.vertex t) =
            simplexPoint X.realization.coordinates X.realization.vertex t
  barycenter_types (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p))
      (ht : cotype t = T) (hb : IsBarycenter T t) (ω : alcoveStabilizer A (A.alcove p)) :
    realAffine X.realization.coordinates X.realization.coordinates ω.val.val
      (simplexPoint X.realization.coordinates X.realization.vertex t) =
        simplexPoint X.realization.coordinates X.realization.vertex t ↔ Q.wallPerm ω '' T = T
  stabilizer_types (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p))
      (ht : cotype t = T) (g : G) :
    action g (X.realization.place 1 t) = X.realization.place 1 t →
      Q.wallPerm (typeChange Q g) '' T = T

variable {Γ : Type u} [Group Γ]

/-- Extension of the coefficient or pinned semilinear action to the marked complex. -/
structure CoefficientAction (X : Building C) (ρ : Γ →* MulAut G)
    (e : Γ → V ≃ᵃ[ℚ] V) where
  action : Γ →* (X.realization.Point ≃ᵢ X.realization.Point)
  types : Γ →* Equiv.Perm (A.SimpleWall p)
  wall (σ : Γ) (i : A.SimpleWall p) :
    e σ '' A.wallHyperplane i.val = A.wallHyperplane (types σ i).val
  real_isometry (σ : Γ) :
    Isometry (realAffine X.realization.coordinates X.realization.coordinates (e σ))
  chart (σ : Γ) (g h : C.G₀) (hh : (h : G) = ρ σ (g : G)) (x : EuclideanApartment V) :
    action σ (X.realization.chart g x) =
      X.realization.chart h (realAffine X.realization.coordinates X.realization.coordinates (e σ) x)
  place_action (σ : Γ) (g h : C.G₀) (hh : (h : G) = ρ σ (g : G))
      (t s : Weights (A.SimpleWall p)) (hs : ∀ i, s.val (types σ i) = t.val i) :
    action σ (X.realization.place g t) = X.realization.place h s

/-- For the given coefficient action and a finite cocycle, the twisted isometries
preserve the open face of each fixed point and fix its barycenter. The chamber
representative locates the face by translating a face of the standard alcove. -/
def TwistedFixedFace [Finite Γ] {X : Building C} {Q : C.TypeQuotient}
    (ad : AdjointAction X Q) {ρ : Γ →* MulAut G} {e : Γ → V ≃ᵃ[ℚ] V}
    (coef : CoefficientAction X ρ e) (a : Γ → G) : Prop :=
  ∃ (twist : Γ →* (X.realization.Point ≃ᵢ X.realization.Point))
    (types : Γ →* Equiv.Perm (A.SimpleWall p)),
    (∀ σ x, twist σ x = ad.action (a σ) (coef.action σ x)) ∧
    (∀ σ, types σ = Q.wallPerm (typeChange Q (a σ)) * coef.types σ) ∧
    (∀ σ g t, ∃ h s, twist σ (X.realization.place g t) = X.realization.place h s ∧
      ∀ i, s.val (types σ i) = t.val i) ∧
    (∃ x, ∀ σ, twist σ x = x) ∧
    ∀ x, (∀ σ, twist σ x = x) →
      ∃ (g : C.G₀) (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p)),
        x ∈ X.realization.openFace g T ∧ cotype t = T ∧ IsBarycenter T t ∧
        X.realization.translate g (X.realization.place 1 t) = X.realization.place g t ∧
        ∀ σ, twist σ '' X.realization.openFace g T = X.realization.openFace g T ∧
          twist σ (X.realization.place g t) = X.realization.place g t

/-- A coefficient comparison on the given rational points yields an action
compatible with the adjoint action and every finite cocycle twist. -/
def AdjointCoefficientActions {X : Building C} {Q : C.TypeQuotient}
    (ad : AdjointAction X Q) : Prop :=
  ∀ (Γ : Type u) [Group Γ] (ρ : Γ →* MulAut G) (e : Γ → V ≃ᵃ[ℚ] V),
    (∀ σ, AutomorphismComparison C (ρ σ) (e σ)) →
    ∃ coef : CoefficientAction X ρ e,
      (∀ σ g x, coef.action σ (ad.action g x) = ad.action (ρ σ g) (coef.action σ x)) ∧
      ∀ [Finite Γ] (a : Γ → G),
        (∀ σ τ, a (σ * τ) = a σ * ρ σ (a τ)) → TwistedFixedFace ad coef a

end LocalBuilding


section Maps

variable {G H V V' : Type u} {J J' : Type v} [Group G] [Group H]
  [AddCommGroup V] [Module ℚ V] [AddCommGroup V'] [Module ℚ V']
  {A : ApartmentRoots ℚ V J} {A' : ApartmentRoots ℚ V' J'} {p : V} {p' : V'}
  {M : CoxeterMatrix (A.SimpleWall p)} {M' : CoxeterMatrix (A'.SimpleWall p')}
  {cs : CoxeterSystem M A.affineWeylGroup} {cs' : CoxeterSystem M' A'.affineWeylGroup}
  {I G₀ : Subgroup G} {I' H₀ : Subgroup H}
  {lift : A.affineWeylGroup → G} {lift' : A'.affineWeylGroup → H}

/-- The geometric map induced by a homomorphism of marked rational points
and the specified linear identification of the cocharacter apartments. -/
structure RealizationMap (X : Realization cs I G₀ lift) (Y : Realization cs' I' H₀ lift')
    (φ : G →* H) (e : V ≃ₗ[ℚ] V') where
  maps_group : G₀ ≤ H₀.comap φ
  wall : A.SimpleWall p ≃ A'.SimpleWall p'
  wall_eq (i : A.SimpleWall p) :
    e '' A.wallHyperplane i.val = A'.wallHyperplane (wall i).val
  iwahori : I'.comap φ = I
  parahoric_eq (T : Set (A.SimpleWall p)) :
    (faceSubgroup cs' I' lift' (wall '' T)).comap φ = faceSubgroup cs I lift T
  point : X.Point → Y.Point
  isometry : Isometry point
  chart (g : G₀) (x : EuclideanApartment V) :
    point (X.chart g x) = Y.chart ⟨φ g, maps_group g.property⟩
      (realAffine X.coordinates Y.coordinates e.toAffineEquiv x)
  place (g : G₀) (t : Weights (A.SimpleWall p)) (s : Weights (A'.SimpleWall p'))
      (hs : ∀ i, s.val (wall i) = t.val i) :
    point (X.place g t) = Y.place ⟨φ g, maps_group g.property⟩ s

end Maps

open ExceptionalIwahoriCongruence (integralRing)

section Split

variable {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]
  {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
  {c : MarkedCentralCover M M'} {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
  {e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)}

/-- The pair of buildings over one split level, with the actual central map
and the adjoint action on the adjoint complex. -/
structure SplitBuildingLevel (L : SplitLevel K c p p' e) where
  sc : Building L.sc
  ad : Building L.ad
  central : RealizationMap sc.realization ad.realization
    (integralPointHom c.map (CommAlgCat.of Integers.{u} K)) e
  central_onto : Function.Surjective central.point
  adjoint : AdjointAction ad L.typeQuotient
  coefficients : AdjointCoefficientActions adjoint

end Split

/-- The labeled building over each split exceptional reference field and its
finite unramified extensions. The two kinds of pinned coefficient actions
available at the extension level act on this same realization. -/
def SplitAffineBuildings : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
    (c : MarkedCentralCover M M') (n : ℕ) (b : Fin n ≃ D.base.support) (b' : Fin n ≃ E.base.support),
    (n = 6 ∨ n = 7 ∨ n = 8) →
    ExceptionalNumbering D n b → ExceptionalNumbering E n b' →
    D.datum.corootSpan ℤ = ⊤ → E.datum.rootSpan ℤ = ⊤ →
    ∃ (p : ℚ ⊗[ℤ] D.Y) (p' : ℚ ⊗[ℤ] E.Y)
      (e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y))
      (X : SplitLevel F c p p' e) (BX : SplitBuildingLevel X),
      e.toLinearMap = c.pushCocharacter.baseChange ℚ ∧ p' = e p ∧
      ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K]
        [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension F K],
        IsUnramifiedLocalExtension F K →
        ∃ (Y : SplitLevel K c p p' e) (BY : SplitBuildingLevel Y),
          let s := scalarPoints M (algebraMap F K)
          let s' := scalarPoints M' (algebraMap F K)
          ScalarComparison (algebraMap F K) s X.sc Y.sc ∧
          ScalarComparison (algebraMap F K) s' X.ad Y.ad ∧
          TypeQuotientTransport X.typeQuotient Y.typeQuotient s' (MonoidHom.id _) ∧
          (∃ (f : RealizationMap BX.sc.realization BY.sc.realization s (LinearEquiv.refl ℚ _))
            (f' : RealizationMap BX.ad.realization BY.ad.realization s' (LinearEquiv.refl ℚ _)),
            (∀ g x, f'.point (BX.adjoint.action g x) = BY.adjoint.action (s' g) (f'.point x)) ∧
            ∀ x, f'.point (BX.central.point x) = BY.central.point (f.point x)) ∧
          Y.Coefficients (F := F) ∧
          ∀ (h : n = 6)
            (C : MarkedFibre M F) (C' : MarkedFibre M' F)
            (l : Aut C.realization.attached.toBased ≃* Aut C.realization.pinned)
            (l' : Aut C'.realization.attached.toBased ≃* Aut C'.realization.pinned)
            (Q : AdjointQuotient C.realization.pinned.pair.G)
            (Q' : AdjointQuotient C'.realization.pinned.pair.G),
            Y.OuterE6Coefficients (h ▸ b) (h ▸ b') C C' (l := l) (l' := l') (Q := Q) (Q' := Q')

section Folded

variable {F L k K : Type u} [Field F] [Field L] [Field k] [Field K]
  [Algebra F L] [Algebra F k] [Algebra F K] [Algebra k K] [IsScalarTower F k K]
  [ValuativeRel k] [TopologicalSpace k] [IsNonarchimedeanLocalField k]
  [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
  {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
  {R : RamifiedReference F L M} {R' : RamifiedReference F L M'}
  {σ : Gal(L/F)} {σK : Gal(K/k)} {f : L →ₐ[F] K}
  {A : FoldedApartment (R.diagram σ)} {A' : FoldedApartment (R'.diagram σ)}

/-- The pair of buildings over one level of the ramified diagram descent. -/
structure FoldedBuildingLevel
    (X : FoldedLevel R σ σK f A) (Y : FoldedLevel R' σ σK f A')
    (φ : R.descent.group.val ⟶ R'.descent.group.val)
    (e : invariantApartment D (R.diagram σ) ≃ₗ[ℚ] invariantApartment E (R'.diagram σ)) where
  sc : Building X.comparison
  ad : Building Y.comparison
  central : RealizationMap sc.realization ad.realization
    (pointHom φ ((testSpec F).obj (.op (CommAlgCat.of F k)))) e
  central_onto : Function.Surjective central.point
  adjoint : AdjointAction ad Y.typeQuotient
  coefficients : AdjointCoefficientActions adjoint

end Folded

/-- The labeled building for the ramified quasi-split outer E₆ reference, in
both isogeny types and at every finite unramified coefficient extension. -/
def RamifiedAffineBuildings : Prop :=
  ∀ (F L : Type u) [Field F] [Field L] [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension F L]
    (σ : Gal(L/F)), Module.finrank F L = 2 → σ ≠ 1 → 1 < ramificationIndex F L →
    ∀ {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E} (c : MarkedCentralCover M M')
      (b : Fin 6 ≃ D.base.support) (b' : Fin 6 ≃ E.base.support),
    ExceptionalNumbering D 6 b → ExceptionalNumbering E 6 b' →
    D.datum.corootSpan ℤ = ⊤ → E.datum.rootSpan ℤ = ⊤ →
    ∀ (R : RamifiedReference F L M) (R' : RamifiedReference F L M'),
    let τ := R.diagram σ
    let τ' := R'.diagram σ
    (∀ i, τ.val.indexEquiv (b i) = b (e6Partner i)) →
    (∀ i, τ'.val.indexEquiv (b' i) = b' (e6Partner i)) →
    (∀ i, c.rootEquiv (τ.val.indexEquiv i) = τ'.val.indexEquiv (c.rootEquiv i)) →
    ∃ (A : FoldedApartment τ) (A' : FoldedApartment τ')
      (e : invariantApartment D τ ≃ₗ[ℚ] invariantApartment E τ')
      (φ : R.descent.group.val ⟶ R'.descent.group.val)
      (X : FoldedLevel R σ σ (AlgHom.id F L) A)
      (X' : FoldedLevel R' σ σ (AlgHom.id F L) A')
      (BX : FoldedBuildingLevel X X' φ e),
      (∀ x, (e x).val = c.pushCocharacter.baseChange ℚ x.val) ∧ A'.basepoint = e A.basepoint ∧
      CentralIsogenies.IsCentralIsogeny φ ∧
      CentralComparison c (pointHom φ ((testSpec F).obj (.op (CommAlgCat.of F F))))
        X.comparison X'.comparison e ∧
      ∀ (k : Type u) [Field k] [Algebra F k] [FiniteDimensional F k]
        [ValuativeRel k] [TopologicalSpace k] [IsNonarchimedeanLocalField k] [ValuativeExtension F k],
        IsUnramifiedLocalExtension F k →
        ∃ (T : DiagramCompositum F L k σ)
          (Y : FoldedLevel R σ T.diagram (IsScalarTower.toAlgHom F L T.field) A)
          (Y' : FoldedLevel R' σ T.diagram (IsScalarTower.toAlgHom F L T.field) A')
          (BY : FoldedBuildingLevel Y Y' φ e),
          let s := coefficientPoints R.descent.group.val (Algebra.ofId F k)
          let s' := coefficientPoints R'.descent.group.val (Algebra.ofId F k)
          CentralComparison c (pointHom φ ((testSpec F).obj (.op (CommAlgCat.of F k))))
            Y.comparison Y'.comparison e ∧
          ScalarComparison (algebraMap L T.field) s X.comparison Y.comparison ∧
          ScalarComparison (algebraMap L T.field) s' X'.comparison Y'.comparison ∧
          TypeQuotientTransport X'.typeQuotient Y'.typeQuotient s' (MonoidHom.id _) ∧
          (∃ (f : RealizationMap BX.sc.realization BY.sc.realization s (LinearEquiv.refl ℚ _))
            (f' : RealizationMap BX.ad.realization BY.ad.realization s' (LinearEquiv.refl ℚ _)),
            (∀ g x, f'.point (BX.adjoint.action g x) = BY.adjoint.action (s' g) (f'.point x)) ∧
            ∀ x, f'.point (BX.central.point x) = BY.central.point (f.point x)) ∧
          Y.Coefficients T ∧ Y'.Coefficients T

end

end LinearAlgebraicGroups.Specs.ExceptionalAffineBuilding
