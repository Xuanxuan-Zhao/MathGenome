section Cosets

variable {G B W : Type*} [Group G] [Group W]
  {M : CoxeterMatrix B} (cs : CoxeterSystem M W) (I : Subgroup G) (lift : W → G)

/-- The standard subgroup of the ordinary affine Weyl group at a face of cotype `J`. -/
abbrev standardWallSubgroup (J : Set B) : Subgroup W :=
  ExceptionalRealAlcove.standardWallSubgroup cs J

/-- The subgroup generated by the Iwahori and the simple lifts in `J`. -/
def faceSubgroup (J : Set B) : Subgroup G :=
  Subgroup.closure ((I : Set G) ∪ (lift ∘ cs.simple) '' J)

/-- Chambers are left cosets of the Iwahori with a type-preserving representative. -/
abbrev Chamber (G₀ : Subgroup G) :=
  Set.range (fun g : G₀ => (QuotientGroup.mk (g : G) : G ⧸ I))

/-- Faces of a specified cotype are left cosets of the corresponding face subgroup. -/
abbrev Face (G₀ : Subgroup G) (J : Set B) :=
  Set.range (fun g : G₀ => (QuotientGroup.mk (g : G) : G ⧸ faceSubgroup cs I lift J))

/-- The chambers of the apartment translated by `g`. -/
def apartmentChambers (g : G) : Set (G ⧸ I) :=
  Set.range fun w => QuotientGroup.mk (g * lift w)

end Cosets

/-- Coordinates on a closed simplex, indexed by the walls opposite the vertices. -/
abbrev Weights := ExceptionalRealAlcove.Weights

abbrev cotype := @ExceptionalRealAlcove.cotype

/-- The barycenter of the relative interior of a nonempty face. -/
def IsBarycenter {B : Type*} (J : Set B) (t : Weights B) : Prop :=
  ∀ i, t.val i = if i ∈ J then 0 else 1 / (Nat.card {i // i ∉ J} : ℝ)

/-- Lengths of finite chains of segments lying in individual closed chambers. -/
inductive CellChain {G B E X : Type*} [MetricSpace E]
    (place : G → Weights B → X) (position : Weights B → E) : X → X → ℝ → Prop
  | nil (x : X) : CellChain place position x x 0
  | cons (g : G) (t s : Weights B) {x : X} {l : ℝ} :
      CellChain place position (place g s) x l →
      CellChain place position (place g t) x (dist (position t) (position s) + l)

section RealApartment

variable {V V' : Type u} [AddCommGroup V] [AddCommGroup V'] [Module ℚ V] [Module ℚ V']

abbrev EuclideanApartment (V : Type u) [AddCommGroup V] [Module ℚ V] :=
  EuclideanSpace ℝ (Fin (Module.finrank ℚ V))

abbrev RealCoordinates (V : Type u) [AddCommGroup V] [Module ℚ V] :=
  (ℝ ⊗[ℚ] V) ≃ₗ[ℝ] EuclideanApartment V

abbrev rationalPoint := @ExceptionalRealAlcove.rationalPoint

/-- Scalar extension of a rational affine map of apartments. -/
abbrev realAffine := @ExceptionalRealAlcove.realAffine

abbrev realWallValue := @ExceptionalRealAlcove.realWallValue

abbrev simplexPoint := @ExceptionalRealAlcove.simplexPoint

end RealApartment

section Building

variable {G V : Type u} {J : Type v} [Group G] [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V} {M : CoxeterMatrix (A.SimpleWall p)}

/-- A realization of the marked coset complex. The gluing formula fixes the
point set up to the canonical bijection, and the chain formula fixes its metric. -/
structure Realization (cs : CoxeterSystem M A.affineWeylGroup) (I G₀ : Subgroup G)
    (lift : A.affineWeylGroup → G) where
  Point : Type (max u v)
  [metric : MetricSpace Point]
  [complete : CompleteSpace Point]
  cat0 : Geometry.CAT0SpacesSpec.cat0Value Point
  midpoint : Geometry.CAT0ComparisonSpec.midpointComparisonValue Point
  coordinates : RealCoordinates V
  finite_types : Finite (A.SimpleWall p)
  vertex : A.SimpleWall p → V
  vertex_marked : ∀ i, IsAlcoveVertex A p i (vertex i)
  vertex_unique : ∀ i x, IsAlcoveVertex A p i x → x = vertex i
  independent : AffineIndependent ℝ (rationalPoint coordinates ∘ vertex)
  closed_alcove : Set.range (simplexPoint coordinates vertex) =
    {x | ∀ a, A.positive p a → 0 ≤ realWallValue A coordinates a x}
  open_alcove : simplexPoint coordinates vertex '' {t | cotype t = ∅} =
    {x | ∀ a, A.positive p a → 0 < realWallValue A coordinates a x}
  weyl_isometry : ∀ w : A.affineWeylGroup, Isometry (realAffine coordinates coordinates w.val)
  wall_group : ∀ t : Weights (A.SimpleWall p),
    standardWallSubgroup cs (cotype t) =
      Subgroup.closure ((fun a => (⟨A.reflection a, Subgroup.subset_closure ⟨a, rfl⟩⟩ :
        A.affineWeylGroup)) '' {a | realWallValue A coordinates a
          (simplexPoint coordinates vertex t) = 0})
  translated_wall_group (w : A.affineWeylGroup) (t : Weights (A.SimpleWall p)) :
    (standardWallSubgroup cs (cotype t)).map (MulAut.conj w).toMonoidHom =
      ExceptionalRealAlcove.wallReflectionGroup A coordinates
        (realAffine coordinates coordinates w.val (simplexPoint coordinates vertex t))
  finite_wall_group : ∀ (T : Set (A.SimpleWall p)), T ≠ univ → Finite (standardWallSubgroup cs T)
  iwahori_mem : I ≤ G₀
  lift_mem : ∀ w, lift w ∈ G₀
  face_mem : ∀ T, faceSubgroup cs I lift T ≤ G₀
  face_union : ∀ T : Set (A.SimpleWall p), (faceSubgroup cs I lift T : Set G) =
    ⋃ w : standardWallSubgroup cs T, DoubleCoset.doubleCoset (lift w.val) I I
  face_inter : ∀ T U : Set (A.SimpleWall p),
    faceSubgroup cs I lift T ⊓ faceSubgroup cs I lift U = faceSubgroup cs I lift (T ∩ U)
  apartment_incidence : ∀ (T : Set (A.SimpleWall p)) (g : G₀) (w w' : A.affineWeylGroup),
    (QuotientGroup.mk ((g : G) * lift w) : G ⧸ faceSubgroup cs I lift T) =
      QuotientGroup.mk ((g : G) * lift w') ↔ w⁻¹ * w' ∈ standardWallSubgroup cs T
  incident_finite : ∀ (T : Set (A.SimpleWall p)), T ≠ univ → ∀ g : G₀,
    (QuotientGroup.mk '' {h : G | (g : G)⁻¹ * h ∈ faceSubgroup cs I lift T} : Set (G ⧸ I)).Finite
  common_apartment : ∀ c c' : Chamber I G₀,
    ∃ g : G₀, c.val ∈ apartmentChambers I lift g ∧ c'.val ∈ apartmentChambers I lift g
  place : G₀ → Weights (A.SimpleWall p) → Point
  place_surjective : ∀ x, ∃ g t, place g t = x
  place_eq : ∀ g h t s, place g t = place h s ↔
    t = s ∧ (g : G)⁻¹ * (h : G) ∈ faceSubgroup cs I lift (cotype t)
  open_face_cosets : ∀ (T U : Set (A.SimpleWall p)), T ≠ univ → U ≠ univ → ∀ g h : G₀,
    place g '' {t | cotype t = T} = place h '' {t | cotype t = U} ↔
      T = U ∧ (g : G)⁻¹ * (h : G) ∈ faceSubgroup cs I lift T
  closed_face_incidence : ∀ (T U : Set (A.SimpleWall p)), T ≠ univ → U ≠ univ → ∀ g h : G₀,
    place g '' {t | T ⊆ cotype t} ⊆ place h '' {t | U ⊆ cotype t} ↔
      {b : G | (h : G)⁻¹ * b ∈ faceSubgroup cs I lift U} ⊆
        {b : G | (g : G)⁻¹ * b ∈ faceSubgroup cs I lift T}
  barycenter : ∀ (T : Set (A.SimpleWall p)), T ≠ univ → ∃ t, cotype t = T ∧ IsBarycenter T t
  barycenter_rational : ∀ (T : Set (A.SimpleWall p)) (t : Weights (A.SimpleWall p)),
    IsBarycenter T t → ∃ x : V, rationalPoint coordinates x = simplexPoint coordinates vertex t
  chart : G₀ → EuclideanApartment V → Point
  chart_isometry : ∀ g, Isometry (chart g)
  chart_cover : ∀ x, ∃ w t, x = realAffine coordinates coordinates (w : A.affineWeylGroup).val
    (simplexPoint coordinates vertex t)
  chart_place : ∀ (g : G₀) (w : A.affineWeylGroup) (t : Weights (A.SimpleWall p)),
    chart g (realAffine coordinates coordinates w.val (simplexPoint coordinates vertex t)) =
      place (g * ⟨lift w, lift_mem w⟩) t
  intrinsic : ∀ x y, dist x y = sInf {l | CellChain place (simplexPoint coordinates vertex) x y l}
  translate : G₀ →* (Point ≃ᵢ Point)
  translate_chart : ∀ g h x, translate g (chart h x) = chart (g * h) x
  retract : ∀ (g : G₀) (u : A.affineWeylGroup), ∃ r : Point → EuclideanApartment V,
    LipschitzWith 1 r ∧
    (∀ x, r (chart g x) = x) ∧
    (∀ (h : G₀) (w : A.affineWeylGroup) (t : Weights (A.SimpleWall p)),
      (((g : G) * lift u)⁻¹ * (h : G)) ∈ DoubleCoset.doubleCoset (lift w) I I →
      r (place h t) = realAffine coordinates coordinates (u * w).val
        (simplexPoint coordinates vertex t)) ∧
    ∀ (h : G₀) (v : A.affineWeylGroup),
      (QuotientGroup.mk ((h : G) * lift v) : G ⧸ I) = QuotientGroup.mk ((g : G) * lift u) →
      ∀ x, r (chart h x) = realAffine coordinates coordinates (u * v⁻¹).val x

attribute [instance] Realization.metric Realization.complete

variable {cs : CoxeterSystem M A.affineWeylGroup} {I G₀ : Subgroup G}
  {lift : A.affineWeylGroup → G}

def Realization.closedFace (X : Realization cs I G₀ lift) (g : G₀)
    (T : Set (A.SimpleWall p)) : Set X.Point :=
  X.place g '' {t | T ⊆ cotype t}

def Realization.openFace (X : Realization cs I G₀ lift) (g : G₀)
    (T : Set (A.SimpleWall p)) : Set X.Point :=
  X.place g '' {t | cotype t = T}

end Building

