import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.NontrialitarianSpinModels
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals

open AlgebraicGeometry CategoryTheory Opposite
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.ScalarEvenSpinLocalDensity

open AbsoluteDynkinTypes (IsAbsolutelyAlmostSimple)
open CharacterDescent (Cocharacter)
open IntegralModels (MatrixRealization)
open LinearAlgebraicGroups.Arithmetic.AdelicGroups (PointsIn)
open NontrialitarianSpinModels (DescendedQuadraticPair IsOrthogonal SpinModel)
open OppositeRadicals (IsNoncentral)
open RelativeRayGeneration (unipotentGenerated)
open RM03.Brauer.SemilinearDescent (AlgebraAction)
open SymplecticInvolutionModels.DivisionForms (toDivisionInvolution)

/-- For a type `D` spin model whose descended algebra is split and whose
involution is orthogonal, a noncentral cocharacter over `F` gives density of
the subgroup generated by the `F`-points of the unipotent radicals of all
`F`-parabolics. Use the matrix coefficient topology of each closed realization
of the original group `G`. The index type `I` labels the hyperbolic pairs of
the split model. -/
def Statement : Prop :=
  ∀ {F K I : Type u} [Field F] [Infinite F] [TopologicalSpace F]
    [Field K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K]
    [Fintype I] [DecidableEq I],
    (2 : F) ≠ 0 → 4 ≤ Fintype.card I →
    ∀ (G : AffineAlgebraicGroup F),
      IsAbsolutelyAlmostSimple G → SimplyConnectedLattice.GeometricallySimplyConnected G →
      ∀ {ρ : AlgebraAction F K (Matrix (I ⊕ I) (I ⊕ I) K)}
        (D : DescendedQuadraticPair ρ), SpinModel G D →
        IsOrthogonal (toDivisionInvolution D.involution) →
        ∀ (r : ℕ), (ρ.fixedSubalgebra ≃ₐ[F] Matrix (Fin r) (Fin r) F) →
          ∀ (c : Cocharacter G.val), IsNoncentral c →
          ∀ (i : MatrixRealization G),
            Dense {g : PointsIn i F | ∃ p ∈ unipotentGenerated G,
              toUnit ((testSpec F).obj (op (CommAlgCat.of F F))) ≫ p = g}

end LinearAlgebraicGroups.Specs.Arithmetic.ScalarEvenSpinLocalDensity
