import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.RelativeRayGeneration
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ApproximationOfLocalWords
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Relative.SplitContractingRadical

open AlgebraicGeometry CategoryTheory Opposite
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

universe u v

namespace LinearAlgebraicGroups.Specs.Arithmetic.OppositeRadicals

open LinearAlgebraicGroups.Arithmetic
open AdelicGroups ApproximationOfLocalWords
open IntegralModels (MatrixRealization)
open BorelProper (IsParabolic)
open CharacterDescent (Cocharacter)
open DiagonalizableGroups (IntegerCharacters groupAlgebra)
open GeometricRadicals (baseChangedSubgroup)
open RankOneFlag (SameSubgroup)
open RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open RelativeRayGeneration (unipotentGenerated)
open StandardParabolicLevi (IsContractingRadical)
open Unipotent (baseChangedAlgebraicGroup)
open LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition oppositeCocharacter unitPoint)

noncomputable section

abbrev MultiplicativeGroup (K : Type u) [Field K] : GroupScheme K :=
  specGroup (groupAlgebra K IntegerCharacters)

def IsNoncentral {K : Type u} [Field K] {G : GroupScheme K} (c : Cocharacter G) : Prop :=
  ∃ (X : SchemeOver K) (g : X ⟶ G.X), ¬ Centralizes c g

/-- The two fixed radicals inside the original K-group. -/
def fixedRadicals {K : Type u} [Field K] {G : GroupScheme K} {c : Cocharacter G}
    (P : LimitDecomposition c) (Q : LimitDecomposition (oppositeCocharacter c)) :
    ULift.{u} Bool → ClosedSubgroup G
  | ⟨false⟩ => P.contracting
  | ⟨true⟩ => Q.contracting

/-- The sections definition of (G at F)(F)⁺ viewed in the local point group. -/
def localPlus {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    (D : GlobalFieldData.{u, v} K) (i : MatrixRealization G) (w : D.Place) :
    Set (LocalPoints D i w) :=
  let F := D.Completion w
  let R := CommAlgCat.of F F
  let G' := baseChangedAlgebraicGroup F G
  {g | ∃ p ∈ unipotentGenerated G',
    baseChangePoint K F G.val.X R (toUnit ((testSpec F).obj (op R)) ≫ p) = g}

/-- Scalar extension preserves geometric almost simplicity. -/
def AbsolutelyAlmostSimpleFieldExtension : Prop :=
  ∀ {K F : Type u} [Field K] [Field F] [Algebra K F] (G : AffineAlgebraicGroup K),
    IsAbsolutelyAlmostSimple G → IsAbsolutelyAlmostSimple (baseChangedAlgebraicGroup F G)

/-- The fixed parabolics and their radicals after extension to a completion,
and the resulting subgroup of local points. -/
def LocalGeneration : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K)
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → ∀ (c : Cocharacter G.val), IsNoncentral c →
    ∀ (P : LimitDecomposition c) (Q : LimitDecomposition (oppositeCocharacter c))
      (w : D.Place),
      let F := D.Completion w
      let G' := baseChangedAlgebraicGroup F G
      ∃ e : MultiplicativeGroup F ≅ (groupBaseChange K F).obj (MultiplicativeGroup K),
        (∀ (R : TestAlgebra F) (s : Rˣ),
          baseChangePoint K F (MultiplicativeGroup K).X R (unitPoint R s ≫ e.hom.hom.hom) =
            unitPoint ((restrictTestAlgebra K F).obj R) s) ∧
        let c' : Cocharacter G'.val := e.hom ≫ (groupBaseChange K F).map c
        IsNoncentral c' ∧
        ∃ (P' : LimitDecomposition c') (Q' : LimitDecomposition (oppositeCocharacter c')),
        ∃ hp hq hu hv,
          SameSubgroup P'.parabolic (baseChangedSubgroup F P.parabolic hp) ∧
          SameSubgroup Q'.parabolic (baseChangedSubgroup F Q.parabolic hq) ∧
          SameSubgroup P'.contracting (baseChangedSubgroup F P.contracting hu) ∧
          SameSubgroup Q'.contracting (baseChangedSubgroup F Q.contracting hv) ∧
          IsParabolic G' P'.parabolic ∧ IsParabolic G' Q'.parabolic ∧
          IsContractingRadical P' ∧ IsContractingRadical Q' ∧
          (generatedBySubgroups (fixedRadicals P Q) D i w : Set (LocalPoints D i w)) =
            localPlus D i w

/-- The global radicals have affine coordinates, and local density of the groups
generated by rational parabolic radicals implies strong approximation away from S.
The finite-support approximation conclusion also holds without local density. -/
def Approximation : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K)
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → ∀ (c : Cocharacter G.val), IsNoncentral c →
    ∀ (P : LimitDecomposition c) (Q : LimitDecomposition (oppositeCocharacter c)),
      IsParabolic G P.parabolic ∧ IsParabolic G Q.parabolic ∧
      IsContractingRadical P ∧ IsContractingRadical Q ∧
      ∀ (S : Finset D.Place), S.Nonempty →
        (∀ x : Adeles D i S,
          (∃ T : Finset (Outside D S), ∀ w ∉ T, x w = 1) →
          (∀ w : Outside D S, x w ∈ localPlus D i w.1) →
          x ∈ rationalClosure D i S) ∧
        ((∀ w : Outside D S, Dense (localPlus D i w.1)) → StrongApproximation D i S)

end
end LinearAlgebraicGroups.Specs.Arithmetic.OppositeRadicals
