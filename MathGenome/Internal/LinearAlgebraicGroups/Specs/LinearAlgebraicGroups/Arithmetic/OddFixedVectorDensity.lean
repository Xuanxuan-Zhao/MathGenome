import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.NontrialitarianSpinModels
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals

open AlgebraicGeometry CategoryTheory Opposite
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.OddFixedVectorDensity

open AbsoluteDynkinTypes (IsAbsolutelyAlmostSimple)
open CharacterDescent (Cocharacter)
open IntegralModels (MatrixRealization)
open LinearAlgebraicGroups.Arithmetic.AdelicGroups (PointsIn)
open NontrialitarianSpinModels (HasFixedVectorVertex)
open OppositeRadicals (IsNoncentral)
open RelativeRayGeneration (unipotentGenerated)
open SimplyConnectedLattice (GeometricallySimplyConnected)

/-- Local density of the subgroup generated by rational parabolic radicals for an
isotropic simply connected type `D₄` group with a fixed vector vertex, in
characteristic different from two. The topology is that of the given local field
and the chosen closed matrix realization. -/
def Statement : Prop :=
  ∀ {F : Type u} [Field F] [TopologicalSpace F], (2 : F) ≠ 0 →
    ((∃ v : ValuativeRel F, @IsNonarchimedeanLocalField F _ v _) ∨
      (∃ r : F ≃+* ℝ, IsHomeomorph r)) →
    ∀ (G : AffineAlgebraicGroup F),
      IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
      HasFixedVectorVertex G 4 →
      ∀ (c : Cocharacter G.val), IsNoncentral c →
        ∀ (i : MatrixRealization G),
          Dense {g : PointsIn i F | ∃ p ∈ unipotentGenerated G,
            toUnit ((testSpec F).obj (op (CommAlgCat.of F F))) ≫ p = g}

end LinearAlgebraicGroups.Specs.Arithmetic.OddFixedVectorDensity
