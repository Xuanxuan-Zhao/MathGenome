import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.QuasiSplitLocalGeneration
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.RelativeRayGeneration

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.QuasiSplitRadicalGeneration

open GeometricBorelConjugacy (IsQuasiSplit)
open GeometricRadicals (IsSemisimple)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Specs.QuasiSplitLocalGeneration (IsLocalField)
open RelativeRayGeneration (unipotentGenerated)

/-- The rational points of a quasi-split simply connected semisimple group
over a local field are generated by the rational parabolic radicals. -/
def Statement : Prop :=
  ∀ {F : Type u} [Field F], IsLocalField F →
    ∀ G : AffineAlgebraicGroup F, IsSemisimple G →
      GeometricallySimplyConnected G → IsQuasiSplit G → unipotentGenerated G = ⊤

end LinearAlgebraicGroups.Specs.Arithmetic.QuasiSplitRadicalGeneration
