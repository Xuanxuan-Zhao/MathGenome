import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.LocalNormOneCommutators
import Mathlib.RingTheory.SimpleRing.Matrix
import Mathlib.Algebra.Central.Matrix

noncomputable section

namespace LinearAlgebraicGroups.Arithmetic.InnerTypeALocalGeneration.Spec

open LocalNormOneCommutators.Spec
open _root_.Specs.RM03.CSA
open scoped WithZero

universe u v

/-- A positive-size matrix algebra over a central simple algebra is central simple. -/
theorem matrixCentralSimple {F A : Type*} [Field F] [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) {m : ℕ} (hm : 0 < m) :
    isCentralSimple F (Matrix (Fin m) (Fin m) A) := by
  let : Nonempty (Fin m) := ⟨⟨0, hm⟩⟩
  let : IsSimpleRing A := hA.1
  let : Algebra.IsCentral F A := hA.2.1
  let : FiniteDimensional F A := hA.2.2
  exact ⟨inferInstance, inferInstance, inferInstance⟩

/-- Density of the subgroup generated by all units with a single off-diagonal
block, in the local topology of the reduced-norm-one group. -/
def BlockDensity {F A : Type*} [Field F] [TopologicalSpace F] [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) (m : ℕ) (hm : 2 ≤ m) : Prop :=
  let M := Matrix (Fin m) (Fin m) A
  let hM := matrixCentralSimple hA (by omega : 0 < m)
  let E := (elementaryGroup (B := A) (Fin m) : Set Mˣ)
  E ⊆ normOne hM ∧
    ∀ b : Module.Basis (Fin (Module.finrank F M)) F M,
      letI := coordinateTopology b
      normOne hM ⊆ closure E

/-- Local generation by the original block root groups, for all central simple
coefficient algebras at finite, real and complex places. -/
def LocalBlockGeneration : Prop :=
  (∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] {A : Type v} [Ring A] [Algebra F A]
      (hA : isCentralSimple F A) (m : ℕ) (hm : 2 ≤ m), BlockDensity hA m hm) ∧
  (∀ {A : Type v} [Ring A] [Algebra ℝ A]
      (hA : isCentralSimple ℝ A) (m : ℕ) (hm : 2 ≤ m), BlockDensity hA m hm) ∧
  (∀ {A : Type v} [Ring A] [Algebra ℂ A]
      (hA : isCentralSimple ℂ A) (m : ℕ) (hm : 2 ≤ m), BlockDensity hA m hm)

/-- The same finite-place assertion expressed with completeness, discrete
rank-one valuation and finite residue field. -/
def CompleteDiscreteBlockGeneration : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [UniformSpace F] [IsUniformAddGroup F]
    [IsValuativeTopology F] [CompleteSpace F]
    [Finite (IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring)],
    Nonempty (ValuativeRel.ValueGroupWithZero F ≃*o ℤᵐ⁰) →
    ∀ {A : Type v} [Ring A] [Algebra F A] (hA : isCentralSimple F A)
      (m : ℕ) (hm : 2 ≤ m), BlockDensity hA m hm

/-- Over any field the ordinary elementary subgroup is the determinant-one group. -/
def SplitElementaryGeneration : Prop :=
  ∀ {F : Type u} [Field F] (n : ℕ), 2 ≤ n →
    (elementaryGroup (B := F) (Fin n) : Set (Matrix (Fin n) (Fin n) F)ˣ) =
      {x : (Matrix (Fin n) (Fin n) F)ˣ | Matrix.det (x : Matrix (Fin n) (Fin n) F) = 1}

/-- The block generators of a split coefficient algebra give exact generation. -/
def SplitBlockGeneration : Prop :=
  ∀ {F : Type u} [Field F] {A : Type v} [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) (m : ℕ) (hm : 2 ≤ m) {s : ℕ}, 0 < s →
    (A ≃ₐ[F] Matrix (Fin s) (Fin s) F) →
    (elementaryGroup (B := A) (Fin m) : Set (Matrix (Fin m) (Fin m) A)ˣ) =
      normOne (matrixCentralSimple hA (by omega : 0 < m))

end LinearAlgebraicGroups.Arithmetic.InnerTypeALocalGeneration.Spec
