import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ExceptionalAffineBruhat
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.LinearAlgebra.AffineSpace.Independent

/-! The Euclidean geometry of the marked exceptional alcoves. -/

namespace LinearAlgebraicGroups.Specs.ExceptionalRealAlcove

open Set
open scoped CategoryTheory.MonObj Classical Pointwise TensorProduct
open ExceptionalAffineRootSystems (ApartmentRoots AlcoveGeometry AlcoveCoxeterData)
open ExceptionalAffineBruhat

universe u v

noncomputable section

section Coxeter

variable {B W : Type*} [Group W]
  {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

/-- The standard subgroup of the ordinary affine Weyl group at a face of cotype `J`. -/
def standardWallSubgroup (J : Set B) : Subgroup W :=
  Subgroup.closure (cs.simple '' J)

end Coxeter

/-- Coordinates on a closed simplex, indexed by the walls opposite the vertices. -/
def Weights (B : Type*) :=
  { t : B → ℝ // (∀ i, 0 ≤ t i) ∧ ∑ᶠ i, t i = 1 }

def cotype {B : Type*} (t : Weights B) : Set B := {i | t.val i = 0}

section RealApartment

variable {V V' : Type u} [AddCommGroup V] [AddCommGroup V'] [Module ℚ V] [Module ℚ V']

abbrev EuclideanApartment (V : Type u) [AddCommGroup V] [Module ℚ V] :=
  EuclideanSpace ℝ (Fin (Module.finrank ℚ V))

abbrev RealCoordinates (V : Type u) [AddCommGroup V] [Module ℚ V] :=
  (ℝ ⊗[ℚ] V) ≃ₗ[ℝ] EuclideanApartment V

def rationalPoint (r : RealCoordinates V) (x : V) : EuclideanApartment V :=
  r (1 ⊗ₜ[ℚ] x)

/-- Scalar extension of a rational affine map of apartments. -/
def realAffine (r : RealCoordinates V) (r' : RealCoordinates V') (f : V ≃ᵃ[ℚ] V')
    (x : EuclideanApartment V) : EuclideanApartment V' :=
  r' (f.linear.toLinearMap.baseChange ℝ (r.symm x) + 1 ⊗ₜ[ℚ] f 0)

def realWallValue {J : Type v} (A : ApartmentRoots ℚ V J) (r : RealCoordinates V)
    (a : J × ℤ) (x : EuclideanApartment V) : ℝ :=
  (TensorProduct.AlgebraTensorModule.rid ℚ ℝ ℝ)
    ((A.root a.1).baseChange ℝ (r.symm x)) + a.2

def simplexPoint {B : Type*} (r : RealCoordinates V) (vertex : B → V)
    (t : Weights B) : EuclideanApartment V :=
  ∑ᶠ i, t.val i • rationalPoint r (vertex i)

/-- The weak positive-wall inequalities in the marked apartment. -/
def RealClosed {J : Type v} (A : ApartmentRoots ℚ V J) (p : V) (r : RealCoordinates V)
    (x : EuclideanApartment V) : Prop :=
  ∀ a, A.positive p a → 0 ≤ realWallValue A r a x

/-- The strict positive-wall inequalities in the marked apartment. -/
def RealOpen {J : Type v} (A : ApartmentRoots ℚ V J) (p : V) (r : RealCoordinates V)
    (x : EuclideanApartment V) : Prop :=
  ∀ a, A.positive p a → 0 < realWallValue A r a x

/-- The subgroup of the ordinary affine Weyl group generated by the walls through a point. -/
def wallReflectionGroup {J : Type v} (A : ApartmentRoots ℚ V J) (r : RealCoordinates V)
    (x : EuclideanApartment V) : Subgroup A.affineWeylGroup :=
  Subgroup.closure ((fun a : J × ℤ =>
    (⟨A.reflection a, Subgroup.subset_closure ⟨a, rfl⟩⟩ : A.affineWeylGroup)) ''
    {a | realWallValue A r a x = 0})

/-- A subdivision of a straight segment, with strictly ordered parameters,
chamber labels, endpoint weights and their Euclidean length. -/
inductive OrderedSubdivision {J : Type v} {A : ApartmentRoots ℚ V J} {p : V}
    (r : RealCoordinates V) (vertex : A.SimpleWall p → V) (x y : EuclideanApartment V) :
    ℝ → ℝ → ℝ → Prop
  | nil (s : ℝ) : OrderedSubdivision r vertex x y s s 0
  | cons {s m t l : ℝ} (hsm : s < m) (w : A.affineWeylGroup)
      (a b : Weights (A.SimpleWall p))
      (ha : realAffine r r w.val (simplexPoint r vertex a) = AffineMap.lineMap x y s)
      (hb : realAffine r r w.val (simplexPoint r vertex b) = AffineMap.lineMap x y m)
      (tail : OrderedSubdivision r vertex x y m t l) :
      OrderedSubdivision r vertex x y s t
        (dist (AffineMap.lineMap x y s) (AffineMap.lineMap x y m) + l)

end RealApartment

section MarkedAlcove

variable {V : Type u} {J : Type v} [AddCommGroup V] [Module ℚ V]
  {A : ApartmentRoots ℚ V J} {p : V}

/-- The rational vertices and their real realization in every linear coordinate system. -/
structure RealAlcoveData (d : AlcoveCoxeterData A p) where
  finiteWalls : Finite (A.SimpleWall p)
  vertex : A.SimpleWall p → V
  marked_vertex (i : A.SimpleWall p) : IsAlcoveVertex A p i (vertex i)
  vertex_unique (i : A.SimpleWall p) (x : V) : IsAlcoveVertex A p i x → x = vertex i
  affineIndependent (r : RealCoordinates V) :
    AffineIndependent ℝ (fun i => rationalPoint r (vertex i))
  opposite_pos (r : RealCoordinates V) (i : A.SimpleWall p) :
    0 < realWallValue A r i.val (rationalPoint r (vertex i))
  wall_weight (r : RealCoordinates V) (t : Weights (A.SimpleWall p)) (i : A.SimpleWall p) :
    realWallValue A r i.val (simplexPoint r vertex t) =
      realWallValue A r i.val (rationalPoint r (vertex i)) * t.val i
  closed_simplex (r : RealCoordinates V) (x : EuclideanApartment V) :
    RealClosed A p r x ↔ ∃ t : Weights (A.SimpleWall p), simplexPoint r vertex t = x
  open_simplex (r : RealCoordinates V) (x : EuclideanApartment V) :
    RealOpen A p r x ↔
      ∃ t : Weights (A.SimpleWall p), (∀ i, 0 < t.val i) ∧ simplexPoint r vertex t = x
  covers (r : RealCoordinates V) (x : EuclideanApartment V) :
    ∃ (w : A.affineWeylGroup) (t : Weights (A.SimpleWall p)),
      realAffine r r w.val (simplexPoint r vertex t) = x
  overlap (r : RealCoordinates V) (w v : A.affineWeylGroup) (t s : Weights (A.SimpleWall p)) :
    realAffine r r w.val (simplexPoint r vertex t) = realAffine r r v.val (simplexPoint r vertex s) ↔
      t = s ∧ w⁻¹ * v ∈ standardWallSubgroup d.coxeter (cotype s)
  wallSubgroup (r : RealCoordinates V) (t : Weights (A.SimpleWall p)) :
    standardWallSubgroup d.coxeter (cotype t) = wallReflectionGroup A r (simplexPoint r vertex t)
  translatedWallSubgroup (r : RealCoordinates V) (w : A.affineWeylGroup) (t : Weights (A.SimpleWall p)) :
    (standardWallSubgroup d.coxeter (cotype t)).map (MulAut.conj w).toMonoidHom =
      wallReflectionGroup A r (realAffine r r w.val (simplexPoint r vertex t))
  finiteFaceSubgroup (T : Set (A.SimpleWall p)) :
    T ≠ univ → Finite (standardWallSubgroup d.coxeter T)
  locallyFinite (r : RealCoordinates V) :
    LocallyFinite (fun a : J × ℤ => {x | realWallValue A r a x = 0})
  subdivision (r : RealCoordinates V) (x y : EuclideanApartment V) :
    OrderedSubdivision r vertex x y 0 1 (dist x y)

end MarkedAlcove

open Pinning (BasedRootDatum)
open IntegralSemisimpleModel (Model integerAlgebra)
attribute [local instance] integerAlgebra
open ExceptionalIwahoriImageComparison (MarkedCentralCover)

/-- Applies to the split comparison at the original field and at each of
its unramified levels with the same marked rational apartment. -/
def SplitRealAlcoves : Prop :=
  ∀ (K : Type u) [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    {D E : BasedRootDatum.{u}} {M : Model D} {M' : Model E}
    (c : MarkedCentralCover M M') (n : ℕ) (b : Fin n ≃ D.base.support) (b' : Fin n ≃ E.base.support),
    (n = 6 ∨ n = 7 ∨ n = 8) →
    ExceptionalNumbering D n b → ExceptionalNumbering E n b' →
    D.datum.corootSpan ℤ = ⊤ → E.datum.rootSpan ℤ = ⊤ →
    ∀ {p : ℚ ⊗[ℤ] D.Y} {p' : ℚ ⊗[ℤ] E.Y}
      (e : (ℚ ⊗[ℤ] D.Y) ≃ₗ[ℚ] (ℚ ⊗[ℤ] E.Y)) (L : SplitLevel K c p p' e),
      p' = e p → Nonempty (RealAlcoveData L.sc.coxeter) ∧ Nonempty (RealAlcoveData L.ad.coxeter)

/-- The marked folded comparison supplies the same normalized geometry for
either isogeny type, over the base field and at its unramified levels. -/
def RamifiedRealAlcoves : Prop :=
  ∀ {F L k K : Type u} [Field F] [Field L] [Field k] [Field K]
    [Algebra F L] [Algebra F k] [Algebra F K] [Algebra k K] [IsScalarTower F k K]
    [ValuativeRel k] [TopologicalSpace k] [IsNonarchimedeanLocalField k]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
    {D : BasedRootDatum.{u}} {M : Model D} (R : RamifiedReference F L M)
    (σ : Gal(L/F)) (σK : Gal(K/k)) (f : L →ₐ[F] K)
    (A : FoldedApartment (R.diagram σ)) (X : FoldedLevel R σ σK f A),
    Nonempty (RealAlcoveData X.comparison.coxeter)

end

end LinearAlgebraicGroups.Specs.ExceptionalRealAlcove
