import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.AnisotropicAdNilpotents
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.CompactProductIsolation
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ProjectiveRecurrence
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.SimplyConnectedLattice

open Set
open scoped Classical RestrictedProduct

set_option backward.isDefEq.respectTransparency false

universe u

namespace LinearAlgebraicGroups.Specs.ExceptionalAdelicApproximation

open LinearAlgebraicGroups.Arithmetic
open AdelicGroups ArithmeticLatticeProjection CompactProductIsolation
open IntegralModels (MatrixRealization)
open GeometricBorelConjugacy (IsQuasiSplit)
open GeometricRadicals (IsSplitReductive)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open AnisotropicAdNilpotents (IsAnisotropic)
open Specs.Arithmetic.RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open Specs.Arithmetic.ProjectiveRecurrence
  (localPointSet parabolicRadicalPoints cocharacterRadicalPoints)
open Specs.Arithmetic.OppositeRadicals (localPlus)
open Unipotent (baseChangedAlgebraicGroup)

noncomputable section

variable {K : Type u} [Field K] [NumberField K]

/-- The canonical places and completions of the number field. -/
abbrev numberPlaces (K : Type u) [Field K] [NumberField K] : GlobalFieldData.{u, u} K :=
  .number inferInstance

local instance numberCompletionField (w : NumberPlace K) :
    Field ((numberPlaces K).Completion w) :=
  GlobalFieldData.instFieldCompletion (numberPlaces K) w

local instance numberCompletionTopology (w : NumberPlace K) :
    TopologicalSpace ((numberPlaces K).Completion w) :=
  GlobalFieldData.instTopologicalSpaceCompletion (numberPlaces K) w

local instance numberCompletionAlgebra (w : NumberPlace K) :
    Algebra K ((numberPlaces K).Completion w) :=
  completionAlgebra (numberPlaces K) w

/-- The local inputs for the adelic application, taken at the actual completions. -/
structure CompletionHypotheses (G : AffineAlgebraicGroup K) (i : MatrixRealization G) : Prop where
  finiteQuasiSplit : ∀ w : (numberPlaces K).FinitePlace,
    IsQuasiSplit (baseChangedAlgebraicGroup ((numberPlaces K).Completion (.inl w)) G)
  complexSplit : ∀ w : NumberField.InfinitePlace K, w.IsComplex →
    IsSplitReductive (baseChangedAlgebraicGroup ((numberPlaces K).Completion (.inr w)) G)
  realConnected : ∀ w : NumberField.InfinitePlace K, w.IsReal →
    ConnectedSpace (LocalPoints (numberPlaces K) i (.inr w))
  realRadicalDensity : ∀ w : NumberField.InfinitePlace K, w.IsReal →
    ¬ CompactSpace (LocalPoints (numberPlaces K) i (.inr w)) →
    Dense (↑(Subgroup.closure (localPointSet (numberPlaces K) i (.inr w)
      (cocharacterRadicalPoints
        (baseChangedAlgebraicGroup ((numberPlaces K).Completion (.inr w)) G)))) :
      Set (LocalPoints (numberPlaces K) i (.inr w)))

/-- Compare the section and field-valued-point definitions of the local subgroup generated
by parabolic radicals. -/
def LocalPlusComparison : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G) (w : (numberPlaces K).Place),
    let D := numberPlaces K
    localPlus D i w =
      (Subgroup.closure (localPointSet D i w
        (parabolicRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G))) :
          Set (LocalPoints D i w))

/-- The local hypotheses give parabolic radical generation and density of the subgroups
generated by contracted elements wherever the assembly needs them. -/
def LocalGeneration : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    CompletionHypotheses G i →
    let D := numberPlaces K
    (∀ w : D.FinitePlace,
      localPlus D i (.inl w) = univ ∧
      Dense (↑(Subgroup.closure {x : LocalPoints D i (.inl w) | Contracted x}) :
        Set (LocalPoints D i (.inl w)))) ∧
    (∀ w : NumberField.InfinitePlace K, w.IsComplex ∨
      ¬ CompactSpace (LocalPoints D i (.inr w)) →
      Dense (localPlus D i (.inr w)) ∧
      Dense (↑(Subgroup.closure (localPointSet D i (.inr w)
        (cocharacterRadicalPoints (baseChangedAlgebraicGroup (D.Completion (.inr w)) G)))) :
          Set (LocalPoints D i (.inr w))) ∧
      Dense (↑(Subgroup.closure {x : LocalPoints D i (.inr w) | Contracted x}) :
        Set (LocalPoints D i (.inr w))))

/-- For a globally anisotropic group, the product of the noncompact archimedean
factors outside S embeds in the adelic diagonal closure. -/
def ArchimedeanIsolation : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    CompletionHypotheses G i → IsAnisotropic G.val →
    let D := numberPlaces K
    ∀ (S J : Finset D.Place), S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      (∀ v : D.Place, v ∈ J ↔ ∃ w : NumberField.InfinitePlace K,
        v = Sum.inr w ∧ v ∉ S ∧ ¬ CompactSpace (LocalPoints D i v)) →
      ∀ x : FinitePoints D i J, insertFinite D i S J x ∈ diagonalClosure D i S

/-- Once all outside archimedean factors are compact, every outside finite factor
embeds in the diagonal closure. -/
def FiniteIsolation : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    CompletionHypotheses G i → IsAnisotropic G.val →
    let D := numberPlaces K
    ∀ S : Finset D.Place, S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      (∀ w : D.InfinitePlace, Sum.inr w ∉ S → CompactSpace (LocalPoints D i (.inr w))) →
      ∀ (w : D.FinitePlace) (hw : Sum.inl w ∉ S) (x : LocalPoints D i (.inl w)),
        RestrictedProduct.mulSingle (fun v : Outside D S => localSubgroup D i v.1)
          ⟨Sum.inl w, hw⟩ x ∈ diagonalClosure D i S

/-- Weak approximation on the connected archimedean factors finishes the adelic
approximation once the finite factors have been isolated. -/
def WeakApproximationLifting : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    GeometricRadicals.IsSemisimple G →
    let D := numberPlaces K
    ∀ S : Finset D.Place,
      (∀ w : D.InfinitePlace, Sum.inr w ∉ S → ConnectedSpace (LocalPoints D i (.inr w))) →
      (∀ (w : D.FinitePlace) (hw : Sum.inl w ∉ S) (x : LocalPoints D i (.inl w)),
        RestrictedProduct.mulSingle (fun v : Outside D S => localSubgroup D i v.1)
          ⟨Sum.inl w, hw⟩ x ∈ diagonalClosure D i S) →
      StrongApproximation D i S

/-- Strong approximation outside every finite nonempty S with noncompact G_S
for a globally isotropic group under the given local hypotheses. -/
def IsotropicStrongApproximation : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    CompletionHypotheses G i → ¬ IsAnisotropic G.val →
    let D := numberPlaces K
    ∀ S : Finset D.Place, S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      StrongApproximation D i S

/-- Strong approximation outside every finite nonempty S with noncompact G_S
for a globally anisotropic group under the given local hypotheses. The adelic
topology includes every compact real factor outside S. -/
def AnisotropicStrongApproximation : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K]
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    CompletionHypotheses G i → IsAnisotropic G.val →
    let D := numberPlaces K
    ∀ S : Finset D.Place, S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      StrongApproximation D i S

end

end LinearAlgebraicGroups.Specs.ExceptionalAdelicApproximation
