import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.SimpleRoots
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Relative.RelativeWeylScheme
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.SimplyConnectedLattice

open Set
open RootPairing

universe u v w z

namespace LinearAlgebraicGroups.Specs.Arithmetic.QuasiSplitFixedWeyl

section RootPairing

variable {Idx : Type u} {X : Type v} {Y : Type w}
  [AddCommGroup X] [AddCommGroup Y] (P : RootPairing Idx ℤ X Y)

noncomputable section

/-- The standard parabolic Weyl subgroup for a subset of the simple roots. -/
def parabolicWeyl (I : Set Idx) : Subgroup P.weylGroup :=
  Subgroup.closure (weylGroup.ofIdx P '' I)

/-- A longest element is a member of maximum simple-reflection length. -/
def IsLongest (b : P.Base) (I : Set Idx) (w : P.weylGroup) : Prop :=
  w ∈ parabolicWeyl P I ∧
    ∀ x ∈ parabolicWeyl P I, SimpleRoots.wordLength P b x ≤ SimpleRoots.wordLength P b w

variable {Γ : Type z} [Group Γ]

/-- The subgroup fixed under conjugation by the root datum automorphisms. -/
def fixedWeyl (ρ : Γ →* P.Aut) : Subgroup P.weylGroup where
  carrier := {w | ∀ γ, Commute (ρ γ) w.val}
  one_mem' _ := Commute.one_right _
  mul_mem' hw hv γ := (hw γ).mul_right (hv γ)
  inv_mem' hw γ := (hw γ).inv_right

/-- The orbit of a simple root under the specified action on the root datum. -/
def rootOrbit (ρ : Γ →* P.Aut) (i : Idx) : Set Idx :=
  Set.range (fun γ ↦ (ρ γ).indexEquiv i)

end

/-- Each standard parabolic Weyl subgroup has a unique longest element. -/
def LongestElements : Prop :=
  ∀ {Idx : Type u} {X : Type v} {Y : Type w} [Finite Idx]
    [AddCommGroup X] [AddCommGroup Y] (P : RootPairing Idx ℤ X Y) [P.IsReduced]
    (f : X →ₗ[ℤ] ℤ), (∀ i, f (P.root i) ≠ 0) →
    ∀ (b : P.Base), SimpleRoots.IsBaseFor P f b →
      ∀ I : Set Idx, I ⊆ b.support → ∃! a, IsLongest P b I a

/-- Under a based action the fixed Weyl group is generated by the longest
elements attached to the orbits of simple roots. -/
def OrbitGeneration : Prop :=
  ∀ {Idx : Type u} {X : Type v} {Y : Type w} {Γ : Type z}
    [Finite Idx] [AddCommGroup X] [AddCommGroup Y] [Group Γ]
    (P : RootPairing Idx ℤ X Y) [P.IsReduced]
    (f : X →ₗ[ℤ] ℤ), (∀ i, f (P.root i) ≠ 0) →
    ∀ (b : P.Base), SimpleRoots.IsBaseFor P f b →
    ∀ (ρ : Γ →* P.Aut),
      (∀ γ i, (ρ γ).indexEquiv i ∈ b.support ↔ i ∈ b.support) →
      Subgroup.closure
        {a | ∃ i ∈ b.support, IsLongest P b (rootOrbit P ρ i) a} =
        fixedWeyl P ρ

end RootPairing

/-- A rational Borel of a reductive group is minimal among rational parabolics. -/
def BorelIsMinimalParabolic : Prop :=
  ∀ {F : Type u} [Field F] (G : AffineAlgebraicGroup F), GeometricRadicals.IsReductive G →
    ∀ B : ClosedSubgroup G.val, GeometricBorelConjugacy.IsKBorel B →
      Relative.MaximalSplitTori.IsMinimalParabolic G B


open AlgebraicGeometry CategoryTheory
open GeometricBorelConjugacy (subgroupOfSubgroup IsKBorel)
open GeometricRadicals (IsReductive IsTorus IsSplitTorus)
open RankOneFlag (IsGeometricallyMaximal)
open SchemeDerivedGroup (IsSubgroupOf)
open Relative.MaximalSplitTori (IsMaximalSplitTorus IsMinimalParabolic)

/-- A largest split subtorus contains every split subtorus of the torus. -/
def IsLargestSplitSubtorus {F : Type u} [Field F] {T : GroupScheme F}
    (S : ClosedSubgroup T) : Prop :=
  IsSplitTorus S.group ∧
    ∀ S' : ClosedSubgroup T, IsSplitTorus S'.group → IsSubgroupOf S' S

/-- Every torus has a largest split subtorus, including an anisotropic torus. -/
def LargestSplitSubtorusExists : Prop :=
  ∀ {F : Type u} [Field F] (T : AffineAlgebraicGroup F), IsTorus T.val →
    ∃ S : ClosedSubgroup T.val, IsLargestSplitSubtorus S

/-- The maximal torus of a rational Borel is cut out by centralizing a
cocharacter defined over the ground field. -/
def BorelTorusCentralizer : Prop :=
  ∀ {F : Type u} [Field F] (G : AffineAlgebraicGroup F), IsReductive G →
    ∀ (B T : ClosedSubgroup G.val), IsKBorel B → IsTorus T.group →
      IsGeometricallyMaximal T → IsSubgroupOf T B →
      ∃ c : CharacterDescent.Cocharacter T.group,
        RepresentsSubgroup T (fun _ g ↦ Centralizes (c ≫ T.inclusion) g)

/-- The largest split subtorus of the Borel torus is maximal split in the
ambient group and has scheme centralizer equal to the given torus. -/
def QuasiSplitCentralizer : Prop :=
  ∀ {F : Type u} [Field F] (G : AffineAlgebraicGroup F), IsReductive G →
    ∀ (B T : ClosedSubgroup G.val), IsKBorel B → IsTorus T.group →
      IsGeometricallyMaximal T → IsSubgroupOf T B →
      ∃ S : ClosedSubgroup T.group, IsLargestSplitSubtorus S ∧
        IsMaximalSplitTorus (subgroupOfSubgroup T S) ∧
        RepresentsSubgroup T (fun _ g ↦ Centralizes (subgroupOfSubgroup T S).inclusion g) ∧
        IsMinimalParabolic G B ∧ IsSubgroupOf (subgroupOfSubgroup T S) B

open CategoryTheory.Limits
open scoped CategoryTheory.MonoidalCategory CategoryTheory.MonObj
open AbstractPairing (Datum)
open GeometricRadicals (IsSemisimple)
open CharacterDescent (Character Cocharacter)
open DiagonalizableGroups (groupAlgebra IntegerCharacters)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Unipotent (baseChangedAlgebraicGroup)
open UnipotentRadicalIntersection (IsSchemeIntersection)
open Relative.RelativeWeylScheme (QuotientData rationalProjection)
open LinearAlgebraicGroups.CocharacterDynamics (unitPoint)

noncomputable section

variable {F K : Type u} [Field F] [Field K] [Algebra F K]

/-- A scalar field automorphism acts contravariantly on its spectrum. -/
abbrev scalarMap (σ : Gal(K/F)) :
    Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of K) :=
  Spec.map (CommRingCat.ofHom σ.toRingHom)

theorem scalarMap_over (σ : Gal(K/F)) : scalarMap σ ≫ fieldSpecMap F K = fieldSpecMap F K := by
  rw [← Spec.map_comp]
  congr 1
  ext x
  exact σ.commutes x

/-- The underlying semilinear scheme map on a scalar extension is the
identity over the ground-field scheme and the indicated scalar map on the
base. -/
def scalarTransport (σ : Gal(K/F)) (X : SchemeOver F) :
    ((baseChange F K).obj X).left ⟶ ((baseChange F K).obj X).left :=
  pullback.lift (pullback.fst X.hom (fieldSpecMap F K))
    (pullback.snd X.hom (fieldSpecMap F K) ≫ scalarMap σ) (by
      rw [Category.assoc, scalarMap_over, pullback.condition])

/-- The group of units, in the same presentation used for characters. -/
abbrev multiplicativeGroup (F : Type u) [Field F] : GroupScheme F :=
  specGroup (groupAlgebra F IntegerCharacters.{u})

/-- Scalar extension on the multiplicative group preserves the canonical
unit coordinate on every test algebra. -/
def IsUnitComparison
    (e : multiplicativeGroup K ≅ (groupBaseChange F K).obj (multiplicativeGroup F)) : Prop :=
  ∀ (R : TestAlgebra K) (a : Rˣ),
    baseChangePoint F K (multiplicativeGroup F).X R (unitPoint R a ≫ e.hom.hom.hom) =
      unitPoint ((restrictTestAlgebra F K).obj R) a

set_option backward.isDefEq.respectTransparency false in
/-- The action on the base-changed torus is the action on the actual
character and cocharacter morphisms induced by changing scalars. -/
def IsScalarAction {G : AffineAlgebraicGroup F} (T : ClosedSubgroup G.val)
    (hT : IsClosedImmersion ((groupBaseChange F K).map T.inclusion).hom.hom.left)
    (comm : IsCommMonObj (GeometricRadicals.baseChangedSubgroup K T hT).group.X)
    (D : @Datum K _ (baseChangedAlgebraicGroup K G) (GeometricRadicals.baseChangedSubgroup K T hT) comm)
    (e : multiplicativeGroup K ≅ (groupBaseChange F K).obj (multiplicativeGroup F))
    (ρ : Gal(K/F) →* D.rootDatum.Aut) : Prop :=
    letI := comm
    (∀ (σ : Gal(K/F)) (χ : Character ((groupBaseChange F K).obj T.group)),
      ((show Character ((groupBaseChange F K).obj T.group) from
          Additive.toMul ((ρ σ).weightEquiv (Additive.ofMul χ))) ≫ e.hom).hom.hom.left =
        scalarTransport σ T.group.X ≫ (χ ≫ e.hom).hom.hom.left ≫
          scalarTransport σ⁻¹ (multiplicativeGroup F).X) ∧
    (∀ (σ : Gal(K/F)) (c : Cocharacter ((groupBaseChange F K).obj T.group)),
      (e.inv ≫ (show Cocharacter ((groupBaseChange F K).obj T.group) from
          Additive.toMul ((ρ σ).coweightEquiv.symm (Additive.ofMul c)))).hom.hom.left =
        scalarTransport σ (multiplicativeGroup F).X ≫ (e.inv ≫ c).hom.hom.left ≫
          scalarTransport σ⁻¹ T.group.X)

/-- The Borel torus can be split over a finite Galois extension. -/
def FiniteGaloisTorusSplitting : Prop :=
  ∀ {F : Type u} [Field F] (T : AffineAlgebraicGroup F), IsTorus T.val →
    ∃ (K : Type u) (_ : Field K) (_ : Algebra F K) (_ : FiniteDimensional F K) (_ : IsGalois F K),
      IsSplitTorus ((groupBaseChange F K).obj T.val)

/-- The normalizer of a subgroup normalizes its scheme centralizer. -/
def NormalizesCentralizer : Prop :=
  ∀ {F : Type u} [Field F] {G : GroupScheme F} (S C : ClosedSubgroup G),
    RepresentsSubgroup C (fun _ g ↦ Centralizes S.inclusion g) →
    ∀ (Y : SchemeOver F) (g : Y ⟶ G.X), Normalizes S.inclusion g → Normalizes C.inclusion g

/-- The relative labels inject into the absolute Weyl group by scalar
extension of a rational representative. -/
def RelativeWeylEmbedding : Prop :=
  ∀ {F K : Type u} [Field F] [Field K] [Algebra F K]
    (G : AffineAlgebraicGroup F), IsReductive G →
    ∀ (S P T : ClosedSubgroup G.val),
    IsMaximalSplitTorus S → IsMinimalParabolic G P → IsSubgroupOf S P →
    RepresentsSubgroup T (fun _ g ↦ Centralizes S.inclusion g) →
    ∀ (Q : QuotientData S)
      (hTK : IsClosedImmersion ((groupBaseChange F K).map T.inclusion).hom.hom.left),
      let TK := GeometricRadicals.baseChangedSubgroup K T hTK
      ∀ (comm : IsCommMonObj TK.group.X), letI := comm
        ∀ (D : Datum (G := baseChangedAlgebraicGroup K G) TK)
          (A : DatumAndWeyl.Identification D),
          ∃ e : Q.splitImage.labels →* D.rootDatum.weylGroup, Function.Injective e ∧
            ∀ (n : 𝟙_ (SchemeOver F) ⟶ Q.normalizer.group.X) (w : Q.splitImage.labels),
              rationalProjection Q n = Q.splitImage.constantGroup.sectionPoint w →
              ∃ r : 𝟙_ (SchemeOver K) ⟶ A.normalizer.group.X,
                r ≫ A.normalizer.inclusion.hom.hom =
                  scalarExtendedRationalPoint K (n ≫ Q.normalizer.inclusion.hom.hom) ∧
                r ≫ A.quotient.hom.hom = A.image.constantGroup.sectionPoint (A.labelEquiv (e w))

/-- The isomorphism uses the actual normalizer quotient of the largest split
subtorus and the actual absolute normalizer quotient of the Borel torus. -/
def Statement : Prop :=
  ∀ {F : Type u} [Field F] (G : AffineAlgebraicGroup F), IsSemisimple G →
    GeometricallySimplyConnected G →
    ∀ (Bpos Bneg T : ClosedSubgroup G.val), IsKBorel Bpos → IsKBorel Bneg →
      IsTorus T.group → IsGeometricallyMaximal T → IsSchemeIntersection {Bpos, Bneg} T →
      ∃ S : ClosedSubgroup T.group, IsLargestSplitSubtorus S ∧
        let S₀ := subgroupOfSubgroup T S
        IsMaximalSplitTorus S₀ ∧ RepresentsSubgroup T (fun _ g ↦ Centralizes S₀.inclusion g) ∧
        IsMinimalParabolic G Bpos ∧ IsSubgroupOf S₀ Bpos ∧
        ∃ (K : Type u) (_ : Field K) (_ : Algebra F K)
          (_ : FiniteDimensional F K) (_ : IsGalois F K)
          (hT : IsClosedImmersion ((groupBaseChange F K).map T.inclusion).hom.hom.left)
          (hB : IsClosedImmersion ((groupBaseChange F K).map Bpos.inclusion).hom.hom.left),
          let GK := baseChangedAlgebraicGroup K G
          let TK : ClosedSubgroup GK.val := GeometricRadicals.baseChangedSubgroup K T hT
          let BK : ClosedSubgroup GK.val := GeometricRadicals.baseChangedSubgroup K Bpos hB
          IsSplitTorus TK.group ∧
          ∃ (comm : IsCommMonObj TK.group.X), letI := comm
            ∃ (D : Datum (G := GK) TK) (A : DatumAndWeyl.Identification D)
              (c : Cocharacter TK.group) (b : D.rootDatum.Base)
              (ρ : Gal(K/F) →* D.rootDatum.Aut)
              (t : multiplicativeGroup K ≅ (groupBaseChange F K).obj (multiplicativeGroup F)),
              IsUnitComparison t ∧ IsScalarAction T hT comm D t ρ ∧
              (∀ i, (SimpleRoots.evaluate D c) (D.rootDatum.root i) ≠ 0) ∧
              SimpleRoots.IsBaseFor D.rootDatum (SimpleRoots.evaluate D c) b ∧
              SimpleRoots.positive D.rootDatum (SimpleRoots.evaluate D c) =
                BorelsAndChambers.subgroupRoots TK BK ∧
              (∀ σ i, (ρ σ).indexEquiv i ∈ b.support ↔ i ∈ b.support) ∧
              ∃ (Q : QuotientData S₀) (e : Q.splitImage.labels ≃* fixedWeyl D.rootDatum ρ),
                RankOneFlag.SameSubgroup Q.centralizer T ∧
                (∀ w, ∃ n, rationalProjection Q n = Q.splitImage.constantGroup.sectionPoint w) ∧
                (∀ (n : 𝟙_ (SchemeOver F) ⟶ Q.normalizer.group.X) (w : Q.splitImage.labels),
                  rationalProjection Q n = Q.splitImage.constantGroup.sectionPoint w →
                  ∃ r : 𝟙_ (SchemeOver K) ⟶ A.normalizer.group.X,
                    r ≫ A.normalizer.inclusion.hom.hom =
                      scalarExtendedRationalPoint K (n ≫ Q.normalizer.inclusion.hom.hom) ∧
                    r ≫ A.quotient.hom.hom = A.image.constantGroup.sectionPoint (A.labelEquiv (e w).val)) ∧
                Subgroup.closure {w | ∃ i ∈ b.support,
                  IsLongest D.rootDatum b (rootOrbit D.rootDatum ρ i) (e w).val} = ⊤

end

end LinearAlgebraicGroups.Specs.Arithmetic.QuasiSplitFixedWeyl
