import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.AbsoluteDynkinTypes
import MathGenome.Internal.LieAlgebrasAndRepresentations.Specs.LieAlgebrasAndRepresentations.ExceptionalCoordinateGF

noncomputable section

set_option autoImplicit false

open LieAlgebrasAndRepresentations
open scoped BigOperators

namespace LinearAlgebraicGroups.Specs.ExceptionalFoldedWeyl

open AbsoluteDynkinTypes (CartanRoots E6Reflection)

/-- The real cocharacter space in the simple-coroot basis, in Bourbaki numbering. -/
abbrev E6Space := Fin 6 → ℝ

def e6Diagram (x : E6Space) : E6Space := fun j => x (E6Reflection j)

def foldedSpace : Set E6Space := {x | e6Diagram x = x}

def project (x : E6Space) : E6Space := (1 / 2 : ℝ) • (x + e6Diagram x)

def e6Inner (x y : E6Space) : ℝ :=
  ∑ i, ∑ j, x i * (CartanMatrix.E 6 i j : ℝ) * y j

def e6Roots : Set E6Space :=
  {v | ∃ p : (Fin 6 → ℤ) × (Fin 6 → ℤ),
    CartanRoots (CartanMatrix.E 6) p ∧ v = fun j => (p.2 j : ℝ)}

def foldedRoots : Set E6Space := project '' e6Roots

def foldedSimple (i : Fin 4) : E6Space :=
  project (Pi.single (![0, 2, 3, 1] i : Fin 6) 1)

def e6Lattice : Set E6Space :=
  Set.range (fun z : Fin 6 → ℤ => fun j => (z j : ℝ))

def projectedLattice : Set E6Space := project '' e6Lattice

def foldedCoroot (β : E6Space) : E6Space := (2 / e6Inner β β) • β

def reflection (β : E6Space) : Function.End E6Space :=
  fun x => x - e6Inner β x • foldedCoroot β

/-- In either case these are the integral wall equations for the dual folded system. -/
def OnWall (β x : E6Space) : Prop :=
  ∃ m : ℤ, e6Inner (foldedCoroot β) x = (m : ℝ)

def e6Weyl : Submonoid (Function.End E6Space) :=
  Submonoid.closure (Set.range fun j : Fin 6 => reflection (Pi.single j 1))

def wallReflections (x : E6Space) : Submonoid (Function.End E6Space) :=
  Submonoid.closure (reflection '' {β ∈ foldedRoots | OnWall β x})

/-- The roots of the dual folded system are the folded coroots. -/
def dualFoldedRoots : Set E6Space := foldedCoroot '' foldedRoots

/-- The lattice generated by the coroots of the dual folded system. -/
def dualCorootLattice : AddSubgroup E6Space :=
  AddSubgroup.closure (foldedCoroot '' dualFoldedRoots)

/-- The four orbit products in the order of the Bourbaki orbits
{1,6}, {3,5}, {4}, {2}. -/
def orbitReflection (i : Fin 4) : Function.End E6Space :=
  let s (j : Fin 6) := reflection (Pi.single j 1)
  (![s 0 * s 5, s 2 * s 4, s 3, s 1] : Fin 4 → Function.End E6Space) i

def foldedWeyl : Submonoid (Function.End E6Space) :=
  Submonoid.closure (reflection '' foldedRoots)

def diagramCentralizingWeyl : Set (Function.End E6Space) :=
  {w ∈ e6Weyl | Function.Commute w e6Diagram}

/-- The Cartan averaging projector takes values in the fixed space, acts there
as the identity, and preserves evaluation on that space. -/
def ProjectionCalculation : Prop :=
  (∀ x, project x ∈ foldedSpace) ∧
  (∀ x ∈ foldedSpace, project x = x) ∧
  (∀ a x, x ∈ foldedSpace → e6Inner (project a) x = e6Inner a x)

/-- The projected roots with their normalized metric, fibres, and dual coroot lattice. -/
def FoldedRootCalculation : Prop :=
  (∃ f : E6Space →ₗ[ℝ] ExceptionalGF.Space 4,
    (∀ x ∈ foldedSpace, ∀ y ∈ foldedSpace, inner ℝ (f x) (f y) = e6Inner x y) ∧
    Set.BijOn f foldedSpace Set.univ ∧
    f '' foldedRoots = ExceptionalGF.f4Roots ∧
    ∀ i : Fin 4, f (foldedSimple i) = ExceptionalGF.f4Simple (Fin.rev i)) ∧
  (∀ β ∈ foldedRoots,
    (e6Inner β β = 2 ∧ {α ∈ e6Roots | project α = β} = {β} ∧
      e6Diagram β = β ∧
      (∀ x, OnWall β x ↔ ∃ m : ℤ, e6Inner β x = (m : ℝ))) ∨
    (e6Inner β β = 1 ∧
      ∃ α ∈ e6Roots, α ≠ e6Diagram α ∧ e6Inner α (e6Diagram α) = 0 ∧
        {a ∈ e6Roots | project a = β} = {α, e6Diagram α} ∧
        (∀ x, OnWall β x ↔ ∃ m : ℤ, 2 * e6Inner β x = (m : ℝ)))) ∧
  projectedLattice = (AddSubgroup.closure foldedRoots : Set E6Space) ∧
  projectedLattice = (dualCorootLattice : Set E6Space)

/-- The diagram centralizer is generated by the simple orbit products.
Restriction gives the folded Weyl action and determines an absolute Weyl
element in this centralizer uniquely. -/
def FoldedWeylCalculation : Prop :=
  diagramCentralizingWeyl = (Submonoid.closure (Set.range orbitReflection) :
    Set (Function.End E6Space)) ∧
  (∀ i, Set.EqOn (orbitReflection i) (reflection (foldedSimple i)) foldedSpace) ∧
  (∀ w ∈ diagramCentralizingWeyl, Set.MapsTo w foldedSpace foldedSpace) ∧
  (∀ u ∈ diagramCentralizingWeyl, ∀ v ∈ diagramCentralizingWeyl,
    Set.EqOn u v foldedSpace → u = v) ∧
  (∀ w ∈ diagramCentralizingWeyl, ∃ r ∈ foldedWeyl, Set.EqOn w r foldedSpace) ∧
  (∀ r ∈ foldedWeyl, ∃ w ∈ diagramCentralizingWeyl, Set.EqOn w r foldedSpace)

/-- The simple-root values at twice the compact logarithm are integral
exactly when that vector lies in the absolute coroot lattice. In the compact
application they are integral because the square of the toral twist acts
trivially on the simple root subgroups. -/
def InvolutionRange : Prop :=
  ∀ x ∈ foldedSpace, (2 : ℝ) • x ∈ e6Lattice ↔
    ∀ j : Fin 6, ∃ m : ℤ, e6Inner (Pi.single j 1) ((2 : ℝ) • x) = (m : ℝ)

/-- The stabilizer of the class of a compact involution logarithm is exactly
the monoid of restrictions generated by the reflections in walls through it. -/
def WallStabilizer : Prop :=
  ∀ x ∈ foldedSpace, (2 : ℝ) • x ∈ e6Lattice →
    ∀ w ∈ diagramCentralizingWeyl,
      w x - x ∈ projectedLattice ↔
        ∃ r ∈ wallReflections x, Set.EqOn w r foldedSpace

end LinearAlgebraicGroups.Specs.ExceptionalFoldedWeyl
