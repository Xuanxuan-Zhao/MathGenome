import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.CompactProductIsolation
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OuterTypeAModels
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.RelativeRootIrreducibility
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.SimplyConnectedLattice

open scoped Classical

universe u v

namespace LinearAlgebraicGroups.Specs.Arithmetic.DivisionNormOneFiniteSplitFactors

open _root_.LinearAlgebraicGroups.Arithmetic (GlobalFieldData)
open _root_.LinearAlgebraicGroups.Arithmetic.ArithmeticLatticeProjection (FinitePoints)
open _root_.LinearAlgebraicGroups.Arithmetic.CompactProductIsolation (Contracted)
open _root_.Specs.RM03.CSA (isCentralSimple)
open GeometricRadicals (IsSplitReductive)
open IntegralModels (MatrixRealization)
open OuterTypeAModels (RepresentsNormOne)
open RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Unipotent (baseChangedAlgebraicGroup)

/-- Away from a finite set of finite places, the norm-one group of a central
division algebra is split reductive and geometrically simply connected. Its
local points are densely generated by contracted elements in every closed
matrix realization. -/
def Statement : Prop :=
  ∀ {K A : Type u} [Field K] (D : GlobalFieldData.{u, v} K)
    [DivisionRing A] [Algebra K A] (hA : isCentralSimple K A),
    ∀ {I : Type u} [Fintype I] (b : Module.Basis I K A) (G : AffineAlgebraicGroup K),
      IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
      RepresentsNormOne hA b G →
      ∃ E : Finset D.FinitePlace, ∀ w : D.FinitePlace, w ∉ E →
        let L := baseChangedAlgebraicGroup (D.Completion (.inl w)) G
        IsSplitReductive L ∧ GeometricallySimplyConnected L ∧
          ∀ i : MatrixRealization G,
            Dense (Subgroup.closure {x : FinitePoints D i {Sum.inl w} | Contracted x} :
              Set (FinitePoints D i {Sum.inl w}))

end LinearAlgebraicGroups.Specs.Arithmetic.DivisionNormOneFiniteSplitFactors
