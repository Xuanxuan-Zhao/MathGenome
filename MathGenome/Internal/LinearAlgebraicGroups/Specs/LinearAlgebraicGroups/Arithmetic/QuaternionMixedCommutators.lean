import MathGenome.Internal.RingModuleAssociativeAlgebra.Specs.RM03.CSA.ReducedNorm
import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Topology.Algebra.Module.ModuleTopology
import Mathlib.LinearAlgebra.Complex.FiniteDimensional

namespace LinearAlgebraicGroups.Arithmetic.QuaternionMixedCommutators

open _root_.Specs.RM03.CSA
open scoped commutatorElement

universe u v w

/-- The subgroup generated by commutators with second entry in the fixed subfield. -/
def mixedSubgroup {F : Type u} [Field F] {B : Type v} [DivisionRing B] [Algebra F B]
    {E : Type w} [Field E] [Algebra F E] (i : E →ₐ[F] B) : Subgroup Bˣ :=
  Subgroup.closure {x | ∃ (a : Bˣ) (b : Eˣ), x = ⁅a, Units.map i.toMonoidHom b⁆}

/-- The norm-one units of the central division algebra. -/
def normOne {F : Type u} [Field F] {B : Type v} [DivisionRing B] [Algebra F B]
    (hB : isCentralSimple F B) : Set Bˣ :=
  {x | reducedNorm hB (x : B) = 1}

/-- The unit group carries the subspace topology from the finite-dimensional algebra. -/
abbrev unitsTopology (F : Type u) [Field F] [TopologicalSpace F]
    (B : Type v) [DivisionRing B] [Algebra F B] : TopologicalSpace Bˣ :=
  TopologicalSpace.induced (Units.val : Bˣ → B) (moduleTopology F B)

/-- Over a nonarchimedean local field, the mixed commutators generate a
normal subgroup dense in the norm-one group. -/
def NonarchimedeanMixedCommutators : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {B : Type v} [DivisionRing B] [Algebra F B]
    (hB : isCentralSimple F B) (_ : degree F B = 2)
    {E : Type w} [Field E] [Algebra F E] [Algebra.IsSeparable F E]
    (i : E →ₐ[F] B) (_ : Module.finrank F E = 2),
    letI := unitsTopology F B
    (mixedSubgroup i).Normal ∧ closure (mixedSubgroup i : Set Bˣ) = normOne hB

/-- Over the reals, the subgroup for any fixed complex subfield is normal
and equals the norm-one group, so its closure also equals the norm-one group. -/
def RealMixedCommutators : Prop :=
  ∀ {B : Type v} [DivisionRing B] [Algebra ℝ B]
    (hB : isCentralSimple ℝ B) (_ : degree ℝ B = 2) (i : ℂ →ₐ[ℝ] B),
    letI := unitsTopology ℝ B
    (mixedSubgroup i).Normal ∧
      (mixedSubgroup i : Set Bˣ) = normOne hB ∧
      closure (mixedSubgroup i : Set Bˣ) = normOne hB

end LinearAlgebraicGroups.Arithmetic.QuaternionMixedCommutators
