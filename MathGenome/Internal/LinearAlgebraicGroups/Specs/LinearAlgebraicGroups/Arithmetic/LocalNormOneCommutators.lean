import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.LocalDivisionAlgebras
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.AdditiveStrongApproximation
import Mathlib.Topology.Algebra.Group.Units
import Mathlib.Analysis.Complex.Basic
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.LinearAlgebra.Matrix.StdBasis

noncomputable section

open scoped TensorProduct WithZero commutatorElement

namespace LinearAlgebraicGroups.Arithmetic.LocalNormOneCommutators

universe u v w

namespace Spec

open _root_.Specs.RM03.CSA

/-- The finite-dimensional vector-space topology, expressed in the coordinates of a basis. -/
abbrev coordinateTopology {F A ι : Type*} [Field F] [TopologicalSpace F]
    [AddCommGroup A] [Module F A] [Finite ι] (b : Module.Basis ι F A) : TopologicalSpace A :=
  TopologicalSpace.induced (fun x i => b.repr x i) inferInstance

/-- Norm-one units of the given central simple algebra. -/
def normOne {F A : Type*} [Field F] [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) : Set Aˣ := { x | reducedNorm hA (x : A) = 1 }

/-- A finite product of multiplicative commutators, in the indicated order. -/
def commutatorWord {G : Type*} [Group G] (L : List (G × G)) : G :=
  (L.map fun p => ⁅p.1, p.2⁆).prod

/-- One local approximation statement, in the finite-dimensional topology on the units. -/
def denseCommutators {F A : Type*} [Field F] [TopologicalSpace F] [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) : Prop :=
  ∀ b : Module.Basis (Fin (Module.finrank F A)) F A,
    letI := coordinateTopology b
    normOne hA ⊆ closure (commutator Aˣ : Set Aˣ)

def NonarchimedeanDivision : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {B : Type v} [DivisionRing B] [Algebra F B]
    (hB : isCentralSimple F B), denseCommutators hB

/-- The real assertion is algebraic. Every norm-one unit is an actual commutator. -/
def RealDivision : Prop :=
  ∀ {B : Type v} [DivisionRing B] [Algebra ℝ B] (hB : isCentralSimple ℝ B)
    (x : Bˣ), x ∈ normOne hB → ∃ a b : Bˣ, ⁅a, b⁆ = x

/-- The complex division case has trivial reduced-norm kernel. -/
def ComplexDivision : Prop :=
  ∀ {B : Type v} [DivisionRing B] [Algebra ℂ B] (hB : isCentralSimple ℂ B)
    (x : Bˣ), x ∈ normOne hB → x = 1

/-- The elementary unit with off-diagonal entry `a`; its inverse has entry `-a`. -/
def elementary {B ι : Type*} [Ring B] [Fintype ι] [DecidableEq ι]
    (i j : ι) (hij : i ≠ j) (a : B) : (Matrix ι ι B)ˣ where
  val := 1 + Matrix.single i j a
  inv := 1 + Matrix.single i j (-a)
  val_inv := by
    simp [add_mul, mul_add, Matrix.single_mul_single_of_ne _ i j i hij.symm,
      add_assoc, ← Matrix.single_add]
  inv_val := by
    simp [add_mul, mul_add, Matrix.single_mul_single_of_ne _ i j i hij.symm,
      add_assoc, ← Matrix.single_add]

/-- The subgroup generated by all elementary transvections over the division factor. -/
def elementaryGroup {B : Type*} [Ring B] (ι : Type*) [Fintype ι] [DecidableEq ι] :
    Subgroup (Matrix ι ι B)ˣ :=
  Subgroup.closure { e | ∃ (i j : ι) (hij : i ≠ j) (a : B), e = elementary i j hij a }

/-- Passage from a division algebra to matrices. The elementary density conclusion uses
two distinct coordinates, while commutator density also includes the one-coordinate case. -/
def MatrixTransfer : Prop :=
  ∀ {F : Type u} [Field F] [TopologicalSpace F] [IsTopologicalDivisionRing F] [Infinite F]
    {B : Type v} [DivisionRing B] [Algebra F B]
    (hB : isCentralSimple F B), denseCommutators hB →
    ∀ (m : ℕ), 0 < m →
      ∀ (hA : isCentralSimple F (Matrix (Fin m) (Fin m) B)),
        denseCommutators hA ∧
        (2 ≤ m →
          (elementaryGroup (B := B) (Fin m) : Set (Matrix (Fin m) (Fin m) B)ˣ) ⊆ normOne hA ∧
          ∀ b : Module.Basis (Fin (Module.finrank F (Matrix (Fin m) (Fin m) B)))
              F (Matrix (Fin m) (Fin m) B),
            letI := coordinateTopology b
            normOne hA ⊆ closure (elementaryGroup (B := B) (Fin m) : Set (Matrix (Fin m) (Fin m) B)ˣ))

/-- The local commutator closure contains the reduced-norm-one group of every central
simple algebra over a nonarchimedean local field, the reals, or the complex numbers. -/
def LocalAlgebras : Prop :=
  (∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] {A : Type v} [Ring A] [Algebra F A]
      (hA : isCentralSimple F A), denseCommutators hA) ∧
  (∀ {A : Type v} [Ring A] [Algebra ℝ A]
      (hA : isCentralSimple ℝ A), denseCommutators hA) ∧
  (∀ {A : Type v} [Ring A] [Algebra ℂ A]
      (hA : isCentralSimple ℂ A), denseCommutators hA)

/-- The finite-place assertion from the source hypotheses of completeness, a discrete
rank-one value group, and finite residue field. -/
def CompleteDiscreteAlgebras : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [UniformSpace F] [IsUniformAddGroup F]
    [IsValuativeTopology F] [CompleteSpace F]
    [Finite (IsLocalRing.ResidueField (ValuativeRel.valuation F).valuationSubring)],
    Nonempty (ValuativeRel.ValueGroupWithZero F ≃*o ℤᵐ⁰) →
    ∀ {A : Type v} [Ring A] [Algebra F A]
      (hA : isCentralSimple F A), denseCommutators hA

/-- Scalar extension of global units to the completion at the indicated place. -/
def localizeUnit {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K)
    {A : Type w} [Ring A] [Algebra K A] (p : D.Place) :
    letI : Algebra K (D.Completion p) := (D.embedding p).toAlgebra
    Aˣ →* (D.Completion p ⊗[K] A)ˣ :=
  letI : Algebra K (D.Completion p) := (D.embedding p).toAlgebra
  Units.map (Algebra.TensorProduct.includeRight (R := K) (A := D.Completion p)).toMonoidHom

/-- Simultaneous approximation of specified local commutator words by a word in global units.
The resulting global word has reduced norm one. The local words may have different lengths. -/
def SimultaneousApproximation : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K)
    {A : Type w} [Ring A] [Algebra K A] (hA : isCentralSimple K A)
    (T : Finset D.Place),
    letI (p : T) : Algebra K (D.Completion p.1) := (D.embedding p.1).toAlgebra
    let Aₚ (p : T) := D.Completion p.1 ⊗[K] A
    ∀ (b : ∀ p : T, Module.Basis (Fin (Module.finrank (D.Completion p.1) (Aₚ p)))
        (D.Completion p.1) (Aₚ p)),
      letI (p : T) := coordinateTopology (b p)
      ∀ (L : ∀ p : T, List ((Aₚ p)ˣ × (Aₚ p)ˣ))
        (U : ∀ p : T, Set (Aₚ p)ˣ),
        (∀ p, IsOpen (U p)) → (∀ p, commutatorWord (L p) ∈ U p) →
        ∃ W : List (Aˣ × Aˣ), commutatorWord W ∈ normOne hA ∧
          ∀ p : T, localizeUnit D p.1 (commutatorWord W) ∈ U p

end Spec

end LinearAlgebraicGroups.Arithmetic.LocalNormOneCommutators
