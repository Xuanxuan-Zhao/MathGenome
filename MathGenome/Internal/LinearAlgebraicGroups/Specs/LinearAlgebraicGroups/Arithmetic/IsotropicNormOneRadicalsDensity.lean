import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OuterTypeAModels
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.InnerTypeALocalGeneration
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals

open AlgebraicGeometry CategoryTheory Opposite
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped TensorProduct

noncomputable section

universe u v

namespace LinearAlgebraicGroups.Specs.Arithmetic.IsotropicNormOneRadicalsDensity

open OuterTypeAModels (RepresentsNormOne)
open OppositeRadicals (IsNoncentral)
open RelativeRayGeneration (unipotentGenerated)
open IntegralModels (MatrixRealization)
open LinearAlgebraicGroups.Arithmetic.AdelicGroups (PointsIn)
open LinearAlgebraicGroups.Arithmetic.LocalNormOneCommutators.Spec (elementary)
open _root_.Specs.RM03.CSA (isCentralSimple)
open _root_.Specs.RM03.CSA.NormOneGroup (normAt)

/-- The scheme-defined generated subgroup, tested at the ground field. -/
def generatedPoints {F : Type u} [Field F] {G : AffineAlgebraicGroup F}
    (i : MatrixRealization G) : Set (PointsIn i F) :=
  {x | ∃ p ∈ unipotentGenerated G, toUnit ((testSpec F).obj (op (CommAlgCat.of F F))) ≫ p = x}

/-- Every cocharacter of a norm-one group of a central division algebra is central. -/
def DivisionCocharactersCentral : Prop :=
  ∀ {F B : Type u} [Field F] [DivisionRing B] [Algebra F B]
    (hB : isCentralSimple F B) {ι : Type u} [Fintype ι] (b : Module.Basis ι F B)
    (G : AffineAlgebraicGroup F), RepresentsNormOne hB b G →
    ∀ c : CharacterDescent.Cocharacter G.val, ¬ IsNoncentral c

/-- In any matrix presentation, every off-diagonal block family belongs to the
subgroup generated by the rational points of parabolic radicals. -/
def ElementaryInRadicals : Prop :=
  ∀ {F A : Type u} [Field F] [Ring A] [Algebra F A]
    (hA : isCentralSimple F A) {ι : Type u} [Fintype ι] (b : Module.Basis ι F A)
    (G : AffineAlgebraicGroup F)
    (point : ∀ R : TestAlgebra F, Points G.val.X R ≃ {x : R ⊗[F] A // normAt hA b x = 1}),
    (∀ R (x y : ((groupPointsFunctor F).obj G.val).obj R),
      (point R (x * y)).val = (point R x).val * (point R y).val) →
    (∀ {R S : TestAlgebra F} (f : R ⟶ S) (x : Points G.val.X R),
      (point S (mapPoints f x)).val =
        Algebra.TensorProduct.map f.hom (.id F A) (point R x).val) →
    ∀ {B : Type u} [DivisionRing B] [Algebra F B] {m : ℕ}
      (e : A ≃ₐ[F] Matrix (Fin m) (Fin m) B) (i : MatrixRealization G)
      (r s : Fin m) (hrs : r ≠ s) (a : B),
      ∃ x : PointsIn i F, x ∈ generatedPoints i ∧
        e (Algebra.TensorProduct.lid F A (point (CommAlgCat.of F F) x).val) =
          (elementary r s hrs a : Matrix (Fin m) (Fin m) B)

/-- Local density in the topology of an arbitrary closed matrix realization. -/
def DensityOver {F : Type u} [Field F] [TopologicalSpace F] : Prop :=
  ∀ {A : Type u} [Ring A] [Algebra F A] (hA : isCentralSimple F A)
    {ι : Type u} [Fintype ι] (b : Module.Basis ι F A)
    (G : AffineAlgebraicGroup F), RepresentsNormOne hA b G →
    (∃ c : CharacterDescent.Cocharacter G.val, IsNoncentral c) →
    ∀ i : MatrixRealization G, Dense (generatedPoints i)

def LocalDensity : Prop :=
  (∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F], DensityOver (F := F)) ∧
  DensityOver (F := ℝ) ∧ DensityOver (F := ℂ)

open OuterTypeAModels (RepresentsUnitary)
open Unipotent (baseChangedAlgebraicGroup)
open LinearAlgebraicGroups.UnitaryNormEquations (SecondKind)

/-- At a place splitting the quadratic centre, selecting a centre embedding
into the local field selects the reduced-norm-one factor. -/
def SplitCentreDensityOver {L : Type u} [Field L] [TopologicalSpace L] : Prop :=
  ∀ {K E A : Type u} [Field K] [Field E] [Algebra K E]
    [Algebra.IsQuadraticExtension K E] [Algebra.IsSeparable K E]
    [Algebra K L] [Algebra E L] [IsScalarTower K E L]
    [Ring A] [Algebra K A] [Algebra E A] [IsScalarTower K E A]
    (hA : isCentralSimple E A) {ι : Type u} [Fintype ι] (b : Module.Basis ι E A)
    (star : SecondKind K E A) {G : AffineAlgebraicGroup K},
    RepresentsUnitary hA b star G →
    let G' := baseChangedAlgebraicGroup L G
    (∃ c : CharacterDescent.Cocharacter G'.val, IsNoncentral c) →
    ∀ i : MatrixRealization G', Dense (generatedPoints i)

def SplitCentreLocalDensity : Prop :=
  (∀ {L : Type u} [Field L] [ValuativeRel L] [TopologicalSpace L]
    [IsNonarchimedeanLocalField L], SplitCentreDensityOver (L := L)) ∧
  SplitCentreDensityOver (L := ℝ) ∧ SplitCentreDensityOver (L := ℂ)

/-- Transport the local norm-one density theorem to the completion points
equipped with the topology from a closed realization over the global field. -/
def CompletionDensityTransfer : Prop :=
  ∀ {K : Type u} [Field K] (D : LinearAlgebraicGroups.Arithmetic.GlobalFieldData.{u,v} K)
    (G : AffineAlgebraicGroup K) (i : MatrixRealization G) (w : D.Place),
    let L := D.Completion w
    let G' := baseChangedAlgebraicGroup L G
    DensityOver (F := L) →
    ∀ {A : Type u} [Ring A] [Algebra L A] (hA : isCentralSimple L A)
      {ι : Type u} [Fintype ι] (b : Module.Basis ι L A),
      RepresentsNormOne hA b G' →
      (∃ c : CharacterDescent.Cocharacter G'.val, IsNoncentral c) →
      Dense (OppositeRadicals.localPlus D i w)

/-- In the original matrix realization at a split-centre completion, the
rational parabolic radicals of the local group generate a dense subgroup. -/
def SplitCentreCompletionDensity : Prop :=
  ∀ {K E A : Type u} [Field K] [Field E] [Algebra K E]
    [Algebra.IsQuadraticExtension K E] [Algebra.IsSeparable K E]
    [Ring A] [Algebra K A] [Algebra E A] [IsScalarTower K E A]
    (hA : isCentralSimple E A) {ι : Type u} [Fintype ι] (b : Module.Basis ι E A)
    (star : SecondKind K E A) {G : AffineAlgebraicGroup K},
    RepresentsUnitary hA b star G →
    ∀ (D : LinearAlgebraicGroups.Arithmetic.GlobalFieldData.{u,v} K)
      (i : MatrixRealization G) (w : D.Place),
      let L := D.Completion w
      ∀ [Algebra E L] [IsScalarTower K E L],
        let G' := baseChangedAlgebraicGroup L G
        (∃ c : CharacterDescent.Cocharacter G'.val, IsNoncentral c) →
        Dense (OppositeRadicals.localPlus D i w)

end LinearAlgebraicGroups.Specs.Arithmetic.IsotropicNormOneRadicalsDensity
