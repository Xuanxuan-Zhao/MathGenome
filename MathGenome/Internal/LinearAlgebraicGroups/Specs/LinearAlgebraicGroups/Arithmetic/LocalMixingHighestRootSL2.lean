import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.RelativeRootIrreducibility
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.TrialitarianRelativeRoots
import Mathlib.NumberTheory.LocalField.Basic

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.LocalMixingHighestRootSL2

open CharacterDescent (Character Cocharacter)
open CharacterPairing (absoluteRoots pairing)
open GeometricRadicals (IsSplitReductive IsSplitTorus IsTorus baseChangedSubgroup)
open QuasiSplitOrbitLevis (MultiplicativeComparison PreservesUnits)
open RankOneFlag (IsGeometricallyMaximal)
open Relative.MaximalSplitTori (IsMaximalSplitTorus)
open Relative.RelativeChambers (IsRegular relativeRoots)
open Relative.RelativeReflections (Datum)
open Relative.RelativeWeylScheme (QuotientData)
open RelativeRootIrreducibility (IsAbsolutelyAlmostSimple RealRootSpan realRoot)
open RootGroups (HasScalarAction Proportional)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open TrialitarianFixedRootSL2 (RankOne)
open Unipotent (baseChangedAlgebraicGroup)
open _root_.LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition)

noncomputable section

variable {F : Type u} [Field F] {G : AffineAlgebraicGroup F}

/-- The character has exactly one absolute root above it over a finite Galois
splitting field of the group and a maximal torus containing the split torus. -/
def HasSingleAbsoluteRoot (S : ClosedSubgroup G.val) (a : Character S.group) : Prop :=
  ∃ (T : ClosedSubgroup G.val) (i : S.group ⟶ T.group),
    IsTorus T.group ∧ IsGeometricallyMaximal T ∧ i ≫ T.inclusion = S.inclusion ∧
    ∃ (K : Type u) (_ : Field K) (_ : Algebra F K) (_ : FiniteDimensional F K)
      (_ : IsGalois F K)
      (hT : IsClosedImmersion ((groupBaseChange F K).map T.inclusion).hom.hom.left)
      (e : MultiplicativeComparison F K),
      IsSplitReductive (baseChangedAlgebraicGroup K G) ∧
      IsSplitTorus ((groupBaseChange F K).obj T.group) ∧
      PreservesUnits e ∧
      ∃! b : Character ((groupBaseChange F K).obj T.group),
        b ∈ absoluteRoots (baseChangedSubgroup K T hT) ∧
          (groupBaseChange F K).map i ≫ b = (groupBaseChange F K).map a ≫ e.inv

/-- The root has maximal length for a Euclidean form on the span of the
actual relative roots that realizes their relative Cartan integers. -/
def IsLongest (S : ClosedSubgroup G.val) (a : relativeRoots S) : Prop :=
  ∃ (D : QuotientData S) (comm : IsCommMonObj S.group.X),
    letI := comm
    ∃ (d : Datum D) (form : InnerProductSpace.Core ℝ (RealRootSpan S)),
      letI := @InnerProductSpace.Core.toNormedAddCommGroup ℝ (RealRootSpan S) _ _ _ form
      letI := InnerProductSpace.ofCore form.toCore
      (∀ b r : relativeRoots S,
        2 * inner ℝ (realRoot b) (realRoot r) / inner ℝ (realRoot r) (realRoot r) =
          (pairing S.group b.val (d.reflection r).coroot : ℝ)) ∧
      ∀ b : relativeRoots S, ‖realRoot b‖ ≤ ‖realRoot a‖

/-- Proportional relative roots are equal or opposite. -/
def HasReducedRoots (S : ClosedSubgroup G.val) : Prop :=
  ∀ a b : relativeRoots S, Proportional a.val b.val → b.val = a.val ∨ b.val = a.val⁻¹

/-- The chosen rank-one subgroup has the prescribed opposite scalar weights
on its two transvections and the opposite radicals of its diagonal. -/
def IsRankOneAt (S : ClosedSubgroup G.val) (a : relativeRoots S) (L : RankOne S) : Prop :=
  HasScalarAction S a.val (L.upper.hom ≫ L.positive.inclusion) ∧
  HasScalarAction S a.val⁻¹ (L.lower.hom ≫ L.negative.inclusion) ∧
  TrialitarianRelativeRoots.RankOne.HasOppositeRadicals L

/-- The highest root dominates every positive relative root in the order
generated by the positive root characters. -/
def IsHighest (S : ClosedSubgroup G.val) (c : Cocharacter S.group)
    (θ : relativeRoots S) : Prop :=
  let positive := {b ∈ relativeRoots S | 0 < pairing S.group b c}
  θ.val ∈ positive ∧
    ∀ b ∈ positive, θ.val * b⁻¹ ∈ Submonoid.closure positive

/-- The positive rank-one subgroup at the highest relative root is central
in the radical of a maximal proper parabolic containing the limit parabolic. -/
def HasHighestSplitRankOne (S : ClosedSubgroup G.val) : Prop :=
  ∃ (c : Cocharacter S.group) (θ : relativeRoots S)
    (L : RankOne S) (P : LimitDecomposition (c ≫ S.inclusion)),
    IsRegular S c ∧ IsHighest S c θ ∧ HasSingleAbsoluteRoot S θ.val ∧ IsRankOneAt S θ L ∧
      TrialitarianRelativeRoots.RankOne.HasCentralUpper L P.parabolic

/-- A longest relative root with a singleton absolute fibre gives the
marked split rank-one subgroup at a highest root in the reduced case. -/
def Statement : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : AffineAlgebraicGroup F),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    ∀ S : ClosedSubgroup G.val, IsMaximalSplitTorus S →
      HasReducedRoots S →
      (∃ a : relativeRoots S, IsLongest S a ∧ HasSingleAbsoluteRoot S a.val) →
      (∀ a : relativeRoots S, HasSingleAbsoluteRoot S a.val →
        ∃ L : RankOne S, IsRankOneAt S a L) →
      HasHighestSplitRankOne S

end

end LinearAlgebraicGroups.Specs.Arithmetic.LocalMixingHighestRootSL2
