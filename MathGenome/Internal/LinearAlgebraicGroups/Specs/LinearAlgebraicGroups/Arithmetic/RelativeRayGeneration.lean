import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.RelativeRootIrreducibility

open AlgebraicGeometry CategoryTheory
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.Arithmetic.RelativeRayGeneration

open BorelProper (IsParabolic)
open CharacterDescent (Cocharacter)
open GeometricBorelConjugacy (subgroupOfSubgroup)
open GeometricRadicals (IsUnipotentRadical)
open RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open Unipotent (closedSubgroupAlgebraicGroup)
open LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition oppositeCocharacter)

/-- The subgroup of ground-field points generated by the unipotent radicals of
all ground-field parabolics. -/
noncomputable def unipotentGenerated {k : Type u} [Field k] (G : AffineAlgebraicGroup k) :
    Subgroup (𝟙_ (SchemeOver k) ⟶ G.val.X) :=
  ⨆ (P : ClosedSubgroup G.val) (_ : IsParabolic G P)
    (U : ClosedSubgroup P.group) (_ : IsUnipotentRadical (closedSubgroupAlgebraicGroup P) U),
      SubgroupSections (subgroupOfSubgroup P U) (𝟙_ (SchemeOver k))

/-- A noncentral cocharacter's two opposite parabolic radicals generate
the subgroup generated by all rational parabolic radicals. The ground-field
quantification includes all completions of global fields. -/
def Statement : Prop :=
  ∀ {k : Type u} [Field k] [Infinite k] (G : AffineAlgebraicGroup k),
    IsAbsolutelyAlmostSimple G →
    ∀ c : Cocharacter G.val,
      (∃ (X : SchemeOver k) (g : X ⟶ G.val.X), ¬ Centralizes c g) →
      ∀ (D : LimitDecomposition c) (E : LimitDecomposition (oppositeCocharacter c)),
        SubgroupSections D.contracting (𝟙_ (SchemeOver k)) ⊔
          SubgroupSections E.contracting (𝟙_ (SchemeOver k)) = unipotentGenerated G

end LinearAlgebraicGroups.Specs.Arithmetic.RelativeRayGeneration
