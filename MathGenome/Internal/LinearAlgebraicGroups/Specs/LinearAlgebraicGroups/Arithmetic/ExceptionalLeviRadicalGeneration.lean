import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Classification.SimplyConnectedLattice
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Reductive.GeneralLinearStructure

open AlgebraicGeometry CategoryTheory Opposite
open CategoryTheory.MonoidalCategory CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.ExceptionalLeviRadicalGeneration

open AdjointCocharacters (coordinateHopf)
open Arithmetic.RelativeRayGeneration (unipotentGenerated)
open Arithmetic.RelativeRootIrreducibility (IsAbsolutelyAlmostSimple)
open CharacterDescent (Cocharacter)
open DiagonalizableGroups (groupAlgebra IntegerCharacters)
open ExceptionalIwahoriCongruence (affinePointTopology)
open ExceptionalMarkedRootDescent (coordinatePointEquiv)
open GeneralLinearStructure (SpecialMatrixPoints)
open InnerTypeARelativeContraction (NormOnePoints)
open SchemeDerivedGroup (IsDerivedSubgroup RepresentsQuotient)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Unipotent (closedSubgroupAlgebraicGroup Index)
open LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition cocharacterPoint)
open _root_.Specs.RM03.CSA (degree isCentralSimple)

noncomputable section

variable {F : Type u} [Field F]

/-- The spectrum of the ground field as the terminal scheme over that field. -/
def groundPointIso (F : Type u) [Field F] :
    𝟙_ (SchemeOver F) ≅ (testSpec F).obj (op (CommAlgCat.of F F)) :=
  Over.isoMk (Iso.refl (Spec (CommRingCat.of F))) (by
    change 𝟙 (Spec (CommRingCat.of F)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F F)) = 𝟙 _
    rw [Category.id_comp]
    exact Spec.map_id _)

/-- The topology on the rational points induced by evaluation of coordinate
functions into the topological ground field. -/
abbrev localPointTopology [TopologicalSpace F] (G : AffineAlgebraicGroup F) :
    TopologicalSpace (𝟙_ (SchemeOver F) ⟶ G.val.X) :=
  letI := affinePointTopology F (coordinateHopf G) F
  TopologicalSpace.induced
    (fun p => ((coordinatePointEquiv G _).symm ((groundPointIso F).inv ≫ p)).ofConv)
    inferInstance

/-- The reduced-norm-one model of a matrix algebra over a central division
algebra of the given degree, with multiplication and scalar change on all
commutative test algebras. -/
def IsDivisionMatrixGroup (H : AffineAlgebraicGroup F) (m d : ℕ) : Prop :=
  ∃ (B : Type u) (_ : DivisionRing B) (_ : Algebra F B),
    isCentralSimple F B ∧ degree F B = d ∧
    ∃ (h : isCentralSimple F (Matrix (Fin m) (Fin m) B))
      (b : Module.Basis (ULift.{u} (Fin (Module.finrank F (Matrix (Fin m) (Fin m) B)))) F
        (Matrix (Fin m) (Fin m) B)),
      Nonempty (NormOnePoints h b H)

/-- The two actual scheme models of the derived Levi in the nonsplit inner
exceptional cases. -/
def HasDerivedLeviModel (H : AffineAlgebraicGroup F) : Prop :=
  IsDivisionMatrixGroup H 2 3 ∨
    ∃ (H₁ H₂ : AffineAlgebraicGroup F), Nonempty (SpecialMatrixPoints H₁ 2) ∧
      IsDivisionMatrixGroup H₂ 3 2 ∧ Nonempty (H.val ≅ Limits.prod H₁.val H₂.val)

/-- A closed split SL₂ subgroup and its standard determinant-one diagonal
cocharacter, identified on every test algebra. -/
structure SplitRankOneDiagonal (G : AffineAlgebraicGroup F) where
  subgroup : ClosedSubgroup G.val
  matrix : SpecialMatrixPoints (closedSubgroupAlgebraicGroup subgroup) 2
  diagonal : Cocharacter subgroup.group
  diagonal_eq : ∀ (R : TestAlgebra F) (t : Rˣ),
    (matrix.hom.app R (cocharacterPoint diagonal R t)).val =
      Matrix.diagonal (fun i : Index.{u} 2 => if i.down = 0 then (t : R) else (t⁻¹ : Rˣ))

/-- An actual centralizing Levi with one of the indicated derived groups and
a quotient section given in the ambient group by a split SL₂ diagonal
implies density of the group generated by rational parabolic radicals. -/
def LeviRadicalGeneration : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : AffineAlgebraicGroup F),
    IsAbsolutelyAlmostSimple G → GeometricallySimplyConnected G →
    ∀ (c : Cocharacter G.val) (D : LimitDecomposition c)
      (H : ClosedSubgroup D.centralizer.group)
      (q : D.centralizer.group ⟶ specGroup (groupAlgebra F IntegerCharacters))
      (s : Cocharacter D.centralizer.group) (A : SplitRankOneDiagonal G),
      IsDerivedSubgroup H → IsSchemeKernel q H → RepresentsQuotient H q →
      s ≫ q = 𝟙 _ →
      s ≫ D.centralizer.inclusion = A.diagonal ≫ A.subgroup.inclusion →
      HasDerivedLeviModel
        (closedSubgroupAlgebraicGroup (G := closedSubgroupAlgebraicGroup D.centralizer) H) →
      letI := localPointTopology G
      Dense (unipotentGenerated G : Set (𝟙_ (SchemeOver F) ⟶ G.val.X))

end

end LinearAlgebraicGroups.Specs.ExceptionalLeviRadicalGeneration
