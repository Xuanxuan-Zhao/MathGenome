open _root_.Specs.RM03.CSA (degree isCentralSimple)

noncomputable section

variable {F : Type u} [Field F]

local notation "Fsep" => SeparableClosure F
local notation "Gm" => specGroup (groupAlgebra F IntegerCharacters)

/-- The split Borel pair over the separable closure is adapted to the specified
rational tori and minimal parabolic. All inclusion squares are scheme morphisms. -/
structure AdaptedPair (G : AffineAlgebraicGroup F) (n : ℕ) where
  S : ClosedSubgroup G.val
  maximalSplit : IsMaximalSplitTorus S
  T : ClosedSubgroup G.val
  maximalTorus : IsMaximalTorus T
  intoTorus : S.group ⟶ T.group
  intoTorus_eq : intoTorus ≫ T.inclusion = S.inclusion
  J : ClosedSubgroup G.val
  minimalParabolic : IsMinimalParabolic G J
  torusInParabolic : IsSubgroupOf T J
  pair : SplitBorelPair Fsep
  datum : AttachedDatum pair
  numbering : Fin n ≃ datum.toBased.base.support
  cartan_eq : ∀ i j,
    datum.toBased.datum.pairing (numbering i) (numbering j) = CartanMatrix.E n i j
  ambient : pair.G.val ≅ (groupBaseChange F Fsep).obj G.val
  torus : (groupBaseChange F Fsep).obj T.group ≅ pair.T.group
  torus_eq : torus.hom ≫ pair.T.inclusion ≫ ambient.hom =
    (groupBaseChange F Fsep).map T.inclusion
  borel : pair.B.group ⟶ (groupBaseChange F Fsep).obj J.group
  borel_eq : borel ≫ (groupBaseChange F Fsep).map J.inclusion =
    pair.B.inclusion ≫ ambient.hom
  multiplicative : MultiplicativeComparison F Fsep
  multiplicative_eq : PreservesUnits multiplicative

variable {G : AffineAlgebraicGroup F} {n : ℕ}

abbrev AdaptedPair.splitInAbsolute (A : AdaptedPair G n) :
    (groupBaseChange F Fsep).obj A.S.group ⟶ A.pair.T.group :=
  (groupBaseChange F Fsep).map A.intoTorus ≫ A.torus.hom

abbrev AdaptedPair.geometricCocharacter (A : AdaptedPair G n)
    (c : Cocharacter A.S.group) : Cocharacter A.pair.T.group :=
  A.multiplicative.hom ≫ (groupBaseChange F Fsep).map c ≫ A.splitInAbsolute

/-- The marked simple restriction map in root coordinates. Its integral image
need only be the lattice generated by the restricted simple roots. -/
def HasWhiteRestrictions (A : AdaptedPair G n) {r : ℕ} (white : Fin r → Fin n) : Prop :=
  ∃ encode : Multiplicative (Fin r → ℤ) →* Character A.S.group,
    Function.Injective encode ∧
    ∀ i : Fin n, A.splitInAbsolute ≫ (A.numbering i).val.val =
      (groupBaseChange F Fsep).map
        (encode (Multiplicative.ofAdd (fun j => (Pi.single i 1 : Fin n → ℤ) (white j)))) ≫
          A.multiplicative.inv

/-- This is innerness relative to a split group by actual scheme automorphisms. -/
def IsInner (G : AffineAlgebraicGroup F) : Prop :=
  ∃ G₀ : AffineAlgebraicGroup F, IsSplitReductive G₀ ∧
    AreInnerForms (S := Fsep) G₀ G

/-- The central division matrix model represents the reduced-norm-one
functor naturally on all commutative ground-field algebras. -/
def RepresentsDivisionMatrixNormOne (H : AffineAlgebraicGroup F) (m : ℕ)
    (B : Type u) [DivisionRing B] [Algebra F B] : Prop :=
  ∃ (h : isCentralSimple F (Matrix (Fin m) (Fin m) B))
    (b : Module.Basis (ULift.{u} (Fin (Module.finrank F (Matrix (Fin m) (Fin m) B)))) F
      (Matrix (Fin m) (Fin m) B)),
    RepresentsNormOne h b H

/-- The degree-three division matrix model of the derived E₆ Levi. -/
def HasE6LeviModel (H : AffineAlgebraicGroup F) : Prop :=
  ∃ (B : Type u) (_ : DivisionRing B) (_ : Algebra F B),
    isCentralSimple F B ∧ degree F B = 3 ∧ RepresentsDivisionMatrixNormOne H 2 B

/-- A degree-two central division algebra with its local cyclic presentation.
The latter uses an unramified quadratic subfield and its Galois automorphism,
and applies in residue characteristic two. -/
def IsLocalQuaternion [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B : Type u) [DivisionRing B] [Algebra F B] : Prop :=
  ∃ (h : isCentralSimple F B) (w : Valuation B ℤᵐ⁰),
    degree F B = 2 ∧ IsDivisionValuation h w ∧
      ∃ residue : ResidueData (F := F) w, Nonempty (CyclicPresentation (F := F) w residue)

/-- The product of the split A₁ and inner A₅ factors as group schemes over F. -/
def HasE7LeviModel [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (H : AffineAlgebraicGroup F) : Prop :=
  ∃ (H₁ H₂ : AffineAlgebraicGroup F) (_ : SpecialMatrixPoints H₁ 2)
    (B : Type u) (_ : DivisionRing B) (_ : Algebra F B),
    IsLocalQuaternion (F := F) B ∧ RepresentsDivisionMatrixNormOne H₂ 3 B ∧
      Nonempty (H.val ≅ Limits.prod H₁.val H₂.val)

/-- The actual limit parabolic and its centralizing Levi have the given
derived group model. The given rational coroot splits the scheme quotient. -/
def HasOmittedNodeLevi (A : AdaptedPair G n) (node : Fin n)
    (δ : Cocharacter A.S.group) (model : AffineAlgebraicGroup F → Prop) : Prop :=
  ∃ (c : Cocharacter A.S.group) (L : LimitDecomposition (c ≫ A.S.inclusion)),
    (∀ i, let p := pairing A.pair.T.group (A.numbering i).val.val (A.geometricCocharacter c)
      if i = node then 0 < p else p = 0) ∧
    IsParabolic G L.parabolic ∧ ¬ IsIso L.parabolic.inclusion ∧
    IsSubgroupOf A.J L.parabolic ∧
    (∀ Q : ClosedSubgroup G.val, IsParabolic G Q → IsSubgroupOf L.parabolic Q →
      IsIso Q.inclusion ∨ IsSubgroupOf Q L.parabolic) ∧
    ∃ (H : ClosedSubgroup L.centralizer.group) (q : L.centralizer.group ⟶ Gm)
      (s : Cocharacter L.centralizer.group),
      let derived := closedSubgroupAlgebraicGroup
        (G := closedSubgroupAlgebraicGroup L.centralizer) H
      IsDerivedSubgroup H ∧ GeometricallySimplyConnected derived ∧
      IsSchemeKernel q H ∧ RepresentsQuotient H q ∧
      s ≫ q = 𝟙 _ ∧ s ≫ L.centralizer.inclusion = δ ≫ A.S.inclusion ∧ model derived

/-- The omitted Bourbaki node 2 in the nonsplit inner E₆ index. -/
def E6OmittedNodeLevi : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (G : AffineAlgebraicGroup F) (A : AdaptedPair G 6),
    IsSemisimple G → GeometricallySimplyConnected G → IsInner G → ¬ IsSplitReductive G →
    relativeRank G = 2 → HasWhiteRestrictions A (![1, 3] : Fin 2 → Fin 6) →
    ∀ δ : Cocharacter A.S.group,
      A.geometricCocharacter δ = (A.datum.toBased.datum.coroot (A.numbering 1)).toMul →
      HasOmittedNodeLevi A 1 δ HasE6LeviModel

/-- The omitted Bourbaki node 3 in the nonsplit inner E₇ index. -/
def E7OmittedNodeLevi : Prop :=
  ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (G : AffineAlgebraicGroup F) (A : AdaptedPair G 7),
    IsSemisimple G → GeometricallySimplyConnected G → IsInner G → ¬ IsSplitReductive G →
    relativeRank G = 4 → HasWhiteRestrictions A (![0, 2, 3, 5] : Fin 4 → Fin 7) →
    ∀ δ : Cocharacter A.S.group,
      A.geometricCocharacter δ = (A.datum.toBased.datum.coroot (A.numbering 2)).toMul →
      HasOmittedNodeLevi A 2 δ HasE7LeviModel

end

end LinearAlgebraicGroups.Specs.ExceptionalOmittedNodeLevis
