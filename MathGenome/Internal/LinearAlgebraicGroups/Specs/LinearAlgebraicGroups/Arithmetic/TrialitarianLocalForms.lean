import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.OppositeRadicals
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Descent.QuasiSplitInnerForms
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.RootData.AbsoluteDynkinTypes

/-! The local and globally isotropic conclusions of the trialitarian case of F12. -/

open CategoryTheory

universe u v

namespace LinearAlgebraicGroups.Specs.Arithmetic.TrialitarianLocalForms

open _root_.LinearAlgebraicGroups.Arithmetic (GlobalFieldData)
open _root_.LinearAlgebraicGroups.Arithmetic.AdelicGroups (completionAlgebra)
open AbsoluteDynkinTypes (D4Cartan D4Outer)
open AutomorphismSequence (AdjointQuotient SplitSequence relativePoints)
open CharacterDescent (Cocharacter)
open GeometricBorelConjugacy (IsQuasiSplit)
open GeometricRadicals (IsSemisimple)
open IntegralModels (MatrixRealization)
open OppositeRadicals (IsNoncentral localPlus)
open Pinning (AttachedDatum PinnedGroup)
open QuasiSplitInnerForms (outerHom)
open RelativeFormComparison (IsInduced fieldTest transportedAut)
open RootGroups (AdditiveLine)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Unipotent (baseChangedAlgebraicGroup)

variable {F : Type u} [Field F]

/-- A pinning of a split reference form identifies the absolute simple roots
of the given group with the standard (D_4) diagram. The relative points
comparison is induced by the splitting isomorphism of group schemes. -/
structure D4Diagram (G : AffineAlgebraicGroup F) where
  additive : AdditiveLine F
  pinned : PinnedGroup additive
  datum : AttachedDatum pinned.pair
  lifts : Aut datum.toBased ≃* Aut pinned
  adjoint : AdjointQuotient pinned.pair.G
  sequence : SplitSequence pinned datum lifts adjoint
  splitIso : (groupBaseChange F (SeparableClosure F)).obj pinned.pair.G.val ≅
    (groupBaseChange F (SeparableClosure F)).obj G.val
  relativeIso : relativePoints pinned.pair.G.val (fieldTest F (SeparableClosure F)) ≅
    relativePoints G.val (fieldTest F (SeparableClosure F))
  induced : IsInduced F (SeparableClosure F) splitIso relativeIso
  simple : Fin 4 ≃ datum.toBased.base.support
  cartan : ∀ i j,
    datum.toBased.datum.pairing (simple j).val (simple i).val = D4Cartan i j

/-- The diagram action is the outer part of the transported scalar action.
Triality means that its action on the three outer vertices is transitive. -/
def D4Diagram.IsTransitive {G : AffineAlgebraicGroup F} (D : D4Diagram G) : Prop :=
  ∀ i j : D4Outer, ∃ σ : Gal(SeparableClosure F/F),
    (outerHom D.sequence (transportedAut F (SeparableClosure F) D.relativeIso σ)).asIso.hom.val.indexEquiv
      (D.simple i.val).val = (D.simple j.val).val

/-- A simply connected semisimple group of absolute type (D_4). -/
def IsSimplyConnectedD4 (G : AffineAlgebraicGroup F) : Prop :=
  IsSemisimple G ∧ GeometricallySimplyConnected G ∧ Nonempty (D4Diagram G)

/-- Triality is tested over the indicated ground field. After extension to
a completion its diagram action need not remain transitive. -/
def IsTrialitarian (G : AffineAlgebraicGroup F) : Prop :=
  ∃ D : D4Diagram G, D.IsTransitive

/-- For the semisimple groups here, positive split rank is witnessed by a
ground-field cocharacter with noncentral image. -/
def HasPositiveSplitRank (G : AffineAlgebraicGroup F) : Prop :=
  ∃ c : Cocharacter G.val, IsNoncentral c

/-- At every nonarchimedean local field, a simply connected (D_4)-form
with transitive diagram action has a Borel defined over that field. -/
def FiniteQuasiSplit : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : AffineAlgebraicGroup F),
    IsSemisimple G → GeometricallySimplyConnected G →
    IsTrialitarian G → IsQuasiSplit G

/-- Positive split rank at finite places holds for both diagram cases.
In the nontransitive case the diagram has a fixed vector vertex. -/
def FiniteIsotropy : Prop :=
  ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (G : AffineAlgebraicGroup F),
    IsSimplyConnectedD4 G → HasPositiveSplitRank G

/-- At each isotropic completion of a globally trialitarian group, the
subgroup generated by rational parabolic radicals is dense in the full
local point group with its completion topology. -/
def LocalGeneration : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K) (G : AffineAlgebraicGroup K),
    IsSemisimple G → GeometricallySimplyConnected G → IsTrialitarian G →
    ∀ (i : MatrixRealization G) (w : D.Place),
      HasPositiveSplitRank (baseChangedAlgebraicGroup (D.Completion w) G) →
      Dense (localPlus D i w)

/-- A globally isotropic simply connected trialitarian group has strong
approximation in the full adelic topology away from any finite nonempty
set of places. -/
def GlobalStrongApproximation : Prop :=
  ∀ {K : Type u} [Field K] (D : GlobalFieldData.{u, v} K) (G : AffineAlgebraicGroup K),
    IsSemisimple G → GeometricallySimplyConnected G → IsTrialitarian G →
    HasPositiveSplitRank G →
    ∀ (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
      _root_.LinearAlgebraicGroups.Arithmetic.AdelicGroups.StrongApproximation D i S

end LinearAlgebraicGroups.Specs.Arithmetic.TrialitarianLocalForms
