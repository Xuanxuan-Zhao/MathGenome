import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.AnisotropicAdNilpotents
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.CompactProductIsolation
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ProjectiveRecurrence

open AlgebraicGeometry CategoryTheory
open scoped Classical RestrictedProduct

noncomputable section

set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
universe u

namespace LinearAlgebraicGroups.Specs.LocalCompactnessCriterion

open LinearAlgebraicGroups.Arithmetic LinearAlgebraicGroups.Arithmetic.AdelicGroups
open LinearAlgebraicGroups.Arithmetic.ArithmeticLatticeProjection
open LinearAlgebraicGroups.Arithmetic.CompactProductIsolation
open LinearAlgebraicGroups.Specs.Arithmetic.ProjectiveRecurrence
open IntegralModels (MatrixRealization RationalPoints)
open AnisotropicAdNilpotents (IsAnisotropic)
open GeometricRadicals (IsSemisimple)
open GeometricBorelConjugacy (IsQuasiSplit)
open SimplyConnectedLattice (GeometricallySimplyConnected)
open Unipotent (baseChangedAlgebraicGroup)

/-- Compactness over a characteristic-zero local field with its usual norm
topology. A nontrivial norm and properness of the field cover both the
archimedean and nonarchimedean local fields in the criterion. -/
def LocalFieldCompactness : Prop :=
  ∀ {F : Type u} [NontriviallyNormedField F] [ProperSpace F] [CharZero F],
    ∀ (G : AffineAlgebraicGroup F) (i : MatrixRealization G), IsSemisimple G →
      (CompactSpace (PointsIn i F) ↔ IsAnisotropic G.val)

/-- The compactness criterion for an arbitrary semisimple group over a number-field
completion, with the matrix topology coming from a closed realization. -/
def LocalCompactness : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K] (D : GlobalFieldData.{u, u} K),
    D = .number inferInstance → ∀ (w : D.Place),
    ∀ (G : AffineAlgebraicGroup (D.Completion w)) (i : MatrixRealization G),
      IsSemisimple G → (CompactSpace (PointsIn i (D.Completion w)) ↔ IsAnisotropic G.val)

/-- Semisimple groups over a number field are quasi-split at all but finitely many
finite places. -/
def QuasiSplitAtAlmostAllFinitePlaces : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K] (D : GlobalFieldData.{u, u} K),
    D = .number inferInstance → ∀ (G : AffineAlgebraicGroup K), IsSemisimple G →
    {w : D.FinitePlace | ¬ IsQuasiSplit (baseChangedAlgebraicGroup
      (D.Completion (.inl w)) G)}.Finite

/-- Globally anisotropic groups give cocompact arithmetic lattices for all
finite T containing S and every noncompact archimedean factor. -/
def CocompactLattice : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K] (D : GlobalFieldData.{u, u} K),
    D = .number inferInstance → ∀ (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → IsAnisotropic G.val →
    ∀ (S T : Finset D.Place), S.Nonempty → S ⊆ T →
      ¬ CompactSpace (FinitePoints D i S) →
      (∀ w : D.InfinitePlace, Sum.inr w ∉ T → CompactSpace (LocalPoints D i (.inr w))) →
      let U := integralOutside D i T
      let L := lattice D i T U
      IsCompact (U : Set (Adeles D i T)) ∧ IsOpen (U : Set (Adeles D i T)) ∧
      (arithmeticSubgroup D i T U : Set (RationalPoints G)).InjOn (rationalProjection D i T) ∧
      IsClosed (L : Set (FinitePoints D i T)) ∧ IsDiscrete (L : Set (FinitePoints D i T)) ∧
      CompactSpace (FinitePoints D i T ⧸ L) ∧
      FiniteInvariantQuotientMeasure L ∧
      ∀ (J : Finset D.Place) (hJ : J ⊆ T), J.Nonempty → Disjoint J S →
        let P := L.map (forgetPlaces D i hJ)
        ¬ IsDiscrete (P : Set (FinitePoints D i J)) ∧
        ∃ H : Subgroup (FinitePoints D i J),
          (H : Set (FinitePoints D i J)) = closure (P : Set (FinitePoints D i J)) ∧
          CompactSpace (FinitePoints D i J ⧸ H) ∧ FiniteInvariantQuotientMeasure H

/-- At each noncompact outside finite place, the projected lattice closure is
open of finite index and contains the subgroup generated by rational parabolic
radicals. That subgroup embeds in the adelic diagonal closure when all outside
infinite factors are compact. -/
def IsolateParabolicRadicals : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K] (D : GlobalFieldData.{u, u} K),
    D = .number inferInstance → ∀ (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → IsAnisotropic G.val →
    ∀ (S : Finset D.Place), S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      (∀ w : D.InfinitePlace, Sum.inr w ∉ S → CompactSpace (LocalPoints D i (.inr w))) →
      ∀ (w : D.FinitePlace) (hw : Sum.inl w ∉ S), ¬ CompactSpace (LocalPoints D i (.inl w)) →
        let T := S ∪ {Sum.inl w}
        let U := integralOutside D i T
        let hwT : Sum.inl w ∈ T := Finset.mem_union_right S (Finset.mem_singleton_self _)
        let A := Subgroup.closure (localPointSet D i (.inl w) (parabolicRadicalPoints
          (baseChangedAlgebraicGroup (D.Completion (.inl w)) G)))
        let v : Outside D S := ⟨.inl w, hw⟩
        (∃ H : Subgroup (LocalPoints D i (.inl w)),
          (H : Set (LocalPoints D i (.inl w))) =
            closure (((lattice D i T U).map (evaluatePlace D i hwT) : Subgroup _) : Set _) ∧
          IsOpen (H : Set (LocalPoints D i (.inl w))) ∧ H.FiniteIndex ∧ A ≤ H) ∧
        ∀ a ∈ A,
          RestrictedProduct.mulSingle (fun k : Outside D S => localSubgroup D i k.1) v a ∈
            diagonalClosure D i S

/-- For a simply connected group with all infinite places omitted, the
quasi-split outside factors are isotropic and their whole restricted product is
in the diagonal closure. Density on the remaining finite product is equivalent
to strong approximation outside `S`. -/
def GoodPlacesReduction : Prop :=
  ∀ {K : Type u} [Field K] [NumberField K] (D : GlobalFieldData.{u, u} K),
    D = .number inferInstance → ∀ (G : AffineAlgebraicGroup K) (i : MatrixRealization G),
    IsAbsolutelyAlmostSimple G → IsAnisotropic G.val → GeometricallySimplyConnected G →
    ∀ (S : Finset D.Place), S.Nonempty → ¬ CompactSpace (FinitePoints D i S) →
      (∀ w : D.InfinitePlace, Sum.inr w ∈ S) →
      (∀ w : D.FinitePlace, Sum.inl w ∉ S →
        let Gv := baseChangedAlgebraicGroup (D.Completion (.inl w)) G
        IsQuasiSplit Gv → ¬ IsAnisotropic Gv.val) ∧
      ∃ J : Finset D.Place, Disjoint J S ∧
        (∀ w : D.FinitePlace, Sum.inl w ∈ J ↔
          Sum.inl w ∉ S ∧ ¬ IsQuasiSplit (baseChangedAlgebraicGroup (D.Completion (.inl w)) G)) ∧
        {x : Adeles D i S | ∀ w : Outside D S, w.1 ∈ J → x w = 1} ⊆ diagonalClosure D i S ∧
        (DenseRange (rationalProjection D i J) ↔ StrongApproximation D i S)

end LinearAlgebraicGroups.Specs.LocalCompactnessCriterion
