import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.AdelicGroups
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Affine.ClosedSubgroups

noncomputable section

open AlgebraicGeometry CategoryTheory Opposite
open LinearAlgebraicGroups.Specs (AffineAlgebraicGroup ClosedSubgroup)

universe u v

namespace LinearAlgebraicGroups.Arithmetic.ApproximationOfLocalWords

open AdelicGroups
open Specs.IntegralModels (MatrixRealization RationalPoints)
open Specs.Unipotent (Index)

variable {K : Type u} [Field K] {G : AffineAlgebraicGroup K}

abbrev ParameterSpace (K : Type u) [Field K] (n : ℕ) : SchemeOver K :=
  (testSpec K).obj (op (CommAlgCat.of K (MvPolynomial (Fin n) K)))

/-- The point of affine space specified by a tuple in the test algebra. -/
def parameterPoint {n : ℕ} {R : Type u} [CommRing R] [Algebra K R] (a : Fin n → R) :
    Points (ParameterSpace K n) (CommAlgCat.of K R) :=
  (testSpec K).map (CommAlgCat.ofHom (MvPolynomial.aeval a)).op

/-- Evaluate a morphism from affine space on a tuple of parameters. -/
def evaluate {n : ℕ} {X : SchemeOver K} (f : ParameterSpace K n ⟶ X)
    {R : Type u} [CommRing R] [Algebra K R] (a : Fin n → R) :
    Points X (CommAlgCat.of K R) :=
  parameterPoint a ≫ f

/-- The subgroup generated by the images of the parameter maps at one place. -/
def generatedAt {ι : Type u} {n : ι → ℕ} (f : ∀ j, ParameterSpace K (n j) ⟶ G.val.X)
    (D : GlobalFieldData.{u, v} K) (i : MatrixRealization G) (w : D.Place) :
    Subgroup (LocalPoints D i w) :=
  Subgroup.closure {g | ∃ j a, evaluate (f j) a = g}

/-- The topological closure of the rational diagonal in the adelic group. -/
def rationalClosure (D : GlobalFieldData.{u, v} K) (i : MatrixRealization G) (S : Finset D.Place) :
    Set (Adeles D i S) :=
  closure {x | ∃ g : RationalPoints G, ∀ w : Outside D S, x w = localPoint D i w.1 g}

/-- The subgroup generated by the local points of a family of closed subgroups,
viewed inside the ambient group. -/
def generatedBySubgroups {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    {ι : Type u} (H : ι → ClosedSubgroup G.val)
    (D : GlobalFieldData.{u, v} K) (i : MatrixRealization G) (w : D.Place) :
    Subgroup (LocalPoints D i w) :=
  Subgroup.closure {g | ∃ (j : ι) (h : Points (H j).group.X (CommAlgCat.of K (D.Completion w))),
    h ≫ (H j).inclusion.hom.hom = g}

end LinearAlgebraicGroups.Arithmetic.ApproximationOfLocalWords

namespace LinearAlgebraicGroups.Specs.ApproximationOfLocalWords

open Arithmetic Arithmetic.AdelicGroups Arithmetic.ApproximationOfLocalWords
open IntegralModels (MatrixRealization RationalPoints)
open Unipotent (Index)

/-- The matrix entries and inverse determinant of a ground-field parametrization
are polynomials over the ground field, for every commutative test algebra. -/
def PolynomialCoordinates : Prop :=
  ∀ {K : Type u} [Field K] {G : AffineAlgebraicGroup K} (i : MatrixRealization G)
    {n : ℕ} (f : ParameterSpace K n ⟶ G.val.X),
    ∃ (p : Index.{u} i.size → Index.{u} i.size → MvPolynomial (Fin n) K)
      (q : MvPolynomial (Fin n) K),
      ∀ (R : Type u) [CommRing R] [Algebra K R] (a : Fin n → R),
        let g : PointsIn i R := evaluate f a
        (∀ l m, (asMatrix i R g).val l m = MvPolynomial.aeval a (p l m)) ∧
          ((asMatrix i R g)⁻¹.val).det = MvPolynomial.aeval a q

/-- Finite-support tuples of points in the locally generated subgroups lie in the
closure of the diagonal. The family of maps may be arbitrary, since each word is finite. -/
def LocalWordClosure : Prop :=
  ∀ {K : Type u} [Field K] {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u, v} K)
    (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
    ∀ {ι : Type u} {n : ι → ℕ} (f : ∀ j, ParameterSpace K (n j) ⟶ G.val.X),
      (∀ j, evaluate (f j) (0 : Fin (n j) → K) = (1 : RationalPoints G)) →
      ∀ x : Adeles D i S,
        (∃ T : Finset (Outside D S), ∀ w ∉ T, x w = 1) →
        (∀ w : Outside D S, x w ∈ generatedAt f D i w.1) →
        x ∈ rationalClosure D i S

/-- Dense generation at each outside place implies strong approximation. -/
def LocalDenseGeneration : Prop :=
  ∀ {K : Type u} [Field K] {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u, v} K)
    (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
    ∀ {ι : Type u} {n : ι → ℕ} (f : ∀ j, ParameterSpace K (n j) ⟶ G.val.X),
      (∀ j, evaluate (f j) (0 : Fin (n j) → K) = (1 : RationalPoints G)) →
      (∀ w : Outside D S, Dense (generatedAt f D i w.1 : Set (LocalPoints D i w.1))) →
      StrongApproximation D i S

/-- The two adelic approximation conclusions for the local groups generated by
the points of the given closed subgroups. -/
def SubgroupApproximation {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    {ι : Type u} (D : GlobalFieldData.{u, v} K)
    (i : MatrixRealization G) (S : Finset D.Place) (H : ι → ClosedSubgroup G.val) : Prop :=
  (∀ x : Adeles D i S,
    (∃ T : Finset (Outside D S), ∀ w ∉ T, x w = 1) →
    (∀ w : Outside D S, x w ∈ generatedBySubgroups H D i w.1) →
    x ∈ rationalClosure D i S) ∧
  ((∀ w : Outside D S,
    Dense (generatedBySubgroups H D i w.1 : Set (LocalPoints D i w.1))) →
    StrongApproximation D i S)

/-- The closure and density statements apply to families of closed subgroups
isomorphic over the ground field to affine spaces. -/
def SubgroupsWithAffineCoordinates : Prop :=
  ∀ {K : Type u} [Field K] {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u, v} K)
    (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
    ∀ {ι : Type u} {n : ι → ℕ} (H : ι → ClosedSubgroup G.val),
      (∀ j, ParameterSpace K (n j) ≅ (H j).group.X) →
      SubgroupApproximation D i S H

/-- The affine-coordinate application in terms of polynomial coordinate
algebras, as for the split contracting radicals in D08. -/
def SubgroupsWithPolynomialCoordinates : Prop :=
  ∀ {K : Type u} [Field K] {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u, v} K)
    (i : MatrixRealization G) (S : Finset D.Place), S.Nonempty →
    ∀ {ι : Type u} {n : ι → ℕ} (H : ι → ClosedSubgroup G.val)
      (A : ι → HopfAlgebraCategory K),
      (∀ j, specGroup (A j) ≅ (H j).group) →
      (∀ j, MvPolynomial (Fin (n j)) K ≃ₐ[K] A j) →
      SubgroupApproximation D i S H

end LinearAlgebraicGroups.Specs.ApproximationOfLocalWords
