/-! Clifford invariants of the quadratic vector form over the diagram cubic field in F12. -/

namespace LinearAlgebraicGroups.Specs.Arithmetic.TrialitarianCliffordInvariants

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj TensorProduct
open _root_.LinearAlgebraicGroups.Arithmetic.TrialitarianAlbertDescentSpecification
open _root_.LinearAlgebraicGroups.Albert
open _root_.LinearAlgebraicGroups.Composition
open IsotropicSpinGeneration (IsIsotropic)

universe u v

set_option autoImplicit false

noncomputable section

variable {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]

/-- The full polar form is nondegenerate, including in characteristic two. -/
abbrev IsRegular (q : QuadraticForm K V) : Prop :=
  LinearMap.ker q.polarBilin = ⊥

/-- The Witt index is the largest dimension of a totally isotropic subspace. -/
def HasWittIndex (q : QuadraticForm K V) (m : ℕ) : Prop :=
  (∃ U : Submodule K V, Module.finrank K U = m ∧ ∀ z : U, q z.val = 0) ∧
    ∀ U : Submodule K V, (∀ z : U, q z.val = 0) → Module.finrank K U ≤ m

/-- The hyperbolic space of Witt index `m`, with its full polar pairing normalized to one. -/
abbrev hyperbolic (K : Type u) [Field K] (m : ℕ) :=
  OddSpinModels.hyperbolicForm (ULift.{u} (Fin m)) K

/-- A local even-dimensional regular space has an anisotropic kernel of dimension at most four. -/
def LocalWittDecomposition : Prop :=
  ∀ {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K]
    {V : Type v} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (q : QuadraticForm K V) (n : ℕ), IsRegular q → Module.finrank K V = 2 * n →
    ∃ (m r : ℕ) (q₀ : QuadraticForm K (Fin (2 * r) → K)),
      m + r = n ∧ r ≤ 2 ∧ IsRegular q₀ ∧ ¬ IsIsotropic q₀ ∧
        q.Equivalent ((hyperbolic K m).prod q₀)

/-- Signed determinant of the Gram matrix for the bilinear form with diagonal `q`. -/
def signedDiscriminant {n : ℕ} (q : QuadraticForm K V) (b : Module.Basis (Fin (2 * n)) K V) : K :=
  (-1) ^ n * (Matrix.of fun i j => q.polarBilin (b i) (b j) / 2).det

/-- The ordered volume element in the full Clifford algebra. -/
def volumeElement {n : ℕ} (q : QuadraticForm K V) (b : Module.Basis (Fin (2 * n)) K V) :
    CliffordAlgebra q :=
  (List.ofFn fun i => CliffordAlgebra.ι q (b i)).prod

/-- In characteristic different from two the center of the even Clifford algebra is the discriminant algebra. -/
def DiscriminantCenter : Prop :=
  ∀ {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    (q : QuadraticForm K V) {n : ℕ} (b : Module.Basis (Fin (2 * n)) K V),
    (2 : K) ≠ 0 → 0 < n → IsRegular q →
    (∀ i j, i ≠ j → q.polarBilin (b i) (b j) = 0) →
    ∃ e : QuadraticAlgebra K (signedDiscriminant q b) 0 ≃ₐ[K]
        Subalgebra.center K (CliffordAlgebra.even q),
      ((e QuadraticAlgebra.omega).val : CliffordAlgebra q) = volumeElement q b

/-- The two vectors in one basis pair have polar value one, and distinct pairs are orthogonal. -/
def IsSymplecticBasis {n : ℕ} (q : QuadraticForm K V)
    (b : Module.Basis (Fin n ⊕ Fin n) K V) : Prop :=
  (∀ i j, q.polarBilin (b (.inl i)) (b (.inl j)) = 0) ∧
  (∀ i j, q.polarBilin (b (.inr i)) (b (.inr j)) = 0) ∧
  ∀ i j, q.polarBilin (b (.inl i)) (b (.inr j)) = if i = j then 1 else 0

/-- The representative of the Arf invariant supplied by a symplectic basis. -/
def arf {n : ℕ} (q : QuadraticForm K V) (b : Module.Basis (Fin n ⊕ Fin n) K V) : K :=
  ∑ i, q (b (.inl i)) * q (b (.inr i))

def arfElement {n : ℕ} (q : QuadraticForm K V) (b : Module.Basis (Fin n ⊕ Fin n) K V) :
    CliffordAlgebra q :=
  ∑ i, CliffordAlgebra.ι q (b (.inl i)) * CliffordAlgebra.ι q (b (.inr i))

/-- In characteristic two the center is generated by the indicated Artin–Schreier element. -/
def ArfCenter : Prop :=
  ∀ {K : Type u} [Field K] [CharP K 2] {V : Type v} [AddCommGroup V] [Module K V]
    (q : QuadraticForm K V) {n : ℕ} (b : Module.Basis (Fin n ⊕ Fin n) K V),
    0 < n → IsSymplecticBasis q b →
    ∃ e : QuadraticAlgebra K (arf q b) 1 ≃ₐ[K]
        Subalgebra.center K (CliffordAlgebra.even q),
      ((e QuadraticAlgebra.omega).val : CliffordAlgebra q) = arfElement q b ∧
      ∀ x : V, arfElement q b * CliffordAlgebra.ι q x =
        CliffordAlgebra.ι q x * (arfElement q b + 1)

/-- The two even factors, represented by one algebra equivalence so that they
are the actual simple components. -/
def EvenCliffordFactors (q : QuadraticForm K V) (A B : _root_.CSA.{u, v} K) : Prop :=
  Nonempty (CliffordAlgebra.even q ≃ₐ[K] A × B)

def HasEvenDivisionClass {D : Type u} [Ring D] [Algebra K D]
    (q : QuadraticForm K V) : Prop :=
  ∃ A B : _root_.CSA.{u, v} K, EvenCliffordFactors q A B ∧
    _root_.Specs.RM03.Brauer.equivalent K A D ∧ _root_.Specs.RM03.Brauer.equivalent K B D

/-- In characteristic different from two the anisotropic four-space is a scaled quaternion norm,
with square signed discriminant and the same quaternion class in both even factors. -/
def OddQuaternionKernel : Prop :=
  ∀ {K : Type u} [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K] {V : Type v} [AddCommGroup V] [Module K V]
    (q : QuadraticForm K V) (b : Module.Basis (Fin (2 * 2)) K V),
    (2 : K) ≠ 0 → IsRegular q → ¬ IsIsotropic q →
    ∃ (scale a c : K), scale ≠ 0 ∧ a ≠ 0 ∧ c ≠ 0 ∧
      let D := QuaternionAlgebra K a 0 c
      ∃ hD : _root_.Specs.RM03.CSA.isCentralSimple K D,
        (∀ x : D, x ≠ 0 → IsUnit x) ∧
        (∃ e : V ≃ₗ[K] D, ∀ x, q x = scale * _root_.Specs.RM03.CSA.reducedNorm hD (e x)) ∧
        IsSquare (signedDiscriminant q b) ∧ HasEvenDivisionClass (D := D) q

/-- The symbol `[d,c)` with `i²+i=d`, `j²=c` and `ji=(i+1)j`. -/
abbrev Symbol (K : Type u) [Field K] (d c : K) := QuaternionAlgebra K d 1 c

/-- The class of `d` in the Artin–Schreier quotient is zero. -/
def IsArtinSchreier (d : K) : Prop := ∃ x : K, x ^ 2 + x = d

/-- The norm subgroup of the quadratic étale algebra `K[i]/(i²+i+d)`. -/
def normSubgroup (d : K) : Subgroup Kˣ :=
  (Units.map (QuadraticAlgebra.norm (R := K) (a := d) (b := 1))).range

/-- Norms characterize splitting of the cyclic symbol, and its Brauer class
is additive in the Artin–Schreier parameter and multiplicative in the unit parameter. -/
def SymbolIdentities : Prop :=
  ∀ {K : Type u} [Field K] [CharP K 2] (d e : K) (c t : Kˣ),
    _root_.Specs.RM03.CSA.isCentralSimple K (Symbol K d c) ∧
    (_root_.Specs.RM03.CSA.isSplit K (Symbol K d c) ↔ c ∈ normSubgroup d) ∧
    _root_.Specs.RM03.Brauer.equivalent K ((Symbol K d c) ⊗[K] (Symbol K e c)) (Symbol K (d + e) c) ∧
    _root_.Specs.RM03.Brauer.equivalent K ((Symbol K d c) ⊗[K] (Symbol K d t)) (Symbol K d (c * t : Kˣ))

/-- Each nonzero Artin–Schreier class over a local field has a nonsplit symbol
presentation of the quaternion division class. Its norm group has index two.
Distinct nonzero classes have distinct norm groups, with product the full unit group. -/
def LocalNormGroups : Prop :=
  ∀ {K : Type u} [Field K] [CharP K 2] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K] (d : K), ¬ IsArtinSchreier d →
    (∃ c : Kˣ, ¬ _root_.Specs.RM03.CSA.isSplit K (Symbol K d c) ∧
      ∀ x : Symbol K d c, x ≠ 0 → IsUnit x) ∧
    ∃ χ : Kˣ →* Multiplicative (ZMod 2),
      Function.Surjective χ ∧ χ.ker = normSubgroup d ∧ (normSubgroup d).index = 2 ∧
      (∀ a b : Kˣ, χ a = χ b ↔
        _root_.Specs.RM03.Brauer.equivalent K (Symbol K d a) (Symbol K d b)) ∧
      ∀ e : K, ¬ IsArtinSchreier e → ¬ IsArtinSchreier (d + e) →
        normSubgroup d ≠ normSubgroup e ∧ normSubgroup d ⊔ normSubgroup e = ⊤

/-- In characteristic two an anisotropic four-space has zero Arf invariant.
The specified symplectic coordinates give its quaternion norm presentation
and both of its actual even factors have the division Brauer class. -/
def CharTwoQuaternionKernel : Prop :=
  ∀ {K : Type u} [Field K] [CharP K 2] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K] {V : Type v} [AddCommGroup V] [Module K V]
    (q : QuadraticForm K V) (b : Module.Basis (Fin 2 ⊕ Fin 2) K V),
    IsSymplecticBasis q b → ¬ IsIsotropic q →
    let a := q (b (.inl 0))
    let d := a * q (b (.inr 0))
    let c := q (b (.inl 1)) / a
    let D := Symbol K d c
    a ≠ 0 ∧ c ≠ 0 ∧ ¬ IsArtinSchreier d ∧ IsArtinSchreier (arf q b) ∧
      ∃ hD : _root_.Specs.RM03.CSA.isCentralSimple K D,
        (∀ x : D, x ≠ 0 → IsUnit x) ∧
        (∃ e : V ≃ₗ[K] D, ∀ x, q x = a * _root_.Specs.RM03.CSA.reducedNorm hD (e x)) ∧
        HasEvenDivisionClass (D := D) q

/-- In either characteristic a hyperbolic plane preserves the two component
classes of a regular even form with split even center. -/
def HyperbolicCliffordFactors : Prop :=
  ∀ {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (q : QuadraticForm K V), IsRegular q →
    Even (Module.finrank K V) →
    ∀ (A B : _root_.CSA.{u, v} K), EvenCliffordFactors q A B →
      ∃ A' B' : _root_.CSA.{u, max u v} K,
        EvenCliffordFactors (q.prod (hyperbolic K 1)) A' B' ∧
        _root_.Specs.RM03.Brauer.equivalent K A' A ∧ _root_.Specs.RM03.Brauer.equivalent K B' B

/-- An anisotropic binary form in characteristic two is a scaled norm from
the separable quadratic field specified by its nonzero Arf class. -/
def CharTwoBinaryNorm : Prop :=
  ∀ {K : Type u} [Field K] [CharP K 2] {V : Type v} [AddCommGroup V] [Module K V]
    (q : QuadraticForm K V) (b : Module.Basis (Fin 1 ⊕ Fin 1) K V),
    IsSymplecticBasis q b → ¬ IsIsotropic q →
    let a := q (b (.inl 0))
    let d := arf q b
    a ≠ 0 ∧ ¬ IsArtinSchreier d ∧ IsField (QuadraticAlgebra K d 1) ∧
      ∃ e : V ≃ₗ[K] QuadraticAlgebra K d 1,
        ∀ x, q x = a * QuadraticAlgebra.norm (e x)

section Cubic

variable {F E S : Type u} [Field F] [Field E] [Field S]
  [Algebra F E] [Algebra F S] [Algebra E S] [IsScalarTower F E S]

/-- The inclusion selecting the vector vertex among the three embeddings of the cubic field. -/
abbrev vectorEmbedding : E →ₐ[F] S := IsScalarTower.toAlgHom F E S

/-- The half-spin vertices are the other two embeddings of the cubic field. -/
abbrev HalfSpinVertices (F E S : Type u) [Field F] [Field E] [Field S]
    [Algebra F E] [Algebra F S] [Algebra E S] [IsScalarTower F E S] :=
  {e : E →ₐ[F] S // e ≠ vectorEmbedding}

/-- The residual diagram action fixes the two half-spin vertices individually. -/
def ResidualActionTrivial (F E S : Type u) [Field F] [Field E] [Field S]
    [Algebra F E] [Algebra F S] [Algebra E S] [IsScalarTower F E S] : Prop :=
  ∀ (σ : Gal(S/E)) (e : E →ₐ[F] S),
    ((σ.restrictScalars F).toAlgHom).comp e = e

/-- Extension of a vector in the scalar-extended Albert space to the field
where all three Peirce blocks are marked. -/
def extendAlbertVector (J : AlbertModel F) (x : E ⊗[F] J.V) : S ⊗[F] J.V :=
  TensorProduct.map (vectorEmbedding (F := F) (E := E) (S := S)).toLinearMap
    LinearMap.id x

/-- The geometric block of index `i`, with diagonal and all other blocks zero. -/
def geometricPeirceBlock (i : Fin 3) : Submodule S (TrialitySpecification.Model S) :=
  LinearMap.ker (LinearMap.fst S (Fin 3 → S) (Fin 3 → Zorn S)) ⊓
    ⨅ j : {j : Fin 3 // j ≠ i},
      LinearMap.ker ((LinearMap.proj j.val).comp
        (LinearMap.snd S (Fin 3 → S) (Fin 3 → Zorn S)))

/-- The Peirce space over the diagram field, defined by the actual geometric
block under the comparison taking the cubic algebra to the diagonal. -/
def peirceSpace {J : AlbertModel F}
    (t : S ⊗[F] J.V ≃ₗ[S] TrialitySpecification.Model S) (i : Fin 3) :
    Submodule E (E ⊗[F] J.V) :=
  (Submodule.restrictScalars E
      ((geometricPeirceBlock (S := S) i).comap t.toLinearMap)).comap
    (TensorProduct.AlgebraTensorModule.map
      (Algebra.ofId E S).toLinearMap LinearMap.id)

/-- The rank-eight quadratic form on the marked Peirce block of the cubic stabilizer. -/
structure CubicPeirceModel (G : AffineAlgebraicGroup F) (D : DiagramPresentation G E S) where
  albert : AlbertModel F
  splitAlbert : SplitSpecification.IsSplitModel albert.law .octonion
  cubic : CubicStabilizer albert E
  realization : G.val ≅ cubic.stabilizer.group
  coordinates : S ⊗[F] albert.V ≃ₗ[S] TrialitySpecification.Model S
  unit : coordinates (1 ⊗ₜ[F] albert.law.unit) = CubicSpecification.cubicUnit
  law : ∀ x y, coordinates (albert.law.op S x y) =
    TrialitySpecification.modelOp (coordinates x) (coordinates y)
  diagonal : ∀ e : E, coordinates (1 ⊗ₜ[F] cubic.diagonal e) =
    (fun i => D.numbering.symm i e, 0)
  q : QuadraticForm E (Fin 8 → E)
  regular : IsRegular q
  vector : (Fin 8 → E) ≃ₗ[E] peirceSpace (E := E) coordinates (D.numbering vectorEmbedding)
  norm : ∀ x : Fin 8 → E,
    algebraMap E S (q x) = ZornSpecification.norm S
      ((coordinates (extendAlbertVector albert (vector x).val)).2 (D.numbering vectorEmbedding))

/-- The marked Peirce form identifies the actual scalar-extended group with its spin group. -/
structure CubicVectorModel (G : AffineAlgebraicGroup F) (D : DiagramPresentation G E S)
    extends CubicPeirceModel G D where
  spinPoints : ∀ R : TestAlgebra E,
    SpinSpecification.SchemePoints ((groupBaseChange F E).obj G.val) R →*
      (SpinSpecification.ScalarClifford q R)ˣ
  spin : SpinSpecification.IsSpinPointRepresentation q
    ((groupBaseChange F E).obj G.val) spinPoints
  /-- Clifford conjugation recovers the stabilizer action on the marked Peirce block
  after extending coefficients to each test algebra. -/
  spinVector : ∀ (R : TestAlgebra E)
      (p : SpinSpecification.SchemePoints ((groupBaseChange F E).obj G.val) R),
    let R₀ := (restrictTestAlgebra F E).obj R
    letI : Algebra F R := inferInstanceAs (Algebra F R₀)
    letI : IsScalarTower F E R := IsScalarTower.of_algebraMap_eq' rfl
    let j := (TensorProduct.AlgebraTensorModule.cancelBaseChange F E R R albert.V).toLinearMap ∘ₗ
      (((peirceSpace (E := E) coordinates (D.numbering vectorEmbedding)).subtype ∘ₗ
        vector.toLinearMap).baseChange R)
    let p₀ := baseChangePoint F E G.val.X R p
    let h := albert.action R₀ (p₀ ≫ realization.hom.hom.hom ≫ cubic.stabilizer.inclusion.hom.hom)
    ∀ x : R ⊗[E] (Fin 8 → E), ∃ y : R ⊗[E] (Fin 8 → E),
      j y = h (j x) ∧ SpinSpecification.vectors q R y =
        SpinSpecification.conjugate q R (spinPoints R p) (SpinSpecification.vectors q R x)

/-- The even Clifford center has the two half-spin labels with their actual
Galois action over the diagram field. -/
def LabelsAgree {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D)
    (labels : (Subalgebra.center E (CliffordAlgebra.even M.q) →ₐ[E] S) ≃
      HalfSpinVertices F E S) : Prop :=
  ∀ (σ : Gal(S/E)) f,
    (labels (σ.toAlgHom.comp f)).val = (σ.restrictScalars F).toAlgHom.comp (labels f).val

/-- The actual coordinate of the scalar-extended diagonal algebra at `e`. -/
def diagonalCoordinate {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D) (e : E →ₐ[F] S) (x : E ⊗[F] E) : S :=
  (M.coordinates (extendAlbertVector M.albert (M.cubic.diagonal.baseChange E x))).1 (D.numbering e)

/-- Polarizing the quadratic Jordan operator at the two complementary axes gives
the projection onto the block labelled by the missing axis. -/
def geometricPeirceProjector (i : Fin 3) (x : TrialitySpecification.Model S) :
    TrialitySpecification.Model S :=
  QuadraticOperatorSpecification.triple (ZornSpecification.norm S) (fun _ => 1)
    (FrameSpecification.frameAxis (HermitianSpecification.cyclicNext i)) x
    (FrameSpecification.frameAxis (HermitianSpecification.cyclicPrev i))

/-- The Galois action on the scalar coefficients, expressed in the marked Albert coordinates. -/
def geometricCoefficientAction {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D) (τ : Gal(S/F)) (x : TrialitySpecification.Model S) :
    TrialitySpecification.Model S :=
  M.coordinates (τ.toAlgHom.toLinearMap.rTensor M.albert.V (M.coordinates.symm x))

/-- The diagonal coordinates and quadratic Peirce projectors use the same forward permutation. -/
def CyclicLabelTransport {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D) : Prop :=
  (∀ (e : E →ₐ[F] S) (a b : E),
    diagonalCoordinate M e (a ⊗ₜ[F] b) = vectorEmbedding (F := F) a * e b) ∧
  ∀ (σ : Gal(E/F)) (τ : Gal(S/F)),
    τ.toAlgHom.comp vectorEmbedding = vectorEmbedding.comp σ.toAlgHom →
    ∀ e : E →ₐ[F] S,
      τ.toAlgHom.comp e = e.comp σ.toAlgHom ∧
      (∀ x : E ⊗[F] E,
        diagonalCoordinate M (τ.toAlgHom.comp e) (TensorProduct.map σ.toLinearMap LinearMap.id x) =
          τ (diagonalCoordinate M e x)) ∧
      ∀ x : TrialitySpecification.Model S,
        geometricCoefficientAction M τ (geometricPeirceProjector (D.numbering e) x) =
          geometricPeirceProjector (D.numbering (τ.toAlgHom.comp e)) (geometricCoefficientAction M τ x)

/-- The product of two vector Clifford generators on a half-spin block is the
composition of their polar products with the Albert unit. -/
def halfSpinVectorProduct {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D) (j : HalfSpinVertices F E S)
    (v w : Fin 8 → E) (x : Zorn S) : Zorn S :=
  let act (y : Fin 8 → E) (z : TrialitySpecification.Model S) :=
    QuadraticOperatorSpecification.triple (ZornSpecification.norm S) (fun _ => 1)
      (M.coordinates (extendAlbertVector M.albert (M.vector y).val)) CubicSpecification.cubicUnit z
  (act v (act w (CubicSpecification.singleBlockCoordinates (D.numbering j.val) x))).2
    (D.numbering j.val)

/-- Over the separable closure, the labelled factors act on the actual half-spin
Peirce coordinates by the Clifford products from the Albert law. -/
def GeometricCliffordComparison {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D)
    (labels : (Subalgebra.center E (CliffordAlgebra.even M.q) →ₐ[E] S) ≃
      HalfSpinVertices F E S) : Prop :=
  ∃ f : (S ⊗[E] CliffordAlgebra.even M.q) ≃ₐ[S]
      (∀ _ : HalfSpinVertices F E S, Module.End S (Zorn S)),
    (∀ j v w x, f (1 ⊗ₜ[E] (CliffordAlgebra.even.ι M.q).bilin v w) j x =
      halfSpinVectorProduct M j v w x) ∧
    ∀ j (z : Subalgebra.center E (CliffordAlgebra.even M.q)),
      f (1 ⊗ₜ[E] z.val) j = algebraMap S _ ((labels.symm j) z)

/-- When the residual action is trivial, the algebra factors are the endomorphism
algebras of the two half-spin Peirce spaces over `E`, with their central labels.
All three eight-dimensional spaces, including the vector space, are transported
by the cubic Galois action. Acting by `σ` on the tensor coefficients takes the
space with label `e` to the space with label `e.comp σ.toAlgHom`. Conjugation by
this semilinear map is the forward coefficient conjugacy of their endomorphism algebras.
Each label is reached from the marked vector label, and its endomorphism
algebra is a split matrix algebra. -/
def CyclicCliffordComparison {G : AffineAlgebraicGroup F} {D : DiagramPresentation G E S}
    (M : CubicPeirceModel G D)
    (labels : (Subalgebra.center E (CliffordAlgebra.even M.q) →ₐ[E] S) ≃
      HalfSpinVertices F E S) : Prop :=
  (∀ e : E →ₐ[F] S, Module.finrank E (peirceSpace (E := E) M.coordinates (D.numbering e)) = 8) ∧
  (∀ e : E →ₐ[F] S,
    (∃ σ : Gal(E/F), vectorEmbedding.comp σ.toAlgHom = e) ∧
    Nonempty (Module.End E (peirceSpace (E := E) M.coordinates (D.numbering e)) ≃ₐ[E]
      Matrix (Fin 8) (Fin 8) E)) ∧
  (∀ (σ : Gal(E/F)) (e : E →ₐ[F] S) (x : E ⊗[F] M.albert.V),
    x ∈ peirceSpace (E := E) M.coordinates (D.numbering e) ↔
      TensorProduct.map σ.toLinearMap LinearMap.id x ∈
        peirceSpace (E := E) M.coordinates (D.numbering (e.comp σ.toAlgHom))) ∧
  CyclicLabelTransport M ∧
  (∀ (σ : Gal(E/F)) (e : E →ₐ[F] S),
    let W := peirceSpace (E := E) M.coordinates (D.numbering e)
    let W' := peirceSpace (E := E) M.coordinates (D.numbering (e.comp σ.toAlgHom))
    ∃ c : Module.End E W ≃+* Module.End E W',
      (∀ a : E, c (algebraMap E _ a) = algebraMap E _ (σ a)) ∧
      ∀ (a : Module.End E W) (x : W) (y : W'),
        TensorProduct.map σ.toLinearMap LinearMap.id x.val = y.val →
        (c a y).val = TensorProduct.map σ.toLinearMap LinearMap.id (a x).val) ∧
  ∃ f : CliffordAlgebra.even M.q ≃ₐ[E]
      (∀ j : HalfSpinVertices F E S,
        Module.End E (peirceSpace (E := E) M.coordinates (D.numbering j.val))),
    (∀ j (z : Subalgebra.center E (CliffordAlgebra.even M.q)),
      ∃ c : E, f z.val j = algebraMap E _ c ∧
        (labels.symm j) z = algebraMap E S c) ∧
    ∀ j v w (x : peirceSpace (E := E) M.coordinates (D.numbering j.val)),
      let y := f ((CliffordAlgebra.even.ι M.q).bilin v w) j x
      (M.coordinates (extendAlbertVector M.albert y.val)).2 (D.numbering j.val) =
        halfSpinVectorProduct M j v w
          ((M.coordinates (extendAlbertVector M.albert x.val)).2 (D.numbering j.val))

/-- The residual transposition gives a binary anisotropic kernel. The trivial
residual action gives a hyperbolic vector form and a split group. -/
def TrialitarianCubicSplitting : Prop :=
  ∀ (F E S : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [Field E] [Field S] [Algebra F E] [Algebra F S]
    [Algebra E S] [IsScalarTower F E S]
    [Module.Finite F E] [Algebra.IsSeparable F E] [IsSepClosure F S],
    Module.finrank F E = 3 → ∀ (G : AffineAlgebraicGroup F) (D : DiagramPresentation G E S),
    ∃ (M : CubicVectorModel G D)
      (labels : (Subalgebra.center E (CliffordAlgebra.even M.q) →ₐ[E] S) ≃
        HalfSpinVertices F E S),
      LabelsAgree M.toCubicPeirceModel labels ∧
      GeometricBorelConjugacy.IsQuasiSplit (Unipotent.baseChangedAlgebraicGroup E G) ∧
      (ResidualActionTrivial F E S →
        IsGalois F E ∧ CyclicCliffordComparison M.toCubicPeirceModel labels ∧
          M.q.Equivalent (hyperbolic E 4) ∧ HasWittIndex M.q 4 ∧
          GeometricRadicals.IsSplitReductive (Unipotent.baseChangedAlgebraicGroup E G)) ∧
      (¬ ResidualActionTrivial F E S →
        ∃ q₀ : QuadraticForm E (Fin 2 → E), IsRegular q₀ ∧ ¬ IsIsotropic q₀ ∧
          M.q.Equivalent ((hyperbolic E 3).prod q₀) ∧ HasWittIndex M.q 3) ∧
      GeometricCliffordComparison M.toCubicPeirceModel labels

end Cubic

end

end LinearAlgebraicGroups.Specs.Arithmetic.TrialitarianCliffordInvariants
