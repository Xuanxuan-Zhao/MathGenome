import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ExceptionalAffineBruhat
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.IsSepClosed

namespace LinearAlgebraicGroups.Specs.RamifiedExceptionalAuxiliaryTower

open ValuativeRel IsLocalRing
open scoped WithZero ValuativeRel
open ExceptionalLocalRootCoordinates (normalizedValuation residueMap ramificationIndex)
open ExceptionalAffineBruhat (DiagramCompositum IsUnramifiedLocalExtension)

universe u
noncomputable section

set_option maxHeartbeats 1500000

attribute [local instance] ExceptionalLocalRootCoordinates.canonicalExtension

/-- An actual field map together with its restriction to the valuation rings. -/
structure ValuedFieldMap {K E : Type u} [Field K] [Field E] [ValuativeRel K]
    [ValuativeRel E] (f : K →+* E) where
  integers : 𝒪[K] →+* 𝒪[E]
  [isLocal : IsLocalHom integers]
  field_eq (z : 𝒪[K]) : (integers z : E) = f (z : K)

attribute [instance] ValuedFieldMap.isLocal

abbrev ValuedFieldMap.residue {K E : Type u} [Field K] [Field E] [ValuativeRel K]
    [ValuativeRel E] {f : K →+* E} (e : ValuedFieldMap f) : 𝓀[K] →+* 𝓀[E] :=
  ResidueField.map e.integers

/-- An actual intermediate field of the chosen separable closure, with its
finite unramified local structure. -/
structure UnramifiedLevel (F S : Type u) [Field F] [Field S] [Algebra F S]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] where
  field : IntermediateField F S
  [finite : FiniteDimensional F field]
  [galois : IsGalois F field]
  [valuative : ValuativeRel field]
  [topology : TopologicalSpace field]
  [localField : IsNonarchimedeanLocalField field]
  [extendsBase : ValuativeExtension F field]
  unramified : IsUnramifiedLocalExtension F field

attribute [instance] UnramifiedLevel.finite UnramifiedLevel.galois UnramifiedLevel.valuative
  UnramifiedLevel.topology UnramifiedLevel.localField UnramifiedLevel.extendsBase

instance {F S : Type u} [Field F] [Field S] [Algebra F S] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] : Preorder (UnramifiedLevel F S) :=
  Preorder.lift UnramifiedLevel.field

abbrev UnramifiedLevel.inclusion {F S : Type u} [Field F] [Field S] [Algebra F S]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    {k k' : UnramifiedLevel F S} (h : k ≤ k') : k.field →ₐ[F] k'.field :=
  IntermediateField.inclusion (show k.field ≤ k'.field from h)

/-- Every actual finite unramified subfield has the Galois structure used
in the coefficient-level index. -/
def FiniteUnramifiedSubfieldsAreGalois : Prop :=
  ∀ {F S : Type u} [Field F] [Field S] [Algebra F S]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K : IntermediateField F S) [FiniteDimensional F K]
    [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K] [ValuativeExtension F K],
    IsUnramifiedLocalExtension F K → IsGalois F K

/-- A degree-`d` auxiliary extension generated by a distinguished
uniformizer root. -/
structure UniformizerRootExtension (K : Type u) [Field K] [ValuativeRel K]
    (d : ℕ) (π : K) where
  field : Type u
  [fieldInstance : Field field]
  [algebra : Algebra K field]
  [valuative : ValuativeRel field]
  [topology : TopologicalSpace field]
  [localField : IsNonarchimedeanLocalField field]
  [valuativeExtension : ValuativeExtension K field]
  [finite : FiniteDimensional K field]
  root : fieldˣ
  degree : Module.finrank K field = d
  power : (root : field) ^ d = algebraMap K field π
  generated : Algebra.adjoin K ({(root : field)} : Set field) = ⊤
  residue_bijective : Function.Bijective (residueMap K field)

attribute [instance] UniformizerRootExtension.fieldInstance UniformizerRootExtension.algebra
  UniformizerRootExtension.valuative UniformizerRootExtension.topology
  UniformizerRootExtension.localField UniformizerRootExtension.valuativeExtension
  UniformizerRootExtension.finite

section Tower

variable {F L S : Type u} [Field F] [Field L] [Field S] [Algebra F L] [Algebra F S]
  [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
  [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension F L]
  {σ : Gal(L/F)}

variable (T : ∀ k : UnramifiedLevel F S, DiagramCompositum F L k.field σ)

abbrev coefficientResidue (k : UnramifiedLevel F S) :=
  residueMap k.field (T k).field

/-- The field and residue comparisons along actual inclusions of the
coefficient subfields, using the given tensor composita. -/
structure AuxiliaryTransition {k k' : UnramifiedLevel F S} (h : k ≤ k') {d : ℕ} {π : L}
    (E : UniformizerRootExtension (T k).field d (algebraMap L (T k).field π))
    (E' : UniformizerRootExtension (T k').field d (algebraMap L (T k').field π)) where
  coefficient : ValuedFieldMap (UnramifiedLevel.inclusion h).toRingHom
  diagram : (T k).field →ₐ[F] (T k').field
  diagram_left (z : L) : diagram (algebraMap L (T k).field z) = algebraMap L (T k').field z
  diagram_right (z : k.field) :
    diagram (algebraMap k.field (T k).field z) =
      algebraMap k'.field (T k').field (UnramifiedLevel.inclusion h z)
  diagramValued : ValuedFieldMap diagram.toRingHom
  auxiliary : E.field →+* E'.field
  auxiliary_diagram (z : (T k).field) :
    auxiliary (algebraMap (T k).field E.field z) = algebraMap (T k').field E'.field (diagram z)
  auxiliary_root : auxiliary (E.root : E.field) = E'.root
  valued : ValuedFieldMap auxiliary
  diagram_residue :
    diagramValued.residue.comp (coefficientResidue T k) =
      (coefficientResidue T k').comp coefficient.residue
  auxiliary_residue :
    valued.residue.comp (residueMap (T k).field E.field) =
      (residueMap (T k').field E'.field).comp diagramValued.residue

/-- The local-field part of scaling over the finite unramified tower. -/
structure AuxiliaryTower (d : ℕ) (π : L) where
  ramifiedResidue : Function.Bijective (residueMap F L)
  base : UnramifiedLevel F S
  base_eq : base.field = ⊥
  directed : ∀ k k' : UnramifiedLevel F S, ∃ l, k ≤ l ∧ k' ≤ l
  extension : ∀ k, UniformizerRootExtension (T k).field d (algebraMap L (T k).field π)
  transition : ∀ {k k'} (h : k ≤ k'), AuxiliaryTransition T h (extension k) (extension k')
  transition_diagram_id (k) : (transition (le_refl k)).diagram = AlgHom.id F _
  transition_diagram_comp {k k' k''} (h : k ≤ k') (h' : k' ≤ k'') :
    (transition (h.trans h')).diagram = (transition h').diagram.comp (transition h).diagram
  transition_id (k) : (transition (le_refl k)).auxiliary = RingHom.id _
  transition_comp {k k' k''} (h : k ≤ k') (h' : k' ≤ k'') :
    (transition (h.trans h')).auxiliary = (transition h').auxiliary.comp (transition h).auxiliary
  coefficientResidue_bijective (k) : Function.Bijective (coefficientResidue T k)
  action : ∀ k, Gal(k.field/F) →* (extension k).field ≃+* (extension k).field
  action_extends (k) (s : Gal(k.field/F)) (z : (T k).field) :
    action k s (algebraMap (T k).field (extension k).field z) =
      algebraMap (T k).field (extension k).field ((T k).coefficient s z)
  action_fixes_root (k) (s : Gal(k.field/F)) :
    action k s ((extension k).root : (extension k).field) = (extension k).root
  actionValued (k) (s : Gal(k.field/F)) : ValuedFieldMap (action k s).toRingHom
  action_natural {k k' : UnramifiedLevel F S} (h : k ≤ k') (s : Gal(k.field/F)) (s' : Gal(k'.field/F))
      (hs : ∀ z, s' (UnramifiedLevel.inclusion h z) = UnramifiedLevel.inclusion h (s z))
      (z : (extension k).field) :
    action k' s' ((transition h).auxiliary z) = (transition h).auxiliary (action k s z)
  residueEmbedding : ∀ k, 𝓀[(extension k).field] →+* AlgebraicClosure 𝓀[F]
  residue_base (k) :
    (residueEmbedding k).comp
      ((residueMap (T k).field (extension k).field).comp
        ((coefficientResidue T k).comp (residueMap F k.field))) =
      algebraMap 𝓀[F] (AlgebraicClosure 𝓀[F])
  residue_compatible {k k'} (h : k ≤ k') :
    (residueEmbedding k').comp (transition h).valued.residue = residueEmbedding k
  residue_exhaustive {Index : Type u} [Finite Index] (z : Index → AlgebraicClosure 𝓀[F]) :
    ∃ (k : UnramifiedLevel F S) (b : Index → 𝓀[(extension k).field]),
      ∀ i, residueEmbedding k (b i) = z i

end Tower

section ValuedCompatibility

variable {F L S : Type u} [Field F] [Field L] [Field S] [Algebra F L] [Algebra F S]
  [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
  [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension F L]
  {σ : Gal(L/F)} {T : ∀ k : UnramifiedLevel F S, DiagramCompositum F L k.field σ}
  {d : ℕ} {π : L}

/-- The geometric residue embeddings at the diagram and coefficient levels
are the restrictions along the canonical residue maps. -/
abbrev AuxiliaryTower.diagramResidueEmbedding (P : AuxiliaryTower T d π) (k : UnramifiedLevel F S) :
    𝓀[(T k).field] →+* AlgebraicClosure 𝓀[F] :=
  (P.residueEmbedding k).comp (residueMap (T k).field (P.extension k).field)

abbrev AuxiliaryTower.coefficientResidueEmbedding (P : AuxiliaryTower T d π) (k : UnramifiedLevel F S) :
    𝓀[k.field] →+* AlgebraicClosure 𝓀[F] :=
  (P.diagramResidueEmbedding k).comp (coefficientResidue T k)

/-- The auxiliary inclusions are functorial on integral and residue rings,
and the coefficient actions on those rings commute with actual restriction. -/
structure AuxiliaryTower.ValuedCompatibility (P : AuxiliaryTower T d π) : Prop where
  integers_id (k : UnramifiedLevel F S) :
    (P.transition (le_refl k)).valued.integers = RingHom.id _
  integers_comp {k k' k'' : UnramifiedLevel F S} (h : k ≤ k') (h' : k' ≤ k'') :
    (P.transition (h.trans h')).valued.integers =
      (P.transition h').valued.integers.comp (P.transition h).valued.integers
  residue_id (k : UnramifiedLevel F S) :
    (P.transition (le_refl k)).valued.residue = RingHom.id _
  residue_comp {k k' k'' : UnramifiedLevel F S} (h : k ≤ k') (h' : k' ≤ k'') :
    (P.transition (h.trans h')).valued.residue =
      (P.transition h').valued.residue.comp (P.transition h).valued.residue
  integers_action_one (k : UnramifiedLevel F S) :
    (P.actionValued k 1).integers = RingHom.id _
  integers_action_mul (k : UnramifiedLevel F S) (s t : Gal(k.field/F)) :
    (P.actionValued k (s * t)).integers =
      (P.actionValued k s).integers.comp (P.actionValued k t).integers
  residue_action_one (k : UnramifiedLevel F S) :
    (P.actionValued k 1).residue = RingHom.id _
  residue_action_mul (k : UnramifiedLevel F S) (s t : Gal(k.field/F)) :
    (P.actionValued k (s * t)).residue =
      (P.actionValued k s).residue.comp (P.actionValued k t).residue
  integers_action_natural {k k' : UnramifiedLevel F S} (h : k ≤ k')
      (s : Gal(k.field/F)) (s' : Gal(k'.field/F))
      (hs : ∀ z, s' (UnramifiedLevel.inclusion h z) = UnramifiedLevel.inclusion h (s z)) :
    (P.actionValued k' s').integers.comp (P.transition h).valued.integers =
      (P.transition h).valued.integers.comp (P.actionValued k s).integers
  residue_action_natural {k k' : UnramifiedLevel F S} (h : k ≤ k')
      (s : Gal(k.field/F)) (s' : Gal(k'.field/F))
      (hs : ∀ z, s' (UnramifiedLevel.inclusion h z) = UnramifiedLevel.inclusion h (s z)) :
    (P.actionValued k' s').residue.comp (P.transition h).valued.residue =
      (P.transition h).valued.residue.comp (P.actionValued k s).residue
  diagram_embedding_compatible {k k' : UnramifiedLevel F S} (h : k ≤ k') :
    (P.diagramResidueEmbedding k').comp (P.transition h).diagramValued.residue =
      P.diagramResidueEmbedding k
  coefficient_embedding_compatible {k k' : UnramifiedLevel F S} (h : k ≤ k') :
    (P.coefficientResidueEmbedding k').comp (P.transition h).coefficient.residue =
      P.coefficientResidueEmbedding k

end ValuedCompatibility

/-- The restrictions of the auxiliary comparison and action laws to the
actual valuation rings and residue fields. -/
def RamifiedAuxiliaryValuedCompatibility : Prop :=
  ∀ {F L S : Type u} [Field F] [Field L] [Field S] [Algebra F L] [Algebra F S]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension F L]
    {σ : Gal(L/F)} {T : ∀ k : UnramifiedLevel F S, DiagramCompositum F L k.field σ}
    {d : ℕ} {π : L} (P : AuxiliaryTower T d π),
    P.ValuedCompatibility

/-- Every specified uniformizer root gives the full valued auxiliary tower for
the given separable ramified quadratic diagram extension. -/
def RamifiedAuxiliaryTower : Prop :=
  ∀ {F L S : Type u} [Field F] [Field L] [Field S] [Algebra F L] [Algebra F S]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [ValuativeExtension F L]
    [FiniteDimensional F L] [IsGalois F L] [IsSepClosed S] [Algebra.IsSeparable F S]
    (σ : Gal(L/F)), Module.finrank F L = 2 → σ ≠ 1 → 1 < ramificationIndex F L →
    ∀ (T : ∀ k : UnramifiedLevel F S, DiagramCompositum F L k.field σ)
      (d : ℕ), 0 < d → ∀ (π : L), normalizedValuation L π = WithZero.exp (-1) →
      Nonempty (AuxiliaryTower T d π)

end

end LinearAlgebraicGroups.Specs.RamifiedExceptionalAuxiliaryTower
