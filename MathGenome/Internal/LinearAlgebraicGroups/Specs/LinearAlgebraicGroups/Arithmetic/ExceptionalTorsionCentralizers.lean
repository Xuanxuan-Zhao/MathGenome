import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ComplexExceptionalDatum
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Arithmetic.ExceptionalAffineCorootStabilizers
import Mathlib.GroupTheory.OrderOfElement

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj

namespace LinearAlgebraicGroups.Specs.ExceptionalTorsionCentralizers

open AbsoluteDynkinTypes (IsAbsolutelyAlmostSimple)
open ComplexExceptionalDatum (HasExceptionalType)
open ExceptionalAffineCorootStabilizers (HighestRootAndVertices)
open AbstractPairing (Root)
open CharacterPairing (characterValue)
open DatumAndWeyl (Identification)
open OrderedRootProducts (RootSubgroupFamily)
open Pinning (AttachedDatum SplitBorelPair)
open SimplyConnectedLattice (GeometricallySimplyConnected)

noncomputable section

/-- The arithmetic input supplied by the parent's E-series computation. -/
def ExceptionalAlcoveInputs : Prop :=
  HighestRootAndVertices (![1, 2, 2, 3, 2, 1] : Fin 6 → ℤ) ∧
  HighestRootAndVertices (![2, 2, 3, 4, 3, 2, 1] : Fin 7 → ℤ) ∧
  HighestRootAndVertices (![2, 3, 4, 6, 5, 4, 3, 2] : Fin 8 → ℤ)

abbrev ComplexPoints (H : GroupScheme ℂ) :=
  (testSpec ℂ).obj (.op (CommAlgCat.of ℂ ℂ)) ⟶ H.X

def torusPoint {P : SplitBorelPair ℂ} (t : ComplexPoints P.T.group) : ComplexPoints P.G.val :=
  t ≫ P.T.inclusion.hom.hom

/-- The actual complex points of the roots trivial on the given torus point. -/
def RootGenerators {P : SplitBorelPair ℂ} (U : RootSubgroupFamily P.T)
    (t : ComplexPoints P.T.group) : Set (ComplexPoints P.G.val) :=
  {g | ∃ α : Root P.T, characterValue α.val (CommAlgCat.of ℂ ℂ) t = 1 ∧
      g ∈ SubgroupSections (U α).val ((testSpec ℂ).obj (.op (CommAlgCat.of ℂ ℂ)))}

/-- The normalizer points that also commute with a given torus point. -/
def NormalizerGenerators {P : SplitBorelPair ℂ} [IsCommMonObj P.T.group.X]
    {D : AbstractPairing.Datum P.T} (I : Identification D) (t : ComplexPoints P.T.group) :
    Set (ComplexPoints P.G.val) :=
  {g | g ∈ SubgroupSections I.normalizer ((testSpec ℂ).obj (.op (CommAlgCat.of ℂ ℂ))) ∧
    Commute (torusPoint t) g}

/-- The Bruhat generation statement on a split pair before eliminating the
centralizing normalizer representatives. -/
def BruhatCentralizerStatement : Prop :=
  ∀ P : SplitBorelPair ℂ, ∃ D : AttachedDatum P, letI := D.comm
    ∃ (I : Identification D.datum) (U : RootSubgroupFamily P.T),
      ∀ t : ComplexPoints P.T.group,
        Subgroup.centralizer ({torusPoint t} : Set (ComplexPoints P.G.val)) =
          Subgroup.closure
            ((Set.range (torusPoint (P := P)) ∪ RootGenerators U t) ∪ NormalizerGenerators I t)

/-- Stabilizer in the Weyl group acting by the attached normalizer conjugations. -/
def WeylStabilizer {P : SplitBorelPair ℂ} (D : AttachedDatum P) :
    letI := D.comm
    Identification D.datum → ComplexPoints P.T.group → Prop :=
  letI := D.comm
  fun I t =>
    ∀ w : D.datum.rootDatum.weylGroup,
      t ≫ ((I.image.conjugation (I.labelEquiv w)).hom.hom.hom) = t ↔
      w ∈ Subgroup.closure
        {s | ∃ α : Root P.T, characterValue α.val (CommAlgCat.of ℂ ℂ) t = 1 ∧
          s = RootPairing.weylGroup.ofIdx D.datum.rootDatum α}

def CentralizerOfTorusPoint : Prop :=
  ∀ P : SplitBorelPair ℂ, ∃ D : AttachedDatum P, letI := D.comm
    ∃ (I : Identification D.datum) (U : RootSubgroupFamily P.T),
      ∀ t : ComplexPoints P.T.group, WeylStabilizer D I t →
        Subgroup.centralizer ({torusPoint t} : Set (ComplexPoints P.G.val)) =
          Subgroup.closure (Set.range (torusPoint (P := P)) ∪ RootGenerators U t)

/-- Every finite-order point of the actual complexification lies in a split
maximal torus. Its point centralizer is generated by that torus and the
attached root groups whose characters are trivial at the point. -/
def Statement : Prop :=
  ExceptionalAlcoveInputs →
  ∀ G : AffineAlgebraicGroup ℝ, IsAbsolutelyAlmostSimple G →
    GeometricallySimplyConnected G → HasExceptionalType G →
    let H := Unipotent.baseChangedAlgebraicGroup ℂ G
    ∀ t : ComplexPoints H.val, IsOfFinOrder t →
      ∃ (P : SplitBorelPair ℂ) (hP : P.G = H) (s : ComplexPoints P.T.group)
        (D : AttachedDatum P) (U : RootSubgroupFamily P.T),
        (hP ▸ torusPoint s : ComplexPoints H.val) = t ∧
        (letI := D.comm
         ∃ I : Identification D.datum,
           WeylStabilizer D I s) ∧
        Subgroup.centralizer ({torusPoint s} : Set (ComplexPoints P.G.val)) =
          Subgroup.closure (Set.range (torusPoint (P := P)) ∪ RootGenerators U s)

end

end LinearAlgebraicGroups.Specs.ExceptionalTorsionCentralizers
