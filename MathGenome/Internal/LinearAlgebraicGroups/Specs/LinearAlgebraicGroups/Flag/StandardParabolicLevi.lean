import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Flag.BruhatCells
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Reductive.BorelProper
import MathGenome.Internal.LinearAlgebraicGroups.Specs.LinearAlgebraicGroups.Reductive.SubtorusCentralizer

open AlgebraicGeometry CategoryTheory
open CategoryTheory.CartesianMonoidalCategory
open scoped CategoryTheory.MonoidalCategory CategoryTheory.MonObj

universe u

namespace LinearAlgebraicGroups.Specs.StandardParabolicLevi

open AbstractPairing (Datum Root)
open BorelsAndChambers (IsRegular contractingSubgroup positiveRoots subgroupRoots)
open BorelProper (IsParabolic)
open BruhatOrbitParametrization (Cell IsRepresentative OrderedParametrization)
open CharacterDescent (Cocharacter)
open CharacterPairing (absoluteRoots pairing)
open DatumAndWeyl (Identification)
open GeometricBorelConjugacy (IsKBorel subgroupOfSubgroup)
open GeometricRadicals (GeometricGroup IsReductive IsSplitReductive IsSplitTorus IsTorus
  IsUnipotentRadical baseChangedSubgroup)
open OrderedRootProducts (RootSubgroupFamily)
open QuotientEmbedding (Presentation)
open RankOneFlag (IsGeometricallyMaximal)
open SchemeDerivedGroup (IsSubgroupOf)
open SimpleRoots (IsBaseFor evaluate)
open SubtorusCentralizer (IsCentralizer)
open Unipotent (closedSubgroupAlgebraicGroup)
open LinearAlgebraicGroups.CocharacterDynamics (LimitDecomposition)

variable {k : Type u} [Field k] {G : AffineAlgebraicGroup k} {T : ClosedSubgroup G.val}
variable [IsCommMonObj T.group.X] {D : Datum T}

/-- The absolute roots in the integral span of the selected simple roots. -/
def leviRoots (D : Datum T) (I : Set (Root T)) : Set (Root T) :=
  {α | D.rootDatum.root α ∈ Submodule.span ℤ (D.rootDatum.root '' I)}

/-- The subgroup generated by the simple reflections with indices in (I). -/
noncomputable def parabolicWeylGroup (D : Datum T) (I : Set (Root T)) : Subgroup D.rootDatum.weylGroup :=
  Subgroup.closure (RootPairing.weylGroup.ofIdx D.rootDatum '' I)

/-- The largest torus contained in the common kernel of the selected roots. -/
def IsCommonKernelTorus (I : Set (Root T)) (S : ClosedSubgroup T.group) : Prop :=
  IsSplitTorus S.group ∧
    (∀ α ∈ I, S.inclusion ≫ α.val = 1) ∧
    (∀ H : ClosedSubgroup T.group, IsTorus H.group →
      (∀ α ∈ I, H.inclusion ≫ α.val = 1) → IsSubgroupOf H S)

/-- The cocharacter lies in the relative interior of the specified chamber face. -/
def HasFace (b : D.rootDatum.Base) (I : Set (Root T)) (c : Cocharacter T.group) : Prop :=
  (∀ α ∈ I, pairing T.group α.val c = 0) ∧
  (∀ α ∈ (b.support : Set (Root T)) \ I, 0 < pairing T.group α.val c)

/-- The contracting kernel is the unipotent radical, including after geometric
base change. -/
def IsContractingRadical {c : Cocharacter G.val} (L : LimitDecomposition c) : Prop :=
  let P := closedSubgroupAlgebraicGroup L.parabolic
  let U := contractingSubgroup L
  IsUnipotentRadical P U ∧
    ∃ h : IsClosedImmersion
      ((groupBaseChange k (AlgebraicClosure k)).map U.inclusion).hom.hom.left,
      IsUnipotentRadical (GeometricGroup P) (baseChangedSubgroup (AlgebraicClosure k) U h)

/-- The limit construction supplies the semidirect product via its section,
kernel and multiplication in `LimitDecomposition`. -/
structure StandardParabolic (B : ClosedSubgroup G.val) (D : Datum T)
    (b : D.rootDatum.Base) (U : RootSubgroupFamily T) (I : Set (Root T)) where
  kernelTorus : ClosedSubgroup T.group
  isKernelTorus : IsCommonKernelTorus I kernelTorus
  cocharacter : Cocharacter T.group
  face : HasFace b I cocharacter
  factorsThroughKernelTorus : ∃ c : Cocharacter kernelTorus.group, c ≫ kernelTorus.inclusion = cocharacter
  limitGroups : LimitDecomposition (cocharacter ≫ T.inclusion)
  parabolic : IsParabolic G limitGroups.parabolic
  containsBorel : IsSubgroupOf B limitGroups.parabolic
  centralizer : IsCentralizer (subgroupOfSubgroup T kernelTorus) limitGroups.centralizer
  leviTorus : ClosedSubgroup limitGroups.centralizer.group
  torusIso : T.group ≅ leviTorus.group
  torusInclusion : torusIso.hom ≫ leviTorus.inclusion ≫ limitGroups.centralizer.inclusion = T.inclusion
  leviTorusMaximal : IsGeometricallyMaximal leviTorus
  leviSplit : IsSplitReductive (closedSubgroupAlgebraicGroup limitGroups.centralizer)
  leviRoots_eq : absoluteRoots leviTorus =
    (fun α : Root T ↦ torusIso.inv ≫ α.val) '' leviRoots D I
  radical : IsContractingRadical limitGroups
  orderedRadical : OrderedParametrization U (subgroupRoots T B \ leviRoots D I) limitGroups.contracting
  radicalInBorel : IsSubgroupOf limitGroups.contracting B

/-- Construction of the standard parabolics attached to all subsets of the
simple roots of the given Borel, with their Levi decompositions and actual
Bruhat indices. -/
def Statement : Prop :=
  ∀ {k : Type u} [Field k] (G : AffineAlgebraicGroup k), IsReductive G →
    ∀ (T B : ClosedSubgroup G.val), IsSplitTorus T.group → IsGeometricallyMaximal T →
      IsKBorel B → IsSubgroupOf T B →
      ∃ h : IsCommMonObj T.group.X, letI := h
        ∃ (D : Datum T) (W : Identification D) (U : RootSubgroupFamily T)
          (c : Cocharacter T.group) (b : D.rootDatum.Base),
          IsRegular T c ∧ positiveRoots T c = subgroupRoots T B ∧
          IsBaseFor D.rootDatum (evaluate D c) b ∧
          ∀ (I : Set (Root T)), I ⊆ b.support →
            ∃ P : StandardParabolic B D b U I,
              (∀ w, ∃ n, IsRepresentative W w n) ∧ Nonempty (Presentation B) ∧
              ∀ (Q : Presentation B)
                (n : D.rootDatum.weylGroup → (𝟙_ (SchemeOver k) ⟶ W.normalizer.group.X)),
                (∀ w, IsRepresentative W w (n w)) →
                let g := fun w ↦ n w ≫ W.normalizer.inclusion.hom.hom
                ∃ (a : ModObj G.val.X Q.scheme)
                  (A : D.rootDatum.weylGroup → ClosedSubgroup G.val)
                  (C : ∀ w, Cell (T := T) Q a (g w) (A w)),
                  lift (fst G.val.X G.val.X) (snd G.val.X G.val.X ≫ Q.projection) ≫ a.smul =
                    μ[G.val.X] ≫ Q.projection ∧
                  (∀ w, g w ∈ SubgroupSections P.limitGroups.parabolic (𝟙_ (SchemeOver k)) ↔
                    w ∈ parabolicWeylGroup D I) ∧
                  (⋃ w : parabolicWeylGroup D I, Set.range (C w.val).doubleOrbitInclusion.left) =
                    Set.range P.limitGroups.parabolic.inclusion.hom.hom.left

end LinearAlgebraicGroups.Specs.StandardParabolicLevi
