/-- If the simple reflections generate the normalizer quotient, the rank-one
product rule identifies the union of the double cosets with the subgroup
generated by the Borel and the elementary parabolics. -/
private theorem doubleCosetUnion_subgroup {M N W : Type*} [Group M] [Group N] [Group W]
    {Δ : Type*} (B : Subgroup M) (P : Δ → Subgroup M) (s : Δ → W)
    (φ : N →* W) (inc : N →* M) (n : W → N)
    (hn : ∀ w, φ (n w) = w) (hker : ∀ t, φ t = 1 → inc t ∈ B)
    (hgen : Subgroup.closure (Set.range s) = ⊤)
    (hP : ∀ i, inc (n (s i)) ∈ P i)
    (hmul : ∀ v i,
      let C := fun w ↦ (B : Set M) * {inc (n w)} * (B : Set M)
      C v * (P i : Set M) ⊆ C v ∪ C (v * s i)) :
    ∃ H : Subgroup M, (H : Set M) = ⋃ w, (B : Set M) * {inc (n w)} * (B : Set M) := by
  let C := fun w ↦ (B : Set M) * {inc (n w)} * (B : Set M)
  let S := ⋃ w, C w
  let H := Subgroup.closure ((B : Set M) ∪ ⋃ i, (P i : Set M))
  have hBH : B ≤ H := fun _ hx ↦ Subgroup.subset_closure (Or.inl hx)
  have hPH (i : Δ) : P i ≤ H := fun _ hx ↦
    Subgroup.subset_closure (Or.inr (Set.mem_iUnion.mpr ⟨i, hx⟩))
  have hS : (1 : M) ∈ S := by
    have h : inc (n 1) ∈ B := hker _ (hn 1)
    apply Set.mem_iUnion.mpr
    refine ⟨1, ?_⟩
    change (1 : M) ∈ (B : Set M) * {inc (n 1)} * (B : Set M)
    simpa only [one_mul, mul_inv_cancel] using
      (Set.mul_mem_mul (Set.mul_mem_mul B.one_mem (Set.mem_singleton (inc (n 1)))) (B.inv_mem h))
  have hstableB (x y : M) (hx : x ∈ S) (hy : y ∈ B) : x * y ∈ S := by
    obtain ⟨v, hv⟩ := Set.mem_iUnion.mp hx
    obtain ⟨z, hz, b, hb, rfl⟩ := Set.mem_mul.mp hv
    exact Set.mem_iUnion.mpr ⟨v, by
      rw [mul_assoc]
      exact Set.mul_mem_mul hz (B.mul_mem hb hy)⟩
  have hstableP (i : Δ) (x y : M) (hx : x ∈ S) (hy : y ∈ P i) : x * y ∈ S := by
    obtain ⟨v, hv⟩ := Set.mem_iUnion.mp hx
    rcases hmul v i (Set.mul_mem_mul hv hy) with hh | hh
    · exact Set.mem_iUnion.mpr ⟨v, hh⟩
    · exact Set.mem_iUnion.mpr ⟨v * s i, hh⟩
  have hpreserve (y : M) (hy : y ∈ H) :
      ∀ x ∈ S, x * y ∈ S ∧ x * y⁻¹ ∈ S := by
    induction hy using Subgroup.closure_induction with
    | mem y hy =>
      rcases hy with hy | hy
      · exact fun x hx ↦ ⟨hstableB x y hx hy, hstableB x y⁻¹ hx (B.inv_mem hy)⟩
      · obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
        exact fun x hx ↦ ⟨hstableP i x y hx hi, hstableP i x y⁻¹ hx ((P i).inv_mem hi)⟩
    | one => simp
    | mul y z _ _ hy hz =>
      intro x hx
      exact ⟨by simpa only [mul_assoc] using (hz (x * y) (hy x hx).1).1,
        by simpa only [mul_inv_rev, mul_assoc] using (hy (x * z⁻¹) (hz x hx).2).2⟩
    | inv y _ hy => simpa only [inv_inv] using fun x hx ↦ (hy x hx).symm
  have htop : (H.comap inc).map φ = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact Subgroup.mem_map.mpr ⟨n (s i), hPH i (hP i), hn _⟩
  have hrep (w : W) : inc (n w) ∈ H := by
    have hw : w ∈ (H.comap inc).map φ := htop ▸ Subgroup.mem_top w
    obtain ⟨a, ha, ha'⟩ := Subgroup.mem_map.mp hw
    have ht : inc (a⁻¹ * n w) ∈ H :=
      hBH (hker _ (by rw [map_mul, map_inv, ha', hn, inv_mul_cancel]))
    have ht' := H.mul_mem (show inc a ∈ H from ha) ht
    simpa only [map_mul, map_inv, mul_inv_cancel_left] using ht'
  refine ⟨H, Set.Subset.antisymm ?_ ?_⟩
  · intro x hx
    simpa only [one_mul] using (hpreserve x hx 1 hS).1
  · intro x hx
    obtain ⟨w, hw⟩ := Set.mem_iUnion.mp hx
    exact Subgroup.mul_subset (Subgroup.mul_subset hBH (Set.singleton_subset_iff.mpr (hrep w))) hBH hw

variable {k : Type u} [Field k] {G : AffineAlgebraicGroup k}

private def affineLine (k : Type u) [Field k] : SchemeOver k :=
  (testSpec k).obj (.op (CommAlgCat.of k (Polynomial k)))

private theorem rootScheme_isAffineLine {T : ClosedSubgroup G.val}
    (U : RootSubgroupFamily T) (i : Root T) :
    Nonempty ((U i).val.group.X ≅ affineLine k) := by
  have hu : IsSplitAdditive (U i).val.group := (U i).property.2.1
  obtain ⟨operations, _, _, _, ⟨e⟩⟩ := hu
  exact ⟨(Grp.forget (SchemeOver k)).mapIso e⟩

private def rootProductAffineIso {T : ClosedSubgroup G.val} (U : RootSubgroupFamily T) :
    (l : List (Root T)) →
      OrderedRootProducts.product (fun i ↦ (U i).val.group.X) l ≅ affineSpace k l.length
  | [] => Iso.refl _
  | i :: l => MonoidalCategory.tensorIso (rootScheme_isAffineLine U i).some
      (rootProductAffineIso U l)

open private existsEnumeration from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Flag.BruhatOrbitParametrization

private theorem length_of_enumeration {I : Type u} [Finite I] {S : Set I} {l : List I}
    (hl : Enumerates l S) : l.length = S.ncard := by
  classical
  have he : l.toFinset = (Set.toFinite S).toFinset := by
    ext i
    simp [hl.2 i]
  rw [Set.ncard_eq_toFinset_card _, ← he, List.toFinset_card_of_nodup hl.1]

private theorem orbit_affineSpace {T : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    (D : Datum T) (U : RootSubgroupFamily T) {A : ClosedSubgroup G.val} {X : SchemeOver k}
    {S : Set (Root T)} {l : ℕ} (hS : Specs.BruhatOrbitParametrization.OrderedParametrization U S A)
    (hlen : l = S.ncard) (e : A.group.X ≅ X) :
    Nonempty (X ≅ affineSpace k l) := by
  let := D.finiteRoots
  obtain ⟨roots, hr⟩ := existsEnumeration S
  obtain ⟨p, _⟩ := hS roots hr
  rw [hlen, ← length_of_enumeration hr]
  exact ⟨e.symm ≪≫ p.symm ≪≫ rootProductAffineIso U roots⟩

private def groundPointIso (K : Type u) [Field K] :
    𝟙_ (SchemeOver K) ≅ (testSpec K).obj (.op (CommAlgCat.of K K)) :=
  Over.isoMk (Iso.refl (Spec (CommRingCat.of K))) (by
    change (𝟙 (Spec (CommRingCat.of K))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K K)) = 𝟙 _
    rw [Category.id_comp]
    exact Spec.map_id _)

/-- Projection from scalar extension on rational points over the new field. -/
private def extendedPointEquiv (K : Type u) [Field K] [Algebra k K] (X : SchemeOver k) :
    (𝟙_ (SchemeOver K) ⟶ (baseChange k K).obj X) ≃
      (Over.mk (fieldSpecMap k K) ⟶ X) :=
  (Iso.homCongr (groundPointIso K) (Iso.refl _)).trans
    (Equiv.ofBijective _ (baseChangePoints k K X (CommAlgCat.of K K)))

private theorem extendedPointEquiv_apply (K : Type u) [Field K] [Algebra k K]
    (X : SchemeOver k) (p : 𝟙_ (SchemeOver K) ⟶ (baseChange k K).obj X) :
    extendedPointEquiv K X p = baseChangePoint k K X (CommAlgCat.of K K)
      ((groundPointIso K).inv ≫ p) := by
  change baseChangePoint k K X (CommAlgCat.of K K) ((groundPointIso K).inv ≫ p ≫ 𝟙 _) = _
  rw [Category.comp_id]

private theorem extendedPointEquiv_comp (K : Type u) [Field K] [Algebra k K]
    {X Z : SchemeOver k} (f : X ⟶ Z)
    (p : 𝟙_ (SchemeOver K) ⟶ (baseChange k K).obj X) :
    extendedPointEquiv K Z (p ≫ (baseChange k K).map f) = extendedPointEquiv K X p ≫ f := by
  rw [extendedPointEquiv_apply, extendedPointEquiv_apply, ← Category.assoc (groundPointIso K).inv]
  exact baseChangePointsSchemeNaturality k K f (CommAlgCat.of K K) ((groundPointIso K).inv ≫ p)

private def extendedPointMulEquiv (K : Type u) [Field K] [Algebra k K] (M : GroupScheme k) :
    (𝟙_ (SchemeOver K) ⟶ ((groupBaseChange k K).obj M).X) ≃*
      (Over.mk (fieldSpecMap k K) ⟶ M.X) where
  toEquiv := extendedPointEquiv K M.X
  map_mul' p q := by
    change extendedPointEquiv K M.X (p * q) =
      extendedPointEquiv K M.X p * extendedPointEquiv K M.X q
    let e := (groundPointIso K).inv
    let R := CommAlgCat.of K K
    have h₁ := extendedPointEquiv_apply K M.X (p * q)
    have h₂ := congrArg (baseChangePoint k K M.X R) (MonObj.comp_mul e p q)
    have h₃ := baseChangePointsGroupLaw k K M R (e ≫ p) (e ≫ q)
    have h₄ := congrArg₂ (· * ·) (extendedPointEquiv_apply K M.X p).symm
      (extendedPointEquiv_apply K M.X q).symm
    exact h₁.trans (h₂.trans (h₃.trans h₄))

private theorem rationalPoint_of_nonempty {K : Type u} [Field K] [IsAlgClosed K]
    (X : SchemeOver K) [LocallyOfFiniteType X.hom] [Nonempty X.left] :
    Nonempty (𝟙_ (SchemeOver K) ⟶ X) := by
  let : JacobsonSpace X.left := LocallyOfFiniteType.jacobsonSpace X.hom
  obtain ⟨x, _, hx⟩ := nonempty_inter_closedPoints
    (Set.univ_nonempty (α := X.left)) isOpen_univ.isLocallyClosed
  exact ⟨Over.homMk (pointOfClosedPoint X.hom x hx) (pointOfClosedPoint_comp X.hom x hx)⟩

/-- A subgroup containing the rational points of a dense open subset over an
algebraically closed field contains every rational point. -/
private theorem subgroup_eq_top_of_denseOpen {K : Type u} [Field K] [IsAlgClosed K]
    (M : GroupScheme K) [LocallyOfFiniteType M.X.hom] {V : SchemeOver K}
    (i : V ⟶ M.X) [IsOpenImmersion i.left] (hd : DenseRange i.left)
    (H : Subgroup (𝟙_ (SchemeOver K) ⟶ M.X))
    (hH : ∀ v : 𝟙_ (SchemeOver K) ⟶ V, v ≫ i ∈ H) : H = ⊤ := by
  apply top_unique
  intro g _
  let L : M.X ≅ M.X :=
    { hom := (toUnit _ ≫ g) * 𝟙 _
      inv := (toUnit _ ≫ g⁻¹) * 𝟙 _
      hom_inv_id := by
        simp only [MonObj.comp_mul, comp_toUnit_assoc, Category.comp_id, GrpObj.comp_inv,
          inv_mul_cancel_left]
      inv_hom_id := by
        simp only [MonObj.comp_mul, comp_toUnit_assoc, Category.comp_id, GrpObj.comp_inv,
          mul_inv_cancel_left] }
  let j := i ≫ L.hom
  let : IsIso L.hom.left := ((Over.forget (Spec (CommRingCat.of K))).mapIso L).isIso_hom
  let : IsOpenImmersion j.left := by
    change IsOpenImmersion (i.left ≫ L.hom.left)
    infer_instance
  let : LocallyOfFiniteType V.hom := by rw [← Over.w i]; infer_instance
  have hn : Nonempty V.left := by
    have hM : Nonempty M.X.left :=
      ⟨(η[M.X] : 𝟙_ (SchemeOver K) ⟶ M.X).left (IsLocalRing.closedPoint K)⟩
    obtain ⟨v, _⟩ := hd.exists_mem_open isOpen_univ (Set.univ_nonempty (α := M.X.left))
    exact ⟨v⟩
  obtain ⟨v, w, hw⟩ := hd.exists_mem_open (IsOpenImmersion.isOpen_range j.left)
    (Set.range_nonempty j.left)
  let F := pullback i j
  let pi := pullback.fst i j
  let pj := pullback.snd i j
  have hp := (IsPullback.of_hasPullback i j).map (Over.forget _)
  obtain ⟨z, _, _⟩ := Scheme.exists_preimage_of_isPullback hp v w hw.symm
  let : Nonempty F.left := ⟨z⟩
  let : IsOpenImmersion pj.left :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hp (show IsOpenImmersion i.left from inferInstance)
  let : LocallyOfFiniteType F.hom := by rw [← Over.w pj]; infer_instance
  obtain ⟨t⟩ := rationalPoint_of_nonempty F
  have heq : (t ≫ pi) ≫ i = g * ((t ≫ pj) ≫ i) := by
    simp only [Category.assoc, pi, pj, pullback.condition]
    change (t ≫ pullback.snd i j) ≫ i ≫ L.hom = _
    simp only [L, MonObj.comp_mul, comp_toUnit_assoc, Category.comp_id]
    rw [toUnit_unit, Category.id_comp, Category.assoc]
  have ht := H.mul_mem (hH (t ≫ pi)) (H.inv_mem (hH (t ≫ pj)))
  rwa [heq, mul_inv_cancel_right] at ht

private theorem range_of_fppfImage {Y X Z : SchemeOver k} (f : X ⟶ Z) (g : Y ⟶ Z)
    (h : (Sieve.generate (Presieve.singleton f)).pullback g ∈ fppfOver k Y)
    (y : Y.left) : g.left y ∈ Set.range f.left := by
  rw [GrothendieckTopology.mem_over_iff] at h
  have hle : Scheme.fppfTopology ≤ Scheme.jointlySurjectiveTopology := by
    rw [Scheme.jointlySurjectiveTopology_eq_toGrothendieck_jointlySurjectivePretopology,
      Scheme.jointlySurjectivePretopology, Precoverage.toGrothendieck_toPretopology_eq_toGrothendieck]
    exact Precoverage.toGrothendieck_mono (show Scheme.fppfPrecoverage ≤
      Scheme.jointlySurjectivePrecoverage from inf_le_left)
  have hcover := Scheme.mem_jointlySurjectiveTopology_iff_jointlySurjectivePretopology.mp (hle _ h)
  obtain ⟨W, q, hq, v, hv⟩ := hcover y
  cases hq with
  | @of Z' q' hm =>
    change q' v = y at hv
    change (Sieve.overEquiv Y ((Sieve.generate (Presieve.singleton f)).pullback g)) q' at hm
    rw [Sieve.overEquiv_iff] at hm
    obtain ⟨A, a, d, hd, hfac⟩ := hm
    cases hd
    exact ⟨a.left v, by
      have hh : a.left ≫ f.left = q' ≫ g.left := congrArg (fun p ↦ p.left) hfac
      have hh' := congrArg (fun p : Z' ⟶ Z.left ↦ p v) hh
      change f.left (a.left v) = g.left (q' v) at hh'
      exact hh'.trans (congrArg (fun z : Y.left ↦ g.left z) hv)⟩

private theorem lift_of_range {K : Type u} [Field K] [Algebra k K] [IsAlgClosed K]
    {X Z : SchemeOver k} (f : X ⟶ Z) [LocallyOfFiniteType f.left]
    (g : Over.mk (fieldSpecMap k K) ⟶ Z)
    (h : g.left (IsLocalRing.closedPoint K) ∈ Set.range f.left) :
    ∃ p : Over.mk (fieldSpecMap k K) ⟶ X, p ≫ f = g := by
  let Y := Over.mk (fieldSpecMap k K)
  let F := pullback f.left g.left
  let p := pullback.fst f.left g.left
  let q := pullback.snd f.left g.left
  obtain ⟨x, hx⟩ := h
  have hp := IsPullback.of_hasPullback f.left g.left
  obtain ⟨z, _, _⟩ := Scheme.exists_preimage_of_isPullback hp x (IsLocalRing.closedPoint K) hx
  let E : SchemeOver K := Over.mk q
  let : Nonempty E.left := ⟨z⟩
  let : LocallyOfFiniteType E.hom :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hp inferInstance
  obtain ⟨t⟩ := rationalPoint_of_nonempty E
  have ht : t.left ≫ q = 𝟙 _ := Over.w t
  have ht' : (t.left ≫ p) ≫ f.left = g.left := by
    change (t.left ≫ pullback.fst f.left g.left) ≫ f.left = _
    rw [Category.assoc, pullback.condition, ← Category.assoc, ht, Category.id_comp]
  refine ⟨Over.homMk (t.left ≫ p) ?_, Over.OverMorphism.ext ht'⟩
  rw [← Over.w f, ← Category.assoc, ht', Over.w g]

private def pointHom {M N : GroupScheme k} (f : M ⟶ N) (Y : SchemeOver k) :
    (Y ⟶ M.X) →* (Y ⟶ N.X) := ((yonedaGrp.map f).app (.op Y)).hom

private def restrictPointHom (M : GroupScheme k) (Y : SchemeOver k) :
    (𝟙_ (SchemeOver k) ⟶ M.X) →* (Y ⟶ M.X) where
  toFun x := toUnit Y ≫ x
  map_one' := by simp only [MonObj.comp_one]
  map_mul' := MonObj.comp_mul (toUnit Y)

private def normalizerLabel {T : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    {D : Datum T} (I : Identification D) :
    (𝟙_ (SchemeOver k) ⟶ I.normalizer.group.X) →* D.rootDatum.weylGroup :=
  I.labelEquiv.symm.toMonoidHom.comp
    ((LocallyConstant.evalMonoidHom (IsLocalRing.closedPoint k)).comp
      ((I.image.constantGroup.families _).toMonoidHom.comp (pointHom I.quotient _)))

private theorem normalizer_isRepresentative {T : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    {D : Datum T} (I : Identification D) (n : 𝟙_ (SchemeOver k) ⟶ I.normalizer.group.X) :
    IsRepresentative I (normalizerLabel I n) n := by
  let F := I.image.constantGroup.families (𝟙_ (SchemeOver k))
  have hu : toUnit (𝟙_ (SchemeOver k)) = 𝟙 _ := Subsingleton.elim _ _
  apply F.injective
  rw [← Category.id_comp (I.image.constantGroup.sectionPoint _), ← hu,
    I.image.constantGroup.constant]
  apply LocallyConstant.ext
  intro x
  let : Subsingleton (𝟙_ (SchemeOver k)).left :=
    inferInstanceAs (Subsingleton (Spec (CommRingCat.of k)))
  have hx : x = IsLocalRing.closedPoint k := Subsingleton.elim _ _
  rw [hx]
  change F (n ≫ I.quotient.hom.hom) _ =
    I.labelEquiv (I.labelEquiv.symm (F (n ≫ I.quotient.hom.hom) _))
  rw [MulEquiv.apply_symm_apply]

private theorem normalizerLabel_eq {T : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    {D : Datum T} (I : Identification D) {w : D.rootDatum.weylGroup}
    {n : 𝟙_ (SchemeOver k) ⟶ I.normalizer.group.X} (hn : IsRepresentative I w n) :
    normalizerLabel I n = w := by
  change I.labelEquiv.symm
    (I.image.constantGroup.families _ (n ≫ I.quotient.hom.hom) (IsLocalRing.closedPoint k)) = w
  rw [show n ≫ I.quotient.hom.hom = I.image.constantGroup.sectionPoint (I.labelEquiv w) from hn]
  have hu : toUnit (𝟙_ (SchemeOver k)) = 𝟙 _ := Subsingleton.elim _ _
  rw [← Category.id_comp (I.image.constantGroup.sectionPoint _), ← hu,
    I.image.constantGroup.constant]
  exact I.labelEquiv.symm_apply_apply w

open private schemeKernel_sections from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Affine.SchemeImageQuotient
open private section_mem_of_le from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Flag.BruhatOrbitParametrization

private theorem normalizerLabel_ker {T B : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    {D : Datum T} (I : Identification D) (hTB : SchemeDerivedGroup.IsSubgroupOf T B)
    (Y : SchemeOver k) (n : 𝟙_ (SchemeOver k) ⟶ I.normalizer.group.X)
    (hn : normalizerLabel I n = 1) :
    toUnit Y ≫ n ≫ I.normalizer.inclusion.hom.hom ∈ SubgroupSections B Y := by
  have hq : n ≫ I.quotient.hom.hom = 1 := by
    have h := normalizer_isRepresentative I n
    rw [hn] at h
    exact h.trans (by rw [map_one, map_one])
  obtain ⟨t, ht⟩ := (schemeKernel_sections I.isQuotient.1 n).mpr hq
  apply section_mem_of_le hTB
  change t ≫ I.torusInclusion.hom.hom = n at ht
  refine ⟨toUnit Y ≫ t, ?_⟩
  change (toUnit Y ≫ t) ≫ T.inclusion.hom.hom = toUnit Y ≫ n ≫ I.normalizer.inclusion.hom.hom
  have hI := congrArg (Grp.forget (SchemeOver k)).map I.inclusion_eq
  change I.torusInclusion.hom.hom ≫ I.normalizer.inclusion.hom.hom = T.inclusion.hom.hom at hI
  rw [Category.assoc, ← hI, ← Category.assoc t, ht]

/-- A rational point of the normalizer lies in the double coset of one of the
chosen lifts for any identification of the normalizer quotient. -/
private theorem doubleCoset_of_normalizer {T B : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    {D : Datum T} (I : Identification D) (hTB : SchemeDerivedGroup.IsSubgroupOf T B)
    (n : D.rootDatum.weylGroup → (𝟙_ (SchemeOver k) ⟶ I.normalizer.group.X))
    (hn : ∀ w, IsRepresentative I w (n w)) (Y : SchemeOver k)
    (p : 𝟙_ (SchemeOver k) ⟶ G.val.X) (hp : Normalizes T.inclusion p) :
    ∃ w, doubleCoset B Y p = doubleCoset B Y (n w ≫ I.normalizer.inclusion.hom.hom) := by
  obtain ⟨q, rfl⟩ := (I.representsNormalizer _ _).mp hp
  let w := normalizerLabel I q
  refine ⟨w, ?_⟩
  let f := (pointHom I.normalizer.inclusion Y).comp (restrictPointHom I.normalizer.group Y)
  let d := (n w)⁻¹ * q
  have hd : normalizerLabel I d = 1 := by
    rw [show d = (n w)⁻¹ * q from rfl, map_mul, map_inv,
      normalizerLabel_eq I (hn w), inv_mul_cancel]
  have hB : f d ∈ SubgroupSections B Y := normalizerLabel_ker I hTB Y d hd
  have hqd : f q = f (n w) * f d := by rw [← map_mul, show n w * d = q by simp [d]]
  let S : Set (Y ⟶ G.val.X) := SubgroupSections B Y
  change S * {f q} * S = S * {f (n w)} * S
  rw [hqd, ← Set.singleton_mul_singleton, mul_assoc S, mul_assoc S,
    mul_assoc {f (n w)}, Subgroup.singleton_mul_subgroup hB]

private theorem representative_mem_doubleCoset (B : ClosedSubgroup G.val) (Y : SchemeOver k)
    (p : 𝟙_ (SchemeOver k) ⟶ G.val.X) :
    toUnit Y ≫ p ∈ doubleCoset B Y p := by
  let S := SubgroupSections B Y
  change toUnit Y ≫ p ∈ (S : Set (Y ⟶ G.val.X)) * {toUnit Y ≫ p} * (S : Set (Y ⟶ G.val.X))
  simpa only [one_mul, mul_one] using
    Set.mul_mem_mul (Set.mul_mem_mul S.one_mem (Set.mem_singleton (toUnit Y ≫ p))) S.one_mem

private theorem doubleCoset_eq_range {T B : ClosedSubgroup G.val}
    {Q : QuotientEmbedding.Presentation B} {a : ModObj G.val.X Q.scheme}
    {p : 𝟙_ (SchemeOver k) ⟶ G.val.X} {A : ClosedSubgroup G.val}
    (C : Cell (T := T) Q a p A) (Y : SchemeOver k) (g : Y ⟶ G.val.X) :
    g ∈ doubleCoset B Y p ↔ ∃ x : Y ⟶ C.doubleOrbit, x ≫ C.doubleOrbitInclusion = g := by
  rw [C.doubleOrbitSections Y g]
  constructor
  · rintro ⟨z, ⟨b₁, ⟨a₁, rfl⟩, _, hm, rfl⟩, b₂, ⟨a₂, rfl⟩, rfl⟩
    rw [Set.mem_singleton_iff.mp hm]
    exact ⟨a₁, a₂, rfl⟩
  · rintro ⟨b₁, b₂, rfl⟩
    exact Set.mul_mem_mul
      (Set.mul_mem_mul (show b₁ ≫ B.inclusion.hom.hom ∈ SubgroupSections B Y from ⟨b₁, rfl⟩)
        (Set.mem_singleton _))
      (show b₂ ≫ B.inclusion.hom.hom ∈ SubgroupSections B Y from ⟨b₂, rfl⟩)

open private baseChangeMapIsPullback from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Flag.HomogeneousQuotient

private theorem evaluate_root {T : ClosedSubgroup G.val} [IsCommMonObj T.group.X]
    (D : Datum T) (c : CharacterDescent.Cocharacter T.group) (i : Root T) :
    evaluate D c (D.rootDatum.root i) = CharacterPairing.pairing T.group i.val c := by
  change D.rootDatum.toLinearMap (D.rootDatum.root i) (Additive.ofMul c) = _
  rw [D.root_eq, D.pairing_eq]

private theorem doubleCosets_cover_geometric
    (openCell : Specs.OpenCell.Statement.{u})
    (simpleProduct : Specs.SimpleParabolicProduct.Statement.{u})
    (hG : GeometricRadicals.IsReductive G) {T B Bneg : ClosedSubgroup G.val}
    (hT : GeometricRadicals.IsSplitTorus T.group) (hmax : RankOneFlag.IsGeometricallyMaximal T)
    (hB : GeometricBorelConjugacy.IsKBorel B) (hBneg : GeometricBorelConjugacy.IsKBorel Bneg)
    (hTB : SchemeDerivedGroup.IsSubgroupOf T B) (hTBneg : SchemeDerivedGroup.IsSubgroupOf T Bneg)
    (hneg : Specs.OpenCell.AreOpposite T B Bneg)
    {Rpos : ClosedSubgroup B.group} {Rneg : ClosedSubgroup Bneg.group}
    (hRpos : GeometricRadicals.IsUnipotentRadical (Unipotent.closedSubgroupAlgebraicGroup B) Rpos)
    (hRneg : GeometricRadicals.IsUnipotentRadical (Unipotent.closedSubgroupAlgebraicGroup Bneg) Rneg)
    (K : Type u) [Field K] [Algebra k K] [IsAlgClosed K]
    (g : Over.mk (fieldSpecMap k K) ⟶ G.val.X) :
    ∃ p : 𝟙_ (SchemeOver k) ⟶ G.val.X,
      Normalizes T.inclusion p ∧ g ∈ doubleCoset B (Over.mk (fieldSpecMap k K)) p := by
  classical
  let Y := Over.mk (fieldSpecMap k K)
  obtain ⟨hc, D, I, U, c, b, hcReg, hcPos, hb, hrep, hp⟩ :=
    simpleProduct G hG T B hT hmax hB hTB
  let := hc
  choose n hn using hrep
  let r := fun w ↦ n w ≫ I.normalizer.inclusion.hom.hom
  let s : b.support → D.rootDatum.weylGroup := fun i ↦ RootPairing.weylGroup.ofIdx D.rootDatum i.val
  let S := SubgroupSections B Y
  have hsimple (i : b.support) : ∃ P : Subgroup (Y ⟶ G.val.X),
      toUnit Y ≫ r (s i) ∈ P ∧
      ∀ w, doubleCoset B Y (r w) * (P : Set (Y ⟶ G.val.X)) ⊆
        doubleCoset B Y (r w) ∪ doubleCoset B Y (r (w * s i)) := by
    obtain ⟨wall, P, H, _, _, _, e, j, A, f, hj, _, _, _, _, _, _, _, hprod⟩ := hp i.val i.property
    obtain ⟨hP, _, _, hmul⟩ := hprod n hn K
    refine ⟨SubgroupSections P.parabolic Y, ?_, fun w ↦ (hmul w).1.le⟩
    change toUnit Y ≫ r (s i) ∈ (SubgroupSections P.parabolic Y : Set (Y ⟶ G.val.X))
    rw [show (SubgroupSections P.parabolic Y : Set (Y ⟶ G.val.X)) =
        (S : Set _) ∪ doubleCoset B Y (r (s i)) from hP]
    exact Or.inr (representative_mem_doubleCoset B Y (r (s i)))
  choose P hP hmul using hsimple
  let f := (pointHom I.normalizer.inclusion Y).comp (restrictPointHom I.normalizer.group Y)
  obtain ⟨J, hJ⟩ := doubleCosetUnion_subgroup S P s (normalizerLabel I) f n
    (fun w ↦ normalizerLabel_eq I (hn w)) (normalizerLabel_ker I hTB Y) hb.generates hP
    (fun w i ↦ hmul i w)
  change (J : Set _) = ⋃ w, doubleCoset B Y (r w) at hJ
  let : Finite I.image.labels := I.image.finite
  let : Finite D.rootDatum.weylGroup := Finite.of_injective I.labelEquiv I.labelEquiv.injective
  let : Fintype D.rootDatum.weylGroup := Fintype.ofFinite _
  let len := SimpleRoots.wordLength D.rootDatum b
  obtain ⟨w₀, _, hlong⟩ := Finset.exists_max_image Finset.univ len Finset.univ_nonempty
  have hpos (i : Root T) : b.IsPos i ↔ i ∈ subgroupRoots T B := by
    rw [hb.positive_iff, ← hcPos]
    change 0 < evaluate D c (D.rootDatum.root i) ↔ 0 < CharacterPairing.pairing T.group i.val c
    rw [evaluate_root]
  obtain ⟨hOpen, hDense, hTranslated⟩ :=
    openCell G hG T hT hmax B Bneg hB hBneg hTB hTBneg hneg Rneg Rpos hRneg hRpos
  let i := Specs.OpenCell.cellMap T Rneg Rpos
  let m := Specs.OpenCell.translatedCellMap T Rneg Rpos (r w₀)
  let db := Specs.OpenCell.doubleOrbitMap B (r w₀)
  have hmaxlen (v : D.rootDatum.weylGroup) : len v ≤ len w₀ :=
    hlong v (Finset.mem_univ v)
  have hm (z : Y ⟶ G.val.X) : (∃ p, p ≫ m = z) ↔ Specs.OpenCell.InFppfDoubleOrbit B (r w₀) z :=
    (hTranslated hc D I b hpos w₀ hmaxlen (n w₀) (hn w₀)).2 z
  let : LocallyOfFiniteType G.val.X.hom := G.property.2.1
  let : IsClosedImmersion B.inclusion.hom.hom.left := B.isClosedImmersion
  let : LocallyOfFiniteType B.group.X.hom := by rw [← Over.w B.inclusion.hom.hom]; infer_instance
  let : LocallyOfFiniteType (db.left ≫ G.val.X.hom) := by
    rw [Over.w db]
    let β := fst B.group.X B.group.X
    have hpb : IsPullback β.left (snd B.group.X B.group.X).left B.group.X.hom B.group.X.hom :=
      Over.isPullback_of_binaryFan_isLimit _ (tensorProductIsBinaryProduct B.group.X B.group.X)
    let : LocallyOfFiniteType β.left :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hpb.flip inferInstance
    change LocallyOfFiniteType ((B.group.X ⊗ B.group.X : SchemeOver k).hom)
    rw [← Over.w β]
    infer_instance
  let : LocallyOfFiniteType db.left := locallyOfFiniteType_of_comp db.left G.val.X.hom
  have hmemTranslated (p : Y ⟶ _) : p ≫ m ∈ doubleCoset B Y (r w₀) := by
    have h := hm (p ≫ m) |>.mp ⟨p, rfl⟩
    have hPoint := range_of_fppfImage db (p ≫ m) h (IsLocalRing.closedPoint K)
    obtain ⟨z, hz⟩ := lift_of_range db (p ≫ m) hPoint
    rw [← hz]
    change z ≫ ((fst _ _ ≫ B.inclusion.hom.hom) * (toUnit _ ≫ r w₀) *
      (snd _ _ ≫ B.inclusion.hom.hom)) ∈ doubleCoset B Y (r w₀)
    simp only [MonObj.comp_mul, comp_toUnit_assoc]
    have hb₁ : z ≫ fst _ _ ≫ B.inclusion.hom.hom ∈ SubgroupSections B Y := by
      refine ⟨z ≫ fst _ _, ?_⟩
      change (z ≫ fst _ _) ≫ B.inclusion.hom.hom = _
      exact Category.assoc ..
    have hb₂ : z ≫ snd _ _ ≫ B.inclusion.hom.hom ∈ SubgroupSections B Y := by
      refine ⟨z ≫ snd _ _, ?_⟩
      change (z ≫ snd _ _) ≫ B.inclusion.hom.hom = _
      exact Category.assoc ..
    exact Set.mul_mem_mul (Set.mul_mem_mul hb₁ (Set.mem_singleton _)) hb₂
  have hmem (p : Y ⟶ _) : p ≫ i ∈ J := by
    have hp : p ≫ m ∈ J := by
      change p ≫ m ∈ (J : Set _)
      rw [hJ]
      exact Set.mem_iUnion.mpr ⟨w₀, hmemTranslated p⟩
    have hr : toUnit Y ≫ r w₀ ∈ J := by
      change toUnit Y ≫ r w₀ ∈ (J : Set _)
      rw [hJ]
      exact Set.mem_iUnion.mpr ⟨w₀, representative_mem_doubleCoset B Y (r w₀)⟩
    have hpm : p ≫ m = (toUnit Y ≫ r w₀) * (p ≫ i) := by
      simp only [m, Specs.OpenCell.translatedCellMap, MonObj.comp_mul, comp_toUnit_assoc, i]
    have h := J.mul_mem (J.inv_mem hr) hp
    rwa [hpm, inv_mul_cancel_left] at h
  let M := (groupBaseChange k K).obj G.val
  let iK := (baseChange k K).map i
  let : IsOpenImmersion iK.left :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (baseChangeMapIsPullback K i).flip hOpen
  let : LocallyOfFiniteType M.X.hom :=
    MorphismProperty.pullback_snd _ _ inferInstance
  let E := extendedPointMulEquiv K G.val
  have htop : J.comap E.toMonoidHom = ⊤ := by
    refine subgroup_eq_top_of_denseOpen M iK (hDense K) _ ?_
    intro p
    change extendedPointEquiv K G.val.X (p ≫ iK) ∈ J
    rw [extendedPointEquiv_comp K i p]
    exact hmem _
  have hg : g ∈ J := by
    have h := show E.symm g ∈ J.comap E.toMonoidHom from htop ▸ Subgroup.mem_top _
    change E (E.symm g) ∈ J at h
    rwa [MulEquiv.apply_symm_apply] at h
  change g ∈ (J : Set _) at hg
  rw [hJ] at hg
  obtain ⟨w, hw⟩ := Set.mem_iUnion.mp hg
  exact ⟨r w, (I.representsNormalizer _ _).mpr ⟨n w, rfl⟩, hw⟩

open private exists_field_point from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.DiagonalizableFixedLocus

private theorem exists_geometric_point (X : SchemeOver k) (x : X.left) :
    ∃ (K : Type u) (_ : Field K) (_ : Algebra k K) (_ : IsAlgClosed K)
      (p : Over.mk (fieldSpecMap k K) ⟶ X), p.left (IsLocalRing.closedPoint K) = x := by
  obtain ⟨L, _, _, p, hp⟩ := exists_field_point X x
  let K := AlgebraicClosure L
  let φ := (algebraMap L K).comp (algebraMap k L)
  letI : Algebra k K := φ.toAlgebra
  let e : Over.mk (fieldSpecMap k K) ⟶ Over.mk (fieldSpecMap k L) :=
    Over.homMk (Spec.map (CommRingCat.ofHom (algebraMap L K))) (by
      exact (Spec.map_comp (CommRingCat.ofHom (algebraMap k L))
        (CommRingCat.ofHom (algebraMap L K))).symm)
  exact ⟨K, inferInstance, inferInstance, inferInstance, e ≫ p, by
    change p.left (e.left (IsLocalRing.closedPoint K)) = x
    have hpoint : e.left (IsLocalRing.closedPoint K) = IsLocalRing.closedPoint L := by
      change (_ : Spec (CommRingCat.of L)) = _
      exact Subsingleton.elim _ _
    rw [hpoint]
    exact hp⟩

set_option maxHeartbeats 1200000 in
/-- Conditional form of the split Bruhat stratification, using the open cell
and simple parabolic product theorems in the specified order. -/
theorem bruhatCells_conditional.{v}
    (openCell : Specs.OpenCell.Statement.{v})
    (simpleProduct : Specs.SimpleParabolicProduct.Statement.{v}) :
    Specs.BruhatCells.Statement.{v} := by
  classical
  intro k _ G hG T B hT hmax hB hTB
  obtain ⟨hc, D, I, U, Bneg, Rpos, Rneg, hBneg, hTBneg, hneg, hRpos, hRneg, hrep, hQ, hdata⟩ :=
    _root_.LinearAlgebraicGroups.Flag.BruhatOrbitParametrization.bruhatOrbitParametrization G hG T B hT hmax hB hTB
  let := hc
  obtain ⟨_, _, _, _, c, _, hreg, hpos, _⟩ :=
    simpleProduct G hG T B hT hmax hB hTB
  let := D.finiteRoots
  let := D.freeCharacters
  let := D.finiteCharacters
  let := D.reduced
  have hreg' (i : Root T) : evaluate D c (D.rootDatum.root i) ≠ 0 := by
    rw [evaluate_root]
    exact hreg i
  obtain ⟨b, hb⟩ := _root_.LinearAlgebraicGroups.RootData.SimpleRoots.baseFor D.rootDatum (evaluate D c) hreg'
  refine ⟨hc, D, I, U, Bneg, Rpos, Rneg, c, b, hBneg, hTBneg, hneg, hRpos, hRneg,
    hreg, hpos, hb, hrep, hQ, ?_⟩
  intro Q
  obtain ⟨a, ha, cells⟩ := hdata Q
  refine ⟨a, ha, ?_⟩
  intro n hn
  dsimp only
  obtain ⟨A, V, C, hC, hdisj⟩ := cells n hn
  refine ⟨A, C, ?_, hdisj, ?_⟩
  · intro w
    refine ⟨(hC w).1, (hC w).2.2.1, ?_⟩
    apply orbit_affineSpace D U (hC w).2.2.1 _ (C w).orbitIso
    rw [hb.length_eq, hb.inversions_eq]
    congr 1
    have hplus : SimpleRoots.positive D.rootDatum (evaluate D c) = subgroupRoots T B := by
      rw [← hpos]
      ext i
      change 0 < evaluate D c (D.rootDatum.root i) ↔ 0 < CharacterPairing.pairing T.group i.val c
      rw [evaluate_root]
    have hminus : {i | evaluate D c (D.rootDatum.root i) < 0} = subgroupRoots T Bneg := by
      rw [hneg, ← hplus]
      ext i
      change evaluate D c (D.rootDatum.root i) < 0 ↔ ¬ 0 < evaluate D c (D.rootDatum.root i)
      exact ⟨fun hn ↦ not_lt_of_ge hn.le, fun hn ↦
        (le_of_not_gt hn).lt_of_ne (hreg' i)⟩
    rw [hplus, hminus]
  · have hCover : (⋃ w, Set.range (C w).doubleOrbitInclusion.left) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro x
      obtain ⟨K, _, _, _, g, hx⟩ := exists_geometric_point G.val.X x
      obtain ⟨p, hp, hg⟩ := doubleCosets_cover_geometric openCell simpleProduct hG hT hmax
        hB hBneg hTB hTBneg hneg hRpos hRneg K g
      obtain ⟨w, hw⟩ := doubleCoset_of_normalizer I hTB n hn _ p hp
      rw [hw] at hg
      obtain ⟨y, hy⟩ := (doubleCoset_eq_range (C w) _ _).mp hg
      refine Set.mem_iUnion.mpr ⟨w, y.left (IsLocalRing.closedPoint K), ?_⟩
      rw [← hx, ← hy, Over.comp_left, Scheme.Hom.comp_apply]
    refine ⟨hCover, Set.eq_univ_of_forall ?_⟩
    intro z
    obtain ⟨x, rfl⟩ := Q.surjective.1 z
    have hx : x ∈ ⋃ w, Set.range (C w).doubleOrbitInclusion.left := hCover ▸ Set.mem_univ x
    obtain ⟨w, x, rfl⟩ := Set.mem_iUnion.mp hx
    refine Set.mem_iUnion.mpr ⟨w, (C w).toOrbit.left x, ?_⟩
    have h := congrArg (fun f : (C w).doubleOrbit ⟶ Q.scheme ↦ f.left x) (C w).isInverseImage.w
    exact h.symm

/-- The group and its flag quotient are stratified by the split Bruhat cells. -/
theorem bruhatCells : Specs.BruhatCells.Statement.{u} :=
  bruhatCells_conditional
    _root_.LinearAlgebraicGroups.Flag.OpenCell.openCell
    _root_.LinearAlgebraicGroups.Flag.SimpleParabolicProduct.simpleParabolicProduct

end

end LinearAlgebraicGroups.Flag.BruhatCells
