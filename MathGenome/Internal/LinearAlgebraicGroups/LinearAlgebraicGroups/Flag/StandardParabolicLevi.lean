private theorem normal_image_of_split_projection
    {A J : AffineAlgebraicGroup k} {V : ClosedSubgroup A.val}
    (q : A.val ⟶ J.val) (s : J.val ⟶ A.val) (hs : s ≫ q = 𝟙 _)
    (hV : IsNormalSubgroup V.inclusion)
    {F : AffineAlgebraicGroup k} (p : V.group ⟶ F.val) (i : F.val ⟶ J.val)
    (hp : IsImageFactorization (V.inclusion ≫ q) p i)
    (hJs : Smooth J.val.X.hom) (hFs : Smooth F.val.X.hom) :
    IsNormalSubgroup i := by
  let Y := J.val.X ⊗ V.group.X
  let X := J.val.X ⊗ F.val.X
  let l : Y ⟶ X := 𝟙 _ ⊗ₘ p.hom.hom
  letI : Surjective l.left := tensorHom_property _ _ @Surjective inferInstance hp.2.2.1
  letI := hJs
  letI := hFs
  haveI : Smooth X.hom := by
    change Smooth (J.val.X ⊗ F.val.X).hom
    rw [Over.tensorObj_hom]
    infer_instance
  letI : IsReduced X.left := isReduced_of_smooth_over_field X.hom
  obtain ⟨b, hb⟩ := normalSubgroup_conjugate_sections hV
    (fst J.val.X V.group.X ≫ s.hom.hom) (snd J.val.X V.group.X)
  have hp' : p.hom.hom ≫ i.hom.hom = V.inclusion.hom.hom ≫ q.hom.hom :=
    congrArg (fun f : V.group ⟶ J.val ↦ f.hom.hom) hp.1
  have hs' : s.hom.hom ≫ q.hom.hom = 𝟙 _ :=
    congrArg (fun f : J.val ⟶ J.val ↦ f.hom.hom) hs
  have he : l ≫ subgroupConjugation i = (b ≫ p.hom.hom) ≫ i.hom.hom := by
    simp only [l, subgroupConjugation, MonObj.comp_mul, GrpObj.comp_inv, Category.assoc,
      tensorHom_fst, tensorHom_snd_assoc, Category.comp_id, hp']
    have h := congrArg (fun t ↦ t ≫ q.hom.hom) hb
    simp only [MonObj.mul_comp, GrpObj.inv_comp, Category.assoc, hs', Category.comp_id] at h
    exact h.symm
  apply factors_of_range_subset (subgroupConjugation i) i.hom.hom hp.2.2.2.2.2
  intro x hx
  obtain ⟨y, rfl⟩ := hx
  obtain ⟨z, hz⟩ := l.left.surjective y
  refine ⟨(b ≫ p.hom.hom).left z, ?_⟩
  have h := congrArg (fun f : Y ⟶ J.val.X ↦ f.left z) he
  simpa only [Over.comp_left, Scheme.Hom.comp_apply, hz] using h.symm

private theorem geometric_normal_unipotent_dies
    {A J : AffineAlgebraicGroup k} (hJ : IsReductive J)
    (q : A.val ⟶ J.val) (s : J.val ⟶ A.val) (hs : s ≫ q = 𝟙 _)
    (V : ClosedSubgroup (GeometricGroup A).val) (hV : IsSmoothConnectedNormal V)
    (hu : IsUnipotent (closedSubgroupAlgebraicGroup V)) :
    V.inclusion ≫ (groupBaseChange k (AlgebraicClosure k)).map q = 0 := by
  let K := AlgebraicClosure k
  let E := groupBaseChange k K
  let A' := GeometricGroup A
  let J' := GeometricGroup J
  let V' := closedSubgroupAlgebraicGroup (G := A') V
  obtain ⟨F, p, i, hp, _, _⟩ := schemeImageFactorization V' J' (V.inclusion ≫ E.map q)
  let I : ClosedSubgroup J'.val := ⟨F.val, i, hp.2.2.2.2.2⟩
  letI : Surjective p.hom.hom.left := hp.2.2.1
  letI : Smooth V'.val.X.hom := hV.1
  letI : IsReduced V'.val.X.left := isReduced_of_smooth_over_field V'.val.X.hom
  have hred : IsReduced F.val.X.left := reduced_of_flat_local_cover
    (X := V'.val.X.left) fun z ↦ by
      obtain ⟨x, hx⟩ := p.hom.hom.left.surjective z
      exact ⟨p.hom.hom.left, hp.2.1, x, hx⟩
  letI := F.property.2.1
  have hFs := smoothOfReducedOverPerfectField K F.val hred
  letI : ConnectedSpace V'.val.X.left := hV.2.1
  have hFc := p.hom.hom.left.surjective.connectedSpace p.hom.hom.left.continuous
  have hFn := normal_image_of_split_projection (A := A') (J := J') (E.map q) (E.map s)
    (by rw [← E.map_comp, hs]; exact E.map_id J.val) hV.2.2 p i hp
    (smooth_baseChangedGroup hJ.1) hFs
  have hFu := Unipotent.faithfullyFlatQuotientsUnipotent V' F p hp.2.1 hp.2.2.1 hu
  obtain ⟨j, hj⟩ := (GeometricRadicals.geometricUnipotentRadicalLargest J).2.2 I
    ⟨hFs, hFc, hFn⟩ (by obtain ⟨M, f, hf⟩ := hFu; exact ⟨M, f, hf⟩)
  obtain ⟨e⟩ := hJ.2.2
  have hj₀ : j = 0 := IsZero.eq_of_tgt ((Grp.isZero_trivial _).of_iso e) _ _
  change j ≫ (geometricUnipotentRadical J).inclusion = i at hj
  rw [hj₀, zero_comp] at hj
  change V.inclusion ≫ E.map q = 0
  rw [← hp.1, ← hj, comp_zero]

private theorem radical_of_reductive_quotient
    {A J : AffineAlgebraicGroup k} (hJ : IsReductive J)
    (q : A.val ⟶ J.val) (s : J.val ⟶ A.val) (hs : s ≫ q = 𝟙 _)
    (U : ClosedSubgroup A.val) (hq : IsSchemeKernel q U)
    (hUs : Smooth U.group.X.hom) (hUc : ConnectedSpace U.group.X.left)
    (hu : IsUnipotent (closedSubgroupAlgebraicGroup U)) : IsUnipotentRadical A U := by
  refine ⟨⟨hUs, hUc, normalOfSchemeKernel hq⟩, hu, fun V hV hVu ↦ ?_⟩
  let K := AlgebraicClosure k
  let V' := extendSubgroup K V
  let U' := extendSubgroup K U
  have hV' : IsSmoothConnectedNormal (G := GeometricGroup A) V' :=
    ⟨smooth_baseChangedGroup hV.1,
      connected_baseChangedGroup (closedSubgroupAlgebraicGroup V) hV.2.1,
      baseChangeNormalSubgroup k K V.inclusion hV.2.2⟩
  have hV'u : IsUnipotent (closedSubgroupAlgebraicGroup (G := GeometricGroup A) V') := by
    obtain ⟨M, f, hf⟩ := (Unipotent.unipotenceFieldExtension (K := K)
      (closedSubgroupAlgebraicGroup V)).mpr hVu
    exact ⟨M, f, hf⟩
  have hkill := geometric_normal_unipotent_dies hJ q s hs V' hV' hV'u
  have hq' : IsSchemeKernel ((groupBaseChange k K).map q) U' :=
    baseChangeKernelSquare q _ hq
  exact subgroupOf_of_extend (K := K) (liftToSchemeKernel hq' V'.inclusion hkill)

private theorem contracting_is_radical {lam : Cocharacter G.val}
    (L : LimitDecomposition lam) (hL : IsReductive (closedSubgroupAlgebraicGroup L.centralizer))
    (hUs : Smooth L.contracting.group.X.hom) (hUc : GeometricallyConnected L.contracting.group.X.hom)
    (hU : IsUnipotent (closedSubgroupAlgebraicGroup L.contracting)) : IsContractingRadical L := by
  let P := closedSubgroupAlgebraicGroup L.parabolic
  let J := closedSubgroupAlgebraicGroup L.centralizer
  let U := contractingSubgroup L
  have hu : IsUnipotent (closedSubgroupAlgebraicGroup (G := P) U) := by
    obtain ⟨M, f, hf⟩ := hU
    exact ⟨M, f, hf⟩
  refine ⟨radical_of_reductive_quotient (A := P) (J := J) hL L.limit L.sectionMap
    L.section_limit U L.isKernel hUs (connected_of_geometricallyConnected hUc) hu, ?_⟩
  let K := AlgebraicClosure k
  let F := groupBaseChange k K
  let U' := extendSubgroup K U
  have hu' : IsUnipotent (closedSubgroupAlgebraicGroup (G := GeometricGroup P) U') := by
    obtain ⟨M, f, hf⟩ := (Unipotent.unipotenceFieldExtension (K := K)
      (closedSubgroupAlgebraicGroup (G := P) U)).mpr hu
    exact ⟨M, f, hf⟩
  refine ⟨U'.isClosedImmersion, radical_of_reductive_quotient (A := GeometricGroup P)
    (J := GeometricGroup J) (reductive_geometricGroup J hL)
    (F.map L.limit) (F.map L.sectionMap) ?_ U' (baseChangeKernelSquare L.limit _ L.isKernel)
    (smooth_baseChangedGroup hUs)
    (connected_baseChangedGroup (closedSubgroupAlgebraicGroup (G := P) U)
      (connected_of_geometricallyConnected hUc)) hu'⟩
  rw [← F.map_comp, L.section_limit]
  exact F.map_id J.val

end Radical

section Bruhat

open CocharacterDynamics (cocharacterPoint laurentAlgebra laurentConstants laurentParameter
  polynomialAlgebra polynomialToLaurent polynomialEvaluate HasExtension orbit)
open Specs.AdjointRepresentation (GroupPoints)
open private affineBaseTerminal from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Solvable.SplitFixedPoint
open private laurentParameter_zpow from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.CocharacterLieWeights
open private mono_over from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Affine.Stabilizers
open private factors_of_range_subset sections_of_subgroupOf
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.SubtorusCentralizer
open private characterUnitOnPoints characterUnit characterUnit_natural characterUnit_cocharacter
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.RootData.RootGroups

private theorem representative_conjugation (W : Identification D) {w : D.rootDatum.weylGroup}
    {n : 𝟙_ (SchemeOver k) ⟶ W.normalizer.group.X} (hn : IsRepresentative W w n) :
    ((W.image.conjugation (W.labelEquiv w)).hom ≫ T.inclusion).hom.hom =
      Specs.BruhatOrbitParametrization.conjugatePoint
        (n ≫ W.normalizer.inclusion.hom.hom) T.inclusion.hom.hom := by
  have hunit : toUnit (𝟙_ (SchemeOver k)) = 𝟙 _ := Subsingleton.elim _ _
  have hn' : n ≫ W.quotient.hom.hom =
      toUnit _ ≫ W.image.constantGroup.sectionPoint (W.labelEquiv w) := by
    rw [hunit, Category.id_comp]
    exact hn
  have h := congrArg (fun f ↦ lift (𝟙 T.group.X) (toUnit T.group.X) ≫ f)
    (W.image.conjugates _ n _ hn')
  simpa only [Specs.BruhatOrbitParametrization.conjugatePoint, conjugateFamily,
    MonObj.comp_mul, GrpObj.comp_inv, Category.assoc,
    lift_fst_assoc, lift_snd_assoc, Category.id_comp] using h.symm

private theorem face_stabilizes_cocharacter {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hreg : IsRegular T c)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam)
    (W : Identification D) (w : D.rootDatum.weylGroup) :
    lam ≫ (W.image.conjugation (W.labelEquiv w)).hom = lam ↔ w ∈ parabolicWeylGroup D I := by
  rw [← face_weyl_group hreg hb hlam w]
  let y := Additive.ofMul lam
  let e := w.val.coweightEquiv
  have h : lam ≫ (W.image.conjugation (W.labelEquiv w)).hom = lam ↔ e.symm y = y := by
    change _ ↔ w.val.coweightEquiv.symm (Additive.ofMul lam) = Additive.ofMul lam
    rw [W.cocharacterAction]
    rfl
  rw [h, LinearEquiv.symm_apply_eq]
  change y = e y ↔ _
  constructor
  · intro he
    ext x
    change D.rootDatum.toLinearMap (w.val.weightEquiv x) y = D.rootDatum.toLinearMap x y
    rw [w.val.toLinearMap_weightEquiv, ← he]
  · intro h
    apply D.rootDatum.toLinearMap.flip.toPerfPair.injective
    ext x
    change D.rootDatum.toLinearMap x y = D.rootDatum.toLinearMap x (e y)
    rw [← w.val.toLinearMap_weightEquiv]
    exact (DFunLike.congr_fun h x).symm

private abbrev groundAlgebra (k : Type u) [Field k] := CommAlgCat.of k k

private theorem polynomial_to_laurent_dense (R : TestAlgebra k) :
    DenseRange ((testSpec k).map (polynomialToLaurent R).op).left := by
  change DenseRange (PrimeSpectrum.comap (polynomialToLaurent R).hom.toRingHom)
  rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
  intro p hp
  have hz : p = 0 := Polynomial.toLaurent_injective hp
  simp [hz]

omit [IsCommMonObj T.group.X] in
private theorem exponent_eq_of_polynomial_torus_point
    (a d : Cocharacter T.group)
    (p : GroupPoints T.group (polynomialAlgebra (groundAlgebra k)))
    (hp : let R := groundAlgebra k
      mapPoints (polynomialToLaurent R) p =
        cocharacterPoint a (laurentAlgebra R) (laurentParameter R) *
          (cocharacterPoint d (laurentAlgebra R) (laurentParameter R))⁻¹)
    (χ : Character T.group) : pairing T.group χ a = pairing T.group χ d := by
  let R := groundAlgebra k
  let P := polynomialAlgebra R
  let F := laurentAlgebra R
  let t := laurentParameter R
  let u := characterUnit χ P p
  let m := pairing T.group χ a - pairing T.group χ d
  have he := congrArg (characterUnitOnPoints χ F) hp
  change characterUnit χ F (mapPoints (polynomialToLaurent R) p) =
    characterUnitOnPoints χ F (cocharacterPoint a F t * (cocharacterPoint d F t)⁻¹) at he
  rw [characterUnit_natural, map_mul, map_inv] at he
  change Units.map (polynomialToLaurent R).hom.toMonoidHom u =
    characterUnit χ F (cocharacterPoint a F t) * (characterUnit χ F (cocharacterPoint d F t))⁻¹ at he
  rw [characterUnit_cocharacter, characterUnit_cocharacter, ← zpow_sub] at he
  have e := congrArg (fun v : Fˣ ↦ (v : F)) he
  change (↑u : Polynomial k).toLaurent = (↑(t ^ m) : LaurentPolynomial k) at e
  rw [laurentParameter_zpow] at e
  obtain ⟨r, _, hr⟩ := Polynomial.isUnit_iff.mp u.isUnit
  rw [← hr, Polynomial.toLaurent_C] at e
  by_contra h
  have hm : m ≠ 0 := sub_ne_zero.mpr h
  have he' : (LaurentPolynomial.C (R := k) r).coeff m =
      (LaurentPolynomial.T m : LaurentPolynomial k).coeff m :=
    congrArg (fun f : LaurentPolynomial k ↦ f.coeff m) e
  simp [LaurentPolynomial.T_apply, hm] at he'

private theorem representative_in_limit_iff (W : Identification D) {w : D.rootDatum.weylGroup}
    {n : 𝟙_ (SchemeOver k) ⟶ W.normalizer.group.X} (hn : IsRepresentative W w n)
    (lam : Cocharacter T.group) (L : LimitDecomposition (lam ≫ T.inclusion)) :
    n ≫ W.normalizer.inclusion.hom.hom ∈ SubgroupSections L.parabolic (𝟙_ (SchemeOver k)) ↔
      lam ≫ (W.image.conjugation (W.labelEquiv w)).hom = lam := by
  let n₀ := n ≫ W.normalizer.inclusion.hom.hom
  let R := groundAlgebra k
  let P := polynomialAlgebra R
  let F := laurentAlgebra R
  let X := (testSpec k).obj (.op P)
  let Y := (testSpec k).obj (.op F)
  let Z := (testSpec k).obj (.op R)
  let e : Z ≅ 𝟙_ (SchemeOver k) := (affineBaseTerminal k).uniqueUpToIso
    (isTerminalTensorUnit (C := SchemeOver k))
  let u : GroupPoints G.val R := toUnit Z ≫ n₀
  let l : Y ⟶ X := (testSpec k).map (polynomialToLaurent R).op
  let nY : Y ⟶ G.val.X := toUnit Y ≫ n₀
  let d := lam ≫ (W.image.conjugation (W.labelEquiv w)).hom
  let t := laurentParameter R
  let a : Y ⟶ T.group.X := cocharacterPoint lam F t
  let b : Y ⟶ T.group.X := cocharacterPoint d F t
  have hZu : e.hom = toUnit Z := Subsingleton.elim _ _
  have hs : n₀ ∈ SubgroupSections L.parabolic (𝟙_ (SchemeOver k)) ↔
      HasExtension (lam ≫ T.inclusion) u := by
    constructor
    · rintro ⟨v, hv⟩
      change v ≫ L.parabolic.inclusion.hom.hom = n₀ at hv
      apply (L.parabolic_points R u).mpr
      refine ⟨e.hom ≫ v, ?_⟩
      change (e.hom ≫ v) ≫ L.parabolic.inclusion.hom.hom = toUnit Z ≫ n₀
      rw [Category.assoc, hv, hZu]
    · intro hu
      obtain ⟨v, hv⟩ := (L.parabolic_points R u).mp hu
      refine ⟨e.inv ≫ v, ?_⟩
      change v ≫ L.parabolic.inclusion.hom.hom = toUnit Z ≫ n₀ at hv
      change (e.inv ≫ v) ≫ L.parabolic.inclusion.hom.hom = n₀
      rw [Category.assoc, hv, ← hZu, Iso.inv_hom_id_assoc]
  have hconst : (show Y ⟶ G.val.X from mapPoints (laurentConstants R) u) = nY := by
    change (_ ≫ toUnit Z ≫ n₀) = _
    rw [← Category.assoc, show (testSpec k).map (laurentConstants R).op ≫ toUnit Z = toUnit Y
      from Subsingleton.elim _ _]
  have hconj :
      b ≫ T.inclusion.hom.hom =
        nY * (a ≫ T.inclusion.hom.hom) * nY⁻¹ := by
    have hb : b ≫ T.inclusion.hom.hom =
        a ≫ ((W.image.conjugation (W.labelEquiv w)).hom ≫ T.inclusion).hom.hom :=
      Category.assoc _ _ _
    have h := congrArg (fun f ↦ a ≫ f) (representative_conjugation W hn)
    rw [hb]
    simpa only [nY, n₀, Specs.BruhatOrbitParametrization.conjugatePoint, MonObj.comp_mul,
      GrpObj.comp_inv, ← Category.assoc, show a ≫ toUnit T.group.X = toUnit Y
        from Subsingleton.elim _ _] using h
  have horbit : (show Y ⟶ G.val.X from orbit (lam ≫ T.inclusion) u) * nY⁻¹ =
      (a * b⁻¹) ≫ T.inclusion.hom.hom := by
    change (a ≫ T.inclusion.hom.hom) *
      (show Y ⟶ G.val.X from mapPoints (laurentConstants R) u) *
      (a ≫ T.inclusion.hom.hom)⁻¹ * nY⁻¹ = _
    rw [hconst, MonObj.mul_comp, GrpObj.inv_comp, hconj]
    group
  rw [hs]
  constructor
  · rintro ⟨z, f, hf, _⟩
    let j : X ⟶ G.val.X := (show X ⟶ G.val.X from f) * (toUnit X ≫ n₀)⁻¹
    have hj : l ≫ j = (a * b⁻¹) ≫ T.inclusion.hom.hom := by
      simp only [j, MonObj.comp_mul, GrpObj.comp_inv, ← Category.assoc l,
        show l ≫ toUnit X = toUnit Y from Subsingleton.elim _ _]
      have hf' : l ≫ (show X ⟶ G.val.X from f) =
          (show Y ⟶ G.val.X from orbit (lam ≫ T.inclusion) u) := hf
      rw [hf', horbit]
    have hR : DenseRange l.left := polynomial_to_laurent_dense R
    have hRange : Set.range j.left ⊆ Set.range T.inclusion.hom.hom.left := by
      letI := T.isClosedImmersion
      have hclosed := T.inclusion.hom.hom.left.isClosedEmbedding.isClosed_range
      have hh : Set.range l.left ⊆ j.left ⁻¹' Set.range T.inclusion.hom.hom.left := by
        rintro _ ⟨y, rfl⟩
        exact ⟨(a * b⁻¹).left y, congrArg (fun f : Y ⟶ G.val.X ↦ f.left y) hj.symm⟩
      have h := (hclosed.preimage j.left.continuous).closure_subset_iff.mpr hh
      rw [hR.closure_range] at h
      rintro _ ⟨x, rfl⟩
      exact h (Set.mem_univ x)
    letI : IsReduced X.left := by
      change IsReduced (Spec (CommRingCat.of (Polynomial k)))
      infer_instance
    obtain ⟨p, hp⟩ := factors_of_range_subset j T.inclusion.hom.hom T.isClosedImmersion hRange
    letI := mono_over T.inclusion.hom.hom T.isClosedImmersion
    have hp' : mapPoints (polynomialToLaurent R) p = a * b⁻¹ :=
      (cancel_mono T.inclusion.hom.hom).mp (by change (l ≫ p) ≫ _ = _; rw [Category.assoc, hp, hj])
    apply Additive.ofMul.injective
    apply D.rootDatum.toLinearMap.flip.toPerfPair.injective
    ext χ
    let β : Character T.group := Additive.toMul χ
    change D.rootDatum.toLinearMap (Additive.ofMul β) (Additive.ofMul d) =
      D.rootDatum.toLinearMap (Additive.ofMul β) (Additive.ofMul lam)
    rw [D.pairing_eq, D.pairing_eq]
    exact (exponent_eq_of_polynomial_torus_point lam d p hp' β).symm
  · intro hd
    have he : a = b := congrArg (fun c ↦ cocharacterPoint c F t) hd.symm
    have h : (show Y ⟶ G.val.X from orbit (lam ≫ T.inclusion) u) = nY := by
      apply mul_inv_eq_one.mp
      rw [horbit, he, mul_inv_cancel, MonObj.one_comp]
    refine ⟨mapPoints (polynomialEvaluate R 0) (toUnit X ≫ n₀), toUnit X ≫ n₀, ?_, rfl⟩
    change l ≫ toUnit X ≫ n₀ = _
    rw [← Category.assoc, show l ≫ toUnit X = toUnit Y from Subsingleton.elim _ _]
    exact h.symm

omit [IsCommMonObj T.group.X] in
private theorem cell_range_classification
    {B P : ClosedSubgroup G.val} (hBP : IsSubgroupOf B P)
    {Q : Specs.QuotientEmbedding.Presentation B} {a : ModObj G.val.X Q.scheme}
    {n : 𝟙_ (SchemeOver k) ⟶ G.val.X} {A : ClosedSubgroup G.val}
    (C : Cell (T := T) Q a n A) (x : G.val.X.left)
    (hx : x ∈ Set.range C.doubleOrbitInclusion.left) :
    x ∈ Set.range P.inclusion.hom.hom.left ↔
      n ∈ SubgroupSections P (𝟙_ (SchemeOver k)) := by
  let i := C.doubleOrbitInclusion
  let p := P.inclusion.hom.hom
  constructor
  · rintro ⟨y, hy⟩
    obtain ⟨z, hz⟩ := hx
    let V := pullback i p
    let v : V ⟶ C.doubleOrbit := pullback.fst _ _
    let u : V ⟶ P.group.X := pullback.snd _ _
    have huv : v ≫ i = u ≫ p := pullback.condition
    have hp : IsPullback v.left u.left i.left p.left :=
      (IsPullback.of_hasPullback i p).map (Over.forget _)
    obtain ⟨t, _, _⟩ := Scheme.exists_preimage_of_isPullback hp z y (hz.trans hy.symm)
    obtain ⟨b₁, b₂, hb⟩ := (C.doubleOrbitSections _ (v ≫ i)).mp ⟨v, rfl⟩
    have h₁ := sections_of_subgroupOf hBP
      (show b₁ ≫ B.inclusion.hom.hom ∈ SubgroupSections B V from ⟨b₁, rfl⟩)
    have h₂ := sections_of_subgroupOf hBP
      (show b₂ ≫ B.inclusion.hom.hom ∈ SubgroupSections B V from ⟨b₂, rfl⟩)
    have h₃ : v ≫ i ∈ SubgroupSections P V := ⟨u, huv.symm⟩
    have h₄ : toUnit V ≫ n ∈ SubgroupSections P V := by
      have h := (SubgroupSections P V).mul_mem ((SubgroupSections P V).inv_mem h₁)
        ((SubgroupSections P V).mul_mem h₃ ((SubgroupSections P V).inv_mem h₂))
      rw [← hb] at h
      convert h using 1
      group
    obtain ⟨f, hf⟩ := h₄
    letI : IsReduced (𝟙_ (SchemeOver k)).left := by
      change IsReduced (Spec (CommRingCat.of k))
      infer_instance
    apply factors_of_range_subset n p P.isClosedImmersion
    rintro _ ⟨r, rfl⟩
    letI : Subsingleton ((𝟙_ (SchemeOver k)).left : Type u) := by
      change Subsingleton (PrimeSpectrum k)
      infer_instance
    have hu : (toUnit V).left t = r := Subsingleton.elim _ _
    exact ⟨f.left t, by
      have hf' : f ≫ p = toUnit V ≫ n := hf
      have h := congrArg (fun g : V ⟶ G.val.X ↦ g.left t) hf'
      simpa only [Over.comp_left, Scheme.Hom.comp_apply, hu] using h⟩
  · intro hn
    obtain ⟨f, hf⟩ := hn
    change f ≫ p = n at hf
    have h₀ : toUnit C.doubleOrbit ≫ n ∈ SubgroupSections P C.doubleOrbit :=
      ⟨toUnit C.doubleOrbit ≫ f, by change (_ ≫ f) ≫ p = _; rw [Category.assoc, hf]⟩
    obtain ⟨b₁, b₂, hb⟩ := (C.doubleOrbitSections _ i).mp ⟨𝟙 _, Category.id_comp _⟩
    have h₁ := sections_of_subgroupOf hBP
      (show b₁ ≫ B.inclusion.hom.hom ∈ SubgroupSections B C.doubleOrbit from ⟨b₁, rfl⟩)
    have h₂ := sections_of_subgroupOf hBP
      (show b₂ ≫ B.inclusion.hom.hom ∈ SubgroupSections B C.doubleOrbit from ⟨b₂, rfl⟩)
    have h₃ := (SubgroupSections P C.doubleOrbit).mul_mem
      ((SubgroupSections P C.doubleOrbit).mul_mem h₁ h₀) h₂
    rw [hb] at h₃
    obtain ⟨g, hg⟩ := h₃
    obtain ⟨y, rfl⟩ := hx
    exact ⟨g.left y, congrArg (fun f : C.doubleOrbit ⟶ G.val.X ↦ f.left y) hg⟩

end Bruhat

section Construction

open Specs.OrderedRootProducts (rootProduct product)
open private rootCoordinate_exists rootSubgroup_embeds
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.RootData.OrderedRootProducts
open private subgroupOf_trans from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.GeometricBorelConjugacy
open private subgroupOf_of_sections sections_of_subgroupOf
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.SubtorusCentralizer
open private connected_of_geometricallyConnected borel_of_regular_cocharacter torus_subgroupOf_centralizer
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.RootData.BorelsAndChambers
open private restrictSubgroup from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.MaximalToriConjugate
open private maximal_torus_in_intermediate_group from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.RootData.RankOneFlag

omit [IsCommMonObj T.group.X] in
private theorem root_product_in_subgroup {U : RootSubgroupFamily T} {B : ClosedSubgroup G.val}
    (l : List (Root T)) (h : ∀ α ∈ l, IsSubgroupOf (U α).val B) :
    rootProduct U l ∈ SubgroupSections B (product (fun α ↦ (U α).val.group.X) l) := by
  induction l with
  | nil => exact (SubgroupSections B _).one_mem
  | cons α l ih =>
    have hhead := h α (List.mem_cons_self ..)
    obtain ⟨f, hf⟩ := ih (fun β hβ ↦ h β (List.mem_cons_of_mem _ hβ))
    change f ≫ B.inclusion.hom.hom = rootProduct U l at hf
    apply (SubgroupSections B _).mul_mem
    · exact sections_of_subgroupOf hhead ⟨fst _ _, rfl⟩
    · refine ⟨snd _ _ ≫ f, ?_⟩
      change (_ ≫ f) ≫ _ = _
      rw [Category.assoc, hf]

private theorem face_radical_in_borel
    (hG : IsReductive G) (hT : IsSplitTorus T.group) (hTm : IsGeometricallyMaximal T)
    {B : ClosedSubgroup G.val} (hB : IsKBorel B) (hTB : IsSubgroupOf T B)
    (U : RootSubgroupFamily T) {I : Set (Root T)} {lam : Cocharacter T.group}
    (L : LimitDecomposition (lam ≫ T.inclusion))
    (hordered : OrderedParametrization U (subgroupRoots T B \ leviRoots D I) L.contracting) :
    IsSubgroupOf L.contracting B := by
  classical
  letI := D.finiteRoots
  letI := Fintype.ofFinite (Root T)
  let M := (subgroupRoots T B \ leviRoots D I).toFinset
  let l := M.toList
  have hl : Enumerates l (subgroupRoots T B \ leviRoots D I) :=
    ⟨Finset.nodup_toList _, fun α ↦ by simp [l, M]⟩
  obtain ⟨e, he⟩ := hordered l hl
  obtain ⟨d, E, _, hEB, hd⟩ := borel_of_regular_cocharacter G hG T hT hTm B hB hTB
  have hroots (α : Root T) (hα : α ∈ l) : IsSubgroupOf (U α).val B := by
    obtain ⟨x⟩ := rootCoordinate_exists RootData.RootGroups.rootSubgroups G hG T hT hTm U α
    have hx : α ∈ positiveRoots T d := by
      rw [← hd]
      exact ((hl.2 α).mp hα).1
    exact subgroupOf_trans (rootSubgroup_embeds x d E hx)
      (subgroupOf_trans ⟨E.contractingToParabolic, E.contracting_in_G⟩ hEB.2)
  obtain ⟨f, hf⟩ := root_product_in_subgroup l hroots
  change f ≫ B.inclusion.hom.hom = rootProduct U l at hf
  apply subgroupOf_of_sections
  refine ⟨e.inv ≫ f, ?_⟩
  change (e.inv ≫ f) ≫ B.inclusion.hom.hom = L.contracting.inclusion.hom.hom
  rw [Category.assoc, hf, ← he, Iso.inv_hom_id_assoc]

/-- The standard parabolic construction from the split Bruhat stratification. -/
theorem standardParabolicLevi_conditional
    (bruhat : Specs.BruhatCells.Statement.{u}) : Specs.StandardParabolicLevi.Statement.{u} := by
  classical
  intro k _ G hG T B hT hTm hB hTB
  obtain ⟨hm, h⟩ := bruhat G hG T B hT hTm hB hTB
  letI := hm
  obtain ⟨D, W, U, Bneg, Rpos, Rneg, c, b, _, _, _, _, _, hreg, hc, hb, hn, hQ, hcells⟩ := h
  refine ⟨hm, D, W, U, c, b, hreg, hc, hb, ?_⟩
  intro I hI
  obtain ⟨lam, hlam⟩ := exists_face_cocharacter (D := D) b I hI
