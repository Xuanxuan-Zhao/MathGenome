variable {Idx X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  (P : RootPairing Idx ℤ X Y)

/-- The roots vanishing on the face lie in the integral span of its selected
simple roots. Positive roots pair nonnegatively on the face. -/
private theorem face_values (b : P.Base) (I : Set Idx)
    (g : X →ₗ[ℤ] ℤ) (hzero : ∀ i ∈ I, g (P.root i) = 0)
    (hpos : ∀ i ∈ (b.support : Set Idx) \ I, 0 < g (P.root i)) (i : Idx) :
    (g (P.root i) = 0 ↔ P.root i ∈ Submodule.span ℤ (P.root '' I)) ∧
      (b.IsPos i → 0 ≤ g (P.root i)) := by
  classical
  have hnonneg (j : Idx) (hj : j ∈ b.support) : 0 ≤ g (P.root j) := by
    by_cases h : j ∈ I
    · rw [hzero j h]
    · exact (hpos j ⟨hj, h⟩).le
  have hspan : Submodule.span ℤ (P.root '' I) ≤ LinearMap.ker g :=
    Submodule.span_le.mpr (by rintro x ⟨j, hj, rfl⟩; exact hzero j hj)
  refine ⟨⟨?_, fun h ↦ LinearMap.mem_ker.mp (hspan h)⟩, ?_⟩
  · intro hi
    obtain ⟨a, _, ha, he⟩ := b.exists_root_eq_sum_int i
    have hs : (∑ j ∈ b.support, a j * g (P.root j)) = 0 := by
      rw [he, map_sum] at hi
      simpa [map_zsmul, zsmul_eq_mul] using hi
    have hz (j : Idx) (hj : j ∈ b.support) (hjI : j ∉ I) : a j = 0 := by
      have hp := hpos j ⟨hj, hjI⟩
      rcases ha with ha | ha
      · have hterm : a j * g (P.root j) ≤ 0 := hs ▸
          Finset.single_le_sum (fun l hl ↦ mul_nonneg (ha.le l) (hnonneg l hl)) hj
        exact le_antisymm (nonpos_of_mul_nonpos_left hterm hp) (ha.le j)
      · have hterm : 0 ≤ a j * g (P.root j) := by
          have h := Finset.sum_le_sum_of_subset_of_nonpos (f := fun l ↦ a l * g (P.root l))
            (Finset.singleton_subset_iff.mpr hj)
            (fun l hl _ ↦ mul_nonpos_of_nonpos_of_nonneg (ha.le l) (hnonneg l hl))
          simpa only [hs, Finset.sum_singleton] using h
        exact le_antisymm (ha.le j) (nonneg_of_mul_nonneg_left hterm hp)
    rw [he]
    refine Submodule.sum_mem _ fun j hj ↦ ?_
    by_cases hjI : j ∈ I
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, hjI, rfl⟩)
    · rw [hz j hj hjI, zero_smul]
      exact Submodule.zero_mem _
  · intro hi
    obtain ⟨a, _, hs, he⟩ := b.exists_root_eq_sum_int i
    have ha : 0 < a := hs.resolve_right fun hn ↦ by
      rw [b.isPos_iff, b.height_eq_sum he] at hi
      exact (not_lt_of_ge (Finset.sum_nonpos fun j _ ↦ hn.le j)) hi
    rw [he, map_sum]
    exact Finset.sum_nonneg fun j hj ↦ by
      rw [map_zsmul, zsmul_eq_mul]
      exact mul_nonneg (ha.le j) (hnonneg j hj)

/-- The stabilizer of an integral functional in the relative interior of a
face is generated by its vanishing simple reflections. -/
private theorem face_stabilizer [Finite Idx] [P.IsReduced] (b : P.Base)
    (f g : X →ₗ[ℤ] ℤ) (hf : ∀ i, f (P.root i) ≠ 0) (hb : IsBaseFor P f b)
    (I : Set Idx) (hzero : ∀ i ∈ I, g (P.root i) = 0)
    (hpos : ∀ i ∈ (b.support : Set Idx) \ I, 0 < g (P.root i))
    (w : P.weylGroup) :
    g.comp w.val.weightEquiv.toLinearMap = g ↔
      w ∈ Subgroup.closure (weylGroup.ofIdx P '' I) := by
  classical
  let Fix : Subgroup P.weylGroup :=
    { carrier := {v | g.comp v.val.weightEquiv.toLinearMap = g}
      one_mem' := by ext x; rfl
      mul_mem' := by
        intro v z hv hz
        ext x
        change g (v.val.weightEquiv (z.val.weightEquiv x)) = g x
        exact (DFunLike.congr_fun hv (z.val.weightEquiv x)).trans (DFunLike.congr_fun hz x)
      inv_mem' := by
        intro v hv
        ext x
        change g (v.val.weightEquiv.symm x) = g x
        simpa using (DFunLike.congr_fun hv (v.val.weightEquiv.symm x)).symm }
  let W := Subgroup.closure (weylGroup.ofIdx P '' I)
  have hgen (i : Idx) (hi : i ∈ I) : weylGroup.ofIdx P i ∈ Fix := by
    change g.comp (P.reflection i).toLinearMap = g
    ext x
    change g (P.reflection i x) = g x
    rw [RootPairing.reflection_apply, map_sub, map_zsmul, hzero i hi, smul_zero, sub_zero]
  have hWF : W ≤ Fix := (Subgroup.closure_le Fix).mpr (by
    rintro - ⟨i, hi, rfl⟩
    exact hgen i hi)
  refine ⟨?_, fun hw ↦ hWF hw⟩
  intro hw
  obtain ⟨l, hl, hlen, hmin⟩ := exists_shortest_word P b hb.generates w
  rw [← hl] at hw ⊢
  have hminimal : ∀ l', wordProduct P b l' = wordProduct P b l → l.length ≤ l'.length :=
    fun l' he ↦ hmin _ (he.trans hl)
  clear hlen hmin hl w
  induction l using List.reverseRecOn with
  | nil => exact W.one_mem
  | append_singleton l j ih =>
    let v := wordProduct P b l
    let s := weylGroup.ofIdx P j.val
    have hword : wordProduct P b (l ++ [j]) = v * s := by
      rw [word_append, word_cons, word_nil, mul_one]
    have hj : 0 < f (P.root j.val) := (hb.positive_iff _).mp (b.isPos_of_mem_support j.property)
    have hvj : 0 < f (P.root (P.weylGroupToPerm v j.val)) := by
      rcases lt_or_gt_of_ne (hf (P.weylGroupToPerm v j.val)) with hn | hp
      · obtain ⟨l', hl', hlen⟩ := delete_of_signChange P b f hf hb.positive_iff l hj hn
        have h := hminimal l' (hl'.trans hword.symm)
        simp only [List.length_append, List.length_singleton] at h
        omega
      · exact hp
    have hnegative : f (P.root (P.weylGroupToPerm (v * s) j.val)) < 0 := by
      rw [perm_mul, perm_reflection, reflected_value]
      exact neg_neg_of_pos hvj
    let i := P.weylGroupToPerm (v * s) j.val
    have hi : g (P.root i) ≤ 0 := by
      let io := P.reflectionPerm i i
      have hio : f (P.root io) > 0 := by
        change f (P.root (P.reflectionPerm i i)) > 0
        rw [root_reflectionPerm, reflection_apply_self, map_neg]
        exact neg_pos.mpr hnegative
      have hn := (face_values P b I g hzero hpos io).2 ((hb.positive_iff io).mpr hio)
      change 0 ≤ g (P.root (P.reflectionPerm i i)) at hn
      rw [root_reflectionPerm, reflection_apply_self, map_neg] at hn
      exact neg_nonneg.mp hn
    have he : g (P.root i) = g (P.root j.val) := by
      rw [hword] at hw
      rw [← P.weylGroup_apply_root]
      exact DFunLike.congr_fun hw (P.root j.val)
    have hjI : j.val ∈ I := by
      by_contra h
      exact (not_lt_of_ge (he ▸ hi)) (hpos _ ⟨j.property, h⟩)
    have hs : s ∈ Fix := hgen _ hjI
    have hv : v ∈ Fix := by
      have hw' : wordProduct P b (l ++ [j]) ∈ Fix := hw
      rw [hword] at hw'
      exact (Fix.mul_mem_cancel_right hs).mp hw'
    have hshort (l' : List b.support) (hl' : wordProduct P b l' = wordProduct P b l) :
        l.length ≤ l'.length := by
      have h := hminimal (l' ++ [j]) (by rw [word_append, hl', ← word_append])
      simpa using h
    rw [hword]
    exact W.mul_mem (ih hv hshort) (Subgroup.subset_closure ⟨j.val, hjI, rfl⟩)

end RootPairing

variable {k : Type u} [Field k] {G : AffineAlgebraicGroup k} {T : ClosedSubgroup G.val}
variable [IsCommMonObj T.group.X] {D : Datum T}

/-- Choose an integral cocharacter with simple-root values zero on `I`
and a common strictly positive value on its complement. -/
theorem exists_face_cocharacter (b : D.rootDatum.Base) (I : Set (Root T))
    (hI : I ⊆ b.support) : ∃ c : Cocharacter T.group, HasFace b I c := by
  classical
  letI := D.freeCharacters
  letI := D.finiteCharacters
  obtain ⟨f, m, hm, hf⟩ := exists_integralValues b.linearIndepOn_root
    (fun j : b.support ↦ if j.val ∈ I then 0 else 1)
  let c := D.rootDatum.toLinearMap.flip.toPerfPair.symm f
  have he : evaluate D (Additive.toMul c) = f := by
    change D.rootDatum.toLinearMap.flip.toPerfPair c = f
    exact D.rootDatum.toLinearMap.flip.toPerfPair.apply_symm_apply f
  have hpair (i : Root T) (hi : i ∈ b.support) :
      pairing T.group i.val (Additive.toMul c) = m * (if i ∈ I then 0 else 1) := by
    rw [← D.pairing_eq, ← D.root_eq]
    change evaluate D (Additive.toMul c) (D.rootDatum.root i) = _
    rw [he]
    exact hf ⟨i, hi⟩
  exact ⟨Additive.toMul c, fun i hi ↦ by simp [hpair i (hI hi), hi],
    fun i hi ↦ by simpa [hpair i hi.1, hi.2] using hm⟩

private theorem evaluate_root (D : Datum T) (c : Cocharacter T.group) (i : Root T) :
    evaluate D c (D.rootDatum.root i) = pairing T.group i.val c := by
  change D.rootDatum.toLinearMap (D.rootDatum.root i) (Additive.ofMul c) = _
  rw [D.root_eq, D.pairing_eq]

theorem face_root_signs {B : ClosedSubgroup G.val} {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hc : positiveRoots T c = subgroupRoots T B)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam) (i : Root T) :
    (pairing T.group i.val lam = 0 ↔ i ∈ leviRoots D I) ∧
      (i ∈ subgroupRoots T B → 0 ≤ pairing T.group i.val lam) := by
  obtain ⟨hz, hp⟩ := face_values D.rootDatum b I (evaluate D lam)
    (fun i hi ↦ (evaluate_root D lam i).trans (hlam.1 i hi))
    (fun i hi ↦ by rw [evaluate_root]; exact hlam.2 i hi) i
  rw [evaluate_root] at hz hp
  refine ⟨hz, fun hi ↦ hp ((hb.positive_iff i).mpr ?_)⟩
  change 0 < evaluate D c (D.rootDatum.root i)
  rw [evaluate_root]
  change i ∈ positiveRoots T c
  rwa [hc]

theorem face_positive_roots {B : ClosedSubgroup G.val} {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hreg : IsRegular T c)
    (hc : positiveRoots T c = subgroupRoots T B)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam) :
    positiveRoots T lam = subgroupRoots T B \ leviRoots D I := by
  ext i
  have ⟨hz, hp⟩ := face_root_signs hc hb hlam i
  constructor
  · intro hi
    change 0 < pairing T.group i.val lam at hi
    refine ⟨?_, fun h ↦ hi.ne' (hz.mpr h)⟩
    rw [← hc]
    by_contra hn
    let j := D.rootDatum.reflectionPerm i i
    have hroot : D.rootDatum.root j = -D.rootDatum.root i := by
      change D.rootDatum.root (D.rootDatum.reflectionPerm i i) = _
      rw [RootPairing.root_reflectionPerm, RootPairing.reflection_apply_self]
    have hneg : pairing T.group i.val c < 0 := by
      exact lt_of_le_of_ne (le_of_not_gt hn) (hreg i)
    have hj : j ∈ subgroupRoots T B := by
      rw [← hc]
      change 0 < pairing T.group j.val c
      rw [← evaluate_root D c j, hroot, map_neg, evaluate_root]
      exact neg_pos.mpr hneg
    have h := (face_root_signs hc hb hlam j).2 hj
    rw [← evaluate_root D lam j, hroot, map_neg, evaluate_root] at h
    exact hi.not_ge (neg_nonneg.mp h)
  · intro hi
    exact lt_of_le_of_ne (hp hi.1) (Ne.symm (fun h ↦ hi.2 (hz.mp h)))

theorem face_weyl_group {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hreg : IsRegular T c)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam)
    (w : D.rootDatum.weylGroup) :
    (evaluate D lam).comp w.val.weightEquiv.toLinearMap = evaluate D lam ↔
      w ∈ parabolicWeylGroup D I := by
  letI := D.finiteRoots
  letI := D.reduced
  exact face_stabilizer D.rootDatum b (evaluate D c) (evaluate D lam)
    (fun i ↦ evaluate_root D c i ▸ hreg i) hb I
    (fun i hi ↦ (evaluate_root D lam i).trans (hlam.1 i hi))
    (fun i hi ↦ by rw [evaluate_root]; exact hlam.2 i hi) w


