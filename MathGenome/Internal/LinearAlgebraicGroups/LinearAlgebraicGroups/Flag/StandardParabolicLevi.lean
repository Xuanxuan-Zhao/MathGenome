variable {M : Type u} [CommGroup M]

private theorem saturatedKernel_le {N : Type u} [CommGroup N]
    [Module.IsTorsionFree ℤ (Additive N)] {J : Type u} (x : J → M)
    (f : M →* N) (hf : ∀ j, f (x j) = 1) :
    let K := Submodule.span ℤ (Set.range (Additive.ofMul ∘ x))
    let Q := Additive M ⧸ K
    let π := ((torsion ℤ Q).mkQ.comp K.mkQ).toAddMonoidHom.toMultiplicativeRight
    π.ker ≤ f.ker := by
  dsimp only
  intro a ha
  let K := Submodule.span ℤ (Set.range (Additive.ofMul ∘ x))
  let Q := Additive M ⧸ K
  let F := f.toAdditive.toIntLinearMap
  have hK : K ≤ LinearMap.ker F := by
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    exact hf j
  let F' := K.liftQ F hK
  have ha' : (K.mkQ (Additive.ofMul a) : Q) ∈ torsion ℤ Q :=
    (Submodule.Quotient.mk_eq_zero _).mp ha
  obtain ⟨d, hd⟩ := (mem_torsion_iff _).mp ha'
  change (d : ℤ) • K.mkQ (Additive.ofMul a) = 0 at hd
  have he : (d : ℤ) • F' (K.mkQ (Additive.ofMul a)) = 0 := by
    rw [← map_smul, hd, map_zero]
  exact ((isTorsionFree_iff_smul_eq_zero.mp inferInstance) _ _ he).resolve_left
    (mem_nonZeroDivisors_iff_ne_zero.mp d.property)

/-- A split torus has a largest subtorus in the common kernel of any
family of characters. Every morphism from a split torus into the common
kernel factors through that subtorus. -/
private theorem common_kernel {H : GroupScheme k} (hH : IsSplitTorus H)
    {J : Type u} (χ : J → Character H) :
    ∃ S : ClosedSubgroup H, IsSplitTorus S.group ∧
      (∀ j, S.inclusion ≫ χ j = 1) ∧
      (∀ E : ClosedSubgroup H, IsTorus E.group →
        (∀ j, E.inclusion ≫ χ j = 1) → IsSubgroupOf E S) ∧
      ∀ {E : GroupScheme k}, IsSplitTorus E → ∀ f : E ⟶ H,
        (∀ j, f ≫ χ j = 1) → ∃ g : E ⟶ S.group, g ≫ S.inclusion = f := by
  classical
  obtain ⟨r, ⟨e⟩⟩ := splitPresentation hH
  let M := StandardLattice.{u} r
  let x (j : J) := (latticeCharacter (k := k) M).symm (e.hom ≫ χ j)
  have hx (j : J) : latticeCharacter (k := k) M (x j) = e.hom ≫ χ j :=
    (latticeCharacter (k := k) M).apply_symm_apply _
  let K := Submodule.span ℤ (Set.range (Additive.ofMul ∘ x))
  let Q := Additive M ⧸ K
  let R := Q ⧸ torsion ℤ Q
  let π : M →* Multiplicative R :=
    ((torsion ℤ Q).mkQ.comp K.mkQ).toAddMonoidHom.toMultiplicativeRight
  let N := π.ker
  let p := QuotientGroup.mk' N
  let i := diagonalClosedInclusion k N
  have hπ : Function.Surjective π :=
    (Submodule.mkQ_surjective (torsion ℤ Q)).comp (Submodule.mkQ_surjective K)
  obtain ⟨hic, _⟩ := LinearAlgebraicGroups.DiagonalizableGroups.diagonalRestrictionKernelAndQuotient k M N
  letI := hic
  let F := Grp.forget (SchemeOver k) ⋙ Over.forget (Spec (CommRingCat.of k))
  haveI : IsIso e.hom.hom.hom.left := F.map_isIso e.hom
  let S : ClosedSubgroup H := ⟨_, i ≫ e.hom, IsClosedImmersion.comp _ _⟩
  letI : Module.Finite ℤ (Additive M) := Module.Finite.equiv (latticeCoordinates r).symm
  let s := Module.finrank ℤ R
  let b := Module.finBasis ℤ R
  let d := b.equivFun.trans (latticeCoordinates s).symm
  let a : M ⧸ N ≃* StandardLattice.{u} s :=
    (QuotientGroup.quotientKerEquivOfSurjective π hπ).trans d.toAddEquiv.toMultiplicative
  obtain ⟨a'⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) s
  have hsplit : IsSplitTorus S.group := ⟨s, ⟨(hopfSpec (CommRingCat.of k)).mapIso
    (CommHopfAlgCat.isoMk (MonoidAlgebra.domCongrBialgEquiv k k a.symm)).op ≪≫ a'⟩⟩
  have hfactor {L : Type u} [CommGroup L] [Module.IsTorsionFree ℤ (Additive L)]
      (f : M →* L) (hf : ∀ j, f (x j) = 1) :
      ∃ g : specGroup (groupAlgebra k L) ⟶ S.group,
        g ≫ S.inclusion = specGroupMap (groupAlgebraMap k f) ≫ e.hom := by
    let fbar := QuotientGroup.lift N f (saturatedKernel_le x f hf)
    refine ⟨specGroupMap (groupAlgebraMap k fbar), ?_⟩
    change specGroupMap (groupAlgebraMap k fbar) ≫
      specGroupMap (groupAlgebraMap k p) ≫ e.hom = _
    rw [← Category.assoc, latticeMap_comp]
    rfl
  have hkill {L : Type u} [CommGroup L] (f : M →* L)
      (hf : ∀ j, (specGroupMap (groupAlgebraMap k f) ≫ e.hom) ≫ χ j = 1) :
      ∀ j, f (x j) = 1 := by
    intro j
    have h := hf j
    rw [Category.assoc, ← hx, latticeCharacter_comp] at h
    exact (latticeCharacter (k := k) L).injective (h.trans (map_one _).symm)
  refine ⟨S, hsplit, ?_, ?_, ?_⟩
  · intro j
    have h : p (x j) = 1 := (QuotientGroup.eq_one_iff (N := N) _).mpr <| by
      change π (x j) = 1
      have hj : Additive.ofMul (x j) ∈ K := Submodule.subset_span ⟨j, rfl⟩
      have hz : K.mkQ (Additive.ofMul (x j)) = 0 := (Submodule.Quotient.mk_eq_zero _).mpr hj
      change (torsion ℤ Q).mkQ (K.mkQ (Additive.ofMul (x j))) = 0
      rw [hz, map_zero]
    change (i ≫ e.hom) ≫ χ j = 1
    rw [Category.assoc, ← hx]
    change specGroupMap (groupAlgebraMap k p) ≫ latticeCharacter (k := k) M (x j) = 1
    rw [latticeCharacter_comp, h, map_one]
  · intro E hE he
    haveI := E.isClosedImmersion
    haveI : IsIso e.inv.hom.hom.left := F.map_isIso e.inv
    have hcl : IsClosedImmersion (E.inclusion ≫ e.inv).hom.hom.left :=
      IsClosedImmersion.comp E.inclusion.hom.hom.left e.inv.hom.hom.left
    obtain ⟨L, ⟨d, hd⟩, _⟩ :=
      (LinearAlgebraicGroups.DiagonalizableGroups.diagonalClosedSubgroups
        k M E.group (E.inclusion ≫ e.inv)).mp hcl
    let f := QuotientGroup.mk' L
    haveI := torsionFree_of_diagonal_torus (M ⧸ L)
      (torus_of_iso d hE)
    have hde : specGroupMap (groupAlgebraMap k f) ≫ e.hom = d.inv ≫ E.inclusion := by
      change diagonalClosedInclusion k L ≫ e.hom = _
      have hd' : diagonalClosedInclusion k L = d.inv ≫ E.inclusion ≫ e.inv := by
        rw [← hd, Iso.inv_hom_id_assoc]
      simp only [hd', Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h := hkill f (fun j ↦ by
      rw [hde, Category.assoc, he j]
      apply Grp.hom_ext
      exact MonObj.comp_one d.inv.hom.hom)
    obtain ⟨g, hg⟩ := hfactor f h
    exact ⟨d.hom ≫ g, by rw [Category.assoc, hg, hde, Iso.hom_inv_id_assoc]⟩
  · intro E hE f hf
    obtain ⟨t, ⟨d⟩⟩ := splitPresentation hE
    let L := StandardLattice.{u} t
    letI : Module.Free ℤ (Additive L) := Module.Free.of_equiv (latticeCoordinates t).symm
    obtain ⟨a, ha⟩ := (splitGroupHomEquiv (k := k) M L).surjective (d.hom ≫ f ≫ e.inv)
    change specGroupMap (groupAlgebraMap k a) = d.hom ≫ f ≫ e.inv at ha
    have hae : specGroupMap (groupAlgebraMap k a) ≫ e.hom = d.hom ≫ f := by
      simp only [ha, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h := hkill a (fun j ↦ by
      rw [hae, Category.assoc, hf j]
      apply Grp.hom_ext
      exact MonObj.comp_one d.hom.hom.hom)
    obtain ⟨g, hg⟩ := hfactor a h
    exact ⟨d.inv ≫ g, by rw [Category.assoc, hg, hae, Iso.inv_hom_id_assoc]⟩

private theorem powerMorphism_zero :
    CharacterPairing.powerMorphism (k := k) 0 = 1 := by
  have h : Specs.CharacterPairing.powerMorphism (k := k) 0 =
      latticeCharacter (k := k) IntegerCharacters 1 := by
    rw [Specs.CharacterPairing.powerMorphism, zpow_zero]
    rfl
  exact h.trans (map_one _)

private theorem common_kernel_for_face (hT : IsSplitTorus T.group)
    {b : D.rootDatum.Base} {I : Set (Root T)} {lam : Cocharacter T.group}
    (hlam : HasFace b I lam) :
    ∃ S : ClosedSubgroup T.group, IsCommonKernelTorus I S ∧
      ∃ c : Cocharacter S.group, c ≫ S.inclusion = lam := by
  obtain ⟨S, hsplit, hkill, hmax, hfac⟩ :=
    common_kernel hT (fun α : I ↦ α.val.val)
  refine ⟨S, ⟨hsplit, fun α hα ↦ hkill ⟨α, hα⟩,
    fun H hH h ↦ hmax H hH (fun α ↦ h α.val α.property)⟩, ?_⟩
  have hGm : IsSplitTorus (specGroup (groupAlgebra k IntegerCharacters)) := by
    refine ⟨1, ?_⟩
    obtain ⟨e⟩ := LinearAlgebraicGroups.CharacterDescent.standardSplitTorus (k := k) 1
    let a : StandardLattice.{u} 1 ≃* IntegerCharacters.{u} :=
      MulEquiv.funUnique (Fin 1) IntegerCharacters
    exact ⟨(hopfSpec (CommRingCat.of k)).mapIso
      (CommHopfAlgCat.isoMk (MonoidAlgebra.domCongrBialgEquiv k k a)).op ≪≫ e⟩
  apply hfac hGm lam
  intro α
  rw [← powerMorphism_zero]
  exact (LinearAlgebraicGroups.RootData.CharacterPairing.characterPairingComposition
    T.group α.val.val lam).1 0 |>.mpr (hlam.1 α.val α.property)

end CommonKernel

