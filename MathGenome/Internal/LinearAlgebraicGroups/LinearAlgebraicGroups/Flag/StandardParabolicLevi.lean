private theorem character_restricts_trivially {I : Set (Root T)}
    {S : ClosedSubgroup T.group} (hS : IsCommonKernelTorus I S)
    {α : Root T} (hα : α ∈ leviRoots D I) :
    S.inclusion ≫ α.val = 1 := by
  let f : Additive (Character T.group) →ₗ[ℤ] Additive (Character S.group) :=
    (restrictCharacter S.inclusion).toAdditive.toIntLinearMap
  have hspan : Submodule.span ℤ (D.rootDatum.root '' I) ≤ LinearMap.ker f := by
    apply Submodule.span_le.mpr
    rintro _ ⟨β, hβ, rfl⟩
    rw [D.root_eq]
    exact hS.2.1 β hβ
  change f (Additive.ofMul α.val) = 0
  rw [← D.root_eq]
  exact hspan hα

omit [IsCommMonObj T.group.X] in
private theorem weight_in_centralizer {S : ClosedSubgroup T.group} {C : ClosedSubgroup G.val}
    (hC : IsCentralizer (subgroupOfSubgroup T S) C)
    {χ : Character T.group} (hχ : S.inclusion ≫ χ = 1) {v : Lie k G.val}
    (hv : v ∈ adjointWeightVectors T χ) : v ∈ lieImage C := by
  let S' := subgroupOfSubgroup T S
  have hAff := (closedSubgroupAlgebraicGroup (G := G) S').property.1
  have hw : v ∈ adjointWeightVectors S' 1 := by
    intro R t
    have heval : characterValue χ R (t ≫ S.inclusion.hom.hom) =
        characterValue (1 : Character S.group) R t := by
      rw [← hχ]
      rfl
    have he := hv R (t ≫ S.inclusion.hom.hom)
    change _ * _ * _ = mapPoints
      (Specs.AdjointRepresentation.scale R (characterValue χ R (t ≫ S.inclusion.hom.hom))) _ at he
    rw [heval] at he
    exact he
  obtain ⟨w, hw⟩ := (hC _ _).mp ((zeroWeightVectors_iff_centralizes S' hAff v).mp hw)
  letI := mono_over C.inclusion.hom.hom C.isClosedImmersion
  have hred : reduceTangentPoints C.group w = 1 := by
    apply (cancel_mono C.inclusion.hom.hom).mp
    change ((testSpec k).map (dualReduction k).op ≫ w) ≫ C.inclusion.hom.hom =
      (1 : GroupPoints C.group (baseTest k)) ≫ C.inclusion.hom.hom
    rw [Category.assoc, hw, MonObj.one_comp]
    exact v.toMul.property
  exact ⟨⟨w, hred⟩, Subtype.ext hw⟩

private theorem face_common_kernel_centralizer
    (hG : IsReductive G) (hT : IsSplitTorus T.group) (hTm : IsGeometricallyMaximal T)
    {B : ClosedSubgroup G.val} {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hc : positiveRoots T c = subgroupRoots T B)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam)
    (S : ClosedSubgroup T.group) (hS : IsCommonKernelTorus I S)
    (d : Cocharacter S.group) (hd : d ≫ S.inclusion = lam)
    (L : LimitDecomposition (lam ≫ T.inclusion)) :
    IsCentralizer (subgroupOfSubgroup T S) L.centralizer ∧
      IsReductive (closedSubgroupAlgebraicGroup L.centralizer) := by
  classical
  let S' := subgroupOfSubgroup T S
  obtain ⟨C, hC, hCr⟩ := Reductive.SubtorusCentralizer.centralizerReductive G hG T S'
    (isTorus_of_split hT) (isTorus_of_split hS.1) ⟨S.inclusion, rfl⟩ hTm
  letI := hG.1
  letI := connected_of_geometricallyConnected hG.2.1
  have hd' : d ≫ S'.inclusion = lam ≫ T.inclusion := by
    change d ≫ S.inclusion ≫ T.inclusion = lam ≫ T.inclusion
    rw [← Category.assoc, hd]
  have hCL : IsSubgroupOf C L.centralizer := by
    apply subgroupOf_of_sections
    apply (L.centralizer_points _ _).mp
    rw [← hd']
    apply (centralizes_iff _ _).mpr
    intro Y g t
    have hcomm := (hC _ _).mpr
      (show C.inclusion.hom.hom ∈ SubgroupSections C C.group.X from ⟨𝟙 _, by
        change 𝟙 _ ≫ C.inclusion.hom.hom = C.inclusion.hom.hom
        exact Category.id_comp _⟩)
    change Commute (g ≫ C.inclusion.hom.hom) (t ≫ d.hom.hom ≫ S'.inclusion.hom.hom)
    simpa only [Category.assoc] using (centralizes_iff _ _).mp hcomm Y g (t ≫ d.hom.hom)
  let A := closedSubgroupAlgebraicGroup C
  let s := identityLieStructure G
  let t := identityLieStructure A
  letI := s.lieRing
  letI := s.lieAlgebra
  letI := t.lieRing
  letI := t.lieAlgebra
  letI : AddCommGroup (Lie k G.val) := s.lieRing.toAddCommGroup
  letI : Module k (Lie k G.val) := s.lieAlgebra.toModule
  letI : AddCommGroup (Lie k A.val) := t.lieRing.toAddCommGroup
  letI : Module k (Lie k A.val) := t.lieAlgebra.toModule
  letI := G.property.1
  letI := A.property.1
  obtain ⟨j, hj⟩ := identityDifferentialLieHom k A.val G.val C.inclusion t s
  have himage : lieImage C = (LinearMap.range j.toLinearMap : Set (Lie k G.val)) := by
    ext v
    change (∃ w, mapPointKernel C.inclusion w = v) ↔ ∃ w, j w = v
    constructor
    · rintro ⟨w, hw⟩
      exact ⟨w, (hj w).trans hw⟩
    · rintro ⟨w, hw⟩
      exact ⟨w, (hj w).symm.trans hw⟩
  have hLL : lieImage L.centralizer ⊆ lieImage C := by
    rw [(limitLie_weightSpans G T hT lam L s).2, himage]
    change (⨆ χ : {χ : Character T.group // pairing T.group χ lam = 0},
      adjointWeightSpace T χ.val s) ≤ LinearMap.range j.toLinearMap
    apply iSup_le
    intro χ v hv
    have hv' : v ∈ adjointWeightVectors T χ.val :=
      (RootData.CharacterPairing.adjointWeightSpaceVectors G T s χ.val) ▸ hv
    by_cases hv0 : v = 0
    · simpa only [hv0] using (LinearMap.range j.toLinearMap).zero_mem
    change v ∈ (LinearMap.range j.toLinearMap : Set (Lie k G.val))
    rw [← himage]
    apply weight_in_centralizer hC _ hv'
    by_cases hχ : χ.val = 1
    · rw [hχ]
      apply Grp.hom_ext
      exact MonObj.comp_one _
    · let α : Root T := ⟨χ.val, hχ, v, hv', (canonicalZero_eq s).symm ▸ hv0⟩
      exact character_restricts_trivially hS ((face_root_signs hc hb hlam α).1.mp χ.property)
  have hLC := subgroupOf_of_lieImage (A := G) hCL hCr.1
    (connected_of_geometricallyConnected hCr.2.1)
    (CocharacterDynamics.limitSubgroupsSmooth G _ L).2.2
    (connected_of_geometricallyConnected
      (CocharacterDynamics.geometricallyConnectedLimitSubgroups G _ L).2.2) hLL
  obtain ⟨e, _⟩ := subgroupIso_of_same (show SameSubgroup L.centralizer C from ⟨hLC, hCL⟩)
  have hrep : IsCentralizer S' L.centralizer := by
    intro Y y
    constructor
    · intro hy
      exact sections_of_subgroupOf hCL ((hC Y y).mp hy)
    · intro hy
      exact (hC Y y).mpr (sections_of_subgroupOf hLC hy)
  exact ⟨hrep, reductive_of_groupIso e.symm hCr⟩

private theorem face_levi_roots
    {B : ClosedSubgroup G.val} {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hT : IsSplitTorus T.group)
    (hc : positiveRoots T c = subgroupRoots T B)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam)
    (L : LimitDecomposition (lam ≫ T.inclusion))
    (C : ClosedSubgroup L.centralizer.group) (e : T.group ≅ C.group)
    (he : e.hom ≫ C.inclusion ≫ L.centralizer.inclusion = T.inclusion) :
    absoluteRoots C = (fun α : Root T ↦ e.inv ≫ α.val) '' leviRoots D I := by
  classical
  letI := mono_over L.centralizer.inclusion.hom.hom L.centralizer.isClosedImmersion
  have he' : C.inclusion ≫ L.centralizer.inclusion = e.inv ≫ T.inclusion :=
    (e.inv_hom_id_assoc _).symm.trans (congrArg (e.inv ≫ ·) he)
  have he₀ : e.inv ≫ (1 : Character T.group) = 1 := by
    apply Grp.hom_ext
    exact MonObj.comp_one _
  have hein : Function.Injective (fun χ : Character T.group ↦ e.inv ≫ χ) :=
    fun _ _ h ↦ (cancel_epi e.inv).mp h
  let s := identityLieStructure G
  letI := s.lieRing
  letI := s.lieAlgebra
  obtain ⟨W, _, _, hZ⟩ := lieWeights G _ L s
  have hvanish {χ : Character T.group} {v : Lie k G.val} (hv : v ∈ adjointWeightVectors T χ)
      (hL : v ∈ lieImage L.centralizer) (hv0 : v ≠ 0) : pairing T.group χ lam = 0 := by
    by_contra hχ
    apply hv0
    apply W.basis.equivFun.injective
    ext j
    rw [map_zero]
    by_cases hj : W.weight j = pairing T.group χ lam
    · exact (hZ ▸ hL) j (hj.symm ▸ hχ)
    · exact cocharacter_weight_coordinates T lam s W hv j hj
  ext χ
  constructor
  · rintro ⟨hχ, v, hv, hv0⟩
    let β := e.hom ≫ χ
    have hβ : e.inv ≫ β = χ := by simp [β]
    let w := mapPointKernel L.centralizer.inclusion v
    have hw : w ∈ adjointWeightVectors T β :=
      map_weightVector L.centralizer.inclusion e.symm he' (hβ.symm ▸ hv)
    have hw0 : w ≠ 0 := by
      intro h
      exact hv0 (differential_injective L.centralizer.inclusion (by simpa only [map_zero] using h))
    let α : Root T := ⟨β, fun h ↦ hχ (hβ.symm.trans (h ▸ he₀)), w, hw, hw0⟩
    exact ⟨α, (face_root_signs hc hb hlam α).1.mp (hvanish hw ⟨v, rfl⟩ ((canonicalZero_eq s) ▸ hw0)), hβ⟩
  · rintro ⟨α, hα, rfl⟩
    obtain ⟨hα₀, v, hv, hv0⟩ := α.property
    have hpair := (face_root_signs hc hb hlam α).1.mpr hα
    have hw : v ∈ adjointWeightSpace T α.val s := by
      change v ∈ (adjointWeightSpace T α.val s : Set (Lie k G.val))
      rwa [RootData.CharacterPairing.adjointWeightSpaceVectors G T s α.val]
    have hL : v ∈ lieImage L.centralizer := by
      rw [(limitLie_weightSpans G T hT lam L s).2]
      exact (le_iSup (fun χ : {χ : Character T.group // pairing T.group χ lam = 0} ↦
        adjointWeightSpace T χ.val s) ⟨α.val, hpair⟩) hw
    obtain ⟨w, hw⟩ := hL
    exact ⟨fun h ↦ hα₀ (hein (h.trans he₀.symm)), w,
      weightVector_of_map L.centralizer.inclusion e.inv he' (hw.symm ▸ hv),
      fun h ↦ hv0 (by simpa only [h, map_zero] using hw.symm)⟩

private theorem face_parabolic
    (hG : IsReductive G) (hT : IsSplitTorus T.group) (hTm : IsGeometricallyMaximal T)
    {B : ClosedSubgroup G.val} (hB : IsKBorel B) (hTB : IsSubgroupOf T B)
    {b : D.rootDatum.Base} {I : Set (Root T)}
    {c lam : Cocharacter T.group} (hc : positiveRoots T c = subgroupRoots T B)
    (hb : IsBaseFor D.rootDatum (evaluate D c) b) (hlam : HasFace b I lam)
    (L : LimitDecomposition (lam ≫ T.inclusion)) :
    IsParabolic G L.parabolic ∧ IsSubgroupOf B L.parabolic := by
  obtain ⟨hBs, hBc⟩ := kBorel_smooth_connected G B hB
  have hBP := subgroupOf_limit_of_rootSigns G hG T B hT hTm hBs hBc hTB lam L
    (fun α hα ↦ (face_root_signs hc hb hlam α).2 hα)
  letI := hG.1
  let P := extendSubgroup (AlgebraicClosure k) L.parabolic
  exact ⟨⟨hG, (CocharacterDynamics.limitSubgroupsSmooth G _ L).1,
    P.isClosedImmersion, extendSubgroup (AlgebraicClosure k) B, hB.choose_spec,
    extend_subgroupOf hBP⟩, hBP⟩

