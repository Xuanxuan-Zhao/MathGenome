section Assembly

variable {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
variable (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)

private instance (w : D.Place) : T2Space (LocalPoints D i w) :=
  (localMatrixEmbedding D i w).isEmbedding.t2Space

private theorem continuous_factor {J : Finset D.Place} (w : (↑J : Set D.Place)) :
    Continuous (WeakApproximationByTori.factor D i J w) := by
  apply continuous_pi
  intro z
  change Continuous (fun x : LocalPoints D i w.val => Pi.mulSingle (M := fun t : (↑J : Set D.Place) => LocalPoints D i t.val) w x z)
  by_cases h : z = w
  · subst z
    simp only [Pi.mulSingle_eq_same]
    exact continuous_id
  · simp only [Pi.mulSingle_eq_of_ne h]
    exact continuous_const

private theorem contracted_mulSingle {J : Finset D.Place}
    (w : (↑J : Set D.Place)) {x : LocalPoints D i w.val} (hx : Contracted x) :
    Contracted (WeakApproximationByTori.factor D i J w x) := by
  obtain ⟨a, ha⟩ := hx
  let f := WeakApproximationByTori.factor D i J w
  refine ⟨f a, ?_⟩
  change Tendsto (fun n : ℕ => f a ^ n * f x * (f a ^ n)⁻¹) atTop (𝓝 1)
  have hc : Continuous f := continuous_factor D i w
  simpa only [Function.comp_def, map_mul, map_inv, map_pow, map_one] using
    (hc.tendsto' 1 1 (map_one f)).comp ha

/-- Density of the subgroup generated by contracted elements passes to a finite
product, by applying the factor embeddings and the finite product formula. -/
theorem dense_contracted_product (J : Finset D.Place)
    (h : ∀ w : (↑J : Set D.Place), Dense (Subgroup.closure
      {x : LocalPoints D i w.val | Contracted x} : Set (LocalPoints D i w.val))) :
    Dense (Subgroup.closure {x : FinitePoints D i J | Contracted x} :
      Set (FinitePoints D i J)) := by
  classical
  let H := (Subgroup.closure {x : FinitePoints D i J | Contracted x}).topologicalClosure
  have hfactor (w : (↑J : Set D.Place)) (x : LocalPoints D i w.val) :
      WeakApproximationByTori.factor D i J w x ∈ H := by
    let f := WeakApproximationByTori.factor D i J w
    have hclosed : IsClosed ((H.comap f : Subgroup (LocalPoints D i w.val)) :
        Set (LocalPoints D i w.val)) :=
      (Subgroup.isClosed_topologicalClosure _).preimage (continuous_factor D i w)
    have hsubset :
        Subgroup.closure {x : LocalPoints D i w.val | Contracted x} ≤ H.comap f := by
      apply (Subgroup.closure_le _).mpr
      intro y hy
      exact Subgroup.le_topologicalClosure _
        (Subgroup.subset_closure (contracted_mulSingle D i w hy))
    exact closure_minimal hsubset hclosed (h w x)
  intro x
  change x ∈ H
  exact Subgroup.pi_mem_of_mulSingle_mem x (fun w => hfactor w (x w))

/-- Tori give density at a finite remainder when all its factors are
archimedean and connected. -/
theorem denseProjection_of_archimedeanConnected
    (hTori : Specs.WeakApproximationByTori.ArchimedeanComponentsFor D)
    (hG : IsSemisimple G) (J : Finset D.Place)
    (hArch : ∀ w ∈ J, ∃ z : D.InfinitePlace, w = Sum.inr z)
    (hConn : ∀ z : D.InfinitePlace, Sum.inr z ∈ J → ConnectedSpace (LocalPoints D i (.inr z))) :
    DenseRange (rationalProjection D i J) := by
  let Z := (rationalProjection D i J).range.topologicalClosure
  have hfactor (w : (↑J : Set D.Place)) (x : LocalPoints D i w.val) :
      WeakApproximationByTori.factor D i J w x ∈ Z := by
    obtain ⟨z, hz⟩ := hArch w.val w.property
    obtain ⟨w, hw⟩ := w
    dsimp at hz
    subst w
    let := hConn z hw
    exact hTori G hG i J z hw x (by
      rw [PreconnectedSpace.connectedComponent_eq_univ]
      exact mem_univ _)
  intro x
  change x ∈ Z
  exact Subgroup.pi_mem_of_mulSingle_mem x (fun w => hfactor w (x w))

/-- Once the adelic projection has dense arithmetic image on a block and the
local contraction groups generate there, the entire block lies in the diagonal
closure with identity on the other coordinates. -/
theorem isolate_of_denseProjection (S J : Finset D.Place) (hSJ : Disjoint J S)
    (U : Subgroup (Adeles D i (S ∪ J)))
    (hUc : IsCompact (U : Set (Adeles D i (S ∪ J))))
    (hUo : IsOpen (U : Set (Adeles D i (S ∪ J))))
    (hProj : Dense (projectedArithmetic D i S J U : Set (FinitePoints D i J)))
    (hLocal : ∀ w : (↑J : Set D.Place), Dense (Subgroup.closure
      {x : LocalPoints D i w.val | Contracted x} : Set (LocalPoints D i w.val))) :
    ∀ (w : Outside D S), w.val ∈ J → ∀ x : LocalPoints D i w.val,
      RestrictedProduct.mulSingle (fun z : Outside D S => localSubgroup D i z.val) w x ∈
        diagonalClosure D i S := by
  intro w hw x
  obtain ⟨y, hy⟩ := mulSingle_mem_range_insertFinite D i hSJ w hw x
  rw [← hy]
  exact (isolateAdelicFactors D i S J hSJ U hUc hUo).2 hProj
    (dense_contracted_product D i J hLocal) y

private theorem noncompact_of_omitted_superset {S T : Finset D.Place} (h : S ⊆ T)
    (hS : ¬ CompactSpace (FinitePoints D i S)) : ¬ CompactSpace (FinitePoints D i T) := by
  intro hT
  let := hT
  apply hS
  let f := forgetPlaces D i h
  have hf : Continuous f := by
    apply continuous_pi
    intro w
    change Continuous (fun x : FinitePoints D i T => x ⟨w.val, h w.property⟩)
    exact continuous_apply (⟨w.val, h w.property⟩ : (↑T : Set D.Place))
  have hs : Function.Surjective f := by
    intro x
    refine ⟨fun w => if hw : w.val ∈ S then x ⟨w.val, hw⟩ else 1, ?_⟩
    funext w
    change (if hw : w.val ∈ S then x ⟨w.val, hw⟩ else 1) = x w
    have hw : w.val ∈ S := w.property
    rw [dite_eq_left hw]
  exact hs.compactSpace hf

/-- Strong approximation follows after removing a disjoint finite block whose
projection and subgroups of contracted elements are both dense. -/
private theorem enlarge_of_denseProjection (S J : Finset D.Place) (hSJ : Disjoint J S)
    (U : Subgroup (Adeles D i (S ∪ J)))
    (hUc : IsCompact (U : Set (Adeles D i (S ∪ J))))
    (hUo : IsOpen (U : Set (Adeles D i (S ∪ J))))
    (hProj : Dense (projectedArithmetic D i S J U : Set (FinitePoints D i J)))
    (hLocal : ∀ w : (↑J : Set D.Place), Dense (Subgroup.closure
      {x : LocalPoints D i w.val | Contracted x} : Set (LocalPoints D i w.val))) :
    StrongApproximation D i (S ∪ J) ↔ StrongApproximation D i S := by
  let Z := diagonalClosedSubgroup D i S
  have hZ : (Z : Set (Adeles D i S)) = diagonalClosure D i S := diagonalClosedSubgroup_coe D i S
  apply ((enlargeOmittedSet D i S (S ∪ J) Finset.subset_union_left).2 ?_).2.2
  intro x hx
  rw [← hZ]
  apply isolatedFactorsSpan D i S {w | w.val ∈ S ∪ J} Z (hZ ▸ isClosed_closure) _ _
  · intro w hw a
    change _ ∈ (Z : Set (Adeles D i S))
    rw [hZ]
    have hwJ := (Finset.mem_union.mp hw).resolve_left w.property
    exact isolate_of_denseProjection D i S J hSJ U hUc hUo hProj hLocal w hwJ a
  · exact (mem_forgetOutside_ker_iff D i Finset.subset_union_left x).mp hx

end Assembly

section NumberField

open LinearAlgebraicGroups.Specs.RelativeRank (relativeRank)
variable {K : Type u} [Field K] [NumberField K] {G : AffineAlgebraicGroup K}
variable (Dₙ : GlobalFieldData.{u,u} K) (i : MatrixRealization G)

set_option maxHeartbeats 2000000 in
private theorem isolate_finite_place
    (hD : Dₙ = .number inferInstance)
    (hG : IsAbsolutelyAlmostSimple G)
    (hquot : CompactSpace (Adeles Dₙ i ∅ ⧸ diagonalSubgroup Dₙ i))
    (S : Finset (Dₙ).Place) (hS : ¬ CompactSpace (FinitePoints Dₙ i S))
    (hCompact : ∀ a : (Dₙ).InfinitePlace, Sum.inr a ∉ S → CompactSpace (LocalPoints Dₙ i (.inr a)))
    (w : (Dₙ).FinitePlace) (hw : Sum.inl w ∉ S)
    (hRank : 0 < relativeRank (baseChangedAlgebraicGroup ((Dₙ).Completion (.inl w)) G))
    (hRad : Dense (↑(Subgroup.closure (localPointSet Dₙ i (.inl w)
      (parabolicRadicalPoints (baseChangedAlgebraicGroup ((Dₙ).Completion (.inl w)) G)))) :
      Set (LocalPoints Dₙ i (.inl w))))
    (hContracted : Dense (↑(Subgroup.closure
      {x : LocalPoints Dₙ i (.inl w) | Contracted x}) : Set (LocalPoints Dₙ i (.inl w)))) :
    ∀ x : LocalPoints Dₙ i (.inl w),
      RestrictedProduct.mulSingle (fun z : Outside Dₙ S => localSubgroup Dₙ i z.val)
        ⟨.inl w, hw⟩ x ∈ diagonalClosure Dₙ i S := by
  classical
  let J : Finset (Dₙ).Place := {Sum.inl w}
  let U := integralOutside Dₙ i (S ∪ J)
  have hwJ : Sum.inl w ∈ J := Finset.mem_singleton_self _
  have hdis : Disjoint J S := Finset.disjoint_singleton_left.mpr hw
  have hv : Sum.inl w ∈ S ∪ J := Finset.mem_union_right S hwJ
  obtain ⟨hUc, hUo⟩ := ArithmeticLatticeProjection.compactOpenOutside Dₙ i (S ∪ J)
    (fun a ha => hCompact a (fun h => ha (Finset.mem_union_left J h)))
  obtain ⟨H, hH, _, _, _, hfull⟩ := ProjectiveRecurrence.padicLatticeProjection G i Dₙ hD
    w S (S ∪ J) U Finset.subset_union_left hw hv hquot hS hUc hUo hG hRank
  have hDense : Dense (↑((lattice Dₙ i (S ∪ J) U).map (evaluatePlace Dₙ i hv)) :
      Set (LocalPoints Dₙ i (.inl w))) := by
    rw [dense_iff_closure_eq, ← hH, hfull hRad, Subgroup.coe_top]
  let : Unique (↑J : Set (Dₙ).Place) :=
    { default := ⟨.inl w, hwJ⟩
      uniq := fun y => Subtype.ext (Finset.mem_singleton.mp y.property) }
  let e : FinitePoints Dₙ i J ≃ₜ LocalPoints Dₙ i (.inl w) :=
    Homeomorph.piUnique (fun y : (↑J : Set (Dₙ).Place) => LocalPoints Dₙ i y.val)
  have hProj : Dense (projectedArithmetic Dₙ i S J U : Set (FinitePoints Dₙ i J)) := by
    apply e.symm.surjective.denseRange.dense_of_mapsTo e.symm.continuous hDense
    rintro _ ⟨y, hy, rfl⟩
    refine ⟨y, hy, e.injective ?_⟩
    rw [e.apply_symm_apply]
    rfl
  have hLocal (y : (↑J : Set Dₙ.Place)) :
      Dense (↑(Subgroup.closure {x : LocalPoints Dₙ i y.val | Contracted x}) :
        Set (LocalPoints Dₙ i y.val)) := by
    have h : y.val = Sum.inl w := Finset.mem_singleton.mp y.property
    exact h ▸ hContracted
  intro x
  exact isolate_of_denseProjection Dₙ i S J hdis U hUc hUo hProj hLocal ⟨.inl w, hw⟩ hwJ x

set_option maxHeartbeats 1600000 in
private theorem anisotropicNumber_of_local
    (hD : Dₙ = .number inferInstance)
    (hG : IsAbsolutelyAlmostSimple G)
    (hquot : CompactSpace (Adeles Dₙ i ∅ ⧸ diagonalSubgroup Dₙ i))
    (S : Finset (Dₙ).Place) (hS : ¬ CompactSpace (FinitePoints Dₙ i S))
    (hArch : ∀ w : (Dₙ).InfinitePlace, ¬ CompactSpace (LocalPoints Dₙ i (.inr w)) →
      Dense (↑(Subgroup.closure (localPointSet Dₙ i (.inr w) (cocharacterRadicalPoints
        (baseChangedAlgebraicGroup ((Dₙ).Completion (.inr w)) G)))) :
        Set (LocalPoints Dₙ i (.inr w))) ∧
      Dense (↑(Subgroup.closure {x : LocalPoints Dₙ i (.inr w) | Contracted x}) :
        Set (LocalPoints Dₙ i (.inr w))))
    (hConn : ∀ w : (Dₙ).InfinitePlace, CompactSpace (LocalPoints Dₙ i (.inr w)) →
      ConnectedSpace (LocalPoints Dₙ i (.inr w)))
    (hFinite : ∀ w : (Dₙ).FinitePlace,
      0 < relativeRank (baseChangedAlgebraicGroup ((Dₙ).Completion (.inl w)) G) ∧
      Dense (↑(Subgroup.closure (localPointSet Dₙ i (.inl w) (parabolicRadicalPoints
        (baseChangedAlgebraicGroup ((Dₙ).Completion (.inl w)) G)))) :
        Set (LocalPoints Dₙ i (.inl w))) ∧
      Dense (↑(Subgroup.closure {x : LocalPoints Dₙ i (.inl w) | Contracted x}) :
        Set (LocalPoints Dₙ i (.inl w)))) :
    StrongApproximation Dₙ i S := by
  classical
  let : Fintype Dₙ.InfinitePlace := by
    rw [hD]
    exact inferInstanceAs (Fintype (NumberField.InfinitePlace K))
  let A : Finset (Dₙ).InfinitePlace := Finset.univ.filter
    (fun w => Sum.inr w ∉ S ∧ ¬ CompactSpace (LocalPoints Dₙ i (.inr w)))
  have hA (w : ↑A) : Sum.inr w.val ∉ S ∧ ¬ CompactSpace (LocalPoints Dₙ i (.inr w.val)) :=
    (Finset.mem_filter.mp w.property).2
  let j : (Dₙ).InfinitePlace ↪ (Dₙ).Place := ⟨Sum.inr, Sum.inr_injective⟩
  let J := A.map j
  let T := S ∪ J
  let U := integralOutside Dₙ i T
  have hdis : Disjoint J S := by
    apply Finset.disjoint_left.mpr
    intro w hw hwS
    obtain ⟨a, ha, rfl⟩ := Finset.mem_map.mp hw
    exact (hA ⟨a, ha⟩).1 hwS
  have hCompact (w : (Dₙ).InfinitePlace) (hw : Sum.inr w ∉ T) :
      CompactSpace (LocalPoints Dₙ i (.inr w)) := by
    by_contra hn
    apply hw
    apply Finset.mem_union_right
    exact Finset.mem_map.mpr ⟨w,
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun hs => hw (Finset.mem_union_left J hs), hn⟩,
      rfl⟩
  have hEnlarge : StrongApproximation Dₙ i T → StrongApproximation Dₙ i S := by
    by_cases hAne : A.Nonempty
    · obtain ⟨hUc, hUo⟩ := ArithmeticLatticeProjection.compactOpenOutside Dₙ i T hCompact
      let f (a : ↑A) : (↑J : Set (Dₙ).Place) :=
        ⟨j a.val, Finset.mem_map.mpr ⟨a.val, a.property, rfl⟩⟩
      let e := Equiv.ofBijective f
        ⟨fun a b hab => Subtype.ext (j.injective (congrArg Subtype.val hab)), by
          intro y
          obtain ⟨a, ha, h⟩ := Finset.mem_map.mp y.property
          exact ⟨⟨a, ha⟩, Subtype.ext h⟩⟩
      let reindex : (∀ a : ↑A, LocalPoints Dₙ i (.inr a.val)) ≃ₜ FinitePoints Dₙ i J :=
        Homeomorph.piCongrLeft (Y := fun y : (↑J : Set Dₙ.Place) => LocalPoints Dₙ i y.val) e
      have haT (a : ↑A) : Sum.inr a.val ∈ T := Finset.mem_union_right S (f a).property
      have hd := ProjectiveRecurrence.archimedeanLatticeProjection G i Dₙ hD S T A U
        Finset.subset_union_left hAne (fun a => (hA a).1) haT hquot hS hUc hUo hG
        (fun a => (hArch a.val (hA a).2).1)
      have hp : Dense (projectedArithmetic Dₙ i S J U : Set (FinitePoints Dₙ i J)) := by
        apply reindex.surjective.denseRange.dense_of_mapsTo reindex.continuous hd
        rintro _ ⟨x, hx, rfl⟩
        refine ⟨x, hx, reindex.symm.injective ?_⟩
        rw [reindex.symm_apply_apply]
        rfl
      apply (enlarge_of_denseProjection Dₙ i S J hdis U hUc hUo hp _).mp
      intro y
      obtain ⟨a, rfl⟩ := e.surjective y
      exact (hArch a.val (hA a).2).2
    · have hempty : J = ∅ := by simp [J, Finset.not_nonempty_iff_eq_empty.mp hAne]
      simp [T, hempty]
  apply hEnlarge
  let B := Finset.univ.filter (fun w : (Dₙ).InfinitePlace => Sum.inr w ∉ T)
  let R := B.map j
  have hRT : Disjoint R T := by
    apply Finset.disjoint_left.mpr
    intro y hy hyT
    obtain ⟨w, hw, rfl⟩ := Finset.mem_map.mp hy
    exact (Finset.mem_filter.mp hw).2 hyT
  have hTori : Specs.WeakApproximationByTori.ArchimedeanComponentsFor Dₙ := by
    rw [hD]
    exact WeakApproximationByTori.archimedeanComponents (K := K)
  have hd : DenseRange (rationalProjection Dₙ i R) :=
    denseProjection_of_archimedeanConnected Dₙ i hTori
      hG.1 R
      (fun w hw => by
        obtain ⟨a, _, rfl⟩ := Finset.mem_map.mp hw
        exact ⟨a, rfl⟩)
      (fun w hw => hConn w (hCompact w (Finset.disjoint_left.mp hRT hw)))
  apply ((projectToRemainingPlaces Dₙ i T R hRT).2 ?_).2.2.mp hd
  rintro ⟨w | w, hw⟩ hR x
  · obtain ⟨hRank, hRad, hCont⟩ := hFinite w
    exact isolate_finite_place Dₙ i hD hG hquot T
      (noncompact_of_omitted_superset Dₙ i Finset.subset_union_left hS)
      hCompact w hw hRank hRad hCont x
  · exact (hR (Finset.mem_map.mpr ⟨w, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hw⟩, rfl⟩)).elim

end NumberField

section CompactQuotient

private theorem compact_quotient_of_coordinate_formula {K : Type u} [Field K]
    {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)
    (h : Specs.CharacteristicZeroCompactness.CompactAdelicQuotient D i) :
    CompactSpace (Adeles D i ∅ ⧸ diagonalSubgroup D i) := by
  obtain ⟨d, hd, hcompact⟩ := h
  have hrange : d.range = diagonalSubgroup D i := by
    ext a
    change (∃ g, d g = a) ↔ ∃ g, ∀ w : Outside D ∅, a w = localPoint D i w.val g
    constructor
    · rintro ⟨g, rfl⟩
      exact ⟨g, hd g⟩
    · rintro ⟨g, hg⟩
      exact ⟨g, RestrictedProduct.ext _ _ fun w => (hd g w).trans (hg w).symm⟩
  exact hrange ▸ hcompact

end CompactQuotient

section NumberDataComparison

open LinearAlgebraicGroups.Specs.IntegralModels (RationalPoints)
open LinearAlgebraicGroups.Specs.CharacteristicZeroCompactness (CompactAdelicQuotient)

variable {K : Type u} [Field K] [hK : NumberField K] {G : AffineAlgebraicGroup K}

/-- The data used by the adelic topology and diagonal at one place. -/
private structure CompletionPointData (G : AffineAlgebraicGroup K) where
  points : Type u
  [group : Group points]
  [topology : TopologicalSpace points]
  integral : Subgroup points
  diagonal : RationalPoints G →* points

attribute [local instance] CompletionPointData.group CompletionPointData.topology

private def completionPointData (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)
    (p : D.Place) : CompletionPointData G where
  points := LocalPoints D i p
  integral := localSubgroup D i p
  diagonal := localPoint D i p

/-- Number-field places, completions and all their point data coincide when
the universe parameter for the constant field is changed. -/
private theorem numberCompletionPointData (i : MatrixRealization G) :
    (fun p : NumberPlace K => completionPointData (.number.{u,v} hK) i p) =
      (fun p : NumberPlace K => completionPointData (.number.{u,w} hK) i p) := by
  funext p
  cases p <;> rfl

private theorem numberStrongApproximation_iff (i : MatrixRealization G)
    (S : Finset (NumberPlace K)) :
    StrongApproximation (.number.{u,v} hK) i S ↔ StrongApproximation (.number.{u,w} hK) i S := by
  let P (X : NumberPlace K → CompletionPointData G) : Prop :=
    Dense {x : Πʳ p : {p : NumberPlace K // p ∉ S}, [(X p.val).points, (X p.val).integral] |
      ∃ g : RationalPoints G, ∀ p : {p : NumberPlace K // p ∉ S}, x p = (X p.val).diagonal g}
  exact Iff.of_eq (congrArg P (numberCompletionPointData.{u,v,w} i))

private theorem numberOmittedCompact_iff (i : MatrixRealization G)
    (D₁ : GlobalFieldData.{u,v} K) (h₁ : D₁ = .number hK)
    (D₂ : GlobalFieldData.{u,w} K) (h₂ : D₂ = .number hK)
    (S : Finset (NumberPlace K)) :
    CompactSpace (FinitePoints D₁ i (h₁.symm ▸ S)) ↔
      CompactSpace (FinitePoints D₂ i (h₂.symm ▸ S)) := by
  subst D₁
  subst D₂
  let P (X : NumberPlace K → CompletionPointData G) : Prop :=
    CompactSpace (∀ p : (↑S : Set (NumberPlace K)), (X p.val).points)
  exact Iff.of_eq (congrArg P (numberCompletionPointData.{u,v,w} i))

private theorem numberCompactQuotient_iff (i : MatrixRealization G) :
    CompactAdelicQuotient (.number.{u,v} hK) i ↔ CompactAdelicQuotient (.number.{u,w} hK) i := by
  let I := {p : NumberPlace K // p ∉ (∅ : Finset (NumberPlace K))}
  let P (X : NumberPlace K → CompletionPointData G) : Prop :=
    let A := Πʳ p : I, [(X p.val).points, (X p.val).integral]
    ∃ d : RationalPoints G →* A,
      (∀ (g : RationalPoints G) (p : I), d g p = (X p.val).diagonal g) ∧
        CompactSpace (A ⧸ d.range)
  exact Iff.of_eq (congrArg P (numberCompletionPointData.{u,v,w} i))

end NumberDataComparison

section Cartan

open LinearAlgebraicGroups.Specs.RealAlbertGroups (HasAbsoluteTypeF4)
open SplitAlbertLocalFormsSpecification (IsAbsoluteF4 HasF4Cartan)
open LinearAlgebraicGroups.Albert.AutomorphismTypeSpecification (cartanMatrix)
open LinearAlgebraicGroups.Specs.AbsoluteDynkinTypes (PreservesCartan)
open LinearAlgebraicGroups.Specs.Pinning (SplitBorelPair AttachedDatum)

private theorem f4Cartan_reverse :
    ∀ a b : Fin 4, CartanMatrix.F₄ (Fin.revPerm b) (Fin.revPerm a) = cartanMatrix a b := by
  decide

private theorem cartanOfType {K : Type u} [Field K] {P : SplitBorelPair K}
    (D : AttachedDatum P) :
    (letI := D.comm; ∃ e : D.base.support ≃ Fin 4,
      PreservesCartan (RootData.integralCartan D.datum.rootDatum D.base) CartanMatrix.F₄ e) →
    HasF4Cartan D.toBased := by
  let := D.comm
  rintro ⟨e, he⟩
  refine ⟨(Fin.revPerm.trans e.symm : Fin 4 ≃ D.base.support), fun a b => ?_⟩
  change D.datum.rootDatum.pairing (e.symm (Fin.revPerm a)).val
    (e.symm (Fin.revPerm b)).val = cartanMatrix a b
  exact (he (e.symm (Fin.revPerm b)) (e.symm (Fin.revPerm a))).trans (by
    simpa only [e.apply_symm_apply] using f4Cartan_reverse a b)

theorem absoluteF4_iff {K : Type u} [Field K] (G : AffineAlgebraicGroup K) :
    HasAbsoluteTypeF4 G ↔ IsAbsoluteF4 G := by
  constructor
  · rintro ⟨hG, P, hP, D, h⟩
    exact ⟨hG, P, hP, D, cartanOfType D h⟩
  · rintro ⟨hG, P, hP, D, e, he⟩
    let := D.comm
    change Fin 4 ≃ D.base.support at e
    refine ⟨hG, P, hP, D, (e.symm.trans Fin.revPerm : D.base.support ≃ Fin 4), fun a b => ?_⟩
    change ∀ i j, D.datum.rootDatum.pairing (e i).val (e j).val = cartanMatrix i j at he
    change D.datum.rootDatum.pairing b.val a.val =
      CartanMatrix.F₄ (Fin.revPerm (e.symm a)) (Fin.revPerm (e.symm b))
    rw [f4Cartan_reverse (e.symm b) (e.symm a), ← he, e.apply_symm_apply, e.apply_symm_apply]

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open scoped CategoryTheory.MonObj
open LinearAlgebraicGroups.Specs.GeometricRadicals (GeometricGroup)
open LinearAlgebraicGroups.Specs.SimplyConnectedLattice (GeometricallySimplyConnected)

/-- The geometric F₄ Cartan condition implies absolute almost simplicity and
geometric simple connectedness. -/
theorem geometricProperties {K : Type u} [Field K] (G : AffineAlgebraicGroup K)
    (h : HasAbsoluteTypeF4 G) : IsAbsolutelyAlmostSimple G ∧ GeometricallySimplyConnected G :=
  RealAlbertGroups.absolute_simple_and_simply_connected_of_type_f4 G h

open LinearAlgebraicGroups.Specs.Pinning (BasedRootDatum BasedIso)
open private basedIso_base_iff alignPairs pinAlignedPairs
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Classification.PinnedEquivalence
open private sepClosedBorelPair sepClosedBorelPair_group
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.OctonionForms
open private groupBaseChangeTower from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Reductive.RadicalBaseChange
open private fibreTowerIso from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Classification.SimplyConnectedLattice
open private reductive_of_semisimple from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Classification.CentralIsogenies

private theorem f4Cartan_of_basedIso {D E : BasedRootDatum.{u}}
    (e : BasedIso D E) (hD : HasF4Cartan D) : HasF4Cartan E := by
  obtain ⟨a, ha⟩ := hD
  let j := e.val.indexEquiv.subtypeEquiv (basedIso_base_iff e)
  refine ⟨a.trans j, fun b c => ?_⟩
  change E.datum.pairing (e.val.indexEquiv (a b).val)
    (e.val.indexEquiv (a c).val) = cartanMatrix b c
  exact (e.val.toHom.pairing).trans (ha b c)

/-- The same pinned datum occurs after arbitrary scalar extension, by using
the two geometric fibres of an integral split realization. -/
theorem absoluteF4_fieldExtension {K F : Type u} [Field K] [Field F] [Algebra K F]
    (G : AffineAlgebraicGroup K) (h : HasAbsoluteTypeF4 G) :
    HasAbsoluteTypeF4 (baseChangedAlgebraicGroup F G) := by
  obtain ⟨hG, P, hP, D, hD⟩ := (absoluteF4_iff G).mp h
  let H := baseChangedAlgebraicGroup F G
  have hH : IsSemisimple H :=
    (Reductive.RadicalBaseChange.semisimpleFieldExtension (K := F) G hG.1 hG.2.1).mpr hG
  let E := AlgebraicClosure K
  let L := AlgebraicClosure F
  let j : E →ₐ[K] L := IsAlgClosed.lift
  let : Algebra E L := j.toRingHom.toAlgebra
  let : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq' j.comp_algebraMap.symm
  let := D.toBased.finiteRoots
  obtain ⟨M⟩ := Classification.IntegralRealization.integralRealization D.toBased
  obtain ⟨_, X, f, _⟩ := M.fieldFibre E
  obtain ⟨_, Y, g, _⟩ := M.fieldFibre L
  obtain ⟨q⟩ := ((Classification.PinnedEquivalence.pinnedEquivalence.2 E).2.1
    P X.pinned.pair D X.attached).mpr ⟨X.datumIso.val⟩
  have hp : Nonempty ((GeometricGroup G).val ≅ (Specs.IntegralSemisimpleModel.fibre E).obj M.group) := by
    rw [← hP]
    exact ⟨q ≪≫ f.symm⟩
  obtain ⟨p⟩ := hp
  have hHL : IsSemisimple (GeometricGroup H) :=
    (Reductive.RadicalBaseChange.semisimpleFieldExtension (K := L) H hH.1 hH.2.1).mpr hH
  let hR := reductive_of_semisimple (GeometricGroup H) hHL
  let Q := sepClosedBorelPair (GeometricGroup H) hR
  have hQ : Q.G = GeometricGroup H := sepClosedBorelPair_group _ hR
  let iso : Y.pinned.pair.G.val ≅ Q.G.val := by
    rw [hQ]
    change Y.pinned.pair.G.val ≅ ((groupBaseChange F L).obj ((groupBaseChange K F).obj G.val))
    exact g.symm ≪≫ ((fibreTowerIso E L).app M.group) ≪≫
      (groupBaseChange E L).mapIso p.symm ≪≫
      ((groupBaseChangeTower (k := K) (K := E) L).app G.val).symm ≪≫
      (groupBaseChangeTower (k := K) (K := F) L).app G.val
  let y : BasedIso D.toBased Y.attached.toBased := Y.datumIso
  have hy := f4Cartan_of_basedIso y hD
  obtain ⟨φ, t, b, ht, hb⟩ := alignPairs Y.pinned.pair Q iso
  obtain ⟨P', Q', hP', hQ', ⟨pinned⟩⟩ := pinAlignedPairs Y.pinned.pair Q
    (Classification.Pinning.standardAdditiveLine L) φ t ht b hb
  have hY : ∃ C : AttachedDatum P'.pair, HasF4Cartan C.toBased := by
    rw [hP']
    exact ⟨Y.attached, hy⟩
  obtain ⟨C, hC⟩ := hY
  let B := Classification.Pinning.attachedDatum Q'.pair
  exact (absoluteF4_iff H).mpr ⟨hH, Q'.pair, (congrArg SplitBorelPair.G hQ').trans hQ, B,
    f4Cartan_of_basedIso (Classification.Pinning.inducedBasedIso pinned C B) hC⟩

end Cartan

