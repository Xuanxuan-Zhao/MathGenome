private theorem anisotropic_of_noPositiveRank {K : Type u} [Field K]
    (G : AffineAlgebraicGroup K) (h : ¬ 0 < relativeRank G) : IsAnisotropic G.val := by
  intro T hT
  obtain ⟨r, ⟨e⟩⟩ := hT
  by_cases hr : r = 0
  · subst r
    exact ⟨e ≪≫ empty_power_iso⟩
  · exfalso
    have hr' : (0 : WithBot ℕ∞) < (r : WithBot ℕ∞) := by
      exact_mod_cast Nat.pos_of_ne_zero hr
    apply h (hr'.trans_le ?_)
    rw [← standard_torus_dimension (k := K), ← dimension_of_iso e]
    exact split_dimension_le_rank G T ⟨r, ⟨e⟩⟩

set_option maxHeartbeats 1800000 in
private theorem radicalClosure_subset_localPlus {K : Type u} [Field K]
    {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)
    (w : D.Place) :
    (↑(Subgroup.closure (localPointSet D i w
      (parabolicRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G)))) :
        Set (LocalPoints D i w)) ⊆ localPlus D i w := by
  let F := D.Completion w
  let G' := baseChangedAlgebraicGroup F G
  let φ := (completionPointEquiv D i w).toMonoidHom
  have hEq : localPlus D i w = ((unipotentGenerated G').map φ : Set (LocalPoints D i w)) := by
    ext g
    change (∃ p ∈ unipotentGenerated G',
      baseChangePoint K F G.val.X (CommAlgCat.of F F) (toUnit _ ≫ p) = g) ↔
      g ∈ (unipotentGenerated G').map φ
    constructor
    · rintro ⟨p, hp, hpg⟩
      exact ⟨p, hp, (completionPointEquiv_apply D i w p).trans hpg⟩
    · rintro ⟨p, hp, hpg⟩
      exact ⟨p, hp, (completionPointEquiv_apply D i w p).symm.trans hpg⟩
  rw [hEq]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨p, ⟨P, hP, U, hU, q, hq⟩, hp⟩
  let e := testPointSections G'.val
  refine ⟨e p, ?_, ?_⟩
  · apply (le_iSup_of_le P (le_iSup_of_le hP (le_iSup_of_le U (le_iSup_of_le hU le_rfl))) :
      SubgroupSections (subgroupOfSubgroup P U) (𝟙_ (SchemeOver F)) ≤ unipotentGenerated G')
    exact ⟨testPointSections U.group q, by
      change (testPointSections U.group q) ≫ (U.inclusion ≫ P.inclusion).hom.hom = e p
      rw [← hq]
      exact (Category.assoc _ _ _).symm⟩
  · have hpoint : toUnit ((testSpec F).obj (Opposite.op (CommAlgCat.of F F))) ≫ e p = p := by
      have he : (toUnit _) ≫ e p = e.symm (e p) := by
        change toUnit _ ≫ e p = _ ≫ e p
        exact congrArg (· ≫ e p) (toUnit_unique _ _).symm
      exact he.trans (e.symm_apply_apply p)
    apply Over.OverMorphism.ext
    change (completionPointEquiv D i w (e p)).left = g.left
    rw [completionPointEquiv_apply, hpoint]
    exact hp.symm

/-- For an isotropic group, apply the two fixed opposite radicals once the
parabolic radical points are known to generate densely in its outside factors. -/
theorem isotropic_of_localRadicals {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)
    (hG : IsAbsolutelyAlmostSimple G) (hr : 0 < relativeRank G)
    (S : Finset D.Place) (hS : S.Nonempty)
    (hLocal : ∀ w : Outside D S,
      Dense (↑(Subgroup.closure (localPointSet D i w.val (parabolicRadicalPoints
        (baseChangedAlgebraicGroup (D.Completion w.val) G)))) : Set (LocalPoints D i w.val))) :
    StrongApproximation D i S := by
  have hP := (Descent.RelativeRank.semisimpleParabolicCriterion G hG.1).mpr hr
  obtain ⟨c, hc⟩ := proper_parabolic_cocharacter G hP
  have hc' : IsNoncentral c := by
    unfold IsNoncentral
    change ¬ ∀ X g, Centralizes c g at hc
    push Not at hc
    exact hc
  obtain ⟨P⟩ := existsLimitDecomposition G c
  obtain ⟨Q⟩ := existsLimitDecomposition G (oppositeCocharacter c)
  exact ((OppositeRadicals.approximation D G i hG c hc' P Q).2.2.2.2 S hS).2
    (fun w => (hLocal w).mono (radicalClosure_subset_localPlus D i w.val))

/-- Positive global rank gives positive local rank at every completion, via
the noncentral cocharacter in the opposite-radical construction. -/
theorem positiveRank_at_completion {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G)
    (hG : IsAbsolutelyAlmostSimple G) (hr : 0 < relativeRank G) (w : D.Place) :
    0 < relativeRank (baseChangedAlgebraicGroup (D.Completion w) G) := by
  have hP := (Descent.RelativeRank.semisimpleParabolicCriterion G hG.1).mpr hr
  obtain ⟨c, hc⟩ := proper_parabolic_cocharacter G hP
  have hc' : IsNoncentral c := by
    unfold IsNoncentral
    change ¬ ∀ X g, Centralizes c g at hc
    push Not at hc
    exact hc
  obtain ⟨P⟩ := existsLimitDecomposition G c
  obtain ⟨Q⟩ := existsLimitDecomposition G (oppositeCocharacter c)
  obtain ⟨e, _, hNoncentral, _, _, _⟩ := OppositeRadicals.localGeneration D G i hG c hc' P Q w
  let H := baseChangedAlgebraicGroup (D.Completion w) G
  have hH := (OppositeRadicals.absolutelyAlmostSimpleFieldExtension
    (F := D.Completion w) G hG).1
  apply (Descent.RelativeRank.semisimpleParabolicCriterion H hH).mp
  refine exists_proper_dynamic_of_noncentral H (reductive_of_semisimple H hH)
    (e.hom ≫ (groupBaseChange K (D.Completion w)).map c) ?_
  intro hh
  obtain ⟨X, g, hn⟩ := hNoncentral
  exact hn (hh X g)

end GlobalCases

section SplitPoints

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj
open LinearAlgebraicGroups.Specs (ClosedSubgroup)
open LinearAlgebraicGroups.Specs.GeometricRadicals (IsSplitTorus IsSplitReductive)
open LinearAlgebraicGroups.Specs.RankOneFlag (IsGeometricallyMaximal)
open LinearAlgebraicGroups.Specs.SimplyConnectedLattice (GeometricallySimplyConnected)
open LinearAlgebraicGroups.Specs.CharacterDescent (Cocharacter)
open LinearAlgebraicGroups.Specs.CharacterPairing (pairing)
open LinearAlgebraicGroups.Specs.AbstractPairing (Root)
open LinearAlgebraicGroups.Specs.OrderedRootProducts (RootSubgroupFamily)
open LinearAlgebraicGroups.Specs.BorelsAndChambers (contractingSubgroup positiveRoots)
open CocharacterDynamics (existsLimitDecomposition)
open private reductive_of_semisimple from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Classification.CentralIsogenies
open private rootCoordinate_exists rootSubgroup_embeds
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.RootData.OrderedRootProducts
open private cocharacter_parabolic from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.RelativeRayGeneration
open private dimension_of_iso split_dimension_le_rank standard_torus_dimension
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Descent.RelativeRank

/-- The coroot of any absolute root contracts its root subgroup, so the
root generation theorem gives generation by rational parabolic radicals. -/
theorem splitParabolicRadicals_generate {F : Type u} [Field F]
    (G : AffineAlgebraicGroup F) (hG : IsSemisimple G) (hsc : GeometricallySimplyConnected G)
    (T : ClosedSubgroup G.val) (hs : IsSplitTorus T.group) (hm : IsGeometricallyMaximal T) :
    Subgroup.closure (parabolicRadicalPoints G) = ⊤ := by
  classical
  have hred := reductive_of_semisimple G hG
  obtain ⟨comm, ⟨B⟩⟩ := RootData.AbstractPairing.abstractPairing G hred T hs hm
  let := comm
  let roots := RootData.RootGroups.rootSubgroups G hred T hs hm
  have hV (a : Root T) : Nonempty {V : ClosedSubgroup G.val //
      Specs.RootGroups.IsRootSubgroup T V a.val} := by
    obtain ⟨V, hV, _⟩ := (roots.2 a.val a.property).2.2
    exact ⟨⟨V, hV⟩⟩
  have hgen := SplitLocalGeneration.splitLocalGeneration G hG hsc T hs hm
  apply top_unique
  rw [← hgen]
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨α, hα, U, hU, p, rfl⟩
  apply Subgroup.subset_closure
  let a : Root T := ⟨α, hα⟩
  let V : RootSubgroupFamily T := fun b =>
    if h : b = a then ⟨U, h ▸ hU⟩ else (hV b).some
  have hVa : (V a).val = U := by simp [V]
  let c : Cocharacter T.group := Additive.toMul (B.rootDatum.coroot a)
  have ha : a ∈ positiveRoots T c := by
    change 0 < pairing T.group a.val c
    rw [← B.pairing_eq, ← B.root_eq]
    change 0 < B.rootDatum.toLinearMap (B.rootDatum.root a) (B.rootDatum.coroot a)
    rw [B.rootDatum.root_coroot_eq_pairing, B.rootDatum.pairing_same]
    decide
  obtain ⟨D⟩ := existsLimitDecomposition G (c ≫ T.inclusion)
  obtain ⟨x⟩ := rootCoordinate_exists RootData.RootGroups.rootSubgroups G hred T hs hm V a
  have hsub := rootSubgroup_embeds x c D ha
  rw [hVa] at hsub
  obtain ⟨f, hf⟩ := hsub
  refine ⟨D.parabolic, cocharacter_parabolic hred _ D, contractingSubgroup D,
    (Relative.SplitContractingRadical.contractingSubgroupIsRadical G hred _ D).1,
    p ≫ f.hom.hom, ?_⟩
  change (p ≫ f.hom.hom) ≫
    (D.contractingToParabolic ≫ D.parabolic.inclusion).hom.hom = p ≫ U.inclusion.hom.hom
  rw [D.contracting_in_G, Category.assoc]
  exact congrArg (p ≫ ·) ((Grp.forget (SchemeOver F)).congr_map hf)

end SplitPoints

section LocalPoints

open AlgebraicGeometry CategoryTheory
open scoped CategoryTheory.MonObj
open LinearAlgebraicGroups.Specs.AdelicGroups

/-- Every rational parabolic radical point is a contracting point of a
rational cocharacter and is contracted in the matrix topology. -/
theorem parabolicPoints_are_contracted {F : Type u} [NontriviallyNormedField F]
    (G : AffineAlgebraicGroup F) (i : MatrixRealization G) :
    parabolicRadicalPoints G ⊆ cocharacterRadicalPoints G ∩ {g : PointsIn i F | Contracted g} := by
  intro g hg
  obtain ⟨P, hP, U, hU, p, rfl⟩ := hg
  let R := CommAlgCat.of F F
  obtain ⟨c, D, _, _, hrad, hlim⟩ :=
    LocalCocharacterEvaluation.parabolicRadicalEvaluation G i P hP
  obtain ⟨e, he⟩ := hrad U hU
  let g : PointsIn i F := p ≫ (U.inclusion ≫ P.inclusion).hom.hom
  have hmem : g ∈ ((((groupPointsFunctor F).map D.contracting.inclusion).app R).hom).range := by
    refine ⟨p ≫ e.hom.hom.hom, ?_⟩
    change (p ≫ e.hom.hom.hom) ≫ D.contracting.inclusion.hom.hom = g
    rw [Category.assoc]
    exact congrArg (p ≫ ·) ((Grp.forget (SchemeOver F)).congr_map he)
  obtain ⟨t, ht⟩ := LocalCocharacterEvaluation.contractingScalarExists (E := F)
  have hscalar : Continuous (algebraMap F F) := by
    simpa using (continuous_id : Continuous (fun x : F => x))
  exact ⟨⟨c, D, hmem⟩, ⟨_, hlim hscalar t ht g hmem⟩⟩

end LocalPoints

section CompletionComparison

open AlgebraicGeometry CategoryTheory
open LinearAlgebraicGroups.Specs.RealAlbertGroups (HasAbsoluteTypeF4)
open LinearAlgebraicGroups.Specs.RelativeRank (relativeRank)
open LinearAlgebraicGroups.Specs.Pinning (SplitBorelPair)
open F4SplitFieldsSpecification (HasSplitMaximalTorus)
open private sepClosedBorelPair sepClosedBorelPair_group
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.OctonionForms
open private reductive_of_semisimple from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Classification.CentralIsogenies

private structure LocalGeneration {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    (D : GlobalFieldData.{u,u} K) (i : MatrixRealization G) (w : D.Place) : Prop where
  parabolic : Dense (↑(Subgroup.closure (localPointSet D i w
    (parabolicRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G)))) :
      Set (LocalPoints D i w))
  cocharacter : Dense (↑(Subgroup.closure (localPointSet D i w
    (cocharacterRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G)))) :
      Set (LocalPoints D i w))
  contracted : Dense (↑(Subgroup.closure {x : LocalPoints D i w | Contracted x}) :
    Set (LocalPoints D i w))

open private localPointSet_eq_image from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.ProjectiveRecurrence

/-- The comparison sends parabolic radicals to their original completion coordinates,
and carries convergence of the contracting conjugations along the homeomorphism. -/
private theorem localGeneration_of_comparison {K : Type u} [Field K]
    {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u,u} K)
    (i : MatrixRealization G) (w : D.Place)
    (j : MatrixRealization (baseChangedAlgebraicGroup (D.Completion w) G))
    (e : PointsIn j (D.Completion w) ≃ₜ* LocalPoints D i w)
    (he : ∀ p, (show Points G.val.X (CommAlgCat.of K (D.Completion w)) from e p).left =
      (baseChangePoint K (D.Completion w) G.val.X
        (CommAlgCat.of (D.Completion w) (D.Completion w)) p).left)
    (hd : Dense (↑(Subgroup.closure (G := PointsIn j (D.Completion w))
      (parabolicRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G))) :
        Set (PointsIn j (D.Completion w))))
    (hc : parabolicRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G) ⊆
      cocharacterRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G) ∩
        {x : PointsIn j (D.Completion w) | Contracted x}) :
    LocalGeneration D i w := by
  have h := e.surjective.denseRange.dense_image e.continuous hd
  change Dense (↑((Subgroup.closure (parabolicRadicalPoints
    (baseChangedAlgebraicGroup (D.Completion w) G))).map e.toMonoidHom) :
      Set (LocalPoints D i w)) at h
  rw [MonoidHom.map_closure] at h
  refine ⟨?_, ?_, h.mono (Subgroup.closure_mono ?_)⟩
  · rwa [localPointSet_eq_image D i w j e he]
  · rw [localPointSet_eq_image D i w j e he]
    exact h.mono (Subgroup.closure_mono (Set.image_mono fun _ hx => (hc hx).1))
  · rintro _ ⟨x, hx, rfl⟩
    obtain ⟨a, ha⟩ := (hc hx).2
    refine ⟨e a, ?_⟩
    have hlim := (e.continuous.tendsto' 1 1 (map_one e)).comp ha
    change Tendsto (fun n : ℕ => e (a ^ n * x * (a ^ n)⁻¹)) atTop (𝓝 1) at hlim
    change Tendsto (fun n : ℕ => e a ^ n * e x * (e a ^ n)⁻¹) atTop (𝓝 1)
    simpa only [map_mul, map_inv, map_pow] using hlim

private theorem denseParabolicPoints_of_split {F : Type u} [Field F] [TopologicalSpace F]
    (G : AffineAlgebraicGroup F) (i : MatrixRealization G) (hG : HasAbsoluteTypeF4 G)
    (hS : HasSplitMaximalTorus G) :
    Dense (↑(Subgroup.closure (G := PointsIn i F) (parabolicRadicalPoints G)) :
      Set (PointsIn i F)) := by
  obtain ⟨⟨T, hs, hm⟩, _⟩ := hS
  rw [splitParabolicRadicals_generate G hG.1 (geometricProperties G hG).2 T hs hm,
    Subgroup.coe_top]
  exact dense_univ

open private finiteNormedField infiniteNormedField
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.WeakApproximationLocalSmoothImage

private theorem splitOfAlgebraicallyClosed {F : Type u} [Field F] [IsAlgClosed F]
    (G : AffineAlgebraicGroup F) (hG : HasAbsoluteTypeF4 G) : HasSplitMaximalTorus G := by
  let hR := reductive_of_semisimple G hG.1
  let P := sepClosedBorelPair G hR
  have hP : P.G = G := sepClosedBorelPair_group G hR
  exact F4SplitFields.splittingOfIso G ((absoluteF4_iff G).mp hG) P
    (eqToIso (congrArg (fun H : AffineAlgebraicGroup F => H.val) hP))

variable {K : Type u} [Field K] [hK : NumberField K] {G : AffineAlgebraicGroup K}
variable (D : GlobalFieldData.{u,u} K) (i : MatrixRealization G)

/-- Splitting at the finite places gives positive rank and generation by
parabolic radicals for the given realization of each completed group. -/
private theorem numberFiniteGeneration (hD : D = .number hK) (hG : HasAbsoluteTypeF4 G)
    (w : D.FinitePlace) :
    0 < relativeRank (baseChangedAlgebraicGroup (D.Completion (.inl w)) G) ∧
      LocalGeneration D i (.inl w) := by
  subst D
  let D : GlobalFieldData.{u,u} K := .number hK
  let F := w.adicCompletion K
  let : NontriviallyNormedField F := finiteNormedField w
  let : Algebra K F := completionAlgebra D (.inl w)
  let H := baseChangedAlgebraicGroup F G
  have hH : HasAbsoluteTypeF4 H := absoluteF4_fieldExtension G hG
  have hS : HasSplitMaximalTorus H :=
    F4SplitFields.finiteCompletionSplitting D w H ((absoluteF4_iff H).mp hH)
  obtain ⟨_, j₀, _, e₀, he₀, _⟩ := ArchimedeanLieChart.baseChangeMatrixComparison K F G i
  let j : MatrixRealization H := j₀
  let e : PointsIn j F ≃ₜ* PointsIn i F := e₀
  exact ⟨hS.2, localGeneration_of_comparison D i (.inl w) j e he₀
    (denseParabolicPoints_of_split H j hH hS) (parabolicPoints_are_contracted H j)⟩

set_option maxHeartbeats 1600000 in
/-- Real factors use the real completion theorem. A complex factor is split
of positive rank, so it is noncompact and its radical points generate. -/
private theorem numberInfiniteGeneration (hD : D = .number hK) (hG : HasAbsoluteTypeF4 G)
    (w : D.InfinitePlace) :
    (CompactSpace (LocalPoints D i (.inr w)) → ConnectedSpace (LocalPoints D i (.inr w))) ∧
    (0 < relativeRank (baseChangedAlgebraicGroup (D.Completion (.inr w)) G) →
      ¬ CompactSpace (LocalPoints D i (.inr w))) ∧
    (¬ CompactSpace (LocalPoints D i (.inr w)) → LocalGeneration D i (.inr w)) := by
  subst D
  let D : GlobalFieldData.{u,u} K := .number hK
  let F := w.Completion
  let : NontriviallyNormedField F := infiniteNormedField w
  let : Algebra K F := completionAlgebra D (.inr w)
  let H := baseChangedAlgebraicGroup F G
  have hH : HasAbsoluteTypeF4 H := absoluteF4_fieldExtension G hG
  obtain ⟨_, j₀, _, e₀, he₀, _⟩ := ArchimedeanLieChart.baseChangeMatrixComparison K F G i
  let j : MatrixRealization H := j₀
  let e : PointsIn j F ≃ₜ* PointsIn i F := e₀
  have hcompact (hc : CompactSpace (PointsIn i F)) : CompactSpace (PointsIn j F) := by
    let := hc
    exact e.symm.surjective.compactSpace e.symm.continuous
  have hnoncompact (hc : ¬ CompactSpace (PointsIn i F)) :
      ¬ CompactSpace (PointsIn j F) := by
    intro h
    let := h
    exact hc (e.surjective.compactSpace e.continuous)
  rcases w.isReal_or_isComplex with hw | hw
  · obtain ⟨r, hr⟩ := numberRealCompletion w hw
    obtain ⟨hconn, hpos, hgen⟩ := F4RealCompletion.realCompletion r hr H j hH
    refine ⟨fun _ => ?_, fun hp hc => hpos hp (hcompact hc), fun hc => ?_⟩
    · let := hconn
      exact e.surjective.connectedSpace e.continuous
    · exact localGeneration_of_comparison D i (.inr w) j e he₀
        (hgen (hnoncompact hc)) (parabolicPoints_are_contracted H j)
  · obtain ⟨c, _⟩ := numberComplexCompletion w hw
    let : IsAlgClosed F := ⟨fun f =>
      Polynomial.Splits.of_splits_map_of_injective c.injective
        (IsAlgClosed.splits (f.map c.toRingHom)) (fun x _ => c.surjective x)⟩
    have hS := splitOfAlgebraicallyClosed H hH
    have hnc (h : CompactSpace (PointsIn i F)) : False :=
      F4RealCompletion.positiveRankNoncompact H j hH.1 hS.2 (hcompact h)
    have hgen : LocalGeneration D i (.inr w) :=
      localGeneration_of_comparison D i (.inr w) j e he₀
        (denseParabolicPoints_of_split H j hH hS) (parabolicPoints_are_contracted H j)
    exact ⟨fun h => (hnc h).elim, fun _ => hnc, fun _ => hgen⟩

end CompletionComparison

section StrongApproximation

open LinearAlgebraicGroups.Specs.RealAlbertGroups (HasAbsoluteTypeF4)
open LinearAlgebraicGroups.Specs.RelativeRank (relativeRank)
open LinearAlgebraicGroups.Specs.CharacteristicZeroCompactness (CompactAdelicQuotient)

private theorem numberStrongApproximation {K : Type u} [Field K] [hK : NumberField K]
    {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u,u} K) (i : MatrixRealization G)
    (hD : D = .number hK) (hG : HasAbsoluteTypeF4 G)
    (S : Finset D.Place) (hSne : S.Nonempty) (hS : ¬ CompactSpace (FinitePoints D i S)) :
    StrongApproximation D i S := by
  have hsimple := (geometricProperties G hG).1
  by_cases hr : 0 < relativeRank G
  · apply isotropic_of_localRadicals D i hsimple hr S hSne
    rintro ⟨w | w, _⟩
    · exact (numberFiniteGeneration D i hD hG w).2.parabolic
    · obtain ⟨_, hpos, hgen⟩ := numberInfiniteGeneration D i hD hG w
      exact (hgen (hpos (positiveRank_at_completion D i hsimple hr (.inr w)))).parabolic
  · have hcompact : CompactAdelicQuotient D i := by
      rw [hD]
      exact (numberCompactQuotient_iff.{u,0,u} i).mp
        (CharacteristicZeroCompactness.anisotropicAdelicCompactness G hG.1
          (anisotropic_of_noPositiveRank G hr) i)
    refine anisotropicNumber_of_local D i hD hsimple
      (compact_quotient_of_coordinate_formula D i hcompact) S hS ?_ ?_ ?_
    · intro w hw
      have h := (numberInfiniteGeneration D i hD hG w).2.2 hw
      exact ⟨h.cocharacter, h.contracted⟩
    · exact fun w => (numberInfiniteGeneration D i hD hG w).1
    · intro w
      obtain ⟨hpos, hgen⟩ := numberFiniteGeneration D i hD hG w
      exact ⟨hpos, hgen.parabolic, hgen.contracted⟩

/-- Strong approximation for groups of absolute type F₄ over global fields. -/
theorem strongApproximation : Specs.StrongApproximationF4.Statement.{u,v} := by
  intro K _ G hG D i S hSne hS
  cases D with
  | number hK =>
    let : NumberField K := hK
    let D := GlobalFieldData.number.{u,u} hK
    have hS' := (numberOmittedCompact_iff.{u,v,u} i (.number hK) rfl D rfl S).not.mp hS
    exact (numberStrongApproximation_iff.{u,u,v} i S).mp
      (numberStrongApproximation D i rfl hG S hSne hS')
  | function F t =>
    let := t.rationalAlgebra
    obtain ⟨⟨T, hs, hm⟩, _⟩ :=
      F4SplitFields.functionFieldSplitting (F := F) G ((absoluteF4_iff G).mp hG)
    exact SplitApproximation.splitStrongApproximation G hG.1 (geometricProperties G hG).2
      T hs hm (.function F t) i S hSne

end StrongApproximation

end
end LinearAlgebraicGroups.Arithmetic.StrongApproximationF4
