/-- The same completed subgroup generated by parabolic radicals witnesses both
density statements after comparison with the base-changed scheme. -/
private theorem dense_of_localPlus {K : Type u} [Field K] {G : AffineAlgebraicGroup K}
    (D : GlobalFieldData.{u,v} K) (i : MatrixRealization G) (w : D.Place)
    [Algebra ℝ (D.Completion w)] (hℝ : Continuous (algebraMap ℝ (D.Completion w)))
    (hd : Dense (localPlus D i w)) :
    Dense (Subgroup.closure (localPointSet D i w
      (cocharacterRadicalPoints (baseChangedAlgebraicGroup (D.Completion w) G))) :
        Set (LocalPoints D i w)) ∧
    Dense (Subgroup.closure {x : LocalPoints D i w | Contracted x} :
        Set (LocalPoints D i w)) := by
  let F := D.Completion w
  let G' := baseChangedAlgebraicGroup F G
  obtain ⟨j, hj⟩ := LocalCocharacterEvaluation.completionPointTopology G i (F := F)
  let e : PointsIn j F ≃* LocalPoints D i w :=
    baseChangePointGroupEquiv F G.val (CommAlgCat.of F F)
  have he : Continuous (e : PointsIn j F → LocalPoints D i w) := hj.continuous
  let S := localPointSet D i w (cocharacterRadicalPoints G')
  have hmap : ∀ x : PointsIn j F, x ∈ cocharacterRadicalPoints G' → e x ∈ S :=
    fun x hx => ⟨x, hx, rfl⟩
  have hS : ∀ x ∈ S, Contracted x := by
    rintro x ⟨p, ⟨c, L, hp⟩, hx⟩
    have hp' : e p = x := Over.OverMorphism.ext hx.symm
    have hS0 := LocalCocharacterEvaluation.contractingScalarExists (E := ℝ)
    obtain ⟨t, ht⟩ := hS0
    have h := LocalCocharacterEvaluation.contractingEvaluation G' j c L hℝ t ht p hp
    rw [← hp']
    refine ⟨e (cocharacterPoint c (CommAlgCat.of F F)
      (Units.map (algebraMap ℝ F).toMonoidHom t)), ?_⟩
    let a : PointsIn j F :=
      cocharacterPoint c (CommAlgCat.of F F) (Units.map (algebraMap ℝ F).toMonoidHom t)
    let p' : PointsIn j F := p
    have htend : Tendsto (fun n : ℕ => e (a ^ n * p' * (a ^ n)⁻¹)) atTop (𝓝 (e 1)) :=
      (he.tendsto (1 : PointsIn j F)).comp h
    have hfix (n : ℕ) : e (a ^ n * p' * (a ^ n)⁻¹) =
        e a ^ n * e p * (e a ^ n)⁻¹ := by
      rw [e.map_mul, e.map_mul, e.map_inv, map_pow e]
    simpa only [hfix, e.map_one] using htend
  have hgen : localPlus D i w ⊆ (Subgroup.closure S : Set (LocalPoints D i w)) := by
    rintro _ ⟨p, hp, rfl⟩
    have hsub : unipotentGenerated G' ≤
        ((Subgroup.closure S).comap e.toMonoidHom).comap
          (testPointSections G'.val).symm.toMonoidHom := by
      apply unipotentGenerated_le_of_contracting
      intro c L x hx
      obtain ⟨y, rfl⟩ := hx
      apply Subgroup.subset_closure
      apply hmap
      refine ⟨c, L, (testPointSections L.contracting.group).symm y, ?_⟩
      change ((rationalSourceIso F).inv ≫ y) ≫ L.contracting.inclusion.hom.hom =
        (rationalSourceIso F).inv ≫ (y ≫ L.contracting.inclusion.hom.hom)
      exact Category.assoc _ _ _
    have hp' := hsub hp
    change e ((rationalSourceIso F).inv ≫ p) ∈ Subgroup.closure S at hp'
    rwa [toUnit_unique (rationalSourceIso F).inv _] at hp'
  exact ⟨hd.mono hgen, hd.mono (hgen.trans (Subgroup.closure_mono hS))⟩

