private theorem archimedean_division_degree_le_two
    {F B : Type u} [Field F] [DivisionRing B] [Algebra F B]
    [Algebra ℝ F] [FiniteDimensional ℝ F] [FiniteDimensional F B] :
    degree F B ≤ 2 := by
  letI : Algebra ℝ B := Algebra.compHom B (algebraMap ℝ F)
  letI : IsScalarTower ℝ F B := IsScalarTower.of_algebraMap_eq' rfl
  letI : FiniteDimensional ℝ B := Module.Finite.trans F B
  obtain ⟨n, hn, _⟩ := D07.Ch23.Frobenius.finiteDimensionalClassification B
  have hB : Module.finrank ℝ B ≤ 4 := by
    rw [D07.Ch23.Frobenius.model_finrank B hn]
    rcases hn with ⟨rfl, _⟩ | ⟨rfl, _⟩ | ⟨rfl, _⟩ <;> decide
  have hFB : Module.finrank F B ≤ 4 := by
    have h := Module.finrank_mul_finrank ℝ F B
    have hp : 1 ≤ Module.finrank ℝ F := Module.finrank_pos
    exact (Nat.le_mul_of_pos_left _ hp).trans (h.le.trans hB)
  exact Nat.lt_succ_iff.mp (Nat.sqrt_lt'.mpr (hFB.trans_lt (by decide)))

set_option maxHeartbeats 650000 in
/-- Degree at least three leaves two different matrix coordinates over the division
factor. Conjugation by the diagonal cocharacter acts nontrivially on a transvection. -/
private theorem normOne_has_noncentral_cocharacter
    {F A : Type u} [Field F] [CharZero F] [Algebra ℝ F] [FiniteDimensional ℝ F]
    [Ring A] [Algebra F A] {I : Type u} [Fintype I] {G : AffineAlgebraicGroup F}
    (hA : isCentralSimple F A) (b : Module.Basis I F A)
    (hdegree : 3 ≤ degree F A) (rep : RepresentsNormOne hA b G) :
    ∃ c : Cocharacter G.val, IsNoncentral c := by
  classical
  obtain ⟨m, B, _, _, hB, hm, ⟨e⟩⟩ := _root_.RM03.CSA.MatrixDivision.exists_presentation F A hA
  letI := hB.2
  have hdeg : degree F A = m * degree F B := degree_matrix_division hA hB hm e
  have hb : degree F B ≤ 2 := archimedean_division_degree_le_two
  have hm' : 2 ≤ m := by
    by_contra h
    have : m = 1 := by omega
    simp [this] at hdeg
    omega
  let i : Fin m := ⟨0, by omega⟩
  let j : Fin m := ⟨1, by omega⟩
  have hij : i ≠ j := by intro h; have := congrArg Fin.val h; contradiction
  obtain ⟨point, mul, natural⟩ := rep
  let model := normOnePointsIso hA b point mul natural
  obtain ⟨c, hc⟩ := exists_diagonal_cocharacter hA b model e i j hij
  let R := CommAlgCat.of F F
  let q := e.symm (Matrix.single i j (1 : B))
  have hq : q * q = 0 := offDiagonalEntry_sq_zero e i j hij 1
  let y : (normOneFunctor hA b).obj R :=
    ⟨1 + (1 : F) ⊗ₜ[F] q, normAt_one_add_square_zero hA b hq R 1⟩
  let x : GroupPoints G.val R := model.inv.app R y
  have hx : model.hom.app R x = y := GrpCat.hom_inv_apply (model.app R) y
  refine ⟨c, (testSpec F).obj (op R), x, fun hh => ?_⟩
  let t : Fˣ := Units.mk0 2 (by norm_num)
  let a : GroupPoints G.val R := cocharacterPoint c R t
  have hh' := (centralizes_iff c x).mp hh _ (𝟙 _) (unitPoint R t)
  have hcomm : x * a = a * x := by
    let U := (testSpec F).obj (op R)
    let x' : U ⟶ G.val.X := x
    let a' : U ⟶ G.val.X := a
    have h' : (𝟙 U ≫ x') * a' = a' * (𝟙 U ≫ x') := hh'.eq
    rw [Category.id_comp] at h'
    exact h'
  have hconj : a * x * a⁻¹ = x := by rw [← hcomm, mul_inv_cancel_right]
  have h := congrArg (fun g => (model.hom.app R g).val) hconj
  have hmul (g z : GroupPoints G.val R) :
      (model.hom.app R (g * z)).val = (model.hom.app R g).val * (model.hom.app R z).val :=
    congrArg Subtype.val (map_mul (model.hom.app R).hom g z)
  change (model.hom.app R
    (a * x * (cocharacterPoint c R t)⁻¹)).val = (model.hom.app R x).val at h
  rw [← cocharacterPoint_inv c R t, hmul, hmul, hx, show a = cocharacterPoint c R t from rfl,
    hc, hc] at h
  change _ * (1 + (1 : F) ⊗ₜ[F] q) * _ = 1 + (1 : F) ⊗ₜ[F] q at h
  rw [diagonalTensor_conj R e i j hij t 1] at h
  have heq := congrArg (fun z : F ⊗[F] A => e (Algebra.TensorProduct.lid F A z) i j) h
  simp [q, t, Algebra.TensorProduct.lid_tmul, hij, Matrix.one_apply_ne] at heq
  rw [Algebra.smul_def, mul_one, ← map_one (algebraMap F B)] at heq
  have hab := (algebraMap F B).injective heq
  norm_num at hab

private theorem dense_localPlus_of_hermitian {K : Type u} [Field K]
    {G : AffineAlgebraicGroup K} (D : GlobalFieldData.{u,v} K)
    (i : MatrixRealization G) (w : D.Place)
    (ht : unipotentGenerated (baseChangedAlgebraicGroup (D.Completion w) G) = ⊤) :
    Dense (localPlus D i w) := by
  have h : localPlus D i w = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨p, hp⟩ := (completionPointEquiv D i w).surjective x
    exact ⟨p, ht ▸ Subgroup.mem_top p, (completionPointEquiv_apply D i w p).symm.trans hp⟩
  rw [h]
  exact dense_univ

section SpecialUnitary

open scoped Matrix
open private unitary_eigenbasis_matrix unitaryDiagonal
