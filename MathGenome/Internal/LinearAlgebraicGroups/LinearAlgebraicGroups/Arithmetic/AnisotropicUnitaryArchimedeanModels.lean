private abbrev StandardSU (n : ℕ) :=
  {M : Matrix (Fin n) (Fin n) ℂ // Mᴴ * M = 1 ∧ M.det = 1}

private theorem standardSU_compact (n : ℕ) : CompactSpace (StandardSU n) := by
  classical
  let S : Set (Matrix (Fin n) (Fin n) ℂ) := {M | Mᴴ * M = 1 ∧ M.det = 1}
  have hclosed : IsClosed S :=
    (isClosed_eq (continuous_id.matrix_conjTranspose.mul continuous_id) continuous_const).inter
      (isClosed_eq (Continuous.matrix_det continuous_id) continuous_const)
  let B : Set (Matrix (Fin n) (Fin n) ℂ) :=
    Set.univ.pi fun _ : Fin n => Set.univ.pi fun _ : Fin n => Metric.closedBall 0 1
  have hB : IsCompact B :=
    isCompact_univ_pi fun _ => isCompact_univ_pi fun _ => isCompact_closedBall _ _
  have hsubset : S ⊆ B := by
    intro M hM i _ j _
    have hsum : ∑ k, ‖M k j‖ ^ 2 = 1 := by
      have he := congrArg (fun X : Matrix (Fin n) (Fin n) ℂ => (X j j).re) hM.1
      change (∑ k, star (M k j) * M k j).re = ((1 : Matrix (Fin n) (Fin n) ℂ) j j).re at he
      rw [show (∑ k, star (M k j) * M k j) = ∑ k, (↑(‖M k j‖ ^ 2) : ℂ) from
        Finset.sum_congr rfl (fun k _ => by rw [mul_comm, Complex.star_def, Complex.mul_conj', Complex.ofReal_pow])]
        at he
      change Complex.reAddGroupHom (∑ k, (↑(‖M k j‖ ^ 2) : ℂ)) = _ at he
      rw [map_sum] at he
      simpa only [Complex.reAddGroupHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk,
        Complex.ofReal_re, Matrix.one_apply_eq, Complex.one_re] using he
    have hle : ‖M i j‖ ^ 2 ≤ 1 := by
      rw [← hsum]
      exact Finset.single_le_sum (f := fun k => ‖M k j‖ ^ 2) (fun k _ => sq_nonneg _) (Finset.mem_univ i)
    simp only [Metric.mem_closedBall, dist_zero_right]
    nlinarith [norm_nonneg (M i j)]
  exact isCompact_iff_compactSpace.mp (hB.of_isClosed_subset hclosed hsubset)

private theorem unitary_of_circle (z : Circle) : (z : ℂ) ∈ unitary ℂ := by
  apply Unitary.mem_iff.mpr
  have h : (z : ℂ) * star (z : ℂ) = 1 := by rw [Complex.star_def, Complex.mul_conj', Circle.norm_coe]; norm_num
  exact ⟨by simpa only [mul_comm] using h, h⟩

private theorem norm_of_unitary_scalar (z : unitary ℂ) : ‖z.val‖ = 1 := by
  have h := (Unitary.mem_iff.mp z.property).2
  rw [Complex.star_def, Complex.mul_conj'] at h
  have hr : ‖z.val‖ ^ 2 = 1 := by exact_mod_cast h
  nlinarith [norm_nonneg z.val]

private theorem standardSU_connected (n : ℕ) : ConnectedSpace (StandardSU n) := by
  classical
  cases n with
  | zero =>
    let u : StandardSU 0 := ⟨1, by simp⟩
    letI : PathConnectedSpace (StandardSU 0) := ⟨⟨u⟩, fun x y => by
      rw [Subsingleton.elim y x]⟩
    infer_instance
  | succ n =>
    let I := Fin (n + 1)
    let unit : StandardSU (n + 1) := ⟨1, by simp⟩
    have hjoin (g : StandardSU (n + 1)) : Joined unit g := by
      let u : Matrix.unitaryGroup I ℂ := ⟨g.val, Matrix.mem_unitaryGroup_iff'.mpr g.property.1⟩
      obtain ⟨Q, ζ, hζ, hQ⟩ := unitary_eigenbasis_matrix u g.property.2
      let z (i : I) : Circle := ⟨(ζ i).val, Metric.mem_sphere.2 (by
        rw [dist_zero_right, norm_of_unitary_scalar])⟩
      let scaled (w : I → Circle) (i : I) : Circle :=
        w i * (if i = 0 then (∏ j, w j)⁻¹ else 1)
      have hscaled (w : I → Circle) : ∏ i, scaled w i = 1 := by
        rw [show (∏ i, scaled w i) = (∏ i, w i) *
          ∏ i : I, (if i = 0 then (∏ j, w j)⁻¹ else 1) from Finset.prod_mul_distrib]
        rw [Fintype.prod_ite_eq', mul_inv_cancel]
      let diag (w : I → Circle) : Matrix.unitaryGroup I ℂ :=
        unitaryDiagonal fun i => ⟨scaled w i, unitary_of_circle (scaled w i)⟩
      have hdiag (w : I → Circle) : (diag w).val.det = 1 := by
        change (Matrix.diagonal (fun i => ((scaled w i : Circle) : ℂ))).det = 1
        rw [Matrix.det_diagonal]
        change (∏ i, Circle.coeHom (scaled w i)) = Circle.coeHom 1
        rw [← map_prod, hscaled]
      let f (w : I → Circle) : StandardSU (n + 1) :=
        ⟨(Q * diag w * Q⁻¹).val,
          Matrix.mem_unitaryGroup_iff'.mp (Q * diag w * Q⁻¹).property,
          (Matrix.det_units_conj (Unitary.toUnits Q) (diag w).val).trans (hdiag w)⟩
      have hf : Continuous f := by
        apply Continuous.subtype_mk
        change Continuous (fun w : I → Circle => Q.val *
          Matrix.diagonal (fun i => ((scaled w i : Circle) : ℂ)) * (Q⁻¹).val)
        have hd : Continuous (fun w : I → Circle =>
            Matrix.diagonal (fun i => ((scaled w i : Circle) : ℂ))) := by
          refine continuous_matrix fun i j => ?_
          simp only [Matrix.diagonal_apply]
          split_ifs
          · apply continuous_subtype_val.comp
            unfold scaled
            split_ifs
            · exact (continuous_apply i).mul (Continuous.inv (continuous_finsetProd _ fun j _ => continuous_apply j))
            · exact (continuous_apply i).mul continuous_const
          · exact continuous_const
        exact (continuous_const.mul hd).mul continuous_const
      have hf1 : f (fun _ => 1) = unit := by
        apply Subtype.ext
        change Q.val * Matrix.diagonal _ * (Q⁻¹).val = 1
        have hd : Matrix.diagonal (fun i : I => ((scaled (fun _ => 1) i : Circle) : ℂ)) = 1 := by
          ext i j
          by_cases hij : i = j <;> simp [scaled, Matrix.one_apply, hij]
        rw [hd, mul_one]
        exact (Unitary.mem_iff.mp Q.property).2
      have hprod : ∏ i, z i = 1 := by
        apply Subtype.ext
        change Circle.coeHom (∏ i, z i) = 1
        rw [map_prod]
        change (∏ i, (ζ i).val) = 1
        simpa using congrArg Subtype.val hζ
      have hfz : f z = g := by
        apply Subtype.ext
        have hd : diag z = unitaryDiagonal ζ := by
          apply Subtype.ext
          change Matrix.diagonal (fun i => ((scaled z i : Circle) : ℂ)) =
            Matrix.diagonal (fun i => (ζ i).val)
          congr 1
          funext i
          rw [show scaled z i = z i by
            simp only [scaled, hprod, inv_one, ite_self, mul_one]]
        change (Q * diag z * Q⁻¹).val = u.val
        rw [hd, ← hQ]
      rw [← hf1, ← hfz]
      exact (PathConnectedSpace.joined (fun _ : I => (1 : Circle)) z).map hf
    letI : PathConnectedSpace (StandardSU (n + 1)) :=
      ⟨⟨unit⟩, fun x y => (hjoin x).symm.trans (hjoin y)⟩
    infer_instance

end SpecialUnitary

section HermitianTopology

open Specs.Arithmetic.OuterTypeALocalModels (conjugationAt PreservesHermitianMatrix)
open AdelicGroups (asMatrix)
open private asMatrix_natural
  from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.IsotropicNormOneRadicalsDensity
open private glVal_isEmbedding from MathGenome.Internal.LinearAlgebraicGroups.LinearAlgebraicGroups.Arithmetic.AdelicGroups

set_option maxHeartbeats 900000 in
/-- Prove continuity of the inverse model comparison by evaluating a single Hermitian
point over the algebra of continuous scalar functions. -/
private theorem continuous_hermitian_inverse
    {F Q : Type u} {X : Type} [Field F] [Field Q] [Algebra F Q]
    [TopologicalSpace F] [IsTopologicalDivisionRing F] [TopologicalSpace X]
    {n : ℕ} {G : AffineAlgebraicGroup F} (i : MatrixRealization G)
    {σ : Q ≃ₐ[F] Q} {H : Matrix (Fin n) (Fin n) Q}
    (point : ∀ R : TestAlgebra F, GroupPoints G.val R ≃
      {g : Matrix.SpecialLinearGroup (Fin n) (R ⊗[F] Q) // PreservesHermitianMatrix σ H R g})
    (natural : ∀ {R S : TestAlgebra F} (f : R ⟶ S) x,
      (point S (mapPoints f x)).val = Matrix.SpecialLinearGroup.map
        (Algebra.TensorProduct.map f.hom (.id F Q)).toRingHom (point R x).val)
    {J : Type v} [Fintype J] (b : Module.Basis J F Q)
    (p : X → PointsIn i F)
    (hp : ∀ j k l, Continuous (fun x =>
      b.repr ((Algebra.TensorProduct.lid F Q) ((point (CommAlgCat.of F F) (p x)).val.val j k)) l)) :
    Continuous p := by
  classical
  let R := CommAlgCat.of F C(X, F)
  let S := CommAlgCat.of F F
  let f (x : X) : R ⟶ S := CommAlgCat.ofHom (ContinuousMap.evalAlgHom F F x)
  let ev (x : X) := Algebra.TensorProduct.map (f x).hom (AlgHom.id F Q)
  let e := Algebra.TensorProduct.lid F Q
  have ev_tmul (x : X) (a : C(X,F)) (q : Q) :
      e (ev x (a ⊗ₜ[F] q)) = a x • q := by
    rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.lid_tmul]
    rfl
  have coord_ev (x : X) (z : R ⊗[F] Q) (l : J) :
      b.repr (e (ev x z)) l =
        TensorProduct.equivFinsuppOfBasisRight b z l x := by
    induction z using TensorProduct.inductionOn with
    | tmul r q =>
      rw [ev_tmul, TensorProduct.equivFinsuppOfBasisRight_apply_tmul_apply, map_smul, Finsupp.smul_apply]
      change r x * (b.repr q) l = (b.repr q) l * r x
      exact mul_comm _ _
    | add a z ha hz =>
      simp only [map_add, Finsupp.add_apply, ha, hz]
      rfl
  have ev_sep {a z : R ⊗[F] Q} (h : ∀ x, ev x a = ev x z) : a = z := by
    apply (TensorProduct.equivFinsuppOfBasisRight b).injective
    ext l x
    rw [← coord_ev x a l, ← coord_ev x z l, h x]
  let N (x : X) := (point S (p x)).val.val
  let M : Matrix (Fin n) (Fin n) (R ⊗[F] Q) :=
    Matrix.of fun j k => ∑ l : J, (⟨fun x => b.repr (e (N x j k)) l, hp j k l⟩ : C(X,F))
      ⊗ₜ[F] b l
  have hM (x : X) : M.map (ev x) = N x := by
    apply Matrix.ext
    intro j k
    apply e.injective
    change e (ev x (∑ l : J, _ ⊗ₜ[F] b l)) = e (N x j k)
    simp only [map_sum, ev_tmul]
    exact b.sum_repr _
  have hdet : M.det = 1 := by
    apply ev_sep
    intro x
    calc
      ev x M.det = (M.map (ev x)).det := (RingHom.map_det (ev x).toRingHom M)
      _ = ev x 1 := by rw [hM, map_one]; exact (point S (p x)).val.property
  let gM : Matrix.SpecialLinearGroup (Fin n) (R ⊗[F] Q) := ⟨M, hdet⟩
  have hc (x : X) (z : R ⊗[F] Q) :
      ev x (conjugationAt σ R z) = conjugationAt σ S (ev x z) := by
    induction z using TensorProduct.inductionOn with
    | tmul r q => rfl
    | add a z ha hz => simp only [map_add, ha, hz]
  have hH (x : X) (q : Q) :
      ev x (Algebra.TensorProduct.includeRight (R := F) (A := R) q) =
        Algebra.TensorProduct.includeRight (R := F) (A := S) q := by
    change ev x (1 ⊗ₜ[F] q) = 1 ⊗ₜ[F] q
    rw [Algebra.TensorProduct.map_tmul, map_one]
    rfl
  have hpres : PreservesHermitianMatrix σ H R gM := by
    unfold PreservesHermitianMatrix
    let HR := H.map (Algebra.TensorProduct.includeRight (R := F) (A := R))
    let HS := H.map (Algebra.TensorProduct.includeRight (R := F) (A := S))
    change (M.map (conjugationAt σ R)).transpose * HR * M = HR
    have hcheck (x : X) : (((M.map (conjugationAt σ R)).transpose * HR * M).map (ev x)) =
        HR.map (ev x) := by
      have h₁ : ((M.map (conjugationAt σ R)).transpose).map (ev x) =
          ((N x).map (conjugationAt σ S)).transpose := by
        rw [← hM]
        exact Matrix.ext fun j k => hc x (M k j)
      have h₂ : HR.map (ev x) = HS := Matrix.ext fun j k => hH x (H j k)
      rw [Matrix.map_mul, Matrix.map_mul, h₁, h₂, hM]
      exact (point S (p x)).property
    exact Matrix.ext fun j k => ev_sep (fun x => congrArg (fun A => A j k) (hcheck x))
  let g : Points G.val.X R := (point R).symm ⟨gM, hpres⟩
  have hg (x : X) : mapPoints (f x) g = p x := by
    apply (point S).injective
    apply Subtype.ext
    refine (natural (f x) g).trans ?_
    change Matrix.SpecialLinearGroup.map (ev x).toRingHom (point R g).val = _
    simp only [g, Equiv.apply_symm_apply]
    apply Subtype.ext
    exact hM x
  apply (IsInducing.induced (asMatrix i F)).continuous_iff.mpr
  have hval : IsEmbedding
      (Units.val : Matrix.GeneralLinearGroup (Specs.Unipotent.Index.{u} i.size) F → _) :=
    glVal_isEmbedding
  apply hval.isInducing.continuous_iff.mpr
  refine continuous_matrix fun j k => ?_
  have he (x : X) : (asMatrix i F (p x)).val j k = ((asMatrix i R g).val j k) x := by
    rw [← hg x]
    exact congrArg (fun a : Matrix.GeneralLinearGroup _ F => a.val j k)
      (asMatrix_natural i (f x) g)
  change Continuous (fun x => (asMatrix i F (p x)).val j k)
  simp_rw [he]
  exact ((asMatrix i R g).val j k).continuous

end HermitianTopology

section HermitianOrthonormalization

open scoped Matrix

private theorem same_sign_of_anisotropic_diagonal {n : ℕ} (lam : Fin n → ℝ)
    (h : ∀ x : Fin n → ℂ, x ≠ 0 →
      (∑ i, star (x i) * (lam i : ℂ) * x i) ≠ 0) :
    ∃ r : ℝ, r ≠ 0 ∧ r * r = 1 ∧ ∀ i, 0 < r * lam i := by
  classical
  have hn (i : Fin n) : lam i ≠ 0 := by
    intro he
    let x : Fin n → ℂ := Pi.single i 1
    have hx : x ≠ 0 := by
      intro hz
      have := congrFun hz i
      simp [x] at this
    apply h x hx
    have ht (j : Fin n) : star (x j) * (lam j : ℂ) * x j = 0 := by
      by_cases hj : j = i
      · subst j
        simp [x, he]
      · simp [x, Pi.single_eq_of_ne hj]
    simp only [ht, Finset.sum_const_zero]
  have hm (i j : Fin n) (hi : 0 < lam i) (hj : lam j < 0) : False := by
    have hij : i ≠ j := by rintro rfl; exact (not_lt_of_gt hi) hj
    let a := Real.sqrt (-lam j)
    let b := Real.sqrt (lam i)
    have ha : 0 < a := Real.sqrt_pos.2 (neg_pos.2 hj)
    let x : Fin n → ℂ := Pi.single i (a : ℂ) + Pi.single j (b : ℂ)
    have hxi : x i = a := by simp [x, Pi.single_eq_of_ne hij]
    have hxj : x j = b := by simp [x, Pi.single_eq_of_ne hij.symm]
    have hx : x ≠ 0 := by
      intro hz
      have he := congrFun hz i
      rw [hxi] at he
      exact (ne_of_gt ha) (Complex.ofReal_eq_zero.mp he)
    apply h x hx
    have ht (k : Fin n) (hk : k ≠ i) (hl : k ≠ j) :
        star (x k) * (lam k : ℂ) * x k = 0 := by
      simp [x, Pi.single_eq_of_ne hk, Pi.single_eq_of_ne hl]
    rw [← Finset.sum_subset (Finset.subset_univ ({i,j} : Finset (Fin n))) (fun k _ hk => by
      simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hk
      exact ht k hk.1 hk.2)]
    rw [Finset.sum_pair hij, hxi, hxj]
    have ha2 : a * a = -lam j := Real.mul_self_sqrt (by linarith)
    have hb2 : b * b = lam i := Real.mul_self_sqrt hi.le
    have he : a * lam i * a + b * lam j * b = 0 := by
      linear_combination lam i * ha2 + lam j * hb2
    simp only [Complex.star_def, Complex.conj_ofReal]
    exact_mod_cast he
  by_cases hp : ∀ i, 0 < lam i
  · exact ⟨1, by norm_num, by norm_num, by simpa using hp⟩
  · push_neg at hp
    obtain ⟨j, hj⟩ := hp
    have hj' : lam j < 0 := lt_of_le_of_ne hj (hn j)
    refine ⟨-1, by norm_num, by norm_num, fun i => ?_⟩
    have hi : lam i < 0 := lt_of_le_of_ne (le_of_not_gt (fun hi => hm i j hi hj')) (hn i)
    simpa using neg_pos.mpr hi

/-- An anisotropic complex Hermitian matrix is a nonzero scalar times a Gram matrix. -/
private theorem anisotropic_hermitian_gram {n : ℕ} (H : Matrix (Fin n) (Fin n) ℂ)
    (hH : H.IsHermitian)
    (ha : ∀ x : Fin n → ℂ, x ≠ 0 → dotProduct (star x) (H.mulVec x) ≠ 0) :
    ∃ (r : ℂ) (B : (Matrix (Fin n) (Fin n) ℂ)ˣ),
      r ≠ 0 ∧ H = r • (B.valᴴ * B.val) := by
  classical
  let V : Matrix.unitaryGroup (Fin n) ℂ := hH.eigenvectorUnitary
  let lam := hH.eigenvalues
  let D := Matrix.diagonal fun i => (lam i : ℂ)
  have hv₁ : V.valᴴ * V.val = 1 := (Unitary.mem_iff.mp V.property).1
  have hH' : H = V.val * D * V.valᴴ := hH.spectral_theorem
  have hdiag : V.valᴴ * H * V.val = D := by
    rw [hH']
    calc
      V.valᴴ * (V.val * D * V.valᴴ) * V.val = (V.valᴴ * V.val) * D * (V.valᴴ * V.val) := by
        noncomm_ring
      _ = D := by rw [hv₁, one_mul, mul_one]
  have han (x : Fin n → ℂ) (hx : x ≠ 0) :
      (∑ i, star (x i) * (lam i : ℂ) * x i) ≠ 0 := by
    have hx' : V.val.mulVec x ≠ 0 := by
      intro he
      apply hx
      calc
        x = (V.valᴴ * V.val).mulVec x := by rw [hv₁, Matrix.one_mulVec]
        _ = 0 := by rw [← Matrix.mulVec_mulVec, he, Matrix.mulVec_zero]
    have he : dotProduct (star (V.val.mulVec x)) (H.mulVec (V.val.mulVec x)) =
        dotProduct (star x) (D.mulVec x) := by
      calc
        _ = (star x ᵥ* V.valᴴ) ⬝ᵥ ((H * V.val) *ᵥ x) := by
          rw [Matrix.star_mulVec, ← Matrix.mulVec_mulVec]
        _ = star x ⬝ᵥ ((V.valᴴ * (H * V.val)) *ᵥ x) := by
          simp only [Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul]
        _ = _ := by rw [← mul_assoc, hdiag]
    have hx'' := ha (V.val.mulVec x) hx'
    rw [he] at hx''
    simpa only [D, dotProduct, Matrix.mulVec_diagonal, Pi.star_apply, ← mul_assoc] using hx''
  obtain ⟨r, hr, hrr, hpos⟩ := same_sign_of_anisotropic_diagonal lam han
  let d (i : Fin n) : ℂ := Real.sqrt (r * lam i)
  let U := Matrix.diagonal d
  have hd (i : Fin n) : d i ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr (hpos i)))
  have hU : IsUnit U :=
    (Matrix.isUnit_iff_isUnit_det U).2 (isUnit_iff_ne_zero.mpr (by
      rw [Matrix.det_diagonal]
      exact Finset.prod_ne_zero_iff.mpr (fun i _ => hd i)))
  let W := hU.unit
  let V' := Unitary.toUnits V
  let B := W * V'⁻¹
  have hB : B.val = U * V.valᴴ := rfl
  have hUstar : Uᴴ = U := by
    ext i j
    by_cases hij : i = j <;> simp [U, d, hij, eq_comm]
  have hUD : (r : ℂ) • (U * U) = D := by
    rw [show U * U = Matrix.diagonal (fun i => d i * d i) from Matrix.diagonal_mul_diagonal _ _]
    ext i j
    by_cases hij : i = j
    · subst j
      simp only [Matrix.smul_apply, Matrix.diagonal_apply_eq, smul_eq_mul, D, d]
      have hs := Real.mul_self_sqrt (hpos i).le
      have he : r * (Real.sqrt (r * lam i) * Real.sqrt (r * lam i)) = lam i := by
        rw [hs, ← mul_assoc, hrr, one_mul]
      exact_mod_cast he
    · simp [hij, D]
  refine ⟨r, B, Complex.ofReal_ne_zero.mpr hr, ?_⟩
  rw [hB, Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose, hUstar,
    hH', ← hUD, mul_smul_comm, smul_mul_assoc]
  congr 1
  noncomm_ring

end HermitianOrthonormalization

section RealQuadraticModel

open scoped Matrix
open NumberField.InfinitePlace.Completion

private theorem real_completion_of_quadratic_extension
    {K Q : Type u} [Field K] [Field Q] (w : NumberField.InfinitePlace K)
    [Algebra w.Completion Q] [Algebra.IsQuadraticExtension w.Completion Q] :
    w.IsReal := by
  rcases w.isReal_or_isComplex with hr | hc
  · exact hr
  · let e := ringEquivComplexOfIsComplex hc
    letI : Algebra ℂ Q := Algebra.compHom Q e.symm.toRingHom
    have hdim : Module.finrank ℂ Q = 2 := by
      have h := Algebra.finrank_eq_of_equiv_equiv e (RingEquiv.refl Q)
        (by
          ext x
          change algebraMap w.Completion Q (e.symm (e x)) = algebraMap w.Completion Q x
          rw [RingEquiv.symm_apply_apply])
      exact h.symm.trans (Algebra.IsQuadraticExtension.finrank_eq_two w.Completion Q)
    letI : FiniteDimensional ℂ Q := Module.finite_of_finrank_pos (by rw [hdim]; decide)
    let e' := AlgEquiv.ofBijective (Algebra.ofId ℂ Q)
      (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := ℂ) (K := Q))
    have h := e'.toLinearEquiv.finrank_eq
    rw [Module.finrank_self, hdim] at h
    contradiction

private theorem quadratic_over_real_model {F Q : Type u} [Field F] [Field Q]
    [Algebra F Q] [Algebra.IsQuadraticExtension F Q]
    (eF : F ≃+* ℝ) (σ : Q ≃ₐ[F] Q) (hσ : σ ≠ 1) :
    ∃ eQ : ℂ ≃+* Q, (∀ r : ℝ, eQ (r : ℂ) = algebraMap F Q (eF.symm r)) ∧
      ∀ z : ℂ, eQ (star z) = σ (eQ z) := by
  letI : Algebra ℝ F := eF.symm.toRingHom.toAlgebra
  letI : Algebra ℝ Q := Algebra.compHom Q (algebraMap ℝ F)
  letI : IsScalarTower ℝ F Q := IsScalarTower.of_algebraMap_eq' rfl
  let e := AlgEquiv.ofBijective (Algebra.ofId ℝ F)
    (show Function.Bijective (algebraMap ℝ F) from eF.symm.bijective)
  letI : FiniteDimensional ℝ F := Module.Finite.of_surjective e.toLinearMap e.surjective
  letI : FiniteDimensional ℝ Q := Module.Finite.trans F Q
  have hf : Module.finrank ℝ F = 1 := e.toLinearEquiv.finrank_eq.symm.trans (Module.finrank_self ℝ)
  have hq : Module.finrank ℝ Q = 2 := by
    rw [← Module.finrank_mul_finrank ℝ F Q, hf, one_mul,
      Algebra.IsQuadraticExtension.finrank_eq_two]
  obtain ⟨d, hd, _⟩ := D07.Ch23.Frobenius.finiteDimensionalClassification Q
  have he := D07.Ch23.Frobenius.model_finrank Q hd
  have hd2 : d = 2 := he.symm.trans hq
  subst d
  rcases hd with ⟨h, _⟩ | ⟨_, ⟨eC⟩⟩ | ⟨h, _⟩
  · omega
  · let τ := (eC.trans (σ.restrictScalars ℝ)).trans eC.symm
    have hτ : τ.toAlgHom ≠ AlgHom.id ℝ ℂ := by
      intro h
      apply hσ
      apply AlgEquiv.ext
      intro z
      obtain ⟨x, rfl⟩ := eC.surjective z
      apply eC.symm.injective
      have hh := DFunLike.congr_fun h x
      change eC.symm (σ (eC x)) = x at hh
      simpa only [AlgEquiv.one_apply, AlgEquiv.symm_apply_apply] using hh
    have ht : τ.toAlgHom = Complex.conjAe :=
      (Complex.real_algHom_eq_id_or_conj τ.toAlgHom).resolve_left hτ
    refine ⟨eC.toRingEquiv, fun r => eC.commutes r, fun z => ?_⟩
    have h := DFunLike.congr_fun ht z
    change eC.symm (σ (eC z)) = star z at h
    exact (eC.symm_apply_eq.mp h).symm
  · omega

private theorem unitary_conj_iff {n : ℕ} (B : (Matrix (Fin n) (Fin n) ℂ)ˣ)
    {r : ℂ} (hr : r ≠ 0) {H : Matrix (Fin n) (Fin n) ℂ}
    (hH : H = r • (B.valᴴ * B.val)) (X : Matrix (Fin n) (Fin n) ℂ) :
    (B.val * X * (B⁻¹).val)ᴴ * (B.val * X * (B⁻¹).val) = 1 ↔ Xᴴ * H * X = H := by
  let C := B.val
  let D := (B⁻¹).val
  have hCD : C * D = 1 := B.val_inv
  have hDC : D * C = 1 := B.inv_val
  have hstar : Cᴴ * Dᴴ = 1 := by
    rw [← Matrix.conjTranspose_mul, hDC, Matrix.conjTranspose_one]
  have he : (C * X * D)ᴴ * (C * X * D) = Dᴴ * (Xᴴ * (Cᴴ * C) * X) * D := by
    simp only [Matrix.conjTranspose_mul, mul_assoc]
  have hD : Dᴴ * (Cᴴ * C) * D = 1 := by
    calc
      Dᴴ * (Cᴴ * C) * D = (C * D)ᴴ * (C * D) := by
        simp only [Matrix.conjTranspose_mul, mul_assoc]
      _ = 1 := by rw [hCD, Matrix.conjTranspose_one, mul_one]
  change (C * X * D)ᴴ * (C * X * D) = 1 ↔ Xᴴ * H * X = H
  rw [he, hH, mul_smul_comm, smul_mul_assoc, smul_right_inj hr, ← hD]
  constructor
  · intro h
    have h' := congrArg (fun Y => Cᴴ * Y * C) h
    change Cᴴ * (Dᴴ * (Xᴴ * (Cᴴ * C) * X) * D) * C =
      Cᴴ * (Dᴴ * (Cᴴ * C) * D) * C at h'
    have hcancel (Y : Matrix (Fin n) (Fin n) ℂ) : Cᴴ * (Dᴴ * Y * D) * C = Y := by
      calc
        _ = (Cᴴ * Dᴴ) * Y * (D * C) := by noncomm_ring
        _ = Y := by rw [hstar, hDC, one_mul, mul_one]
    exact (hcancel _).symm.trans (h'.trans (hcancel _))
  · exact fun h => congrArg (fun Y => Dᴴ * Y * D) h

private theorem complex_coordinate_continuity {F Q : Type u} [Field F] [Field Q]
    [Algebra F Q] [TopologicalSpace F] [IsTopologicalRing F]
    (eF : F ≃+* ℝ) (hc : Continuous eF.symm)
    (eQ : ℂ ≃+* Q) (heQ : ∀ r : ℝ, eQ (r : ℂ) = algebraMap F Q (eF.symm r))
    {J : Type v} (b : Module.Basis J F Q) (l : J) :
    Continuous (fun z : ℂ => b.repr (eQ z) l) := by
  have he (z : ℂ) : eQ z = eF.symm z.re • (1 : Q) + eF.symm z.im • eQ Complex.I := by
    conv_lhs => rw [← Complex.re_add_im z]
    rw [map_add, map_mul, heQ, heQ, Algebra.smul_def, Algebra.smul_def, mul_one]
  have hf (z : ℂ) : b.repr (eQ z) l =
      eF.symm z.re * b.repr 1 l + eF.symm z.im * b.repr (eQ Complex.I) l := by
    rw [he, map_add, Finsupp.add_apply, map_smul, map_smul, Finsupp.smul_apply,
      Finsupp.smul_apply, smul_eq_mul, smul_eq_mul]
  rw [show (fun z : ℂ => b.repr (eQ z) l) = _ from funext hf]
  exact ((hc.comp Complex.continuous_re).mul continuous_const).add
    ((hc.comp Complex.continuous_im).mul continuous_const)

end RealQuadraticModel

open scoped Matrix
open Specs.Arithmetic.OuterTypeALocalModels (conjugationAt PreservesHermitianMatrix)

private theorem ground_hermitian_matrix_iff
    {F Q : Type u} [Field F] [Field Q] [Algebra F Q]
    {σ : Q ≃ₐ[F] Q} {n : ℕ} {H : Matrix (Fin n) (Fin n) Q}
    (X : Matrix.SpecialLinearGroup (Fin n) ((CommAlgCat.of F F) ⊗[F] Q)) :
    PreservesHermitianMatrix σ H (CommAlgCat.of F F) X ↔
      let Y := X.val.map (Algebra.TensorProduct.lid F Q)
      (Y.map σ).transpose * H * Y = H := by
  let R := CommAlgCat.of F F
  let e := Algebra.TensorProduct.lid F Q
  let H' := H.map (Algebra.TensorProduct.includeRight (R := F) (A := R))
  have hH : H'.map e = H := by
    ext i j
    change e ((1 : F) ⊗ₜ[F] H i j) = H i j
    rw [Algebra.TensorProduct.lid_tmul, one_smul]
  have hc (z : F ⊗[F] Q) : e (conjugationAt σ R z) = σ (e z) := by
    induction z using TensorProduct.inductionOn with
    | tmul r q =>
      change Algebra.TensorProduct.lid F Q (r ⊗ₜ[F] σ q) =
        σ (Algebra.TensorProduct.lid F Q (r ⊗ₜ[F] q))
      simp only [Algebra.TensorProduct.lid_tmul]
      exact (map_smul σ.toLinearEquiv r q).symm
    | add a b ha hb => simp only [map_add, ha, hb]
  have hX : ((X.val.map (conjugationAt σ R)).transpose).map e =
      ((X.val.map e).map σ).transpose :=
    Matrix.ext fun i j => hc (X.val j i)
  change (X.val.map (conjugationAt σ R)).transpose * H' * X.val = H' ↔ _
  rw [← (Matrix.map_injective e.injective).eq_iff, Matrix.map_mul, Matrix.map_mul, hX, hH]

set_option maxHeartbeats 1200000 in
private theorem compact_connected_real_hermitian_points
    {F Q : Type u} [Field F] [Field Q] [Algebra F Q]
    [Algebra.IsQuadraticExtension F Q] [TopologicalSpace F] [IsTopologicalDivisionRing F]
    (eF : F ≃+* ℝ) (hc : Continuous eF.symm)
    {G : AffineAlgebraicGroup F} (i : MatrixRealization G)
    (σ : Q ≃ₐ[F] Q) (hσ : σ ≠ 1) {n : ℕ} (H : Matrix (Fin n) (Fin n) Q)
    (hH : (H.map σ).transpose = H)
    (hmodel : RepresentsHermitian σ H G)
    (ha : ¬ ∃ x : Fin n → Q, x ≠ 0 ∧ dotProduct (σ ∘ x) (H.mulVec x) = 0) :
    CompactSpace (PointsIn i F) ∧ ConnectedSpace (PointsIn i F) := by
  classical
  obtain ⟨eQ, hreal, hconj⟩ := quadratic_over_real_model eF σ hσ
  let Hc := H.map eQ.symm
  have hHc : Hc.map eQ = H := by ext i j; exact eQ.apply_symm_apply (H i j)
  have hmap (X : Matrix (Fin n) (Fin n) ℂ) :
      ((X.map eQ).map σ).transpose = Xᴴ.map eQ := by
    ext j k
    exact (hconj (X k j)).symm
  have hcH : Hc.IsHermitian := by
    apply Matrix.map_injective eQ.injective
    change Hcᴴ.map eQ = Hc.map eQ
    rw [← hmap, hHc, hH]
  have hac (z : Fin n → ℂ) (hnz : z ≠ 0) :
      dotProduct (star z) (Hc.mulVec z) ≠ 0 := by
    intro hz
    apply ha
    refine ⟨eQ ∘ z, fun h => hnz (funext fun k => eQ.injective (by
      simpa using congrFun h k)), ?_⟩
    have h := congrArg eQ hz
    change eQ.toRingHom (dotProduct (star z) (Hc.mulVec z)) = eQ.toRingHom 0 at h
    rw [map_zero, RingHom.map_dotProduct] at h
    have hm : eQ.toRingHom ∘ Hc.mulVec z = (Hc.map eQ).mulVec (eQ ∘ z) :=
      funext fun k => RingHom.map_mulVec eQ.toRingHom Hc z k
    rw [hm, hHc] at h
    have hs : eQ.toRingHom ∘ star z = σ ∘ eQ ∘ z := funext fun k => hconj (z k)
    rwa [hs] at h
  obtain ⟨r, B, hr, hB⟩ := anisotropic_hermitian_gram Hc hcH hac
  have hpres (X : Matrix (Fin n) (Fin n) ℂ) :
      (((X.map eQ).map σ).transpose * H * X.map eQ = H) ↔ Xᴴ * Hc * X = Hc := by
    rw [hmap, ← hHc, ← Matrix.map_mul, ← Matrix.map_mul]
    exact (Matrix.map_injective eQ.injective).eq_iff
  obtain ⟨point, _, hnat⟩ := hmodel
  let R := CommAlgCat.of F F
  let e := Algebra.TensorProduct.lid F Q
  let read (x : PointsIn i F) : Matrix.SpecialLinearGroup (Fin n) Q :=
    Matrix.SpecialLinearGroup.map e.toRingHom (point R x).val
  have hinj : Function.Injective read := by
    intro x y h
    apply (point R).injective
    apply Subtype.ext
    apply Subtype.ext
    exact Matrix.map_injective e.injective (congrArg Subtype.val h)
  have hreads (x : PointsIn i F) :
      ((read x).val.map σ).transpose * H * (read x).val = H :=
    (ground_hermitian_matrix_iff (point R x).val).mp (point R x).property
  have hpre (W : Matrix.SpecialLinearGroup (Fin n) Q)
      (hW : (W.val.map σ).transpose * H * W.val = H) :
      ∃ x : PointsIn i F, read x = W := by
    let W' := Matrix.SpecialLinearGroup.map e.symm.toRingHom W
    have he : W'.val.map e = W.val := Matrix.ext fun j k => e.apply_symm_apply (W.val j k)
    have h' : PreservesHermitianMatrix σ H R W' := by
      apply (ground_hermitian_matrix_iff W').mpr
      change ((W'.val.map e).map σ).transpose * H * W'.val.map e = H
      rwa [he]
    refine ⟨(point R).symm ⟨W', h'⟩, ?_⟩
    unfold read
    rw [Equiv.apply_symm_apply]
    exact Subtype.ext he
  let Y (g : StandardSU n) := (B⁻¹).val * g.val * B.val
  have hY (g : StandardSU n) : B.val * Y g * (B⁻¹).val = g.val := by
    calc
      _ = (B.val * (B⁻¹).val) * g.val * (B.val * (B⁻¹).val) := by
        unfold Y
        noncomm_ring
      _ = _ := by
        rw [show B.val * (B⁻¹).val = 1 from B.val_inv, one_mul, mul_one]
  let lift (g : StandardSU n) : Matrix.SpecialLinearGroup (Fin n) Q :=
    Matrix.SpecialLinearGroup.map eQ.toRingHom
      ⟨Y g, (Matrix.det_units_conj B⁻¹ g.val).trans g.property.2⟩
  have hlift (g : StandardSU n) :
      ((lift g).val.map σ).transpose * H * (lift g).val = H := by
    apply (hpres (Y g)).2
    apply (unitary_conj_iff B hr hB (Y g)).1
    rw [hY]
    exact g.property.1
  have hex (g : StandardSU n) : ∃ x : PointsIn i F, read x = lift g :=
    hpre (lift g) (hlift g)
  choose p hp using hex
  have hX (g : StandardSU n) (j k : Fin n) :
      Algebra.TensorProduct.lid F Q ((point (CommAlgCat.of F F) (p g)).val.val j k) =
        eQ (Y g j k) :=
    congrArg (fun a : Matrix.SpecialLinearGroup (Fin n) Q => a.val j k) (hp g)
  let b := Module.finBasis F Q
  have hcont : Continuous p := by
    apply continuous_hermitian_inverse i point hnat b p
    intro j k l
    simp_rw [hX]
    apply (complex_coordinate_continuity eF hc eQ hreal b l).comp
    have hYcont : Continuous Y :=
      (continuous_const.mul (continuous_subtype_val : Continuous (Subtype.val : StandardSU n → _))).mul
        continuous_const
    exact (continuous_apply k).comp ((continuous_apply j).comp hYcont)
  have hsurj : Function.Surjective p := by
    intro x
    let X := (read x).val.map eQ.symm
    have hX₁ : X.map eQ = (read x).val := by
      ext j k
      exact eQ.apply_symm_apply ((read x).val j k)
    have hX₂ : X.det = 1 := by
      apply eQ.injective
      rw [map_one]
      calc
        eQ X.det = (X.map eQ).det := RingHom.map_det eQ.toRingHom X
        _ = 1 := by rw [hX₁]; exact (read x).property
    have hX₃ : Xᴴ * Hc * X = Hc := by
      apply (hpres X).1
      rw [hX₁]
      exact hreads x
    let g : StandardSU n := ⟨B.val * X * (B⁻¹).val,
      (unitary_conj_iff B hr hB X).2 hX₃, (Matrix.det_units_conj B X).trans hX₂⟩
    refine ⟨g, hinj ?_⟩
    rw [hp]
    apply Subtype.ext
    change (Y g).map eQ = (read x).val
    have hy : Y g = X := by
      change (B⁻¹).val * (B.val * X * (B⁻¹).val) * B.val = X
      calc
        _ = ((B⁻¹).val * B.val) * X * ((B⁻¹).val * B.val) := by noncomm_ring
        _ = _ := by
          rw [show (B⁻¹).val * B.val = 1 from B.inv_val, one_mul, mul_one]
    rw [hy, hX₁]
  letI := standardSU_compact n
  letI := standardSU_connected n
  exact ⟨hsurj.compactSpace hcont, hsurj.connectedSpace hcont⟩

private theorem real_equiv_of_quadratic_completion
    {K Q : Type u} [Field K] [NumberField K] [Field Q]
    (D : GlobalFieldData.{u,v} K) (hD : D = .number inferInstance)
    (w : D.InfinitePlace)
    (hq : ∃ a : Algebra (D.Completion (.inr w)) Q, letI := a
      Algebra.IsQuadraticExtension (D.Completion (.inr w)) Q) :
    ∃ eF : D.Completion (.inr w) ≃+* ℝ, Continuous eF.symm := by
  subst D
  change ∃ a : Algebra w.Completion Q, letI := a
    Algebra.IsQuadraticExtension w.Completion Q at hq
  obtain ⟨a, h⟩ := hq
  letI := a
  letI := h
  have hr := real_completion_of_quadratic_extension (Q := Q) w
  exact ⟨NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hr,
    (NumberField.InfinitePlace.Completion.isometryEquivRealOfIsReal hr).symm.continuous⟩

private theorem anisotropic_hermitian_compact_connected
    {K Q : Type u} [Field K] [NumberField K] [Field Q]
    (D : GlobalFieldData.{u,v} K) (hD : D = .number inferInstance)
    {G : AffineAlgebraicGroup K} (i : MatrixRealization G) (w : D.InfinitePlace) :
    let F := D.Completion (.inr w)
    ∀ [Algebra F Q] [Algebra.IsQuadraticExtension F Q]
      (σ : Q ≃ₐ[F] Q) (_ : σ ≠ 1) {n : ℕ}
      (H : (Matrix (Fin n) (Fin n) Q)ˣ),
      (H.val.map σ).transpose = H.val →
      RepresentsHermitian σ H.val (baseChangedAlgebraicGroup F G) →
      (¬ ∃ x : Fin n → Q, x ≠ 0 ∧ dotProduct (σ ∘ x) (H.val.mulVec x) = 0) →
      CompactSpace (LocalPoints D i (.inr w)) ∧ ConnectedSpace (LocalPoints D i (.inr w)) := by
  intro F _ _ σ hσ n H hH hmodel ha
  obtain ⟨eF, heF⟩ := real_equiv_of_quadratic_completion D hD w
    (Q := Q) ⟨inferInstance, inferInstance⟩
  obtain ⟨j, hj⟩ := LocalCocharacterEvaluation.completionPointTopology G i (F := F)
  obtain ⟨hcompact, hconn⟩ := compact_connected_real_hermitian_points eF heF j σ hσ H.val hH hmodel ha
  exact ⟨hj.surjective.compactSpace hj.continuous, hj.surjective.connectedSpace hj.continuous⟩

set_option maxHeartbeats 1000000 in
theorem archimedeanLocalModels :
    Specs.Arithmetic.AnisotropicUnitaryArchimedeanModels.ArchimedeanLocalModels.{u, v} := by
  intro K E A _ D _ _ _ _ _ _ _ hquad I _ hA hdeg b s G _ _ hG i _ hD w
  letI : Algebra.IsQuadraticExtension K E := ⟨hquad⟩
  let F := D.Completion (.inr w)
  let G' := baseChangedAlgebraicGroup F G
  have hreal : ∃ a : Algebra ℝ F, letI := a
      FiniteDimensional ℝ F ∧ Continuous (algebraMap ℝ F) := by
    subst D
    exact LocalCocharacterEvaluation.archimedeanCompletionScalars w
  obtain ⟨a, ha, hc⟩ := hreal
  letI := a
  letI := ha
  letI : CharZero F := charZero_of_injective_algebraMap (algebraMap ℝ F).injective
  letI : Infinite F := Infinite.of_injective (algebraMap ℝ F) (algebraMap ℝ F).injective
  rcases OuterTypeALocalModels.unitaryLocalModels hA b s G hG D (.inr w) with h | h
  · obtain ⟨Q, _, _, _, _, hdim, σ, H, hσ, _, hH, _, hmodel, _⟩ := h
    letI : Algebra.IsQuadraticExtension F Q := ⟨hdim⟩
    by_cases hvec : ∃ x : Fin (degree E A) → Q,
        x ≠ 0 ∧ dotProduct (σ ∘ x) (H.val.mulVec x) = 0
    · right
      have heq : σ = quadraticConjugation F Q := (quadraticAut σ).resolve_left hσ
      subst σ
      exact dense_of_localPlus D i (.inr w) hc
        (dense_localPlus_of_hermitian D i (.inr w)
          (IsotropicOuterTypeA.hermitianLocalGeneration H hH hvec G' hmodel))
    · exact Or.inl (anisotropic_hermitian_compact_connected D hD i w σ hσ H hH hmodel hvec)
  · right
    obtain ⟨j, _, hF, hFd, hmodel⟩ := h
    letI : Algebra E F := j.toRingHom.toAlgebra
    letI : IsScalarTower K E F := IsScalarTower.of_algebraMap_eq'
      j.comp_algebraMap.symm
    have hco := normOne_has_noncentral_cocharacter hF (b.baseChange F) (hFd.symm ▸ hdeg) hmodel
    exact dense_of_localPlus D i (.inr w) hc
      (IsotropicNormOneRadicalsDensity.splitCentreCompletionDensity hA b s hG D i (.inr w) hco)

end LinearAlgebraicGroups.Arithmetic.AnisotropicUnitaryArchimedeanModels
