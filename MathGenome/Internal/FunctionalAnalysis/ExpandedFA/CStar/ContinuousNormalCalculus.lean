import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.CStar.ContinuousNormalCalculus
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.CStar.CommutativeRepresentation
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.CStar.SpectralPermanence
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Basic
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range

/-!
The continuous calculus for a normal element in a unital C*-algebra.

The library constructs its calculus by the Gelfand representation of the
closed star algebra generated by the element. Its complex C*-instance proves
isometry and full spectral mapping without any additional hypothesis on the
ambient algebra. Uniqueness is the Stone–Weierstrass uniqueness theorem for
continuous star homomorphisms on a compact subset of ℂ.
-/

namespace ExpandedFA.CStar.ContinuousNormalCalculus
universe u

theorem representation_and_permanence : Spec.RepresentationAndPermanence.{u} := by
  exact ⟨CommutativeRepresentation.representation,
    CommutativeRepresentation.zero_representation,
    SpectralPermanence.spectral_permanence⟩

theorem normal_calculus : Spec.NormalCalculus.{u} := by
  intro A _ a ha
  refine ⟨cfcHom (R := ℂ) ha, isometry_cfcHom a ha, cfcHom_id ha, ?_, ?_⟩
  · exact range_cfcHom ℂ ha
  · exact cfcHom_map_spectrum ha

theorem normal_calculus_unique : Spec.NormalCalculusUnique.{u} := by
  intro A _ a _ Φ Ψ hΦ hΨ hΦa hΨa
  exact ContinuousMap.UniqueHom.eq_of_continuous_of_map_id
    (spectrum ℂ a) Φ Ψ hΦ hΨ (hΦa.trans hΨa.symm)

end ExpandedFA.CStar.ContinuousNormalCalculus
