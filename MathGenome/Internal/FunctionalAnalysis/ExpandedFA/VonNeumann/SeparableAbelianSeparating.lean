import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.VonNeumann.SeparableAbelianSeparating
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.OperatorTopology.DoubleCommutant
import Mathlib.Order.Zorn
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Analysis.Normed.Group.InfiniteSum

noncomputable section
open Set Function
open scoped InnerProductSpace Topology
namespace ExpandedFA.VonNeumann.SeparableAbelianSeparating
universe u
variable {𝕜 : Type*} [RCLike 𝕜]
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]

/-- The linear orbit map for an arbitrary unital star subalgebra. -/
def orbitMap (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) : A →ₗ[𝕜] H where
  toFun a := (a : H →L[𝕜] H) e
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The closed cyclic subspace generated by a vector. -/
def cyclicSpace (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) : Submodule 𝕜 H :=
  (orbitMap A e).range.topologicalClosure

instance cyclicSpace_complete (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) :
    CompleteSpace (cyclicSpace A e) :=
  (Submodule.isClosed_topologicalClosure _).completeSpace_coe

lemma self_mem_cyclicSpace (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) :
    e ∈ cyclicSpace A e := by
  apply Submodule.le_topologicalClosure
  exact ⟨1, rfl⟩

lemma cyclicSpace_invariant (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) (a : A) :
    ∀ x ∈ cyclicSpace A e, (a : H →L[𝕜] H) x ∈ cyclicSpace A e := by
  apply Submodule.topologicalClosure_mem_invtSubmodule
  rintro x ⟨b, rfl⟩
  exact ⟨a * b, rfl⟩

lemma orthogonal_invariant (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (V : Submodule 𝕜 H)
    (hV : ∀ a : A, ∀ x ∈ V, (a : H →L[𝕜] H) x ∈ V) (a : A) :
    ∀ x ∈ Vᗮ, (a : H →L[𝕜] H) x ∈ Vᗮ := by
  intro x hx y hy
  rw [← ContinuousLinearMap.adjoint_inner_left]
  exact hx _ (hV (star a) y hy)

lemma cyclicSpace_le (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) (V : Submodule 𝕜 H)
    (hclosed : IsClosed (V : Set H)) (he : e ∈ V)
    (hV : ∀ a : A, ∀ x ∈ V, (a : H →L[𝕜] H) x ∈ V) : cyclicSpace A e ≤ V := by
  apply Submodule.topologicalClosure_minimal _ _ hclosed
  rintro x ⟨a, rfl⟩
  exact hV a e he

/-- Zorn produces a total orthogonal family of nonzero cyclic generators.
This geometric statement does not require commutativity or separability. -/
lemma orthogonal_cyclic_decomposition (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) :
    ∃ s : Set H, (∀ e ∈ s, e ≠ 0) ∧
      s.Pairwise (fun e f => cyclicSpace A e ⟂ cyclicSpace A f) ∧
      (⨆ e : s, cyclicSpace A (e : H)).topologicalClosure = ⊤ := by
  classical
  let F : Set (Set H) := {s | (∀ e ∈ s, e ≠ 0) ∧
    s.Pairwise (fun e f => cyclicSpace A e ⟂ cyclicSpace A f)}
  obtain ⟨s, hs⟩ := zorn_subset F (by
    intro c hc hchain
    refine ⟨⋃₀ c, ⟨?_, ?_⟩, fun t ht => subset_sUnion_of_mem ht⟩
    · rintro e ⟨t, ht, het⟩
      exact (hc ht).1 e het
    · intro e he f hf hef
      obtain ⟨t, ht, het⟩ := he
      obtain ⟨v, hv, hfv⟩ := hf
      rcases hchain.total ht hv with htv | hvt
      · exact (hc hv).2 (htv het) hfv hef
      · exact (hc ht).2 het (hvt hfv) hef)
  let W : Submodule 𝕜 H := (⨆ e : s, cyclicSpace A (e : H)).topologicalClosure
  have hWinv : ∀ a : A, ∀ x ∈ W, (a : H →L[𝕜] H) x ∈ W := by
    intro a
    apply Submodule.topologicalClosure_mem_invtSubmodule
    rw [Module.End.mem_invtSubmodule]
    apply iSup_le
    intro e x hx
    exact Submodule.mem_iSup_of_mem e (cyclicSpace_invariant A e a x hx)
  have htotal : W = ⊤ := by
    have : CompleteSpace W := (Submodule.isClosed_topologicalClosure _).completeSpace_coe
    apply (Submodule.orthogonal_eq_bot_iff).mp
    apply eq_bot_iff.mpr
    intro x hx
    change x = 0
    by_contra hxzero
    have hcx : cyclicSpace A x ≤ Wᗮ :=
      cyclicSpace_le A x Wᗮ W.isClosed_orthogonal hx (orthogonal_invariant A W hWinv)
    have hxortho (e : s) : cyclicSpace A x ⟂ cyclicSpace A (e : H) := by
      exact hcx.trans (Submodule.orthogonal_le
        ((le_iSup (fun e : s => cyclicSpace A (e : H)) e).trans
          (Submodule.le_topologicalClosure _)))
    have hnew : insert x s ∈ F := by
      refine ⟨?_, ?_⟩
      · intro e he
        rcases he with rfl | he
        · exact hxzero
        · exact hs.1.1 e he
      · intro e he f hf hef
        rcases he with rfl | he <;> rcases hf with rfl | hf
        · exact (hef rfl).elim
        · exact hxortho ⟨f, hf⟩
        · exact (hxortho ⟨e, he⟩).symm
        · exact hs.1.2 he hf hef
    have hxs : x ∈ s := hs.2 hnew (subset_insert x s) (mem_insert x s)
    have hxW : x ∈ W := Submodule.le_topologicalClosure _
      (Submodule.mem_iSup_of_mem (⟨x, hxs⟩ : s) (self_mem_cyclicSpace A x))
    exact hxzero ((inner_self_eq_zero (𝕜 := 𝕜)).mp (hx x hxW))
  exact ⟨s, hs.1.1, hs.1.2, htotal⟩

omit [CompleteSpace H] in
/-- Nonzero orthogonal vectors have disjoint small balls, hence form a
countable set in a separable Hilbert space. -/
lemma orthogonal_set_countable [TopologicalSpace.SeparableSpace H] (s : Set H)
    (hz : ∀ e ∈ s, e ≠ 0)
    (hi : s.Pairwise (fun e f => inner 𝕜 e f = 0)) : s.Countable := by
  have hd : Pairwise (Disjoint on (fun e : s => Metric.ball (e : H) (‖(e : H)‖ / 3))) := by
    intro e f hef
    apply Set.disjoint_left.mpr
    intro x hxe hxf
    have hinner := hi e.property f.property (fun h => hef (Subtype.ext h))
    have hsq : ‖(e : H) - (f : H)‖ ^ 2 = ‖(e : H)‖ ^ 2 + ‖(f : H)‖ ^ 2 := by
      simpa [hinner] using norm_sub_sq (𝕜 := 𝕜) (e : H) (f : H)
    have he : ‖(e : H)‖ ≤ dist (e : H) (f : H) := by
      rw [dist_eq_norm]
      nlinarith [norm_nonneg ((e : H) - (f : H)), sq_nonneg ‖(f : H)‖,
        norm_nonneg (e : H)]
    have hf : ‖(f : H)‖ ≤ dist (e : H) (f : H) := by
      rw [dist_eq_norm]
      nlinarith [norm_nonneg ((e : H) - (f : H)), sq_nonneg ‖(e : H)‖,
        norm_nonneg (f : H)]
    have htri := dist_triangle (e : H) x (f : H)
    have hxe' : dist (e : H) x < ‖(e : H)‖ / 3 := by
      simpa [Metric.mem_ball, dist_comm] using hxe
    have hxf' : dist x (f : H) < ‖(f : H)‖ / 3 := hxf
    have hp := norm_pos_iff.mpr (hz e e.property)
    linarith
  have hcount : Countable s := hd.countable_of_isOpen_disjoint
    (fun _ => Metric.isOpen_ball)
    (fun e => ⟨e, Metric.mem_ball_self (by
      exact div_pos (norm_pos_iff.mpr (hz e e.property)) (by norm_num))⟩)
  exact Set.to_countable s

lemma cyclicProjection_commutes (A : StarSubalgebra 𝕜 (H →L[𝕜] H)) (e : H) (a : A) :
    (cyclicSpace A e).starProjection * (a : H →L[𝕜] H) =
      (a : H →L[𝕜] H) * (cyclicSpace A e).starProjection := by
  apply ExpandedFA.OperatorTopology.DoubleCommutantProof.starProjection_commutes_of_invariant
  · exact cyclicSpace_invariant A e a
  · exact cyclicSpace_invariant A e (star a)

/-- On each cyclic subspace, an operator commuting with the algebra is
zero as soon as it kills the generator. -/
lemma cyclicSpace_le_ker (A : StarSubalgebra 𝕜 (H →L[𝕜] H))
    (hcomm : ∀ S ∈ A, ∀ T ∈ A, S * T = T * S)
    (T : H →L[𝕜] H) (hT : T ∈ A) (e : H) (he : T e = 0) :
    cyclicSpace A e ≤ LinearMap.ker T.toLinearMap := by
  apply Submodule.topologicalClosure_minimal _ _ T.isClosed_ker
  rintro x ⟨a, rfl⟩
  change T ((a : H →L[𝕜] H) e) = 0
  have h := congrArg (fun S : H →L[𝕜] H => S e) (hcomm T hT a a.property)
  change T ((a : H →L[𝕜] H) e) = (a : H →L[𝕜] H) (T e) at h
  rw [h, he, map_zero]

/-- The geometric separating-vector construction works over both scalar fields,
including the zero Hilbert space. -/
theorem separating_vector [TopologicalSpace.SeparableSpace H]
    (A : StarSubalgebra 𝕜 (H →L[𝕜] H))
    (hcomm : ∀ S ∈ A, ∀ T ∈ A, S * T = T * S) :
    ∃ e : H, ∀ T ∈ A, T e = 0 → T = 0 := by
  classical
  obtain ⟨s, hz, horth, htotal⟩ := orthogonal_cyclic_decomposition A
  have hcount : s.Countable := orthogonal_set_countable s hz (by
    intro e he f hf hef
    exact (horth he hf hef).inner_eq (self_mem_cyclicSpace A e)
      (self_mem_cyclicSpace A f))
  obtain ⟨w, hwpos, c, hw, _hc⟩ := hcount.exists_pos_hasSum_le (by norm_num : (0 : ℝ) < 1)
  let b : s → ℝ := fun i => w i / (1 + ‖(i : H)‖)
  have hbpos (i : s) : 0 < b i := div_pos (hwpos i) (by positivity)
  let v : s → H := fun i => (b i : 𝕜) • (i : H)
  have hnorm (i : s) : ‖v i‖ ≤ w i := by
    dsimp [v]
    rw [norm_smul, RCLike.norm_ofReal, abs_of_pos (hbpos i)]
    dsimp [b]
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity : 0 < 1 + ‖(i : H)‖)]
    nlinarith [hwpos (i : H)]
  have hv : Summable v := Summable.of_norm
    (hw.summable.of_nonneg_of_le (fun i => norm_nonneg (v i)) hnorm)
  let e : H := ∑' i, v i
  have hproj (i : s) : (cyclicSpace A (i : H)).starProjection e = v i := by
    let Q := (cyclicSpace A (i : H)).starProjection
    have hsingle (j : s) : Q (v j) = if j = i then v i else 0 := by
      by_cases hji : j = i
      · subst j
        simp only [ite_eq_left]
        exact Submodule.starProjection_eq_self_iff.mpr
          ((cyclicSpace A (i : H)).smul_mem _ (self_mem_cyclicSpace A i))
      · rw [ite_eq_right hji]
        apply Submodule.eq_starProjection_of_mem_of_inner_eq_zero (Submodule.zero_mem _)
        intro y hy
        have hle := horth j.property i.property (fun h => hji (Subtype.ext h))
        simpa only [sub_zero] using inner_eq_zero_symm.mp
          (hle ((cyclicSpace A (j : H)).smul_mem (b j : 𝕜)
            (self_mem_cyclicSpace A j)) y hy)
    change Q (∑' j, v j) = v i
    rw [Q.map_tsum hv, tsum_congr hsingle, tsum_ite_eq]
  refine ⟨e, fun T hT hTe => ?_⟩
  have hkill (i : s) : T (i : H) = 0 := by
    have hQ := congrArg (fun S : H →L[𝕜] H => S e)
      (cyclicProjection_commutes A (i : H) ⟨T, hT⟩)
    change (cyclicSpace A (i : H)).starProjection (T e) =
      T ((cyclicSpace A (i : H)).starProjection e) at hQ
    rw [hTe, map_zero, hproj] at hQ
    have hh : (b i : 𝕜) • T (i : H) = 0 := by
      simpa only [v, map_smul] using hQ.symm
    exact (smul_eq_zero.mp hh).resolve_left (by
      exact RCLike.ofReal_ne_zero.mpr (ne_of_gt (hbpos i)))
  have hker : (⨆ i : s, cyclicSpace A (i : H)).topologicalClosure ≤
      LinearMap.ker T.toLinearMap := by
    apply Submodule.topologicalClosure_minimal _ _ T.isClosed_ker
    exact iSup_le fun i => cyclicSpace_le_ker A hcomm T hT i (hkill i)
  rw [htotal] at hker
  ext x
  exact hker (Submodule.mem_top)

/-- Every abelian unital star subalgebra on a separable complex Hilbert
space admits a separating vector, including the zero Hilbert space. -/
theorem exists_separating_vector : Spec.SeparatingVector.{u} := by
  intro H _ _ _ _ A hcomm
  exact separating_vector A hcomm

/-- A separating vector on the genuine real Hilbert space; no complex
structure or closure hypothesis on the algebra is required. -/
theorem exists_real_separating_vector : Spec.RealSeparatingVector.{u} := by
  intro H _ _ _ _ A hcomm
  exact separating_vector A hcomm

end ExpandedFA.VonNeumann.SeparableAbelianSeparating
