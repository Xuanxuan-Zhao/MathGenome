import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.VonNeumann.NormalAlgebraControlMeasure
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.VonNeumann.SeparableMASA
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.SpectralMeasure.NormalSpectral
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.SpectralMeasure.CyclicModel
import Mathlib.MeasureTheory.Function.LpSeminorm.LpNorm
import Mathlib.MeasureTheory.VectorMeasure.Decomposition.RadonNikodym

noncomputable section
open MeasureTheory Set
open scoped ENNReal InnerProductSpace

namespace ExpandedFA.VonNeumann.NormalAlgebraControlMeasure
universe u v
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The source's W*(N) is abelian for normal N. -/
theorem normalAlgebra_abelian (N : H →L[ℂ] H) (hN : IsStarNormal N) :
    SeparableMASA.Spec.IsAbelian (Spec.normalAlgebra N) := by
  let := hN
  apply SeparableMASA.abelian_doubleCommutant (StarAlgebra.adjoin ℂ {N})
  exact fun a ha b hb => setLike_mul_comm ha hb

/-- The double commutant is closed in the shared WOT, on the whole space. -/
theorem normalAlgebra_wotClosed (N : H →L[ℂ] H) :
    SeparableMASA.Spec.IsWOTClosed (Spec.normalAlgebra N) :=
  SeparableMASA.commutant_wotClosed _

/-- Explicit bridge from the chosen double-commutant definition to the
source's WOT-closed algebra generated by N. -/
theorem normalAlgebra_eq_wotClosure (N : H →L[ℂ] H) :
    (Spec.normalAlgebra N : Set (H →L[ℂ] H)) =
      @closure _ (OperatorTopology.Spec.WeakTopologyValue ℂ H H)
        (StarAlgebra.adjoin ℂ ({N} : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H)) := by
  change (SeparableMASA.commutant
    (SeparableMASA.commutant (StarAlgebra.adjoin ℂ {N})) : Set (H →L[ℂ] H)) = _
  simp only [SeparableMASA.coe_commutant]
  exact (OperatorTopology.double_commutant H (StarAlgebra.adjoin ℂ {N})).2.symm

/-- The generator belongs to the concrete double commutant. -/
theorem generator_mem (N : H →L[ℂ] H) : N ∈ Spec.normalAlgebra N :=
  SeparableMASA.le_doubleCommutant (StarAlgebra.adjoin ℂ {N})
    (StarAlgebra.subset_adjoin ℂ {N} (Set.mem_singleton N))

/-- Every spectral projection lies in the concrete generated von Neumann
algebra. This uses joint commutation with N and N*, not a scalar measure. -/
theorem spectralProjection_mem {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (B : Set (spectrum ℂ N)) (hB : MeasurableSet B) :
    E B ∈ Spec.normalAlgebra N := by
  rw [Spec.normalAlgebra, ← SetLike.mem_coe, StarSubalgebra.coe_centralizer,
    StarMemClass.star_coe_eq, Set.union_self]
  intro T hT
  have hc : T ∈ Set.centralizer
      (StarAlgebra.adjoin ℂ ({N} : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H)) := by
    simpa only [← SetLike.mem_coe, StarSubalgebra.coe_centralizer,
      StarMemClass.star_coe_eq, Set.union_self] using hT
  have hmem := StarAlgebra.subset_adjoin ℂ {N} (Set.mem_singleton N)
  have hTN : Commute T N := (hc N hmem).symm
  have hTNstar : Commute T (star N) := (hc (star N) (star_mem hmem)).symm
  exact SpectralMeasure.NormalSpectral.spectral_commutation hN E hE T hTN hTNstar B hB

/-- Norm closedness is used only for the uniform simple-function limit. -/
theorem normalAlgebra_normClosed (N : H →L[ℂ] H) :
    IsClosed (Spec.normalAlgebra N : Set (H →L[ℂ] H)) := by
  change IsClosed (SeparableMASA.commutant
    (SeparableMASA.commutant (StarAlgebra.adjoin ℂ {N})) : Set (H →L[ℂ] H))
  rw [SeparableMASA.coe_commutant]
  exact Set.isClosed_centralizer _

/-- The bounded Borel calculus takes values in W*(N). No separability or
scalar control measure is needed for this direction of the image equality. -/
theorem spectralIntegral_mem {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (f : spectrum ℂ N → ℂ) (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) :
    E.spectralIntegral f ∈ Spec.normalAlgebra N := by
  obtain ⟨a, ha⟩ := SpectralMeasure.exists_uniform_simple_approx f hf
  apply (normalAlgebra_normClosed N).mem_of_tendsto (E.spectralIntegral_tendsto f hf a ha)
  apply Filter.Eventually.of_forall
  intro n
  change (∑ c ∈ (a n).range, c • E ((a n) ⁻¹' {c})) ∈ Spec.normalAlgebra N
  exact (Spec.normalAlgebra N).sum_mem (fun c _ =>
    (Spec.normalAlgebra N).smul_mem
      (spectralProjection_mem hN E hE _ ((a n).measurableSet_fiber c)) c)

/-- A separating vector detects all spectral null sets. -/
theorem controlMeasure_of_separating {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e) :
    Spec.IsControlMeasure E (E.diagonalMeasure e) := by
  intro B hB
  rw [E.diagonalMeasure_apply e B hB]
  constructor
  · intro hz
    simp [hz]
  · intro hz
    have hnorm : ‖E B e‖ ^ 2 = 0 := by
      exact le_antisymm (ENNReal.ofReal_eq_zero.mp hz) (sq_nonneg _)
    apply he (E B) (spectralProjection_mem hN E hE B hB)
    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hnorm)

/-- Finite scalar control measure, including the zero Hilbert space. -/
theorem finite_control_measure : Spec.FiniteControlMeasure.{u} := by
  intro H _ _ _ _ N hN
  obtain ⟨E, hE, _⟩ := SpectralMeasure.NormalPVM.normal_spectral_theorem H N hN
  obtain ⟨e, he⟩ := SeparableMASA.abelian_separating H (Spec.normalAlgebra N)
    (normalAlgebra_abelian N hN) (normalAlgebra_wotClosed N)
  exact ⟨E, e, E.diagonalMeasure e, hE, inferInstance,
    E.diagonalMeasure_apply e, controlMeasure_of_separating hN E hE e he⟩

/-- Every native L∞ class has an everywhere bounded measurable
representative, even when the original measure is not complete. In the
application the underlying measurable sets are exactly the Borel sets. -/
theorem exists_bounded_representative {S : Type v} [MeasurableSpace S]
    (μ : Measure S) (h : Lp ℂ ∞ μ) :
    ∃ f : S → ℂ, SpectralMeasure.Spec.IsBoundedMeasurable f ∧ f =ᵐ[μ] h := by
  classical
  have htop : eLpNormEssSup h μ < ∞ := by
    rw [← eLpNorm_exponent_top (Lp.aestronglyMeasurable h)]
    exact (Lp.memLp h).eLpNorm_lt_top
  obtain ⟨C, hC⟩ := eLpNormEssSup_lt_top_iff_isBoundedUnder.mp htop
  let f : S → ℂ := (Lp.aestronglyMeasurable h).mk h
  have hf : Measurable f := (Lp.aestronglyMeasurable h).measurable_mk
  let B : Set S := {s | ‖f s‖ ≤ (C : ℝ)}
  have hB : MeasurableSet B := measurableSet_le hf.norm measurable_const
  refine ⟨B.indicator f, ⟨hf.indicator hB, (C : ℝ), ?_⟩, ?_⟩
  · intro s
    by_cases hs : s ∈ B
    · rw [Set.indicator_of_mem hs]
      exact hs
    · simp only [Set.indicator_of_notMem hs, norm_zero]
      exact C.coe_nonneg
  · filter_upwards [(Lp.aestronglyMeasurable h).ae_eq_mk, hC] with s hs hcs
    change h s = f s at hs
    change ‖h s‖₊ ≤ C at hcs
    have hsB : s ∈ B := by
      change ‖f s‖ ≤ (C : ℝ)
      rw [← hs]
      exact NNReal.coe_le_coe.mpr hcs
    exact (Set.indicator_of_mem hsB f).trans hs.symm

/-- The control-measure null ideal makes the Borel calculus independent
of all changes on scalar null sets. -/
theorem spectralIntegral_congr_ae {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S)
    (hc : Spec.IsControlMeasure E μ) {f g : S → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f)
    (hg : SpectralMeasure.Spec.IsBoundedMeasurable g) (heq : f =ᵐ[μ] g) :
    E.spectralIntegral f = E.spectralIntegral g := by
  have hB : MeasurableSet {s | f s ≠ g s} := (measurableSet_eq_fun hf.1 hg.1).compl
  have hnull : E {s | f s ≠ g s} = 0 :=
    (hc _ hB).mpr (ae_iff.mp heq)
  exact SpectralMeasure.BorelNormSpectrum.integral_congr_of_null E hB hnull hf hg
    (fun s hs => Classical.not_not.mp hs)

/-- Choose an everywhere bounded Borel representative of each native L∞ class. -/
def boundedRepresentative {S : Type v} [MeasurableSpace S]
    (μ : Measure S) (h : Lp ℂ ∞ μ) : S → ℂ :=
  Classical.choose (exists_bounded_representative μ h)

theorem boundedRepresentative_bounded {S : Type v} [MeasurableSpace S]
    (μ : Measure S) (h : Lp ℂ ∞ μ) :
    SpectralMeasure.Spec.IsBoundedMeasurable (boundedRepresentative μ h) :=
  (Classical.choose_spec (exists_bounded_representative μ h)).1

theorem boundedRepresentative_ae {S : Type v} [MeasurableSpace S]
    (μ : Measure S) (h : Lp ℂ ∞ μ) : boundedRepresentative μ h =ᵐ[μ] h :=
  (Classical.choose_spec (exists_bounded_representative μ h)).2

/-- The native L∞ norm equals the exact spectral norm when the null ideals agree. -/
theorem spectralIntegral_norm_eq_lpNorm {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S)
    (hc : Spec.IsControlMeasure E μ) (h : Lp ℂ ∞ μ) {f : S → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) (heq : f =ᵐ[μ] h) :
    ‖E.spectralIntegral f‖ = ‖h‖ := by
  apply le_antisymm
  · apply SpectralMeasure.BorelNormSpectrum.norm_le_of_null_bound E hf (norm_nonneg h)
    apply (hc _ (measurableSet_lt measurable_const hf.1.norm)).mpr
    have hb : ∀ᵐ s ∂μ, ‖f s‖ ≤ ‖h‖ := by
      filter_upwards [heq, ae_le_lpNorm_exponent_top (Lp.memLp h)] with s hs hb
      rw [hs]
      exact hb
    simpa only [not_le] using ae_iff.mp hb
  · apply ScalarMultiplicationCommutant.norm_top_le_of_bound μ h (norm_nonneg _)
    have hn (r : ℝ) (hr : ‖E.spectralIntegral f‖ < r) :
        ∀ᵐ s ∂μ, ‖f s‖ ≤ r := by
      apply ae_iff.mpr
      simpa only [not_le] using
        (hc _ (measurableSet_lt measurable_const hf.1.norm)).mp
          (SpectralMeasure.BorelNormSpectrum.null_above_norm E hf hr)
    have happrox : ∀ᵐ s ∂μ, ∀ n : ℕ, ‖f s‖ ≤ ‖E.spectralIntegral f‖ + 1 / (n + 1 : ℝ) :=
      ae_all_iff.mpr fun n => hn _ (lt_add_of_pos_right _ (by positivity))
    filter_upwards [heq, happrox] with s hs hb
    rw [← hs]
    exact le_of_forall_pos_le_add (fun ε hε => by
      obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
      exact (hb n).trans (by linarith))

/-- Borel integration descends to L∞ using the common null ideal. -/
def linftyCalculus {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N)) (hc : Spec.IsControlMeasure E μ) :
    Lp ℂ ∞ μ →ₗ[ℂ] Spec.normalAlgebra N where
  toFun h := ⟨E.spectralIntegral (boundedRepresentative μ h),
    spectralIntegral_mem hN E hE _ (boundedRepresentative_bounded μ h)⟩
  map_add' h k := by
    apply Subtype.ext
    change E.spectralIntegral _ = E.spectralIntegral _ + E.spectralIntegral _
    rw [← E.spectralIntegral_add _ _ (boundedRepresentative_bounded μ h)
      (boundedRepresentative_bounded μ k)]
    apply spectralIntegral_congr_ae E μ hc (boundedRepresentative_bounded μ (h + k))
      ((boundedRepresentative_bounded μ h).add (boundedRepresentative_bounded μ k))
    filter_upwards [boundedRepresentative_ae μ (h + k), boundedRepresentative_ae μ h,
      boundedRepresentative_ae μ k, Lp.coeFn_add h k] with s hhk hh hk hadd
    simp only [Pi.add_apply]
    simp only [hhk, hh, hk, hadd, Pi.add_apply]
  map_smul' c h := by
    apply Subtype.ext
    change E.spectralIntegral _ = c • E.spectralIntegral _
    rw [← E.spectralIntegral_smul c _ (boundedRepresentative_bounded μ h)]
    apply spectralIntegral_congr_ae E μ hc (boundedRepresentative_bounded μ (c • h))
      ((boundedRepresentative_bounded μ h).smul c)
    filter_upwards [boundedRepresentative_ae μ (c • h), boundedRepresentative_ae μ h,
      Lp.coeFn_smul c h] with s hch hh hsmul
    simp only [Pi.smul_apply]
    simp only [hch, hh, hsmul, Pi.smul_apply]

theorem linftyCalculus_eq {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N)) (hc : Spec.IsControlMeasure E μ)
    (h : Lp ℂ ∞ μ) {f : spectrum ℂ N → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) (heq : f =ᵐ[μ] h) :
    (linftyCalculus hN E hE μ hc h : H →L[ℂ] H) = E.spectralIntegral f :=
  spectralIntegral_congr_ae E μ hc (boundedRepresentative_bounded μ h) hf
    ((boundedRepresentative_ae μ h).trans heq.symm)

/-- Exact norm preservation also proves faithfulness on equivalence classes. -/
theorem linftyCalculus_norm {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N)) (hc : Spec.IsControlMeasure E μ) (h : Lp ℂ ∞ μ) :
    ‖linftyCalculus hN E hE μ hc h‖ = ‖h‖ :=
  spectralIntegral_norm_eq_lpNorm E μ hc h (boundedRepresentative_bounded μ h)
    (boundedRepresentative_ae μ h)

theorem linftyCalculus_mul {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N)) (hc : Spec.IsControlMeasure E μ) (h k : Lp ℂ ∞ μ) :
    linftyCalculus hN E hE μ hc (Spec.product μ h k) =
      linftyCalculus hN E hE μ hc h * linftyCalculus hN E hE μ hc k := by
  apply Subtype.ext
  change E.spectralIntegral _ = E.spectralIntegral _ * E.spectralIntegral _
  rw [← E.spectralIntegral_mul _ _ (boundedRepresentative_bounded μ h)
    (boundedRepresentative_bounded μ k)]
  apply spectralIntegral_congr_ae E μ hc
    (boundedRepresentative_bounded μ (Spec.product μ h k))
    ((boundedRepresentative_bounded μ h).mul (boundedRepresentative_bounded μ k))
  filter_upwards [boundedRepresentative_ae μ (Spec.product μ h k),
    boundedRepresentative_ae μ h, boundedRepresentative_ae μ k,
    (ContinuousLinearMap.mul ℂ ℂ).coeFn_holder (r := ∞) h k] with s hhk hh hk hmul
  simpa only [Spec.product, Pi.mul_apply, hh, hk, ContinuousLinearMap.mul_apply']
    using hhk.trans hmul

theorem linftyCalculus_star {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N)) (hc : Spec.IsControlMeasure E μ) (h : Lp ℂ ∞ μ) :
    linftyCalculus hN E hE μ hc (star h) = star (linftyCalculus hN E hE μ hc h) := by
  apply Subtype.ext
  change E.spectralIntegral _ = star (E.spectralIntegral _)
  rw [← E.spectralIntegral_star _ (boundedRepresentative_bounded μ h)]
  apply spectralIntegral_congr_ae E μ hc (boundedRepresentative_bounded μ (star h))
    (boundedRepresentative_bounded μ h).star
  filter_upwards [boundedRepresentative_ae μ (star h), boundedRepresentative_ae μ h,
    Lp.coeFn_star h] with s hstar hh hs
  simpa only [Pi.star_apply, hh] using hstar.trans hs

/-- The continuous orbit extends isometrically to the scalar L² space.
Its image is the cyclic subspace; the vector need not be cyclic on all of H. -/
def vectorModel {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H) :
    Lp ℂ 2 (E.diagonalMeasure e) →ₗᵢ[ℂ] H :=
  (SpectralMeasure.CyclicModel.orbitMap N hN e).extendOfIsometry
    (e := (ContinuousMap.toLp 2 (E.diagonalMeasure e) ℂ).toLinearMap)
    (SpectralMeasure.CyclicModel.continuous_density H N (E.diagonalMeasure e))
    (SpectralMeasure.CyclicModel.orbitMap_norm N hN E hE e)

theorem vectorModel_continuous {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (f : C(spectrum ℂ N, ℂ)) :
    vectorModel hN E hE e (ContinuousMap.toLp 2 (E.diagonalMeasure e) ℂ f) =
      E.spectralIntegral f e := by
  have hv : vectorModel hN E hE e (ContinuousMap.toLp 2 (E.diagonalMeasure e) ℂ f) =
      cfcHom hN f e :=
    LinearMap.extendOfIsometry_eq (SpectralMeasure.CyclicModel.orbitMap N hN e)
      (e := (ContinuousMap.toLp 2 (E.diagonalMeasure e) ℂ).toLinearMap)
      (SpectralMeasure.CyclicModel.continuous_density H N (E.diagonalMeasure e))
      (SpectralMeasure.CyclicModel.orbitMap_norm N hN E hE e) f
  rw [hv, ← SpectralMeasure.CyclicModel.continuousIntegral_eq_cfcHom N hN E hE]
  rfl

/-- The vector norm identity holds for any L² representative. -/
theorem spectralIntegral_apply_norm_eq_l2 {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (e : H)
    (u : Lp ℂ 2 (E.diagonalMeasure e)) {f : S → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) (heq : f =ᵐ[E.diagonalMeasure e] u) :
    ‖E.spectralIntegral f e‖ = ‖u‖ := by
  apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
  rw [E.spectralIntegral_norm_sq_integral f hf e,
    SpectralMeasure.CyclicModel.l2_norm_sq]
  exact integral_congr_ae (heq.fun_comp (fun z : ℂ => ‖z‖ ^ 2))

/-- The extension agrees with every bounded Borel orbit, by L² density.
In particular no assertion of cyclicity on the ambient Hilbert space is needed. -/
theorem vectorModel_borel {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (u : Lp ℂ 2 (E.diagonalMeasure e)) {f : spectrum ℂ N → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) (heq : f =ᵐ[E.diagonalMeasure e] u) :
    vectorModel hN E hE e u = E.spectralIntegral f e := by
  let μ := E.diagonalMeasure e
  let V := vectorModel hN E hE e
  have hd (g : C(spectrum ℂ N, ℂ)) :
      dist (E.spectralIntegral f e) (V (ContinuousMap.toLp 2 μ ℂ g)) =
        dist u (ContinuousMap.toLp 2 μ ℂ g) := by
    rw [vectorModel_continuous, dist_eq_norm, dist_eq_norm,
      ← sub_apply,
      ← SpectralMeasure.BorelNormSpectrum.integral_sub E hf
        (SpectralMeasure.NormalPVM.continuous_bounded g)]
    apply spectralIntegral_apply_norm_eq_l2 E e _
      (SpectralMeasure.BorelNormSpectrum.bounded_sub hf
        (SpectralMeasure.NormalPVM.continuous_bounded g))
    filter_upwards [heq, ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) μ g,
      Lp.coeFn_sub u (ContinuousMap.toLp 2 μ ℂ g)] with s hs hg hsub
    simp only [Pi.sub_apply] at *
    rw [hsub, hs, hg]
  apply dist_eq_zero.mp
  apply le_antisymm _ dist_nonneg
  apply le_of_forall_pos_le_add
  intro ε hε
  obtain ⟨g, hg⟩ := Metric.denseRange_iff.mp
    (SpectralMeasure.CyclicModel.continuous_density H N μ) u (ε / 2) (by positivity)
  have htri := dist_triangle (V u) (V (ContinuousMap.toLp 2 μ ℂ g))
    (E.spectralIntegral f e)
  rw [V.dist_map,
    dist_comm (V (ContinuousMap.toLp 2 μ ℂ g)) (E.spectralIntegral f e), hd] at htri
  linarith

/-- The scalar L² model intertwines every bounded Borel multiplier. -/
theorem vectorModel_intertwines {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (h : Lp ℂ ∞ (E.diagonalMeasure e)) {f : spectrum ℂ N → ℂ}
    (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) (heq : f =ᵐ[E.diagonalMeasure e] h)
    (u : Lp ℂ 2 (E.diagonalMeasure e)) :
    vectorModel hN E hE e (ScalarMultiplicationCommutant.Spec.multiplier (E.diagonalMeasure e) h u) =
      E.spectralIntegral f (vectorModel hN E hE e u) := by
  let μ := E.diagonalMeasure e
  let V := vectorModel hN E hE e
  apply congrFun ((SpectralMeasure.CyclicModel.continuous_density H N μ).equalizer
    (V.continuous.comp (ScalarMultiplicationCommutant.Spec.multiplier μ h).continuous)
    ((E.spectralIntegral f).continuous.comp V.continuous) ?_) u
  funext g
  change V (ScalarMultiplicationCommutant.Spec.multiplier μ h (ContinuousMap.toLp 2 μ ℂ g)) =
    E.spectralIntegral f (V (ContinuousMap.toLp 2 μ ℂ g))
  have hb : (f * g : spectrum ℂ N → ℂ) =ᵐ[μ]
      ScalarMultiplicationCommutant.Spec.multiplier μ h (ContinuousMap.toLp 2 μ ℂ g) := by
    filter_upwards [heq, ContinuousMap.coeFn_toLp (p := 2) (𝕜 := ℂ) μ g,
      ScalarMultiplicationCommutant.multiplier_apply μ h (ContinuousMap.toLp 2 μ ℂ g)] with s hs hg hm
    simp only [Pi.mul_apply]
    rw [hm, hs, hg]
  rw [vectorModel_borel hN E hE e _
      (hf.mul (SpectralMeasure.NormalPVM.continuous_bounded g)) hb,
    vectorModel_continuous,
    E.spectralIntegral_mul f g hf (SpectralMeasure.NormalPVM.continuous_bounded g)]
  rfl

/-- A bounded measurable function determines a native L∞ class. -/
theorem bounded_memLp_top {S : Type v} [MeasurableSpace S] (μ : Measure S)
    {f : S → ℂ} (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) : MemLp f ∞ μ := by
  obtain ⟨C, hC⟩ := hf.2
  exact memLp_top_of_bound hf.1.aestronglyMeasurable C (Filter.Eventually.of_forall hC)

/-- The image of the scalar L² model is invariant under all bounded Borel integrals. -/
theorem vectorModel_range_invariant {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    {f : spectrum ℂ N → ℂ} (hf : SpectralMeasure.Spec.IsBoundedMeasurable f)
    (x : H) (hx : x ∈ (vectorModel hN E hE e).toLinearMap.range) :
    E.spectralIntegral f x ∈ (vectorModel hN E hE e).toLinearMap.range := by
  obtain ⟨u, rfl⟩ := hx
  let h := (bounded_memLp_top (E.diagonalMeasure e) hf).toLp f
  exact ⟨ScalarMultiplicationCommutant.Spec.multiplier (E.diagonalMeasure e) h u,
    vectorModel_intertwines hN E hE e h hf (MemLp.coeFn_toLp _).symm u⟩

/-- The cyclic projection belongs to the commutant of N, so its range reduces
all of the double commutant. This is the ambient-to-cyclic-space bridge. -/
theorem normalAlgebra_preserves_vectorModel {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (T : H →L[ℂ] H) (hT : T ∈ Spec.normalAlgebra N) :
    ∀ x ∈ (vectorModel hN E hE e).toLinearMap.range,
      T x ∈ (vectorModel hN E hE e).toLinearMap.range := by
  let V := vectorModel hN E hE e
  let K := V.toLinearMap.range
  have : CompleteSpace K := V.isometry.isClosedEmbedding.isClosed_range.completeSpace_coe
  let P := K.starProjection
  have hinv : ∀ x ∈ K, N x ∈ K := by
    intro x hx
    rw [← SpectralMeasure.NormalPVM.continuousIntegral_coordinate E hE]
    exact vectorModel_range_invariant hN E hE e
      (SpectralMeasure.NormalPVM.continuous_bounded (SpectralMeasure.CyclicModel.Spec.coordinate N)) x hx
  have hstarinv : ∀ x ∈ K, star N x ∈ K := by
    intro x hx
    rw [← SpectralMeasure.NormalPVM.continuousIntegral_coordinate E hE]
    change star (E.spectralIntegral (SpectralMeasure.CyclicModel.Spec.coordinate N)) x ∈ K
    rw [← E.spectralIntegral_star _ (SpectralMeasure.NormalPVM.continuous_bounded
        (SpectralMeasure.CyclicModel.Spec.coordinate N))]
    exact vectorModel_range_invariant hN E hE e
      (SpectralMeasure.NormalPVM.continuous_bounded (SpectralMeasure.CyclicModel.Spec.coordinate N)).star x hx
  have hPN : P * N = N * P :=
    OperatorTopology.DoubleCommutantProof.starProjection_commutes_of_invariant K N hinv hstarinv
  have hNP : N ∈ StarSubalgebra.centralizer ℂ ({P} : Set (H →L[ℂ] H)) := by
    rw [StarSubalgebra.mem_centralizer_iff]
    intro g hg
    rcases Set.mem_singleton_iff.mp hg with rfl
    refine ⟨hPN, ?_⟩
    change star K.starProjection * N = N * star K.starProjection
    rw [(isSelfAdjoint_starProjection K).star_eq]
    exact hPN
  have hAP : StarAlgebra.adjoin ℂ ({N} : Set (H →L[ℂ] H)) ≤
      StarSubalgebra.centralizer ℂ ({P} : Set (H →L[ℂ] H)) :=
    StarAlgebra.adjoin_le (by intro S hS; rcases Set.mem_singleton_iff.mp hS with rfl; exact hNP)
  have hP : P ∈ SeparableMASA.commutant (StarAlgebra.adjoin ℂ {N}) := by
    rw [← SetLike.mem_coe, SeparableMASA.coe_commutant]
    intro S hS
    exact ((StarSubalgebra.mem_centralizer_iff ℂ).mp (hAP hS) P (Set.mem_singleton P)).1.symm
  have hPT : P * T = T * P := by
    change T ∈ SeparableMASA.commutant (SeparableMASA.commutant (StarAlgebra.adjoin ℂ {N})) at hT
    rw [← SetLike.mem_coe, SeparableMASA.coe_commutant] at hT
    exact hT P hP
  intro x hx
  apply (Submodule.starProjection_eq_self_iff).mp
  change P (T x) = T x
  have hp := congrArg (fun S : H →L[ℂ] H => S x) hPT
  change P (T x) = T (P x) at hp
  rw [hp, show P x = x from Submodule.starProjection_eq_self_iff.mpr hx]

/-- A separating vector upgrades equality on its cyclic subspace to equality
on all of H, yielding the reverse Borel-image inclusion. -/
theorem borel_surjective_of_separating {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e)
    (T : H →L[ℂ] H) (hT : T ∈ Spec.normalAlgebra N) :
    ∃ f : spectrum ℂ N → ℂ, SpectralMeasure.Spec.IsBoundedMeasurable f ∧ E.spectralIntegral f = T := by
  let μ := E.diagonalMeasure e
  let V := vectorModel hN E hE e
  let U := V.equivRange
  let inv := normalAlgebra_preserves_vectorModel hN E hE e T hT
  let R : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ :=
    U.symm.toContinuousLinearEquiv.toContinuousLinearMap ∘L
      (T.restrict inv) ∘L U.toContinuousLinearEquiv.toContinuousLinearMap
  have hRV (u : Lp ℂ 2 μ) : V (R u) = T (V u) := by
    have hh := congrArg Subtype.val (U.apply_symm_apply ((T.restrict inv) (U u)))
    exact hh
  have hcomm : ScalarMultiplicationCommutant.Spec.CommutesWithMultipliers μ R := by
    intro h
    ext u : 1
    apply V.injective
    change V (R (ScalarMultiplicationCommutant.Spec.multiplier μ h u)) =
      V (ScalarMultiplicationCommutant.Spec.multiplier μ h (R u))
    let f := boundedRepresentative μ h
    have hf := boundedRepresentative_bounded μ h
    have heq := boundedRepresentative_ae μ h
    rw [hRV, vectorModel_intertwines hN E hE e h hf heq,
      vectorModel_intertwines hN E hE e h hf heq, hRV]
    exact congrArg (fun S : H →L[ℂ] H => S (V u))
      (normalAlgebra_abelian N hN T hT _ (spectralIntegral_mem hN E hE f hf))
  obtain ⟨h, ⟨hR, _⟩, _⟩ := ScalarMultiplicationCommutant.finite_commutant ℂ _ μ R hcomm
  obtain ⟨f, hf, heq⟩ := exists_bounded_representative μ h
  have h1 : V (ContinuousMap.toLp 2 μ ℂ 1) = e := by
    rw [vectorModel_continuous]
    change E.spectralIntegral (fun _ => 1) e = e
    rw [E.spectralIntegral_one]
    rfl
  have hTe : T e = E.spectralIntegral f e := by
    rw [← h1, ← hRV, hR, vectorModel_intertwines hN E hE e h hf heq, h1]
  have hz : T - E.spectralIntegral f = 0 :=
    he _ ((Spec.normalAlgebra N).sub_mem hT (spectralIntegral_mem hN E hE f hf))
      (by simpa only [sub_apply, sub_eq_zero] using hTe)
  exact ⟨f, hf, (sub_eq_zero.mp hz).symm⟩

/-- The descended L∞ calculus is onto the concrete generated algebra. -/
theorem linftyCalculus_surjective {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e) :
    Function.Surjective (linftyCalculus hN E hE (E.diagonalMeasure e)
      (controlMeasure_of_separating hN E hE e he)) := by
  intro T
  obtain ⟨f, hf, hT⟩ := borel_surjective_of_separating hN E hE e he T T.property
  refine ⟨(bounded_memLp_top (E.diagonalMeasure e) hf).toLp f, ?_⟩
  apply Subtype.ext
  rw [linftyCalculus_eq hN E hE _ _ _ hf (MemLp.coeFn_toLp _).symm, hT]

/-- Radon–Nikodym for the finite complex spectral coefficient measure,
proved from the real and imaginary signed-measure derivatives. -/
theorem coefficient_density {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S) [SigmaFinite μ]
    (hc : Spec.IsControlMeasure E μ) (x y : H) :
    ∃ g : S → ℂ, Integrable g μ ∧
      ∀ B, MeasurableSet B → ⟪x, E B y⟫_ℂ = ∫ s in B, g s ∂μ := by
  let c := E.coefficientMeasure x y
  have hca : c ≪ᵥ μ.toENNRealVectorMeasure := by
    intro B hB
    by_cases hmeas : MeasurableSet B
    · rw [Measure.toENNRealVectorMeasure_apply_measurable hmeas] at hB
      change E.coefficientMeasure x y B = 0
      rw [E.coefficientMeasure_apply x y B hmeas]
      change ⟪x, E B y⟫_ℂ = 0
      rw [(hc B hmeas).mpr hB]
      simp
    · exact c.not_measurable hmeas
  obtain ⟨hre, him⟩ := (ComplexMeasure.absolutelyContinuous_ennreal_iff c _).mp hca
  have hre' := SignedMeasure.withDensityᵥ_rnDeriv_eq c.re μ hre
  have him' := SignedMeasure.withDensityᵥ_rnDeriv_eq c.im μ him
  refine ⟨c.rnDeriv μ, c.integrable_rnDeriv μ, ?_⟩
  intro B hB
  have hcoeff : ⟪x, E B y⟫_ℂ = c B := (E.coefficientMeasure_apply x y B hB).symm
  rw [hcoeff]
  apply Complex.ext
  · simp only [← RCLike.re_eq_complex_re]
    rw [← integral_re (c.integrable_rnDeriv μ).integrableOn]
    change c.re B = ∫ s in B, c.re.rnDeriv μ s ∂μ
    have hh := (congrArg (fun t : SignedMeasure S => t B) hre').symm
    simpa only [withDensityᵥ_apply (SignedMeasure.integrable_rnDeriv c.re μ) hB] using hh
  · simp only [← RCLike.im_eq_complex_im]
    rw [← integral_im (c.integrable_rnDeriv μ).integrableOn]
    change c.im B = ∫ s in B, c.im.rnDeriv μ s ∂μ
    have hh := (congrArg (fun t : SignedMeasure S => t B) him').symm
    simpa only [withDensityᵥ_apply (SignedMeasure.integrable_rnDeriv c.im μ) hB] using hh

/-- The density identity on sets gives the exact finite spectral-sum identity. -/
theorem simpleIntegral_coefficient_density {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S)
    (x y : H) {g : S → ℂ} (hg : Integrable g μ)
    (hsets : ∀ B, MeasurableSet B → ⟪x, E B y⟫_ℂ = ∫ s in B, g s ∂μ)
    (a : SimpleFunc S ℂ) :
    ⟪x, E.simpleIntegral a y⟫_ℂ = ∫ s, a s * g s ∂μ := by
  classical
  have hfun : (fun s => a s * g s) =
      (fun s => ∑ c ∈ a.range, (a ⁻¹' {c}).indicator (fun s => c * g s) s) := by
    funext s
    rw [Finset.sum_eq_single (a s)]
    · simp
    · intro c hc hne
      simp [Ne.symm hne]
    · exact fun h => (h (a.mem_range_self s)).elim
  rw [E.simpleIntegral_apply, inner_sum, hfun]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro c hc
    rw [inner_smul_right, hsets _ (a.measurableSet_fiber c),
      integral_indicator (a.measurableSet_fiber c), integral_const_mul]
  · exact fun c hc => (hg.const_mul c).indicator (a.measurableSet_fiber c)

/-- Uniform simple approximation extends the density identity to all bounded
Borel functions. The majorant is an integrable multiple of the L¹ density. -/
theorem spectralIntegral_coefficient_density {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S)
    (x y : H) {g : S → ℂ} (hg : Integrable g μ)
    (hsets : ∀ B, MeasurableSet B → ⟪x, E B y⟫_ℂ = ∫ s in B, g s ∂μ)
    (f : S → ℂ) (hf : SpectralMeasure.Spec.IsBoundedMeasurable f) :
    ⟪x, E.spectralIntegral f y⟫_ℂ = ∫ s, f s * g s ∂μ := by
  open Filter in
  obtain ⟨a, ha⟩ := SpectralMeasure.exists_uniform_simple_approx f hf
  have hi : Filter.Tendsto (fun n => ⟪x, E.simpleIntegral (a n) y⟫_ℂ) Filter.atTop
      (nhds ⟪x, E.spectralIntegral f y⟫_ℂ) := by
    have hy := (((ContinuousLinearMap.apply ℂ H) y).continuous.tendsto _).comp
      (E.spectralIntegral_tendsto f hf a ha)
    exact Filter.Tendsto.inner tendsto_const_nhds hy
  obtain ⟨C, hC0, hC⟩ := hf.nonneg_bound
  have hb : ∀ᶠ n in Filter.atTop, ∀ s, ‖a n s‖ ≤ C + 1 := by
    filter_upwards [Metric.tendstoUniformly_iff.mp ha 1 (by positivity)] with n hn s
    have ht := dist_triangle (a n s) (f s) 0
    simp only [dist_zero_right] at ht
    have hd := hn s
    rw [dist_comm] at hd
    linarith [hC s]
  have hint : Filter.Tendsto (fun n => ∫ s, a n s * g s ∂μ) Filter.atTop
      (nhds (∫ s, f s * g s ∂μ)) := by
    apply tendsto_integral_filter_of_dominated_convergence (fun s => (C + 1) * ‖g s‖)
    · exact Filter.Eventually.of_forall (fun n => (a n).measurable.aestronglyMeasurable.mul
        hg.aestronglyMeasurable)
    · exact hb.mono (fun n hn => Filter.Eventually.of_forall (fun s => by
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right (hn s) (norm_nonneg _)))
    · exact hg.norm.const_mul (C + 1)
    · exact Filter.Eventually.of_forall (fun s => (ha.tendsto_at s).mul tendsto_const_nhds)
  simp only [← simpleIntegral_coefficient_density E μ x y hg hsets] at hint
  exact tendsto_nhds_unique hi hint

/-- Every operator coefficient is an L¹ test for the same finite control measure. -/
theorem coefficient_is_l1_test {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e)
    (Ψ : Lp ℂ ∞ (E.diagonalMeasure e) ≃ₗ[ℂ] Spec.normalAlgebra N)
    (hΨ : Spec.IsCalculusIsomorphism N E.spectralIntegral (E.diagonalMeasure e) Ψ)
    (x y : H) :
    ∃ g : Lp ℂ 1 (E.diagonalMeasure e), ∀ f : Lp ℂ ∞ (E.diagonalMeasure e),
      ⟪x, (Ψ f : H →L[ℂ] H) y⟫_ℂ = Spec.pairing (E.diagonalMeasure e) f g := by
  let μ := E.diagonalMeasure e
  obtain ⟨g, hg, hsets⟩ := coefficient_density E μ (controlMeasure_of_separating hN E hE e he) x y
  let gLp := (memLp_one_iff_integrable.mpr hg).toLp g
  refine ⟨gLp, ?_⟩
  intro h
  obtain ⟨f, hf, heq⟩ := hΨ.2.2.2.1 h
  rw [hΨ.2.2.2.2 h f hf heq, spectralIntegral_coefficient_density E μ x y hg hsets f hf,
    Spec.pairing, ContinuousLinearMap.lpPairing_eq_integral]
  apply integral_congr_ae
  filter_upwards [heq, MemLp.coeFn_toLp (memLp_one_iff_integrable.mpr hg)] with s hs hgLp
  change f s * g s = h s * gLp s
  rw [hs, hgLp]

/-- Every L¹ function is one pointwise product of two L² vectors, with
conjugation on the first factor as required by the Hilbert convention. -/
theorem l1_factorization {S : Type v} [MeasurableSpace S]
    (μ : Measure S) (g : Lp ℂ 1 μ) :
    ∃ u v : Lp ℂ 2 μ, (fun s => star (u s) * v s) =ᵐ[μ] g := by
  let a : S → ℂ := fun s => (Real.sqrt ‖g s‖ : ℂ)
  let b : S → ℂ := fun s => g s / a s
  have ha : Measurable a := by
    dsimp [a]
    exact Complex.measurable_ofReal.comp (Real.continuous_sqrt.measurable.comp
      (Lp.stronglyMeasurable g).measurable.norm)
  have hb : Measurable b := (Lp.stronglyMeasurable g).measurable.div ha
  have hna (s : S) : ‖a s‖ ^ 2 = ‖g s‖ := by
    simp only [a, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _)]
    exact Real.sq_sqrt (norm_nonneg _)
  have hnb (s : S) : ‖b s‖ ^ 2 = ‖g s‖ := by
    dsimp [b]
    rw [norm_div, div_pow, hna]
    by_cases hz : ‖g s‖ = 0
    · simp [hz]
    · rw [pow_two, mul_div_cancel_right₀ _ hz]
  have hg : Integrable (fun s => ‖g s‖) μ :=
    (memLp_one_iff_integrable.mp (Lp.memLp g)).norm
  have hma : MemLp a 2 μ := (memLp_two_iff_integrable_sq_norm ha.aestronglyMeasurable).mpr
    (by simpa only [hna] using hg)
  have hmb : MemLp b 2 μ := (memLp_two_iff_integrable_sq_norm hb.aestronglyMeasurable).mpr
    (by simpa only [hnb] using hg)
  refine ⟨hma.toLp a, hmb.toLp b, ?_⟩
  filter_upwards [MemLp.coeFn_toLp hma, MemLp.coeFn_toLp hmb] with s hs ht
  rw [hs, ht]
  change star ((Real.sqrt ‖g s‖ : ℂ)) * (g s / (Real.sqrt ‖g s‖ : ℂ)) = g s
  simp only [Complex.star_def, Complex.conj_ofReal]
  by_cases hz : g s = 0
  · simp [hz]
  · have hn : (Real.sqrt ‖g s‖ : ℂ) ≠ 0 := by
      exact_mod_cast (ne_of_gt (Real.sqrt_pos.mpr (norm_pos_iff.mpr hz)))
    exact mul_div_cancel₀ _ hn

/-- Every native L¹ test is exactly one coefficient on the cyclic subspace. -/
theorem l1_test_is_coefficient {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (Ψ : Lp ℂ ∞ (E.diagonalMeasure e) ≃ₗ[ℂ] Spec.normalAlgebra N)
    (hΨ : Spec.IsCalculusIsomorphism N E.spectralIntegral (E.diagonalMeasure e) Ψ)
    (g : Lp ℂ 1 (E.diagonalMeasure e)) :
    ∃ x y : H, ∀ f : Lp ℂ ∞ (E.diagonalMeasure e),
      Spec.pairing (E.diagonalMeasure e) f g = ⟪x, (Ψ f : H →L[ℂ] H) y⟫_ℂ := by
  let μ := E.diagonalMeasure e
  let V := vectorModel hN E hE e
  obtain ⟨u, v, huv⟩ := l1_factorization μ g
  refine ⟨V u, V v, ?_⟩
  intro h
  obtain ⟨f, hf, heq⟩ := hΨ.2.2.2.1 h
  rw [hΨ.2.2.2.2 h f hf heq, ← vectorModel_intertwines hN E hE e h hf heq,
    V.inner_map_map, L2.inner_def, Spec.pairing, ContinuousLinearMap.lpPairing_eq_integral]
  apply integral_congr_ae
  filter_upwards [huv, ScalarMultiplicationCommutant.multiplier_apply μ h v] with s hs hm
  change h s * g s =
    (ScalarMultiplicationCommutant.Spec.multiplier μ h v) s * star (u s)
  rw [hm, ← hs]
  ring

/-- Equality of the two complete families of tests proves equality of the
initial topologies, with no boundedness condition on the operators. -/
theorem topology_eq_of_coefficientFunctionals (N : H →L[ℂ] H)
    (μ : Measure (spectrum ℂ N))
    (Ψ : Lp ℂ ∞ μ ≃ₗ[ℂ] Spec.normalAlgebra N)
    (h : Spec.CoefficientFunctionals N μ Ψ) :
    Spec.weakStarTopology μ = TopologicalSpace.induced
      (fun f => (Ψ f : H →L[ℂ] H)) (OperatorTopology.Spec.WeakTopologyValue ℂ H H) := by
  rw [OperatorTopology.hilbert_weak_eq_coefficients ℂ H H]
  change TopologicalSpace.induced (fun f g => Spec.pairing μ f g) Pi.topologicalSpace =
    TopologicalSpace.induced (fun f => (Ψ f : H →L[ℂ] H))
      (TopologicalSpace.induced
        (fun (T : H →L[ℂ] H) (p : H × H) => ⟪p.2, T p.1⟫_ℂ) Pi.topologicalSpace)
  rw [induced_compose]
  simp only [induced_to_pi, Function.comp_apply]
  apply le_antisymm
  · apply le_iInf
    intro p
    obtain ⟨g, hg⟩ := h.1 p.2 p.1
    have heq : (fun f : Lp ℂ ∞ μ => ⟪p.2, (Ψ f : H →L[ℂ] H) p.1⟫_ℂ) =
        (fun f => Spec.pairing μ f g) := funext hg
    rw [heq]
    exact iInf_le _ g
  · apply le_iInf
    intro g
    obtain ⟨x, y, hg⟩ := h.2 g
    have heq : (fun f : Lp ℂ ∞ μ => Spec.pairing μ f g) =
        (fun f => ⟪x, (Ψ f : H →L[ℂ] H) y⟫_ℂ) := funext hg
    rw [heq]
    exact iInf_le _ (y, x)

/-- Once the L∞ isomorphism has been constructed, its Borel
representatives give the reverse inclusion in the range assertion. -/
theorem borelImage_of_isomorphism {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E)
    (μ : Measure (spectrum ℂ N))
    (Ψ : Lp ℂ ∞ μ ≃ₗ[ℂ] Spec.normalAlgebra N)
    (hΨ : Spec.IsCalculusIsomorphism N E.spectralIntegral μ Ψ) :
    Spec.BorelImage N E.spectralIntegral := by
  intro T
  constructor
  · intro hT
    let h := Ψ.symm ⟨T, hT⟩
    obtain ⟨f, hf, heq⟩ := hΨ.2.2.2.1 h
    refine ⟨f, hf, ?_⟩
    have hcompat := hΨ.2.2.2.2 h f hf heq
    have hval : (Ψ h : H →L[ℂ] H) = T :=
      congrArg Subtype.val (Ψ.apply_symm_apply ⟨T, hT⟩)
    exact hcompat.symm.trans hval
  · rintro ⟨f, hf, rfl⟩
    exact spectralIntegral_mem hN E hE f hf

/-- The Borel calculus gives the surjective isometric L∞ star-algebra model. -/
theorem calculus_isomorphism {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e) :
    ∃ Ψ : Lp ℂ ∞ (E.diagonalMeasure e) ≃ₗ[ℂ] Spec.normalAlgebra N,
      Spec.IsCalculusIsomorphism N E.spectralIntegral (E.diagonalMeasure e) Ψ := by
  let μ := E.diagonalMeasure e
  let hc := controlMeasure_of_separating hN E hE e he
  let F := linftyCalculus hN E hE μ hc
  let I : Lp ℂ ∞ μ →ₗᵢ[ℂ] Spec.normalAlgebra N :=
    { F with norm_map' := linftyCalculus_norm hN E hE μ hc }
  let Ψ := LinearEquiv.ofBijective F ⟨I.injective, linftyCalculus_surjective hN E hE e he⟩
  refine ⟨Ψ, linftyCalculus_mul hN E hE μ hc,
    linftyCalculus_star hN E hE μ hc, linftyCalculus_norm hN E hE μ hc,
    exists_bounded_representative μ, ?_⟩
  exact fun h f hf hrep => linftyCalculus_eq hN E hE μ hc h hf hrep

/-- Both families of defining scalar functionals coincide exactly.
The isomorphism is supplied by the proved calculus construction. -/
theorem coefficientFunctionals_of_calculus {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e)
    (Ψ : Lp ℂ ∞ (E.diagonalMeasure e) ≃ₗ[ℂ] Spec.normalAlgebra N)
    (hΨ : Spec.IsCalculusIsomorphism N E.spectralIntegral (E.diagonalMeasure e) Ψ) :
    Spec.CoefficientFunctionals N (E.diagonalMeasure e) Ψ := by
  exact ⟨coefficient_is_l1_test hN E hE e he Ψ hΨ, l1_test_is_coefficient hN E hE e Ψ hΨ⟩

/-- The calculus model and coefficient-family identity on the same measure. -/
theorem calculus_model {N : H →L[ℂ] H} (hN : IsStarNormal N)
    (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
    (hE : SpectralMeasure.NormalPVM.Spec.Resolves N E) (e : H)
    (he : SeparableMASA.Spec.IsSeparating (Spec.normalAlgebra N) e) :
    ∃ Ψ : Lp ℂ ∞ (E.diagonalMeasure e) ≃ₗ[ℂ] Spec.normalAlgebra N,
      Spec.IsCalculusIsomorphism N E.spectralIntegral (E.diagonalMeasure e) Ψ ∧
      Spec.CoefficientFunctionals N (E.diagonalMeasure e) Ψ := by
  obtain ⟨Ψ, hΨ⟩ := calculus_isomorphism hN E hE e he
  exact ⟨Ψ, hΨ, coefficientFunctionals_of_calculus hN E hE e he Ψ hΨ⟩

/-- Full result assembled for a single spectral resolution, separating
vector and vector measure, including the topology on the whole algebra. -/
theorem normal_algebra_control_measure : Spec.NormalAlgebraControlMeasure.{u} := by
  intro H _ _ _ _ N hN
  obtain ⟨E, hE, _⟩ := SpectralMeasure.NormalPVM.normal_spectral_theorem H N hN
  obtain ⟨e, he⟩ := SeparableMASA.abelian_separating H (Spec.normalAlgebra N)
    (normalAlgebra_abelian N hN) (normalAlgebra_wotClosed N)
  obtain ⟨Ψ, hΨ, hcoeff⟩ := calculus_model hN E hE e he
  refine ⟨E, E.spectralIntegral, E.diagonalMeasure e, inferInstance, hE,
    SpectralMeasure.BorelNormSpectrum.borel_calculus E,
    SpectralMeasure.NormalPVM.continuousIntegral_coordinate E hE,
    controlMeasure_of_separating hN E hE e he,
    borelImage_of_isomorphism hN E hE _ Ψ hΨ, Ψ, hΨ, hcoeff,
    topology_eq_of_coefficientFunctionals N _ Ψ hcoeff⟩

end ExpandedFA.VonNeumann.NormalAlgebraControlMeasure
