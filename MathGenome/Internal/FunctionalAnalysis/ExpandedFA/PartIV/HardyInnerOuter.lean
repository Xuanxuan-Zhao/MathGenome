import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.PartIV.HardyInnerOuter
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.PartIV.HardyLogModulus
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.PartIV.Beurling

noncomputable section
open MeasureTheory Filter
open scoped Topology Real
namespace ExpandedFA.PartIV.HardyInnerOuter
open HardyDiskSpec BeurlingWanderingSpec BeurlingSpec
open HardyDisk (evaluation_injective monomial_evaluation analytic_evaluation
  bounded_analytic_coefficients)
open HardyLogModulus

lemma eval_smul (a : ℂ) (f : H2) (z : ℂ) :
    eval (a • f) z = a * eval f z := HardyDisk.evaluation_smul a f z

lemma innerMul_eval (i : H2) (hi : IsInner i) (f : H2) (z : ℂ) (hz : z ∈ disk) :
    eval (Beurling.innerMul i hi f) z = eval i z * eval f z :=
  Beurling.innerMul_evaluation i hi f z hz

/-- The closed subspace generated by polynomial multiples of a vector. -/
def cyclicSubspace (f : H2) : Submodule ℂ H2 :=
  (Submodule.span ℂ (Set.range (fun n : ℕ => (shift^[n]) f))).topologicalClosure

lemma mem_cyclicSubspace (f : H2) : f ∈ cyclicSubspace f := by
  apply Submodule.le_topologicalClosure
  exact Submodule.subset_span ⟨0, rfl⟩

lemma cyclicSubspace_minimal {f : H2} {M : Submodule ℂ H2}
    (hc : IsClosed (M : Set H2)) (hM : ShiftInvariant M) (hf : f ∈ M) :
    cyclicSubspace f ≤ M := by
  apply Submodule.topologicalClosure_minimal _ _ hc
  apply Submodule.span_le.mpr
  rintro _ ⟨n, rfl⟩
  exact BeurlingWandering.iterate_mem hM hf n

lemma cyclicSubspace_invariant (f : H2) : ShiftInvariant (cyclicSubspace f) := by
  let S := Submodule.span ℂ (Set.range (fun n : ℕ => (shift^[n]) f))
  have hS : S.map shift.toLinearMap ≤ S := by
    rw [Submodule.map_span]
    apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨n, rfl⟩, rfl⟩
    apply Submodule.subset_span
    exact ⟨n + 1, Function.iterate_succ_apply' ..⟩
  have hm := (S.topologicalClosure_map shift.toContinuousLinearMap).trans
    (Submodule.topologicalClosure_mono hS)
  intro g hg
  exact hm ⟨g, hg, rfl⟩

lemma zero_mem_disk : (0 : ℂ) ∈ disk := by simp [HardyDiskSpec.disk]

lemma eval_zero (f : H2) : eval f 0 = f 0 := by
  simp [HardyDiskSpec.eval, zero_pow_eq]

/-- A unit Hardy vector whose constant coefficient already has norm one is constant. -/
lemma constant_of_norm_at_zero {f : H2} (hf : ‖f‖ = 1) (h0 : ‖eval f 0‖ = 1) :
    f = lp.single 2 0 (eval f 0) := by
  rw [eval_zero] at h0 ⊢
  have hi : RCLike.re (inner ℂ f (lp.single 2 0 (f 0))) = ‖f 0‖ ^ 2 := by
    rw [lp.inner_single_right, inner_self_eq_norm_sq]
  have hs : ‖f - lp.single 2 0 (f 0)‖ ^ 2 = 0 := by
    rw [@norm_sub_sq ℂ, hf, hi, lp.norm_single (by norm_num), h0]
    norm_num
  exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hs))

lemma inner_bound {j : H2} (hj : IsInner j) {z : ℂ} (hz : z ∈ disk) :
    ‖eval j z‖ ≤ 1 :=
  evaluation_norm_le_of_boundary_norm_le (hj.2.mono fun _ ht => ht.le) hz

/-- Equal boundary moduli for a product by an inner function. -/
lemma boundary_modulus_of_inner_product {o j g : H2} (hj : IsInner j)
    (hp : ∀ z ∈ disk, eval o z = eval j z * eval g z) :
    ∀ᵐ t ∂circleMeasure, ‖boundary g t‖ = ‖boundary o t‖ := by
  filter_upwards [boundary_mul_of_eval_mul hp, hj.2] with t ht hjt
  rw [ht, norm_mul, hjt, one_mul]

/-- The exact logarithmic modulus prevents a nonconstant inner divisor. -/
lemma exponential_divisor_constant {f o j g : H2} (hf : f ≠ 0)
    {c : ℂ} (hc : ‖c‖ = 1)
    (ho : Set.EqOn (eval o) (exponentialFactor (boundaryLog f) c) disk)
    (hmod : ∀ᵐ t ∂circleMeasure, ‖boundary o t‖ = ‖boundary f t‖)
    (hj : IsInner j) (hp : ∀ z ∈ disk, eval o z = eval j z * eval g z) :
    ∃ a : ℂ, ‖a‖ = 1 ∧ j = lp.single 2 0 a := by
  have hc0 : c ≠ 0 := by intro h; simp [h] at hc
  have ho0 : eval o 0 ≠ 0 := by
    rw [ho zero_mem_disk]
    exact exponential_nonzero _ c hc0 0
  have hg0 : g ≠ 0 := by
    intro h
    have hh := hp 0 zero_mem_disk
    simp [h, HardyDiskSpec.eval] at hh
    exact ho0 hh
  have hgm := boundary_modulus_of_inner_product hj hp
  have hlogs : boundaryLog g =ᵐ[circleMeasure] boundaryLog f := by
    filter_upwards [hgm, hmod] with t ht hft
    simp only [boundaryLog, ht, hft]
  have hP : poissonLog (boundaryLog g) 0 = poissonLog (boundaryLog f) 0 := by
    apply integral_congr_ae
    filter_upwards [hlogs] with t ht
    simp only [ht]
  have hgle := exponential_majorization g hg0 0 zero_mem_disk
  rw [hP, ← exponential_norm _ (boundary_log_integrable f hf).1 c hc 0 zero_mem_disk,
    ← ho zero_mem_disk] at hgle
  have hnormprod := congrArg norm (hp 0 zero_mem_disk)
  rw [norm_mul] at hnormprod
  have hgp : 0 < ‖eval g 0‖ := by
    apply norm_pos_iff.mpr
    intro hg
    exact ho0 (by rw [hp 0 zero_mem_disk, hg, mul_zero])
  have hj0 : ‖eval j 0‖ = 1 := by
    apply le_antisymm (inner_bound hj zero_mem_disk)
    nlinarith
  exact ⟨eval j 0, hj0, constant_of_norm_at_zero (Beurling.inner_norm hj) hj0⟩

lemma constant_productRange {j : H2} {a : ℂ} (ha : ‖a‖ = 1)
    (hj : j = lp.single 2 0 a) : ProductRange j = Set.univ := by
  have ha0 : a ≠ 0 := by intro h; simp [h] at ha
  apply Set.eq_univ_of_forall
  intro f
  refine ⟨a⁻¹ • f, ?_⟩
  intro z hz
  rw [hj, monomial_evaluation, pow_zero, mul_one, eval_smul]
  simp [ha0]

/-- Beurling converts the absence of nonconstant inner divisors into cyclicity. -/
theorem exponential_cyclicity : Spec.ExponentialCyclicity := by
  intro f hf c hc o ho
  obtain ⟨_, hnonzero, o', ho', hmod', _⟩ := factor_construction f hf c hc
  have heq : o = o' := evaluation_injective o o' (fun z hz =>
    (ho hz).trans (ho' hz).symm)
  have hmod : ∀ᵐ t ∂circleMeasure, ‖boundary o t‖ = ‖boundary f t‖ := by
    rwa [heq]
  have hone : o ≠ 0 := by
    intro h
    have hh := hnonzero 0 zero_mem_disk
    rw [← ho zero_mem_disk, h] at hh
    exact hh (by simp [HardyDiskSpec.eval])
  have hMne : cyclicSubspace o ≠ ⊥ := by
    intro h
    have hh := mem_cyclicSubspace o
    rw [h, Submodule.mem_bot] at hh
    exact hone hh
  obtain ⟨j, hj, hM⟩ := Beurling.classification (cyclicSubspace o)
    (Submodule.isClosed_topologicalClosure _) hMne (cyclicSubspace_invariant o)
  have hoM : o ∈ ProductRange j := by rw [← hM]; exact mem_cyclicSubspace o
  obtain ⟨g, hp⟩ := hoM
  obtain ⟨a, ha, hja⟩ := exponential_divisor_constant hf hc ho hmod hj hp
  change cyclicSubspace o = ⊤
  apply SetLike.coe_injective
  rw [hM, constant_productRange ha hja]
  rfl

/-- The bounded quotient has a genuine Hardy boundary function and is inner. -/
theorem factorization : Spec.Factorization := by
  intro f hf c hc
  obtain ⟨_, hnonzero, o, ho, hmod, hbound⟩ := factor_construction f hf c hc
  have hone : ∀ z ∈ disk, eval o z ≠ 0 := fun z hz => by rw [ho hz]; exact hnonzero z hz
  have hdiff : DifferentiableOn ℂ (fun z => eval f z / eval o z) disk :=
    (analytic_evaluation f).differentiableOn.div (analytic_evaluation o).differentiableOn hone
  let bval : Disk → ℂ := fun z => eval f z / eval o z
  let b : HInfinity := ⟨bval, hdiff.congr (fun z hz => by simp [HardyDiskSpec.zeroExtend, hz, bval]),
    1, fun z => by dsimp [bval]; rw [ho z.property]; exact hbound z z.property⟩
  obtain ⟨i, hi⟩ := bounded_analytic_coefficients b
  have hie : ∀ z ∈ disk, eval i z = eval f z / eval o z := fun z hz => hi ⟨z, hz⟩
  have hp : ∀ z ∈ disk, eval f z = eval i z * eval o z := by
    intro z hz
    rw [hie z hz, div_mul_cancel₀ _ (hone z hz)]
  have hbprod := boundary_mul_of_eval_mul hp
  have hbnz := (boundary_log_integrable f hf).2
  have hiinner : IsInner i := by
    refine ⟨⟨1, fun z hz => ?_⟩, ?_⟩
    · rw [hie z hz, ho hz]
      exact hbound z hz
    · filter_upwards [hbprod, hmod, hbnz] with t ht hmt hnzt
      have hpos : 0 < ‖boundary f t‖ := norm_pos_iff.mpr hnzt
      have hh := congrArg norm ht
      rw [norm_mul, hmt] at hh
      nlinarith
  exact ⟨i, o, hiinner, exponential_cyclicity f hf c hc o ho, hp, ho⟩

/-- Multiplication by an inner function carries a cyclic outer factor onto
exactly the closed cyclic subspace of the product. -/
lemma cyclic_product_range {f i o : H2} (hi : IsInner i) (ho : IsOuter o)
    (hp : ∀ z ∈ disk, eval f z = eval i z * eval o z) :
    (cyclicSubspace f : Set H2) = ProductRange i := by
  let T := Beurling.innerMul i hi
  let R := LinearMap.range T.toLinearMap
  have hf : T o = f := evaluation_injective _ _ (fun z hz =>
    (Beurling.innerMul_evaluation i hi o z hz).trans (hp z hz).symm)
  have hRclosed : IsClosed (R : Set H2) :=
    T.isometry.isUniformInducing.isComplete_range.isClosed
  have hle : cyclicSubspace f ≤ R := cyclicSubspace_minimal hRclosed
    (Beurling.inner_range_invariant i hi) ⟨o, hf⟩
  let N := (cyclicSubspace f).comap T.toLinearMap
  have hNclosed : IsClosed (N : Set H2) :=
    (Submodule.isClosed_topologicalClosure _).preimage T.continuous
  have hNinv : ShiftInvariant N := by
    intro g hg
    change T (shift g) ∈ cyclicSubspace f
    rw [Beurling.innerMul_shift]
    exact cyclicSubspace_invariant f (T g) hg
  have hoN : o ∈ N := by
    change T o ∈ cyclicSubspace f
    rw [hf]
    exact mem_cyclicSubspace f
  have hNtop : N = ⊤ := by
    apply top_unique
    have hh := cyclicSubspace_minimal hNclosed hNinv hoN
    change cyclicSubspace o = ⊤ at ho
    rwa [ho] at hh
  have heq : cyclicSubspace f = R := by
    apply le_antisymm hle
    rintro _ ⟨g, rfl⟩
    exact show g ∈ N from (hNtop ▸ Submodule.mem_top)
  rw [heq]
  exact Beurling.innerMul_range i hi

lemma inner_one : IsInner (lp.single 2 0 (1 : ℂ)) := by
  refine ⟨⟨1, fun z hz => ?_⟩, ?_⟩
  · rw [monomial_evaluation]
    simp
  · rw [BeurlingWandering.boundary_single, one_smul]
    filter_upwards [coeFn_fourierLp (T := 2 * π) 2 (0 : ℤ)] with t ht
    exact (congrArg norm ht).trans (HardyDisk.norm_fourier_point 0 t)

/-- A cyclic vector cannot lie in the range of multiplication by a
nonconstant inner function. -/
theorem no_inner_divisor : Spec.NoInnerDivisor := by
  intro o ho j hj g hp
  let T := Beurling.innerMul j hj
  let R := LinearMap.range T.toLinearMap
  have hRclosed : IsClosed (R : Set H2) :=
    T.isometry.isUniformInducing.isComplete_range.isClosed
  have hg : T g = o := evaluation_injective _ _ (fun z hz =>
    (Beurling.innerMul_evaluation j hj g z hz).trans (hp z hz).symm)
  have hle := cyclicSubspace_minimal hRclosed (Beurling.inner_range_invariant j hj)
    (show o ∈ R from ⟨g, hg⟩)
  change cyclicSubspace o = ⊤ at ho
  have hR : R = ⊤ := top_unique (by rwa [ho] at hle)
  have hr : ProductRange j = Set.univ := by
    rw [← Beurling.innerMul_range j hj]
    exact congrArg (fun M : Submodule ℂ H2 => (M : Set H2)) hR
  have hone : ProductRange (lp.single 2 0 (1 : ℂ)) = Set.univ :=
    constant_productRange (by simp) rfl
  obtain ⟨a, ha, hja⟩ := Beurling.uniqueness (lp.single 2 0 1) j inner_one hj
    (hone.trans hr.symm)
  refine ⟨a, ha, ?_⟩
  rw [hja, ← lp.single_smul]
  simp

/-- Uniqueness of the inner generator of the cyclic subspace fixes both factors. -/
theorem uniqueness : Spec.Uniqueness := by
  intro f i o j p _ hi ho hj hp hfi hfj
  have hr : ProductRange i = ProductRange j :=
    (cyclic_product_range hi ho hfi).symm.trans (cyclic_product_range hj hp hfj)
  obtain ⟨a, ha, hja⟩ := Beurling.uniqueness i j hi hj hr
  have ha0 : a ≠ 0 := by intro h; simp [h] at ha
  have h1 : Beurling.innerMul i hi o = f := evaluation_injective _ _ (fun z hz =>
    (Beurling.innerMul_evaluation i hi o z hz).trans (hfi z hz).symm)
  have h2 : Beurling.innerMul i hi (a • p) = f := by
    apply evaluation_injective
    intro z hz
    rw [innerMul_eval i hi (a • p) z hz, eval_smul, hfj z hz, hja, eval_smul]
    ring
  have hop : o = a • p := (Beurling.innerMul i hi).injective (h1.trans h2.symm)
  refine ⟨a, ha, hja, ?_⟩
  rw [hop, smul_smul, inv_mul_cancel₀ ha0, one_smul]

/-- The formula characterizes the outer factor even when it was initially
specified by cyclicity alone. -/
theorem outer_formula : Spec.OuterFormula := by
  intro f i o hf hi ho hp
  obtain ⟨j, p, hj, hpo, hprod, hformula⟩ := factorization f hf 1 (by simp)
  obtain ⟨a, ha, _, hoa⟩ := uniqueness f j p i o hf hj hpo hi ho hprod hp
  refine ⟨a⁻¹, by simp [ha], ?_⟩
  intro z hz
  rw [hoa, eval_smul, hformula hz]
  simp [exponentialFactor]

end ExpandedFA.PartIV.HardyInnerOuter
