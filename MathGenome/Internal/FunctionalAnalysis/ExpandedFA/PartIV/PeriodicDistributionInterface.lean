import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.PartIV.PeriodicDistributionInterface
import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.Distributions.TestFunctionLFTopology
import Mathlib.Topology.Instances.Int
import Mathlib.Topology.Algebra.Group.Pointwise
import Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension
import Mathlib.Analysis.Calculus.UniformLimitsDeriv

open Set TopologicalSpace Function Filter
open scoped Distributions BoundedContinuousFunction Pointwise Topology NNReal ContDiff

namespace ExpandedFA.PartIV.Periodic

open ExpandedFA.Distributions

variable {𝕜 : Type} [RCLike 𝕜] {d : ℕ}

/-- Distributions on the torus, with the smooth derivative topology. -/
def torusDistribution (𝕜 : Type) [RCLike 𝕜] (d : ℕ) : Type :=
  TorusDistribution 𝕜 d

/-- Distributions on ℝ^d invariant under the whole integer lattice. -/
def invariantDistribution (𝕜 : Type) [RCLike 𝕜] (d : ℕ) : Type :=
  InvariantDistribution 𝕜 d

@[simp] theorem integerVector_zero : integerVector (0 : Lattice d) = 0 := by
  ext i
  simp [integerVector]

@[simp] theorem integerVector_add (k l : Lattice d) :
    integerVector (k + l) = integerVector k + integerVector l := by
  ext i
  simp [integerVector]

@[simp] theorem integerVector_neg (k : Lattice d) :
    integerVector (-k) = -integerVector k := by
  ext i
  simp [integerVector]

@[simp] theorem quotient_add_integer (x : Domain d) (k : Lattice d) :
    quotient (x + integerVector k) = quotient x := by
  funext i
  change ((x i + (k i : ℝ) : ℝ) : AddCircle (1 : ℝ)) = (x i : AddCircle (1 : ℝ))
  rw [AddCircle.coe_add]
  have hk : (((k i : ℝ) : AddCircle (1 : ℝ))) = 0 :=
    (AddCircle.coe_eq_zero_iff (1 : ℝ)).mpr ⟨k i, by simp⟩
  rw [hk, add_zero]

@[simp] theorem lift_add_integer (φ : Smooth 𝕜 d) (x : Domain d) (k : Lattice d) :
    lift φ (x + integerVector k) = lift φ x := by
  simp [lift]

/-- Representatives in the half-open unit cube also belong to its closure. -/
noncomputable def representative (q : Torus d) : Domain d :=
  fun i => (AddCircle.equivIco (1 : ℝ) 0 (q i) : ℝ)

@[simp] theorem quotient_representative (q : Torus d) :
    quotient (representative q) = q := by
  funext i
  exact AddCircle.coe_equivIco

theorem representative_mem_cube (q : Torus d) : representative q ∈ cube d := by
  constructor
  · intro i
    exact (AddCircle.equivIco (1 : ℝ) 0 (q i)).property.1
  · intro i
    exact le_of_lt (by simpa [representative] using (AddCircle.equivIco (1 : ℝ) 0 (q i)).property.2)

theorem lift_injective : Injective (lift : Smooth 𝕜 d → Domain d → 𝕜) := by
  intro φ ψ h
  apply Subtype.ext
  funext q
  have hq := congrFun h (representative q)
  simpa only [lift, quotient_representative] using hq

/-- A continuous jet restriction; these maps define the topology. -/
noncomputable def jetCLM (m : ℕ) :
    Smooth 𝕜 d →L[𝕜] C(cube d, (Domain d) [×m]→L[ℝ] 𝕜) where
  toLinearMap := jetLM 𝕜 d m
  cont := continuous_iInf_dom continuous_induced_dom

theorem continuous_iff_jets {X : Type*} [TopologicalSpace X] (f : X → Smooth 𝕜 d) :
    Continuous f ↔ ∀ m, Continuous (jetLM 𝕜 d m ∘ f) := by
  simp only [continuous_iInf_rng, continuous_induced_rng]

/-- The defining topology is generated by the uniform derivative seminorms. -/
theorem smooth_seminorm_topology :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.seminormTopologyType := by
  intro 𝕜 _ d
  let p : SeminormFamily 𝕜 (Smooth 𝕜 d) ((_ : ℕ) × Unit) :=
    SeminormFamily.sigma fun m _ =>
      (normSeminorm 𝕜 C(cube d, (Domain d) [×m]→L[ℝ] 𝕜)).comp (jetLM 𝕜 d m)
  have hp : WithSeminorms p :=
    withSeminorms_iInf fun m => LinearMap.withSeminorms_induced (norm_withSeminorms _ _) _
  exact hp.congr_equiv (Equiv.sigmaUnique _ _).symm

theorem jet_zero_injective : Injective (jetLM 𝕜 d 0) := by
  intro φ ψ h
  apply Subtype.ext
  funext q
  have hq := congrArg (fun f : C(cube d, (Domain d) [×0]→L[ℝ] 𝕜) =>
    f ⟨representative q, representative_mem_cube q⟩ (fun i => Fin.elim0 i)) h
  simpa [jetLM, iteratedFDeriv_zero_eq_comp, lift] using hq

instance smoothT2Space : T2Space (Smooth 𝕜 d) :=
  T2Space.of_injective_continuous jet_zero_injective (jetCLM (𝕜 := 𝕜) (d := d) 0).continuous

/-- The integer lattice is a closed discrete subset of Euclidean space. -/
theorem integerVector_isClosedEmbedding :
    Topology.IsClosedEmbedding (integerVector : Lattice d → Domain d) :=
  Topology.IsClosedEmbedding.piMap fun _ => Int.isClosedEmbedding_coe_real

theorem finite_integerVectors_in_compact {K : Set (Domain d)} (hK : IsCompact K) :
    (integerVector ⁻¹' K : Set (Lattice d)).Finite :=
  (integerVector_isClosedEmbedding.isCompact_preimage hK).finite_of_discrete

/-- Uniformly over a compact set of base points, only finitely many lattice
translates of another compact set can meet it. -/
theorem finite_compact_translates {K L : Set (Domain d)}
    (hK : IsCompact K) (hL : IsCompact L) :
    {k : Lattice d | ∃ x ∈ L, x + integerVector k ∈ K}.Finite := by
  have h : IsCompact (K - L) := by
    rw [sub_eq_add_neg]
    exact hK.add hL.neg
  apply (finite_integerVectors_in_compact h).subset
  rintro k ⟨x, hx, hk⟩
  exact Set.mem_sub.mpr ⟨x + integerVector k, hk, x, hx, by simp⟩

/-- Compact support gives a locally finite family of translated supports. -/
theorem periodization_locally_finite :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.localFinitenessType := by
  intro 𝕜 _ d ψ x
  refine ⟨Metric.ball x 1, Metric.ball_mem_nhds _ zero_lt_one, ?_⟩
  apply (finite_compact_translates ψ.hasCompactSupport (isCompact_closedBall x 1)).subset
  rintro k ⟨y, hy, hyx⟩
  refine ⟨y, Metric.ball_subset_closedBall hyx, ?_⟩
  exact tsupport_comp_subset_preimage ψ (continuous_id.add continuous_const) hy

/-- Every value of the periodization is an actual finite sum. -/
theorem periodizeRaw_finiteSupport (ψ : EuclideanTests 𝕜 d) (x : Domain d) :
    (Function.support (fun k : Lattice d => ψ (x + integerVector k))).Finite := by
  apply (finite_compact_translates ψ.hasCompactSupport isCompact_singleton).subset
  intro k hk
  exact ⟨x, mem_singleton x, subset_tsupport _ hk⟩

/-- Reindexing by an integer translate proves periodicity, with the prescribed sign. -/
theorem periodizeRaw_add_integer (ψ : EuclideanTests 𝕜 d) (x : Domain d) (l : Lattice d) :
    periodizeRaw ψ (x + integerVector l) = periodizeRaw ψ x := by
  unfold periodizeRaw
  have h := finsum_comp_equiv (Equiv.addLeft l)
    (f := fun k : Lattice d => ψ (x + integerVector k))
  simpa only [Equiv.coe_addLeft, integerVector_add, add_assoc] using h

/-- The cutoff construction is scalar-linear in the smooth torus test. -/
noncomputable def cutoffLM (χ : EuclideanTests 𝕜 d) :
    Smooth 𝕜 d →ₗ[𝕜] EuclideanTests 𝕜 d where
  toFun := cutoffTest χ
  map_add' φ ψ := by
    apply TestFunction.ext
    intro x
    simp [cutoffTest, lift, mul_add]
  map_smul' c φ := by
    apply TestFunction.ext
    intro x
    simp [cutoffTest, lift, mul_left_comm]

/-- Multiplication by a periodic lift commutes with periodization. -/
theorem periodizeRaw_cutoffTest (χ : EuclideanTests 𝕜 d) (φ : Smooth 𝕜 d)
    (x : Domain d) :
    periodizeRaw (cutoffTest χ φ) x = periodizeRaw χ x * lift φ x := by
  unfold periodizeRaw
  simp only [cutoffTest, TestFunction.coe_mk, lift_add_integer]
  exact (finsum_mul (fun k : Lattice d => χ (x + integerVector k)) (lift φ x)).symm

/-- Any continuous periodization with the specified pointwise values is invariant. -/
theorem periodization_translate (P : EuclideanTests 𝕜 d →L[𝕜] Smooth 𝕜 d)
    (hP : ∀ ψ x, lift (P ψ) x = periodizeRaw ψ x)
    (k : Lattice d) (ψ : EuclideanTests 𝕜 d) :
    P (translateTest (integerVector k) ψ) = P ψ := by
  apply lift_injective
  funext x
  rw [hP, hP]
  have hraw : periodizeRaw (translateTest (integerVector k) ψ) x =
      periodizeRaw ψ (x + integerVector k) := by
    unfold periodizeRaw
    congr 1
    funext l
    change ψ ((x + integerVector l) + integerVector k) =
      ψ ((x + integerVector k) + integerVector l)
    congr 1
    ac_rfl
  rw [hraw]
  exact periodizeRaw_add_integer ψ x k

/-- The right inverse identity follows pointwise from `Pχ=1`. -/
theorem periodization_cutoff (P : EuclideanTests 𝕜 d →L[𝕜] Smooth 𝕜 d)
    (hP : ∀ ψ x, lift (P ψ) x = periodizeRaw ψ x)
    {χ : EuclideanTests 𝕜 d} (hχ : IsCutoff χ) (φ : Smooth 𝕜 d) :
    P (cutoffTest χ φ) = φ := by
  apply lift_injective
  funext x
  rw [hP, periodizeRaw_cutoffTest, hχ x, one_mul]

/-- A common finite summation set works throughout any prescribed compact set. -/
theorem periodizeRaw_eq_sum_on_compact (ψ : EuclideanTests 𝕜 d)
    {L : Set (Domain d)} (hL : IsCompact L) :
    ∃ s : Finset (Lattice d), ∀ x ∈ L,
      periodizeRaw ψ x = ∑ k ∈ s, ψ (x + integerVector k) := by
  classical
  let hs := finite_compact_translates ψ.hasCompactSupport hL
  refine ⟨hs.toFinset, ?_⟩
  intro x hx
  apply finsum_eq_sum_of_support_subset
  intro k hk
  exact hs.mem_toFinset.mpr ⟨x, hx, subset_tsupport _ hk⟩

/-- Local finiteness permits termwise smooth calculus without a convergence assumption. -/
theorem contDiff_periodizeRaw (ψ : EuclideanTests 𝕜 d) :
    ContDiff ℝ (⊤ : ℕ∞) (periodizeRaw ψ) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  obtain ⟨s, hs⟩ := periodizeRaw_eq_sum_on_compact ψ (isCompact_closedBall x 1)
  have heq : periodizeRaw ψ =ᶠ[𝓝 x] fun y => ∑ k ∈ s, ψ (y + integerVector k) := by
    filter_upwards [Metric.ball_mem_nhds x zero_lt_one] with y hy
    exact hs y (Metric.ball_subset_closedBall hy)
  have hsm : ContDiff ℝ (⊤ : ℕ∞) (fun y => ∑ k ∈ s, ψ (y + integerVector k)) :=
    ContDiff.sum fun _ _ => ψ.contDiff.comp (contDiff_id.add contDiff_const)
  exact hsm.contDiffAt.congr_of_eventuallyEq heq

/-- The representative of a projected point differs by an integer vector. -/
theorem representative_quotient (x : Domain d) :
    representative (quotient x) = x + integerVector (fun i => -⌊x i⌋) := by
  funext i
  simp [representative, quotient, integerVector, Int.fract, sub_eq_add_neg]

theorem periodizeRaw_representative (ψ : EuclideanTests 𝕜 d) (x : Domain d) :
    periodizeRaw ψ (representative (quotient x)) = periodizeRaw ψ x := by
  rw [representative_quotient, periodizeRaw_add_integer]

/-- Algebraic periodization as an actual smooth function on the quotient torus. -/
noncomputable def periodizationLM : EuclideanTests 𝕜 d →ₗ[𝕜] Smooth 𝕜 d where
  toFun ψ := ⟨fun q => periodizeRaw ψ (representative q), by
    change ContDiff ℝ (⊤ : ℕ∞) (fun x : Domain d =>
      periodizeRaw ψ (representative (quotient x)))
    simpa only [periodizeRaw_representative] using contDiff_periodizeRaw ψ⟩
  map_add' ψ ξ := by
    apply Subtype.ext
    funext q
    apply finsum_add_distrib (periodizeRaw_finiteSupport ψ _) (periodizeRaw_finiteSupport ξ _)
  map_smul' c ψ := by
    apply Subtype.ext
    funext q
    exact (smul_finsum c _).symm

@[simp] theorem lift_periodizationLM (ψ : EuclideanTests 𝕜 d) (x : Domain d) :
    lift (periodizationLM ψ) x = periodizeRaw ψ x :=
  periodizeRaw_representative ψ x

/-- Periodicity holds for every derivative of a smooth lifted test. -/
theorem iteratedFDeriv_lift_add_integer (φ : Smooth 𝕜 d) (m : ℕ)
    (x : Domain d) (k : Lattice d) :
    iteratedFDeriv ℝ m (lift φ) (x + integerVector k) = iteratedFDeriv ℝ m (lift φ) x := by
  have heq : (fun y => lift φ (y + integerVector k)) = lift φ :=
    funext fun y => lift_add_integer φ y k
  have h := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := lift φ) m (integerVector k) x
  rw [heq] at h
  exact h.symm

/-- A cube seminorm bounds the derivative everywhere, by integer periodicity. -/
theorem norm_iteratedFDeriv_lift_le (φ : Smooth 𝕜 d) (m : ℕ) (x : Domain d) :
    ‖iteratedFDeriv ℝ m (lift φ) x‖ ≤ derivativeSeminorm 𝕜 d m φ := by
  have heq : iteratedFDeriv ℝ m (lift φ) (representative (quotient x)) =
      iteratedFDeriv ℝ m (lift φ) x := by
    rw [representative_quotient, iteratedFDeriv_lift_add_integer]
  rw [← heq]
  exact (jetLM 𝕜 d m φ).norm_coe_le_norm
    ⟨representative (quotient x), representative_mem_cube _⟩

/-- The countable jet embedding also proves metrizability of the smooth topology. -/
theorem isUniformEmbedding_jets : IsUniformEmbedding
    (fun φ : Smooth 𝕜 d => fun m : ℕ => jetLM 𝕜 d m φ) where
  injective := fun φ ψ h => jet_zero_injective (congrFun h 0)
  toIsUniformInducing := by
    simp_rw [isUniformInducing_iff_uniformSpace, smoothUniformSpace,
      UniformSpace.replaceTopology_eq, Pi.uniformSpace_eq,
      UniformSpace.comap_iInf, ← UniformSpace.comap_comap]
    rfl

instance smoothMetrizableSpace : MetrizableSpace (Smooth 𝕜 d) :=
  (isUniformEmbedding_jets (𝕜 := 𝕜) (d := d)).isEmbedding.metrizableSpace

/-- A cutoff test lies in the fixed compact support of the cutoff itself. -/
noncomputable def cutoffStepLM (χ : EuclideanTests 𝕜 d) :
    Smooth 𝕜 d →ₗ[𝕜] Step 𝕜 (⟨tsupport χ, χ.hasCompactSupport⟩ : Compacts (Domain d)) where
  toFun φ := ContDiffMapSupportedIn.of_support_subset (χ.contDiff.mul (contDiff_lift φ))
    ((Function.support_mul_subset_left χ (lift φ)).trans (subset_tsupport χ))
  map_add' φ ψ := by
    apply ContDiffMapSupportedIn.ext
    intro x
    simp [mul_add, lift]
  map_smul' c φ := by
    apply ContDiffMapSupportedIn.ext
    intro x
    simp [lift, mul_left_comm]

/-- Multiplication by a fixed compact cutoff is continuous into one compact step. -/
theorem cutoffStepLM_continuous (χ : EuclideanTests 𝕜 d) :
    Continuous (cutoffStepLM χ) := by
  classical
  let K : Compacts (Domain d) := ⟨tsupport χ, χ.hasCompactSupport⟩
  let χK : Step 𝕜 K := ContDiffMapSupportedIn.of_support_subset χ.contDiff (subset_tsupport χ)
  let r := ContDiffMapSupportedIn.seminorm 𝕜 (Domain d) 𝕜 ⊤ K
  apply WithSeminorms.continuous_of_isBounded (smooth_seminorm_topology 𝕜 d)
    (ContDiffMapSupportedIn.withSeminorms 𝕜 (Domain d) 𝕜 ⊤ K) (cutoffStepLM χ)
  apply Seminorm.IsBounded.of_real
  intro m
  let C : ℝ := ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * r i χK
  refine ⟨Finset.range (m + 1), C, ?_⟩
  intro φ
  apply (ContDiffMapSupportedIn.seminorm_top_le_iff 𝕜 (by positivity) m _).mpr
  intro x _
  calc
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
        ‖iteratedFDeriv ℝ i χ x‖ * ‖iteratedFDeriv ℝ (m - i) (lift φ) x‖ :=
      norm_iteratedFDeriv_mul_le χ.contDiff (contDiff_lift φ) x (mod_cast le_top)
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
        r i χK * ((Finset.range (m + 1)).sup (derivativeSeminorm 𝕜 d)) φ := by
      apply Finset.sum_le_sum
      intro i hi
      apply mul_le_mul
      · exact mul_le_mul_of_nonneg_left
          (ContDiffMapSupportedIn.norm_iteratedFDeriv_apply_le_seminorm_top 𝕜
            (f := χK) (x := x)) (by positivity)
      · exact (norm_iteratedFDeriv_lift_le φ (m - i) x).trans
          (Seminorm.le_finset_sup_apply (Finset.mem_range.mpr
            (Nat.lt_succ_of_le (Nat.sub_le m i))))
      · exact norm_nonneg _
      · positivity
    _ = C * ((Finset.range (m + 1)).sup (derivativeSeminorm 𝕜 d)) φ := by
      rw [Finset.sum_mul]

/-- The fixed-support formulation required by the independent specification. -/
theorem cutoff_continuous :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.cutoffContinuityType := by
  intro 𝕜 _ d χ
  exact ⟨⟨cutoffStepLM χ, cutoffStepLM_continuous χ⟩, fun _ _ => rfl⟩

/-- The same cutoff map with codomain the LF test space. -/
noncomputable def cutoffCLM (χ : EuclideanTests 𝕜 d) :
    Smooth 𝕜 d →L[𝕜] EuclideanTests 𝕜 d where
  toLinearMap := cutoffLM χ
  cont := by
    let M : Smooth 𝕜 d →L[𝕜] Step 𝕜
        (⟨tsupport χ, χ.hasCompactSupport⟩ : Compacts (Domain d)) :=
      ⟨cutoffStepLM χ, cutoffStepLM_continuous χ⟩
    exact (TestFunction.continuous_ofSupportedIn (F := 𝕜) (n := ⊤)
      (show tsupport χ ⊆ (⊤ : Opens (Domain d)) from subset_univ _)).comp M.continuous

/-- Point evaluation used to commute finite sums of bundled tests with values. -/
noncomputable def testEvaluation (x : Domain d) : EuclideanTests 𝕜 d →ₗ[𝕜] 𝕜 where
  toFun ψ := ψ x
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem finsum_test_apply {ι : Type*} {f : ι → EuclideanTests 𝕜 d}
    (hf : Function.HasFiniteSupport f) (x : Domain d) :
    (∑ᶠ k, f k) x = ∑ᶠ k, f k x :=
  (testEvaluation x).toAddMonoidHom.map_finsum hf

/-- Two compact tests give finitely many nonzero product tests as one is translated. -/
noncomputable def translatedProduct (χ ψ : EuclideanTests 𝕜 d) (k : Lattice d) :
    EuclideanTests 𝕜 d where
  toFun x := χ x * ψ (x + integerVector k)
  contDiff' := χ.contDiff.mul (ψ.contDiff.comp (contDiff_id.add contDiff_const))
  hasCompactSupport' := χ.hasCompactSupport.mul_right
  tsupport_subset' := subset_univ _

theorem translatedProduct_finiteSupport (χ ψ : EuclideanTests 𝕜 d) :
    Function.HasFiniteSupport (translatedProduct χ ψ) := by
  classical
  apply (finite_compact_translates ψ.hasCompactSupport χ.hasCompactSupport).subset
  intro k hk
  have hne : ∃ x, χ x * ψ (x + integerVector k) ≠ 0 := by
    by_contra! h
    apply hk
    apply TestFunction.ext
    intro x
    exact h x
  obtain ⟨x, hx⟩ := hne
  exact ⟨x, subset_tsupport _ (left_ne_zero_of_mul hx),
    subset_tsupport _ (right_ne_zero_of_mul hx)⟩

/-- The finite-sum identity behind the inverse construction. No continuity of
periodization is assumed in this purely algebraic identity. -/
theorem invariant_periodization_cutoff (u : InvariantDistribution 𝕜 d)
    (χ : EuclideanTests 𝕜 d) (hχ : IsCutoff χ) (ψ : EuclideanTests 𝕜 d) :
    u.val (cutoffTest χ (periodizationLM ψ)) = u.val ψ := by
  classical
  let f : Lattice d → EuclideanTests 𝕜 d := translatedProduct χ ψ
  let g : Lattice d → EuclideanTests 𝕜 d :=
    fun k => translateTest (integerVector (-k)) (f k)
  have hf : Function.HasFiniteSupport f := translatedProduct_finiteSupport χ ψ
  have hg : Function.HasFiniteSupport g := by
    apply hf.subset
    intro k hk
    contrapose! hk
    simp only [Function.mem_support, not_not] at hk ⊢
    apply TestFunction.ext
    intro x
    change f k (x + integerVector (-k)) = 0
    rw [hk]
    rfl
  have hleft : (∑ᶠ k, f k) = cutoffTest χ (periodizationLM ψ) := by
    apply TestFunction.ext
    intro x
    rw [finsum_test_apply hf x]
    change (∑ᶠ k, χ x * ψ (x + integerVector k)) =
      χ x * lift (periodizationLM ψ) x
    rw [lift_periodizationLM]
    exact (mul_finsum _ _).symm
  have hgval (k : Lattice d) (x : Domain d) :
      g k x = χ (x + integerVector (-k)) * ψ x := by
    change χ (x + integerVector (-k)) * ψ ((x + integerVector (-k)) + integerVector k) = _
    simp [add_assoc]
  have hright : (∑ᶠ k, g k) = ψ := by
    apply TestFunction.ext
    intro x
    rw [finsum_test_apply hg x]
    change (∑ᶠ k, g k x) = ψ x
    simp_rw [hgval]
    rw [← finsum_mul]
    have hneg := finsum_comp_equiv (Equiv.neg (Lattice d))
      (f := fun k : Lattice d => χ (x + integerVector k))
    change (∑ᶠ k, χ (x + integerVector (-k))) = periodizeRaw χ x at hneg
    rw [hneg, hχ x, one_mul]
  calc
    u.val (cutoffTest χ (periodizationLM ψ)) = u.val (∑ᶠ k, f k) := congrArg u.val hleft.symm
    _ = ∑ᶠ k, u.val (f k) := u.val.toLinearMap.toAddMonoidHom.map_finsum hf
    _ = ∑ᶠ k, u.val (g k) := by
      congr 1
      funext k
      exact (u.property (-k) (f k)).symm
    _ = u.val (∑ᶠ k, g k) := (u.val.toLinearMap.toAddMonoidHom.map_finsum hg).symm
    _ = u.val ψ := congrArg u.val hright

/-- Normalized cutoffs give the same functional on every smooth torus test. -/
theorem cutoff_independent :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.cutoffIndependenceType := by
  intro 𝕜 _ d χ ξ hχ hξ u φ
  have hφ : periodizationLM (cutoffTest χ φ) = φ := by
    apply lift_injective
    funext x
    rw [lift_periodizationLM, periodizeRaw_cutoffTest, hχ x, one_mul]
  have h := invariant_periodization_cutoff u ξ hξ (cutoffTest χ φ)
  rw [hφ] at h
  exact h.symm

/-- Derivatives commute with the locally finite periodization sum. -/
theorem iteratedFDeriv_periodizeRaw (ψ : EuclideanTests 𝕜 d) (m : ℕ) (x : Domain d) :
    iteratedFDeriv ℝ m (periodizeRaw ψ) x =
      ∑ᶠ k : Lattice d, iteratedFDeriv ℝ m ψ (x + integerVector k) := by
  classical
  let hs := finite_compact_translates ψ.hasCompactSupport (isCompact_closedBall x 1)
  let s := hs.toFinset
  have heq : periodizeRaw ψ =ᶠ[𝓝 x] fun y => ∑ k ∈ s, ψ (y + integerVector k) := by
    filter_upwards [Metric.ball_mem_nhds x zero_lt_one] with y hy
    apply finsum_eq_sum_of_support_subset
    intro k hk
    exact hs.mem_toFinset.mpr
      ⟨y, Metric.ball_subset_closedBall hy, subset_tsupport _ hk⟩
  have hderiv := (heq.iteratedFDeriv ℝ m).self_of_nhds
  rw [hderiv, iteratedFDeriv_fun_sum_apply]
  · simp_rw [iteratedFDeriv_comp_add_right (𝕜 := ℝ)]
    symm
    apply finsum_eq_sum_of_support_subset
    intro k hk
    exact hs.mem_toFinset.mpr ⟨x, Metric.mem_closedBall_self zero_le_one,
      support_iteratedFDeriv_subset m hk⟩
  · intro k _
    exact ((ψ.contDiff.comp (contDiff_id.add contDiff_const)).of_le (mod_cast le_top)).contDiffAt

theorem compact_subset_univ (K : Compacts (Domain d)) :
    (K : Set (Domain d)) ⊆ (⊤ : Opens (Domain d)) := subset_univ _

/-- On a fixed compact test step, each output derivative seminorm is bounded by
one input derivative seminorm, with the finite number of relevant translates. -/
theorem periodization_step_jet_bound (K : Compacts (Domain d)) (m : ℕ) :
    ∃ C : ℝ≥0, ∀ φ : Step 𝕜 K,
      ‖jetLM 𝕜 d m (periodizationLM (TestFunction.ofSupportedIn (compact_subset_univ K) φ))‖ ≤
        C * ContDiffMapSupportedIn.seminorm 𝕜 (Domain d) 𝕜 ⊤ K m φ := by
  classical
  let hs := finite_compact_translates K.isCompact
    (isCompact_Icc : IsCompact (cube d))
  let s := hs.toFinset
  refine ⟨s.card, ?_⟩
  intro φ
  apply (ContinuousMap.norm_le _ (by positivity)).mpr
  intro x
  change ‖iteratedFDeriv ℝ m
      (lift (periodizationLM (TestFunction.ofSupportedIn (compact_subset_univ K) φ))) x‖ ≤ _
  have hlift : lift (periodizationLM (TestFunction.ofSupportedIn (compact_subset_univ K) φ)) =
      periodizeRaw (TestFunction.ofSupportedIn (compact_subset_univ K) φ) :=
    funext fun y => lift_periodizationLM _ y
  rw [hlift, iteratedFDeriv_periodizeRaw]
  have hsum : (∑ᶠ k : Lattice d, iteratedFDeriv ℝ m φ (x + integerVector k)) =
      ∑ k ∈ s, iteratedFDeriv ℝ m φ (x + integerVector k) := by
    apply finsum_eq_sum_of_support_subset
    intro k hk
    exact hs.mem_toFinset.mpr ⟨x, x.property,
      φ.tsupport_subset (support_iteratedFDeriv_subset m hk)⟩
  change ‖∑ᶠ k : Lattice d, iteratedFDeriv ℝ m φ (x + integerVector k)‖ ≤ _
  rw [hsum]
  calc
    _ ≤ ∑ k ∈ s, ‖iteratedFDeriv ℝ m φ (x + integerVector k)‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ s, ContDiffMapSupportedIn.seminorm 𝕜 (Domain d) 𝕜 ⊤ K m φ := by
      apply Finset.sum_le_sum
      intro k _
      exact ContDiffMapSupportedIn.norm_iteratedFDeriv_apply_le_seminorm_top 𝕜
    _ = _ := by simp

/-- Continuity for the full LF topology, proved on all compact steps. -/
theorem periodizationLM_continuous :
    Continuous (periodizationLM (𝕜 := 𝕜) (d := d)) := by
  apply (TestFunction.continuous_iff_continuous_comp
    ((periodizationLM (𝕜 := 𝕜) (d := d)).restrictScalars ℝ)).mpr
  intro K hK
  apply (continuous_iff_jets _).mpr
  intro m
  let v : Step 𝕜 K →ₗ[𝕜] C(cube d, (Domain d) [×m]→L[ℝ] 𝕜) :=
    (jetLM 𝕜 d m).comp (periodizationLM.comp (TestFunction.ofSupportedInCLM 𝕜 hK).toLinearMap)
  obtain ⟨C, hC⟩ := periodization_step_jet_bound (𝕜 := 𝕜) K m
  change Continuous v
  apply WithSeminorms.continuous_normedSpace_rng (𝕝₂ := 𝕜)
    C(cube d, (Domain d) [×m]→L[ℝ] 𝕜)
    (ContDiffMapSupportedIn.withSeminorms 𝕜 (Domain d) 𝕜 ⊤ K) v
  refine ⟨{m}, C, ?_⟩
  intro φ
  change ‖v φ‖ ≤ (C : ℝ) *
    (({m} : Finset ℕ).sup (ContDiffMapSupportedIn.seminorm 𝕜 (Domain d) 𝕜 ⊤ K)) φ
  have hv : v φ = jetLM 𝕜 d m
      (periodizationLM (TestFunction.ofSupportedIn (compact_subset_univ K) φ)) := by
    apply congrArg (jetLM 𝕜 d m)
    apply congrArg periodizationLM
    apply TestFunction.ext
    intro x
    rfl
  rw [hv]
  simpa only [Finset.sup_singleton] using hC φ

/-- Continuous periodization with the literal `∑ ψ(x+k)` formula. -/
noncomputable def periodizationCLM : EuclideanTests 𝕜 d →L[𝕜] Smooth 𝕜 d :=
  ⟨periodizationLM, periodizationLM_continuous⟩

theorem periodization_exists :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.periodizationType := by
  intro 𝕜 _ d
  exact ⟨periodizationCLM, lift_periodizationLM⟩

/-- A nonnegative compact bump equal to one on the closed unit cube. -/
noncomputable def initialCutoff (d : ℕ) : EuclideanTests ℝ d where
  toFun := (default : ContDiffBump (0 : Domain d))
  contDiff' := ContDiffBump.contDiff _
  hasCompactSupport' := ContDiffBump.hasCompactSupport _
  tsupport_subset' := subset_univ _

theorem initialCutoff_nonneg (x : Domain d) : 0 ≤ initialCutoff d x :=
  ContDiffBump.nonneg _

theorem initialCutoff_eq_one {x : Domain d} (hx : x ∈ cube d) : initialCutoff d x = 1 := by
  apply ContDiffBump.one_of_mem_closedBall
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg zero_le_one).mpr
  intro i
  rw [Real.norm_eq_abs, abs_of_nonneg (hx.1 i)]
  exact hx.2 i

theorem le_periodizeRaw_of_nonneg (η : EuclideanTests ℝ d)
    (hη : ∀ x, 0 ≤ η x) (x : Domain d) : η x ≤ periodizeRaw η x := by
  classical
  let hf := periodizeRaw_finiteSupport η x
  let s := insert (0 : Lattice d) hf.toFinset
  have hsum : periodizeRaw η x = ∑ k ∈ s, η (x + integerVector k) := by
    apply finsum_eq_sum_of_support_subset
    intro k hk
    exact Finset.mem_insert_of_mem (hf.mem_toFinset.mpr hk)
  rw [hsum]
  have h := Finset.single_le_sum (s := s) (fun k _ => hη (x + integerVector k))
    (Finset.mem_insert_self (0 : Lattice d) hf.toFinset)
  simpa only [integerVector_zero, add_zero] using h

theorem periodize_initialCutoff_pos (x : Domain d) :
    0 < periodizeRaw (initialCutoff d) x := by
  rw [← periodizeRaw_representative (initialCutoff d) x]
  have h := le_periodizeRaw_of_nonneg (initialCutoff d) initialCutoff_nonneg
    (representative (quotient x))
  rw [initialCutoff_eq_one (representative_mem_cube _)] at h
  exact zero_lt_one.trans_le h

/-- The positive periodic denominator normalizes the compact smooth bump. -/
theorem exists_real_cutoff (d : ℕ) : ∃ χ : EuclideanTests ℝ d, IsCutoff χ := by
  let η := initialCutoff d
  let χ : EuclideanTests ℝ d :=
    { toFun := fun x => η x / periodizeRaw η x
      contDiff' := η.contDiff.div (contDiff_periodizeRaw η)
        (fun x => (periodize_initialCutoff_pos x).ne')
      hasCompactSupport' := by
        apply η.hasCompactSupport.mono
        intro x hx
        change η x ≠ 0
        intro heq
        exact hx (by simp [heq])
      tsupport_subset' := subset_univ _ }
  refine ⟨χ, ?_⟩
  intro x
  change (∑ᶠ k : Lattice d, η (x + integerVector k) /
    periodizeRaw η (x + integerVector k)) = 1
  simp_rw [periodizeRaw_add_integer, div_eq_mul_inv]
  rw [← finsum_mul]
  change periodizeRaw η x / periodizeRaw η x = 1
  exact div_self (periodize_initialCutoff_pos x).ne'

/-- A normalized cutoff exists over both ℝ and ℂ, including dimension zero. -/
theorem normalized_cutoff_exists :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.cutoffExistenceType := by
  intro 𝕜 _ d
  obtain ⟨χ, hχ⟩ := exists_real_cutoff d
  let ξ : EuclideanTests 𝕜 d :=
    TestFunction.postcompCLM (RCLike.ofRealCLM : ℝ →L[ℝ] 𝕜) χ
  refine ⟨ξ, ?_⟩
  intro x
  have h := (RCLike.ofRealCLM : ℝ →L[ℝ] 𝕜).toLinearMap.toAddMonoidHom.map_finsum
    (periodizeRaw_finiteSupport χ x)
  calc
    periodizeRaw ξ x = RCLike.ofReal (periodizeRaw χ x) := h.symm
    _ = 1 := by rw [hχ x]; simp

/-- Pull back a torus distribution along continuous periodization. -/
noncomputable def pullbackDistribution (U : TorusDistribution 𝕜 d) :
    InvariantDistribution 𝕜 d :=
  ⟨U.comp periodizationCLM, fun k ψ => by
    change U (periodizationCLM (translateTest (integerVector k) ψ)) = U (periodizationCLM ψ)
    rw [periodization_translate periodizationCLM lift_periodizationLM]⟩

/-- Descend an invariant distribution by multiplication with a normalized cutoff. -/
noncomputable def descendDistribution (χ : EuclideanTests 𝕜 d)
    (u : InvariantDistribution 𝕜 d) : TorusDistribution 𝕜 d :=
  u.val.comp (cutoffCLM χ)

/-- The two concrete constructions are inverse. -/
noncomputable def periodicDistributionEquiv (χ : EuclideanTests 𝕜 d) (hχ : IsCutoff χ) :
    TorusDistribution 𝕜 d ≃ₗ[𝕜] InvariantDistribution 𝕜 d where
  toFun := pullbackDistribution
  invFun := descendDistribution χ
  left_inv U := by
    apply ContinuousLinearMap.ext
    intro φ
    change U (periodizationCLM (cutoffTest χ φ)) = U φ
    rw [periodization_cutoff periodizationCLM lift_periodizationLM hχ]
  right_inv u := by
    apply Subtype.ext
    apply ContinuousLinearMap.ext
    intro ψ
    exact invariant_periodization_cutoff u χ hχ ψ
  map_add' U V := by
    apply Subtype.ext
    apply ContinuousLinearMap.ext
    intro ψ
    rfl
  map_smul' c U := by
    apply Subtype.ext
    apply ContinuousLinearMap.ext
    intro ψ
    rfl

/-- Canonical correspondence, including the inverse formula for every cutoff. -/
theorem distribution_correspondence :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.correspondenceType := by
  intro 𝕜 _ d
  obtain ⟨χ, hχ⟩ := normalized_cutoff_exists 𝕜 d
  refine ⟨periodizationCLM, periodicDistributionEquiv χ hχ,
    lift_periodizationLM, fun _ _ => rfl, ?_⟩
  intro ξ hξ u φ
  exact cutoff_independent 𝕜 d χ ξ hχ hξ u φ

/-- The concrete product torus is the quotient by the full integer lattice. -/
theorem quotient_identification :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.quotientType := by
  classical
  intro d
  refine ⟨fun q => ⟨representative q, quotient_representative q⟩, ?_⟩
  intro x y
  constructor
  · intro h
    have hi (i : Fin d) : ∃ n : ℤ, (n : ℝ) = y i - x i := by
      have hz : (((y i - x i : ℝ) : AddCircle (1 : ℝ))) = 0 := by
        rw [AddCircle.coe_sub]
        exact sub_eq_zero.mpr (congrFun h i).symm
      simpa only [zsmul_eq_mul, mul_one] using (AddCircle.coe_eq_zero_iff (1 : ℝ)).mp hz
    choose k hk using hi
    refine ⟨k, ?_⟩
    funext i
    change y i = x i + (k i : ℝ)
    linarith [hk i]
  · rintro ⟨k, rfl⟩
    exact (quotient_add_integer x k).symm

section UniformLimits
variable {E F ι : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F]
  {l : Filter ι} [NeBot l]

set_option backward.isDefEq.respectTransparency false in
/-- Uniform limits of all derivatives are the derivatives of a smooth limit. -/
theorem contDiff_limit_of_tendstoUniformly_iteratedFDeriv
    (f : ι → E → F) (g : (m : ℕ) → E → E [×m]→L[ℝ] F)
    (hf : ∀ i, ContDiff ℝ (⊤ : ℕ∞) (f i))
    (hg : ∀ m, TendstoUniformly (fun i => iteratedFDeriv ℝ m (f i)) (g m) l) :
    ContDiff ℝ (⊤ : ℕ∞) (fun x => g 0 x 0) ∧
      ∀ m, iteratedFDeriv ℝ m (fun x => g 0 x 0) = g m := by
  have hderiv (m : ℕ) (x : E) : HasFDerivAt (g m)
      (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => E) F (g (m + 1) x)) x := by
    refine hasFDerivAt_of_tendstoUniformly (f := fun i => iteratedFDeriv ℝ m (f i))
      ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => E) F).toLinearIsometry.isometry.uniformContinuous
        |>.comp_tendstoUniformly (hg (m + 1))) ?_ ?_ x
    · intro i y
      convert ((hf i).differentiable_iteratedFDeriv (m := m) (mod_cast ENat.natCast_lt_top m)).differentiableAt.hasFDerivAt using 1
      rfl
    · intro y
      exact (hg m).tendsto_at y
  let h : E → F := fun x => g 0 x 0
  have hjet (m : ℕ) : iteratedFDeriv ℝ m h = g m := by
    induction m with
    | zero =>
      funext x
      simpa only [h, iteratedFDeriv_zero_eq_comp, Function.comp_apply,
        ← continuousMultilinearCurryFin0_apply] using
        (continuousMultilinearCurryFin0 ℝ E F).symm_apply_apply (g 0 x)
    | succ m ih =>
      funext x
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply, ih, (hderiv m x).fderiv]
      exact (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (m + 1) => E) F).symm_apply_apply _
  refine ⟨?_, hjet⟩
  apply contDiff_of_differentiable_iteratedFDeriv (n := ⊤)
  intro m _
  rw [hjet m]
  exact fun x => (hderiv m x).differentiableAt
end UniformLimits

theorem uniformContinuous_jet (m : ℕ) : UniformContinuous (jetLM 𝕜 d m) :=
  uniformContinuous_pi.mp (isUniformEmbedding_jets (𝕜 := 𝕜) (d := d)).toIsUniformInducing.uniformContinuous m

/-- Extend a compatible cube jet periodically; compatibility is proved below
from uniform limits, including at the faces of the cube. -/
noncomputable def jetExtension (J : (m : ℕ) → C(cube d, (Domain d) [×m]→L[ℝ] 𝕜))
    (m : ℕ) (x : Domain d) : (Domain d) [×m]→L[ℝ] 𝕜 :=
  J m ⟨representative (quotient x), representative_mem_cube _⟩

theorem uniform_jet_limits {l : Filter (Smooth 𝕜 d)}
    (J : (m : ℕ) → C(cube d, (Domain d) [×m]→L[ℝ] 𝕜))
    (hJ : ∀ m, Tendsto (jetLM 𝕜 d m) l (𝓝 (J m))) (m : ℕ) :
    TendstoUniformly (fun φ => iteratedFDeriv ℝ m (lift φ)) (jetExtension J m) l := by
  have h := ContinuousMap.tendsto_iff_tendstoUniformly.mp (hJ m)
  rw [Metric.tendstoUniformly_iff] at h ⊢
  intro ε hε
  filter_upwards [h ε hε] with φ hφ x
  have hx := hφ ⟨representative (quotient x), representative_mem_cube _⟩
  change dist (jetExtension J m x)
    (iteratedFDeriv ℝ m (lift φ) (representative (quotient x))) < ε at hx
  rwa [representative_quotient, iteratedFDeriv_lift_add_integer] at hx

theorem jetExtension_eq_on_cube {l : Filter (Smooth 𝕜 d)} [NeBot l]
    (J : (m : ℕ) → C(cube d, (Domain d) [×m]→L[ℝ] 𝕜))
    (hJ : ∀ m, Tendsto (jetLM 𝕜 d m) l (𝓝 (J m))) (m : ℕ) (x : cube d) :
    jetExtension J m x = J m x := by
  apply tendsto_nhds_unique (uniform_jet_limits J hJ m |>.tendsto_at x)
  exact ((continuous_eval_const x).tendsto (J m)).comp (hJ m)

theorem limit_from_compatible_jets {l : Filter (Smooth 𝕜 d)} [NeBot l]
    (J : (m : ℕ) → C(cube d, (Domain d) [×m]→L[ℝ] 𝕜))
    (hJ : ∀ m, Tendsto (jetLM 𝕜 d m) l (𝓝 (J m)))
    (hsm : ContDiff ℝ (⊤ : ℕ∞) (fun x => jetExtension J 0 x 0))
    (hderiv : ∀ m, iteratedFDeriv ℝ m (fun x => jetExtension J 0 x 0) = jetExtension J m) :
    ∃ φ : Smooth 𝕜 d, l ≤ 𝓝 φ := by
  let φ : Smooth 𝕜 d := ⟨fun q => J 0 ⟨representative q, representative_mem_cube q⟩ 0, hsm⟩
  have hjet (m : ℕ) : jetLM 𝕜 d m φ = J m := by
    apply ContinuousMap.ext
    intro x
    change iteratedFDeriv ℝ m (fun y => jetExtension J 0 y 0) x = J m x
    rw [hderiv]
    exact jetExtension_eq_on_cube J hJ m x
  have ht : Tendsto (id : Smooth 𝕜 d → Smooth 𝕜 d) l (𝓝 φ) := by
    apply (isUniformEmbedding_jets (𝕜 := 𝕜) (d := d)).isEmbedding.tendsto_nhds_iff.mpr
    apply tendsto_pi_nhds.mpr
    intro m
    simpa only [Function.comp_def, id_eq, hjet m] using hJ m
  exact ⟨φ, by simpa only [Tendsto, map_id] using ht⟩

/-- Every Cauchy filter converges for the original uniform derivative topology. -/
instance smoothCompleteSpace : CompleteSpace (Smooth 𝕜 d) where
  complete {l} hl := by
    have : NeBot l := hl.1
    have hlim (m : ℕ) : ∃ J : C(cube d, (Domain d) [×m]→L[ℝ] 𝕜),
        Tendsto (jetLM 𝕜 d m) l (𝓝 J) :=
      CompleteSpace.complete (hl.map (uniformContinuous_jet m))
    obtain ⟨J, hJ⟩ := Classical.skolem.mp hlim
    obtain ⟨hsm, hderiv⟩ := contDiff_limit_of_tendstoUniformly_iteratedFDeriv
      (fun φ : Smooth 𝕜 d => lift φ) (jetExtension J) contDiff_lift
      (uniform_jet_limits J hJ)
    exact limit_from_compatible_jets J hJ hsm hderiv

theorem smooth_topology_properties :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.smoothTopologyPropertiesType := by
  intro 𝕜 _ d
  exact ⟨inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩

@[simp] theorem coordinateJetLM_apply {k : ℕ} (a : Fin k → Fin d)
    (φ : Smooth 𝕜 d) (x : cube d) :
    coordinateJetLM 𝕜 d a φ x =
      iteratedFDeriv ℝ k (lift φ) x (fun j => coordinateVector (a j)) := rfl

@[simp] theorem coordinateJetSeminorm_apply {k : ℕ} (a : Fin k → Fin d)
    (φ : Smooth 𝕜 d) :
    coordinateJetSeminorm 𝕜 d a φ = ‖coordinateJetLM 𝕜 d a φ‖ := rfl

theorem coordinateJet_le_partial {k m : ℕ} (a : Fin k → Fin d) (hk : k ≤ m) :
    coordinateJetSeminorm 𝕜 d a ≤ smoothPartialSeminorm 𝕜 d m := by
  unfold smoothPartialSeminorm
  exact le_trans (Finset.le_sup (Finset.mem_univ a))
    (Finset.le_sup (f := fun j => Finset.univ.sup (coordinateJetSeminorm 𝕜 d (k := j)))
      (Finset.mem_range.mpr (Nat.lt_succ_of_le hk)))

theorem smooth_partial_formula :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.partialFormulaType := by
  intro 𝕜 _ d m φ C hC
  constructor
  · intro h k hk a x hx
    calc
      _ = ‖coordinateJetLM 𝕜 d a φ ⟨x, hx⟩‖ := rfl
      _ ≤ ‖coordinateJetLM 𝕜 d a φ‖ := ContinuousMap.norm_coe_le_norm _ _
      _ ≤ smoothPartialSeminorm 𝕜 d m φ := coordinateJet_le_partial a hk φ
      _ ≤ C := h
  · intro h
    apply Seminorm.finset_sup_apply_le hC
    intro k hk
    apply Seminorm.finset_sup_apply_le hC
    intro a _
    rw [coordinateJetSeminorm_apply]
    apply (ContinuousMap.norm_le _ hC).mpr
    intro x
    exact h k (Nat.le_of_lt_succ (Finset.mem_range.mp hk)) a x x.property

/-- Coordinate partials are bounded by the operator derivative seminorm. -/
theorem coordinateJetSeminorm_le_derivative {k : ℕ} (a : Fin k → Fin d) :
    coordinateJetSeminorm 𝕜 d a ≤ derivativeSeminorm 𝕜 d k := by
  intro φ
  rw [coordinateJetSeminorm_apply]
  apply (ContinuousMap.norm_le _ (apply_nonneg _ _)).mpr
  intro x
  calc
    _ ≤ ‖iteratedFDeriv ℝ k (lift φ) x‖ * ∏ j, ‖coordinateVector (a j)‖ :=
      ContinuousMultilinearMap.le_opNorm _ _
    _ = ‖iteratedFDeriv ℝ k (lift φ) x‖ := by simp [coordinateVector, Pi.norm_single]
    _ ≤ derivativeSeminorm 𝕜 d k φ := (jetLM 𝕜 d k φ).norm_coe_le_norm x

/-- The reverse finite-coordinate bound also covers d=0 and derivative order zero. -/
theorem derivativeSeminorm_le_partial (k : ℕ) :
    derivativeSeminorm 𝕜 d k ≤ ((d : ℝ≥0) ^ k) • smoothPartialSeminorm 𝕜 d k := by
  intro φ
  apply (ContinuousMap.norm_le _ (by positivity)).mpr
  intro x
  apply ExpandedFA.Distributions.norm_multilinear_le_coordinate_bound _ _ (apply_nonneg _ _)
  intro a
  calc
    _ = ‖coordinateJetLM 𝕜 d a φ x‖ := rfl
    _ ≤ ‖coordinateJetLM 𝕜 d a φ‖ := ContinuousMap.norm_coe_le_norm _ _
    _ ≤ smoothPartialSeminorm 𝕜 d k φ := coordinateJet_le_partial a le_rfl φ

/-- The concrete topology is exactly the usual C∞ partial-derivative topology. -/
theorem smooth_partial_topology :
    Specs.ExpandedFA.PartIV.PeriodicDistributionInterface.partialTopologyType := by
  intro 𝕜 _ d
  apply (smooth_seminorm_topology 𝕜 d).congr
  · intro m
    refine ⟨Finset.range (m + 1), 1, ?_⟩
    rw [one_smul]
    change smoothPartialSeminorm 𝕜 d m ≤ _
    unfold smoothPartialSeminorm
    apply Finset.sup_le
    intro k hk
    apply Finset.sup_le
    intro a _
    exact (coordinateJetSeminorm_le_derivative a).trans (Finset.le_sup hk)
  · intro k
    refine ⟨{k}, (d : ℝ≥0) ^ k, ?_⟩
    rw [Finset.sup_singleton]
    exact derivativeSeminorm_le_partial k

end ExpandedFA.PartIV.Periodic
