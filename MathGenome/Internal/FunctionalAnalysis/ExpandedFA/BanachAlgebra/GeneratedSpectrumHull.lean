import MathGenome.Internal.FunctionalAnalysis.ExpandedFA.BanachAlgebra.SpectralPermanence
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.BanachAlgebra.GeneratedSpectrumHull
import Mathlib.Analysis.Normed.Operator.Extend
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-!
The spectrum in every closed subalgebra is contained in the polynomial hull of
the ambient spectrum, by the upstream spectral-radius argument. For the reverse
inclusion in the singly generated algebra, polynomial evaluation at a hull point
is bounded by the inherited norm. Extend it along the dense polynomial image;
continuity preserves multiplication. Applying the resulting character to the
generator proves that the hull point is spectral. This avoids Runge approximation.
-/

namespace ExpandedFA.BanachAlgebra.GeneratedSpectrumHull

open Polynomial
open scoped Topology
universe u

variable {A : Type u} [NormedRing A] [NormedAlgebra ℂ A]

/-- Polynomial values are dense in the closed singly generated algebra. -/
theorem denseRange_aeval_elemental (a : A) :
    DenseRange (aeval (R := ℂ) (⟨a, Algebra.elemental.self_mem ℂ a⟩ : Algebra.elemental ℂ a)) := by
  intro x
  rw [closure_subtype]
  have hr : Subtype.val '' Set.range
      (aeval (R := ℂ) (⟨a, Algebra.elemental.self_mem ℂ a⟩ : Algebra.elemental ℂ a)) =
      (Algebra.adjoin ℂ {a} : Set A) := by
    rw [Algebra.adjoin_singleton_eq_range_aeval, AlgHom.coe_range, ← Set.range_comp]
    congr 1
    funext p
    exact (aeval_algHom_apply (Algebra.elemental ℂ a).val _ p).symm
  rw [hr]
  exact x.property

/-- A norm-bounded polynomial evaluation extends to a character of the closure.
The bound also ensures that evaluation respects every polynomial relation of `a`. -/
theorem exists_character_of_polynomial_bound (a : A) (z : ℂ)
    (hb : ∀ p : Polynomial ℂ, ‖p.eval z‖ ≤ ‖aeval a p‖) :
    ∃ χ : Algebra.elemental ℂ a →ₐ[ℂ] ℂ,
      χ (⟨a, Algebra.elemental.self_mem ℂ a⟩ : Algebra.elemental ℂ a) = z := by
  let b : Algebra.elemental ℂ a := ⟨a, Algebra.elemental.self_mem ℂ a⟩
  let e : Polynomial ℂ →ₐ[ℂ] Algebra.elemental ℂ a := aeval b
  let f : Polynomial ℂ →ₐ[ℂ] ℂ := aeval z
  have hd : DenseRange e := denseRange_aeval_elemental a
  have hbound : ∃ C : ℝ, ∀ p : Polynomial ℂ, ‖f p‖ ≤ C * ‖e p‖ := by
    refine ⟨1, fun p => ?_⟩
    have hc : ((e p : Algebra.elemental ℂ a) : A) = aeval a p :=
      (aeval_algHom_apply (Algebra.elemental ℂ a).val b p).symm
    change ‖(aeval z) p‖ ≤ 1 * ‖((e p : Algebra.elemental ℂ a) : A)‖
    rw [one_mul, hc]
    simpa [aeval_def] using hb p
  let F : Algebra.elemental ℂ a →L[ℂ] ℂ := f.toLinearMap.extendOfNorm e.toLinearMap
  have hF (p : Polynomial ℂ) : F (e p) = f p :=
    LinearMap.extendOfNorm_eq hd hbound p
  have hmul (x y : Algebra.elemental ℂ a) : F (x * y) = F x * F y := by
    refine hd.induction_on₂ (p := fun x y => F (x * y) = F x * F y)
      (isClosed_eq (by fun_prop) (by fun_prop)) ?_ x y
    intro p q
    rw [← map_mul e, hF, hF, hF, map_mul f]
  have hone : F 1 = 1 := by
    rw [← map_one e, hF, map_one f]
  let χ : Algebra.elemental ℂ a →ₐ[ℂ] ℂ :=
    { toFun := F
      map_zero' := F.map_zero
      map_add' := F.map_add
      map_one' := hone
      map_mul' := hmul
      commutes' := fun c => by
        change F (algebraMap ℂ (Algebra.elemental ℂ a) c) = algebraMap ℂ ℂ c
        rw [Algebra.algebraMap_eq_smul_one, F.map_smul, hone]
        simp }
  refine ⟨χ, ?_⟩
  have hx := hF X
  simpa [e, f, χ, b] using hx

/-- In the closed unital algebra generated by `a`, the spectrum fills the
polynomial hull of the ambient spectrum. -/
theorem generated_spectrum_hull :
    Specs.ExpandedFA.BanachAlgebra.GeneratedSpectrumHull.SpectrumHullEquality.{u} := by
  intro A _ _ hA a
  let : CompleteSpace A := hA.1
  let : Nontrivial A := hA.2.1
  let : NormOneClass A := hA.2.2
  let B := Algebra.elemental ℂ a
  let b : B := ⟨a, Algebra.elemental.self_mem ℂ a⟩
  change spectrum ℂ b = polynomialHull (spectrum ℂ a)
  apply Set.Subset.antisymm
  · intro z hz p M hM
    exact polynomial_bound_subalgebra B b z hz p M hM
  · intro z hz
    have hb (p : Polynomial ℂ) : ‖p.eval z‖ ≤ ‖aeval a p‖ := by
      apply hz p
      intro w hw
      apply spectrum.norm_le_norm_of_mem
      rw [spectrum.map_polynomial_aeval]
      exact ⟨w, hw, rfl⟩
    obtain ⟨χ, hχ⟩ := exists_character_of_polynomial_bound a z hb
    rw [← hχ]
    exact AlgHom.apply_mem_spectrum χ b

/-- The entire permanence and polynomial hull proposition. -/
theorem permanence_and_polynomial_hull :
    Specs.ExpandedFA.BanachAlgebra.GeneratedSpectrumHull.PermanenceAndPolynomialHull.{u} :=
  ⟨subalgebra_spectrum_inclusion, subalgebra_spectrum_boundary_inclusion,
    subalgebra_spectrum_polynomial_hulls, subalgebra_spectrum_components,
    generated_spectrum_hull⟩

end ExpandedFA.BanachAlgebra.GeneratedSpectrumHull
