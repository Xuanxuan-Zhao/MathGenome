import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C04Annihilators
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C04CanonicalMap
import Mathlib.Topology.Algebra.Module.Spaces.WeakDual

/-! Independent statements for `fa2:p2:banach-adjoint`, paper.tex 9432–9460.
The duals are the continuous scalar-linear duals, with their operator norms.
Weak-star continuity uses the topology generated by all evaluations on the
specified original spaces. All clauses hold for arbitrary normed spaces,
including zero spaces; the preadjoint criterion assumes neither completeness
of either space nor norm continuity of the given linear map S. -/

namespace ExpandedFA.Compactness.BanachAdjoints.Spec

universe u v w

/-- The shared Banach transpose is a bounded scalar-linear map with the
required composition formula. Boundedness is part of its bundled type. -/
def TransposeEvaluation : Prop :=
  ∀ (𝕜 : Type u) (X : Type v) (Y : Type w) [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedAddCommGroup Y]
    [NormedSpace 𝕜 X] [NormedSpace 𝕜 Y]
    (T : X →L[𝕜] Y) (f : Y →L[𝕜] 𝕜) (x : X),
    P1.C04Annihilators.Spec.BanachTransposeValue 𝕜 X Y T f x = f (T x)

def TransposeNorm : Prop :=
  ∀ (𝕜 : Type u) (X : Type v) (Y : Type w) [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedAddCommGroup Y]
    [NormedSpace 𝕜 X] [NormedSpace 𝕜 Y] (T : X →L[𝕜] Y),
    ‖P1.C04Annihilators.Spec.BanachTransposeValue 𝕜 X Y T‖ = ‖T‖

/-- Equality of bounded maps X → Y″, using exactly the shared canonical
maps J_X, J_Y and the second scalar-linear transpose. -/
def BidualNaturality : Prop :=
  ∀ (𝕜 : Type u) (X : Type v) (Y : Type w) [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedAddCommGroup Y]
    [NormedSpace 𝕜 X] [NormedSpace 𝕜 Y] (T : X →L[𝕜] Y),
    (P1.C04Annihilators.Spec.BanachTransposeValue 𝕜 (Y →L[𝕜] 𝕜) (X →L[𝕜] 𝕜)
      (P1.C04Annihilators.Spec.BanachTransposeValue 𝕜 X Y T)).comp
        (P1.C04CanonicalMap.Spec.CanonicalEvaluationValue 𝕜 X) =
      (P1.C04CanonicalMap.Spec.CanonicalEvaluationValue 𝕜 Y).comp T

/-- S is initially only algebraically scalar-linear. The type changes
below equip its domain and codomain with σ(Y′,Y) and σ(X′,X). -/
def PreadjointCriterion : Prop :=
  ∀ (𝕜 : Type u) (X : Type v) (Y : Type w) [RCLike 𝕜]
    [NormedAddCommGroup X] [NormedAddCommGroup Y]
    [NormedSpace 𝕜 X] [NormedSpace 𝕜 Y]
    (S : (Y →L[𝕜] 𝕜) →ₗ[𝕜] (X →L[𝕜] 𝕜)),
    (∃ T : X →L[𝕜] Y,
      (P1.C04Annihilators.Spec.BanachTransposeValue 𝕜 X Y T).toLinearMap = S) ↔
      Continuous (fun f : WeakDual 𝕜 Y =>
        StrongDual.toWeakDual (S (WeakDual.toStrongDual f)))

end ExpandedFA.Compactness.BanachAdjoints.Spec
