import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Analysis.Normed.Module.Basic
import Mathlib.Analysis.Normed.Group.Constructions
import Mathlib.Analysis.Normed.Group.Submodule
import Mathlib.Analysis.Normed.Operator.LinearIsometry
import Mathlib.Data.Finset.Powerset
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Topology.ContinuousMap.Compact

/-! Canonical finite Walsh objects for paper.tex, lines 12679–12685 and 12721–12725.
Boolean coordinates identify `false` with 0 and `true` with 1. Finite real-valued
function spaces carry Mathlib's maximum (supremum) norm. -/
noncomputable section

namespace ExpandedFA.AP.Walsh
open scoped BigOperators

abbrev Cube (n : ℕ) := Fin (2 * n) → Bool
abbrev Functions (n : ℕ) := Cube n → ℝ

/-- A Walsh character, in its source formula. -/
def character (n : ℕ) (S : Finset (Fin (2 * n))) (a : Cube n) : ℝ :=
  (-1 : ℝ) ^ (∑ j ∈ S, if a j then 1 else 0)

/-- The subsets of coordinates of cardinality `r`. -/
def level (n r : ℕ) : Finset (Finset (Fin (2 * n))) :=
  Finset.univ.powersetCard r

def levelSum (n r : ℕ) : Functions n := ∑ S ∈ level n r, character n S

def levelSize (n : ℕ) : ℕ := (2 * n).choose (n - 1)

def difference (n : ℕ) : Functions n :=
  (levelSize n : ℝ)⁻¹ • (levelSum n (n - 1) - levelSum n (n + 1))

/-- The real span with the inherited supremum norm. -/
def block (n : ℕ) : Submodule ℝ (Functions n) :=
  Submodule.span ℝ {f | ∃ S, (S ∈ level n (n - 1) ∨ S ∈ level n (n + 1)) ∧
    f = character n S}

/-- Addition modulo two, realized by coordinatewise exclusive-or. -/
def translation (n : ℕ) (b : Cube n) : Equiv.Perm (Cube n) where
  toFun a j := xor (a j) (b j)
  invFun a j := xor (a j) (b j)
  left_inv a := by funext j; dsimp; cases a j <;> cases b j <;> rfl
  right_inv a := by funext j; dsimp; cases a j <;> cases b j <;> rfl

/-- Permutation of the coordinates, acting covariantly on points. -/
def coordinatePermutation (n : ℕ) (σ : Equiv.Perm (Fin (2 * n))) :
    Equiv.Perm (Cube n) where
  toFun a j := a (σ.symm j)
  invFun a j := a (σ j)
  left_inv a := by ext j; simp
  right_inv a := by ext j; simp

/-- The actual finite group generated by translations and coordinate permutations. -/
def symmetryGroup (n : ℕ) : Subgroup (Equiv.Perm (Cube n)) :=
  Subgroup.closure (Set.range (translation n) ∪ Set.range (coordinatePermutation n))

/-- Pullback by the inverse permutation is a left action on functions. -/
def pullback (n : ℕ) (g : Equiv.Perm (Cube n)) (f : Functions n) : Functions n :=
  fun a => f (g.symm a)

end ExpandedFA.AP.Walsh

namespace Specs.ExpandedFA.AP.WalshBlocks
open ExpandedFA.AP.Walsh
open scoped BigOperators

-- Definition contracts retain values, as well as types.
def CubeType := ℕ → Type
def CubeValue : CubeType := Cube
def characterType := ∀ n, Finset (Fin (2 * n)) → Cube n → ℝ
def characterValue : characterType := character
def levelType := ∀ n, ℕ → Finset (Finset (Fin (2 * n)))
def levelValue : levelType := level
def levelSumType := ∀ n, ℕ → Functions n
def levelSumValue : levelSumType := levelSum
def levelSizeType := ℕ → ℕ
def levelSizeValue : levelSizeType := levelSize
def differenceType := ∀ n, Functions n
def differenceValue : differenceType := difference
def blockType := ∀ n, Submodule ℝ (Functions n)
def blockValue : blockType := block
def symmetryGroupType := ∀ n, Subgroup (Equiv.Perm (Cube n))
def symmetryGroupValue : symmetryGroupType := symmetryGroup

/-- The finite function model is isometrically the source's `C(H_n; ℝ)`,
with the discrete topology on the cube and identical pointwise values. -/
def continuousFunctionModel : Prop := ∀ n,
  letI : TopologicalSpace (Cube n) := ⊥
  ∃ e : Functions n ≃ₗᵢ[ℝ] C(Cube n, ℝ), ∀ f a, e f a = f a

/-- The scalar product for uniform probability, with the exact normalization. -/
def characterOrthonormal : Prop := ∀ n (S T : Finset (Fin (2 * n))),
  (Fintype.card (Cube n) : ℝ)⁻¹ * ∑ a : Cube n, character n S a * character n T a =
    if S = T then 1 else 0

def adjacentLevelSizes : Prop := ∀ n, 2 ≤ n →
  (level n (n - 1)).card = levelSize n ∧
  (level n (n + 1)).card = levelSize n

/-- The Walsh difference belongs to the block on which the group acts. -/
def differenceMembership : Prop := ∀ n, difference n ∈ block n

/-- A concrete finite group of isometries acting by the prescribed pullback. -/
def isometricAction : Prop := ∀ n, 2 ≤ n →
  Finite (symmetryGroup n) ∧
  ∃ U : symmetryGroup n →* ((block n) ≃ₗᵢ[ℝ] (block n)),
    ∀ g f a, ((U g f : block n) : Functions n) a =
      (f : Functions n) ((g : Equiv.Perm (Cube n)).symm a)

end Specs.ExpandedFA.AP.WalshBlocks
