import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.VonNeumann.SeparableMASA
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.SpectralMeasure.NormalSpectral

/-!
The normal-operator part of `fa2:p2:abelian-von-neumann`, paper.tex
12082–12143. The MASA and general separating-vector assertions are supplied
by SeparableMASA. Here H is separable, but may be zero. The measure is on the
actual spectrum with its Borel sigma algebra. L∞ and L¹ are native Lp spaces,
so equivalence classes, including all completed-measure classes, are retained.
The algebra is the concrete double commutant of the unital star algebra
generated by N. The topology assertion concerns the entire algebra.
-/
noncomputable section
open MeasureTheory Set
open scoped ENNReal InnerProductSpace

namespace ExpandedFA.VonNeumann.NormalAlgebraControlMeasure.Spec
universe u v
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The concrete von Neumann algebra generated by N. The double-commutant
 theorem identifies this with the WOT closure of the generated star algebra. -/
def normalAlgebra (N : H →L[ℂ] H) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  StarSubalgebra.centralizer ℂ
    (StarSubalgebra.centralizer ℂ
      (StarAlgebra.adjoin ℂ ({N} : Set (H →L[ℂ] H)) : Set (H →L[ℂ] H)) :
      Set (H →L[ℂ] H))

/-- Null ideals agree on all Borel sets; finiteness is asserted separately. -/
def IsControlMeasure {S : Type v} [MeasurableSpace S]
    (E : SpectralMeasure.ProjectionValuedMeasure S H) (μ : Measure S) : Prop :=
  ∀ B : Set S, MeasurableSet B → (E B = 0 ↔ μ B = 0)

/-- The bilinear, unconjugated L∞–L¹ pairing ∫ f g dμ. -/
def pairing {S : Type v} [MeasurableSpace S] (μ : Measure S)
    (f : Lp ℂ ∞ μ) (g : Lp ℂ 1 μ) : ℂ :=
  (ContinuousLinearMap.mul ℂ ℂ).lpPairing μ ∞ 1 f g

/-- Exactly σ(L∞,L¹), defined by all its scalar tests. -/
def weakStarTopology {S : Type v} [MeasurableSpace S] (μ : Measure S) :
    TopologicalSpace (Lp ℂ ∞ μ) :=
  .induced (fun f g => pairing μ f g) Pi.topologicalSpace

/-- Native Lp has bilinear Hölder multiplication. This is the pointwise
product on L∞ equivalence classes, without installing a second ring instance. -/
def product {S : Type v} [MeasurableSpace S] (μ : Measure S)
    (f g : Lp ℂ ∞ μ) : Lp ℂ ∞ μ :=
  (ContinuousLinearMap.mul ℂ ℂ).holder ∞ f g

/-- Both directions of the asserted equality with the bounded Borel calculus. -/
def BorelImage (N : H →L[ℂ] H)
    (Φ : ((spectrum ℂ N) → ℂ) → H →L[ℂ] H) : Prop :=
  ∀ T : H →L[ℂ] H, T ∈ normalAlgebra N ↔
    ∃ f : spectrum ℂ N → ℂ, SpectralMeasure.Spec.IsBoundedMeasurable f ∧ Φ f = T

/-- An isometric star-algebra identification, explicitly expressed using
native L∞ multiplication. Every L∞ class has a bounded Borel representative,
and the identification is the stated spectral calculus on every such
representative. A bijective multiplicative linear map onto this unital
algebra automatically preserves the identity, also for the zero algebra. -/
def IsCalculusIsomorphism (N : H →L[ℂ] H)
    (Φ : ((spectrum ℂ N) → ℂ) → H →L[ℂ] H) (μ : Measure (spectrum ℂ N))
    (Ψ : Lp ℂ ∞ μ ≃ₗ[ℂ] normalAlgebra N) : Prop :=
  (∀ f g, Ψ (product μ f g) = Ψ f * Ψ g) ∧
  (∀ f, Ψ (star f) = star (Ψ f)) ∧
  (∀ f, ‖Ψ f‖ = ‖f‖) ∧
  (∀ h : Lp ℂ ∞ μ, ∃ f : spectrum ℂ N → ℂ,
    SpectralMeasure.Spec.IsBoundedMeasurable f ∧ f =ᵐ[μ] h) ∧
  (∀ (h : Lp ℂ ∞ μ) (f : spectrum ℂ N → ℂ),
    SpectralMeasure.Spec.IsBoundedMeasurable f → f =ᵐ[μ] h →
      (Ψ h : H →L[ℂ] H) = Φ f)

/-- Equality of the defining functionals, with exact identities for all f.
The reverse direction says every L¹ test is one coefficient, not just a
limit of coefficients. No norm-bounded restriction occurs. -/
def CoefficientFunctionals (N : H →L[ℂ] H) (μ : Measure (spectrum ℂ N))
    (Ψ : Lp ℂ ∞ μ ≃ₗ[ℂ] normalAlgebra N) : Prop :=
  (∀ x y : H, ∃ g : Lp ℂ 1 μ,
    ∀ f : Lp ℂ ∞ μ, ⟪x, (Ψ f : H →L[ℂ] H) y⟫_ℂ = pairing μ f g) ∧
  (∀ g : Lp ℂ 1 μ, ∃ x y : H,
    ∀ f : Lp ℂ ∞ μ, pairing μ f g = ⟪x, (Ψ f : H →L[ℂ] H) y⟫_ℂ)

/-- The finite control measure can be chosen as a vector spectral measure.
This is useful independently of the algebra identification. -/
def FiniteControlMeasure : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (N : H →L[ℂ] H), IsStarNormal N →
    ∃ (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
      (e : H) (μ : Measure (spectrum ℂ N)),
      SpectralMeasure.NormalPVM.Spec.Resolves N E ∧ IsFiniteMeasure μ ∧
      (∀ B, MeasurableSet B → μ B = ENNReal.ofReal (‖E B e‖ ^ 2)) ∧
      IsControlMeasure E μ

/-- Full assigned result. All objects and all conclusions refer to one
resolution and one finite measure, on the actual spectrum of N. -/
def NormalAlgebraControlMeasure : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [TopologicalSpace.SeparableSpace H] (N : H →L[ℂ] H), IsStarNormal N →
    ∃ (E : SpectralMeasure.ProjectionValuedMeasure (spectrum ℂ N) H)
      (Φ : ((spectrum ℂ N) → ℂ) → H →L[ℂ] H)
      (μ : Measure (spectrum ℂ N)) (hμ : IsFiniteMeasure μ),
      SpectralMeasure.NormalPVM.Spec.Resolves N E ∧
      SpectralMeasure.BorelNormSpectrum.Spec.BorelCalculus E Φ ∧
      Φ (fun z => (z : ℂ)) = N ∧ IsControlMeasure E μ ∧ BorelImage N Φ ∧
      ∃ Ψ : Lp ℂ ∞ μ ≃ₗ[ℂ] normalAlgebra N,
        IsCalculusIsomorphism N Φ μ Ψ ∧ CoefficientFunctionals N μ Ψ ∧
        weakStarTopology μ = TopologicalSpace.induced
          (fun f => (Ψ f : H →L[ℂ] H)) (OperatorTopology.Spec.WeakTopologyValue ℂ H H)

end ExpandedFA.VonNeumann.NormalAlgebraControlMeasure.Spec
