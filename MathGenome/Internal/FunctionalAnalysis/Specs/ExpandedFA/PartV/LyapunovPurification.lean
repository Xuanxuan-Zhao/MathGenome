import Mathlib.MeasureTheory.Function.LpSpace.Basic
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.Analysis.Convex.Extreme

/-!
# Finite-dimensional Lyapunov purification

Independent statements for the purification stage of `fa2:p5:lyapunov`,
paper.tex:23389–23414. The measure is finite, positive and atomless in the
measure-algebra sense (not merely zero on singletons). All coordinates and
all convex combinations are real. Dimension zero and the zero measure are
included. No countable generation or completeness of the measurable space
is imposed. The topology on L∞ is σ(L∞,L¹), generated by its integral tests.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal
universe u

namespace ExpandedFA.PartV.LyapunovPurification.Spec

/-- Atomlessness, stated on measurable sets. For a finite measure this says
exactly that every measurable positive set has a measurable proper split of
positive mass on both sides. This is stronger than null singletons. -/
def Atomless {X : Type u} [MeasurableSpace X] (μ : Measure X) : Prop :=
  ∀ s : Set X, MeasurableSet s → 0 < μ s →
    ∃ t : Set X, MeasurableSet t ∧ t ⊆ s ∧ 0 < μ t ∧ μ t < μ s

/-- The integral-test topology, i.e. σ(L∞(μ),L¹(μ)). L¹ and L∞ here
are the usual quotients by μ-a.e. equality. -/
@[instance_reducible] def densityWeakStarTopology {X : Type u} [MeasurableSpace X] (μ : Measure X) :
    TopologicalSpace (Lp ℝ ∞ μ) :=
  ⨅ f : Lp ℝ 1 μ,
    TopologicalSpace.induced (fun g : Lp ℝ ∞ μ => ∫ x, g x * f x ∂μ) inferInstance

/-- The closed order interval 0 ≤ g ≤ 1 with the indicated finite list of
moments fixed. Coordinates h need only be integrable, not bounded. -/
def densityFiber {X : Type u} [MeasurableSpace X] (μ : Measure X)
    {n : ℕ} (h : Fin n → X → ℝ) (b : Fin n → ℝ) : Set (Lp ℝ ∞ μ) :=
  {g | (∀ᵐ x ∂μ, 0 ≤ g x ∧ g x ≤ 1) ∧
    ∀ j, (∫ x, g x * h j x ∂μ) = b j}

/-- Real convexity of the moment fiber, for an arbitrary positive measure. -/
def FiberConvex : Prop :=
  ∀ {X : Type u} [MeasurableSpace X] {μ : Measure X}
    {n : ℕ} (h : Fin n → X → ℝ), (∀ j, Integrable (h j) μ) →
    ∀ b : Fin n → ℝ, Convex ℝ (densityFiber μ h b)

/-- All fibers, empty ones included, are weak-star compact. -/
def CompactFiber : Prop :=
  ∀ {X : Type u} [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ]
    {n : ℕ} (h : Fin n → X → ℝ), (∀ j, Integrable (h j) μ) →
    ∀ b : Fin n → ℝ,
      @IsCompact (Lp ℝ ∞ μ) (densityWeakStarTopology μ) (densityFiber μ h b)

/-- A nonempty fiber has an extreme point; no atomlessness is needed for
this functional-analytic stage. Extremality uses real convex combinations. -/
def FiberExtremePoint : Prop :=
  ∀ {X : Type u} [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ]
    {n : ℕ} (h : Fin n → X → ℝ), (∀ j, Integrable (h j) μ) →
    ∀ b : Fin n → ℝ, (densityFiber μ h b).Nonempty →
      (Set.extremePoints ℝ (densityFiber μ h b)).Nonempty

/-- The finite-dimensional, atomless bang-bang step: an extreme member of
a moment fiber is represented by the indicator of an ordinary measurable
set, even when the original measure space is not complete. -/
def ExtremeIsIndicator : Prop :=
  ∀ {X : Type u} [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ],
    Atomless μ → ∀ {n : ℕ} (h : Fin n → X → ℝ),
    (∀ j, Integrable (h j) μ) → ∀ (b : Fin n → ℝ) (g : Lp ℝ ∞ μ),
      g ∈ Set.extremePoints ℝ (densityFiber μ h b) →
      ∃ s : Set X, MeasurableSet s ∧ g =ᵐ[μ] s.indicator (fun _ => (1 : ℝ))

/-- Purify any fractional density, stated with a.e. bounds so that it
applies directly to L∞ equivalence classes. The output set is measurable,
not merely measurable in the completion. -/
def Purification : Prop :=
  ∀ {X : Type u} [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ],
    Atomless μ → ∀ {n : ℕ} (h : Fin n → X → ℝ),
    (∀ j, Integrable (h j) μ) → ∀ g : X → ℝ,
      AEStronglyMeasurable g μ → (∀ᵐ x ∂μ, 0 ≤ g x ∧ g x ≤ 1) →
      ∃ s : Set X, MeasurableSet s ∧
        ∀ j, (∫ x in s, h j x ∂μ) = ∫ x, g x * h j x ∂μ

/-- Conditional assembly interface; the unconditional result is `Purification`. -/
def PurificationFromExtremeExistence : Prop :=
  FiberExtremePoint.{u} → Purification.{u}

end ExpandedFA.PartV.LyapunovPurification.Spec
