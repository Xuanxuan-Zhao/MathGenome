import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C12WeakStar

/-!
Independent statements of Banach–Alaoglu, `fa2:p1:c13:alaoglu`
(paper.tex 2517–2522, with arbitrary centers explained in its proof).

The continuous scalar-linear dual and its operator norm are formed with the
original norm topology on E. Compactness is measured in exactly the shared
weak-star topology generated by evaluation at every vector of E. The scalar
norm is absolute value on ℝ and modulus on ℂ. No completeness, separability,
or nonzero-space hypothesis is imposed. Real radii are finite; radius zero
and arbitrary centers are included.
-/

namespace ExpandedFA.P1.C13Alaoglu.Spec

universe u v

/-- The closed unit ball of the continuous linear dual is weak-star compact. -/
def UnitBallCompactness : Prop :=
  ∀ (𝕜 : Type u) (E : Type v) [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E],
    @IsCompact (E →L[𝕜] 𝕜)
      (C12WeakStar.Spec.WeakStarTopologyValue 𝕜 E)
      {f : E →L[𝕜] 𝕜 | ‖f‖ ≤ 1}

/-- Closed dual norm balls of every nonnegative finite radius are compact
in σ(E′,E), including radius zero and every center. -/
def ClosedBallCompactness : Prop :=
  ∀ (𝕜 : Type u) (E : Type v) [RCLike 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]
    (f₀ : E →L[𝕜] 𝕜) (r : ℝ), 0 ≤ r →
    @IsCompact (E →L[𝕜] 𝕜)
      (C12WeakStar.Spec.WeakStarTopologyValue 𝕜 E)
      {f : E →L[𝕜] 𝕜 | ‖f - f₀‖ ≤ r}

end ExpandedFA.P1.C13Alaoglu.Spec
