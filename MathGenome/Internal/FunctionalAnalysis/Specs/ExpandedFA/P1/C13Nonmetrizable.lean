import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C02HilbertSum
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C01SequenceSpaces
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C13ConverseMetric
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.P1.C13Alaoglu

/-! Independent statements for fa2:p1:c13:nonmetrizable (paper.tex 2650–2662).
All sequence spaces retain the shared native norms. The topology on ℓ∞ is
explicitly σ(ℓ∞,ℓ¹), generated by the bilinear series evaluations, also over ℂ.
No norm separability of the dual is assumed in the metrization conclusion. -/

noncomputable section
open scoped Classical
open TopologicalSpace
universe u v
namespace ExpandedFA.P1.C13Nonmetrizable.Spec
open ExpandedFA.P1.C01SequenceSpaces

/-- Scalar Hilbert sum with the existing square-sum norm. -/
abbrev L2 (𝕜 : Type v) [RCLike 𝕜] (I : Type u) :=
  C02HilbertSum.Spec.Space (fun _ : I => 𝕜)

/-- The uncountable-index Hilbert example and its actual dual unit ball. -/
def UncountableL2Example : Prop :=
  ∀ (I : Type u) (𝕜 : Type v) [RCLike 𝕜], ¬ Countable I →
    ¬ SeparableSpace (L2 𝕜 I) ∧
    @IsCompact (L2 𝕜 I →L[𝕜] 𝕜)
      (C12WeakStar.Spec.WeakStarTopologyValue 𝕜 (L2 𝕜 I))
      {f | ‖f‖ ≤ 1} ∧
    ¬ C13ConverseMetric.Spec.BallMetrizable 𝕜 (L2 𝕜 I)

def L1Separable : Prop :=
  ∀ (𝕜 : Type u) [RCLike 𝕜], SeparableSpace (SequenceLp 𝕜 1)

/-- All binary sequences form an uncountable family at mutual sup-distance one. -/
def BinarySequenceWitness : Prop :=
  ∀ (𝕜 : Type u) [RCLike 𝕜],
    ∃ b : Set ℕ → SequenceLInfinity 𝕜,
      (∀ A n, b A n = if n ∈ A then 1 else 0) ∧
      (∀ A, ‖b A‖ ≤ 1) ∧
      (∀ A B, A ≠ B → dist (b A) (b B) = 1) ∧
      ¬ (Set.range b).Countable

/-- Norm nonseparability of ℓ∞ and of the continuous dual of ℓ¹. -/
def LInfinityNonseparable : Prop :=
  ∀ (𝕜 : Type u) [RCLike 𝕜],
    ¬ SeparableSpace (SequenceLInfinity 𝕜) ∧
    ¬ SeparableSpace (SequenceLp 𝕜 1 →L[𝕜] 𝕜)

/-- Initial topology of precisely the ℓ¹ pairing, using the original bounded
sequence carrier and the absolutely convergent series. -/
@[instance_reducible]
def lInfinityWeakStarTopology (𝕜 : Type u) [RCLike 𝕜] :
    TopologicalSpace (SequenceLInfinity 𝕜) :=
  ⨅ x : SequenceLp 𝕜 1,
    TopologicalSpace.induced (fun a : SequenceLInfinity 𝕜 => ∑' n, a n * x n)
      inferInstance

def LInfinityBallMetrizable : Prop :=
  ∀ (𝕜 : Type u) [RCLike 𝕜],
    @MetrizableSpace (Metric.closedBall (0 : SequenceLInfinity 𝕜) 1)
      (TopologicalSpace.induced Subtype.val (lInfinityWeakStarTopology 𝕜))

end ExpandedFA.P1.C13Nonmetrizable.Spec
