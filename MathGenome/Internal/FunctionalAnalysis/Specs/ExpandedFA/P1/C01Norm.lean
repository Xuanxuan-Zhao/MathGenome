import Mathlib.Analysis.Normed.Module.Basic
import Mathlib.Analysis.Normed.Module.Seminorm.Basic
import Mathlib.Analysis.RCLike.Basic

/-!
The independent interface for Definition `fa2:p1:c01:norm` (paper.tex, lines 115–125).
The scalar norm is the absolute value on `ℝ` and the modulus on `ℂ`; `RCLike`
includes both. No nontriviality or completeness of the vector space is required.
-/

namespace ExpandedFA.P1.C01Norm

variable {𝕜 E : Type*}

/-- The manuscript seminorm axioms on the given vector space. The value at zero
is forced by absolute homogeneity, rather than imposed as an extra hypothesis. -/
def SeminormAxioms (𝕜 : Type*) {E : Type*} [RCLike 𝕜]
    [AddCommGroup E] [Module 𝕜 E] (p : E → ℝ) : Prop :=
  (∀ x, 0 ≤ p x) ∧
  (∀ (a : 𝕜) x, p (a • x) = ‖a‖ * p x) ∧
  (∀ x y, p (x + y) ≤ p x + p y)

/-- Definiteness is exactly the additional axiom for a norm. -/
def NormAxioms (𝕜 : Type*) {E : Type*} [RCLike 𝕜]
    [AddCommGroup E] [Module 𝕜 E] (p : E → ℝ) : Prop :=
  SeminormAxioms 𝕜 p ∧ ∀ x, p x = 0 ↔ x = 0

/-- Standard Mathlib structure generated by a bundled seminorm. Its additive
operations are those of the original vector space. Its topology is generated
by its pseudometric, not an independently supplied topology. -/
abbrev seminormedGroup [RCLike 𝕜] [AddCommGroup E] [Module 𝕜 E]
    (p : Seminorm 𝕜 E) : SeminormedAddCommGroup E :=
  p.toAddGroupSeminorm.toSeminormedAddCommGroup

/-- The same construction with definiteness, yielding a metric space. -/
abbrev normedGroup [RCLike 𝕜] [AddCommGroup E] [Module 𝕜 E]
    (p : Seminorm 𝕜 E) (h : ∀ x, p x = 0 → x = 0) : NormedAddCommGroup E :=
  (show AddGroupNorm E from
    { p.toAddGroupSeminorm with eq_zero_of_map_eq_zero' := h }).toNormedAddCommGroup

/-- Norm, distance, balls, and topology all refer to the *same* canonical
seminormed structure. Ball identities hold for every real radius, hence in
particular for the positive radii used in the manuscript. -/
def NormGeometry {E : Type*} [SeminormedAddCommGroup E] (p : E → ℝ) : Prop :=
  (∀ x, ‖x‖ = p x) ∧
  (∀ x y, dist x y = p (x - y)) ∧
  (∀ x r, Metric.ball x r = {y | p (y - x) < r}) ∧
  (∀ x r, Metric.closedBall x r = {y | p (y - x) ≤ r}) ∧
  (∀ s : Set E, IsOpen s ↔
    ∀ x ∈ s, ∃ r > 0, ∀ y, p (y - x) < r → y ∈ s)

namespace Spec

def seminormOfAxiomsType :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [AddCommGroup E] [Module 𝕜 E]
    (p : E → ℝ), SeminormAxioms 𝕜 p → Seminorm 𝕜 E

def seminormOfAxiomsValue : seminormOfAxiomsType :=
  fun _ _ _ _ _ p h => Seminorm.of p h.2.2 h.2.1

def SeminormIdentification : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [AddCommGroup E] [Module 𝕜 E] (p : E → ℝ),
    SeminormAxioms 𝕜 p ↔ ∃ q : Seminorm 𝕜 E, (q : E → ℝ) = p

def NormIdentification : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [AddCommGroup E] [Module 𝕜 E] (p : E → ℝ),
    NormAxioms 𝕜 p ↔
      ∃ q : Seminorm 𝕜 E, (q : E → ℝ) = p ∧ ∀ x, q x = 0 → x = 0

def CanonicalSeminormAxioms : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [SeminormedAddCommGroup E] [NormedSpace 𝕜 E],
    SeminormAxioms 𝕜 (norm : E → ℝ)

def CanonicalNormAxioms : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [NormedAddCommGroup E] [NormedSpace 𝕜 E],
    NormAxioms 𝕜 (norm : E → ℝ)

/-- Construction of a normed-space instance with the original module,
as well as all the induced pseudometric/topology formulas. -/
def SeminormRealization : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [AddCommGroup E] [m : Module 𝕜 E]
    (p : Seminorm 𝕜 E),
    letI := seminormedGroup p
    (∃ n : NormedSpace 𝕜 E, n.toModule = m) ∧ NormGeometry (p : E → ℝ)

/-- In the definite case the identical norm yields an actual metric, without
excluding the zero vector space. -/
def NormRealization : Prop :=
  ∀ (𝕜 E : Type*) [RCLike 𝕜] [AddCommGroup E] [m : Module 𝕜 E]
    (p : Seminorm 𝕜 E) (h : ∀ x, p x = 0 → x = 0),
    letI := normedGroup p h
    (∃ n : NormedSpace 𝕜 E, n.toModule = m) ∧
    NormGeometry (p : E → ℝ) ∧ (∀ x y : E, dist x y = 0 ↔ x = y)

def CanonicalGeometry : Prop :=
  ∀ (E : Type*) [SeminormedAddCommGroup E], NormGeometry (norm : E → ℝ)

end Spec
end ExpandedFA.P1.C01Norm
