import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.BanachAlgebra.SpectralPermanence
import Mathlib.Topology.Algebra.Algebra

/-! The closed unital algebra generated by `a` is `Algebra.elemental ℂ a`,
the norm closure of the algebraic subalgebra generated by `{a}`. A subalgebra
contains all scalars and the ambient identity. No inverse closure is assumed. -/
namespace Specs.ExpandedFA.BanachAlgebra.GeneratedSpectrumHull

open Conventions SpectralPermanence
open scoped Topology
universe u

/-- The final assertion of paper.tex, `fa2:p2:polynomial-hull`. -/
def SpectrumHullEquality : Prop :=
  ∀ (A : Type u) [NormedRing A] [NormedAlgebra ℂ A], IsUnitalBanachAlgebraValue A →
    ∀ a : A,
      spectrum ℂ (⟨a, Algebra.elemental.self_mem ℂ a⟩ : Algebra.elemental ℂ a) =
        PolynomialHullValue (spectrum ℂ a)

/-- All assertions of the permanence and polynomial hull proposition, including
those established by the upstream permanence interface. -/
def PermanenceAndPolynomialHull : Prop :=
  SpectrumInclusion.{u} ∧ SpectrumBoundaryInclusion.{u} ∧
  SpectrumPolynomialHulls.{u} ∧ SpectrumComponents.{u} ∧ SpectrumHullEquality.{u}

end Specs.ExpandedFA.BanachAlgebra.GeneratedSpectrumHull
