import Mathlib.Analysis.Distribution.SchwartzSpace.Fourier
import Mathlib.Analysis.InnerProductSpace.PiL2

/-! Independent objects for paper.tex, `fa2:p4:fourier-normalization`.
Coordinate words enumerate multi-indices (with harmless repetitions), including
order zero. The Schwartz topology is required to be generated by the actual
coordinate monomial/partial-derivative sup seminorms. No dual pairing conjugates
its test function. The Weyl angular frequency is a separate variable. -/

open MeasureTheory
open scoped SchwartzMap FourierTransform ContDiff

namespace ExpandedFA.Fourier

abbrev Euclidean (d : ℕ) := EuclideanSpace ℝ (Fin d)
abbrev Schwartz (𝕜 : Type) [RCLike 𝕜] (d : ℕ) := SchwartzMap (Euclidean d) 𝕜
abbrev Tempered (𝕜 : Type) [RCLike 𝕜] (d : ℕ) := Schwartz 𝕜 d →L[𝕜] 𝕜

noncomputable def basisVector {d : ℕ} (i : Fin d) : Euclidean d := EuclideanSpace.single i 1

/-- A monomial indexed by a coordinate word; empty products are one. -/
def monomial {d k : ℕ} (a : Fin k → Fin d) (x : Euclidean d) : ℝ := ∏ j, x (a j)

/-- Both the polynomial degree and the derivative order, and their coordinate words. -/
structure SchwartzIndex (d : ℕ) where
  degree : ℕ
  order : ℕ
  weight : Fin degree → Fin d
  directions : Fin order → Fin d

noncomputable def weightedPartial (𝕜 : Type) [RCLike 𝕜] {d : ℕ} (s : SchwartzIndex d) :
    Schwartz 𝕜 d →L[𝕜] Schwartz 𝕜 d :=
  (SchwartzMap.smulLeftCLM 𝕜 (fun x : Euclidean d => (monomial s.weight x : 𝕜))).comp
    (LineDeriv.iteratedLineDerivOpCLM 𝕜 (Schwartz 𝕜 d) (fun j => basisVector (s.directions j)))

noncomputable def coordinateSchwartzSeminorm (𝕜 : Type) [RCLike 𝕜] {d : ℕ}
    (s : SchwartzIndex d) : Seminorm 𝕜 (Schwartz 𝕜 d) :=
  (SchwartzMap.seminorm 𝕜 0 0).comp (weightedPartial 𝕜 s).toLinearMap

/-- The ordinary integral transform on functions (in particular on L¹). -/
noncomputable def integralFourier {d : ℕ} (f : Euclidean d → ℂ) (ξ : Euclidean d) : ℂ :=
  ∫ x, Complex.exp (-2 * (Real.pi : ℂ) * Complex.I * (inner ℝ x ξ : ℝ)) * f x

noncomputable def angularFourier {d : ℕ} (f : Euclidean d → ℂ) (p : Euclidean d) : ℂ :=
  ∫ x, Complex.exp (-Complex.I * (inner ℝ x p : ℝ)) * f x

noncomputable def schwartzFourier {d : ℕ} : Schwartz ℂ d →L[ℂ] Schwartz ℂ d :=
  FourierTransform.fourierCLM ℂ (Schwartz ℂ d)

noncomputable def temperedFourier {d : ℕ} (u : Tempered ℂ d) : Tempered ℂ d :=
  u.comp schwartzFourier

noncomputable def temperedPartial {d : ℕ} (i : Fin d) (u : Tempered ℂ d) : Tempered ℂ d :=
  -u.comp (LineDeriv.lineDerivOpCLM ℂ (Schwartz ℂ d) (basisVector i))

noncomputable def coordinateMultiply {d : ℕ} (i : Fin d) : Schwartz ℂ d →L[ℂ] Schwartz ℂ d :=
  SchwartzMap.smulLeftCLM ℂ (fun x : Euclidean d => (x i : ℂ))

noncomputable def temperedCoordinateMultiply {d : ℕ} (i : Fin d) (u : Tempered ℂ d) :
    Tempered ℂ d := u.comp (coordinateMultiply i)

end ExpandedFA.Fourier

namespace Specs.ExpandedFA.Fourier.SchwartzFourierConvention
open _root_.ExpandedFA.Fourier

-- Definitions have full expected values; propositions below require proofs.
def schwartzSpaceType : Type 1 := ∀ (𝕜 : Type) [RCLike 𝕜] (_d : ℕ), Type
def schwartzSpaceValue : schwartzSpaceType := fun 𝕜 _ d => Schwartz 𝕜 d

def temperedSpaceType : Type 1 := ∀ (𝕜 : Type) [RCLike 𝕜] (_d : ℕ), Type
def temperedSpaceValue : temperedSpaceType := fun 𝕜 _ d => Schwartz 𝕜 d →L[𝕜] 𝕜

def seminormFormulaType : Prop := ∀ (𝕜 : Type) [RCLike 𝕜] (d : ℕ)
    (s : SchwartzIndex d) (f : Schwartz 𝕜 d) (C : ℝ), 0 ≤ C →
  (coordinateSchwartzSeminorm 𝕜 s f ≤ C ↔ ∀ x,
    ‖(monomial s.weight x : 𝕜) *
      iteratedFDeriv ℝ s.order f x (fun j => basisVector (s.directions j))‖ ≤ C)

def seminormTopologyType : Prop := ∀ (𝕜 : Type) [RCLike 𝕜] (d : ℕ),
  WithSeminorms (coordinateSchwartzSeminorm 𝕜 (d := d))

/-- Native Schwartz functions are exactly the smooth functions whose coordinate
monomial derivatives are bounded. This also checks the underlying set. -/
def schwartzCharacterizationType : Prop := ∀ (𝕜 : Type) [RCLike 𝕜] (d : ℕ)
    (f : Euclidean d → 𝕜),
  (∃ g : Schwartz 𝕜 d, ⇑g = f) ↔ ContDiff ℝ ∞ f ∧
    ∀ s : SchwartzIndex d, ∃ C : ℝ, ∀ x,
      ‖(monomial s.weight x : 𝕜) *
        iteratedFDeriv ℝ s.order f x (fun j => basisVector (s.directions j))‖ ≤ C

def integralFourierType : Type := ∀ {d : ℕ}, (Euclidean d → ℂ) → Euclidean d → ℂ
noncomputable def integralFourierValue : integralFourierType := @_root_.ExpandedFA.Fourier.integralFourier

def schwartzFourierType : Type := ∀ {d : ℕ}, Schwartz ℂ d →L[ℂ] Schwartz ℂ d
noncomputable def schwartzFourierValue : schwartzFourierType := @_root_.ExpandedFA.Fourier.schwartzFourier

def temperedFourierType : Type := ∀ {d : ℕ}, Tempered ℂ d → Tempered ℂ d
noncomputable def temperedFourierValue : temperedFourierType := @_root_.ExpandedFA.Fourier.temperedFourier

def schwartzIntegralType : Prop := ∀ (d : ℕ) (f : Schwartz ℂ d) (ξ : Euclidean d),
  schwartzFourier f ξ = integralFourier f ξ

def dualPairingType : Prop := ∀ (d : ℕ) (u : Tempered ℂ d) (φ : Schwartz ℂ d),
  temperedFourier u φ = u (schwartzFourier φ)

def partialPairingType : Prop := ∀ (d : ℕ) (i : Fin d) (u : Tempered ℂ d) (φ : Schwartz ℂ d),
  temperedPartial i u φ = -u (LineDeriv.lineDerivOpCLM ℂ (Schwartz ℂ d) (basisVector i) φ)

def coordinatePairingType : Prop := ∀ (d : ℕ) (i : Fin d) (u : Tempered ℂ d)
    (φ : Schwartz ℂ d),
  (∀ x, coordinateMultiply i φ x = (x i : ℂ) * φ x) ∧
    temperedCoordinateMultiply i u φ = u (coordinateMultiply i φ)

def fourierPartialType : Prop := ∀ (d : ℕ) (i : Fin d) (u : Tempered ℂ d),
  temperedFourier (temperedPartial i u) =
    (2 * (Real.pi : ℂ) * Complex.I) • temperedCoordinateMultiply i (temperedFourier u)

def fourierCoordinateType : Prop := ∀ (d : ℕ) (i : Fin d) (u : Tempered ℂ d),
  temperedFourier (temperedCoordinateMultiply i u) =
    (-(2 * (Real.pi : ℂ) * Complex.I)⁻¹) • temperedPartial i (temperedFourier u)

/-- Weyl p is angular frequency p = 2πξ, with no new integrability hypothesis. -/
def angularNormalizationType : Prop := ∀ (d : ℕ) (f : Euclidean d → ℂ) (ξ : Euclidean d),
  angularFourier f ((2 * Real.pi) • ξ) = integralFourier f ξ

end Specs.ExpandedFA.Fourier.SchwartzFourierConvention
