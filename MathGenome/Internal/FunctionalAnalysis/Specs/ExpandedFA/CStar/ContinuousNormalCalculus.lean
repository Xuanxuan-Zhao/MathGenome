import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.CStar.CommutativeRepresentation
import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.CStar.SpectralPermanence
import Mathlib.Analysis.Complex.Spectrum
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
Independent statements of `fa2:p2:commutative-cstar`, paper.tex:12201–12241.
The ambient algebra is a complex unital C*-algebra with its original norm,
involution and algebraic spectrum. No nonzeroness or commutativity of the
ambient algebra is required for the normal-element calculus.

`StarAlgebra.elemental ℂ a` is the norm closure of the unital star algebra
generated by `a`, thus the closed algebra generated by `1`, `a`, and `star a`.
The coordinate function is the inclusion of the actual ambient spectrum
into ℂ. Spectral mapping is equality with the entire range of every continuous
function on that spectrum, not just a polynomial or holomorphic subclass.
-/

namespace ExpandedFA.CStar.ContinuousNormalCalculus.Spec
universe u

/-- The first two assertions, including the empty character space of the zero
algebra, use the already established Gelfand transform and permanence. -/
def RepresentationAndPermanence : Prop :=
  CommutativeRepresentation.Spec.Representation.{u} ∧
    CommutativeRepresentation.Spec.ZeroRepresentation.{u} ∧
    SpectralPermanence.Spec.SpectrumEquality.{u}

/-- Existence, isometry, the exact generated range, and full ambient spectral
mapping for the unital continuous star calculus of a normal element. -/
def NormalCalculus : Prop :=
  ∀ (A : Type u) [CStarAlgebra A] (a : A), IsStarNormal a →
    ∃ Φ : C(spectrum ℂ a, ℂ) →⋆ₐ[ℂ] A,
      Isometry Φ ∧
      Φ ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) = a ∧
      Φ.range = StarAlgebra.elemental ℂ a ∧
      ∀ f : C(spectrum ℂ a, ℂ), spectrum ℂ (Φ f) = Set.range f

/-- Even among all continuous unital star homomorphisms, the value of the
coordinate determines the calculus. In particular this implies uniqueness
among isometric calculi. -/
def NormalCalculusUnique : Prop :=
  ∀ (A : Type u) [CStarAlgebra A] (a : A), IsStarNormal a →
    ∀ Φ Ψ : C(spectrum ℂ a, ℂ) →⋆ₐ[ℂ] A,
      Continuous Φ → Continuous Ψ →
      Φ ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) = a →
      Ψ ((ContinuousMap.id ℂ).restrict (spectrum ℂ a)) = a → Φ = Ψ

end ExpandedFA.CStar.ContinuousNormalCalculus.Spec
