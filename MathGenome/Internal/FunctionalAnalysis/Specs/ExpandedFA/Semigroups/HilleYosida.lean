import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.Semigroups.YosidaConstruction

/-! General Hille–Yosida theorem, paper.tex 14735–14781.
The scalar field is real or complex, the space is an arbitrary Banach space,
and generator equality includes the entire domain. All positive powers use
the same M, including when M > 1. -/

noncomputable section
open Filter Topology
open scoped NNReal

namespace ExpandedFA.Semigroups.HilleYosidaSpec

variable {𝕜 X : Type*} [RCLike 𝕜]
  [NormedAddCommGroup X] [NormedSpace 𝕜 X] [CompleteSpace X]

/-- Every real point above ω is a resolvent point, with all positive power bounds. -/
def ResolventEstimates (A : Unbounded.Operator 𝕜 X X) (M ω : ℝ) : Prop :=
  (∀ r : ℝ, ω < r →
    algebraMap ℝ 𝕜 r ∈ Unbounded.OperatorDomainsSpec.resolventSetValue A) ∧
  ∀ r : ℝ, ω < r → ∀ n : ℕ,
    ‖Unbounded.OperatorDomainsSpec.resolventValue (algebraMap ℝ 𝕜 r) A ^ (n + 1)‖ ≤
      M / (r - ω) ^ (n + 1)

/-- The equivalence with the original fixed growth constants. -/
def Characterization : Prop := ∀ (A : Unbounded.Operator 𝕜 X X) (M ω : ℝ),
  1 ≤ M → Dense (A.domain : Set X) → A.IsClosed →
  ((∃ T : C0Semigroup 𝕜 X, C0SemigroupSpec.generatorValue T = A ∧
    C0SemigroupSpec.exponentialBoundValue T M ω) ↔ ResolventEstimates A M ω)

/-- Strong Yosida approximation, uniform on every bounded nonnegative time
interval, for the semigroup generated by A when ω = 0. -/
def ZeroShiftApproximation : Prop := ∀ (A : Unbounded.Operator 𝕜 X X) (M : ℝ)
    (T : C0Semigroup 𝕜 X),
  Dense (A.domain : Set X) → A.IsClosed →
  C0SemigroupSpec.generatorValue T = A →
  C0SemigroupSpec.exponentialBoundValue T M 0 →
  ∀ (x : X) (b : ℝ), 0 ≤ b →
    TendstoUniformlyOn
      (fun r : ℝ => fun t : ℝ => YosidaConstructionSpec.exponential A r t x)
      (fun t : ℝ => T.operators t.toNNReal x) atTop (Set.Icc 0 b)

def CharacterizationExpected : Prop := ∀ {𝕜 X : Type*} [RCLike 𝕜]
  [NormedAddCommGroup X] [NormedSpace 𝕜 X] [CompleteSpace X],
  Characterization (𝕜 := 𝕜) (X := X)

def ZeroShiftApproximationExpected : Prop := ∀ {𝕜 X : Type*} [RCLike 𝕜]
  [NormedAddCommGroup X] [NormedSpace 𝕜 X] [CompleteSpace X],
  ZeroShiftApproximation (𝕜 := 𝕜) (X := X)

end ExpandedFA.Semigroups.HilleYosidaSpec
