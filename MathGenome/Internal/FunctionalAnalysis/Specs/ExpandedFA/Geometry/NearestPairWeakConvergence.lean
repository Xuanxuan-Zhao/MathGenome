import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.Geometry.MinimumDisplacement
import Mathlib.Topology.Algebra.Module.Spaces.WeakDual

/-! Independent statements for paper.tex, fa2:p2:projection-nearest-pair.
`toWeakSpace` equips the original space with the topology generated by its
continuous scalar-linear dual. Index zero is the paper's pair (u₁,u₂).
Convexity remains real convexity over either scalar field. -/
noncomputable section
open Filter
open scoped Pointwise
namespace ExpandedFA.Geometry.NearestPairWeakConvergence.Spec
universe u v

def WeakNearestPair : Prop :=
  ∀ (𝕜 : Type u) (H : Type v) [RCLike 𝕜]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
    (C₁ C₂ : Set H) (hne₁ : C₁.Nonempty) (hne₂ : C₂.Nonempty)
    (hc₁ : IsClosed C₁) (hc₂ : IsClosed C₂)
    (hv₁ : Hilbert.Conventions.Spec.RealConvexValue 𝕜 H C₁)
    (hv₂ : Hilbert.Conventions.Spec.RealConvexValue 𝕜 H C₂),
    let p := MinimumDisplacement.Spec.minimumVector C₁ C₂
    let P₁ := Hilbert.Projection.Spec.ConvexProjectionValue 𝕜 H C₁ hne₁ hc₁ hv₁
    let P₂ := Hilbert.Projection.Spec.ConvexProjectionValue 𝕜 H C₂ hne₂ hc₂ hv₂
    p ∈ C₂ - C₁ → ∀ s : ℕ → H,
      FirmProjectionAndOrbitGaps.Spec.IsAlternatingOrbit P₁ P₂ s →
      ∃ a ∈ C₁, ∃ b ∈ C₂, b - a = p ∧
        Tendsto (fun n => toWeakSpace 𝕜 H (s (2*n+1))) atTop
          (nhds (toWeakSpace 𝕜 H a)) ∧
        Tendsto (fun n => toWeakSpace 𝕜 H (s (2*n+2))) atTop
          (nhds (toWeakSpace 𝕜 H b))

def BoundedAttainment : Prop :=
  ∀ (𝕜 : Type u) (H : Type v) [RCLike 𝕜]
    [NormedAddCommGroup H] [InnerProductSpace 𝕜 H] [CompleteSpace H]
    (C₁ C₂ : Set H) (hne₁ : C₁.Nonempty) (hne₂ : C₂.Nonempty)
    (hc₁ : IsClosed C₁) (hc₂ : IsClosed C₂)
    (hv₁ : Hilbert.Conventions.Spec.RealConvexValue 𝕜 H C₁)
    (hv₂ : Hilbert.Conventions.Spec.RealConvexValue 𝕜 H C₂),
    Bornology.IsBounded C₁ ∨ Bornology.IsBounded C₂ →
      MinimumDisplacement.Spec.minimumVector C₁ C₂ ∈ C₂ - C₁

end ExpandedFA.Geometry.NearestPairWeakConvergence.Spec
