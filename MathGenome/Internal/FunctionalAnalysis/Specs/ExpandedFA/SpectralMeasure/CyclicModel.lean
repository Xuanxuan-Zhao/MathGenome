import MathGenome.Internal.FunctionalAnalysis.Specs.ExpandedFA.SpectralMeasure.NormalPVM
import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Basic
import Mathlib.MeasureTheory.Function.L2Space
import Mathlib.MeasureTheory.Function.Holder

/-!
The cyclic stage of `fa2:p2:cyclic-model`, paper.tex 12457–12469.
Cyclicity refers to the orbit of the closed unital star algebra generated by N.
The scalar measure is characterized by its values on Borel sets; it is not
normalized. The Hilbert space and the cyclic vector may both be zero.
-/
noncomputable section
open MeasureTheory Set
open scoped ENNReal

namespace ExpandedFA.SpectralMeasure.CyclicModel.Spec
universe u
variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The usual cyclicity condition for C*(I,N), with the ambient norm topology. -/
def IsCyclic (N : H →L[ℂ] H) (e : H) : Prop :=
  DenseRange (fun a : StarAlgebra.elemental ℂ N => (a : H →L[ℂ] H) e)

/-- The actual diagonal measure of the spectral resolution, on all Borel sets. -/
def DiagonalMeasure {N : H →L[ℂ] H}
    (E : ProjectionValuedMeasure (spectrum ℂ N) H) (e : H)
    (μ : Measure (spectrum ℂ N)) : Prop :=
  ∀ B, MeasurableSet B → μ B = ENNReal.ofReal (‖E B e‖ ^ 2)

/-- Pointwise multiplication by a continuous function, as a bounded operator
on L². The coefficient is in L∞, so this is the ordinary Hölder product. -/
def multiplier {S : Type*} [TopologicalSpace S] [CompactSpace S]
    [MeasurableSpace S] [BorelSpace S] (μ : Measure S) [IsFiniteMeasure μ]
    (f : C(S, ℂ)) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ :=
  (ContinuousLinearMap.mul ℂ ℂ).holderL μ ∞ 2 2
    (ContinuousMap.toLp ∞ μ ℂ f)

/-- Coordinate multiplication on the actual spectrum. -/
def coordinate (N : H →L[ℂ] H) : C(spectrum ℂ N, ℂ) :=
  (ContinuousMap.id ℂ).restrict (spectrum ℂ N)

/-- An actual surjective linear isometry, agreeing with the continuous
calculus on continuous functions and intertwining coordinate multiplication.
The stronger continuous-function intertwining statement records its extension. -/
def Model (N : H →L[ℂ] H) (hN : IsStarNormal N)
    (μ : Measure (spectrum ℂ N)) [IsFiniteMeasure μ] (e : H) : Prop :=
  ∃ U : Lp ℂ 2 μ ≃ₗᵢ[ℂ] H,
    (∀ f : C(spectrum ℂ N, ℂ),
      U (ContinuousMap.toLp 2 μ ℂ f) = cfcHom hN f e) ∧
    U (ContinuousMap.toLp 2 μ ℂ 1) = e ∧
    (∀ u, U (multiplier μ (coordinate N) u) = N (U u)) ∧
    (∀ (g : C(spectrum ℂ N, ℂ)) u,
      U (multiplier μ g u) = cfcHom hN g (U u))

/-- The continuous-function-density bridge uses no positivity of the mass. -/
def ContinuousDensity : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (N : H →L[ℂ] H) (μ : Measure (spectrum ℂ N)) [IsFiniteMeasure μ],
    DenseRange (ContinuousMap.toLp 2 μ ℂ : C(spectrum ℂ N, ℂ) →L[ℂ] Lp ℂ 2 μ)

/-- The diagonal measure, its unnormalized total mass, the density bridge,
and the unitary all refer to this same spectral resolution and vector. -/
def ModelOnResolution (N : H →L[ℂ] H) (hN : IsStarNormal N)
    (E : ProjectionValuedMeasure (spectrum ℂ N) H) (e : H) : Prop :=
  ∃ (μ : Measure (spectrum ℂ N)) (hfinite : IsFiniteMeasure μ),
    letI := hfinite
    DiagonalMeasure E e μ ∧ μ univ = ENNReal.ofReal (‖e‖ ^ 2) ∧
    DenseRange (ContinuousMap.toLp 2 μ ℂ : C(spectrum ℂ N, ℂ) →L[ℂ] Lp ℂ 2 μ) ∧
    Model N hN μ e

/-- The construction works for every regular spectral resolution of N. -/
def ResolutionModel : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (N : H →L[ℂ] H) (hN : IsStarNormal N)
    (E : ProjectionValuedMeasure (spectrum ℂ N) H),
    NormalPVM.Spec.Resolves N E → ∀ e : H, IsCyclic N e →
    ModelOnResolution N hN E e

/-- The cyclic stage of the spectral model theorem, starting just from a
normal operator and a cyclic vector on an arbitrary complex Hilbert space. -/
def CyclicModelTheorem : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (N : H →L[ℂ] H) (hN : IsStarNormal N) (e : H), IsCyclic N e →
    ∃ E : ProjectionValuedMeasure (spectrum ℂ N) H,
      NormalPVM.Spec.Resolves N E ∧ ModelOnResolution N hN E e

/-- On the zero Hilbert space the cyclic vector and its scalar measure are
zero, and the theorem still produces the unitary from the native zero L² space. -/
def ZeroRepresentation : Prop :=
  ∀ (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [Subsingleton H] (N : H →L[ℂ] H) (hN : IsStarNormal N),
    ∃ E : ProjectionValuedMeasure (spectrum ℂ N) H,
      NormalPVM.Spec.Resolves N E ∧ DiagonalMeasure E 0 0 ∧ Model N hN 0 0

end ExpandedFA.SpectralMeasure.CyclicModel.Spec
