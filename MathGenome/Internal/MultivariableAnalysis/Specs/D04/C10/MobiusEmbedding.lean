import MathGenome.Internal.MultivariableAnalysis.Specs.D04.C14.EmbeddedManifoldCharts
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv
import Mathlib.Analysis.Calculus.ContDiff.WithLp
import Mathlib.Topology.Instances.RealVectorSpace
import Mathlib.Topology.Maps.Basic
import Mathlib.Topology.Constructions

/-! The closed Möbius strip of paper.tex, d04:10:mobius.
The equivalence relation is generated by the prescribed endpoint gluing,
independently of the parametrization. In particular its embedding is a conclusion.
The chart conclusion uses the shared embedded-manifold definition and specifies
the extended formula near seam points as well as the half-space boundary charts.
-/
noncomputable section
open Set
open scoped RealInnerProductSpace ContDiff
namespace Specs.D04.C10.MobiusEmbedding
open Specs.D04.C01.EuclideanInterfaces.Model
open Specs.D04.C14.EmbeddedManifoldCharts.Model

namespace Model

def radius (R : ℝ) (p : E 2) : ℝ := R + p 1 * Real.cos (p 0 / 2)

def phi (R : ℝ) (p : E 2) : E 3 :=
  WithLp.toLp 2 ![radius R p * Real.cos (p 0),
    radius R p * Real.sin (p 0), p 1 * Real.sin (p 0 / 2)]

def rectangle (a : ℝ) : Set (E 2) :=
  {p | 0 ≤ p 0 ∧ p 0 ≤ 2 * Real.pi ∧ |p 1| ≤ a}

def strip (R a : ℝ) : Set (E 3) := phi R '' rectangle a

def seamPair (a : ℝ) (p q : rectangle a) : Prop :=
  p.val 0 = 0 ∧ q.val 0 = 2 * Real.pi ∧ q.val 1 = -p.val 1

def seamSetoid (a : ℝ) : Setoid (rectangle a) :=
  Relation.EqvGen.setoid (seamPair a)

def du (R : ℝ) (p : E 2) : E 3 := WithLp.toLp 2
  ![-(p 1 / 2) * Real.sin (p 0 / 2) * Real.cos (p 0) -
      radius R p * Real.sin (p 0),
    -(p 1 / 2) * Real.sin (p 0 / 2) * Real.sin (p 0) +
      radius R p * Real.cos (p 0),
    (p 1 / 2) * Real.cos (p 0 / 2)]

def dv (p : E 2) : E 3 := WithLp.toLp 2
  ![Real.cos (p 0 / 2) * Real.cos (p 0),
    Real.cos (p 0 / 2) * Real.sin (p 0), Real.sin (p 0 / 2)]

/-- A local parameter change centered at p. At a width endpoint, x₁≥0
points inward; otherwise it is an ordinary translation. There is no angular
cutoff, so p₀=0 and p₀=2π use the very same extended formula. -/
def parameterChart (a : ℝ) (p x : E 2) : E 2 := WithLp.toLp 2
  ![p 0 + x 0, if |p 1| = a then p 1 * (1 - x 1 / a) else p 1 + x 1]

end Model
open Model

abbrev phiType := ℝ → E 2 → E 3
def phiValue : phiType := Model.phi
abbrev radiusType := ℝ → E 2 → ℝ
def radiusValue : radiusType := Model.radius
abbrev rectangleType := ℝ → Set (E 2)
def rectangleValue : rectangleType := Model.rectangle
abbrev stripType := ℝ → ℝ → Set (E 3)
def stripValue : stripType := Model.strip
abbrev duType := ℝ → E 2 → E 3
def duValue : duType := Model.du
abbrev dvType := E 2 → E 3
def dvValue : dvType := Model.dv

def seam_identityType : Prop := ∀ (R : ℝ) (p : E 2),
  phi R (WithLp.toLp 2 ![p 0 + 2 * Real.pi, -p 1]) = phi R p

def smoothType : Prop := ∀ R : ℝ, ContDiff ℝ ∞ (phi R)

def quantitative_geometryType : Prop := ∀ (R a : ℝ), 0 < a → a < R →
  ∀ p : E 2, |p 1| ≤ a →
    0 < radius R p ∧
    fderiv ℝ (phi R) p (standardBasis 2 0) = du R p ∧
    fderiv ℝ (phi R) p (standardBasis 2 1) = dv p ∧
    ‖dv p‖ = 1 ∧ ⟪du R p, dv p⟫ = 0 ∧
    ‖du R p‖ ^ 2 = (radius R p) ^ 2 + (p 1) ^ 2 / 4 ∧
    0 < ‖du R p‖ ^ 2 ∧ Function.Injective (fderiv ℝ (phi R) p)

/-- No identifications besides equality and the two directions of the seam. -/
def exact_identificationsType : Prop := ∀ (R a : ℝ), 0 < a → a < R →
  ∀ p ∈ rectangle a, ∀ q ∈ rectangle a,
    phi R p = phi R q ↔ p = q ∨
      (p 0 = 0 ∧ q 0 = 2 * Real.pi ∧ q 1 = -p 1) ∨
      (q 0 = 0 ∧ p 0 = 2 * Real.pi ∧ p 1 = -q 1)

def quotient_embeddingType : Prop := ∀ (R a : ℝ), 0 < a → a < R →
  ∃ f : Quotient (seamSetoid a) → E 3,
    Topology.IsEmbedding f ∧ Set.range f = strip R a ∧
    ∀ p : rectangle a, f (Quotient.mk (seamSetoid a) p) = phi R p.val

def compactType : Prop := ∀ (R a : ℝ), 0 < a → a < R → IsCompact (strip R a)

/-- This specifies the actual local patches at every representative, including
the seam and its two width endpoints. Regularity includes full-rank extensions.
Equality is on an ambient open neighborhood of the centered parameter, so the
extension across the flat boundary is part of the conclusion. -/
def local_chartsType : Prop := ∀ (R a : ℝ), 0 < a → a < R →
  ∀ p ∈ rectangle a,
    ∃ c : EmbeddedChart 1 2 3 (strip R a), CenteredAt c 0 ∧
      c.half = decide (|p 1| = a) ∧ c.toFun 0 = phi R p ∧
      ∃ W : Set (E 2), IsOpen W ∧ (0 : E 2) ∈ W ∧
        EqOn c.toFun (phi R ∘ parameterChart a p) W

def embedded_manifoldType : Prop := ∀ (R a : ℝ), 0 < a → a < R →
  IsEmbeddedManifold 1 2 (strip R a) ∧
    intrinsicBoundary 1 2 (strip R a) =
      phi R '' {p ∈ rectangle a | |p 1| = a}

end Specs.D04.C10.MobiusEmbedding
