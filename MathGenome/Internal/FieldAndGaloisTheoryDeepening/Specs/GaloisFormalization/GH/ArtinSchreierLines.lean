import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.GH.ArtinSchreierConnecting
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

namespace Specs.GaloisFormalization.GH.ArtinSchreierLines

open ArtinSchreierCoefficients (primeFieldInclusion wp quotientMap)
open ArtinSchreierConnecting (Characters charactersModule)
open KrullLayers (AbsoluteGaloisGroup LayerGroup restrict)
open IntermediateField (fixedField adjoin)

universe u v

noncomputable section

/-- The kernel in the multiplicatively written domain of an additive character. -/
abbrev characterKernel {p : ℕ} {G : Type v} [Group G] [TopologicalSpace G]
    [TopologicalSpace (ZMod p)] (χ : Characters p G) : Subgroup G :=
  χ.toAddMonoidHom.toMultiplicativeRight.ker

/-- The one-dimensional prime-field subspaces. -/
abbrev Lines (p : ℕ) (V : Type v) [AddCommGroup V] [Module (ZMod p) V] :=
  {D : Submodule (ZMod p) V // Module.finrank (ZMod p) D = 1}

/-- The line generated by a nonzero vector. -/
def lineOf {p : ℕ} [Fact p.Prime] {V : Type v} [AddCommGroup V] [Module (ZMod p) V]
    (x : V) (hx : x ≠ 0) : Lines p V :=
  ⟨Submodule.span (ZMod p) {x}, finrank_span_singleton hx⟩

/-- Actual finite Galois intermediate fields of degree p with cyclic Galois group. -/
abbrev CyclicLayers (p : ℕ) (k : Type u) (S : Type v) [Field k] [Field S] [Algebra k S] :=
  {E : FiniteGaloisIntermediateField k S //
    Module.finrank k E = p ∧ IsCyclic (LayerGroup E)}

/-- Nonzero characters have open normal kernels, and equality of kernels is
equivalent to proportionality by a nonzero prime-field scalar. -/
def CharacterKernels : Prop :=
  ∀ (p : ℕ) (G : Type v) [Fact p.Prime] [Group G] [TopologicalSpace G]
    [TopologicalSpace (ZMod p)] [DiscreteTopology (ZMod p)],
    letI : Module (ZMod p) (Characters p G) := charactersModule p G
    (∀ χ : Characters p G, χ ≠ 0 → Function.Surjective χ ∧
      IsOpen (characterKernel χ : Set G) ∧ (characterKernel χ).Normal) ∧
    ∀ χ ψ : Characters p G, χ ≠ 0 → ψ ≠ 0 →
      (characterKernel χ = characterKernel ψ ↔
        ∃ c : ZMod p, c ≠ 0 ∧ ψ = c • χ)

/-- The connecting character sends the line of a nonzero class to the field
generated by a root. The inverse on a layer is the line obtained by composing
restriction with any isomorphism to the additive prime field. -/
def LineClassification : Prop :=
  ∀ (p : ℕ) (k : Type u) (S : Type v) [Field k] [Field S] [Algebra k S]
    [Fact p.Prime] [CharP k p] [IsSepClosure k S]
    [TopologicalSpace (ZMod p)] [DiscreteTopology (ZMod p)],
    let G := AbsoluteGaloisGroup k S
    let Q := ArtinSchreierCoefficients.Quotient p k
    letI : CharP S p := charP_of_injective_algebraMap' k p
    letI : Module (ZMod p) (Characters p G) := charactersModule p G
    ∃ (connect : Q ≃ₗ[ZMod p] Characters p G)
      (toCharacterLines : Lines p Q ≃ Lines p (Characters p G))
      (characterFields : Lines p (Characters p G) ≃ CyclicLayers p k S)
      (classFields : Lines p Q ≃ CyclicLayers p k S),
      (∀ D : Lines p Q, (toCharacterLines D).val = D.val.map connect.toLinearMap) ∧
      (∀ D : Lines p Q, classFields D = characterFields (toCharacterLines D)) ∧
      (∀ (χ : Characters p G) (hχ : χ ≠ 0),
        (characterFields (lineOf χ hχ)).val.toIntermediateField =
          fixedField (characterKernel χ)) ∧
      (∀ (a : k) (α : S), wp p S α = algebraMap k S a →
        ∀ g : G, primeFieldInclusion p S (connect.toFun (quotientMap p k a) (Additive.ofMul g)) =
          g • α - α) ∧
      (∀ (a : k) (α : S), wp p S α = algebraMap k S a →
        ∀ ha : quotientMap p k a ≠ 0,
          characterKernel (connect.toFun (quotientMap p k a)) = (adjoin k {α}).fixingSubgroup ∧
          (classFields (lineOf (quotientMap p k a) ha)).val.toIntermediateField = adjoin k {α}) ∧
      (∀ (E : CyclicLayers p k S) (e : LayerGroup E.val ≃* Multiplicative (ZMod p)),
        ∃ (χ : Characters p G) (hχ : χ ≠ 0),
          (∀ g : G, χ (Additive.ofMul g) = (e (restrict E.val g)).toAdd) ∧
          characterFields.symm E = lineOf χ hχ) ∧
      ∀ E : CyclicLayers p k S, ∃ (a : k) (α : S) (ha : quotientMap p k a ≠ 0),
        wp p S α = algebraMap k S a ∧
          classFields.symm E = lineOf (quotientMap p k a) ha ∧
          E.val.toIntermediateField = adjoin k {α}

end

end Specs.GaloisFormalization.GH.ArtinSchreierLines
