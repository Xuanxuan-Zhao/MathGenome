import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.PV.PicardVessiotRing
import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.PV.ConstantIdealDescent

/-! Independent specifications for the tensor product in Theorem 2.2. -/
namespace GaloisFormalization.PV.Specs

open scoped TensorProduct

universe u v

set_option linter.checkUnivs false

open Matrix (GeneralLinearGroup)

def tensorRatioType :=
  (K : Type u) → [CommRing K] → {R : Type v} → [CommRing R] → [Algebra K R] →
    {n : ℕ} → GeneralLinearGroup (Fin n) R → GeneralLinearGroup (Fin n) (R ⊗[K] R)

/-- The inverse of the first copy of the fundamental matrix times the second copy. -/
def tensorRatio : tensorRatioType.{u, v} :=
  fun K _ {R} _ _ _ Y =>
    (GeneralLinearGroup.map Algebra.TensorProduct.includeLeftRingHom Y)⁻¹ *
      GeneralLinearGroup.map
        (Algebra.TensorProduct.includeRight : R →ₐ[K] R ⊗[K] R).toRingHom Y

def picardVessiotCoordinateAlgebraType :=
  {kind : OperatorKind} → {K : Type u} → [Field K] → {R : Type v} → [CommRing R] →
    [Algebra K R] → {n : ℕ} → (δ : operatorField kind K) →
    GeneralLinearGroup (Fin n) R →
    letI : Algebra (constantSubfield δ) R := Algebra.compHom R (constantSubfield δ).subtype
    Subalgebra (constantSubfield δ) (R ⊗[K] R)

/-- The constant-field algebra generated by the entries and inverse determinant of the ratio. -/
def picardVessiotCoordinateAlgebra : picardVessiotCoordinateAlgebraType.{u, v} :=
  fun {_ K} _ {R} _ _ _ δ Y =>
    letI : Algebra (constantSubfield δ) R := Algebra.compHom R (constantSubfield δ).subtype
    matrixGeneratedSubalgebra (constantSubfield δ) (tensorRatio K Y)

/-- For the common tensor operator, the ratio is constant and its coordinate algebra is reduced.
Multiplication through the first factor is an operator isomorphism, under which the second
fundamental matrix comes from the first multiplied by the ratio over the coordinate algebra. -/
def picardVessiotTensor : Prop :=
  ∀ {kind : OperatorKind} {K : Type u} [Field K] {R : Type v} [CommRing R]
    [Algebra K R] {n : ℕ} (δ : operatorField kind K) (A : linearSystem kind K n)
    (E : operator kind R) (Y : GeneralLinearGroup (Fin n) R)
    (F : operator kind (R ⊗[K] R)),
    isBaseField δ → isPicardVessiotRing δ A E → isFundamental A E Y →
    tensorLaws (R := K) E E F →
    let C := constantSubfield δ
    letI : Algebra C R := Algebra.compHom R (constantSubfield δ).subtype
    let T := R ⊗[K] R
    let Z := tensorRatio K Y
    let D : Subalgebra C T := picardVessiotCoordinateAlgebra δ Y
    let U := R ⊗[C] D
    letI : CommRing U := Algebra.TensorProduct.instCommRing
    letI : Algebra R U := Algebra.TensorProduct.leftAlgebra
    letI : Algebra C U := Algebra.TensorProduct.leftAlgebra
    (∀ i j, isConstant F (Z.val i j)) ∧ isConstant F (determinantInverse Z) ∧
    (∀ d : D, isConstant F (d : T)) ∧
    IsReduced T ∧ IsReduced D ∧
    ∃ (G : operator kind U) (e : algEquiv R G F),
      tensorLaws (R := C) E (trivial kind D) G ∧
      e.val.toAlgHom = constantTensorMul D ∧
      ∃ B : GeneralLinearGroup (Fin n) D,
        GeneralLinearGroup.map D.val.toRingHom B = Z ∧
        GeneralLinearGroup.map e.val.toAlgHom.toRingHom
          (GeneralLinearGroup.map (Algebra.TensorProduct.includeLeftRingHom : R →+* U) Y *
            GeneralLinearGroup.map
              (Algebra.TensorProduct.includeRight : D →ₐ[C] U).toRingHom B) =
          GeneralLinearGroup.map
            (Algebra.TensorProduct.includeRight : R →ₐ[K] T).toRingHom Y

end GaloisFormalization.PV.Specs
