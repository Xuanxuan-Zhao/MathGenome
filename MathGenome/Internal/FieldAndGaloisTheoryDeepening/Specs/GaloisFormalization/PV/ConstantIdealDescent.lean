import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.PV.OperatorTensor
import Mathlib.RingTheory.TensorProduct.Maps
import Mathlib.RingTheory.Adjoin.Basic

namespace GaloisFormalization.PV.Specs

open scoped TensorProduct

universe u v w

set_option linter.checkUnivs false

/-- The structure map from the field identifies it with the full ring of constants.
Injectivity follows from the field hypothesis when the operator ring is nontrivial. -/
def hasConstantFieldType :=
  {kind : OperatorKind} → {C : Type u} → {S : Type v} →
    [Field C] → [CommRing S] → [Algebra C S] → operator kind S → Prop

def hasConstantField : hasConstantFieldType.{u, v} :=
  fun {_kind C S} _ _ _ E =>
    ∀ s : S, isConstant E s ↔ ∃ c : C, algebraMap C S c = s

/-- Every stable ideal is generated by its contraction along the right factor map. -/
def constantIdealDescent :=
  ∀ {kind : OperatorKind} {C : Type u} {S : Type v} {D : Type w}
    [Field C] [CommRing S] [CommRing D] [Algebra C S] [Algebra C D]
    {E : operator kind S} {G : operator kind (S ⊗[C] D)},
    isSimple E → hasConstantField (C := C) E →
    tensorLaws (R := C) E (trivial kind D) G →
    ∀ I : Ideal (S ⊗[C] D), isStable G (I : Set (S ⊗[C] D)) →
    I = (I.comap (Algebra.TensorProduct.includeRight (R := C) (A := S)).toRingHom).map
      (Algebra.TensorProduct.includeRight (R := C) (A := S)).toRingHom

/-- The constants on the tensor product are the image of the right factor. -/
def constantTensorConstants :=
  ∀ {kind : OperatorKind} {C : Type u} {S : Type v} {D : Type w}
    [Field C] [CommRing S] [CommRing D] [Algebra C S] [Algebra C D]
    {E : operator kind S} {G : operator kind (S ⊗[C] D)},
    isSimple E → hasConstantField (C := C) E →
    tensorLaws (R := C) E (trivial kind D) G →
    constantSubring G = (Algebra.TensorProduct.includeRight (R := C) (A := S)).toRingHom.range

/-- The canonical multiplication map sends a pure tensor to the product of its two images. -/
def constantTensorMulType :=
  {C : Type u} → {S : Type v} → {B : Type w} →
    [CommRing C] → [CommRing S] → [CommRing B] →
    [Algebra C S] → [Algebra C B] → [Algebra S B] → [IsScalarTower C S B] →
    (D : Subalgebra C B) → S ⊗[C] D →ₐ[S] B

def constantTensorMul : constantTensorMulType.{u, v, w} :=
  fun {_C S B} _ _ _ _ _ _ _ D =>
    Algebra.TensorProduct.lift (Algebra.ofId S B) D.val (fun _ _ => Commute.all _ _)

/-- An extension generated over the simple ring by a subalgebra of constants
is isomorphic, by the multiplication map, to the tensor product over the constant field. -/
def constantTensorMulIsEquiv :=
  ∀ {kind : OperatorKind} {C : Type u} {S : Type v} {B : Type w}
    [Field C] [CommRing S] [CommRing B]
    [Algebra C S] [Algebra C B] [Algebra S B] [IsScalarTower C S B]
    {E : operator kind S} {F : operator kind B} (D : Subalgebra C B)
    {G : operator kind (S ⊗[C] D)},
    isSimple E → hasConstantField (C := C) E → isExtension E F →
    tensorLaws (R := C) E (trivial kind D) G →
    (∀ d : D, isConstant F (d : B)) →
    Algebra.adjoin S (D : Set B) = ⊤ →
    ∃ e : algEquiv S G F, e.val.toAlgHom = constantTensorMul D

end GaloisFormalization.PV.Specs
