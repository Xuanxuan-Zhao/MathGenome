import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.PV.MatrixGroupCoordinates
import Mathlib.GroupTheory.Index

namespace GaloisFormalization.PV.MatrixGroupIdentityComponent.Specs

open scoped MatrixGroupCoordinates.Specs Pointwise

universe u

variable {C : Type u} [Field C] {n : ℕ}

def IdentityComponentType :=
  ∀ {C : Type u} [Field C] {n : ℕ}, (G : Subgroup (GL (Fin n) C)) → Subgroup G

/-- The subgroup generated by the connected component of the identity.
Its carrier is that component, as asserted by `IdentityComponentCarrier`. -/
def identityComponent (G : Subgroup (GL (Fin n) C)) : Subgroup G :=
  Subgroup.closure (connectedComponent (1 : G))

def IdentityComponentCarrier : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} (G : Subgroup (GL (Fin n) C)),
    (identityComponent G : Set G) = connectedComponent (1 : G)

def IdentityComponentClosed : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} (G : Subgroup (GL (Fin n) C)),
    IsClosed (identityComponent G : Set G)

def IdentityComponentNormal : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} (G : Subgroup (GL (Fin n) C)),
    (identityComponent G).Normal

def IdentityComponentFiniteIndex : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} (G : Subgroup (GL (Fin n) C)),
    (identityComponent G).FiniteIndex

def IdentityComponentCosets : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} (G : Subgroup (GL (Fin n) C)) (g : G),
    g • (identityComponent G : Set G) = connectedComponent g ∧
      MulOpposite.op g • (identityComponent G : Set G) = connectedComponent g

def ClosedFiniteIndexClopen : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} {G : Subgroup (GL (Fin n) C)}
    (H : Subgroup G) [H.FiniteIndex],
      IsClosed (H : Set G) → IsClopen (H : Set G)

def IdentityComponentLeOfClosedFiniteIndex : Prop :=
  ∀ {C : Type u} [Field C] {n : ℕ} {G : Subgroup (GL (Fin n) C)}
    (H : Subgroup G) [H.FiniteIndex],
      IsClosed (H : Set G) → identityComponent G ≤ H

end GaloisFormalization.PV.MatrixGroupIdentityComponent.Specs
