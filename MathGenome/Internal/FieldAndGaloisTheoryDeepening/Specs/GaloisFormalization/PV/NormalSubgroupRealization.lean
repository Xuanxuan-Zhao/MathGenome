import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.PV.IntermediateFixedRing

namespace GaloisFormalization.PV.Specs

open scoped Matrix MatrixGroupCoordinates.Specs nonZeroDivisors
open Matrix (GeneralLinearGroup)
open MatrixGroupCoordinates.Specs (IsRegularRepresentation)

/-- A closed normal subgroup fixes the embedded total extension of the
Picard–Vessiot algebra generated by a fundamental matrix for a regular
representation with that kernel. -/
def normalSubgroupRealization.{u, v} : Prop :=
  ∀ {kind : OperatorKind} {K : Type u} {R : Type v}
    [Field K] [CommRing R] [Algebra K R] {n : ℕ}
    (δ : operatorField kind K) (A : linearSystem kind K n) (E : operator kind R)
    (T : operator kind (totalQuotientRing R)) (Y : GL (Fin n) R),
    isBaseField δ → isPicardVessiotTotalExtension δ A E T → isFundamental A E Y →
    let Q := totalQuotientRing R
    let G := matrixGaloisGroup δ E Y
    ∀ (H : Subgroup G), IsClosed (H : Set G) → H.Normal →
      ∃ (m : ℕ) (ρ : G →* GL (Fin m) (constantSubfield δ))
        (Aρ : linearSystem kind K m) (W : GL (Fin m) R),
        IsRegularRepresentation ρ ∧ ρ.ker = H ∧ isFundamental Aρ E W ∧
        let WQ := GeneralLinearGroup.map (algebraMap R Q) W
        let B := matrixGeneratedSubalgebra K WQ
        ∃ (D : operator kind B) (U : operator kind (totalQuotientRing B))
          (X : GL (Fin m) B) (j : totalQuotientRing B →ₐ[K] Q),
          isPicardVessiotTotalExtension δ Aρ D U ∧
          GeneralLinearGroup.map B.val.toRingHom X = WQ ∧
          isFundamental Aρ D X ∧ matrixGeneratedSubalgebra K X = ⊤ ∧
          (∀ x : B, x ∈ (B : Type v)⁰ → IsUnit (x : Q)) ∧
          Function.Injective j ∧ commutes U T j ∧
          (∀ x : B, j (algebraMap B (totalQuotientRing B) x) = (x : Q)) ∧
          j.range = matrixFixedSubalgebra δ E Y (H : Set G) ∧
          relativeStabilizer δ E Y j.range = (H : Set G) ∧
          ∀ g : G,
            GeneralLinearGroup.map (matrixFractionAutomorphism δ E Y g).toRingHom WQ =
              WQ * GeneralLinearGroup.map
                ((algebraMap K Q).comp (constantSubfield δ).subtype) (ρ g)

end GaloisFormalization.PV.Specs
