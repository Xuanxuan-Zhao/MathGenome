namespace GaloisFormalization.IG

open GenericCubic SpecializationData

private theorem generic_coeff_eq (n : ℕ) :
    (polynomial (RatFunc.X : RatFunc ℚ)).coeff n =
      algebraMap ℚ[X] (RatFunc ℚ) ((polynomial (X : ℚ[X])).coeff n) := by
  rw [← coeff_map, generic_coefficients]

theorem regular_cubic_coefficients : RegularCubicSpec.CoefficientsRegular := by
  intro a n
  change ((polynomial (RatFunc.X : RatFunc ℚ)).coeff n).denom.eval a ≠ 0
  rw [generic_coeff_eq, RatFunc.denom_algebraMap]
  simp

theorem regular_cubic_specialization_formula : RegularCubicSpec.SpecializationFormula := by
  intro a hf
  change specialize (a : ℚ) (polynomial (RatFunc.X : RatFunc ℚ)) hf = polynomial (a : ℚ)
  have hmap : (polynomial (X : ℚ[X])).map (evalRingHom (a : ℚ)) = polynomial (a : ℚ) := by
    rw [polynomial_map]
    simp
  ext n
  rw [specialize_coeff, generic_coeff_eq, RatFunc.eval_algebraMap, ← hmap, coeff_map]
  simp

private theorem cubicDiscriminant_polynomial {F : Type*} [Field F] (a : F) :
    cubicDiscriminant (polynomial a) = (polynomial a).discr := by
  rw [Polynomial.discr_of_degree_eq_three (polynomial_monic_degree a).2]
  simp only [cubicDiscriminant, Cubic.discr]

/-- A splitting field in a common ambient field remains a splitting field after
adjoining the new base. Both sides are generated by the same set of roots. -/
private theorem compositum_isSplittingField
    {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (p : K[X]) (hp : (p.map (algebraMap K Ω)).Splits) (B : IntermediateField K Ω) :
    let L := adjoin K (p.rootSet Ω)
    let P := L ⊔ B
    letI : Algebra B P := (inclusion le_sup_right).toAlgebra
    (p.map (algebraMap K B)).IsSplittingField B P := by
  classical
  let L := adjoin K (p.rootSet Ω)
  let P := L ⊔ B
  let : Algebra B P := (inclusion le_sup_right).toAlgebra
  let q := p.map (algebraMap K B)
  have hqmap : q.map (algebraMap B Ω) = p.map (algebraMap K Ω) := by
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
  have hroots : q.rootSet Ω = p.rootSet Ω := by
    simp only [rootSet_def, aroots_def, hqmap]
  let P' : IntermediateField B Ω := extendScalars (le_sup_right : B ≤ P)
  have hP : P' = adjoin B (q.rootSet Ω) := by
    apply restrictScalars_injective K
    rw [restrictScalars_adjoin_eq_sup, hroots]
    change L ⊔ B = B ⊔ L
    exact sup_comm L B
  have hs : q.IsSplittingField B P' :=
    IntermediateField.isSplittingField_iff.mpr
      ⟨IntermediateField.splits_of_splits (hqmap.symm ▸ hp) (by
        rw [hP]
        exact fun _ hx ↦ subset_adjoin B _ hx), hP⟩
  exact hs

/-- The geometric splitting field has the full cubic group. Comparing its
faithful action with the arithmetic root action makes restriction surjective. -/
private theorem generic_regular_and_nonsquare
    (L : Type*) [Field L] [Algebra (RatFunc ℚ) L]
    [(polynomial (RatFunc.X : RatFunc ℚ)).IsSplittingField (RatFunc ℚ) L] :
    letI : Algebra ℚ L := Algebra.compHom L (algebraMap ℚ (RatFunc ℚ))
    IsRegularOver ℚ L ∧ ¬ IsSquare (cubicDiscriminant (polynomial (RatFunc.X : RatFunc ℚ))) := by
  let : Algebra ℚ L := Algebra.compHom L (algebraMap ℚ (RatFunc ℚ))
  let K := RatFunc ℚ
  let Ω := AlgebraicClosure K
  let : Algebra ℚ K := RatFunc.instAlgebraOfPolynomial ℚ ℚ
  have hcommK : (algebraMap K Ω).comp (algebraMap ℚ K) = algebraMap ℚ Ω :=
    Subsingleton.elim _ _
  let iK : K →ₐ[ℚ] Ω := ⟨algebraMap K Ω, RingHom.congr_fun hcommK⟩
  let t := iK (RatFunc.X : K)
  have ht : Transcendental ℚ t :=
    mt (isAlgebraic_algHom_iff iK iK.injective).mp RatFunc.transcendental_X
  let A := adjoin ℚ {t}
  let e := RatFunc.algEquivOfTranscendental t ht
  let : Algebra K A := e.toRingHom.toAlgebra
  let : IsScalarTower K A Ω := IsScalarTower.of_algebraMap_eq fun x ↦ by
    change iK x = (e x : Ω)
    rw [RatFunc.algEquivOfTranscendental_apply]
    simp only [t, aeval_algHom_apply, ← map_div₀]
    have heval (g : ℚ[X]) : aeval (RatFunc.X : K) g = algebraMap ℚ[X] K g :=
      RatFunc.aeval_X_left_eq_algebraMap g
    rw [heval, heval, RatFunc.num_div_denom]
  let : Algebra.IsAlgebraic A Ω := Algebra.IsAlgebraic.tower_top (K := K) A
  let tA := AdjoinSimple.gen ℚ t
  let p := polynomial tA
  have hp : (p.map (algebraMap A Ω)).Splits := IsAlgClosed.splits _
  let M := adjoin A (p.rootSet Ω)
  let : p.IsSplittingField A M := IntermediateField.adjoin_rootSet_isSplittingField hp
  have heX : e.toRingHom (RatFunc.X : K) = tA :=
    Subtype.val_injective (RatFunc.algEquivOfTranscendental_X t ht)
  have hpmap : (polynomial (RatFunc.X : K)).map e.toRingHom = p := by
    rw [polynomial_map, heX]
  have hpirr : Irreducible p := by
    rw [← hpmap]
    exact (generic_irreducible ℚ).map (Polynomial.mapEquiv e.toRingEquiv)
  let : FiniteDimensional A M := IsSplittingField.finiteDimensional M p
  let : IsGalois A M := IsGalois.of_separable_splitting_field hpirr.separable
  let D := algebraicClosure ℚ Ω
  let : IsAlgClosed D := (algebraicClosure.isAlgClosure (F := ℚ) (E := Ω)).isAlgClosed
  let B := rationalWithConstants t D
  let P := M ⊔ B
  let : Algebra B P := (inclusion le_sup_right).toAlgebra
  let q := p.map (algebraMap A B)
  let : q.IsSplittingField B P := compositum_isSplittingField p hp B
  have hB : (adjoin D {t}).restrictScalars ℚ = B.restrictScalars ℚ := by
    rw [restrictScalars_adjoin_eq_sup]
    rfl
  let eB : RatFunc D ≃+* B :=
    (RatFunc.algEquivOfTranscendental t (ht.extendScalars (S := D))).toRingEquiv.trans
      (IntermediateField.equivOfEq hB).toRingEquiv
  have htB : eB.toRingHom (RatFunc.X : RatFunc D) = algebraMap A B tA := by
    apply Subtype.val_injective
    exact RatFunc.algEquivOfTranscendental_X t (ht.extendScalars (S := D))
  have hq : (polynomial (RatFunc.X : RatFunc D)).map eB.toRingHom = q := by
    rw [polynomial_map, show q = (polynomial tA).map (algebraMap A B) from rfl,
      polynomial_map, htB]
  have hqirr : Irreducible q := by
    rw [← hq]
    exact (generic_irreducible D).map (Polynomial.mapEquiv eB)
  have hqdeg := polynomial_monic_degree (algebraMap A B tA)
  have hqform : q = polynomial (algebraMap A B tA) := polynomial_map _ _
  have hqns : ¬ IsSquare (cubicDiscriminant q) := by
    rw [hqform, cubicDiscriminant_polynomial, polynomial_discr]
    intro hs
    have hs' : IsSquare (eB.toRingHom (4 - 27 * (RatFunc.X : RatFunc D) ^ 2)) := by
      simpa only [map_sub, map_mul, map_ofNat, map_pow, htB] using hs
    apply generic_discr_nonsquare D
    rw [polynomial_discr]
    change IsSquare (eB (4 - 27 * (RatFunc.X : RatFunc D) ^ 2)) at hs'
    simpa only [RingEquiv.symm_apply_apply] using hs'.map eB.symm
  obtain ⟨_, φ, _⟩ := cubic_galois_equiv_of_nonsquare (L := P) (p := q)
    (hqform ▸ hqdeg.1 : q.Monic) (natDegree_eq_of_degree_eq_some (hqform ▸ hqdeg.2))
    hqirr.separable hqirr hqns
  obtain ⟨order⟩ := cubic_root_ordering (L := M) p
    (natDegree_eq_of_degree_eq_some (polynomial_monic_degree tA).2) hpirr.separable
  have hfaith : Function.Injective (cubicRootAction (p := p) order) :=
    (cubic_root_action_faithful_transitive (p := p) order hpirr).1
  have hbound := Nat.card_le_card_of_injective (cubicRootAction (p := p) order) hfaith
  rw [← Nat.card_congr φ.toEquiv] at hbound
  have hgeom := geometricGaloisGroup ℚ Ω t ht M
  have hregular : IsRegularOver ℚ M :=
    hgeom.2.2.2.mp (hgeom.2.1.bijective_of_nat_card_le hbound).2
  let : Algebra K M := Algebra.compHom M e.toRingHom
  have hsplit : ((polynomial (RatFunc.X : K)).map (algebraMap K M)).Splits := by
    change ((polynomial (RatFunc.X : K)).map
      ((algebraMap A M).comp e.toRingHom)).Splits
    rw [← Polynomial.map_map, hpmap]
    exact IsSplittingField.splits M p
  let i : L →ₐ[K] M := IsSplittingField.lift L _ hsplit
  have hcomm : i.toRingHom.comp (algebraMap ℚ L) = algebraMap ℚ M :=
    Subsingleton.elim _ _
  let iQ : L →ₐ[ℚ] M := ⟨i.toRingHom, RingHom.congr_fun hcomm⟩
  refine ⟨?_, ?_⟩
  · change algebraicClosure ℚ L = ⊥
    rw [eq_bot_iff]
    intro x hx
    have hi : iQ x ∈ algebraicClosure ℚ M :=
      mem_algebraicClosure_iff.mpr ((mem_algebraicClosure_iff.mp hx).algHom iQ)
    rw [show algebraicClosure ℚ M = ⊥ from hregular] at hi
    obtain ⟨c, hc⟩ := mem_bot.mp hi
    exact mem_bot.mpr ⟨c, iQ.injective ((iQ.commutes c).trans hc)⟩
  · let j : K →+* B := (algebraMap A B).comp e.toRingHom
    have hj : j (RatFunc.X : K) = algebraMap A B tA := by
      exact congrArg (algebraMap A B) heX
    intro hs
    apply hqns
    rw [cubicDiscriminant_polynomial, polynomial_discr] at hs
    rw [hqform, cubicDiscriminant_polynomial, polynomial_discr]
    simpa only [map_sub, map_mul, map_ofNat, map_pow, hj] using hs.map j

theorem regular_generic_cubic : RegularCubicSpec.RegularGenericCubic := by
  dsimp only [RegularCubicSpec.RegularGenericCubic]
  intro L _ _ _
  let t : RatFunc ℚ := RatFunc.X
  have hmonic := polynomial_monic_degree t
  have hsep := generic_separable ℚ
  obtain ⟨hreg, hns⟩ := generic_regular_and_nonsquare L
  exact ⟨IsSplittingField.finiteDimensional L (polynomial t), IsGalois.of_separable_splitting_field hsep,
    hreg, cubic_galois_equiv_of_nonsquare hmonic.1 (natDegree_eq_of_degree_eq_some hmonic.2)
      hsep (generic_irreducible ℚ) hns⟩

theorem regular_cubic_odd_specialization : RegularCubicSpec.OddSpecialization := by
  dsimp only [RegularCubicSpec.OddSpecialization]
  intro L _ _ _ a ha
  let f := polynomial (RatFunc.X : RatFunc ℚ)
  have hf : PolynomialRegularAt (a : ℚ) f := regular_cubic_coefficients (a : ℚ)
  refine ⟨hf, ?_⟩
  let g := specialize (a : ℚ) f hf
  have hg : g = oddCubicFibre a := regular_cubic_specialization_formula a hf
  have hmonic : f.Monic := (polynomial_monic_degree _).1
  have hsep : g.Separable := hg.symm ▸ odd_cubic_fibre_separable a ha
  refine ⟨hmonic, hsep, ?_⟩
  intro ℓ _ _ _
  have fibreGroup (p : ℚ[X]) (hp : p = oddCubicFibre a) [p.IsSplittingField ℚ ℓ] :
      ∃ (e : CubicRootOrdering p ℓ) (φ : (ℓ ≃ₐ[ℚ] ℓ) ≃* Equiv.Perm (Fin 3)),
        φ.toMonoidHom = cubicRootAction e := by
    subst p
    exact odd_cubic_fibre_galois_equiv a ha
  have hℓgroup := fibreGroup g hg
  obtain ⟨_, φf, _⟩ := (regular_generic_cubic L).2.2.2
  have ⟨_, φg, _⟩ := hℓgroup
  obtain ⟨i, hi, _, _, _, d, hd, _, _, _⟩ := goodSpecialization ℓ (a : ℚ) f hf L hmonic hsep
  have hcard : Nat.card (decompositionGroup i) = Nat.card (L ≃ₐ[RatFunc ℚ] L) :=
    Nat.card_congr ((d.trans φg).trans φf.symm).toEquiv
  have hiTop : decompositionGroup i = ⊤ := by
    have : Finite (L ≃ₐ[RatFunc ℚ] L) := Finite.of_injective φf φf.injective
    exact Subgroup.range_subtype (decompositionGroup i) ▸
      (decompositionGroup i).subtype.range_eq_top_of_surjective
        ((Nat.bijective_iff_injective_and_card _).mpr ⟨Subtype.val_injective, hcard⟩).2
  refine ⟨hℓgroup, ⟨i, hi, hiTop, d, hd⟩, ?_⟩
  intro j _
  obtain ⟨σ, _, hσ⟩ := goodSpecializationConjugacy ℓ (a : ℚ) f hf L hmonic hsep i j
  apply (Subgroup.map_injective (f := (MulAut.conj σ).toMonoidHom) (MulAut.conj σ).injective)
  rw [hσ]
  change decompositionGroup i = _
  rw [hiTop, Subgroup.map_top_of_surjective _ (MulAut.conj σ).surjective]

end GaloisFormalization.IG
