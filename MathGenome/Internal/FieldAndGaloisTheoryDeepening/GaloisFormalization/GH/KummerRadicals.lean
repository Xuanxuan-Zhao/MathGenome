import MathGenome.Internal.FieldAndGaloisTheoryDeepening.Specs.GaloisFormalization.GH.KummerRadicals
import MathGenome.Internal.FieldAndGaloisTheoryDeepening.GaloisFormalization.GH.KummerConnecting
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-! Radical fields and their Kummer characters. -/

namespace GaloisFormalization.GH.KummerRadicals

open IntermediateField
open Specs.GaloisFormalization.GH.KummerCoefficients
open Specs.GaloisFormalization.GH.KummerRadicals

open scoped Topology

universe u v w

variable {k : Type u} {S : Type v} [Field k] [Field S] [Algebra k S]

noncomputable abbrev radicalField {m : ℕ} (D : Subgroup (PowerClasses k m)) :
    IntermediateField k S :=
  Specs.GaloisFormalization.GH.KummerRadicals.radicalField D

abbrev classesOfField (m : ℕ) (L : IntermediateField k S) : Subgroup (PowerClasses k m) :=
  Specs.GaloisFormalization.GH.KummerRadicals.classesOfField m L

variable [TopologicalSpace Sˣ] [DiscreteTopology Sˣ]

abbrev characterKernelIntersection {m : ℕ} (D : Subgroup (PowerClasses k m))
    (e : PowerClasses k m ≃* (Gal(S/k) →ₜ* Roots S m)) : Subgroup Gal(S/k) :=
  Specs.GaloisFormalization.GH.KummerRadicals.characterKernelIntersection D e

/-- GH06 supplies the character equivalence with the ratio property used below. -/
theorem existsKummerCharacterEquiv [IsSepClosure k S] {m : ℕ}
    (hm : 1 ≤ m) (hu : IsUnit (m : k)) (hμ : rootsInBase k S m) :
    ∃ e : PowerClasses k m ≃* (Gal(S/k) →ₜ* Roots S m), HasKummerRatios e :=
  KummerConnecting.kummerCharacters (k := k) (S := S) hm hu hμ

omit [TopologicalSpace Sˣ] [DiscreteTopology Sˣ] in
private theorem representative_root [IsSepClosure k S] {m : ℕ}
    (hm : 1 ≤ m) (hu : IsUnit (m : k)) (d : PowerClasses k m) :
    ∃ (a : kˣ) (α : Sˣ), powerClass k m a = d ∧
      α ^ m = Units.map (algebraMap k S) a := by
  obtain ⟨a, ha⟩ := QuotientGroup.mk'_surjective (powerMap k m).range d
  obtain ⟨α, hα⟩ := KummerCoefficients.powerMap_surjective k S hm hu
    (Units.map (algebraMap k S) a)
  exact ⟨a, α, ha, hα⟩

private theorem character_eq_one_iff {m : ℕ}
    {e : PowerClasses k m ≃* (Gal(S/k) →ₜ* Roots S m)} (he : HasKummerRatios e)
    {a : kˣ} {α : Sˣ} (hα : α ^ m = Units.map (algebraMap k S) a) (g : Gal(S/k)) :
    e (powerClass k m a) g = 1 ↔ g (α : S) = (α : S) := by
  rw [← Subtype.coe_inj]
  change (e (powerClass k m a) g : Sˣ) = 1 ↔ _
  rw [he a α hα, div_eq_one]
  exact ⟨fun h => congrArg (fun z : Sˣ => (z : S)) h, fun h => Units.ext h⟩

/-- Fixing the field generated by a single root is equivalent to fixing that root. -/
theorem fixingSubgroupAdjoinRoot : FixingSubgroupAdjoinRoot.{u,v} := by
  intro k S _ _ _ _ _ _ m e he a α hα
  ext g
  rw [IntermediateField.mem_fixingSubgroup_iff, MonoidHom.mem_ker]
  change (∀ x ∈ adjoin k ({(α : S)} : Set S), g • x = x) ↔
    e (powerClass k m a) g = 1
  rw [forall_mem_adjoin_smul_eq_self_iff, Set.forall_mem_singleton]
  exact (character_eq_one_iff he hα g).symm

/-- Recover the radical field from the intersection of the kernels of its characters. -/
theorem radicalFieldFixedField : RadicalFieldFixedField.{u,v} := by
  intro k S _ _ _ _ _ _ m hm hu e he D
  have hfix : (radicalField (S := S) D).fixingSubgroup = characterKernelIntersection D e := by
    ext g
    change g ∈ (adjoin k {x : S | ∃ (a : kˣ) (α : Sˣ), powerClass k m a ∈ D ∧
      α ^ m = Units.map (algebraMap k S) a ∧ (α : S) = x}).fixingSubgroup ↔
      g ∈ ⨅ d : D, (e d).toMonoidHom.ker
    rw [IntermediateField.mem_fixingSubgroup_iff, Subgroup.mem_iInf]
    change (∀ x ∈ _, g • x = x) ↔ _
    rw [forall_mem_adjoin_smul_eq_self_iff]
    constructor
    · intro hg d
      obtain ⟨a, α, ha, hα⟩ := representative_root (S := S) hm hu (d : PowerClasses k m)
      change e (d : PowerClasses k m) g = 1
      rw [← ha]
      exact (character_eq_one_iff he hα g).mpr (hg _ ⟨a, α, ha ▸ d.property, hα, rfl⟩)
    · rintro hg _ ⟨a, α, ha, hα, rfl⟩
      exact (character_eq_one_iff he hα g).mp (hg ⟨_, ha⟩)
  refine ⟨hfix, ?_⟩
  change radicalField D = fixedField (characterKernelIntersection D e)
  rw [← hfix, InfiniteGalois.fixedField_fixingSubgroup]

/-- The intersection is open for a finite group of classes, so its fixed field
is a finite Galois intermediate field. -/
theorem radicalFieldFiniteGalois : RadicalFieldFiniteGalois.{u,v} := by
  intro k S _ _ _ _ _ _ m hm hu e he D _
  have hopen : IsOpen (characterKernelIntersection D e : Set Gal(S/k)) := by
    change IsOpen ((↑(⨅ d : D, (e d).toMonoidHom.ker)) : Set Gal(S/k))
    rw [Subgroup.coe_iInf]
    apply isOpen_iInter_of_finite
    intro d
    change IsOpen ((e d) ⁻¹' {1})
    exact (isOpen_discrete {1}).preimage (e d).continuous
  have hnormal : (characterKernelIntersection D e).Normal :=
    Subgroup.normal_iInf_normal fun _ => inferInstance
  have hfix := (radicalFieldFixedField hm hu he D).1
  have hproperties :=
    (InfiniteGalois.isOpen_and_normal_iff_finite_and_isGalois (radicalField D)).mp (by
      rw [hfix]
      exact ⟨hopen, hnormal⟩)
  refine ⟨hopen, hnormal, ?_⟩
  exact ⟨{ toIntermediateField := radicalField D
           finiteDimensional := hproperties.1
           isGalois := hproperties.2 }, rfl⟩

/-- A class represented by a power in the layer has every root of every
representative in the layer, because roots of unity are scalars. -/
theorem memClassesOfField : MemClassesOfField.{u,v} := by
  intro k S _ _ _ _ m _ _ hμ L a α hα
  let base := Units.map (algebraMap k S).toMonoidHom
  let incl := Units.map (algebraMap L S).toMonoidHom
  change α ^ m = base a at hα
  change powerClass k m a ∈ (((powerMap L m).range.map incl).comap base).map
    (powerClass k m) ↔ (α : S) ∈ L
  constructor
  · rintro ⟨b, ⟨_, ⟨β, rfl⟩, hb⟩, hba⟩
    have hab : a / b ∈ (powerMap k m).range := QuotientGroup.eq_iff_div_mem.mp hba.symm
    obtain ⟨c, hc⟩ := hab
    change c ^ m = a / b at hc
    change incl (β ^ m) = base b at hb
    let γ := incl β * base c
    have hγ : γ ^ m = base a := by
      have hbc : b * c ^ m = a := by rw [hc, mul_comm b, div_mul_cancel]
      rw [show γ = incl β * base c from rfl, mul_pow, ← map_pow, ← map_pow, hb,
        ← map_mul, hbc]
    have hz : α / γ ∈ Roots S m :=
      (mem_rootsOfUnity m _).mpr (by rw [div_pow, hα, hγ, div_self'])
    obtain ⟨z, hscalar⟩ := hμ ⟨α / γ, hz⟩
    have heq : base z * γ = α := by
      change base z = α / γ at hscalar
      rw [hscalar, div_mul_cancel]
    rw [← heq]
    exact L.mul_mem (L.algebraMap_mem (z : k))
      (L.mul_mem (β : L).property (L.algebraMap_mem (c : k)))
  · intro hmem
    let b : L := ⟨(α : S), hmem⟩
    let β : Lˣ := Units.mk0 b (fun hb => α.ne_zero (congrArg (fun x : L => (x : S)) hb))
    have hβ : incl β = α := Units.ext rfl
    refine ⟨a, ⟨β ^ m, ⟨β, rfl⟩, ?_⟩, rfl⟩
    change incl (β ^ m) = base a
    rw [map_pow, hβ, hα]

/-- Adjoining any generating family of roots gives the same field. -/
theorem radicalFieldOfGenerators : RadicalFieldOfGenerators.{u,v,w} := by
  intro k S _ _ _ _ m hm hu hμ D ι a α hD hα
  let L := adjoin k (Set.range fun i => (α i : S))
  have hle : D ≤ classesOfField m L := by
    rw [← hD, Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    exact (memClassesOfField hm hu hμ L (a i) (α i) (hα i)).mpr
      (subset_adjoin k _ ⟨i, rfl⟩)
  apply le_antisymm
  · apply adjoin_le_iff.mpr
    rintro _ ⟨b, β, hb, hβ, rfl⟩
    exact (memClassesOfField hm hu hμ L b β hβ).mp (hle hb)
  · apply adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact subset_adjoin k _ ⟨a i, α i, hD ▸ Subgroup.subset_closure ⟨i, rfl⟩, hα i, rfl⟩

/-- A homomorphism trivial on a surjection's kernel descends to its target. -/
private theorem exists_descendedHom {G H A : Type*} [Group G] [Group H] [Group A]
    (r : G →* H) (hr : Function.Surjective r) (f : G →* A) (hf : r.ker ≤ f.ker) :
    ∃ q : H →* A, ∀ g, q (r g) = f g := by
  let e := QuotientGroup.quotientKerEquivOfSurjective r hr
  refine ⟨(QuotientGroup.lift r.ker f hf).comp e.symm.toMonoidHom, fun g => ?_⟩
  have hg : e (QuotientGroup.mk g) = r g := rfl
  change QuotientGroup.lift r.ker f hf (e.symm (r g)) = f g
  rw [← hg, e.symm_apply_apply]
  rfl

/-- The Galois group of a radical layer acts faithfully by character evaluations. -/
theorem radicalGaloisGroup : RadicalGaloisGroup.{u,v} := by
  intro k S _ _ _ _ _ _ m hm hu e he D L hL
  let r := (KrullLayers.restrict L).toMonoidHom
  have hr : Function.Surjective r := KrullLayers.restrict_surjective L
  let eval : Gal(S/k) →* (D → Roots S m) :=
    { toFun := fun g d => e d g
      map_one' := funext fun d => map_one (e d)
      map_mul' := fun g h => funext fun d => map_mul (e d) g h }
  have hker : r.ker = eval.ker := by
    calc
      r.ker = L.toIntermediateField.fixingSubgroup := KrullLayers.restrict_ker L
      _ = (radicalField (S := S) D).fixingSubgroup := congrArg fixingSubgroup hL
      _ = characterKernelIntersection D e := (radicalFieldFixedField hm hu he D).1
      _ = eval.ker := by
        ext g
        change g ∈ (⨅ d : D, (e d).toMonoidHom.ker) ↔ g ∈ eval.ker
        rw [Subgroup.mem_iInf, MonoidHom.mem_ker, funext_iff]
        rfl
  obtain ⟨f, hf⟩ := exists_descendedHom r hr eval hker.le
  have hinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).mp <| by
    refine le_antisymm ?_ bot_le
    rintro x hx
    obtain ⟨g, rfl⟩ := hr x
    have hg : g ∈ eval.ker := MonoidHom.mem_ker.mpr ((hf g).symm.trans (MonoidHom.mem_ker.mp hx))
    rw [← hker] at hg
    exact Subgroup.mem_bot.mpr (MonoidHom.mem_ker.mp hg)
  refine ⟨⟨f, hinj, fun g d => congrFun (hf g) d⟩, ?_, ?_⟩
  · intro g h
    apply hinj
    rw [map_mul, map_mul, mul_comm]
  · intro g
    apply hinj
    rw [map_pow, map_one]
    funext d
    apply Subtype.ext
    exact (mem_rootsOfUnity m _).mp (f g d).property

/-- Restricting the radical characters to the finite Galois layer gives all
its characters, and their values are the same root ratios computed in the layer. -/
theorem classesOfFieldCharacters : ClassesOfFieldCharacters.{u,v} := by
  intro k S _ _ _ _ _ _ m hm hu hμ e he L
  let C := classesOfField m L.toIntermediateField
  let r := (KrullLayers.restrict L).toMonoidHom
  have hr : Function.Surjective r := KrullLayers.restrict_surjective L
  have hker : r.ker = L.toIntermediateField.fixingSubgroup := KrullLayers.restrict_ker L
  have hmem (d : PowerClasses k m) : d ∈ C ↔ r.ker ≤ (e d).toMonoidHom.ker := by
    obtain ⟨a, α, rfl, hα⟩ := representative_root (S := S) hm hu d
    calc
      powerClass k m a ∈ C ↔ (α : S) ∈ L.toIntermediateField :=
        memClassesOfField hm hu hμ L.toIntermediateField a α hα
      _ ↔ (α : S) ∈ fixedField (KrullLayers.layerKernel L) := by
        rw [KrullLayers.fixedField_layerKernel L]
      _ ↔ r.ker ≤ (e (powerClass k m a)).toMonoidHom.ker := by
        rw [hker, mem_fixedField_iff]
        exact ⟨fun h g hg => (character_eq_one_iff he hα g).mpr (h g hg),
          fun h g hg => (character_eq_one_iff he hα g).mp (h hg)⟩
  refine ⟨fun d => by simpa only [hker] using hmem d, ?_⟩
  let inflation : (Gal(L/k) →* Roots S m) →* (Gal(S/k) →ₜ* Roots S m) :=
    { toFun := fun f =>
        { toMonoidHom := f.comp r
          continuous_toFun := (continuous_of_discreteTopology (f := f)).comp
            (KrullLayers.restrict L).continuous }
      map_one' := ContinuousMonoidHom.ext fun _ => rfl
      map_mul' := fun _ _ => ContinuousMonoidHom.ext fun _ => rfl }
  have hinflation : Function.Injective inflation := by
    intro f g h
    apply MonoidHom.ext
    intro x
    obtain ⟨σ, rfl⟩ := hr x
    exact DFunLike.congr_fun h σ
  let φ : (Gal(L/k) →* Roots S m) →* C :=
    (e.symm.toMonoidHom.comp inflation).codRestrict C fun f => by
      change e.symm (inflation f) ∈ C
      apply (hmem _).mpr
      rw [e.apply_symm_apply]
      intro σ hσ
      change f (r σ) = 1
      rw [MonoidHom.mem_ker.mp hσ, map_one]
  have hbij : Function.Bijective φ := by
    constructor
    · intro f g h
      apply hinflation
      apply e.symm.injective
      exact congrArg Subtype.val h
    · intro d
      obtain ⟨f, hf⟩ := exists_descendedHom r hr (e (d : PowerClasses k m)).toMonoidHom
        ((hmem _).mp d.property)
      refine ⟨f, Subtype.ext ?_⟩
      change e.symm (inflation f) = (d : PowerClasses k m)
      apply e.injective
      rw [e.apply_symm_apply]
      exact ContinuousMonoidHom.ext hf
  let eL := (MulEquiv.ofBijective φ hbij).symm
  have heL (d : C) (σ : Gal(S/k)) : eL d (r σ) = e (d : PowerClasses k m) σ := by
    have hφ : e.symm (inflation (eL d)) = (d : PowerClasses k m) :=
      congrArg Subtype.val (eL.symm_apply_apply d)
    rw [← hφ, e.apply_symm_apply]
    rfl
  refine ⟨eL, heL, ?_⟩
  intro a α hα ha g
  obtain ⟨σ, rfl⟩ := hr g
  let incl := Units.map (algebraMap L S).toMonoidHom
  have hαS : (incl α) ^ m = Units.map (algebraMap k S) a := by
    rw [← map_pow, hα]
    rfl
  change (eL ⟨powerClass k m a, ha⟩ (r σ) : Sˣ) = incl ((r σ • α) / α)
  rw [heL, he a (incl α) hαS, map_div]
  rw [show incl (r σ • α) = σ • incl α from KrullLayers.restrict_units_apply L σ α]

end GaloisFormalization.GH.KummerRadicals
