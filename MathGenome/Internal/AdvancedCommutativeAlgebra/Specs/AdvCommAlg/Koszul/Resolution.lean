import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Koszul.Construction
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.RegularSequence.Definitions
import Mathlib.CategoryTheory.Abelian.LeftDerived
import Mathlib.Algebra.Category.ModuleCat.Projective
import Mathlib.LinearAlgebra.Dimension.Finite

/-! RK-07, paper.tex:2261–2279. Tor is the left derived functor of
`N ↦ N ⊗[R] M` in its first argument. This convention allows coefficient
modules in any universe, without a flatness or finiteness assumption. -/
noncomputable section
open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct
universe u v
namespace AdvCommAlg.Koszul
variable {R : Type u} [CommRing R]

/-- Tensor with a coefficient module, allowing a larger target universe. -/
def tensorCoefficient (M : ModuleCat.{v} R) : ModuleCat.{u} R ⥤ ModuleCat.{max u v} R where
  obj N := ModuleCat.of R (N ⊗[R] M)
  map f := ModuleCat.ofHom (f.hom.rTensor M)
  map_id N := by ext n m; rfl
  map_comp f g := by ext n m; rfl

instance (M : ModuleCat.{v} R) : (tensorCoefficient M).Additive where
  map_add {_ _ f g} := by
    apply ModuleCat.hom_ext
    apply TensorProduct.ext'
    intro n m
    change (f.hom n + g.hom n) ⊗ₜ[R] m = f.hom n ⊗ₜ[R] m + g.hom n ⊗ₜ[R] m
    exact TensorProduct.add_tmul _ _ _

/-- A coefficient homomorphism induces the usual tensor homomorphism. -/
def tensorCoefficientMap {M N : ModuleCat.{v} R} (f : M ⟶ N) :
    tensorCoefficient M ⟶ tensorCoefficient N where
  app P := ModuleCat.ofHom (f.hom.lTensor P)
  naturality {_ _} g := by
    apply ModuleCat.hom_ext
    apply TensorProduct.ext
    ext p m
    rfl

@[simp] theorem tensorCoefficientMap_id (M : ModuleCat.{v} R) :
    tensorCoefficientMap (𝟙 M) = 𝟙 (tensorCoefficient M) := by
  apply NatTrans.ext
  funext P
  apply ModuleCat.hom_ext
  apply TensorProduct.ext
  ext p m
  rfl

@[simp] theorem tensorCoefficientMap_comp {M N P : ModuleCat.{v} R}
    (f : M ⟶ N) (g : N ⟶ P) :
    tensorCoefficientMap (f ≫ g) = tensorCoefficientMap f ≫ tensorCoefficientMap g := by
  apply NatTrans.ext
  funext Q
  apply ModuleCat.hom_ext
  apply TensorProduct.ext
  ext p m
  rfl

/-- Tensor a fixed complex with the varying coefficient module. -/
def tensorComplexFunctor (C : ChainComplex (ModuleCat.{u} R) ℕ) :
    ModuleCat.{v} R ⥤ ChainComplex (ModuleCat.{max u v} R) ℕ where
  obj M := ((tensorCoefficient M).mapHomologicalComplex _).obj C
  map f := (NatTrans.mapHomologicalComplex (tensorCoefficientMap f) _).app C
  map_id M := by simp
  map_comp f g := by simp [NatTrans.mapHomologicalComplex_comp]

/-- The functor of Koszul homology with its ordinary coefficient maps. -/
def koszulHomologyFunctor (x : List R) (q : ℕ) :
    ModuleCat.{v} R ⥤ ModuleCat.{max u v} R :=
  tensorComplexFunctor (listComplex x) ⋙ HomologicalComplex.homologyFunctor _ _ q

/-- Tor_q^R(R/I,-), deriving the first tensor argument. -/
def quotientTorFunctor (I : Ideal R) (q : ℕ) :
    ModuleCat.{v} R ⥤ ModuleCat.{max u v} R where
  obj M := ((tensorCoefficient M).leftDerived q).obj (ModuleCat.of R (R ⧸ I))
  map f := (NatTrans.leftDerived (tensorCoefficientMap f) q).app _
  map_id M := by simp
  map_comp f g := by simp

/-- The precise bridge to the canonical coefficient complex used upstream. -/
theorem tensorCoefficient_complex_eq (M : ModuleCat.{v} R) (x : List R) :
    (tensorComplexFunctor (listComplex x)).obj M = coefficientComplex M x := by
  exact ChainComplex.map_chain_complex_of (tensorCoefficient M) _ _
    (fun n => ModuleCat.hom_ext (differential_comp (listForm x) n))

/-- The canonical augmentation in degree zero: exterior degree zero is R,
then take the quotient by the ideal generated by the list. -/
def augmentationZero (x : List R) :
    (listComplex x).X 0 ⟶ ModuleCat.of R (R ⧸ listIdeal x) :=
  ModuleCat.ofHom ((listIdeal x).mkQ.comp
    (exteriorPower.zeroEquiv R (Fin x.length → R)).toLinearMap)

end AdvCommAlg.Koszul

namespace Specs.AdvCommAlg.Koszul
open _root_.AdvCommAlg.Koszul

/-- The actual augmented exterior complex is a bounded finite free resolution.
The specified degree-zero map makes the augmentation canonical. -/
def finiteFreeResolution : Prop :=
  ∀ {R : Type u} [CommRing R] (x : List R),
    RingTheory.Sequence.IsRegular R x →
    ∃ π : listComplex x ⟶ (ChainComplex.single₀ (ModuleCat R)).obj
        (ModuleCat.of R (R ⧸ listIdeal x)),
      π.f 0 = augmentationZero x ∧ QuasiIso π ∧
      (∀ q : ℕ, Module.Free R ((listComplex x).X q) ∧
        Module.Finite R ((listComplex x).X q)) ∧
      (∀ q : ℕ, x.length < q → IsZero ((listComplex x).X q))

/-- Naturality is part of the identification, in every homological degree. -/
def homologyTor : Prop :=
  ∀ {R : Type u} [CommRing R] (x : List R),
    RingTheory.Sequence.IsRegular R x → ∀ q : ℕ,
    Nonempty (koszulHomologyFunctor.{u,v} x q ≅ quotientTorFunctor (listIdeal x) q)

/-- Pointwise identification, explicitly using the shared Koszul homology. -/
def homologyTorPointwise : Prop :=
  ∀ {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (x : List R), RingTheory.Sequence.IsRegular R x → ∀ q : ℕ,
    Nonempty (homology M x q ≅ (quotientTorFunctor (listIdeal x) q).obj (ModuleCat.of R M))

def regularTorVanish : Prop :=
  ∀ {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (x : List R), RingTheory.Sequence.IsRegular R x →
    RingTheory.Sequence.IsWeaklyRegular M x → ∀ q : ℕ, 0 < q →
    IsZero ((quotientTorFunctor (listIdeal x) q).obj (ModuleCat.of R M))

def coefficientAcyclicity : Prop :=
  ∀ {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (x : List R), RingTheory.Sequence.IsWeaklyRegular M x →
    ∀ q : ℕ, 0 < q → Subsingleton (homology M x q)

end Specs.AdvCommAlg.Koszul
