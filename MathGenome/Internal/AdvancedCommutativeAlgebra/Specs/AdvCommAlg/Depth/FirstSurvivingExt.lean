import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.RegularSequence.Definitions
import Mathlib.Algebra.Category.ModuleCat.Ext.HasExt
import Mathlib.Algebra.Homology.DerivedCategory.Ext.Linear
import Mathlib.Algebra.Homology.DerivedCategory.Ext.ExactSequences
import Mathlib.RingTheory.Regular.Category

/-! The comparison following DP-04, paper.tex:2768–2775.
The map below is the successive covariant connecting map, starting with
Hom = Ext⁰. Its inverse is the asserted first-Ext isomorphism. Quotients
are by the ideal generated by the whole ordered list. No maximality or
nonvanishing of the terminal Hom is required.
-/

universe u
open scoped Pointwise
open CategoryTheory CategoryTheory.Abelian

namespace AdvCommAlg.Depth.FirstSurvivingExt

variable {R : Type u} [CommRing R]

abbrev Quotient (M : ModuleCat.{u} R) (xs : List R) :=
  M ⧸ (Ideal.ofList xs • ⊤ : Submodule R M)

def quotientMap {M M' : ModuleCat.{u} R} (xs : List R) (g : M →ₗ[R] M') :
    Quotient M xs →ₗ[R] Quotient M' xs :=
  Submodule.mapQ _ _ g (Submodule.smul_top_le_comap_smul_top (Ideal.ofList xs) g)

def postHom {U V : Type u} [AddCommGroup U] [Module R U]
    [AddCommGroup V] [Module R V] (N : ModuleCat.{u} R) (g : U →ₗ[R] V) :
    (N →ₗ[R] U) →ₗ[R] (N →ₗ[R] V) where
  toFun f := g.comp f
  map_add' _ _ := by ext; simp
  map_smul' _ _ := by ext; simp

def nilQuotientEquiv (M : ModuleCat.{u} R) : Quotient M [] ≃ₗ[R] M :=
  Submodule.quotEquivOfEqBot _ (by simp)

/-- The iterated connecting map Hom(N,M/(xs)M) → Ext^length(xs)(N,M).
The cons step uses precisely the class of 0 → M --a→ M → M/aM → 0.
The nil step is the canonical degree-zero Ext identification.
-/
noncomputable def connectingMap (N M : ModuleCat.{u} R) :
    (xs : List R) → RingTheory.Sequence.IsRegular M xs →
      (N →ₗ[R] Quotient M xs) →ₗ[R] Ext N M xs.length
  | [], _ =>
    Ext.linearEquiv₀.symm.toLinearMap ∘ₗ
      ModuleCat.homLinearEquiv.symm.toLinearMap ∘ₗ
        postHom N (nilQuotientEquiv M).toLinearMap
  | a :: xs, h =>
    let ha := (RingTheory.Sequence.isRegular_cons_iff M a xs).mp h
    let V := ModuleCat.of R (QuotSMulTop a M)
    (ha.1.smulShortComplex_shortExact.extClass.postcompOfLinear R N rfl) ∘ₗ
      connectingMap N V xs ha.2 ∘ₗ
        postHom N (Submodule.quotOfListConsSMulTopEquivQuotSMulTopInner M a xs).toLinearMap

namespace Specs

def vanishingType : Prop :=
  ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    (N M : ModuleCat.{u} R) [Module.Finite R N] [Module.Finite R M]
    (xs : List R) (h : RingTheory.Sequence.IsRegular M xs)
    (hmem : ∀ a ∈ xs, a ∈ Module.annihilator R N),
    ∀ i < xs.length, Subsingleton (Ext N M i)

def comparisonType : Prop :=
  ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    (N M : ModuleCat.{u} R) [Module.Finite R N] [Module.Finite R M]
    (xs : List R) (h : RingTheory.Sequence.IsRegular M xs)
    (hmem : ∀ a ∈ xs, a ∈ Module.annihilator R N),
    ∃ e : Ext N M xs.length ≃ₗ[R] (N →ₗ[R] Quotient M xs),
      ∀ f, e.symm f = connectingMap N M xs h f

/-- Contravariant naturality, with the list fixed and regular on M. -/
def naturalityLeftType : Prop :=
  ∀ {R : Type u} [CommRing R] (N N' M : ModuleCat.{u} R)
    (xs : List R) (h : RingTheory.Sequence.IsRegular M xs)
    (g : N' →ₗ[R] N) (f : N →ₗ[R] Quotient M xs),
    connectingMap N' M xs h (f.comp g) =
      (Ext.mk₀ (ModuleCat.ofHom g)).comp (connectingMap N M xs h f) (zero_add _)

/-- Covariant naturality, with the list fixed and regular on both modules. -/
def naturalityRightType : Prop :=
  ∀ {R : Type u} [CommRing R] (N M M' : ModuleCat.{u} R)
    (xs : List R) (h : RingTheory.Sequence.IsRegular M xs)
    (h' : RingTheory.Sequence.IsRegular M' xs)
    (g : M →ₗ[R] M') (f : N →ₗ[R] Quotient M xs),
    connectingMap N M' xs h' ((quotientMap xs g).comp f) =
      (connectingMap N M xs h f).comp (Ext.mk₀ (ModuleCat.ofHom g)) (add_zero _)

end Specs
end AdvCommAlg.Depth.FirstSurvivingExt
