import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Differentials.Hypersurfaces
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed
import Mathlib.FieldTheory.Separable
import Mathlib.LinearAlgebra.Dimension.Finrank

/-! The finite simple and inseparable assertions of KD-22, paper.tex 429–445.
Integrality of α and K[α] = L express the finite simple algebraic hypothesis.
The quotient equivalence specifies the generator, not merely the dimension. -/
namespace Specs.AdvCommAlg.Differentials
universe u v
noncomputable section

/-- L/(f'(α)) dα for the actual minimal polynomial of an arbitrary generator. -/
def simpleFieldPresentation : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    (α : L), IsIntegral K α → Algebra.adjoin K {α} = ⊤ →
    ∃ e : (L ⧸ Ideal.span {Polynomial.aeval α (minpoly K α).derivative}) ≃ₗ[L]
        KaehlerDifferential K L,
      ∀ b : L, e (Ideal.Quotient.mk _ b) = b • KaehlerDifferential.D K L α

/-- A separable algebraic generator gives zero relative differentials. -/
def simpleSeparableVanishing : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    (α : L), IsIntegral K α → Algebra.adjoin K {α} = ⊤ →
    IsSeparable K α → Subsingleton (KaehlerDifferential K L)

/-- Any field generated by a root of the irreducible X^p-a has basis dα. -/
def purelyInseparableBasis : Prop :=
  ∀ (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    (p : ℕ) [Fact p.Prime] [CharP K p] (a : K)
    (_hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a))
    (α : L), α ^ p = algebraMap K L a → Algebra.adjoin K {α} = ⊤ →
    ∃ b : Module.Basis Unit L (KaehlerDifferential K L),
      b () = KaehlerDifferential.D K L α

/-- In particular the canonical field obtained by adjoining the root has dimension one. -/
def purelyInseparableAdjoinRoot : Prop :=
  ∀ (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p] (a : K)
    [Fact (Irreducible (Polynomial.X ^ p - Polynomial.C a))],
    let f : Polynomial K := Polynomial.X ^ p - Polynomial.C a
    (∃ b : Module.Basis Unit (AdjoinRoot f) (KaehlerDifferential K (AdjoinRoot f)),
      b () = KaehlerDifferential.D K (AdjoinRoot f) (AdjoinRoot.root f)) ∧
    Module.finrank (AdjoinRoot f) (KaehlerDifferential K (AdjoinRoot f)) = 1

end
end Specs.AdvCommAlg.Differentials
