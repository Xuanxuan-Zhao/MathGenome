import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Smooth.StandardPresentation
import Lean.Elab.Tactic.Omega

/-! SM-04, paper.tex:998–1019. All rings, including the zero ring, are
allowed. A presentation retains its specified generators and relations, and
its kernel is exactly the ideal generated by those relations.
`P.toExtension.Cotangent` is the canonical kernel modulo its square with the
B-action induced by the presentation map. No additional independence or
regular sequence hypothesis is imposed. -/
namespace Specs.AdvCommAlg.Smooth.InvertibleMinor

universe u v
noncomputable section

/-- With zero-based indices this is the variable numbered c+i, so these are
exactly the last n-c variables. -/
def trailingVariable {n c : ℕ} (h : c ≤ n) (i : Fin (n - c)) : Fin n :=
  ⟨c + i.val, by omega⟩

/-- Smoothness for every presentation admitting an invertible maximal minor. -/
def presentationSmooth : Prop := ∀ {A : Type u} {B : Type v}
  [CommRing A] [CommRing B] [Algebra A B] {n c : ℕ}
  (P : Algebra.Presentation A B (Fin n) (Fin c)),
  presentationStandardSmooth P → smoothValue A B

/-- The basis vectors are the specified relation classes in I/I². This
statement does not require reordering the variables. -/
def relationBasis : Prop := ∀ {A : Type u} {B : Type v}
  [CommRing A] [CommRing B] [Algebra A B] {n c : ℕ}
  (P : Algebra.Presentation A B (Fin n) (Fin c)),
  presentationStandardSmooth P →
    ∃ b : Module.Basis (Fin c) B P.toExtension.Cotangent,
      ∀ j, b j = Algebra.Extension.Cotangent.mk
        ⟨P.relation j, P.relation_mem_ker j⟩

/-- After the chosen rows have been moved to the initial c rows, the basis
vectors are exactly the differentials of the remaining specified generators.
Fin 0 is permitted for either basis, and no nontriviality is required. -/
def orderedDifferentialBasis : Prop := ∀ {A : Type u} {B : Type v}
  [CommRing A] [CommRing B] [Algebra A B] {n c : ℕ}
  (P : Algebra.Presentation A B (Fin n) (Fin c)) (h : c ≤ n),
  IsUnit (selectedMinor P ⟨Fin.castLE h, Fin.castLE_injective h⟩).det →
    ∃ b : Module.Basis (Fin (n - c)) B (KaehlerDifferential A B),
      ∀ i, b i = KaehlerDifferential.D A B (P.val (trailingVariable h i))

end
end Specs.AdvCommAlg.Smooth.InvertibleMinor
