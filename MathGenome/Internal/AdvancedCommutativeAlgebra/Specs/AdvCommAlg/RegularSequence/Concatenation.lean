import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.RegularSequence.Definitions

/-! Independent specifications for the concatenation assertions of RK-02,
paper.tex:2125–2127. No finiteness, locality or nonzero assumptions are imposed.
The tail acts on the quotient by the ideal generated by the entire prefix. -/

universe u v
open scoped Pointwise
namespace AdvCommAlg.RegularSequence.Specs

def weaklyRegular_append_iffType : Prop :=
  ∀ {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (x y : List R),
    RingTheory.Sequence.IsWeaklyRegular M (x ++ y) ↔
      RingTheory.Sequence.IsWeaklyRegular M x ∧
      RingTheory.Sequence.IsWeaklyRegular
        (M ⧸ (Ideal.ofList x • ⊤ : Submodule R M)) y

def regular_append_iffType : Prop :=
  ∀ {R : Type u} [CommRing R] (M : Type v) [AddCommGroup M] [Module R M]
    (x y : List R),
    RingTheory.Sequence.IsRegular M (x ++ y) ↔
      RingTheory.Sequence.IsRegular M x ∧
      RingTheory.Sequence.IsRegular
        (M ⧸ (Ideal.ofList x • ⊤ : Submodule R M)) y

end AdvCommAlg.RegularSequence.Specs
