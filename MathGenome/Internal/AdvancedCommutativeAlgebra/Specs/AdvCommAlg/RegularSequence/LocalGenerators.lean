import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.RegularSequence.Definitions
import Mathlib.RingTheory.LocalRing.Module
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

/-! RK-09, local assertions, paper.tex:2300–2313 and 2333–2341.
Minimality means that no position is generated by the remaining positions.
The residue tensor below is canonically I / m I. -/
noncomputable section
universe u v w
open Module
open scoped TensorProduct
namespace AdvCommAlg.RegularSequence

/-- Irredundancy keeps track of positions, including possible repetitions. -/
def Irredundant {R : Type u} [CommRing R] {N : Type v}
    [AddCommGroup N] [Module R N] {ι : Type w} (z : ι → N) : Prop :=
  ∀ i, z i ∉ Submodule.span R (z '' {i}ᶜ)

/-- A generating list with no removable position. -/
def MinimalGeneratingList {R : Type u} [CommRing R] (I : Ideal R) (x : List R) : Prop :=
  Ideal.ofList x = I ∧ Irredundant (R := R) x.get

/-- Entries of a list regarded as elements of the ideal they generate. -/
def idealEntries {R : Type u} [CommRing R] (x : List R) : Fin x.length → Ideal.ofList x :=
  fun i => ⟨x.get i, Ideal.subset_span (List.get_mem ..)⟩

namespace Specs

def localPermutation : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M] (x y : List R),
  (∀ a ∈ x, a ∈ IsLocalRing.maximalIdeal R) →
  RingTheory.Sequence.IsRegular M x → x.Perm y → RingTheory.Sequence.IsRegular M y

def regularMinimal : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M] (x : List R),
  (∀ a ∈ x, a ∈ IsLocalRing.maximalIdeal R) →
  RingTheory.Sequence.IsRegular M x → MinimalGeneratingList (Ideal.ofList x) x

/-- The images of minimal generators form an actual residue-field basis. -/
def minimalResidueBasis : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (x : List R), MinimalGeneratingList (Ideal.ofList x) x →
  ∃ b : Basis (Fin x.length) (IsLocalRing.ResidueField R)
      (IsLocalRing.ResidueField R ⊗[R] Ideal.ofList x),
    ∀ i, b i = 1 ⊗ₜ[R] idealEntries x i

/-- Literal quotient formulation, with the natural residue-field action. -/
def minimalQuotientBasis : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (x : List R), MinimalGeneratingList (Ideal.ofList x) x →
  ∃ b : Basis (Fin x.length) (R ⧸ IsLocalRing.maximalIdeal R)
      ((Ideal.ofList x) ⧸ (IsLocalRing.maximalIdeal R •
        (⊤ : Submodule R (Ideal.ofList x)))),
    ∀ i, b i = Submodule.Quotient.mk (idealEntries x i)

/-- An actual square matrix, after identifying the two equally long index sets. -/
def minimalChangeMatrix : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (I : Ideal R) (x y : List R),
  MinimalGeneratingList I x → MinimalGeneratingList I y →
  ∃ h : x.length = y.length,
    ∃ A : Matrix (Fin x.length) (Fin x.length) R, IsUnit A.det ∧
      ∀ i, x.get i = ∑ j, A j i * y.get (finCongr h j)

/-- The matrix columns give a linear equivalence between the coordinate modules.
Its compatibility says exactly that it changes one generating list to the other. -/
def minimalChangeCoordinates : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (I : Ideal R) (x y : List R),
  MinimalGeneratingList I x → MinimalGeneratingList I y →
  ∃ e : (Fin x.length → R) ≃ₗ[R] (Fin y.length → R),
    ∀ i, x.get i = ∑ j, (e (Pi.basisFun R (Fin x.length) i)) j * y.get j

def replacementRegular : Prop := ∀ {R : Type u} [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] (M : Type v) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M] (x y : List R),
  (∀ a ∈ x, a ∈ IsLocalRing.maximalIdeal R) →
  RingTheory.Sequence.IsRegular M x →
  MinimalGeneratingList (Ideal.ofList x) y → RingTheory.Sequence.IsRegular M y

end Specs
end AdvCommAlg.RegularSequence
