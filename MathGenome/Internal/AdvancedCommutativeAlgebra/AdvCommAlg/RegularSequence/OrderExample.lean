import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.RegularSequence.Definitions
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.RegularSequence.OrderExample
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring

/-! The order example after RK-02 (paper.tex:2149–2152).
Coordinate substitution identifies the kernels for the first two prefix ideals.
Their targets are domains, giving injective multiplication. Evaluation at zero
proves properness, and evaluation at one detects the reordered obstruction. -/

noncomputable section
universe u
open scoped Pointwise
namespace AdvCommAlg.RegularSequence.OrderExample
open MvPolynomial

variable (k : Type u) [Field k]

/-- The coordinate ideal generated by the first i variables. -/
private def coordinateIdeal (i : ℕ) : Ideal (Poly k) :=
  Ideal.span (MvPolynomial.X '' {j : Fin 3 | j.val < i})

/-- Set the first i coordinates to zero. -/
private def eraseCoordinates (i : ℕ) : Poly k →ₐ[k] Poly k :=
  aeval (fun j : Fin 3 => if j.val < i then 0 else MvPolynomial.X j)

private theorem coordinateIdeal_eq_ker (i : ℕ) :
    coordinateIdeal k i = RingHom.ker (eraseCoordinates k i).toRingHom := by
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨j, hj, rfl⟩
    change j.val < i at hj
    simp [eraseCoordinates, RingHom.mem_ker, hj]
  · intro p hp
    have hcomp : (Ideal.Quotient.mk (coordinateIdeal k i)).comp
        (eraseCoordinates k i).toRingHom = Ideal.Quotient.mk (coordinateIdeal k i) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [eraseCoordinates]
      · intro j
        by_cases hj : j.val < i
        · have hmem : MvPolynomial.X j ∈ coordinateIdeal k i :=
            Ideal.subset_span ⟨j, hj, rfl⟩
          simpa [eraseCoordinates, hj] using (Ideal.Quotient.eq_zero_iff_mem.mpr hmem).symm
        · simp [eraseCoordinates, hj]
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have heq := DFunLike.congr_fun hcomp p
    change eraseCoordinates k i p = 0 at hp
    change Ideal.Quotient.mk _ (eraseCoordinates k i p) = Ideal.Quotient.mk _ p at heq
    rw [hp, map_zero] at heq
    exact heq.symm

private theorem coordinateIdeal_zero : coordinateIdeal k 0 = ⊥ := by
  simp [coordinateIdeal]

private theorem coordinateIdeal_one : coordinateIdeal k 1 = Ideal.span {X (k := k)} := by
  rw [coordinateIdeal]
  congr 1
  ext p
  simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_singleton_iff]
  constructor
  · rintro ⟨j, hj, rfl⟩
    have : j = 0 := by omega
    subst j
    rfl
  · rintro rfl
    exact ⟨0, by decide, rfl⟩

private theorem coordinateIdeal_two : coordinateIdeal k 2 = Ideal.span {X (k := k), Y} := by
  rw [coordinateIdeal]
  congr 1
  ext p
  simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨j, hj, rfl⟩
    have : j = 0 ∨ j = 1 := by omega
    rcases this with rfl | rfl <;> simp [X, Y]
  · rintro (rfl | rfl)
    · exact ⟨0, by decide, rfl⟩
    · exact ⟨1, by decide, rfl⟩

private theorem firstTwoIdeal :
    Ideal.ofList ([X, Y * (1 - X)] : List (Poly k)) = coordinateIdeal k 2 := by
  rw [coordinateIdeal_two]
  change Ideal.span {a | a ∈ ([X, Y * (1 - X)] : List (Poly k))} = _
  have hs : {a | a ∈ ([X, Y * (1 - X)] : List (Poly k))} =
      {X (k := k), Y * (1 - X)} := by ext a; simp
  rw [hs]
  rw [show Y * (1 - X) = Y - Y * X (k := k) by ring]
  exact Ideal.span_pair_sub_mul_left _ _ _

private theorem regular_mod_coordinate {i : ℕ} {r : Poly k}
    (hr : eraseCoordinates k i r ≠ 0) :
    IsSMulRegular (Poly k ⧸ coordinateIdeal k i) r := by
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [coordinateIdeal_eq_ker, RingHom.mem_ker] at hp ⊢
  change eraseCoordinates k i (r * p) = 0 at hp
  change eraseCoordinates k i p = 0
  rw [map_mul] at hp
  exact (mul_eq_zero.mp hp).resolve_left hr

private theorem ideal_smul_top (I : Ideal (Poly k)) :
    I • (⊤ : Submodule (Poly k) (Poly k)) = I := Ideal.mul_top I

/-- The order X, Y(1-X), Z(1-X) is properly regular. -/
theorem ordered_regular :
    RingRegular ([X, Y * (1 - X), Z * (1 - X)] : List (Poly k)) := by
  constructor
  · rw [RingTheory.Sequence.isWeaklyRegular_iff_Fin]
    intro i
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
    intro p hp
    fin_cases i
    · change X * p ∈ (Ideal.ofList [] • ⊤ : Submodule (Poly k) (Poly k)) at hp
      change p ∈ (Ideal.ofList [] • ⊤ : Submodule (Poly k) (Poly k))
      rw [ideal_smul_top, Ideal.ofList_nil, ← coordinateIdeal_zero k] at hp ⊢
      exact mem_of_isSMulRegular_quotient_of_smul_mem
        (regular_mod_coordinate k (i := 0) (r := X) (by simp [eraseCoordinates, X])) hp
    · change (Y * (1 - X)) * p ∈
          (Ideal.ofList [X] • ⊤ : Submodule (Poly k) (Poly k)) at hp
      change p ∈ (Ideal.ofList [X] • ⊤ : Submodule (Poly k) (Poly k))
      rw [ideal_smul_top, Ideal.ofList_singleton, ← coordinateIdeal_one k] at hp ⊢
      exact mem_of_isSMulRegular_quotient_of_smul_mem
        (regular_mod_coordinate k (i := 1) (r := Y * (1 - X))
          (by simp [eraseCoordinates, X, Y])) hp
    · change (Z * (1 - X)) * p ∈
          (Ideal.ofList [X, Y * (1 - X)] • ⊤ : Submodule (Poly k) (Poly k)) at hp
      change p ∈ (Ideal.ofList [X, Y * (1 - X)] • ⊤ : Submodule (Poly k) (Poly k))
      rw [ideal_smul_top, firstTwoIdeal] at hp ⊢
      exact mem_of_isSMulRegular_quotient_of_smul_mem
        (regular_mod_coordinate k (i := 2) (r := Z * (1 - X))
          (by simp [eraseCoordinates, X, Z])) hp
  · have hle : Ideal.ofList ([X, Y * (1 - X), Z * (1 - X)] : List (Poly k)) ≤
        RingHom.ker (MvPolynomial.eval (fun _ : Fin 3 => (0 : k))) := by
      apply Ideal.span_le.mpr
      intro p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> simp [RingHom.mem_ker, X, Y, Z]
    intro h
    have htop : Ideal.ofList ([X, Y * (1 - X), Z * (1 - X)] : List (Poly k)) = ⊤ := by
      simpa only [ideal_smul_top] using h.symm
    have h1 := hle (htop ▸ (show (1 : Poly k) ∈ (⊤ : Ideal (Poly k)) from trivial))
    simp [RingHom.mem_ker] at h1

/-- Evaluation at X=1 (and Y=1) detects the nonzero class of Y. -/
theorem class_Y_nonzero_and_annihilated :
    let I : Ideal (Poly k) := Ideal.span {Y * (1 - X)}
    Ideal.Quotient.mk I Y ≠ 0 ∧
      Ideal.Quotient.mk I (Z * (1 - X)) * Ideal.Quotient.mk I Y = 0 := by
  dsimp only
  constructor
  · intro hzero
    have hy := Ideal.Quotient.eq_zero_iff_mem.mp hzero
    have hle : Ideal.span ({Y * (1 - X)} : Set (Poly k)) ≤
        RingHom.ker (MvPolynomial.eval (fun _ : Fin 3 => (1 : k))) := by
      apply Ideal.span_le.mpr
      rintro p rfl
      simp [RingHom.mem_ker, X, Y]
    have h1 := hle hy
    simp [RingHom.mem_ker, Y] at h1
  · rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    apply Ideal.mem_span_singleton.mpr
    exact ⟨Z, by ring⟩

/-- In the rotated order the second multiplication already fails to be injective. -/
theorem rotated_not_weaklyRegular :
    ¬ WeaklyRegular (Poly k) ([Y * (1 - X), Z * (1 - X), X] : List (Poly k)) := by
  intro h
  have hreg := h.regular_mod_prev 1 (by simp)
  have hmem := (isSMulRegular_quotient_iff_mem_of_smul_mem _ _).mp hreg
  change ∀ p : Poly k, (Z * (1 - X)) * p ∈
      (Ideal.ofList [Y * (1 - X)] • ⊤ : Submodule (Poly k) (Poly k)) →
    p ∈ (Ideal.ofList [Y * (1 - X)] • ⊤ : Submodule (Poly k) (Poly k)) at hmem
  rw [ideal_smul_top, Ideal.ofList_singleton] at hmem
  have hw := class_Y_nonzero_and_annihilated k
  apply hw.1
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  apply hmem
  apply Ideal.mem_span_singleton.mpr
  exact ⟨Z, by ring⟩

end AdvCommAlg.RegularSequence.OrderExample
