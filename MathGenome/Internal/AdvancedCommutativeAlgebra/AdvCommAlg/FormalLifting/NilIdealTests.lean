import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.FormalLifting.NilpotentTests
import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.FormalLifting.PolynomialLifts
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.FormalLifting.NilIdealTests
import Mathlib.RingTheory.Noetherian.Nilpotent

/-! FL-18: finite relation errors, respectively finite generator differences,
generate a nilpotent ideal contained in the given nil ideal. Apply FL-02 to
that smaller ideal. No Noetherian or nonzero-ring hypothesis is needed.
-/
namespace AdvCommAlg.FormalLifting

universe u v w

open Specs.AdvCommAlg.FormalLifting

/-- Every finitely generated subideal of a nil ideal is nilpotent. -/
lemma nilpotent_of_fg_le_nil {C : Type w} [CommRing C] {J N : Ideal C}
    (hJ : J.FG) (hJN : J ≤ N) (hN : ∀ x ∈ N, IsNilpotent x) :
    IsNilpotent J :=
  hJ.isNilpotent_iff_le_nilradical.mpr (fun x hx => hN x (hJN hx))

/-- Finite presentation reduces existence through a nil ideal to existence
through a finitely generated nilpotent subideal. -/
theorem smooth_nil_reduction_surjective : smoothNilReduction.{u,v,w} := by
  intro A B C _ _ _ _ _ _ h N hN f
  obtain ⟨n, p, hp, hker⟩ := Algebra.FinitePresentation.out (R := A) (A := B)
  obtain ⟨g, hg⟩ := polynomial_lifts A (Fin n) C (C ⧸ N)
    (Ideal.Quotient.mkₐ A N) Ideal.Quotient.mk_surjective (f.comp p)
  let J : Ideal C := (RingHom.ker p.toRingHom).map g.toRingHom
  have hJN : J ≤ N := by
    apply Ideal.map_le_iff_le_comap.mpr
    intro x hx
    change g x ∈ N
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have he := DFunLike.congr_fun hg x
    change Ideal.Quotient.mk N (g x) = f (p x) at he
    change p x = 0 at hx
    simpa only [hx, map_zero] using he
  have hJ : IsNilpotent J := nilpotent_of_fg_le_nil (hker.map g.toRingHom) hJN hN
  have hdesc : RingHom.ker p.toRingHom ≤
      RingHom.ker ((Ideal.Quotient.mkₐ A J).comp g).toRingHom := by
    intro x hx
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem g.toRingHom hx)
  let f₀ : B →ₐ[A] C ⧸ J :=
    p.liftOfSurjective hp ((Ideal.Quotient.mkₐ A J).comp g) hdesc
  obtain ⟨l, hl⟩ := smooth_nilpotent_reduction_surjective h J hJ f₀
  refine ⟨l, ?_⟩
  apply (AlgHom.cancel_right hp).mp
  apply AlgHom.ext
  intro x
  have hlx := DFunLike.congr_fun hl (p x)
  change Ideal.Quotient.mk J (l (p x)) = f₀ (p x) at hlx
  rw [AlgHom.liftOfSurjective_apply] at hlx
  have he := congrArg (Ideal.Quotient.factorₐ A hJN) hlx
  change Ideal.Quotient.mk N (l (p x)) = Ideal.Quotient.mk N (g x) at he
  exact he.trans (DFunLike.congr_fun hg x)

/-- Finite type reduces uniqueness through a nil ideal to uniqueness through
the nilpotent ideal generated by the differences on algebra generators. -/
theorem unramified_nil_reduction_injective : unramifiedNilReduction.{u,v,w} := by
  intro A B C _ _ _ _ _ _ h N hN f g hfg
  obtain ⟨n, p, hp⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType A B)
  let d : Fin n → C := fun i => f (p (MvPolynomial.X i)) - g (p (MvPolynomial.X i))
  let J : Ideal C := Ideal.span (Set.range d)
  have hJN : J ≤ N := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact Ideal.Quotient.eq.mp (DFunLike.congr_fun hfg (p (MvPolynomial.X i)))
  have hJ : IsNilpotent J := nilpotent_of_fg_le_nil
    (Submodule.fg_span (Set.finite_range d)) hJN hN
  apply unramified_nilpotent_reduction_injective h J hJ
  apply (AlgHom.cancel_right hp).mp
  apply MvPolynomial.algHom_ext
  intro i
  exact Ideal.Quotient.eq.mpr (Ideal.subset_span (Set.mem_range_self i))

/-- Combine existence and uniqueness for finitely presented formally étale
algebras, retaining the elementwise nil hypothesis. -/
theorem etale_nil_reduction_bijective : etaleNilReduction.{u,v,w} := by
  intro A B C _ _ _ _ _ _ h N hN
  let : Algebra.FormallyEtale A B := (formallyEtale_iff A B).mp h
  exact ⟨unramified_nil_reduction_injective
      ((formallyUnramified_iff A B).mpr inferInstance) N hN,
    smooth_nil_reduction_surjective ((formallySmooth_iff A B).mpr inferInstance) N hN⟩

end AdvCommAlg.FormalLifting
