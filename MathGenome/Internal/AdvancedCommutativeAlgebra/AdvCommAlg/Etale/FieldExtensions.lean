import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Etale.Definitions
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Etale.FieldExtensions
import Mathlib.RingTheory.Etale.Field

/-! ET-10: arbitrary separable algebraic extensions are formally étale;
finite extensions are étale precisely when separable; among extensions
finitely generated as fields, formal unramifiedness means finite separable.
-/
namespace AdvCommAlg.Etale

universe u v

open Specs.AdvCommAlg.Etale.FieldExtensions

/-- Mathlib's separability hypothesis includes algebraicity. Its formal étale
field theorem also covers infinite algebraic extensions. -/
theorem separable_formallyEtale : separableFormallyEtale.{u,v} := by
  intro K L _ _ _ hsep
  let := hsep
  apply (FormalLifting.formallyEtale_iff K L).mpr
  exact Algebra.FormallyEtale.of_isSeparable K L

/-- A finite extension is automatically of finite presentation over its base field. -/
theorem finite_etale_iff_separable : finiteEtaleIffSeparable.{u,v} := by
  intro K L _ _ _ _
  change Algebra.Etale K L ↔ Algebra.IsSeparable K L
  constructor
  · intro h
    let := h
    exact Algebra.FormallyUnramified.isSeparable K L
  · intro h
    let := h
    exact ⟨Algebra.FormallyEtale.of_isSeparable K L,
      Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩

/-- A field generated by a finite set is the fraction field of the algebra
generated by that same set, and hence is essentially of finite type. -/
theorem finitelyGenerated_essFiniteType : finitelyGeneratedEssFiniteType.{u,v} := by
  intro K L _ _ _ hfg
  exact IntermediateField.fg_top_iff.mp hfg

/-- Use field generation, rather than algebra generation, to supply the
essentially finite type hypothesis in the field separability criterion. -/
theorem finitelyGenerated_unramified_iff : finitelyGeneratedUnramifiedIff.{u,v} := by
  intro K L _ _ _ hfg
  let := finitelyGenerated_essFiniteType K L hfg
  constructor
  · intro h
    let := (FormalLifting.formallyUnramified_iff K L).mp h
    have hsep : Algebra.IsSeparable K L := Algebra.FormallyUnramified.isSeparable K L
    let := hsep
    exact ⟨Algebra.finite_of_essFiniteType_of_isAlgebraic (F := K) (E := L), hsep⟩
  · rintro ⟨_, hsep⟩
    let := hsep
    apply (FormalLifting.formallyUnramified_iff K L).mpr
    exact Algebra.FormallyUnramified.of_isSeparable K L

end AdvCommAlg.Etale
