import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Etale.Permanence
import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Etale.TowerCancellation
import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Etale.QuotientsAndIdempotents
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Etale.DiagonalIdempotent

namespace AdvCommAlg.Etale

universe u v

open scoped TensorProduct
open Specs.AdvCommAlg.Etale.Diagonal

/-- The multiplication map of an étale algebra is the localization at a
complementary idempotent, with kernel generated by that idempotent. -/
theorem diagonal_idempotent : diagonalIdempotent.{u,v} := by
  intro A B _ _ _ h
  let D := B ⊗[A] B
  let μ : D →ₐ[B] B := multiplication A B
  let : Algebra D B := multiplicationAlgebra A B
  have hsurj : Function.Surjective μ := by
    intro b
    exact ⟨b ⊗ₜ[A] (1 : B), mul_one b⟩
  let : IsScalarTower B D B :=
    IsScalarTower.of_algebraMap_eq fun b => (μ.commutes b).symm
  have hBD : Etale B D := etale_base_change A B B h
  have hDB : Etale D B := etale_tower_cancellation B D B hBD (show Algebra.Etale B B from inferInstance)
  let : Algebra.Etale D B := hDB
  let q : (D ⧸ RingHom.ker μ.toRingHom) ≃ₐ[D] B :=
    Ideal.quotientKerAlgEquivOfSurjective
      (f := IsScalarTower.toAlgHom D D B) hsurj
  have hquot : Etale D (D ⧸ RingHom.ker μ.toRingHom) :=
    Algebra.Etale.of_equiv q.symm
  obtain ⟨e, he, hker⟩ := (etale_quotient_iff D (RingHom.ker μ.toRingHom)).mp hquot
  let φ := q.symm.trans (quotientLocalization D (RingHom.ker μ.toRingHom) e he hker)
  refine ⟨e, he, hker, φ, ?_⟩
  intro x
  exact φ.commutes x

end AdvCommAlg.Etale
