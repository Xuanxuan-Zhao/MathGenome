noncomputable section
open scoped TensorProduct
open CategoryTheory
universe u v

namespace AdvCommAlg.Koszul.DegreeOneGradedComparison
open AdvCommAlg.RegularSequence.GradedComparison.Core hiding comparison
open P103.Rees
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable {R : Type u} [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- The coefficient form of injectivity in each homogeneous degree. -/
def HomogeneousRelations (x : List R) : Prop :=
  ∀ (n : ℕ) (s : Finset (Fin x.length →₀ ℕ))
    (hd : ∀ d ∈ s, d.degree = n) (m : (Fin x.length →₀ ℕ) → M),
    (homogeneousEvaluation M x n s hd m).1 ∈
      (sequenceIdeal x ^ (n+1) • (⊤ : Submodule R M)) →
    ∀ d ∈ s, m d ∈ (sequenceIdeal x • (⊤ : Submodule R M))

/-- Degree-one vanishing makes the last entry injective modulo the prefix. -/
theorem last_quotient_injective (pre : List R) (a : R)
    (h : Subsingleton (homology M (pre ++ [a]) 1)) :
    Function.Injective (fun q : M ⧸ listSubmodule M pre => a • q) := by
  have hi := ((append_homology_vanish_iff M pre a 0).mp h).2
  let e := homologyZeroEquiv M pre
  intro q q' he
  apply e.symm.injective
  apply hi
  simpa only [map_smul] using congrArg e.symm he

/-- Injectivity of one multiplication implies injectivity of all its powers. -/
theorem power_smul_injective {N : Type*} [AddCommGroup N] [Module R N]
    (a : R) (h : Function.Injective (fun q : N => a • q)) (n : ℕ) :
    Function.Injective (fun q : N => a^n • q) := by
  induction n with
  | zero => intro q q' he; simpa only [pow_zero, one_smul] using he
  | succ n ih =>
    simpa only [pow_succ, mul_smul, Function.comp_def] using ih.comp h

/-- Cancellation modulo the prefix is the pure-power step of the source proof. -/
theorem pure_power_relation_of_injective (pre : List R) (a : R)
    (h : Function.Injective (fun q : M ⧸ listSubmodule M pre => a • q))
    (n : ℕ) (m m' : M)
    (hm : a^n • (m - a • m') ∈ listSubmodule M pre) :
    m ∈ listSubmodule M (pre ++ [a]) := by
  have hi := power_smul_injective a h n
  have hzero : (Submodule.Quotient.mk (m - a • m') : M ⧸ listSubmodule M pre) = 0 := by
    apply hi
    simpa only [Submodule.Quotient.mk_smul, smul_zero] using
      (Submodule.Quotient.mk_eq_zero (listSubmodule M pre)).mpr hm
  have hmem := (Submodule.Quotient.mk_eq_zero (listSubmodule M pre)).mp hzero
  have hle : listSubmodule M pre ≤ listSubmodule M (pre ++ [a]) := by
    apply Submodule.smul_mono (Ideal.span_mono ?_) le_rfl
    intro r hr
    exact List.mem_append_left _ hr
  have ha : a • m' ∈ listSubmodule M (pre ++ [a]) :=
    Submodule.smul_mem_smul (Ideal.subset_span (by simp)) Submodule.mem_top
  simpa only [sub_add_cancel] using (listSubmodule M (pre ++ [a])).add_mem (hle hmem) ha

/-- Modulo J, a power of J+(a) is generated by the corresponding power of a. -/
theorem sup_principal_power_le (J : Ideal R) (a : R) (k : ℕ) :
    (J ⊔ Ideal.span {a}) ^ k ≤ J ⊔ Ideal.span {a^k} := by
  have he : Ideal.map (Ideal.Quotient.mk J) ((J ⊔ Ideal.span {a}) ^ k) =
      Ideal.map (Ideal.Quotient.mk J) (Ideal.span {a^k}) := by
    rw [Ideal.map_pow, Ideal.map_sup, Ideal.map_quotient_self, bot_sup_eq,
      Ideal.map_span, Set.image_singleton, Ideal.span_singleton_pow,
      Ideal.map_span, Set.image_singleton, map_pow]
  calc
    _ ≤ Ideal.comap (Ideal.Quotient.mk J)
        (Ideal.map (Ideal.Quotient.mk J) ((J ⊔ Ideal.span {a}) ^ k)) := Ideal.le_comap_map
    _ = J ⊔ Ideal.span {a^k} := by rw [he, Ideal.comap_map_quotientMk]

/-- Every element of I^k M is a^k times something, modulo the prefix ideal. -/
theorem power_mod_prefix (pre : List R) (a : R) (k : ℕ) (z : M)
    (hz : z ∈ (sequenceIdeal (pre ++ [a]) ^ k • (⊤ : Submodule R M))) :
    ∃ m' : M, z - a^k • m' ∈ listSubmodule M pre := by
  have hle : sequenceIdeal (pre ++ [a]) ^ k • (⊤ : Submodule R M) ≤
      listSubmodule M pre ⊔ (Ideal.span {a^k} • (⊤ : Submodule R M)) := by
    change sequenceIdeal (pre ++ [a]) ^ k • (⊤ : Submodule R M) ≤
      Ideal.ofList pre • ⊤ ⊔ Ideal.span {a^k} • ⊤
    rw [← Submodule.sup_smul]
    apply Submodule.smul_mono _ le_rfl
    simpa only [sequenceIdeal, Ideal.ofList_append, Ideal.ofList_singleton] using
      sup_principal_power_le (Ideal.ofList pre) a k
  obtain ⟨j, hj, b, hb, he⟩ := Submodule.mem_sup.mp (hle hz)
  rw [Submodule.ideal_span_singleton_smul] at hb
  obtain ⟨m', _, hm'⟩ := (Submodule.mem_smul_pointwise_iff_exists b (a^k) ⊤).mp hb
  refine ⟨m', ?_⟩
  rw [← he, ← hm', add_sub_cancel_right]
  exact hj

/-- The pure-power coefficient belongs to IM. This formulation lets the
generic coordinate argument supply its congruence without expanding a binomial. -/
theorem pure_power_coefficient_of_injective (pre : List R) (a : R)
    (h : Function.Injective (fun q : M ⧸ listSubmodule M pre => a • q))
    (n : ℕ) (z m : M)
    (hz : z ∈ (sequenceIdeal (pre ++ [a]) ^ (n+1) • (⊤ : Submodule R M)))
    (hm : z - a^n • m ∈ listSubmodule M pre) :
    m ∈ listSubmodule M (pre ++ [a]) := by
  obtain ⟨m', hm'⟩ := power_mod_prefix M pre a (n+1) z hz
  apply pure_power_relation_of_injective M pre a h n m m'
  have he : a^n • (m - a • m') = (z - a^(n+1) • m') - (z - a^n • m) := by
    rw [smul_sub, pow_succ, mul_smul]
    abel
  rw [he]
  exact (listSubmodule M pre).sub_mem hm' hm

theorem pure_power_coefficient (pre : List R) (a : R)
    (h : Subsingleton (homology M (pre ++ [a]) 1))
    (n : ℕ) (z m : M)
    (hz : z ∈ (sequenceIdeal (pre ++ [a]) ^ (n+1) • (⊤ : Submodule R M)))
    (hm : z - a^n • m ∈ listSubmodule M pre) :
    m ∈ listSubmodule M (pre ++ [a]) :=
  pure_power_coefficient_of_injective M pre a (last_quotient_injective M pre a h) n z m hz hm

/-- The empty-list case of the coefficient criterion includes every module. -/
theorem homogeneousRelations_nil : HomogeneousRelations M ([] : List R) := by
  classical
  letI : IsEmpty (Fin ([] : List R).length) := ⟨fun i => Fin.elim0 i⟩
  intro n s hd m hz d hs
  have he : (homogeneousEvaluation M [] n s hd m).1 = m d := by
    change (∑ b ∈ s, monomialValue [] b • m b) = m d
    rw [Finset.sum_eq_single d]
    · have hd0 : d = 0 := Subsingleton.elim _ _
      subst d
      simp [monomialValue]
    · intro b hb hbd
      exact (hbd (Subsingleton.elim _ _)).elim
    · intro h
      exact (h hs).elim
  rw [he] at hz
  simpa [sequenceIdeal] using hz

/-- Reordering a selected generator leaves its generated submodule unchanged. -/
theorem listSubmodule_move (pre post : List R) (a : R) :
    listSubmodule M (pre ++ a :: post) = listSubmodule M ((pre ++ post) ++ [a]) := by
  change Ideal.ofList (pre ++ a :: post) • (⊤ : Submodule R M) =
    Ideal.ofList ((pre ++ post) ++ [a]) • ⊤
  simp only [Ideal.ofList_append, Ideal.ofList_cons, Ideal.ofList_nil, sup_bot_eq]
  congr 1
  ac_rfl

theorem listSubmodule_append_singleton (pre : List R) (a : R) :
    listSubmodule M (pre ++ [a]) = listSubmodule M pre ⊔
      Ideal.span {a} • (⊤ : Submodule R M) := by
  change Ideal.ofList (pre ++ [a]) • (⊤ : Submodule R M) = Ideal.ofList pre • ⊤ ⊔ _
  rw [Ideal.ofList_append, Ideal.ofList_singleton, Submodule.sup_smul]

/-- Cancel a power against the next power in a principal summand. -/
theorem cancel_power_mod (J : Submodule R M) (a : R)
    (hi : Function.Injective (fun q : M ⧸ J => a • q)) (k : ℕ) (z : M)
    (hz : a^k • z ∈ J ⊔ Ideal.span {a^(k+1)} • (⊤ : Submodule R M)) :
    z ∈ J ⊔ Ideal.span {a} • (⊤ : Submodule R M) := by
  obtain ⟨j, hj, b, hb, he⟩ := Submodule.mem_sup.mp hz
  rw [Submodule.ideal_span_singleton_smul] at hb
  obtain ⟨m', _, hm'⟩ := (Submodule.mem_smul_pointwise_iff_exists b (a^(k+1)) ⊤).mp hb
  have hz' : a^k • (z - a • m') ∈ J := by
    rw [smul_sub, ← mul_smul, ← pow_succ, hm']
    rw [← he, add_sub_cancel_right]
    exact hj
  have hzero : (Submodule.Quotient.mk (z - a • m') : M ⧸ J) = 0 := by
    apply power_smul_injective a hi k
    simpa only [Submodule.Quotient.mk_smul, smul_zero] using
      (Submodule.Quotient.mk_eq_zero J).mpr hz'
  have hmem := (Submodule.Quotient.mk_eq_zero J).mp hzero
  have ha : a • m' ∈ Ideal.span {a} • (⊤ : Submodule R M) :=
    Submodule.smul_mem_smul (Ideal.subset_span (by simp)) Submodule.mem_top
  simpa only [sub_add_cancel] using
    (J ⊔ Ideal.span {a} • (⊤ : Submodule R M)).add_mem
      ((show J ≤ J ⊔ Ideal.span {a} • (⊤ : Submodule R M) from le_sup_left) hmem)
      ((show Ideal.span {a} • (⊤ : Submodule R M) ≤ J ⊔ _ from le_sup_right) ha)

/-- Cancel a monomial from the ideal generated by the next power of each
coordinate. A fixed prefix records the coordinates already cancelled. -/
theorem cancel_monomial_box (l : List (R × ℕ)) (pre : List R)
    (h : Subsingleton (homology M (pre ++ l.map Prod.fst) 1)) (m : M)
    (hm : (l.map (fun p => p.1 ^ p.2)).prod • m ∈
      listSubmodule M (pre ++ l.map (fun p => p.1 ^ (p.2+1)))) :
    m ∈ listSubmodule M (pre ++ l.map Prod.fst) := by
  induction l generalizing pre with
  | nil => simpa using hm
  | cons p l ih =>
    rcases p with ⟨a,k⟩
    let tail := l.map (fun p => p.1 ^ (p.2+1))
    have ht : Subsingleton (homology M (pre ++ a :: tail) 1) := by
      have he : List.zipWith (fun a k => a^k) (l.map Prod.fst)
          (l.map (fun p => p.2+1)) = tail := by
        induction l with
        | nil => rfl
        | cons p l ih => simp [tail] at *
      have hh := homology_powers_append M (l.map Prod.fst)
        (l.map (fun p => p.2+1)) 0 (by simp)
        (by intro k hk; obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hk; omega)
        (pre ++ [a]) (by simpa [List.append_assoc] using h)
      rw [he] at hh
      simpa [List.append_assoc] using hh
    have hi := last_quotient_injective M (pre ++ tail) a
      ((coordinate_homology_vanish_iff M pre tail a 1).mp ht)
    have hm' : a^k • ((l.map (fun p => p.1^p.2)).prod • m) ∈
        listSubmodule M (pre ++ tail) ⊔
          Ideal.span {a^(k+1)} • (⊤ : Submodule R M) := by
      have hh := hm
      simp only [List.map_cons, List.prod_cons, mul_smul] at hh
      rw [listSubmodule_move M pre tail (a^(k+1))] at hh
      simpa only [listSubmodule_append_singleton] using hh
    have hc := cancel_power_mod M (listSubmodule M (pre ++ tail)) a hi k _ hm'
    have hc' : (l.map (fun p => p.1^p.2)).prod • m ∈
        listSubmodule M ((pre ++ [a]) ++ tail) := by
      rw [List.append_assoc, List.singleton_append, listSubmodule_move M pre tail a]
      simpa only [listSubmodule_append_singleton] using hc
    have hh := ih (pre ++ [a]) (by simpa [List.append_assoc] using h) hc'
    simpa [List.append_assoc] using hh

/-- The rectangular monomial ideal attached to an exponent vector. -/
def boxIdeal (x : List R) (d : Fin x.length →₀ ℕ) : Ideal R :=
  Ideal.span (Set.range (fun i : Fin x.length => x[i] ^ (d i+1)))

theorem monomialValue_eq_prod (x : List R) (d : Fin x.length →₀ ℕ) :
    monomialValue x d = ∏ i : Fin x.length, x[i] ^ d i :=
  Finsupp.prod_fintype d _ (by simp)

/-- Distinct exponent vectors of at least the same total degree escape the
rectangle in some coordinate. -/
theorem exists_exponent_lt {ι : Type*} [Fintype ι] (d b : ι →₀ ℕ)
    (hd : d.degree ≤ b.degree) (hne : b ≠ d) : ∃ i, d i < b i := by
  classical
  by_contra! hle
  have hstrict : ∃ i, b i < d i := by
    by_contra! he
    exact hne (by ext i; exact Nat.le_antisymm (hle i) (he i))
  have hh : b.degree < d.degree := by
    rw [Finsupp.degree_eq_sum, Finsupp.degree_eq_sum]
    exact Finset.sum_lt_sum (fun i _ => hle i)
      (by obtain ⟨i, hi⟩ := hstrict; exact ⟨i, Finset.mem_univ _, hi⟩)
  omega

/-- A monomial outside the rectangle belongs to its defining ideal. -/
theorem monomial_mem_box (x : List R) (d b : Fin x.length →₀ ℕ)
    (hi : ∃ i, d i < b i) : monomialValue x b ∈ boxIdeal x d := by
  classical
  obtain ⟨i, hi⟩ := hi
  apply (boxIdeal x d).mem_of_dvd
    ((pow_dvd_pow x[i] (by omega : d i+1 ≤ b i)).trans ?_)
    (Ideal.subset_span ⟨i, rfl⟩)
  rw [monomialValue_eq_prod]
  exact Finset.dvd_prod_of_mem _ (Finset.mem_univ i)

/-- All terms of degree greater than the rectangle's total degree vanish
modulo its defining ideal. -/
theorem ideal_power_le_box (x : List R) (d : Fin x.length →₀ ℕ) :
    sequenceIdeal x ^ (d.degree+1) ≤ boxIdeal x d := by
  classical
  intro z hz
  rw [← AdvCommAlg.RegularSequence.GradedComparison.generators_span x] at hz
  obtain ⟨p, hp, rfl⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous
    (fun i : Fin x.length => x[i]) z).mp hz
  rw [MvPolynomial.eval_eq]
  apply (boxIdeal x d).sum_mem
  intro b hb
  apply (boxIdeal x d).mul_mem_left
  change monomialValue x b ∈ boxIdeal x d
  apply monomial_mem_box
  have hd : b.degree = d.degree+1 := by
    simpa only [Finsupp.degree_apply] using (hp.degree_eq_sum_deg_support hb).symm
  apply exists_exponent_lt d b (by omega)
  intro he
  have := congrArg Finsupp.degree he
  omega

/-- Degree-one acyclicity cancels an arbitrary monomial from its rectangle. -/
theorem monomial_box_coefficient (x : List R)
    (h : Subsingleton (homology M x 1)) (d : Fin x.length →₀ ℕ) (m : M)
    (hm : monomialValue x d • m ∈ boxIdeal x d • (⊤ : Submodule R M)) :
    m ∈ listSubmodule M x := by
  classical
  let l : List (R × ℕ) := List.ofFn (fun i : Fin x.length => (x[i], d i))
  have hx : l.map Prod.fst = x := by
    dsimp [l]
    rw [List.map_ofFn]
    exact List.ofFn_getElem
  have hp : (l.map (fun p => p.1^p.2)).prod = monomialValue x d := by
    dsimp [l]
    rw [List.map_ofFn, List.prod_ofFn, monomialValue_eq_prod]
    rfl
  have hb : listIdeal (l.map (fun p => p.1^(p.2+1))) = boxIdeal x d := by
    unfold listIdeal boxIdeal
    congr 1
    ext a
    simp [l, List.mem_ofFn, Function.comp_def]
  have hc := cancel_monomial_box M l [] (by simpa [hx] using h) m (by
    simpa only [List.nil_append, hp, listSubmodule, hb] using hm)
  simpa [hx] using hc

namespace GC
open AdvCommAlg.RegularSequence.GradedComparison

/-- The coefficient criterion kills any homogeneous element of the kernel. -/
theorem homogeneous_kernel_eq_zero (x : List R) (h : HomogeneousRelations M x)
    (n : ℕ) (p : PolynomialModule M x) (hp : PolynomialHomogeneous M x n p)
    (hz : comparison M x p = 0) : p = 0 := by
  classical
  let c := polynomialCoefficients M x p
  let s := c.support
  have hd : ∀ d ∈ s, d.degree = n := fun d hd => hp d (Finsupp.mem_support_iff.mp hd)
  have hm : ∀ d, ∃ m : M, (Submodule.Quotient.mk m : Coefficients (sequenceIdeal x) M) = c d :=
    fun d => (sequenceIdeal x • (⊤ : Submodule R M)).mkQ_surjective (c d)
  choose m hm using hm
  have he : p = ∑ d ∈ s, MvPolynomial.monomial d 1 ⊗ₜ Submodule.Quotient.mk (m d) := by
    rw [polynomial_expansion M x p]
    simp only [Finsupp.sum, hm]
    rfl
  have heval : (homogeneousEvaluation M x n s hd m).1 ∈
      (sequenceIdeal x ^ (n+1) • (⊤ : Submodule R M)) := by
    rw [he, comparison_homogeneous_sum M x n s hd m] at hz
    exact (moduleClass_eq_zero_iff _ _ _ _).mp hz
  have hc : c = 0 := by
    ext d
    by_cases hs : d ∈ s
    · rw [← hm d]
      exact (Submodule.Quotient.mk_eq_zero _).mpr (h n s hd m heval d hs)
    · exact Finsupp.notMem_support_iff.mp hs
  apply (polynomialCoefficients M x).injective
  simpa only [map_zero] using hc

/-- Degree projections reduce injectivity of the canonical comparison to
the homogeneous coefficient criterion. -/
theorem comparison_injective_of_homogeneousRelations (x : List R)
    (h : HomogeneousRelations M x) : Function.Injective (comparison M x) := by
  have hk : ∀ p, comparison M x p = 0 → p = 0 := by
    intro p hp
    apply (polynomialCoefficients M x).injective
    ext d
    have hz : homogeneousPart M x d.degree p = 0 := by
      apply homogeneous_kernel_eq_zero M x h d.degree _ (homogeneousPart_homogeneous M x _ p)
      rw [comparison_homogeneousPart, hp, map_zero]
    have he := congrArg (fun q => polynomialCoefficients M x q d) hz
    simpa only [homogeneousPart, LinearEquiv.apply_symm_apply, Finsupp.filter_apply,
      ite_true, map_zero, Finsupp.zero_apply] using he
  intro p q hpq
  exact sub_eq_zero.mp (hk (p-q) (by rw [map_sub, hpq, sub_self]))

end GC

/-- Isolate each coefficient in its rectangular monomial quotient, then cancel
the monomial using degree-one acyclicity of the independently powered lists. -/
theorem homogeneous_relations_of_homology_one (x : List R)
    (h : Subsingleton (homology M x 1)) : HomogeneousRelations M x := by
  classical
  intro n s hd m hz d hs
  apply monomial_box_coefficient M x h d (m d)
  let B := boxIdeal x d • (⊤ : Submodule R M)
  have heval : (homogeneousEvaluation M x n s hd m).1 ∈ B := by
    have hle := Submodule.smul_mono (ideal_power_le_box x d)
      (le_rfl : (⊤ : Submodule R M) ≤ ⊤)
    rw [hd d hs] at hle
    exact hle hz
  have hrest : ∑ b ∈ s.erase d, monomialValue x b • m b ∈ B := by
    apply B.sum_mem
    intro b hb
    obtain ⟨hne, hb⟩ := Finset.mem_erase.mp hb
    exact Submodule.smul_mem_smul
      (monomial_mem_box x d b (exists_exponent_lt d b
        (by rw [hd d hs, hd b hb]) hne)) Submodule.mem_top
  have he := Finset.sum_erase_add s (fun b => monomialValue x b • m b) hs
  change (∑ b ∈ s, monomialValue x b • m b) ∈ B at heval
  rw [← he] at heval
  simpa only [add_sub_cancel_left] using B.sub_mem heval hrest

end AdvCommAlg.Koszul.DegreeOneGradedComparison

namespace AdvCommAlg.Koszul
open AdvCommAlg.RegularSequence.GradedComparison
open AdvCommAlg.RegularSequence.GradedComparison.Core hiding comparison
open P103.Rees

/-- RK-15 uses the exact canonical evaluation map of RK-11. -/
theorem degree_one_comparison_bijective :
    Specs.AdvCommAlg.Koszul.degreeOneComparisonBijective.{u,v} := by
  intro R _ M _ _ x h
  exact ⟨DegreeOneGradedComparison.GC.comparison_injective_of_homogeneousRelations M x
    (DegreeOneGradedComparison.homogeneous_relations_of_homology_one M x h),
    comparison_surjective M x⟩

/-- The isomorphism and its inverse respect the homogeneous grading. -/
theorem degree_one_comparison_gradedIso :
    Specs.AdvCommAlg.Koszul.degreeOneComparisonGradedIso.{u,v} := by
  intro R _ M _ _ x h
  let e := LinearEquiv.ofBijective (comparison M x) (degree_one_comparison_bijective M x h)
  refine ⟨e, rfl, ?_⟩
  intro n p
  constructor
  · exact comparison_homogeneous M x n p
  · intro hp
    obtain ⟨q, hq, he⟩ := comparison_degreewise_surjective M x n (e p) hp
    have he' : e q = e p := he
    exact e.injective he' ▸ hq

end AdvCommAlg.Koszul
