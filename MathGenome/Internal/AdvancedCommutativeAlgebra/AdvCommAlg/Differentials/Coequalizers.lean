import MathGenome.Internal.AdvancedCommutativeAlgebra.AdvCommAlg.Differentials.Naturality
import MathGenome.Internal.AdvancedCommutativeAlgebra.Specs.AdvCommAlg.Differentials.Coequalizers

/-! The coequalizer assertion of KD-19. We use the quotient exact sequence,
and identify its relation module using the ideal generated by u(p)-v(p). -/
namespace AdvCommAlg.Differentials.Coequalizers

universe a p q c
noncomputable section
open scoped TensorProduct
open Specs.AdvCommAlg.Differentials.Coequalizers

variable {A : Type a} {P : Type p} {Q : Type q} {C : Type c}
variable [CommRing A] [CommRing P] [CommRing Q] [CommRing C]
variable [Algebra A P] [Algebra A Q] [Algebra A C]

/-- The universal property implies the concrete quotient description; thus
surjectivity and the ideal-of-differences description are conclusions. -/
theorem coequalizer_quotient_criterion (u v : P →ₐ[A] Q) (π : Q →ₐ[A] C)
    (hQ : CoequalizerUniversal.{a,p,q,c,q} u v π)
    (hC : CoequalizerUniversal.{a,p,q,c,c} u v π) :
    Function.Surjective π ∧ RingHom.ker π.toRingHom = differenceIdeal u v := by
  let I := differenceIdeal u v
  let ρ := Ideal.Quotient.mkₐ A I
  have hρ : ρ.comp u = ρ.comp v := by
    ext x
    exact (Ideal.Quotient.eq).mpr (Ideal.subset_span (Set.mem_range_self x))
  have hI : I ≤ RingHom.ker π.toRingHom := by
    apply Ideal.span_le.mpr
    rintro _ ⟨x, rfl⟩
    change π (u x - v x) = 0
    rw [map_sub, sub_eq_zero]
    exact AlgHom.congr_fun hQ.1 x
  let t := Ideal.Quotient.liftₐ I π (fun _ hx => RingHom.mem_ker.mp (hI hx))
  have ht : t.comp ρ = π := Ideal.Quotient.liftₐ_comp _ _ _
  obtain ⟨s, hs, _⟩ := hQ.2 (Q ⧸ I) ρ hρ
  obtain ⟨g, hg, huniq⟩ := hC.2 C π hC.1
  have hts : t.comp s = AlgHom.id A C := by
    apply Eq.trans (huniq _ (by rw [AlgHom.comp_assoc, hs, ht]))
    exact (huniq _ (by ext; rfl)).symm
  constructor
  · intro z
    obtain ⟨x, hx⟩ := Ideal.Quotient.mkₐ_surjective A I (s z)
    refine ⟨x, ?_⟩
    calc
      π x = t (ρ x) := (AlgHom.congr_fun ht x).symm
      _ = t (s z) := congrArg t hx
      _ = z := AlgHom.congr_fun hts z
  · apply le_antisymm
    · intro x hx
      apply (Ideal.Quotient.eq_zero_iff_mem).mp
      change ρ x = 0
      rw [← AlgHom.congr_fun hs x]
      change s (π x) = 0
      change π x = 0 at hx
      rw [hx, map_zero]
    · exact hI

variable [Algebra Q C] [IsScalarTower A Q C]
variable [Algebra P C] [IsScalarTower A P C]

@[simp] theorem arrowMap_tmul_D (f : P →ₐ[A] Q)
    (hf : ∀ x, algebraMap Q C (f x) = algebraMap P C x) (r : C) (x : P) :
    arrowMap f hf (r ⊗ₜ[P] KaehlerDifferential.D A P x) =
      r • (1 ⊗ₜ[Q] KaehlerDifferential.D A Q (f x)) := by
  rw [show r ⊗ₜ[P] KaehlerDifferential.D A P x =
    r • (1 ⊗ₜ[P] KaehlerDifferential.D A P x) by
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one], map_smul]
  congr 1
  exact (IsBaseChange.lift_eq _ _ _).trans
    (Derivation.liftKaehlerDifferential_comp_D _ _)

/-- Exactness at the middle term, for the concrete quotient description. -/
theorem range_difference_eq_kernel (u v : P →ₐ[A] Q)
    (hu : ∀ x, algebraMap Q C (u x) = algebraMap P C x)
    (hv : ∀ x, algebraMap Q C (v x) = algebraMap P C x)
    (hsurj : Function.Surjective (algebraMap Q C))
    (hker : RingHom.ker (algebraMap Q C) = differenceIdeal u v) :
    LinearMap.range (arrowMap u hu - arrowMap v hv) =
      LinearMap.ker (finalMap (A := A) (Q := Q) (C := C)) := by
  let δ := arrowMap u hu - arrowMap v hv
  let K := LinearMap.range δ
  have hzero : (finalMap (A := A) (Q := Q) (C := C)).comp δ = 0 := by
    apply (TensorProduct.isBaseChange P (KaehlerDifferential A P) C).algHom_ext'
    apply Derivation.liftKaehlerDifferential_unique
    ext x
    change finalMap (δ (1 ⊗ₜ[P] KaehlerDifferential.D A P x)) = 0
    dsimp only [δ]
    rw [LinearMap.sub_apply, map_sub, arrowMap_tmul_D, arrowMap_tmul_D,
      one_smul, one_smul]
    simp only [finalMap, KaehlerDifferential.mapBaseChange_tmul,
      KaehlerDifferential.map_D, one_smul, hu, hv, sub_self]
  have kill : ∀ x ∈ differenceIdeal u v, algebraMap Q C x = 0 := by
    intro x hx
    rw [← hker] at hx
    exact RingHom.mem_ker.mp hx
  have hrel : ∀ x ∈ differenceIdeal u v,
      extendedDerivation (A := A) (Q := Q) (C := C) x ∈ K := by
    intro x hx
    change x ∈ Submodule.span Q (Set.range (fun x : P => u x - v x)) at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, rfl⟩ := hy
      refine ⟨1 ⊗ₜ[P] KaehlerDifferential.D A P x, ?_⟩
      change (arrowMap u hu - arrowMap v hv) _ = _
      rw [LinearMap.sub_apply, arrowMap_tmul_D, arrowMap_tmul_D, one_smul, one_smul]
      change (1 ⊗ₜ[Q] KaehlerDifferential.D A Q (u x)) -
        (1 ⊗ₜ[Q] KaehlerDifferential.D A Q (v x)) =
        1 ⊗ₜ[Q] KaehlerDifferential.D A Q (u x - v x)
      rw [map_sub, TensorProduct.tmul_sub]
    | zero => simp
    | add x y hx hy ex ey => simpa only [map_add] using K.add_mem ex ey
    | smul r x hx ex =>
      change extendedDerivation (A := A) (Q := Q) (C := C) (r * x) ∈ K
      rw [Derivation.leibniz, ← IsScalarTower.algebraMap_smul C r,
        ← IsScalarTower.algebraMap_smul C x, kill x hx, zero_smul, add_zero]
      exact K.smul_mem (algebraMap Q C r) ex
  apply le_antisymm
  · rintro z ⟨x, rfl⟩
    change finalMap (δ x) = 0
    exact LinearMap.congr_fun hzero x
  · intro x hx
    have hx' : x ∈ LinearMap.range (KaehlerDifferential.kerCotangentToTensor A Q C) := by
      rw [KaehlerDifferential.range_kerCotangentToTensor A Q C hsurj]
      exact hx
    obtain ⟨y, rfl⟩ := hx'
    obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective _ y
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
    exact hrel y.1 (by rw [← hker]; exact y.2)

/-- The cokernel isomorphism, with the canonical quotient-map formula. -/
theorem coequalizer_cokernel :
    Specs.AdvCommAlg.Differentials.Coequalizers.coequalizerCokernel.{a,p,q,c} := by
  intro A P Q C _ _ _ _ _ _ _ _ _ _ _ u v hu hv hQ hC
  obtain ⟨hsurj, hker⟩ := coequalizer_quotient_criterion u v
    (IsScalarTower.toAlgHom A Q C) hQ hC
  have hrange := range_difference_eq_kernel u v hu hv hsurj hker
  refine ⟨arrowMap_tmul_D u hu, arrowMap_tmul_D v hv, ?_⟩
  let e := (Submodule.quotEquivOfEq _ _ hrange).trans
    ((finalMap (A := A) (Q := Q) (C := C)).quotKerEquivOfSurjective
      (KaehlerDifferential.mapBaseChange_surjective A Q C hsurj))
  refine ⟨e, ?_, ?_⟩
  · intro z
    simp [e, Submodule.mkQ_apply, Submodule.quotEquivOfEq_mk]
  · intro r x
    simp [e, Submodule.mkQ_apply, Submodule.quotEquivOfEq_mk, finalMap]

end
end AdvCommAlg.Differentials.Coequalizers
