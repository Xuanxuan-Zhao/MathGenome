import MathGenome.Internal.Specs.D07.Ch15.RootsUnity
import MathGenome.Internal.D07.Ch12.FiniteMultiplicativeCyclic
import Mathlib.RingTheory.RootsOfUnity.AlgebraicallyClosed

/-! K07.15.roots_unity, including the exponent embedding over an arbitrary base. -/

namespace D07.Ch15.RootsUnity

open Specs.D07.Ch15.RootsUnity

universe u v

/-- All roots are taken in the same specified overfield. -/
theorem root_group_membership : RootGroupMembership.{v} := by
  intro Ω _ n x
  rw [mem_rootsOfUnity]
  rw [← Units.val_inj]
  simp [Polynomial.IsRoot, sub_eq_zero]

theorem scalar_root_membership : ScalarRootMembership.{v} := by
  intro Ω _ n hn x
  have : NeZero n := ⟨hn.ne'⟩
  constructor
  · intro hx
    have hp : x ^ n = 1 := by simpa [Polynomial.IsRoot, sub_eq_zero] using hx
    exact ⟨rootsOfUnity.mkOfPowEq x hp, rfl⟩
  · rintro ⟨ζ, rfl⟩
    exact (root_group_membership Ω n (ζ : Ωˣ)).mp ζ.property

theorem primitive_root_exists : PrimitiveRootExists.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar
  have : NeZero (n : K) := ⟨hchar⟩
  have : NeZero (n : Ω) := ⟨by
    intro h
    apply hchar
    apply (algebraMap K Ω).injective
    simpa only [map_natCast, map_zero] using h⟩
  exact HasEnoughRootsOfUnity.exists_isPrimitiveRoot Ω n

theorem root_group_structure : RootGroupStructure.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar
  have : NeZero n := ⟨hn.ne'⟩
  obtain ⟨ζ, hζ⟩ := primitive_root_exists K Ω n hn hchar
  exact ⟨inferInstance,
    Ch12.FiniteMultiplicativeCyclic.finite_multiplicative_subgroup_is_cyclic
      Ω (rootsOfUnity n Ω), hζ.card_rootsOfUnity⟩

theorem primitive_root_classification : PrimitiveRootClassification.{v} := by
  intro Ω _ n hn ζ hζ ξ
  have : NeZero n := ⟨hn.ne'⟩
  exact hζ.isPrimitiveRoot_iff

theorem primitive_power_criterion : PrimitivePowerCriterion.{v} := by
  intro Ω _ n hn ζ hζ a
  exact hζ.pow_iff_coprime hn a

theorem primitive_integer_power_criterion : PrimitiveIntegerPowerCriterion.{v} := by
  intro Ω _ n hn ζ hζ a
  cases a with
  | ofNat a => simpa using hζ.pow_iff_coprime hn a
  | negSucc a =>
      simpa only [zpow_negSucc, IsPrimitiveRoot.inv_iff, Int.natAbs_negSucc] using
        hζ.pow_iff_coprime hn (a + 1)

theorem generated_by_primitive_root : GeneratedByPrimitiveRoot.{u, v} := by
  intro K Ω _ _ _ n hn ζ hζ
  have : NeZero n := ⟨hn.ne'⟩
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    obtain ⟨a, _, rfl⟩ := hζ.eq_pow_of_pow_eq_one hx
    exact pow_mem (IntermediateField.subset_adjoin K {ζ} (Set.mem_singleton ζ)) a
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x rfl
    exact IntermediateField.subset_adjoin K _ hζ.pow_eq_one

theorem binomial_separable : BinomialSeparable.{u} := by
  intro K _ n _ hchar
  exact Polynomial.X_pow_sub_one_separable_iff.mpr hchar

/-- The concrete field generated by all roots is cyclotomic; this certificate
is proved from existence in the closure, not assumed as a hypothesis. -/
private theorem rootField_isCyclotomic
    (K : Type u) (Ω : Type v) [Field K] [Field Ω] [Algebra K Ω] [IsAlgClosed Ω]
    (n : ℕ) (hn : 0 < n) (hchar : (n : K) ≠ 0) :
    IsCyclotomicExtension {n} K (RootField K Ω n) := by
  have h := IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot
    {n} K Ω (by
      intro m hm _
      have hm : m = n := Set.mem_singleton_iff.mp hm
      subst m
      exact primitive_root_exists K Ω n hn hchar)
  have heq : {b : Ω | ∃ m ∈ ({n} : Set ℕ), m ≠ 0 ∧ b ^ m = 1} =
      {x : Ω | x ^ n = 1} := by
    ext x
    simp [hn.ne']
  rw [heq] at h
  exact h

theorem root_field_splitting : RootFieldSplitting.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar
  have : NeZero n := ⟨hn.ne'⟩
  have := rootField_isCyclotomic K Ω n hn hchar
  exact IsCyclotomicExtension.isSplittingField_X_pow_sub_one n K _

theorem root_field_finite_galois_abelian : RootFieldFiniteGaloisAbelian.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar
  have : NeZero n := ⟨hn.ne'⟩
  have := rootField_isCyclotomic K Ω n hn hchar
  have := IsCyclotomicExtension.isMulCommutative {n} K (RootField K Ω n)
  exact ⟨IsCyclotomicExtension.finiteDimensional {n} K (RootField K Ω n),
    IsCyclotomicExtension.isGalois {n} K (RootField K Ω n), fun σ τ => mul_comm' σ τ⟩

theorem root_field_primitive_root : RootFieldPrimitiveRoot.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar
  have := rootField_isCyclotomic K Ω n hn hchar
  exact IsCyclotomicExtension.exists_isPrimitiveRoot K (RootField K Ω n)
    (Set.mem_singleton n) hn.ne'

theorem galois_exponent_embedding : GaloisExponentEmbedding.{u, v} := by
  intro K Ω _ _ _ _ n hn hchar ζ hζ
  have : NeZero n := ⟨hn.ne'⟩
  have := rootField_isCyclotomic K Ω n hn hchar
  refine ⟨hζ.autToPow K, ?_, hζ.autToPow_spec K⟩
  intro σ τ hστ
  apply IsCyclotomicExtension.algEquiv_eq_of_apply_eq {n} K (RootField K Ω n)
  intro m hm _
  have hm : m = n := Set.mem_singleton_iff.mp hm
  subst m
  refine ⟨ζ, hζ, ?_⟩
  rw [← hζ.autToPow_spec K σ, ← hζ.autToPow_spec K τ, hστ]

theorem prime_characteristic_failure : PrimeCharacteristicFailure.{u} := by
  intro K _ p _ _
  constructor
  · simpa only [one_pow] using (sub_pow_char (Polynomial.X : Polynomial K) 1).symm
  · intro x
    have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
    calc
      x ^ p = 1 ↔ (x - 1) ^ p = 0 := by rw [sub_pow_char, one_pow, sub_eq_zero]
      _ ↔ x = 1 := by rw [pow_eq_zero_iff hp, sub_eq_zero]

end D07.Ch15.RootsUnity
