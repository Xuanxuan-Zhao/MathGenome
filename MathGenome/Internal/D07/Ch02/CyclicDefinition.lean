import MathGenome.Internal.D07.Ch01.IntegerPowerLaws
import MathGenome.Internal.D07.Ch01.SubgroupLattice
import MathGenome.Internal.Specs.D07.Ch02.CyclicDefinition

/-!
# Cyclic subgroups and cyclic groups

The integer powers of a single element form the canonical `Subgroup.zpowers`.
They form precisely the subgroup generated by that element. The two cyclicity
characterizations below connect Mathlib's predicate with the source definition,
without any restriction on the ambient group or the order of the generator.
-/

namespace D07.Ch02.CyclicDefinition

universe u

theorem cyclic_subgroup_carrier (G : Type u) [Group G] (x : G) :
    (Subgroup.zpowers x : Set G) = {y : G | ∃ k : ℤ, x ^ k = y} :=
  rfl

theorem generator_mem (G : Type u) [Group G] (x : G) :
    x ∈ Subgroup.zpowers x :=
  Subgroup.mem_zpowers x

theorem cyclic_subgroup_le_iff (G : Type u) [Group G] (x : G) (H : Subgroup G) :
    Subgroup.zpowers x ≤ H ↔ x ∈ H :=
  Subgroup.zpowers_le

theorem cyclic_subgroup_eq_generated (G : Type u) [Group G] (x : G) :
    Subgroup.zpowers x = Subgroup.closure ({x} : Set G) :=
  Subgroup.zpowers_eq_closure x

theorem cyclic_iff_integer_powers (G : Type u) [Group G] :
    IsCyclic G ↔ ∃ x : G, ∀ y : G, ∃ k : ℤ, x ^ k = y :=
  ⟨fun h => h.exists_zpow_surjective, fun h => ⟨h⟩⟩

theorem cyclic_iff_cyclic_subgroup_eq_top (G : Type u) [Group G] :
    IsCyclic G ↔ ∃ x : G, Subgroup.zpowers x = ⊤ := by
  rw [cyclic_iff_integer_powers G]
  constructor
  · rintro ⟨x, hx⟩
    refine ⟨x, le_antisymm le_top ?_⟩
    intro y _
    exact (Subgroup.mem_zpowers_iff).mpr (hx y)
  · rintro ⟨x, hx⟩
    refine ⟨x, fun y => ?_⟩
    apply Subgroup.mem_zpowers_iff.mp
    rw [hx]
    exact Subgroup.mem_top y

theorem trivial_group_is_cyclic (G : Type u) [Group G] [Subsingleton G] :
    IsCyclic G := by
  apply (cyclic_iff_integer_powers G).mpr
  exact ⟨1, fun y => ⟨0, Subsingleton.elim _ _⟩⟩

end D07.Ch02.CyclicDefinition
