import MathGenome.Internal.D07.Ch01.HomPreservesPowers
import MathGenome.Internal.D07.Ch02.CyclicModelsIsomorphism
import MathGenome.Internal.Specs.D07.Ch02.CyclicAbelianAndSubgroups

/-!
Subgroups and images of cyclic groups (paper.tex:461–467).

Commutativity follows by writing both elements as powers of one generator.
The subgroup theorem used below proves generation by the least positive
exponent whose power lies in the subgroup, using division with remainder;
it includes the bottom subgroup. A homomorphic image is generated by the
image of a generator. For a nontrivial subgroup in the infinite case,
`IsCyclic.infinite_of_ne_bot` proves that its power generator has infinite
order; the upstream infinite model then supplies the integer isomorphism.
-/

namespace D07.Ch02.CyclicAbelianAndSubgroups

universe u v

theorem cyclic_abelian (G : Type u) [Group G] [IsCyclic G] (x y : G) :
    x * y = y * x := by
  obtain ⟨g, hg⟩ := exists_zpow_surjective G
  obtain ⟨a, rfl⟩ := hg x
  obtain ⟨b, rfl⟩ := hg y
  exact zpow_mul_comm g a b

theorem subgroup_cyclic (G : Type u) [Group G] [IsCyclic G]
    (H : Subgroup G) : IsCyclic H :=
  Subgroup.isCyclic H

theorem surjective_image_cyclic (G : Type u) (K : Type v)
    [Group G] [Group K] [IsCyclic G] (f : G →* K)
    (hf : Function.Surjective f) : IsCyclic K := by
  obtain ⟨g, hg⟩ := exists_zpow_surjective G
  refine ⟨f g, ?_⟩
  intro y
  obtain ⟨x, rfl⟩ := hf y
  obtain ⟨n, rfl⟩ := hg x
  exact ⟨n, (D07.Ch01.HomPreservesPowers.preserves_integer_powers G K f g n).symm⟩

theorem homomorphic_image_cyclic (G : Type u) (K : Type v)
    [Group G] [Group K] [IsCyclic G] (f : G →* K) : IsCyclic f.range :=
  surjective_image_cyclic G f.range f.rangeRestrict f.rangeRestrict_surjective

theorem nontrivial_subgroup_infinite_cyclic (G : Type u)
    [Group G] [IsCyclic G] [Infinite G] (H : Subgroup G) (hH : H ≠ ⊥) :
    Infinite H ∧ IsCyclic H ∧ Nonempty (Multiplicative ℤ ≃* H) := by
  have hInfinite : Infinite H := IsCyclic.infinite_of_ne_bot hH
  let := hInfinite
  let := subgroup_cyclic G H
  obtain ⟨h, hh⟩ :=
    (D07.Ch02.CyclicDefinition.cyclic_iff_cyclic_subgroup_eq_top H).mp inferInstance
  have horder : orderOf h = 0 :=
    Infinite.orderOf_eq_zero_of_forall_mem_zpowers fun y => hh ▸ Subgroup.mem_top y
  obtain ⟨_, e, _⟩ :=
    D07.Ch02.CyclicModelsIsomorphism.infinite_model H h hh horder
  exact ⟨hInfinite, inferInstance, ⟨e⟩⟩

end D07.Ch02.CyclicAbelianAndSubgroups
