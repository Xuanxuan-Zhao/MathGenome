import MathGenome.Internal.D07.Ch17.DirectSums
import MathGenome.Internal.D07.Ch17.KernelsImages
import MathGenome.Internal.Specs.D07.Ch17.IrreducibleDefinitionFiniteSemisimpleDecomposition
import Mathlib.RingTheory.Finiteness.Basic

/-! K07.17.irreducible_definition, paper.tex:4727–4777.
The lattice of invariant subspaces is identified with the submodule lattice of
the group-algebra module. Semisimplicity supplies an independent spanning family
of simple submodules; finite generation makes that family finite. Conversely,
a module generated by simple submodules has complements. The restriction-action
bridge below checks that these simple submodules are the original irreducible
representations. The graph case is also proved directly in coordinates.
-/

namespace D07.Ch17.IrreducibleDefinitionFiniteSemisimpleDecomposition

universe u v w x

noncomputable section
open scoped MonoidAlgebra
open Specs.D07.Ch17.IrreducibleDefinitionFiniteSemisimpleDecomposition

variable {K : Type u} {G : Type v} {V : Type w}
  [Field K] [Group G] [AddCommGroup V] [Module K V]

lemma isCompl_iff_submodule {ρ : Representation K G V} (U W : Subrepresentation ρ) :
    IsCompl U W ↔ IsCompl U.toSubmodule W.toSubmodule := by
  simp only [isCompl_iff, disjoint_iff, codisjoint_iff,
    ← Subrepresentation.toSubmodule_inf, ← Subrepresentation.toSubmodule_sup]
  constructor
  · rintro ⟨h, h'⟩
    exact ⟨congrArg Subrepresentation.toSubmodule h, congrArg Subrepresentation.toSubmodule h'⟩
  · rintro ⟨h, h'⟩
    exact ⟨Subrepresentation.toSubmodule_injective h,
      Subrepresentation.toSubmodule_injective h'⟩

lemma complements_iff_native (ρ : Representation K G V) :
    HasInvariantComplements ρ ↔ Representation.IsSemisimpleRepresentation ρ := by
  constructor
  · intro h
    exact ⟨fun U => (h U).imp (fun W hW => (isCompl_iff_submodule U W).mpr hW)⟩
  · intro h U
    obtain ⟨W, hW⟩ := h.exists_isCompl U
    exact ⟨W, (isCompl_iff_submodule U W).mp hW⟩

lemma complements_iff_module (ρ : Representation K G V) :
    HasInvariantComplements ρ ↔ IsSemisimpleModule K[G] ρ.asModule :=
  (complements_iff_native ρ).trans
    (Representation.isSemisimpleRepresentation_iff_isSemisimpleModule_asModule ρ)

/-- The restriction has exactly the group-algebra action inherited by the
corresponding submodule, not a newly chosen action. -/
def restrictionModuleEquiv {ρ : Representation K G V} (U : Subrepresentation ρ) :
    U.toRepresentation.asModule ≃ₗ[K[G]] U.asSubmodule where
  toFun x := ⟨x.1, x.2⟩
  invFun x := ⟨x.1, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' r x := by
    apply Subtype.ext
    change (U.toRepresentation.asAlgebraHom r x).1 = ρ.asAlgebraHom r x.1
    induction r using MonoidAlgebra.induction_linear with
    | zero => rw [map_zero, map_zero]; rfl
    | add a b ha hb =>
      rw [map_add, map_add]
      change (U.toRepresentation.asAlgebraHom a x).1 +
        (U.toRepresentation.asAlgebraHom b x).1 =
        ρ.asAlgebraHom a x.1 + ρ.asAlgebraHom b x.1
      rw [ha, hb]
    | single g a =>
      simp only [Representation.asAlgebraHom_single, LinearMap.smul_apply]
      rfl

lemma atom_iff_irreducible {ρ : Representation K G V} (U : Subrepresentation ρ) :
    IsAtom U ↔ Representation.IsIrreducible U.toRepresentation := by
  rw [Representation.irreducible_iff_isSimpleModule_asModule,
    (restrictionModuleEquiv U).isSimpleModule_iff, isSimpleModule_iff_isAtom]
  exact (Subrepresentation.subrepresentationSubmoduleOrderIso.isAtom_iff U).symm

theorem atom_characterization : AtomCharacterization.{u,v,w} := by
  intro K G V _ _ _ _ ρ U
  refine ⟨?_, atom_iff_irreducible U⟩
  constructor
  · intro h
    refine ⟨h.ne_bot, fun A hA => ?_⟩
    by_cases he : A = U
    · exact Or.inr he
    · exact Or.inl (h.2 A (lt_of_le_of_ne hA he))
  · rintro ⟨hne, h⟩
    exact ⟨hne, fun A hA => (h A hA.le).resolve_right (ne_of_lt hA)⟩

theorem inheritance : Inheritance.{u,v,w} := by
  intro K G V _ _ _ _ ρ h U
  have := (complements_iff_module ρ).mp h
  have hm : IsSemisimpleModule K[G] U.asSubmodule := inferInstance
  exact (complements_iff_module U.toRepresentation).mpr
    ((restrictionModuleEquiv U).isSemisimpleModule_iff.mpr hm)

lemma finite_internal_simples (ρ : Representation K G V)
    [FiniteDimensional K V] [IsSemisimpleModule K[G] ρ.asModule] :
    ∃ (n : ℕ) (S : Fin n → Submodule K[G] ρ.asModule),
      (∀ i, IsSimpleModule K[G] (S i)) ∧ DirectSum.IsInternal S := by
  have : Module.Finite K[G] ρ.asModule :=
    Module.Finite.of_restrictScalars_finite K K[G] ρ.asModule
  obtain ⟨s, hind, htop, hsimple⟩ :=
    IsSemisimpleModule.exists_sSupIndep_sSup_simples_eq_top K[G] ρ.asModule
  have hi : iSupIndep (fun i : s => i.1) := (sSupIndep_iff s).mp hind
  have : Finite s := WellFoundedGT.finite_of_iSupIndep hi
    (fun i => by
      have := hsimple i.1 i.2
      exact (i.1.nontrivial_iff_ne_bot).mp (IsSimpleModule.nontrivial K[G] i.1))
  let e := (Finite.equivFin s).symm
  refine ⟨Nat.card s, fun i => (e i).1, fun i => hsimple _ (e i).2,
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top (hi.comp e.injective) ?_⟩
  rw [e.surjective.iSup_comp]
  exact (sSup_eq_iSup' s).symm.trans htop

theorem finite_semisimple_decomposition : FiniteSemisimpleDecomposition.{u,v,w} := by
  intro K G V _ _ _ _ _ ρ
  let e := Subrepresentation.subrepresentationSubmoduleOrderIso (ρ := ρ)
  constructor
  · intro h
    have := (complements_iff_module ρ).mp h
    obtain ⟨n, S, hs, hi⟩ := finite_internal_simples ρ
    refine ⟨n, fun i => e.symm (S i), fun i => ?_, ?_⟩
    · exact (e.symm.isAtom_iff _).mpr ((isSimpleModule_iff_isAtom).mp (hs i))
    · exact hi
  · rintro ⟨n, U, hu, hi⟩
    have hi' : DirectSum.IsInternal (fun i => (U i).asSubmodule) := hi
    have hs : ∀ i, IsSimpleModule K[G] (U i).asSubmodule := fun i =>
      isSimpleModule_iff_isAtom.mpr ((e.isAtom_iff (U i)).mpr (hu i))
    have hm : IsSemisimpleModule K[G] ρ.asModule :=
      isSemisimpleModule_of_isSemisimpleModule_submodule'
        (fun i => by have := hs i; infer_instance) hi'.submodule_iSup_eq_top
    exact (complements_iff_module ρ).mpr hm

theorem graph_complement : GraphComplement.{u,v,w,x} := by
  intro K G S T _ _ _ _ _ _ ρ σ B C f hBC hf
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · intro g p hp
    obtain ⟨b, rfl⟩ := LinearMap.mem_range.mp hp
    refine LinearMap.mem_range.mpr ⟨B.toRepresentation g b, ?_⟩
    apply Prod.ext
    · exact hf.isIntertwining g b
    · rfl
  · intro g p hp
    exact ⟨Submodule.mem_top, C.apply_mem_toSubmodule g hp.2⟩
  · constructor
    · apply Submodule.disjoint_def.mpr
      intro p hp hW
      obtain ⟨b, rfl⟩ := LinearMap.mem_range.mp hp
      have hb0 : (b : T) = 0 :=
        Submodule.disjoint_def.mp hBC.disjoint b b.2 hW.2
      have hb : b = 0 := Subtype.ext hb0
      simp [hb]
    · apply codisjoint_iff.mpr
      apply top_unique
      intro p _
      have hp : p.2 ∈ B.toSubmodule ⊔ C.toSubmodule := by
        rw [hBC.sup_eq_top]
        exact Submodule.mem_top
      obtain ⟨b, hb, c, hc, hbc⟩ := Submodule.mem_sup.mp hp
      refine Submodule.mem_sup.mpr
        ⟨(f ⟨b, hb⟩, b), LinearMap.mem_range.mpr ⟨⟨b, hb⟩, rfl⟩,
          (p.1 - f ⟨b, hb⟩, c), ⟨Submodule.mem_top, hc⟩, ?_⟩
      exact Prod.ext (by simp) hbc

theorem graph_case_complement : GraphCaseComplement.{u,v,w,x} := by
  intro K G S T _ _ _ _ _ _ ρ σ A hT hAS
  let B : Subrepresentation σ := {
    toSubmodule := A.toSubmodule.map (LinearMap.snd K S T)
    apply_mem_toSubmodule := by
      intro g t ht
      obtain ⟨p, hp, rfl⟩ := Submodule.mem_map.mp ht
      exact Submodule.mem_map.mpr
        ⟨(ρ.prod σ) g p, A.apply_mem_toSubmodule g hp, rfl⟩ }
  obtain ⟨C, hBC⟩ := hT B
  refine ⟨C, fun g p hp => ⟨Submodule.mem_top, C.apply_mem_toSubmodule g hp.2⟩, ?_⟩
  constructor
  · apply Submodule.disjoint_def.mpr
    intro p hp hW
    have hpB : p.2 ∈ B.toSubmodule := Submodule.mem_map.mpr ⟨p, hp, rfl⟩
    have hp0 : p.2 = 0 := Submodule.disjoint_def.mp hBC.disjoint p.2 hpB hW.2
    exact Submodule.disjoint_def.mp hAS p hp ⟨Submodule.mem_top, hp0⟩
  · apply codisjoint_iff.mpr
    apply top_unique
    intro p _
    have hp : p.2 ∈ B.toSubmodule ⊔ C.toSubmodule := by
      rw [hBC.sup_eq_top]
      exact Submodule.mem_top
    obtain ⟨b, hb, c, hc, hbc⟩ := Submodule.mem_sup.mp hp
    obtain ⟨a, ha, hab⟩ := Submodule.mem_map.mp hb
    refine Submodule.mem_sup.mpr
      ⟨a, ha, (p.1 - a.1, c), ⟨Submodule.mem_top, hc⟩, ?_⟩
    apply Prod.ext
    · simp
    · change a.2 + c = p.2
      change a.2 = b at hab
      rw [hab, hbc]

theorem zero_space : ZeroSpace.{u,v,w} := by
  intro K G V _ _ _ _ _ ρ
  constructor
  · intro U
    refine ⟨⊥, ?_⟩
    have hU : U.toSubmodule = ⊤ := Subsingleton.elim _ _
    rw [hU]
    exact isCompl_top_bot
  · refine ⟨Fin.elim0, fun i => Fin.elim0 i, ?_⟩
    apply DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
    · intro i; exact Fin.elim0 i
    · exact Subsingleton.elim _ _

/-- The addition map respects the action on each summand; finite-support
induction then proves equivariance on the whole direct sum. -/
lemma addition_intertwining {ρ : Representation K G V} {n : ℕ}
    (U : Fin n → Subrepresentation ρ) :
    (Representation.directSum (fun i => (U i).toRepresentation)).IsIntertwiningMap ρ
      (DirectSum.coeLinearMap (fun i => (U i).toSubmodule)) := by
  constructor
  intro g x
  induction x using DirectSum.induction_on with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | of i x =>
    change DirectSum.coeLinearMap (fun i => (U i).toSubmodule)
      (DirectSum.lmap (fun i => (U i).toRepresentation g) (DirectSum.of _ i x)) = _
    simp only [DirectSum.lmap_of, DirectSum.coeLinearMap_of]
    rfl

theorem equivariant_decomposition : EquivariantDecomposition.{u,v,w} := by
  intro K G V _ _ _ _ _ ρ h
  obtain ⟨n, U, hu, hi⟩ := (finite_semisimple_decomposition K G V ρ).mp h
  let e := LinearEquiv.ofBijective (DirectSum.coeLinearMap (fun i => (U i).toSubmodule)) hi
  refine ⟨n, U, Representation.Equiv.mk e ?_, fun i => (atom_iff_irreducible _).mp (hu i),
    fun _ => rfl⟩
  intro g
  exact LinearMap.ext ((addition_intertwining U).isIntertwining g)

end
end D07.Ch17.IrreducibleDefinitionFiniteSemisimpleDecomposition
