import MathGenome.Internal.Specs.D07.Ch12.SeparableTowers
import Mathlib.FieldTheory.SeparableClosure

/-!
Separability in towers and generated fields, K07.12.separable_towers.

Restriction to E follows by mapping elements into L. Raising the base
uses that the new minimal polynomial divides the mapped old one.
`Algebra.IsSeparable.trans` has no finiteness assumption: its proof reduces
an element to the field generated by the finitely many coefficients of
its E-minimal polynomial and uses the finite separable-degree tower law.

For generation, Mathlib proves that separable elements form an intermediate
field (`separableClosure`). Its leastness property shows that an arbitrary
field adjoin of separable elements lies in it. Thus the generation result
allows infinite and empty generating sets, and the ambient field L need
not be algebraic. No closed-field or characteristic hypothesis is used.
-/

universe u v w

namespace D07.Ch12.SeparableTowers

open Specs.D07.Ch12.SeparableTowers

theorem separability_descends : SeparabilityDescends.{u, v, w} := by
  intro K E L _ _ _ _ _ _ _ _ _ hsep
  let : Algebra.IsSeparable K L := hsep
  exact ⟨Algebra.isSeparable_tower_bot_of_isSeparable K E L,
    Algebra.isSeparable_tower_top_of_isSeparable K E L⟩

theorem separability_transitive : SeparabilityTransitive.{u, v, w} := by
  intro K E L _ _ _ _ _ _ _ _ _ hKE hEL
  let : Algebra.IsSeparable K E := hKE
  let : Algebra.IsSeparable E L := hEL
  exact Algebra.IsSeparable.trans K E L

theorem generated_field_separable : GeneratedFieldSeparable.{u, v} := by
  intro K L _ _ _ S hS
  exact (IntermediateField.isSeparable_adjoin_iff_isSeparable K L).mpr
    (fun a ha => (hS a ha).2)

theorem extension_separable_of_generators : ExtensionSeparableOfGenerators.{u, v} := by
  intro K L _ _ _ S hgen hS
  have hsep := generated_field_separable K L S hS
  change Algebra.IsSeparable K (IntermediateField.adjoin K S) at hsep
  change IntermediateField.adjoin K S = ⊤ at hgen
  rw [hgen] at hsep
  let : Algebra.IsSeparable K (⊤ : IntermediateField K L) := hsep
  exact AlgEquiv.Algebra.isSeparable (IntermediateField.topEquiv :
    (⊤ : IntermediateField K L) ≃ₐ[K] L)

end D07.Ch12.SeparableTowers
