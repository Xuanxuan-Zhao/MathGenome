import MathGenome.Internal.Specs.D07.Ch12.AlgebraicClosureSimultaneousRootField
import MathGenome.Internal.D07.Ch09.MaximalExistence
import Mathlib.FieldTheory.SplittingField.Construction
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-! Simultaneous root adjunction by the ideal generated by f(T_f).
The finite evaluation uses splitting fields, constructed by finitely many
irreducible root adjunctions, rather than an algebraically closed ambient field. -/
universe u

namespace D07.Ch12.AlgebraicClosureSimultaneousRootField

open Polynomial
open Specs.D07.Ch12.AlgebraicClosureSimultaneousRootField

noncomputable section

/-- Evaluate the finitely many requested variables at roots in the splitting
field of their product; all other variables may be sent to zero. -/
theorem finiteEvaluation : FiniteEvaluation.{u} := by
  intro K _ s
  classical
  let P : K[X] := ∏ f ∈ s, f.val
  let L := P.SplittingField
  have hsplits (f : RootIndex K) (hf : f ∈ s) :
      (f.val.map (algebraMap K L)).Splits := by
    exact (splits_prod_iff fun j _ => map_ne_zero j.property.1.ne_zero).mp
      (by simpa [P, Polynomial.map_prod] using SplittingField.splits P) f hf
  have hroot (f : RootIndex K) (hf : f ∈ s) :
      ∃ x : L, aeval x f.val = 0 := by
    obtain ⟨x, hx⟩ := (hsplits f hf).exists_eval_eq_zero
      (degree_ne_of_natDegree_ne (by
        rw [natDegree_map]
        exact Nat.ne_of_gt f.property.2))
    exact ⟨x, by simpa only [aeval_def, eval_map] using hx⟩
  let v : RootIndex K → L := fun f =>
    if h : f ∈ s then Classical.choose (hroot f h) else 0
  refine ⟨L, inferInstance, inferInstance, inferInstance, MvPolynomial.aeval v, ?_⟩
  intro f hf
  change (MvPolynomial.aeval v) (aeval (MvPolynomial.X f) f.val) = 0
  rw [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
  dsimp [v]
  rw [dite_eq_left hf]
  exact Classical.choose_spec (hroot f hf)

/-- A putative expression for 1 uses finitely many relations. Applying the
finite evaluation annihilates that expression in a nontrivial field. -/
theorem idealProper : IdealProper.{u} := by
  intro K _
  rw [Ideal.ne_top_iff_one, relationIdeal, Ideal.span, ← Set.image_univ,
    Finsupp.mem_span_image_iff_linearCombination]
  rintro ⟨v, _, hv⟩
  obtain ⟨L, _, _, _, φ, hφ⟩ := finiteEvaluation K v.support
  have heq := congrArg φ hv
  rw [map_one, Finsupp.linearCombination_apply, Finsupp.sum, map_sum,
    Finset.sum_eq_zero] at heq
  · exact zero_ne_one heq
  intro f hf
  rw [smul_eq_mul, map_mul, hφ f hf, mul_zero]

/-- The residue class of the variable indexed by f satisfies f. -/
theorem quotientVariableRoot (K : Type u) [Field K]
    (M : Ideal (RootRing K)) (hIM : relationIdeal K ≤ M) (f : RootIndex K) :
    aeval (Ideal.Quotient.mkₐ K M (MvPolynomial.X f)) f.val = 0 := by
  rw [Polynomial.aeval_algHom_apply]
  change Ideal.Quotient.mk M (relation f) = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr
    (hIM (Ideal.subset_span ⟨f, rfl⟩))

/-- Every quotient element is a polynomial in integral residue-class variables.
No field hypothesis on this quotient is needed for this step. -/
theorem quotientIntegral (K : Type u) [Field K]
    (M : Ideal (RootRing K)) (hIM : relationIdeal K ≤ M)
    (z : RootRing K ⧸ M) : IsIntegral K z := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mkₐ_surjective K M z
  induction p using MvPolynomial.induction_on with
  | C c =>
    change IsIntegral K (algebraMap K (RootRing K ⧸ M) c)
    exact isIntegral_algebraMap
  | add p q hp hq =>
    rw [map_add]
    exact hp.add hq
  | mul_X p f hp =>
    rw [map_mul]
    exact hp.mul ⟨f.val, f.property.1, quotientVariableRoot K M hIM f⟩

/-- Normalization reduces an arbitrary positive-degree polynomial to one of
the monic defining relations. -/
theorem quotientRoot (K : Type u) [Field K]
    (M : Ideal (RootRing K)) (hIM : relationIdeal K ≤ M)
    (f : K[X]) (hf : 0 < f.natDegree) :
    ∃ x : RootRing K ⧸ M, aeval x f = 0 := by
  have hf0 : f ≠ 0 := ne_zero_of_natDegree_gt hf
  let g : RootIndex K := ⟨f * C f.leadingCoeff⁻¹,
    monic_mul_leadingCoeff_inv hf0, by
      rwa [natDegree_mul_leadingCoeff_inv f hf0]⟩
  refine ⟨Ideal.Quotient.mkₐ K M (MvPolynomial.X g), ?_⟩
  have hg := quotientVariableRoot K M hIM g
  change aeval _ (f * C f.leadingCoeff⁻¹) = 0 at hg
  rw [map_mul, aeval_C] at hg
  have hcancel := congrArg
    (fun y : RootRing K ⧸ M => y * algebraMap K (RootRing K ⧸ M) f.leadingCoeff) hg
  simpa only [mul_assoc, ← map_mul, inv_mul_cancel₀ (leadingCoeff_ne_zero.mpr hf0),
    map_one, mul_one, zero_mul] using hcancel

/-- A maximal quotient has precisely the field, embedding, algebraicity, and
root properties asserted in the source. -/
theorem maximalQuotientProperties : MaximalQuotientProperties.{u} := by
  intro K _ M hM hIM
  let : M.IsMaximal := hM
  let : Field (RootRing K ⧸ M) := Ideal.Quotient.field M
  exact ⟨Field.toIsField _, (algebraMap K (RootRing K ⧸ M)).injective,
    ⟨fun z => (quotientIntegral K M hIM z).isAlgebraic⟩,
    quotientRoot K M hIM⟩

/-- Zorn's maximal-ideal existence theorem supplies the promised extension. -/
theorem simultaneousRootField : SimultaneousRootField.{u} := by
  intro K _
  obtain ⟨M, hIM, hM⟩ := Ch09.MaximalExistence.existsMaximal
    (RootRing K) (relationIdeal K) (idealProper K)
  change M.IsMaximal at hM
  exact ⟨M, hM, hIM, maximalQuotientProperties K M hM hIM⟩

/-- Forget the quotient presentation to obtain the usual extension statement. -/
theorem existsExtension : ExtensionExists.{u} := by
  intro K _
  obtain ⟨M, hM, _, hfield, hinj, halg, hroot⟩ := simultaneousRootField K
  let : M.IsMaximal := hM
  let : Field (RootRing K ⧸ M) := Ideal.Quotient.field M
  exact ⟨RootRing K ⧸ M, inferInstance, inferInstance, hinj, halg, hroot⟩

end
end D07.Ch12.AlgebraicClosureSimultaneousRootField
