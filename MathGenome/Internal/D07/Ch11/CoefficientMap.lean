import MathGenome.Internal.Specs.D07.Ch11.CoefficientMap
import MathGenome.Internal.D07.Ch09.FirstIsomorphism
import Mathlib.RingTheory.Polynomial.Basic

/-!
K07.11.coefficient_map. The unital coefficient homomorphism acts on every
formal coefficient. Injectivity detects zero coefficients and hence preserves
degree and leading coefficients. The ideal generated by constants has exactly
the coefficientwise carrier I[X]. The onto coefficient quotient map has this
kernel, so the first isomorphism theorem yields the stated canonical quotient.
All ideal assertions allow I = ⊤, and all general assertions allow zero rings.
-/

universe u v

namespace D07.Ch11.CoefficientMap

open Polynomial
open Specs.D07.Ch11.CoefficientMap

theorem coefficientFormula : CoefficientFormula.{u, v} := by
  intro R S _ _ φ f n
  exact Polynomial.coeff_map φ n

theorem coefficientHomomorphism : CoefficientHomomorphism.{u, v} := by
  intro R S _ _ φ
  refine ⟨mapRingHom φ, coefficientFormula R S φ, ?_⟩
  intro Φ hΦ
  apply RingHom.ext
  intro f
  apply Polynomial.ext
  intro n
  exact (hΦ f n).trans (coefficientFormula R S φ f n).symm

theorem constantsAndIndeterminate : ConstantsAndIndeterminate.{u, v} := by
  intro R S _ _ φ
  exact ⟨fun a => Polynomial.map_C φ, Polynomial.map_X φ⟩

theorem coefficientZeroIff : CoefficientZeroIff.{u, v} := by
  intro R S _ _ φ hφ f n
  rw [coefficientFormula R S φ f n, ← map_zero φ]
  exact hφ.eq_iff

theorem mapInjective : MapInjective.{u, v} := by
  intro R S _ _ φ hφ
  exact Polynomial.map_injective φ hφ

theorem degreePreserved : DegreePreserved.{u, v} := by
  intro R S _ _ φ hφ f
  exact Polynomial.degree_map_eq_of_injective hφ f

theorem natDegreePreserved : NatDegreePreserved.{u, v} := by
  intro R S _ _ φ hφ f
  exact Polynomial.natDegree_map_eq_of_injective hφ f

theorem leadingCoefficientPreserved : LeadingCoefficientPreserved.{u, v} := by
  intro R S _ _ φ hφ f
  exact Polynomial.leadingCoeff_map_of_injective hφ f

theorem degreeDropExample : DegreeDropExample := by
  let φ : ℤ →+* ZMod 2 := Int.castRingHom (ZMod 2)
  let f : Polynomial ℤ := C 2 * X + 1
  have hφ : ¬ Function.Injective φ := by
    intro h
    have hz : φ 2 = φ 0 := by decide
    have : (2 : ℤ) = 0 := h hz
    exact (by decide : (2 : ℤ) ≠ 0) this
  have hm : mapRingHom φ f = 1 := by
    change (C (2 : ℤ) * X + 1).map φ = 1
    have htwo : φ 2 = 0 := by decide
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
      Polynomial.map_X, Polynomial.map_one, htwo, map_zero, zero_mul, zero_add]
  have hd : f.degree = (1 : WithBot ℕ) := by
    change (C (2 : ℤ) * X + C 1).degree = 1
    exact Polynomial.degree_linear (by decide)
  have hlc : f.leadingCoeff = 2 := by
    change (C (2 : ℤ) * X + C 1).leadingCoeff = 2
    exact Polynomial.leadingCoeff_linear (by decide)
  change ¬ Function.Injective φ ∧ mapRingHom φ f = 1 ∧ _
  refine ⟨hφ, hm, hd, ?_, hlc, ?_, ?_⟩
  · rw [hm, Polynomial.degree_one]
  · rw [hlc]
    decide
  · rw [hm, Polynomial.leadingCoeff_one]

theorem coefficientIdealMembership : CoefficientIdealMembership.{u} := by
  intro R _ I f
  exact Ideal.mem_map_C_iff

theorem coefficientIdealGenerated : CoefficientIdealGenerated.{u} := by
  intro R _ I
  rfl

theorem quotientMapSurjective : QuotientMapSurjective.{u} := by
  intro R _ I
  exact Polynomial.map_surjective _ Ideal.Quotient.mk_surjective

theorem quotientMapKernel : QuotientMapKernel.{u} := by
  intro R _ I
  ext f
  rw [RingHom.mem_ker, coefficientIdealMembership R I f]
  change f.map (Ideal.Quotient.mk I) = 0 ↔ _
  rw [Polynomial.ext_iff]
  simp only [Polynomial.coeff_map, Polynomial.coeff_zero,
    Ideal.Quotient.eq_zero_iff_mem]

theorem coefficientQuotientIsomorphism : CoefficientQuotientIsomorphism.{u} := by
  intro R _ I
  obtain ⟨e, he⟩ := D07.Ch09.FirstIsomorphism.first_isomorphism_of_surjective
    (Polynomial R) (Polynomial (R ⧸ I)) (mapRingHom (Ideal.Quotient.mk I))
    (quotientMapSurjective R I)
  refine ⟨(Ideal.quotEquivOfEq (quotientMapKernel R I).symm).trans e, ?_⟩
  intro f
  simpa only [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk] using he f

end D07.Ch11.CoefficientMap
