import MathGenome.Internal.FourierSobolev.Specs.P102.U4.DistributionSupport
import MathGenome.Internal.FourierSobolev.Specs.P102.U4.SchwartzRestriction
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Analysis.Calculus.ContDiff.Comp
import Mathlib.Analysis.LocallyConvex.WithSeminorms

/-! Compactly supported distributions, paper.tex:1370–1378.
Smooth functions on Ω are represented uniquely by their zero extension as functions,
with smoothness required only on Ω. No smoothness at the boundary is imposed.
The topology is generated by the ordinary coordinate derivative suprema on all
ambient compact subsets of Ω. Pairings are scalar-linear, also over ℂ. -/
noncomputable section
open Set TopologicalSpace
open scoped ContDiff Distributions Topology
namespace P102.U4

/-- A faithful model of C∞(Ω); the off-domain values are fixed to zero. -/
def smoothFunctionSubmodule {d : ℕ} (𝕜 : Type) [RCLike 𝕜]
    (Ω : Opens (Space d)) : Submodule 𝕜 (Space d → 𝕜) where
  carrier := {f | ContDiffOn ℝ (⊤ : ℕ∞) f Ω ∧ ∀ x ∉ Ω, f x = 0}
  zero_mem' := ⟨contDiffOn_const, by simp⟩
  add_mem' := by
    rintro f g ⟨hf, hf0⟩ ⟨hg, hg0⟩
    exact ⟨hf.add hg, fun x hx => by simp [hf0 x hx, hg0 x hx]⟩
  smul_mem' := by
    rintro c f ⟨hf, hf0⟩
    exact ⟨hf.const_smul c, fun x hx => by simp [hf0 x hx]⟩

abbrev SmoothFunctions {d : ℕ} (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d)) :=
  smoothFunctionSubmodule 𝕜 Ω

/-- Coordinate derivatives, continuously restricted to a compact set. -/
def smoothWordJet {d k : ℕ} (𝕜 : Type) [RCLike 𝕜] {Ω : Opens (Space d)}
    (K : Compacts (Space d)) (hK : (K : Set (Space d)) ⊆ Ω)
    (a : Fin k → Fin d) : SmoothFunctions 𝕜 Ω →ₗ[𝕜] C(K, 𝕜) where
  toFun f := ⟨fun x => iteratedFDeriv ℝ k f.val x (fun j => coordinateVector d (a j)), by
    have hc := ContinuousOn.continuousOn_iteratedFDeriv f.property.1 Ω.isOpen (k := k) (by simp)
    exact (coordinateEvaluation 𝕜 a).continuous.comp
      (continuousOn_iff_continuous_domRestrict.mp (hc.mono hK))⟩
  map_add' f g := by
    ext x
    change iteratedFDeriv ℝ k (f.val + g.val) x _ = _
    rw [iteratedFDeriv_add_apply
      ((f.property.1.contDiffAt (Ω.isOpen.mem_nhds (hK x.property))).of_le (by simp))
      ((g.property.1.contDiffAt (Ω.isOpen.mem_nhds (hK x.property))).of_le (by simp))]
    rfl
  map_smul' c f := by
    ext x
    change iteratedFDeriv ℝ k (c • f.val) x _ = _
    rw [iteratedFDeriv_const_smul_apply
      ((f.property.1.contDiffAt (Ω.isOpen.mem_nhds (hK x.property))).of_le (by simp))]
    rfl

/-- Supremum of one coordinate derivative on K, including empty K. -/
def smoothWordSeminorm {d k : ℕ} (𝕜 : Type) [RCLike 𝕜] {Ω : Opens (Space d)}
    (K : Compacts (Space d)) (hK : (K : Set (Space d)) ⊆ Ω)
    (a : Fin k → Fin d) : Seminorm 𝕜 (SmoothFunctions 𝕜 Ω) :=
  (normSeminorm 𝕜 C(K, 𝕜)).comp (smoothWordJet 𝕜 K hK a)

/-- max_{|α|≤m} sup_K |∂^α f|, using coordinate words. -/
def smoothSeminorm {d : ℕ} (𝕜 : Type) [RCLike 𝕜] {Ω : Opens (Space d)}
    (K : Compacts (Space d)) (hK : (K : Set (Space d)) ⊆ Ω)
    (m : ℕ) : Seminorm 𝕜 (SmoothFunctions 𝕜 Ω) :=
  (Finset.range (m + 1)).sup fun k =>
    Finset.univ.sup (smoothWordSeminorm 𝕜 K hK (k := k))

abbrev SmoothSeminormIndex {d : ℕ} (Ω : Opens (Space d)) :=
  {K : Compacts (Space d) // (K : Set (Space d)) ⊆ Ω} × ℕ

def smoothSeminormFamily {d : ℕ} (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d)) :
    SmoothSeminormIndex Ω → Seminorm 𝕜 (SmoothFunctions 𝕜 Ω) :=
  fun i => smoothSeminorm 𝕜 i.1.val i.1.property i.2

/-- The usual compact-smooth topology, given by its defining seminorms. -/
instance smoothFunctionsTopology {d : ℕ} (𝕜 : Type) [RCLike 𝕜]
    (Ω : Opens (Space d)) : TopologicalSpace (SmoothFunctions 𝕜 Ω) :=
  (SeminormFamily.moduleFilterBasis (smoothSeminormFamily 𝕜 Ω)).topology

/-- Inclusion of tests into the space of all smooth functions. -/
def testToSmooth {d : ℕ} (𝕜 : Type) [RCLike 𝕜] {Ω : Opens (Space d)} :
    TestSpace 𝕜 Ω →ₗ[𝕜] SmoothFunctions 𝕜 Ω where
  toFun φ := ⟨φ, φ.contDiff.contDiffOn, φ.zero_on_compl⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Multiplication of an arbitrary smooth function by a compactly supported cutoff. -/
def smoothCutoffProduct {d : ℕ} {𝕜 : Type} [RCLike 𝕜] {Ω : Opens (Space d)}
    (χ : TestSpace 𝕜 Ω) (f : SmoothFunctions 𝕜 Ω) : TestSpace 𝕜 Ω :=
  coefficientTestProduct ⟨f.val, f.property.1⟩ χ

/-- A cutoff equals one on some open neighborhood of the support. -/
def IsSupportCutoff {d : ℕ} {𝕜 : Type} [RCLike 𝕜] {Ω : Opens (Space d)}
    (S : DistributionSpace 𝕜 Ω) (χ : TestSpace 𝕜 Ω) : Prop :=
  ∃ U : Opens (Space d), relativeSupport S ⊆ U ∧ ∀ x ∈ U, χ x = 1

namespace CompactExtensionExpected

/-- The zero-extension model represents every locally smooth ambient function,
with equality of smooth functions exactly equality on Ω. -/
def SmoothRepresentation : Prop :=
  ∀ (d : ℕ) (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d)) (f : Space d → 𝕜),
    ContDiffOn ℝ (⊤ : ℕ∞) f Ω →
    ∃! g : SmoothFunctions 𝕜 Ω, EqOn g.val f Ω

/-- The defining coordinate-word seminorm is exactly the manuscript's multi-index
seminorm. In particular it is zero on an empty compact. -/
def MultiIndexFormula : Prop :=
  ∀ (d : ℕ) (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d))
    (K : Compacts (Space d)) (hK : (K : Set (Space d)) ⊆ Ω)
    (m : ℕ) (f : SmoothFunctions 𝕜 Ω) (C : ℝ), 0 ≤ C →
      (smoothSeminorm 𝕜 K hK m f ≤ C ↔
        ∀ α : MultiIndex d, α.card ≤ m → ∀ x ∈ K, ‖multiPartial f.val α x‖ ≤ C)

/-- Boundary case: empty relative support is exactly the zero distribution. -/
def EmptySupport : Prop :=
  ∀ (d : ℕ) (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d))
    (S : DistributionSpace 𝕜 Ω), relativeSupport S = ∅ ↔ S = 0

/-- Full canonical extension, its cutoff formula, continuity and global order bound. -/
def Extension : Prop :=
  ∀ (d : ℕ) (𝕜 : Type) [RCLike 𝕜] (Ω : Opens (Space d))
    (S : DistributionSpace 𝕜 Ω), IsCompact (relativeSupport S) →
    ∃ E : SmoothFunctions 𝕜 Ω →L[𝕜] 𝕜,
      (∃ χ : TestSpace 𝕜 Ω, IsSupportCutoff S χ) ∧
      (∀ χ : TestSpace 𝕜 Ω, IsSupportCutoff S χ →
        ∀ f, E f = S (smoothCutoffProduct χ f)) ∧
      (∀ φ : TestSpace 𝕜 Ω, E (testToSmooth 𝕜 φ) = S φ) ∧
      (∃ (K : Compacts (Space d)) (hK : (K : Set (Space d)) ⊆ Ω)
        (m : ℕ) (C : ℝ), 0 ≤ C ∧
        ∀ f, ‖E f‖ ≤ C * smoothSeminorm 𝕜 K hK m f) ∧
      (∀ E' : SmoothFunctions 𝕜 Ω →ₗ[𝕜] 𝕜,
        (∀ χ : TestSpace 𝕜 Ω, IsSupportCutoff S χ →
          ∀ f, E' f = S (smoothCutoffProduct χ f)) → E' = E.toLinearMap)

/-- Whole-space restriction is a genuine tempered distribution extending S. -/
def TemperedExtension : Prop :=
  ∀ (d : ℕ) (𝕜 : Type) [RCLike 𝕜]
    (S : DistributionSpace 𝕜 (⊤ : Opens (Space d))), IsCompact (relativeSupport S) →
    ∃ E : SmoothFunctions 𝕜 (⊤ : Opens (Space d)) →L[𝕜] 𝕜,
      (∀ χ : WholeTests d 𝕜, IsSupportCutoff S χ →
        ∀ f, E f = S (smoothCutoffProduct χ f)) ∧
      ∃ T : SchwartzTests d 𝕜 →L[𝕜] 𝕜,
        (∀ f : SchwartzTests d 𝕜,
          T f = E ⟨f, f.smooth ⊤ |>.contDiffOn, by simp⟩) ∧
        (∀ φ : WholeTests d 𝕜, T (testToSchwartz d 𝕜 φ) = S φ)

end CompactExtensionExpected
end P102.U4
